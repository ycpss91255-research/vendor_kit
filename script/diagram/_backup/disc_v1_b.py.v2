b.box("u4", E, 1, P2, "刪 version.local.toml 該行 → 重新 materialize version.toml 版\n（拆 symlink、重新展開、印記 index digest）", 400)
b.box("u5", P, 1, F2, "version.local.toml 少一行；cache/<repo>/（重新展開）", 360)
b.box("u6", U, 2, G12, "0", 220)
b.H("ue1", "u0", "u1"); b.H("ue2", "u1", "u2"); b.H("ue3", "u2", "u3", "否"); b.D("ue4", "u2", "u4", "是", 0.5, 0.5)
b.H("ue5", "u4", "u5", "寫"); b.D("ue6", "u4", "u6")
b.close()
b = F.band("vC", "remove <repo>：拆掉一個工具（初始檔永不刪、印清單；append 行問後只刪原文相同的；不開 --purge，要刪用 git rm）")
b.box("m0", U, 0, G12, "just vendor_kit remove <repo>\n（-y、-n/--dry-run）", 220, extra=10)
b.box("m1", L, 0, W12, "flock；docker run 引擎 remove", 280)
