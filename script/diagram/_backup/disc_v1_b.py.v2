b.U("te5", "t1a", "t1f", "寫", 0.75, 0.5); b.D("te6", "t1a", "t2", "", 0.25, 0.5)
b.H("te7", "t2", "t2a", "否"); b.D("te8", "t2", "t3", "是"); b.U("te9", "t2a", "t2f", "寫", 0.75, 0.5); b.D("te10", "t2a", "t3", "", 0.25, 0.5)
b.H("te11", "t3", "t3a", "否"); b.D("te12", "t3", "t4", "是")
b.H("te13", "t4", "t4c", "否"); b.H("te14", "t4c", "t4r", "是"); b.D("te15", "t4c", "t5", "否")
b.D("te16", "t4", "z0", "是"); b.D("te17", "t5", "z0", "", 0.25, 0.5); b.D("te18", "t0s", "z0", "", 0.5, 0.5)
b.H("ze1", "z0", "z1", "寫"); b.H("ze2", "z0", "z2")
b.close()
foot(p6, "p6", F.y, [
 ("sync", "vendor.just 的前置 recipe：每次 just 自動跑（v1 叫 ensure）；只讀 version.toml／local，只寫 .vendor_kit/cache/ 與 gen/；範圍 = 全部工具"),
 ("frozen（CI=1）", "CI 下 sync 只檢查不放行：baseline 落後 version.toml 就回 1（本機只 warn）"),
 ("統一提示", "引擎 ref ≠ gen/.stamp → 換薄殼 + gen 後退出 1，固定印「vendor_kit 已更新 vX → vY，請再跑一次剛才的指令」；不自動續跑（just 一開始即載入定義）"),
 ("materialize", "引擎內部步驟：啟動器 docker create/cp 取 /dist（多架構 index，不帶 --platform，daemon 挑原生）→ 展開到 cache/<repo>/、寫印記"),
 ("印記第一行", "cache/<repo>/.stamp 第一行 = 裝的是哪個 index digest（dev 時是 path:<dir>）；≠ version.toml 就 materialize"),
 ("verify", "把 cache/<repo>/ 每個檔的 sha256 跟印記比；不符 → 重裝 + warn（使用者不可改 cache/）"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源 ref@digest、最後合併版本、接入完成標記、append 過的行、衝突中檔案"),
 ("完成標記／落後", "無完成標記 = add 沒做完 → 1；最後合併版本 ≠ version.toml = 有人只改了 version.toml → 提示 upgrade（CI → 1）"),
 ("gen/", ".vendor_kit/gen/：tools.just（每工具一行 mod）與 .stamp（引擎 ref）；引擎每次重生，不進 git；零 set 零 recipe"),
 ("覆寫（version.local.toml）", "<repo> = \"path:<dir>\"（dev）→ sync 跳過該工具的 materialize／verify；vendor_kit = \"<tag>\" → 引擎改用本機 image"),
], legend_extra=[(RULE, "黃粗框：規則", 130)])
pages_v1_b.append(("v1p6", "流程 v2：sync（每次 just 都跑）", p6))

# ================= P7：upgrade =================
p7 = [v("title", "1", TITLE, "流程 v2：upgrade ── Renovate 路徑、手動、逐檔詢問、回退、自身升級（§2／§5／§7）", 40, 20, 940, 34)]
ny = pend(p7, "⚠ 待拍板（proposal_v2 §9）\n(5) upgrade 對 append 行的「原文比對」在 CRLF／尾端空白時的判定（第一版：嚴格相同；找不到就不動、印新內容）。", x=1000, w=600)
F = Flow(p7, COLS7); F.headers(ny + 14)
b = F.band("uA", "A. Renovate 路徑（下游自選，vendor_kit 不出 bot）：機器人只改 version.toml 一行；PR 的 CI 以新版跑完整流程；合併由 PR 作者本機補")
b.box("a0", RN, 0, G12, "Renovate 定期查 GHCR\n（regex manager、\ndocker datasource）", 200, extra=10)
b.box("a1", G, 0, P12, "<repo>-dist\n出新 tag@digest", 180)
b.box("a2", RN, 1, W2, "開 PR：只改 version.toml\n該工具一行（tag@digest）", 200)
b.box("a3", P, 1, F2, "version.toml（PR 分支）\n<repo> 行 = 新 tag@digest", 280)
b.box("a4", L, 2, W2, "PR 的 CI 跑 check.sh：以新版跑完整流程\nsync frozen → verify → upgrade --dry-run\n→ 工具測試 → 專案測試", 240)
b.box("a4r", E, 2, RULE, "（v2 改）一行改動本身不可能出錯，\n不構成通過依據 → PR 的 CI 必須以新版跑完整流程", 360)
b.box("a5", E, 3, R2, "1：baseline 落後 version.toml → PR 紅，印\n「本機 just vendor_kit upgrade <repo> -y 後 push」", 360)
b.box("a9", P, 3, NOTE, "Renovate 預設不動有人推過的分支；\nPR body 加警告：勿勾 rebase（會蓋掉\n人補的合併 commit）。vendor_kit 無 bot。", 280, extra=10)
b.box("a6", U, 4, W2, "PR 作者本機：切到 PR 分支 →\njust vendor_kit upgrade <repo> -y\n（走 B 補合併）→ commit、push", 200)
b.box("a7", L, 5, W2, "CI 全部再跑（同上完整流程）→ 綠", 240)
b.box("a8", U, 5, G12, "merge PR", 200)
b.H("ae1", "a0", "a1", "查"); b.D("ae2", "a1", "a2", "有新版"); b.H("ae3", "a2", "a3", "改一行")
b.D("ae4", "a2", "a4"); b.D("ae5", "a4", "a5"); b.D("ae6", "a5", "a6", "", 0.5, 0.5)
b.D("ae7", "a6", "a7"); b.H("ae8", "a7", "a8", "綠")
b.close()
b = F.band("uB", "B. 手動路徑：just vendor_kit upgrade [<repo>]（不帶 repo = 全部含 vendor_kit 自身；-t 限單一 repo）")
b.box("b0", U, 0, G12, "just vendor_kit upgrade <repo>\n（-t <tag>、-y、-n/--dry-run）", 200, extra=10)
b.box("b1", L, 0, W12, "flock → docker run 引擎\nupgrade <repo>", 240)
b.box("b2", E, 0, P2, "upgrade：先補待合併（version.toml 已到 B、\nbaseline 仍 A）；否則查最新（或 -t；\n比現版舊 → warn 仍執行）", 360)
b.box("b3", G, 0, P12, "<repo>-dist\n最新 tag@digest", 180)
b.box("b4", E, 1, D12, "有 baseline/\n<repo>/？", 180, 80, ax="l")
b.box("b5", E, 1, R12, "1：無 baseline，\n請先 add <repo>", 160, 70, ax="r")
b.box("b6", E, 2, D12, "--dry-run？", 180, 70, ax="l")
b.box("b7", E, 2, G2, "0：只印會問哪些檔\n（換／合併／append），\n不動任何檔", 160, ax="r")
b.box("b8", E, 3, W2, "改 version.toml：<repo> 行 → 新 tag@digest", 360)
b.box("b8f", P, 3, F2, "version.toml（<repo> 行）", 280)
b.box("b9", L, 4, W2, "docker create/cp 取新版 /dist\n（多架構 index，不帶 --platform）", 240)
b.box("b10", E, 4, P2, "materialize：展開到 cache/<repo>/、寫印記", 360)
b.box("b10f", P, 4, F2, "cache/<repo>/（新版）", 280)
b.box("b11", E, 5, P2, "逐檔判斷（baseline／現況／新版，見 C 表）\n→ 列出要問的檔", 360)
b.box("b12", E, 6, D2, "CI 且無 -y\n又需改檔？", 180, 80, ax="l")
b.box("b13", E, 6, R2, "1：印需改的\n檔清單", 160, 70, ax="r")
b.box("b14", E, 7, P2, "逐檔詢問（-y 免問）並套用：換新版／\ngit merge-file --diff3／append 行替換\n（衝突留 <<<<<<< 標記、記在 metadata）", 360)
b.box("b14f", P, 7, F12, "初始檔（合併後；衝突留 <<<<<<< 標記）", 280)
b.box("b15", E, 8, P2, "推 baseline/<repo>/ + metadata\n（最後合併版本 = 新版；有衝突也推）", 360)
b.box("b15f", P, 8, F12, "baseline/<repo>/、.vendor_kit.toml", 280)
b.box("b16", U, 8, G12, "0：印摘要 → commit\nversion.toml、初始檔、baseline\n（同一 commit）", 200, extra=10)
b.box("b17", E, 9, R2, "2：印衝突檔名清單\n（解完再跑 upgrade，直到乾淨；baseline 已在新版）", 340)
b.H("be1", "b0", "b1"); b.H("be2", "b1", "b2"); b.H("be3", "b2", "b3", "查")
b.D("be4", "b2", "b4", "", 0.5, 0.5); b.H("be5", "b4", "b5", "否"); b.D("be6", "b4", "b6", "是")
b.H("be7", "b6", "b7", "是"); b.D("be8", "b6", "b8", "否"); b.H("be9", "b8", "b8f", "寫")
b.D("be10", "b8", "b9"); b.H("be11", "b9", "b10"); b.H("be12", "b10", "b10f", "寫")
b.D("be13", "b10", "b11"); b.D("be14", "b11", "b12"); b.H("be15", "b12", "b13", "是")
b.D("be16", "b12", "b14", "否"); b.H("be17", "b14", "b14f", "寫"); b.D("be18", "b14", "b15")
b.H("be19", "b15", "b15f", "寫"); b.H("be20", "b15", "b16", "無衝突"); b.D("be21", "b15", "b17", "有衝突")
b.close()
# ---- C. 逐檔判斷表（不是泳道；自由排） ----
b = F.band("uC", "C. 逐檔判斷後詢問（每個 init.toml 檔；引擎 merge 模組；§5 表）")
TBL_H = "rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;"
b.free("c_in0", F12, "baseline/<repo>/<檔>\n（上次合併的範本）", 30, 50, 200, 44)
b.free("c_in1", F12, "專案裡的 <檔>\n（現況，使用者可能改過）", 30, 114, 200, 44)
b.free("c_in2", F12, "新版 cache/<repo>/<檔>\n（image 展開）", 30, 178, 200, 44)
b.free("c_m", P2, "逐檔判斷（右表）\n→ 要改的先問（-y 免問）", 290, 106, 150, 60)
b.P("c_e0", "c_in0", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 72), (260, F.y + 136)])
b.P("c_e1", "c_in1", "c_m", "", (1, 0.5), (0, 0.5), [])
b.P("c_e2", "c_in2", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 200), (260, F.y + 136)])
rows = [("新版沒改／你的檔已等於新版", "不動", "—"),
        ("新版改了、你沒改（D==B）", "問「X 換成新版？」", "同意 → 換；拒絕 → 不動"),
        ("兩邊都改", "問「你和新版都改了 X，要三方合併嗎？」→ git merge-file --diff3", "乾淨 → 寫入；衝突 → 留 <<<<<<< 標記、回 2；baseline 仍推到新版；解完重跑直到乾淨"),
        ("新版新增（baseline 無）", "同 add 列：使用者沒有 → 建（印出）；已有同名 → 不納管", "不覆蓋、印「已存在，範本在 cache」"),
        ("新版刪除該檔", "不刪，只 warn", "使用者的檔留著"),
        ("append 行（mode=append）", "找到上次加的行（原文相同）→ 問後替換", "找不到 → 不動、印新內容"),
        ("二進位／symlink", "不合併：使用者未改（現況 = baseline）才換", "改過 → 保留 + warn")]
tx, ty = 480, 44; cws = [190, 400, 330]
for i, hh in enumerate(["情況", "做法", "結果"]):
    b.free(f"c_h{i}", TBL_H, hh, tx + sum(cws[:i]), ty, cws[i], 28)
cy = ty + 28
for r, row in enumerate(rows):
    rh = math.ceil(max(need_h(c, 12, w) for c, w in zip(row, cws))) + 4
    for i, (c, w) in enumerate(zip(row, cws)):
        b.free(f"c_r{r}c{i}", TERM_K if i == 0 else TERM_V, c, tx + sum(cws[:i]), cy, w, rh)
    cy += rh
b.free("c_note", v2(NOTE), "--dry-run = 只印會問哪些檔，不動任何檔。\nCI 無 -y 又需改檔 → 1 印清單。\n衝突解完 → 再跑一次 upgrade 直到乾淨（不另開 accept）。\n多工具 init.toml 指到同一路徑 → add 時報錯。", 1420, 44, 150, 200)
b.P("c_e3", "c_m", "c_h0", "", (1, 0.5), (0, 0.5), [(460, F.y + 136), (460, F.y + 58)])
b.close()
b = F.band("uD", "D. 回退 ＝ git revert　　E. vendor_kit 自身升級 ＝ 換薄殼、統一提示要求重跑")
b.box("d0", U, 0, G12, "git revert 該升級 commit\n（version.toml + 初始檔 +\nbaseline 同一 commit）", 200, extra=10)
b.box("d1", L, 0, W12, "下次 just：sync 看到印記\n≠ version.toml → materialize 舊版", 240)
b.box("d2", E, 0, P12, "materialize 舊版（合併結果與 baseline\n已由 revert 一起退回）", 360)
b.box("d3", P, 0, F12, "cache/<repo>/（舊版）、初始檔、baseline（退回）", 280)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3", "寫")
b.box("s0", L, 1, W2, "E：version.toml 第一行變（走 A 或 B）\n→ 下次 just：gen/.stamp ≠ 引擎 ref", 240)
b.box("s1", E, 1, P2, "新引擎重寫 .vendor_kit/ 薄殼與 gen/\n（entry.just、vendor.just、ci/check.sh）", 360)
b.box("s2", P, 1, F12, "gen/、.vendor_kit/ 薄殼（重寫）", 280)
b.box("s3", L, 2, R2, "1：統一提示「vendor_kit 已更新\nvX → vY，請再跑一次剛才的指令」", 240)
b.box("s4", U, 2, G12, "重跑原指令\n（其餘工具接著升）", 200, extra=10)
b.H("se1", "s0", "s1"); b.H("se2", "s1", "s2", "寫"); b.D("se3", "s1", "s3", "", 0.5, 0.5); b.H("se4", "s3", "s4")
b.close()
foot(p7, "p7", F.y, [
 ("Renovate", "GitHub 上的機器人（下游自選；vendor_kit 不出 bot）：regex manager + docker datasource 看 version.toml；有新 tag 就開 PR 改那一行"),
 ("check.sh／完整流程", ".vendor_kit/ci/check.sh：下游 CI 只呼叫它 = sync（frozen）→ verify → upgrade --dry-run → 工具測試（just <repo> check 若有）→ 專案測試"),
 ("baseline 落後", "metadata 最後合併版本 ≠ version.toml：有人只改了 version.toml 還沒合併 → CI 1、本機 warn"),
 ("逐檔判斷後詢問", "baseline（上次範本）／現況（使用者的檔）／新版三份比：新版改了才問「換成新版？」；兩邊都改才問「三方合併？」；-y 免問"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< ||||||| ======= >>>>>>> 標記"),
 ("結束狀態 0／1／2", "0 成功；1 失敗不動 version.toml；2 有衝突（留標記、印檔名；baseline 仍推到新版；解完重跑直到乾淨）"),
 ("--dry-run", "只印會問哪些檔（哪些要換／合併／append 替換），不動任何檔；不另開 diff"),
 ("append 行", "mode=append 的初始檔：upgrade 找上次加的行（原文相同）→ 問後替換；找不到 → 不動、印新內容"),
 ("回退", "git revert 升級的那個 commit；下次 just 的 sync 自動 materialize 回舊版 cache/<repo>/"),
 ("自身升級／統一提示", "version.toml 第一行（引擎 ref）變 → 啟動器換薄殼後退出 1，印統一提示要求重跑，不自動續跑"),
], legend_extra=[(RULE, "黃粗框：規則", 130)])
pages_v1_b.append(("v1p7", "流程 v2：upgrade ── Renovate 路徑、手動、逐檔詢問、回退、自身升級", p7))

# ================= P8：dev/undev、remove/uninstall =================
p8 = [v("title", "1", TITLE, "流程 v2：dev／undev、remove／uninstall（§2 dev、undev、remove、uninstall 列；§5 remove 列）", 40, 20, 1000, 34)]
ny = pend(p8, "⚠ 待拍板（proposal_v2 §9）\n(5) append 行的「原文比對」（remove／uninstall 只刪原文相同的行）在 CRLF／尾端空白時的判定（第一版：嚴格相同；不同就不刪、印清單）。")
F = Flow(p8, COLS5); F.headers(ny + 14)
b = F.band("vA", "dev <repo> -p <dir>：用本機工具 repo 取代 image（不進 git；CI 下拒絕；v2 改：工具必須已在 version.toml）")
b.box("d0", U, 0, G12, "just vendor_kit dev <repo>\n-p <dir>", 220, extra=10)
b.box("d1", L, 0, W12, "CI=1 → 1 拒絕；flock；\ndocker run 引擎 dev（-v <dir>:/dist/<repo>:ro）", 280)
b.box("d2", E, 0, D2, "<repo> 已在\nversion.toml？", 170, 80, ax="l")
b.box("d3", E, 0, R2, "1：未接入，請先 add <repo>", 210, 60, ax="r")
b.box("d4", E, 1, D12, "<dir>/dist/ 與\ninit.toml 存在？", 170, 80, ax="l")
b.box("d5", E, 1, R12, "1：缺 dist/ 或 init.toml", 210, 60, ax="r")
b.box("d6", E, 2, P2, "寫 version.local.toml：<repo> = \"path:<dir>\"\n（.vendor_kit/.gitignore 已排除它，不碰 .git/info/exclude）", 400)
b.box("d7", E, 3, P2, "cache/<repo>/ 改為 symlink → <dir>/dist\n印記第一行改 path:<dir>", 400)
b.box("d8", U, 4, G12, "0：之後每次 just 直接用 <dir>\n（sync 跳過 materialize／verify；\nupgrade 的合併來源不受影響）", 220, extra=10)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3", "否"); b.D("de4", "d2", "d4", "是")
b.H("de5", "d4", "d5", "否"); b.D("de6", "d4", "d6", "是", 0.5, 0.5); b.D("de7", "d6", "d7"); b.D("de8", "d7", "d8")
b.free("df_l", LBL, "dev 前 → 後（專案目錄）", 1220, 44, 340, 24)
DF0 = "dev 前\nversion.local.toml：無\ncache/<repo>/：從 image 展開\ncache/<repo>/.stamp\n  第一行：index digest"
DF1 = "dev 後（不進 git）\n＋version.local.toml：\n  <repo> = \"path:<dir>\"\ncache/<repo>/ → <dir>/dist\n  （symlink）\n.stamp 第一行：path:<dir>"
TH = max(fit_h(DF0, 170), fit_h(DF1, 170))
b.free("df0", FTREE, DF0, 1220, 74, 170, TH)
b.free("df1", v2(FTREE), DF1, 1410, 74, 170, TH)
b.P("dfe", "df0", "df1", "", (1, 0.5), (0, 0.5), ())
b.close()
b = F.band("vI", "dev vendor_kit -i <本機 image tag>（v2 改：自身也能 dev；只能 tag 不能 digest —— docker load 後無 RepoDigests，實測；驗收測試用同一機制）")
b.box("v0", U, 0, G2, "just vendor_kit dev vendor_kit\n-i <本機 image tag>", 220, extra=10)
b.box("v1", L, 0, W2, "CI=1 → 1 拒絕；flock；\ndocker run 引擎 dev -i <tag>\n（tar 先自己 docker load）", 280)
b.box("v2", E, 0, P2, "寫 version.local.toml：vendor_kit = \"<tag>\"\n→ 下次 just：sync 取引擎 ref 時覆寫優先 → 用該 image\n換薄殼 + gen → 統一提示 1「請再跑一次」", 400)
b.box("v3", P, 0, F2, "version.local.toml（vendor_kit 行；不進 git）\n之後 gen/、.vendor_kit/ 薄殼由本機引擎重寫", 360)
b.H("ve1", "v0", "v1"); b.H("ve2", "v1", "v2"); b.H("ve3", "v2", "v3", "寫")
b.close()
b = F.band("vB", "undev <repo>：回到 version.toml 鎖定的版本（vendor_kit 自身同理）")
b.box("u0", U, 0, G12, "just vendor_kit undev <repo>", 220)
b.box("u1", L, 0, W12, "flock；docker run 引擎 undev", 280)
