foot(p8, "p8", F.y, [
 ("dev / undev", "用本機工具 repo 的 dist/ 取代 image（開發工具本身用；工具必須已在 version.toml）／回到 version.toml 鎖定版"),
 ("dev vendor_kit -i", "自身 dev：version.local.toml 寫 vendor_kit = \"<本機 image tag>\"（只能 tag）；sync 取引擎 ref 時覆寫優先；驗收測試用同一機制"),
 ("version.local.toml", ".vendor_kit/version.local.toml，不進 git（.vendor_kit/.gitignore 排除；不碰 .git/info/exclude）；記 <repo> = \"path:<dir>\" 或 vendor_kit = \"<tag>\""),
 ("symlink", "dev 時 cache/<repo>/ 是指向 <dir>/dist 的符號連結；印記第一行 path:<dir>；sync 看到就跳過 materialize／verify"),
 ("remove", "刪 version.toml 行、cache/<repo>/、baseline/<repo>/、gen 內那行；初始檔永不刪、印清單；append 行問後只刪原文相同的"),
 ("uninstall", "逐工具 remove → 刪 .vendor_kit/ 全部 → 根 justfile 那行問「要刪這一行嗎」（-y 免問），只刪與我們寫的完全相同的行"),
 ("append 行", "add 時問後加進使用者檔（.gitignore 類）的行，記在 metadata；remove／uninstall 問後只刪原文相同的；不同就不刪、印清單"),
 ("初始檔", "init.toml 複製到專案的檔（歸使用者、進 git）；remove／uninstall 都不刪；--purge 不開（用 git rm）"),
], legend_extra=[(FTREE, "虛線樹：目錄差異", 150)])
pages_v1_b.append(("v1p8", "流程 v2：dev/undev、remove/uninstall", p8))
