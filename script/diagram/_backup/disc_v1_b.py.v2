b.D("xe5", "x3", "x4", "", 0.5, 0.5); b.H("xe6", "x4", "x5", "有"); b.H("xe7", "x5", "x5f", "寫")
b.D("xe8", "x4", "x6", "無", 0.5, 0.5); b.D("xe9", "x5", "x7", "", 0.5, 0.5); b.D("xe10", "x6", "x7", "", 0.5, 0.5)
