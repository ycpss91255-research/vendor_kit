b.box("m4", E, 1, D12, "有 dev 覆寫？", 170, 70, ax="l")
b.box("m5", E, 1, R12, "1：請先 undev <repo>", 200, 60, ax="r")
b.box("m6", E, 2, P2, "刪 version.toml 該行、cache/<repo>/、baseline/<repo>/、\ngen/tools.just 該工具那行", 400)
b.box("m7", P, 2, F2, "－version.toml <repo> 行 －cache/<repo>/\n－baseline/<repo>/ －gen/tools.just 該行\n（初始檔留著）", 360)
b.box("m8", E, 3, D2, "metadata 有\nappend 過的行？", 170, 80, ax="l")
b.box("m9", E, 3, W2, "問「要刪我們加的這幾行嗎」\n（-y 免問）→ 只刪原文相同的行", 220, ax="r")
b.box("m9f", P, 3, F2, "初始檔（只移除我們 append 的行；其餘不動）", 360)
b.box("m10", U, 4, G12, "0：印「以下初始檔保留，\n若不需要請 git rm：…」", 220, extra=10)
b.H("me1", "m0", "m1"); b.H("me2", "m1", "m2"); b.H("me3", "m2", "m3", "否"); b.D("me4", "m2", "m4", "是")
b.H("me5", "m4", "m5", "是"); b.D("me6", "m4", "m6", "否", 0.5, 0.5); b.H("me7", "m6", "m7", "刪"); b.D("me8", "m6", "m8")
b.H("me9", "m8", "m9", "有"); b.H("me10", "m9", "m9f", "寫"); b.D("me11", "m8", "m10", "無"); b.D("me12", "m9", "m10", "", 0.5, 0.5)
b.close()
b = F.band("vD", "uninstall：全部拆掉（install 的反向；bootstrap.sh 的反向也是它）")
b.box("x0", U, 0, G12, "just vendor_kit uninstall\n（-y、-n/--dry-run）", 220, extra=10)
b.box("x1", L, 0, W12, "docker run 引擎 uninstall", 280)
b.box("x2", E, 0, P2, "逐工具 remove（同上：有 dev 覆寫 → 1；\nappend 行問後只刪原文相同的；初始檔不刪）", 400)
b.box("x3", E, 1, P2, "刪 .vendor_kit/ 全部（version.toml、version.local.toml、\n.gitignore、entry/vendor.just、ci/、baseline/、cache/、gen/）", 400)
b.box("x3f", P, 1, F2, "－.vendor_kit/（整個目錄）\n（初始檔留著；使用者的 .gitignore 不碰）", 360)
