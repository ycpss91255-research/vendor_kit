b.R("ce17", "c12", "c16", "", busx=990); b.R("ce18", "c14", "c16", "", busx=990); b.D("ce19", "c15", "c16")
b.D("ce20", "c16", "c17"); b.H("ce21", "c17", "c18")
# 右側：add 前／後 專案目錄差異（不從流程拉線）
b.free("cf_l", LBL, "add 前 → 後（專案目錄；v2 = .vendor_kit/ 結構）", 1220, 44, 340, 24)
CF0 = "add 前（install 後）\n專案/\n├ justfile（＋1 行）\n└ .vendor_kit/\n   ├ version.toml\n   │  （vendor_kit 行）\n   ├ version.local.toml\n   │  （--local 時）\n   ├ .gitignore\n   ├ entry.just\n   ├ vendor.just\n   ├ ci/check.sh\n   └ baseline/（空）"
CF1 = "add 後（＋ = 新增）\n＋version.toml [tools]\n   加 <repo> 行\n＋cache/<repo>/\n   （不進 git）.stamp、\n   files/、init.toml、just/\n＋初始檔（init.toml 的\n   dest；append 問後加）\n＋baseline/<repo>/\n   + .vendor_kit.toml\n＋gen/tools.just 加一行\n   （不進 git）"
TH = max(fit_h(CF0, 170), fit_h(CF1, 170))
b.free("cf0", FTREE, CF0, 1220, 74, 170, TH)
b.free("cf1", v2(FTREE), CF1, 1410, 74, 170, TH)
b.P("cfe", "cf0", "cf1", "", (1, 0.5), (0, 0.5), ())
b.close()
foot(p5, "p5", F.y, [
 ("bootstrap.sh", "release 附的 POSIX sh 薄層：檢查 git repo／just ≥ 1.33 → docker pull 引擎（--local 用本機 image）→ 呼叫 install → 對每個 --tool 呼叫 add；再跑 = install（冪等修復）；不自刪"),
 ("install／uninstall", "專案層一對（vendor_kit 自己）：把 vendor_kit 裝進這個 git repo（建 .vendor_kit/ 各檔＋根 justfile 一行）／全部拆掉；不開 init、--repair"),
 ("薄殼 .vendor_kit/", "version.toml、.gitignore、entry.just、vendor.just、ci/check.sh、baseline/（進 git）＋ cache/、gen/、version.local.toml（不進 git）；引擎產生，人不改"),
 ("version.toml", ".vendor_kit/version.toml 唯一來源（進 git）：第一行 vendor_kit 引擎 ref（ghcr.io/…/vendor_kit:vN@sha256:…）；[tools] 每工具一行 tag@digest"),
 ("version.local.toml", "不進 git：覆寫 version.toml —— dev 的 path:<dir>，或本機引擎 image tag（--local／dev vendor_kit -i）"),
 ("-y／問", "§1 不變量：對使用者的檔可以建（要印出建了什麼）、要改先問（-y 免問）、永不刪、永不覆蓋"),
 ("add", "接一個工具：寫 version.toml → materialize → 初始檔逐檔 → baseline + metadata → 重生 gen/；已接入且完成 → 0 無變更"),
 ("materialize／印記", "引擎內部步驟（非對外動詞；v1 叫 install）：把 image 的 /dist 展開到 .vendor_kit/cache/<repo>/；印記 .stamp 第一行 index digest，之後每檔 sha256"),
 ("初始檔／append 模式", "init.toml [[file]] src/dest [mode=\"copy\"|\"append\"]：copy 無→建、有→不納管；append（.gitignore 類）無→建、有→問「要加這幾行嗎」→ append 並記 metadata"),
 ("baseline／metadata", "baseline/<repo>/ 是上次合併的範本副本；.vendor_kit.toml 記來源 ref@digest、最後合併版本、完成標記、append 過的行、衝突中檔案"),
 ("續作", "add 對已接入工具只補「metadata 無完成標記」的未完成接入；不補使用者刻意刪的檔"),
 ("flock", "專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），避免兩個 just 同時寫"),
], legend_extra=[(FTREE, "虛線樹：目錄差異", 150)])
pages_v1_b.append(("v1p5", "流程 v2：bootstrap.sh + install + add", p5))

# ================= P6：sync（每次 just 都跑） =================
p6 = [v("title", "1", TITLE, "流程 v2：sync（每次 just 都跑）── §2／§6 決策樹（<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p6, "註記（proposal_v2 §9 (2)，已定）：sync 範圍 = 全部工具（不只被叫到的那個）；每次只 grep 印記第一行（便宜），sha256 逐檔 verify 也每次跑。\n本頁無待拍板項。v1 的 ensure → 改名 sync。", style=NOTE)
F = Flow(p6, COLS5); F.headers(ny + 14)
b = F.band("eA", "sync：vendor.just 的前置，任何 just 指令都先跑（只寫 gitignore 路徑 cache/、gen/；CI=1 自動 frozen；v1 叫 ensure）")
b.box("n0", U, 0, G12, "打任何 just 指令\n（sync 自動前置）", 220, extra=10)
b.box("n1", L, 0, W2, "讀 version.toml 第一行取引擎 ref\n（version.local.toml 覆寫優先）\nCI=1 → frozen（只檢查，不 warn 放行）", 280)
b.box("n2", P, 0, F2, ".vendor_kit/version.toml（進 git）\n.vendor_kit/version.local.toml（不進 git，dev 用）", 360)
b.box("n3", L, 1, D2, "gen/.stamp ＝\n引擎 ref？", 160, 90)
b.box("n4", E, 1, P2, "換薄殼：用新引擎\n重寫 .vendor_kit/ 薄殼\n與 gen/", 220, ax="l")
b.box("n5", E, 1, R2, "1：vendor_kit 已更新\nvX → vY，請再跑一次\n剛才的指令", 170, ax="r")
b.box("n6", P, 1, RULE, "（v2 改）統一提示：引擎 ref ≠ gen/.stamp → 換薄殼\n→ 退出 1 印「vendor_kit 已更新 vX → vY，\n請再跑一次剛才的指令」；不自動續跑\n（just 一開始即載入定義）", 360)
b.box("nl", E, 2, LBL, "↓ 以下對每個工具重複（範圍 = 全部工具，已定；先比對印記，便宜）", 400, 24, minh=24)
b.box("t0", L, 3, D2, "version.local\n有 path／image\n覆寫？", 170, 90)
b.box("t0s", U, 3, W2, "dev 中：跳過 materialize\n／verify（cache/<repo>/\n是 symlink）", 220)
b.box("t1", L, 4, D2, "無 cache/<repo>/\n或印記第一行\n≠ version.toml？", 160, 90)
b.box("t1a", E, 4, P2, "materialize：啟動器 docker create/cp 取 /dist\n→ 引擎展開到 cache/<repo>/、寫印記", 400)
b.box("t1g", G, 4, P2, "<repo>-dist@digest\n（多架構 index；不帶 --platform）", 220)
b.box("t1f", P, 4, F2, "cache/<repo>/（重寫，不進 git）", 360)
b.box("t2", L, 5, D12, "verify：每檔\nsha256 ＝ 印記？", 150, 80)
b.box("t2a", E, 5, P2, "重裝（同 materialize）\n+ warn「cache/<repo>/ 被改過，已重裝」", 400)
b.box("t2f", P, 5, F2, "cache/<repo>/（重寫，不進 git）", 360)
b.box("t3", L, 6, D12, "metadata 有\n完成標記？", 150, 80)
b.box("t3a", E, 6, R12, "1：從未完成接入，\n請 just vendor_kit add <repo>", 260, 70)
b.box("t3r", P, 6, RULE, "sync 只寫 cache/ gen/（gitignore 路徑），\n永不寫要進 git 的檔（version.toml、初始檔、baseline）", 360)
b.box("t4", L, 7, D2, "metadata 最後\n合併版本 ＝\nversion.toml？", 160, 90)
b.box("t4c", E, 7, D12, "CI=1？", 110, 70, ax="l")
b.box("t4r", E, 7, R2, "1：baseline 落後 version.toml\n（印 upgrade 指令）", 260, 70, ax="r")
b.box("t5", E, 8, W2, "warn「baseline 落後，請 just vendor_kit upgrade <repo>」\n（繼續，不擋）", 400)
b.box("z0", L, 9, W12, "迴圈結束 → 重生 gen/tools.just\n（每工具一行 mod）與 gen/.stamp", 280)
b.box("z1", P, 9, F12, "gen/tools.just、gen/.stamp（不進 git）", 360)
b.box("z2", U, 9, G12, "0：接著跑原本的 recipe", 220)
b.H("ne1", "n0", "n1"); b.H("ne2", "n1", "n2", "讀"); b.D("ne3", "n1", "n3")
b.H("ne4", "n3", "n4", "否"); b.H("ne5", "n4", "n5"); b.D("ne6", "n3", "t0", "是")
b.H("te0", "t0", "t0s", "是"); b.D("te1", "t0", "t1", "否")
