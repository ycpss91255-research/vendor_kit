b.D("ae9", "a8l", "a8dq", al=True); b.H("ae9x", "a8dq", "a8dx", "否"); b.D("ae9d", "a8dq", "a8d", "是", al=True); b.D("ae9z", "a8d", "a8z", "", 0.5, 0.3)
