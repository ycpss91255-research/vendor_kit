b.D("ae1", "a0", "a1", "", 0.5, 0.5); b.H("ae2", "a1", "a2", "否"); b.D("ae3", "a1", "a3", "是", al=True)
b.H("ae4", "a3", "a4", "否"); b.D("ae5", "a3", "a0l0", "是", al=True); b.D("ae5l", "a0l", "a1v", al=True)
