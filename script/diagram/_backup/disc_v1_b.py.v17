bypass(F, p5c, "ie1y", "i1i", "i1")
foot(p5c, "p5c", F.y, [t for t in T5I if not t[0].startswith(("install 進度檔", "上次產物", "暫存目錄"))], ALL - {"inv", "tree", "pend"} | {"entry"})
