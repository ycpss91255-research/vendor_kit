footer(b, F, 15, [("d8", v2(G12), "0：之後每次 just 用 <dir>", E, "l"), ("d6x", v2(R12), fl("1：失敗（任一步，共通匯流）→ 進度檔保留，下次可寫動詞先恢復"), P, "c")], spacer=1, sp="l")
