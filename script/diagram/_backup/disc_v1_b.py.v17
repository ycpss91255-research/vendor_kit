b.box("x5cg", E, 5, v2(SUB), fl("刪 config.toml（hash == baseline/vendor_kit/config.toml 副本才刪；被改過 → 保留並列出，v2.13 P6）"), 400)
b.box("x5cgf", P, 5, v2(F12), "－config.toml（進 git；只刪未改過的）", 360)
