b.D("be8apy", "b8ap", "b8a", "是", al=True); b.H("be8apn", "b8ap", "b8no", "否")
b.H("be11px", "b8p", "b8px", "失敗"); b.H("be12bx", "b8b", "b8bx", "失敗")
