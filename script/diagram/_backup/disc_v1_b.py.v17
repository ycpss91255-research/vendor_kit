b.D("de2cc", "d2cq", "d2c", "是", al=True); b.D("de2i", "d2c", "d2c2"); b.H("de3", "d2c2", "d3", "寫"); b.D("de2j", "d2c2", "d2c3"); b.H("de3s", "d2c3", "d3s", "寫"); b.D("de2v", "d2c3", "d2v"); b.D("de2vq", "d2v", "d2vq", al=True)
