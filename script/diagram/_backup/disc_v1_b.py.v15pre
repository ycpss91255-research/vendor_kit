b.box("m10gf", P, 14, v2(F12), "－.vendor_kit/.tmp.remove.<id>.toml", 360)
footer(b, F, 15, [("m11", G12, "0：印「以下初始檔保留，若不需要請 git rm：…」", E, "l"), ("m10x", v2(R12), "1：寫入失敗（本段任一步），明列已完成／未完成；版本鎖定行不動、進度檔保留", P, "c")], spacer=3, sp="l")
b.D("me11e", "m9e", "m9l"); b.H("me11f", "m9l", "m9lf", "寫"); b.D("me11h", "m9l", "m9h", al=True)
b.LD("me11hn", "m9h", "m10a", "無", busx=535, vert="left"); b.D("me11q", "m9h", "m9q", "有", al=True)
