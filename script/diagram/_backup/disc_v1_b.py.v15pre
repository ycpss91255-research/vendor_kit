b.box("n1", L, 2, v2(W12), fl("grep version.toml 的 vendor_kit 版本鎖定行取引擎 ref（命中須恰 1；version.local.toml 本機覆寫優先）"), 280)
b.files("n2", P, 2, "讀", [".vendor_kit/version.toml（進 git）", ".vendor_kit/version.local.toml（不進 git，dev 用）"], 360)
