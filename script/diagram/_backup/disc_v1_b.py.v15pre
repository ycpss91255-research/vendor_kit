for _s in ("s_un", "s_del", "s_um", "s_dq", "s_ap", "s_dd", "s_nd", "s_eq", "s_bk"): sidebus(F, p7b, f"ce_{_s}", _s, "c_skip", "", busx=450)
for _q, _lab in (("q1c", "是（要建 X 嗎）"), ("q3c", "是（再問要建 X 嗎）"), ("q4", "是（要替換嗎？）"), ("q8", "是（二進位換成新版？）")):
    sidebus(F, p7b, f"ce_{_q}y", _q, "c_ask", _lab, busx=1230, side="r", tx=0.5, pos=-0.9, vert="below")
_A = F.abs; _ex = _A["q9"][0] + 0.3 * _A["q9"][2]; _tx = round((_ex - _A["c_ask"][0]) / _A["c_ask"][2], 3)
p7b.append(_edge("ce_9n", "q9", "c_ask", "否", (0.3, 1), (_tx, 0), [], -0.5, True))   # 三者皆異 → 問三方合併（同一出口橢圓）
b = F.band("uC2", "C′ 衝突重入（解完衝突後再跑 upgrade；v2.2 D (0)）—— 偵測在 resolve，清除在 apply（拿鎖、建進度檔後）", v2=True)
