footer_edges(F, [("de14", "d6d", "", "d", "d8"), ("de6x", "d6", "失敗", "rb", "d6x", 0.9), ("de7x", "d7", "失敗", "rb", "d6x", 0.9), ("de13x", "d7b", "失敗", "rb", "d6x", 0.9)])
