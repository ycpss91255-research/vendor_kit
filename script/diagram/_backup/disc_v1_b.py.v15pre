b.D("be25", "b15d", "b15g"); b.H("be25f", "b15g", "b15gf", "寫"); b.D("be25q", "b15g", "b16q0", al=True); b.D("be25g", "b16q0", "b16", "否", al=True); b.H("be27", "b16", "b16f", "寫")
