b.box("m9a", E, 10, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("m9x", U, 11, v2(O12), "1 + 6-12：指紋不同「請重跑」", 220)
b.box("m9b", E, 11, v2(D12), "重驗指紋：相同？", 340, ax="l")
b.box("m9cx", U, 12, v2(O12), "1：原 argv 與計畫不一致，請重跑", 220)
b.box("m9c", E, 12, v2(D12), ARGV_Q, 340, ax="l")
b.box("m7cx", U, 13, v2(O12), fl("1：印需改清單（CI 模式；請在本機執行後 commit 並 push）"), 220)
b.box("m7c", E, 13, v2(D12), "是 → CI 模式且需改任何進 git 的檔？", 340, ax="l")
b.box("m7y", U, 14, v2(G12), "0：只印清單（會刪什麼、會問什麼）", 220)
b.box("m7", E, 14, D12, "否 → --dry-run？", 240, ax="l")
b.box("m7z", E, 15, ENTRY, "續「remove（2）」頁：建進度檔 → 問 append 行 → 刪檔 → 刪進度檔", 400, ax="l")
