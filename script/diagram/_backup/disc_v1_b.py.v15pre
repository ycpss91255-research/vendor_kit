b.box("m10m", E, 10, v2(SUB), "否：刪 metadata .vendor_kit.toml（目錄空則一併移除）", 300, ax="l")
b.box("m10mf", P, 10, F12, "－baseline/<repo>/.vendor_kit.toml（進 git）", 360)
b.box("m10b", E, 11, v2(SUB), fl("刪 cache/<repo>/ 並重生 gen/tools.just（去掉該工具所有 mod? 行；同一次原子替換，I17）"), 400)
b.files("m10bf", P, 11, "同一次原子替換（不進 git）", ["－cache/<repo>/", "gen/tools.just（少 mod? 行）"], 360, cols=2)
b.box("m10c", E, 12, v2(SUB), "刪 gen/<repo>.stamp", 400)
b.box("m10cf", P, 12, F12, "－gen/<repo>.stamp（不進 git）", 360)
b.box("m10e", E, 13, v2(SUB), "最後刪 version.toml 該工具的版本鎖定行", 400)
