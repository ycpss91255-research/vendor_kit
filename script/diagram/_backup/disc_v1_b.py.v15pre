b.box("d6p", E, 8, v2(SUB), fl("建進度檔 .tmp.dev.<id>.toml（記覆寫行、symlink 目標、印記第一行；第一個寫入前）"), 400)
b.box("d6pf", P, 8, v2(F12), "＋.vendor_kit/.tmp.dev.<id>.toml（進度檔，不進 git）", 360)
b.box("d6", E, 9, v2(SUB), fl("寫 version.local.toml：[tools].<repo> = \"path:<dir>\"（.vendor_kit/.gitignore 已排除它；不碰 .git/info/exclude）"), 400)
