b.box("d6df", P, 12, v2(F12), "－.vendor_kit/.tmp.dev.<id>.toml", 360)
footer(b, F, 13, [("d8", v2(G12), "0：之後每次 just 用 <dir>", E, "l"), ("d6x", v2(R12), fl("1：失敗（任一步）→ 進度檔保留，下次可寫動詞先恢復"), P, "c")], spacer=3, sp="l")
