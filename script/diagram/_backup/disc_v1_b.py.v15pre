b.box("s13cq", E, 8, v2(D12), "是 → config.toml conflicts 非空？", 260, ax="l")
b.box("s14", G, 9, v2(O12), fl("1 + 6-2：已升級引擎 vX → vY 並重產薄殼，請 commit .vendor_kit/ 並再跑原指令"), 200)
b.box("s13k", E, 9, v2(D12), "否 → 本次換了引擎（進度檔的舊 ref ≠ 本引擎）？", 260, ax="l")
footer(b, F, 10, [("s13xn", v2(R12), fl("1：第一行未變、重產失敗（印原因；引擎未鎖定新版，不是 6-2b）"), L, "c"), ("s14b", v2(O12), fl("1 + 6-2：同引擎修復重產薄殼（版本未變），請 commit .vendor_kit/ 並再跑原指令"), E, "l")])
b.D("se18z", "s13z0", "s13b"); b.H("se18", "s13b", "s13bf", "寫"); b.D("se18b", "s13b", "s13c"); b.H("se18c", "s13c", "s13cf", "寫")
