# ================= P8bc：uninstall（1）=================
p8bc, F = newpage("流程 v2：uninstall（1）resolve → apply 前置（§2；v2.2 E、v2.3 §6、v2.5 §3／§10、v2.15-4）", N8B, COLS5)
b = F.band("vD", "uninstall（1）：全部拆掉（install 的反向）= resolve（完整預檢 → hash → 保護清單 → 引擎內算計畫／詢問清單 → 指紋 → stdout 只傳協定內容）→ apply 前置（拿鎖、重驗、argv、CI 模式、dry-run）；寫入段見「uninstall（2）」頁；不 rm -rf .vendor_kit/", v2=True)
b.box("x0", U, 0, G12, "just vendor_kit uninstall（-y、--dry-run）", 220)
b.box("x0l", L, 0, v2(W12), fl(LS_T), 220)
b.box("x0x", G, 0, v2(R12), fl(LSX), 200)
b.box("x1", L, 1, v2(W12), "docker run <引擎> resolve uninstall（不經 extract）", 280)
b.box("x1e", E, 1, v2(SUB), "resolve（不寫任何檔）：讀 version.toml、version.local.toml、各 metadata", 400)
b.box("x2x", U, 2, v2(O12), fl("1：預檢不過（dev 中 → 請先 undev；未完成接入 → 請先 add…）→ 整體不動、原因全列"), 220)
b.box("x2", E, 2, v2(D12), fl("完整預檢全部工具通過？（每個工具：本機覆寫中？未完成接入？metadata 可解析？任一不過整體不動）"), 400, ax="l")
b.box("x2b1", E, 3, v2(SUB), fl("是：算進 git 的自產檔 hash（薄殼五檔、version.toml、config.toml、基準版根檔含 .gitkeep）"), 400)
b.box("x2b2", E, 4, v2(SUB), fl("算本機產物 hash（gen/、cache/；version.local.toml 不算、直接刪）"), 400)
b.box("x2bb", E, 5, v2(SUB), fl("分類：hash 相符 → 可刪清單；未知或被改的 → 保護清單（之後一律保留並回報）"), 400)
b.box("x2r", P, 5, v2(RULE), fl("保護清單在任何 remove 之前生效（v2.5 §10）：約束下一格的計畫與「uninstall（2）」頁的逐工具 remove（保護模式：清單內的檔跳過）"), 360)
b.box("x2c", E, 6, v2(SUB), fl("引擎內算執行計畫：可刪清單＋保護清單（逐工具 remove 的順序；不經 stdout，apply 重算）"), 400)
b.box("x2d", E, 7, v2(SUB), fl("引擎內算詢問清單：append 行、根 justfile 那行、根 .dockerignore 四行（由 apply 執行詢問）"), 400)
b.box("x2e", E, 8, v2(SUB), fl("產生輸入指紋（同 add（1）頁「輸入指紋」）"), 400)
b.box("x2e2", E, 9, v2(SUB), fl("stdout vk-resolve/1：指紋、apply|yes（無 pull／extract；只傳協定內容）"), 400)
b.box("x1qx", U, 10, v2(R12), fl("1 + 6-30：stdout 文法不合；resolve 非 0 → 原碼傳出"), 220)
b.box("x1q", L, 10, v2(D12), fl("resolve 回 0 且 vk-resolve/1 文法合法？"), 280)
b.box("x1b", L, 11, v2(W12), fl("是：docker run … -v（含 vk-resolve）<引擎> apply uninstall（--dry-run 原樣轉發）"), 280)
b.box("x4a", E, 11, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("x4bx", U, 12, v2(O12), "1 + 6-12：指紋不同「請重跑」", 220)
b.box("x4b", E, 12, v2(D12), "重驗指紋：相同？", 340, ax="l")
b.box("x4cx", U, 13, v2(O12), "1：原 argv 與計畫不一致，請重跑", 220)
b.box("x4c", E, 13, v2(D12), ARGV_Q, 340, ax="l")
b.box("x3cx", U, 14, v2(O12), fl("1：印需改清單（CI 模式；請在本機執行後 commit 並 push）"), 220)
b.box("x3c", E, 14, v2(D12), "是 → CI 模式且需改任何進 git 的檔？", 340, ax="l")
b.box("x3y", U, 15, v2(G12), "0：只印會刪什麼、會問什麼", 220)
b.box("x3", E, 15, D12, "否 → --dry-run？", 240, ax="l")
b.box("x4z", E, 16, ENTRY, "續「uninstall（2）」頁：建進度檔 → 逐工具 remove → 刪自產檔 → 根 justfile 那行 → 刪進度檔", 400, ax="l")
b.H("xe1", "x0", "x0l"); b.H("xe1x", "x0l", "x0x", "失敗"); b.D("xe1l", "x0l", "x1", al=True); b.H("xe1e", "x1", "x1e"); b.D("xe2", "x1e", "x2", al=True); b.H("xe3", "x2", "x2x", "否")
b.D("xe4", "x2", "x2b1", "是", al=True); b.D("xe4a", "x2b1", "x2b2"); b.D("xe4b", "x2b2", "x2bb"); b.D("xe4c", "x2bb", "x2c"); b.D("xe4d", "x2c", "x2d"); b.D("xe4e", "x2d", "x2e"); b.D("xe4e2", "x2e", "x2e2")
b.D("xe5", "x2e2", "x1q", "", 0.5, 0.5); b.H("xe5qx", "x1q", "x1qx", "否"); b.D("xe5b", "x1q", "x1b", "是", al=True); b.H("xe5be", "x1b", "x4a"); b.D("xe5c", "x4a", "x4b", al=True); b.H("xe5x", "x4b", "x4bx", "否"); b.D("xe5d", "x4b", "x4c", "是", al=True); b.H("xe5cx", "x4c", "x4cx", "否")
b.D("xe5e", "x4c", "x3c", "是", al=True); b.H("xe5ex", "x3c", "x3cx", "是"); b.D("xe5f", "x3c", "x3", "否", al=True); b.H("xe6", "x3", "x3y", "是"); b.D("xe7", "x3", "x4z", "否", al=True)
b.close()
foot(p8bc, "p8bc", F.y, _t8b("append 行", "config.toml"), ALL - {"inv", "tree", "pend", "note"} | {"entry"})
addpage("v1p8bc", "流程 v2：uninstall（1）resolve → apply 前置", p8bc)

# ================= P8bcc：uninstall（2）寫入段 =================
p8bcc, F = newpage("流程 v2：uninstall（2）apply 寫入段（§2；v2.2 E、v2.3 §6、v2.5 §3／§10、v2.13 P6、v2.15-8／-14）", N8B, COLS5)
b = F.band("vD2", "uninstall（2）寫入段（承「uninstall（1）」頁）：進度檔 → 逐工具 remove（保護模式）→ 只刪 hash 相符的自產檔 → justfile 那行、.dockerignore 四行問後刪 → 最後刪 version.toml → 刪進度檔；.vendor_kit/ 保留（只剩 log/）", v2=True)
b.box("x4e", E, 0, ENTRY, "來自「uninstall（1）」頁：apply 檢查通過（非 dry-run；已寫 launcher_started）", 300)
