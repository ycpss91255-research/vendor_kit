b.box("n3", L, 3, v2(D12), fl("gen/.stamp 的引擎 ref ＝ 版本鎖定行？（缺 gen/.stamp → 改以薄殼自描述首行 engine= 比對）"), 280)
b.box("n6", P, 3, v2(RULE), fl("統一提示（Q10 (2)、v2.3 §2）：啟動器發現 gen/.stamp ≠ 引擎 ref → 退出 1 印 6-1「vendor_kit 已更新 vX → vY，請執行：just vendor_kit upgrade vendor_kit」；不自動重寫、不自動續跑；install／升引擎不受此關"), 360)
b.box("nq", L, 4, v2(D12), fl("快路徑：grep 全相符且非 CI 模式？"), 240, ax=20)
b.box("nqr", P, 4, v2(RULE), fl("快路徑（Q22）：啟動器只 grep：[tools] 每行 digest == gen/<repo>.stamp 第一行（或 path:<dir>）；gen/tools.just 存在；無 .tmp.<verb>.*.toml；非 CI 模式；sync 無參數。全相符 → 寫執行紀錄後 0；否則起引擎；每檔 sha256 只在 sync --verify、CI 模式、或版本變動的那次才做（§3.6）"), 360)
b.box("nq0", U, 5, v2(G12), fl("0：不起容器，接著跑原本的 recipe（快路徑）"), 220)
b.box("nqf", L, 5, v2(W12), fl("是：執行紀錄寫 sync_fast_path"), 100, ax="l")
b.box("n6b", P, 5, v2(RULE), fl("薄殼重產（v2.2 A、Q10 (2)、Q17）：只由 install 與升引擎做；做之前比對現內容 == 上次產物（自描述首行 hash），相同 → 重產，被改過 → 1 列差異不動；sync 永不寫薄殼"), 360)
b.box("n1i", L, 6, v2(D12), "否 → docker image inspect：本機有？", 180, ax=50)
