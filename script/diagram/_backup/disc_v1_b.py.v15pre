_A = F.abs
def _lbus(eid, s, t, label, busx=610):   # 引擎格左側出線 → x=busx 往下 → 進 t 右側（啟動器欄的跨頁出口）
    sx0, sy0, sw, sh = _A[s]; tx0, ty0, tw, th = _A[t]; ey = sy0 + sh / 2; ny = ty0 + th / 2
    p7bcd.append(_edge(eid, s, t, label, (0, 0.5), (1, 0.5), [(busx, ey), (busx, ny)], -0.7 if label else None, "below" if label else None))
_lbus("se16x", "s13", "s13qx", "失敗"); _lbus("se17mx", "s13gm", "s13qx", "失敗（任一步）")
foot(p7bcd, "p7bcd", F.y, _t7e("多工具", "--protocol", "docker image inspect", "原 argv", "6-12", "resolve", "6-2b") + [E22_T, E4_T], ALL - {"inv", "tree", "pend", "rule"} | {"entry", "tty"})
