b.box("s2c2", E, 11, v2(D12), ARGV_Q, 260, ax="l")
b.box("s2d", E, 12, v2(SUB), fl("是 → 建進度檔 .tmp.upgrade.<id>.toml（記舊引擎 ref、目標引擎 ref、計畫 image ID；改第一行之前）"), 360)
b.box("s2df", P, 12, v2(F12), "＋.vendor_kit/.tmp.upgrade.<id>.toml（進度檔，不進 git；新引擎重產薄殼完成後才刪）", 280)
