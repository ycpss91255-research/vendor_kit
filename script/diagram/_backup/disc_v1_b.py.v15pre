# ================= P5c：install（1）主機檢查 → 比對 → 進度檔 → 產薄殼到暫存 =================
T5I = [t for t in T5 if not t[0].startswith(("release／tar", "--local", "bootstrap.sh", "docker image inspect", "6-18", "resolve"))]   # install 三頁不談離線包／bootstrap
T5I += [("install 進度檔", ".tmp.install.<id>.toml：拿鎖、比對薄殼之後、第一個寫入（含暫存檔）之前建；第一次也建 = 「不留半成品」的清除清單；最後一步（install（2）頁）刪；未完成 → 下次可寫動詞先恢復"),
        ("上次產物", "薄殼每檔自描述首行的 sha256 與其餘內容相符（Q17）= 是引擎上次產出、未被人改 → 可重產；不符 → 1 + 6-28 列差異、零寫入")]
p5c, F = newpage("流程 v2：install（1）主機檢查 → 比對薄殼 → 進度檔 → 產薄殼到暫存（§0／§2、Q17／Q20、v2.15-11）", N5I, COLS5)
