def lane(bid, title, y, h=150):
    d0.append(v(bid, "1", SW(NEUTRAL), title, 40, y, 1620, h))
def chain(bid, items, y=55, x0=30, gap=30, h=50):
    """items: (id, style, text, w[, h])；有給 h 的格子垂直置中對齊同列。"""
    x = x0; prev = None
    for cid, st, text, w, *rest in items:
        hh = rest[0] if rest else h
        d0.append(v(cid, bid, st, text, x, y + (h - hh) / 2, w, hh))
        if prev: d0.append(e(f"{cid}_e", prev, cid, "", (1, 0.5), (0, 0.5)))
        prev = cid; x += w + gap
