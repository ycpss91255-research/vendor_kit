foot(p8, "p8", F.y, [
 ("dev／undev", "用本機工具 repo 的 dist/ 取代 image（開發工具本身用；工具必須已在 version.toml）／回到 version.toml 鎖定版；dev 自身則是換引擎 image"),
 ("覆寫兩種（v2.1 B）", "工具 path 覆寫 <repo> = \"path:<dir>\"：cache/<repo>/ 變 symlink，sync 跳過該工具 materialize／verify 但仍檢查 metadata、baseline；引擎 tag 覆寫 vendor_kit = \"<tag>\"：啟動器改用該本機 image 起容器"),
 ("version.local.toml", ".vendor_kit/version.local.toml，不進 git（.vendor_kit/.gitignore 排除；不碰 .git/info/exclude）；記 <repo> = \"path:<dir>\" 或 vendor_kit = \"<tag>\" + image ID"),
 ("symlink", "符號連結 = 指向另一個路徑的捷徑：dev 時 cache/<repo>/ 不放檔案，而是指到 <dir>/dist；印記第一行 path:<dir>"),
 ("image tag／image ID／RepoDigests", "tag = 人取的版本名（可重 build 換內容）；image ID = 本機 image 內容的 ID（v2.2 B 一併記下，同 tag 重 build 才會被發現）；RepoDigests = 從倉庫拉來才有的 digest，docker load 的 tar 沒有，所以自身 dev 只能用 tag"),
 ("--pull never／掛載 -v", "docker run --pull never = 只用本機 image，不去 GHCR 拉；-v <dir>/dist:/dist/<repo>:ro = 把本機目錄唯讀掛進容器"),
 ("統一提示／薄殼（Q10 (2)）", "引擎 ref（含本機 tag 覆寫）≠ gen/.stamp → sync 只退出 1 印「請 just vendor_kit upgrade vendor_kit」；upgrade vendor_kit 比對現薄殼 == 上次產物（hash）才重產薄殼 + gen；薄殼 = vendor_kit 自己的 tracked 檔"),
 ("materialize／印記／index digest", "把 image 的 /dist 展開到 cache/<repo>/；印記 .stamp 第一行 = index digest（多架構 image 總目錄的 sha256 ID）或 path:<dir>"),
 ("metadata／baseline", "baseline/<repo>/.vendor_kit.toml：完成標記、最後合併版本等；dev 中 sync 仍檢查這兩項（未完成接入 → 1；baseline 落後 → warn／CI 1）"),
 ("flock／CI", "flock = 專案目錄鎖（60 秒），鎖在引擎；CI = 自動測試環境，CI=1 時 dev 一律拒絕、sync 看到任何覆寫 → 1"),
], ALL - {"inv", "pend"})
pages_v1_b.append(("v1p8", "流程 v2：dev / undev", p8))

# ================= P8b：remove / uninstall =================
p8b = [v("title", "1", TITLE, "流程 v2：remove／uninstall（§2、§5 remove 列；v2.1 A／E、v2.2 E；<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p8b, "⚠ 待拍板（proposal_v2 §9）\n(5) append 行的「原文比對」（remove／uninstall 只刪原文相同的行）在 CRLF／尾端空白時的判定（第一版：嚴格相同；不同就不刪、印清單）。")
F = Flow(p8b, COLS5); F.headers(ny + 8)
b = F.band("vC", "remove <repo>：拆掉一個工具（初始檔永不刪、印清單；append 行問後只刪原文相同的；不開 --purge，要刪用 git rm）= resolve → apply（無 image 要拉）", v2=True)
b.box("m0", U, 0, G12, fl("just vendor_kit remove <repo>\n（-y、-n/--dry-run）"), 220, extra=10)
b.box("m1", L, 0, v2(W12), fl("docker run <引擎> resolve remove <repo>"), 280)
b.box("m2", E, 0, D12, fl("已接入？"), 130, 70, ax="l")
b.box("m3", E, 0, G12, fl("0：未接入（提示）"), 200, ax="r")
b.box("m4", E, 1, D12, "有 dev path\n覆寫？", 130, 76, ax="l")
b.box("m5", E, 1, R12, fl("1：請先 undev <repo>\n（v2.1 B）"), 200, ax="r")
b.box("m6", E, 2, v2(SUB), fl("resolve（不寫）：先讀 metadata（append 過的行、完成標記）→ 列要刪的：\nversion.toml 行、cache/、baseline/、gen 的 mod 行；要問的 append 行；輸出指紋"), 400)
b.box("m7", E, 3, D12, "--dry-run？", 130, 70, ax="l")
b.box("m7y", E, 3, v2(G12), "0：只印清單（會刪什麼、\n會問什麼），不動任何檔", 200, ax="r")
b.box("m8", L, 4, v2(W12), "docker run <引擎> apply remove <repo>", 280)
b.box("m9", E, 4, SUB, fl("apply：flock → 重驗指紋 → 問「要刪我們加的這幾行嗎」\n（-y 免問）→ 只刪原文相同的行（找不到 → 不刪、印清單）"), 400)
b.box("m9f", P, 4, F12, "初始檔（只移除我們 append 的行；其餘不動；永不刪檔）", 360)
b.box("m10", E, 5, v2(SUB), fl("刪 baseline/<repo>/（含 metadata）、cache/<repo>/、\ngen/tools.just 該工具所有 mod 行 → 最後刪 version.toml 該行"), 400)
b.box("m10f", P, 5, F12, fl("－baseline/<repo>/ －cache/<repo>/\n－gen/tools.just 該工具 mod 行 －version.toml <repo> 行"), 360)
b.box("m11", U, 5, G12, "0：印「以下初始檔保留，\n若不需要請 git rm：…」", 220, extra=10)
b.H("me1", "m0", "m1"); b.H("me2", "m1", "m2"); b.H("me3", "m2", "m3", "否"); b.D("me4", "m2", "m4", "是")
b.H("me5", "m4", "m5", "是"); b.D("me6", "m4", "m6", "否", al=True); b.D("me7", "m6", "m7", al=True)
b.H("me8", "m7", "m7y", "是"); b.D("me9", "m7", "m8", "否"); b.H("me10", "m8", "m9"); b.H("me11", "m9", "m9f", "寫")
b.D("me12", "m9", "m10"); b.H("me13", "m10", "m10f", "刪"); b.H("me14", "m10", "m11")
b.close()
b = F.band("vD", "uninstall：全部拆掉（install 的反向；bootstrap.sh 的反向也是它）—— 先預檢全部工具；不 rm -rf .vendor_kit/，只刪 hash 相符的自產檔（v2.2 E）", v2=True)
b.box("x0", U, 0, G12, "just vendor_kit uninstall\n（-y、-n/--dry-run）", 220, extra=10)
b.box("x1", L, 0, v2(W12), fl("docker run <引擎> uninstall\n（-n → 唯讀預覽，覆蓋所有刪改與詢問）"), 280)
b.box("x2", E, 0, v2(SUB), fl("預檢全部工具（dev 覆寫、\n未接入…），不動任何東西"), 250, ax="l")
b.box("x2x", E, 0, v2(R12), "預檢失敗 → 1\n（如 dev 中）", 130, ax="r")
b.box("x3", E, 1, D12, "--dry-run？", 130, 70, ax="l")
b.box("x3y", E, 1, v2(G12), "0：印會刪什麼、會問什麼，\n不動任何檔", 220, ax="r")
b.box("x4", E, 2, v2(SUB), "逐工具 remove（同上）", 200, ax="l")
b.box("x4x", E, 2, v2(R12), fl("任一工具失敗 → 1 中止，\n列出已完成部分"), 180, ax="r")
b.box("x5", E, 3, v2(SUB), fl("刪 .vendor_kit/ 內 hash 相符的自產檔（薄殼四檔、version.toml、\nversion.local.toml、baseline/、cache/、gen/）；未知或被改的保留並回報；\n最後目錄非空則保留"), 400)
b.box("x5f", P, 3, v2(F12), fl("－.vendor_kit/（自產檔）；初始檔留著\n使用者 .gitignore：除非工具以 append 模式\n經你同意加行，否則不碰（v2.1 A）"), 360)
b.box("x6", E, 4, D12, "根 justfile 有\n與我們寫的\n完全相同的行？", 170, 90, ax="l")
b.box("x7", E, 4, W12, "有：問「要刪這一行嗎」\n（-y 免問）同意 → 只刪那一行；\n拒絕 → 印指示", 210, ax="r")
b.box("x7f", P, 4, F12, "justfile（少一行）", 360)
b.box("x8", E, 5, W12, "無：不動 justfile；印指示\n「請自行移除那行 import」", 220, ax="l")
b.box("x9", U, 6, G12, "0：印摘要\n（保留的初始檔清單）", 220, extra=10)
b.H("xe1", "x0", "x1"); b.H("xe2", "x1", "x2"); b.H("xe3", "x2", "x2x"); b.D("xe4", "x2", "x3", al=True)
b.H("xe5", "x3", "x3y", "是"); b.D("xe6", "x3", "x4", "否", al=True); b.H("xe7", "x4", "x4x"); b.D("xe8", "x4", "x5", al=True)
b.H("xe9", "x5", "x5f", "刪"); b.D("xe10", "x5", "x6", al=True); b.H("xe11", "x6", "x7", "有"); b.H("xe12", "x7", "x7f", "寫")
b.D("xe13", "x6", "x8", "無", al=True); b.D("xe14", "x7", "x9"); b.D("xe15", "x8", "x9")
b.close()
foot(p8b, "p8b", F.y, [
 ("remove", "刪 version.toml 行、cache/<repo>/、baseline/<repo>/、gen 內該工具所有 mod 行；初始檔永不刪、印清單；append 行問後只刪原文相同的；先讀 metadata 再刪 baseline"),
 ("uninstall（v2.2 E）", "先預檢全部工具 → 逐工具 remove（任一失敗即中止並列出已完成部分）→ 只刪 .vendor_kit/ 內 hash 相符的自產檔（未知／被改的保留並回報，目錄非空則保留）→ 根 justfile 那行問「要刪這一行嗎」（-y 免問），只刪與我們寫的完全相同的行"),
 ("resolve／apply／dry-run", "resolve 只讀只算（讀 metadata、列清單、輸出指紋）；apply 拿 flock 後重驗指紋才刪；-n/--dry-run 只印會刪什麼、會問什麼，覆蓋所有刪改與詢問"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源 ref@digest、最後合併版本、完成標記、append 過的行；remove 先讀它（append 行）再刪 baseline/"),
 ("append 行", "add 時問後加進使用者檔（.gitignore 類）的行，記在 metadata；remove／uninstall 問後只刪原文相同的；不同就不刪、印清單"),
 ("初始檔", "init.toml 複製到專案的檔（歸使用者、進 git）；remove／uninstall 都不刪；--purge 不開（用 git rm）"),
 ("hash 相符的自產檔", "hash = 檔案內容的指紋；uninstall 只刪「內容 == 我們上次產出」的檔（薄殼、version.toml、baseline、cache、gen），使用者改過或不認識的檔一律保留並回報"),
 ("dev 覆寫", "version.local.toml 的 <repo> = \"path:<dir>\"；工具在 dev 中 → remove 回 1 提示先 undev；uninstall 預檢時一併擋"),
 ("gen／mod", "gen/tools.just 每個 <ns>.just 一行 mod（掛成 just 命名空間）；remove 刪該工具的所有 mod 行"),
 ("指紋／flock", "resolve 輸出讀過的檔的 hash，apply 重驗（不同 → 1 請重跑）；flock = 專案目錄鎖（60 秒），鎖在引擎"),
], ALL - {"inv", "rule", "tree"})
pages_v1_b.append(("v1p8b", "流程 v2：remove / uninstall", p8b))
