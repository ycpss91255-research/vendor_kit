b.H("ie1", "i0", "i1"); b.H("ie2", "i1", "i2"); b.H("ie3", "i2", "i3", "否")
b.D("ie4", "i2", "i4", "是", al=True); b.H("ie4x", "i4", "i4x"); b.U("ie5", "i4", "i4f", "寫", 0.8, 0.5)
b.D("ie6", "i4", "i5", al=True); b.H("ie7", "i5", "i5y", "是"); b.D("ie8", "i5", "i6", "否")
b.H("ie9", "i6", "i7", "無"); b.H("ie10", "i7", "i7f", "寫"); b.D("ie11", "i6", "i8", "有")
b.H("ie12", "i8", "i9", "是"); b.D("ie13", "i8", "i10", "否")
b.H("ie14", "i10", "i11", "是"); b.H("ie15", "i11", "i11f", "寫"); b.D("ie16", "i10", "i12", "否")
b.LU("ie17", "i12", "i11", "是"); b.D("ie18", "i12", "i13", "否", al=True)
b.close()
foot(p5, "p5", F.y, [
 ("bootstrap.sh", "release 附的 POSIX sh 薄層：檢查 git repo／just ≥ 1.33 → docker pull 引擎（--local 用本機 image）→ 呼叫 install → 對每個 --tool 呼叫 add；再跑 = install；不自刪"),
 ("release／tar／docker load", "release = GitHub 上發布的一版（附 bootstrap.sh）；tar = 離線包（docker save 存的 image 檔）；docker load = 把 tar 讀進本機 docker"),
 ("GHCR／image／引擎 ref", "GHCR = GitHub 的容器倉庫；image = 打包好的檔案集；引擎 ref = version.toml 第一行指到的引擎 image（ghcr.io/…/vendor_kit:vN@sha256:…）"),
 ("install／uninstall", "專案層一對（vendor_kit 自己）：把 vendor_kit 裝進這個 git repo（建 .vendor_kit/ 各檔＋根 justfile 一行）／全部拆掉；不開 init、--repair"),
 ("薄殼 .vendor_kit/", ".gitignore、entry.just、vendor.just、ci/check.sh（進 git；vendor_kit 自己的檔，人不改）＋ version.toml、baseline/（進 git）＋ cache/、gen/、version.local.toml（不進 git）"),
 ("冪等／修復（v2.2 A、Q10 (2)）", "再跑結果一樣：justfile 已含那行就不再加；薄殼先比對「現內容 == 上次產物（hash 在 gen/.stamp）」才用引擎版重產，被改過 → 1 列差異不動；重產只由 install 修復與 upgrade vendor_kit 做"),
 ("暫存目錄／原子替換", "先寫到暫存目錄，確認沒問題再逐檔一次換上；第一次 install 失敗 → 丟棄暫存，專案不留任何檔（「不留半成品」只對第一次 install 成立）"),
 ("version.toml／version.local.toml", "version.toml 唯一來源（進 git）：第一行引擎 ref、[tools] 每工具一行 tag@digest；local 不進 git：dev 覆寫（工具 path:<dir>，或引擎 image tag + image ID）"),
 ("just／recipe／import", "just = 跑指令的工具（像 make）；recipe = justfile 裡的一條指令；import = 把另一個 just 檔載進根 justfile 的那一行"),
 ("docker pull／run／daemon／--pull never", "pull = 從 GHCR 下載 image；run = 用 image 起容器跑引擎；daemon = 主機的 docker 服務（多架構 image 由它挑原生平台）；--pull never = 只用本機 image"),
 ("flock／-y", "flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎，啟動器不鎖；-y = 免問（§1 不變量：對使用者的檔可建、要改先問、永不刪、永不覆蓋）"),
], ALL - {"inv", "tree"})
pages_v1_b.append(("v1p5", "流程 v2：bootstrap.sh + install", p5))

# ================= P5b：add =================
p5b = [v("title", "1", TITLE, "流程 v2：add <repo> ── §2 add 列、§5 初始檔規則、v2.1 C／E、v2.2 C／E（<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p5b, "⚠ 待拍板（proposal_v2 §9）\n(4) 初始檔 mode=\"append\" 在 init.toml 的欄位名（本頁 append 分支用到）。")
F = Flow(p5b, COLS5); F.headers(ny + 8)
b = F.band("bB", "5b add <repo>（bootstrap.sh 對每個 --tool 呼叫；平時使用者也直接打）= 引擎 resolve（不寫）→ 啟動器 docker → 引擎 apply（-n = apply --dry-run 唯讀預覽）", v2=True)
b.box("c0", U, 0, G12, "just vendor_kit add <repo>\n（-t <tag>、-s <image>、\n--local <tar>、-y、-n/--dry-run）", 220, extra=10)
b.box("c1", L, 0, v2(W12), fl("docker run <引擎> resolve add <repo>\n（--local <tar> 先 docker load）"), 280)
b.box("c2", E, 0, v2(SUB), fl("resolve（不寫任何檔）：讀 version.toml；查 tag（預設最新／-t）\n與 digest（-s 改來源）→ stdout「vk-resolve/1」：要拉的\nimage@digest ＋ 輸入指紋（version.toml、metadata 的 hash）"), 400)
b.box("c3", G, 0, IMG, "ghcr.io/<org>/<repo>-dist\n（工具 image；多架構 index digest）", 220)
b.box("c4", E, 1, D12, "已接入？\n（version.toml\n有 <repo> 行）", 150, 90, ax="l")
b.box("c6", E, 2, G12, fl("0：已接入且完成，無變更\n（-t 與鎖定不同 → 1，\n提示改用 upgrade）"), 200, ax="r")
b.box("c5", E, 2, D12, "metadata 有\n完成標記？", 130, 80, ax=40)
b.box("c8", E, 3, W12, fl("否：續作，只做缺的步驟（不補使用者刻意刪的檔）"), 230, ax="r")
b.box("c9", L, 4, v2(W12), fl("docker pull（已有則略）→ docker create <image> /x\n→ docker cp c:/dist/. <tmp>/<repo>/ → docker rm\n（不帶 --platform；daemon 挑原生）"), 280)
b.box("c9g", G, 4, IMG, "<repo>-dist@digest\n（鎖定的那一版）", 220)
b.box("c10", L, 5, v2(W12), fl("docker run … -v <tmp>:/dist:ro\n<引擎> apply add <repo>（-n → apply --dry-run）"), 280)
b.box("c11", E, 5, v2(SUB), fl("apply：flock 專案目錄（60 秒）\n→ 重驗 resolve 的輸入指紋"), 250, ax="l")
b.box("c11x", E, 5, v2(R12), "指紋不同 → 1\n「請重跑」", 130, ax="r")
b.box("c12", E, 6, v2(SUB), fl("任何寫入前檢查 init.toml dest：copy/copy、\ncopy/append 同 dest（跨工具）、越出 repo、\n指向 .vendor_kit/ → 拒絕；append/append 允許\n（各工具的行分開記）；dist 含 symlink → 拒絕"), 250, ax="l")
b.box("c12x", E, 6, v2(R12), "1：dest 不合法\n（version.toml 未動）", 130, ax="r")
b.box("c13", E, 7, D12, "--dry-run？", 130, 70, ax="l")
b.box("c13y", E, 7, v2(G12), "0：唯讀預覽：印會建／會問\n哪些檔（不動任何檔）", 230, ax="r")
b.box("c14", E, 8, D12, "CI=1 且無 -y\n又需改檔？", 150, 80, ax="l")
b.box("c14x", E, 8, v2(R12), "1：印清單；\nversion.toml 未動", 230, ax="r")
b.box("c15", E, 9, SUB, fl("materialize：/dist/<repo> → 暫存 → cache/<repo>/、寫印記\n（第一行 index digest，之後每檔 sha256）"), 400)
b.box("c15f", P, 9, F12, "＋cache/<repo>/（不進 git）", 360)
b.box("cl", E, 10, LBL, "↓ 初始檔逐檔（init.toml 每個 [[file]]）", 300, 24, ax="r", minh=24)
b.box("c16", E, 11, D12, "初始檔\n已存在？", 130, 76, ax="l")
b.box("c17", E, 11, W12, "無：建（印出建了什麼）", 250, ax="r")
b.box("cr", P, 11, v2(RULE), fl("復原（v2.2 C）：合併全在暫存完成 → 逐檔原子替換\n＋ metadata 進度日誌（state=in-progress，列已完成／未完成）；\n失敗 → 1 明列，下次任何動詞先恢復；version.toml 最後寫"), 360)
b.box("c18", E, 12, D12, "mode=\n\"append\"？", 130, 80, ax="l")
b.box("c19", E, 12, W12, "否：不納管、不覆蓋，印\n「已存在，範本在 cache」", 230, ax="r")
b.box("c20", E, 13, W12, "是：問「要在 X 加這幾行嗎」\n（-y 免問）→ append，記 metadata", 250, ax="l")
b.box("c21", E, 14, SUB, fl("寫 baseline/<repo>/ + metadata（來源 ref@digest、\n最後合併版本、完成標記、append 過的行）"), 400)
b.box("c21f", P, 14, F12, "＋baseline/<repo>/ + .vendor_kit.toml（進 git）", 360)
b.box("c22", E, 15, v2(SUB), fl("重生 gen/tools.just（每個 <ns>.just 一行 mod；一工具可多行）"), 400)
b.box("c22f", P, 15, F12, "gen/tools.just（不進 git）", 360)
b.box("c23", E, 16, v2(SUB), fl("最後寫 version.toml [tools]：\n<repo> = \"…:<tag>@sha256:…\""), 250, ax="l")
b.box("c23x", E, 16, v2(R12), fl("失敗 → 1：明列已完成／\n未完成；version.toml 不動"), 130, ax="r")
b.box("c23f", P, 16, F12, "＋version.toml [tools] 行（進 git）", 360)
b.box("c24", U, 16, G12, "0：印摘要（建了／改了什麼）\n→ git add .vendor_kit/\n（version.toml、baseline/）與初始檔", 220, extra=10)
b.H("ce1", "c0", "c1"); b.H("ce2", "c1", "c2"); b.H("ce3", "c2", "c3", "查")
b.D("ce4", "c2", "c4", al=True); b.D("ce5", "c4", "c5", "是", al=True); b.H("ce6", "c5", "c6", "是"); b.D("ce7", "c5", "c8", "否")
b.D("ce8", "c4", "c9", "否", 0.15, 0.5); b.D("ce9", "c8", "c9"); b.H("ce10", "c9g", "c9", "拉 /dist")
b.D("ce11", "c9", "c10"); b.H("ce12", "c10", "c11"); b.H("ce13", "c11", "c11x")
b.D("ce14", "c11", "c12", al=True); b.H("ce15", "c12", "c12x"); b.D("ce16", "c12", "c13", al=True)
b.H("ce17", "c13", "c13y", "是"); b.D("ce18", "c13", "c14", "否"); b.H("ce19", "c14", "c14x", "是")
b.D("ce20", "c14", "c15", "否", al=True); b.H("ce21", "c15", "c15f", "寫"); b.D("ce22", "c15", "c16", al=True)
b.H("ce23", "c16", "c17", "無"); b.D("ce24", "c16", "c18", "有"); b.H("ce25", "c18", "c19", "否"); b.D("ce26", "c18", "c20", "是", al=True)
b.R("ce27", "c17", "c21", "", busx=990); b.R("ce28", "c19", "c21", "", busx=990); b.D("ce29", "c20", "c21", al=True)
b.H("ce30", "c21", "c21f", "寫"); b.D("ce31", "c21", "c22"); b.H("ce32", "c22", "c22f", "寫"); b.D("ce33", "c22", "c23", "", 0.3125, 0.5)
b.H("ce34", "c23", "c23x"); b.U("ce35", "c23", "c23f", "寫", 0.8, 0.5); b.H("ce36", "c23", "c24")
# 右側：add 前／後 專案目錄差異（不從流程拉線）
b.free("cf_l", LBL, "add 前 → 後（專案目錄；v2 = .vendor_kit/ 結構）", 1220, 44, 340, 24)
CF0 = "add 前（install 後）\n專案/\n├ justfile（＋1 行）\n└ .vendor_kit/\n   ├ version.toml\n   │  （vendor_kit 行）\n   ├ version.local.toml\n   │  （--local 時）\n   ├ .gitignore\n   ├ entry.just\n   ├ vendor.just\n   ├ ci/check.sh\n   └ baseline/（空）"
CF1 = "add 後（＋ = 新增）\n＋version.toml [tools]\n   加 <repo> 行\n＋cache/<repo>/\n   （不進 git）.stamp、\n   files/、init.toml、just/\n＋初始檔（init.toml 的\n   dest；append 問後加）\n＋baseline/<repo>/\n   + .vendor_kit.toml\n＋gen/tools.just 每個\n   <ns>.just 一行 mod\n   （不進 git）"
TH = max(fit_h(CF0, 170), fit_h(CF1, 170))
b.free("cf0", FTREE, CF0, 1220, 74, 170, TH)
b.free("cf1", v2(FTREE), CF1, 1410, 74, 170, TH)
b.P("cfe", "cf0", "cf1", "", (1, 0.5), (0, 0.5), ())
b.close()
foot(p5b, "p5b", F.y, [
 ("add", "接一個工具：resolve 查 tag/digest → 啟動器拉 image → apply：materialize → 初始檔逐檔 → baseline + metadata → 重生 gen/ → 最後寫 version.toml；已接入且完成 → 0 無變更"),
 ("resolve／apply（v2.1 C、v2.2 C）", "同一動詞分兩段：resolve 只讀只算（stdout 第一行 vk-resolve/1，一行一項，診斷走 stderr，啟動器不 eval）；apply 才寫；-n/--dry-run = apply --dry-run 唯讀預覽（也要先拉 image 才知道會問哪些檔）"),
 ("輸入指紋（v2.2 C）", "resolve 把它讀過的 version.toml、metadata、要動的使用者檔的 hash＋鎖定 digest 一起輸出；apply 拿到 flock 後重驗，不同（中間有人改了）→ 1「請重跑」"),
 ("GHCR／image／index digest", "GHCR = GitHub 的容器倉庫；image = 打包好的 dist/；多架構 image 的總目錄叫 index，其 digest（sha256）= 鎖定用的唯一 ID"),
 ("materialize／印記", "引擎內部步驟（非對外動詞）：把 /dist 展開到 .vendor_kit/cache/<repo>/；印記 .stamp 第一行 index digest，之後每檔 sha256（每檔的指紋，用來驗有沒有被改）"),
 ("初始檔／append 模式", "init.toml [[file]] src/dest [mode=\"copy\"|\"append\"]：copy 無→建、有→不納管；append（.gitignore 類）無→建、有→問「要加這幾行嗎」→ append 並記 metadata"),
 ("dest 撞名（v2.2 E）", "兩工具的 init.toml dest 指到同一路徑：copy/copy、copy/append → 拒絕；append/append → 允許（各工具的行分開記，重疊或歸屬不明 → 拒絕）；dest 正規化後不得越出 repo、不得指向 .vendor_kit/"),
 ("baseline／metadata", "baseline/<repo>/ 是上次合併的範本副本（歷史狀態，不是由 version.toml 推導）；.vendor_kit.toml 記來源 ref@digest、最後合併版本、完成標記、append 過的行、衝突中檔案、進度日誌"),
 ("續作", "add 對已接入工具只補「metadata 無完成標記」的未完成接入；不補使用者刻意刪的檔"),
 ("gen／mod／命名空間", "gen/tools.just（不進 git）每個 <ns>.just 一行 mod = 把工具的 just 檔掛成一個命名空間（just <ns> …）；一工具可有多個 <ns>.just；零 set 零 recipe"),
 ("CI／dry-run／daemon", "CI = 自動測試環境（CI=1 → frozen）；dry-run = 只預覽不動檔；daemon = 主機的 docker 服務（多架構 image 由它挑原生平台，不帶 --platform）"),
 ("flock", "專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎 version 模組；啟動器不鎖"),
], ALL - {"inv"})
pages_v1_b.append(("v1p5b", "流程 v2：add", p5b))

# ================= P6：sync（每次 just 都跑） =================
p6 = [v("title", "1", TITLE, "流程 v2：sync（每次 just 都跑）── §2／§6、v2.1 A／B／C、v2.2 A／B／E（<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p6, "已定（Q10 (2)）：sync 發現薄殼／gen 與 version.toml 引擎不符 → 只回 1 提示 just vendor_kit upgrade vendor_kit，不自動重寫薄殼；sync 仍只寫 cache/、gen/。\n註記（§9 (2)，已定）：sync 範圍 = 全部工具；每次只 grep 印記第一行（便宜），sha256 逐檔 verify 也每次跑。v1 的 ensure → 改名 sync。", style=NOTE)
F = Flow(p6, COLS5); F.headers(ny + 8)
b = F.band("eA", "sync 第 1 段：引擎 resolve sync（不寫任何檔；判斷全在引擎）—— vendor.just 的前置，任何 just 指令都先跑；CI=1 自動 frozen；v1 叫 ensure", v2=True)
b.box("n0", U, 0, G12, "打任何 just 指令\n（sync 自動前置）", 220, extra=10)
b.box("n1", L, 0, v2(W12), fl("grep version.toml 第一行取引擎 ref\n（version.local 的 vendor_kit 覆寫優先\n→ 用該本機 image，--pull never）\n→ docker run <引擎> resolve sync"), 280)
b.box("n2", P, 0, F12, ".vendor_kit/version.toml（進 git）\n.vendor_kit/version.local.toml（不進 git，dev 用）", 360)
b.box("nc", E, 1, v2(D12), "CI=1 且有\nlocal 覆寫？", 150, 76, ax="l")
b.box("ncx", E, 1, v2(R12), "1：CI 拒絕本機覆寫\n（frozen，v2.1 A）", 200, ax="r")
b.box("n6", P, 1, v2(RULE), fl("統一提示（Q10 (2)）：gen/.stamp ≠ 引擎 ref（薄殼／gen 與 version.toml 的引擎不符）→ sync 退出 1 印「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」；不自動重寫、不自動續跑（just 一開始即載入定義）"), 360)
b.box("n3", E, 2, D12, "gen/.stamp ＝\n引擎 ref？", 160, 80, ax="l")
b.box("n3n", E, 2, v2(R12), fl("1：印「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」（不重寫薄殼）"), 220, ax="r")
b.box("n6b", P, 2, v2(RULE), fl("薄殼重產（v2.2 A、Q10 (2)）：只由 upgrade vendor_kit 與 install 修復做；做之前比對現內容 == 上次產物（hash 在 gen/.stamp），相同 → 重產 vendor_kit 自有 tracked 薄殼（entry.just、vendor.just、.gitignore、ci/check.sh），被改過 → 1 列差異不動；sync 永不寫薄殼"), 360)
b.box("nl", G, 3, LBL, "← 對每個工具重複\n（範圍 = 全部；先比印記，便宜）", 220, 40, minh=40)
b.box("t0", E, 3, v2(D12), "工具有 path 覆寫？\n（dev 中）", 170, 76, ax="l")
b.box("t0s", E, 3, v2(W12), fl("是：跳過 materialize／verify\n（cache/<repo>/ 是 symlink）；\n仍檢查 metadata、baseline ↓"), 220, ax="r")
b.box("nf", P, 3, v2(RULE), fl("frozen（CI=1，v2.1 A／v2.2 A）= 只准寫 cache/、gen/（不寫 tracked\n檔）；不查最新版；仍拉鎖定版 image；升為失敗的警告：薄殼不符、\nbaseline 落後、未完成接入、任何 local 覆寫"), 360)
b.box("t1", E, 4, D12, "印記第一行 ≠\nversion.toml？", 160, 80, ax="l")
b.box("t1y", E, 4, W12, fl("是（或無 cache/<repo>/）：列待辦\n「拉 <repo>-dist@digest（鎖定版，\n不查最新）→ materialize」"), 220, ax="r")
b.box("t2", E, 5, D12, "verify：每檔\nsha256 ＝ 印記？", 150, 80, ax="l")
b.box("t2n", E, 5, W12, "否：列待辦「重裝 + warn\n『cache/<repo>/ 被改過』」", 220, ax="r")
b.box("t3", E, 6, D12, "metadata 有\n完成標記？", 150, 80, ax="l")
b.box("t3a", E, 6, R12, "1：從未完成接入，\n請 just vendor_kit add <repo>", 210, ax="r")
b.box("t3r", P, 6, INV, fl("不變量（v2.1 A）：自動化不碰使用者的檔 —— sync 不寫 version.toml、初始檔、baseline、薄殼；只寫 cache/、gen/"), 360)
b.box("t4", E, 7, D12, "最後合併版本\n＝ version.toml？", 160, 80, ax="l")
b.box("t4c", E, 7, D12, "否（落後）\n→ CI=1？", 110, 70, ax=170)
b.box("t4r", E, 7, R12, "是 → 1：\nbaseline 落後\n（印 upgrade）", 110, ax="r")
b.box("t5", E, 8, W12, fl("否：warn「baseline 落後，請\njust vendor_kit upgrade <repo>」（繼續）"), 250, ax=100)
b.box("z0", E, 9, v2(W12), "resolve 完：待辦清單以 stdout 回啟動器\n（要拉的 image、要重裝、要重生 gen/）", 250, ax="l")
b.box("z2", U, 9, v2(G12), "0：無待辦 → 快路徑（只跑這\n一次檢查，不起第二個容器）\n→ 接著跑原本的 recipe", 220)
b.H("ne1", "n0", "n1"); b.H("ne2", "n1", "n2", "讀"); b.D("ne3", "n1", "nc")
b.H("ne4", "nc", "ncx", "是"); b.D("ne5", "nc", "n3", "否", al=True); b.H("ne6", "n3", "n3n", "否")
b.D("ne7", "n3", "t0", "是", al=True)
b.H("te0", "t0", "t0s"); b.D("te1", "t0", "t1", "否", al=True); b.R("te2", "t0s", "t3", "", busx=990)
b.H("te3", "t1", "t1y", "是"); b.D("te4", "t1", "t2", "否", al=True); b.D("te5", "t1y", "t2")
b.H("te6", "t2", "t2n", "否"); b.D("te7", "t2", "t3", "是", al=True); b.D("te8", "t2n", "t3")
b.H("te9", "t3", "t3a", "否"); b.D("te10", "t3", "t4", "是", al=True)
b.H("te11", "t4", "t4c"); b.H("te12", "t4c", "t4r"); b.D("te13", "t4c", "t5", "否", al=True)
b.D("te14", "t4", "z0", "是", al=True); b.D("te15", "t5", "z0", al=True); b.H("ze1", "z0", "z2", "無待辦")
b.close()
b = F.band("eB", "sync 第 2 段（有待辦才跑）：啟動器 docker → 引擎 apply sync —— 只寫 cache/、gen/（薄殼不碰）", v2=True)
b.box("m0", L, 0, v2(W12), fl("對每個要拉的 image：docker pull（已有則略）\n→ docker create <img> /x\n→ docker cp c:/dist/. <tmp>/<repo>/ → docker rm\n（不帶 --platform；daemon 挑原生）"), 280)
b.box("m0g", G, 0, IMG, "<repo>-dist@digest\n（鎖定版；多架構 index）", 220)
b.box("m1", L, 1, v2(W12), fl("docker run … -v <tmp>:/dist:ro\n<引擎> apply sync"), 280)
b.box("m2", E, 1, v2(SUB), fl("apply：flock 專案目錄（60 秒；VENDOR_KIT_NO_LOCK=1 可關）\n→ 重驗 resolve 的輸入指紋（不同 → 1「請重跑」）"), 400)
b.box("m3", E, 2, SUB, fl("materialize／重裝：/dist/<repo> → 暫存 → cache/<repo>/\n寫印記（第一行 index digest，之後每檔 sha256）"), 400)
b.box("m3f", P, 2, F12, "cache/<repo>/（重寫，不進 git）", 360)
b.box("m5", E, 3, v2(SUB), fl("重生 gen/tools.just（每個 <ns>.just 一行 mod；一工具可多行）；gen/.stamp 由 upgrade vendor_kit／install 寫"), 400)
b.box("m5f", P, 3, F12, "gen/tools.just（不進 git）", 360)
b.box("m7", U, 3, G12, "0：接著跑原本的 recipe", 220)
b.H("me0", "m0g", "m0", "拉 /dist"); b.D("me1", "m0", "m1"); b.H("me2", "m1", "m2"); b.D("me3", "m2", "m3")
b.H("me4", "m3", "m3f", "寫"); b.D("me5", "m3", "m5")
b.H("me12", "m5", "m5f", "寫"); b.H("me15", "m5", "m7")
b.close()
foot(p6, "p6", F.y, [
 ("sync", "vendor.just 的前置 recipe：每次 just 自動跑（v1 叫 ensure）；只寫 cache/、gen/（永不寫薄殼）；範圍 = 全部工具；無待辦 → 快路徑只跑一次檢查（不起第二個容器）"),
 ("resolve／apply／指紋", "同一動詞兩段：resolve 只讀只算，stdout 一行一項回啟動器（要拉哪些 image、要重寫什麼）＋讀過的檔的 hash（指紋）；apply 拿 flock 後重驗指紋才寫"),
 ("frozen（CI=1）", "CI 下只准寫 cache/、gen/；不查最新版（只拉鎖定版）；警告升為失敗：薄殼不符、baseline 落後、未完成接入、任何 version.local.toml 覆寫 → 1"),
 ("統一提示（Q10 (2)）", "引擎 ref ≠ gen/.stamp → sync 不重寫，退出 1 固定印「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」；重產後印「請 commit 並再跑原指令」"),
 ("薄殼／引擎 ref／hash", "薄殼 = .vendor_kit/ 裡 vendor_kit 自己的 tracked 檔，由引擎 ref（version.toml 第一行的引擎 image 版本）推導；hash = 內容指紋，記在 gen/.stamp 供 upgrade vendor_kit 重產前比對"),
 ("materialize／印記／index digest", "把啟動器 docker create/cp 取來的 /dist 展開到 cache/<repo>/；印記 .stamp 第一行 = index digest（多架構 image 總目錄的 sha256 ID；dev 時是 path:<dir>）"),
 ("verify／sha256", "sha256 = 檔案內容算出的指紋；verify 把 cache/<repo>/ 每個檔的 sha256 跟印記比；不符 → 重裝 + warn（使用者不可改 cache/）"),
 ("metadata／完成標記／落後", "baseline/<repo>/.vendor_kit.toml：無完成標記 = add 沒做完 → 1；最後合併版本 ≠ version.toml = 有人只改了 version.toml → 提示 upgrade（CI → 1）"),
 ("gen／mod／recipe", "gen/：tools.just（每個 <ns>.just 一行 mod = 掛成一個 just 命名空間；一工具可多行）與 .stamp；引擎每次重生，不進 git；零 set 零 recipe（recipe = justfile 的一條指令）"),
 ("覆寫兩種（v2.1 B／v2.2 B）", "引擎覆寫 vendor_kit = \"<tag>\"＋image ID → 啟動器用該本機 image（--pull never）；工具覆寫 <repo> = \"path:<dir>\" → cache 是 symlink，跳過 materialize／verify，仍查 metadata／baseline"),
 ("GHCR／image／daemon／CI／flock", "GHCR = GitHub 容器倉庫；image = 打包好的 dist/；daemon = 主機的 docker 服務；CI = 自動測試環境（CI=1 → frozen）；flock = 專案目錄鎖（60 秒），鎖在引擎"),
], ALL - {"tree"})
pages_v1_b.append(("v1p6", "流程 v2：sync（每次 just 都跑）", p6))

# ================= P7：upgrade ── Renovate 路徑、手動路徑 =================
p7 = [v("title", "1", TITLE, "流程 v2：upgrade ── A. Renovate 路徑、B. 手動路徑（§2／§7、v2.1 C／D、v2.2 C／D）", 40, 20, 1000, 34)]
ny = pend(p7, "⚠ 待拍板（proposal_v2 §9）\n(5) upgrade 對 append 行的「原文比對」在 CRLF／尾端空白時的判定（第一版：嚴格相同；找不到就不動、印新內容）。")
F = Flow(p7, COLS7); F.headers(ny + 8)
b = F.band("uA", "A. Renovate 路徑（下游自選，vendor_kit 不出 bot）：機器人只改 version.toml 一行；PR 的 CI 以新版跑完整流程；補合併在 PR 分支上完成、CI 綠後才 merge", v2=True)
b.box("a0", RN, 0, G12, "Renovate 定期查 GHCR\n（regex manager、\ndocker datasource）", 180)
b.box("a1", G, 0, IMG, "<repo>-dist\n出新 tag@digest", 180)
b.box("a2", RN, 1, W12, "開 PR（獨立分支）：只改\nversion.toml 該工具一行\n（tag@digest）", 180)
b.box("a3", P, 1, F12, "version.toml（PR 分支）\n<repo> 行 = 新 tag@digest", 280)
b.box("a4", L, 2, W12, fl("PR 的 CI 呼叫 check.sh → just\n以新版跑完整流程：sync frozen\n→ verify → upgrade --dry-run\n→ 工具測試 → 專案測試"), 240)
b.box("a4r", E, 2, RULE, "一行改動本身不可能出錯，不構成通過依據\n→ PR 的 CI 必須以新版跑完整流程", 360)
b.box("a5", E, 3, R12, fl("1：baseline 落後 version.toml → PR 紅，印\n「本機 just vendor_kit upgrade <repo> -y 後 push」"), 360)
b.box("a9", P, 3, NOTE, fl("Renovate 預設不動有人推過的分支；\nPR body 加警告：勿勾 rebase（會蓋掉\n人補的合併 commit）。vendor_kit 無 bot。"), 280)
b.box("a6", U, 4, v2(W12), fl("PR 作者本機：切到 PR 分支\n→ upgrade <repo> -y（走 B 的\n待合併分支，固定補到 PR 鎖定版）\n→ commit、push 到 PR 分支"), 220)
b.box("a7", L, 5, W12, "PR 分支 CI 全部再跑（同上完整流程）→ 綠", 240)
b.box("a8", U, 5, G12, fl("merge PR（CI 綠後才 merge）"), 220)
b.H("ae1", "a0", "a1", "查"); b.D("ae2", "a1", "a2", "有新版"); b.H("ae3", "a2", "a3", "改一行")
b.D("ae4", "a2", "a4"); b.D("ae5", "a4", "a5"); b.D("ae6", "a5", "a6")
b.D("ae7", "a6", "a7"); b.H("ae8", "a7", "a8", "綠")
b.close()
b = F.band("uB", "B. 手動路徑：just vendor_kit upgrade [<repo>]（不帶 repo = 全部含 vendor_kit 自身，先完整預檢再動；-t 限單一 repo）= resolve → docker → apply", v2=True)
b.box("b0", U, 0, G12, "just vendor_kit upgrade <repo>\n（-t、-y、-n/--dry-run）", 220)
b.box("b1", L, 0, v2(W12), "docker run <引擎> resolve upgrade <repo>\n（啟動器不鎖）", 240)
b.box("b2", E, 0, v2(D12), "(0) 衝突中檔案仍有我們的標籤\n<<<<<<< vendor_kit:baseline？（檔案\n失蹤不算已解；否 → 清除衝突狀態）", 250, 84, ax="l")
b.box("b2c", E, 0, v2(R12), "是 → 2：先解\n衝突再重跑", 100, ax="r")
b.box("b4", E, 1, D12, "有 baseline/\n<repo>/？", 160, 76, ax="l")
