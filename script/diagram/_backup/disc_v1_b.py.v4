b.H("we1", "w0", "w1"); b.H("we2", "w1", "w2"); b.H("we3", "w2", "w2f", "寫"); b.D("we4", "w2", "w3")
b.H("we5", "w4", "w5"); b.H("we6", "w5", "w6"); b.H("we7", "w6", "w7", "否")
