b.box("u3", E, 0, G12, "0：未啟用 dev（提示）", 200, ax="r")
b.box("u4", E, 1, v2(W12), "resolve：要拉 <repo>-dist@digest（version.toml 鎖定版）", 300, ax="l")
b.box("u5", L, 2, v2(W12), "docker pull → create/cp /dist → rm", 280)
b.box("u5g", G, 2, IMG, "<repo>-dist@digest", 220)
b.box("u6", E, 3, v2(SUB), fl("apply：flock → 刪 version.local.toml 該行 → 拆 symlink\n→ materialize 展開、印記 index digest"), 300, ax="l")
b.box("u6x", E, 3, v2(R12), "失敗 → 1：保留\n可恢復狀態", 90, ax="r")
b.box("u6f", P, 3, F12, "version.local.toml 少一行；cache/<repo>/（重新展開）", 360)
b.box("u7", U, 3, G12, "0", 220)
b.H("ue1", "u0", "u1"); b.H("ue2", "u1", "u2"); b.H("ue3", "u2", "u3", "否"); b.D("ue4", "u2", "u4", "是", al=True)
b.D("ue5", "u4", "u5"); b.H("ue6", "u5g", "u5", "拉 /dist"); b.D("ue7", "u5", "u6"); b.H("ue8", "u6", "u6x")
b.U("ue9", "u6", "u6f", "寫", 0.8, 0.5); b.H("ue10", "u6", "u7")
b.close()
b = F.band("vB′", "undev vendor_kit：刪引擎 tag 覆寫 → 下次 just 用 version.toml 的引擎；薄殼／gen 不符則重寫並統一提示（v2.1 B）", v2=True)
b.box("w0", U, 0, G12, "just vendor_kit undev vendor_kit", 220)
b.box("w1", L, 0, W12, "docker run 引擎 undev vendor_kit", 280)
b.box("w2", E, 0, v2(SUB), fl("刪 version.local.toml 的 vendor_kit 行\n（無 → 0 提示未啟用）"), 400)
b.box("w2f", P, 0, F12, "version.local.toml（少 vendor_kit 行）", 360)
b.box("w3", U, 1, G12, "0：本次結束", 220)
