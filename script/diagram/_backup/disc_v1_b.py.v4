b.box("b6", E, 2, v2(D12), "(1) 有待合併？\n（version 已到 B、\nbaseline 仍 A）", 160, 84, ax="l")
b.box("b7", E, 2, v2(W12), fl("否：(2) 才查最新（或 -t；frozen 不查；-t 比現版舊 → warn 仍執行）→ 目標版 = 最新"), 210, ax="r")
b.box("b6y", E, 3, v2(W12), fl("是：目標版 = B（只補到 version.toml 那版然後停，不查最新）"), 200, ax="l")
b.box("b8", L, 4, v2(W12), fl("docker pull（已有則略）→ docker create <img> /x\n→ docker cp c:/dist/. <tmp>/<repo>/ → docker rm"), 240)
b.box("b8g", G, 4, IMG, "<repo>-dist\n目標 tag@digest", 180)
b.box("b9", L, 5, v2(W12), fl("docker run … -v <tmp>:/dist:ro\n<引擎> apply upgrade <repo>\n（-n → apply --dry-run）"), 240)
b.box("b10", E, 5, v2(SUB), fl("apply：flock → 重驗指紋（不同 → 1「請重跑」）\n→ 逐檔判斷（B baseline／D 現況／N 新版，\n見「逐檔判斷」頁）→ 詢問清單"), 360)
b.box("b11", E, 6, D12, "--dry-run？", 120, 70, ax="l")
b.box("b12", E, 6, D12, "CI=1 且無 -y\n又需改檔？", 150, 76, ax=135)
b.box("b11y", E, 7, v2(G12), "0：唯讀預覽：印會問哪些檔\n（換／合併／append），不動", 180, ax="l")
