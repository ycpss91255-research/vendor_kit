b.box("b13", E, 8, SUB, fl("materialize 目標版到 cache/<repo>/（暫存 → 原子替換）、寫印記"), 360)
b.box("b13f", P, 8, F12, "cache/<repo>/（目標版，不進 git）", 280)
b.box("b14", E, 9, v2(SUB), fl("逐檔詢問（-y 免問）；合併全在暫存做：換新版／\ngit merge-file --diff3（衝突數 → 2，留我們的標籤）／\nappend 行替換 → 逐檔原子替換 ＋ metadata 進度日誌\n（列已完成／未完成）"), 360)
b.box("b14f", P, 9, F12, "初始檔（合併後；衝突留 <<<<<<< vendor_kit:baseline 標記）", 280)
b.box("b15", E, 10, SUB, fl("推 baseline/<repo>/ + metadata（最後合併版本 = 目標版；\n有衝突也推，並記衝突中檔案）"), 360)
b.box("b15f", P, 10, F12, "baseline/<repo>/、.vendor_kit.toml", 280)
b.box("b16", E, 11, v2(SUB), fl("最後寫 version.toml：<repo> 行 →\n目標 tag@digest（待合併：已是 B，不動）"), 200, ax="l")
b.box("b16x", E, 11, v2(R12), "失敗 → 1：明列\n已完成／未完成", 150, ax="r")
b.box("b16f", P, 11, F12, "version.toml（<repo> 行）", 280)
b.box("b17", U, 12, v2(G12), "0：印摘要 → commit（同一 commit）\n另有新版 → 印「再跑一次可升」", 220)
b.box("b18", E, 12, R12, "2：印衝突檔名清單（解完再跑 upgrade 直到乾淨；\nbaseline 已在目標版；補合併衝突也立刻 2）", 300, ax="r")
b.H("be1", "b0", "b1"); b.H("be2", "b1", "b2"); b.H("be3", "b2", "b2c")
b.D("be4", "b2", "b4", "否", al=True); b.D("be5", "b4", "b5", "否"); b.D("be6", "b4", "b6", "是", al=True)
b.H("be7", "b6", "b7"); b.D("be8", "b6", "b6y", "是", al=True); b.D("be9", "b6y", "b8")
b.D("be10", "b7", "b8", "", 0.3, 0.5); b.D("be11", "b7", "b8g", "查", 0.7, 0.5); b.H("be12", "b8g", "b8", "拉 /dist")
b.D("be13", "b8", "b9"); b.H("be14", "b9", "b10"); b.D("be15", "b10", "b11", al=True)
b.D("be16", "b11", "b11y", "是", al=True); b.H("be17", "b11", "b12", "否"); b.D("be18", "b12", "b12x", "是", al=True)
b.D("be19", "b12", "b13", "否", al=True); b.H("be20", "b13", "b13f", "寫"); b.D("be21", "b13", "b14")
b.H("be22", "b14", "b14f", "寫"); b.D("be23", "b14", "b15"); b.H("be24", "b15", "b15f", "寫"); b.D("be25", "b15", "b16", "", 0.278, 0.5)
b.H("be26", "b16", "b16x"); b.U("be27", "b16", "b16f", "寫", 0.8, 0.5)
b.D("be28", "b16", "b17", "無衝突", 0.3, 0.5); b.D("be29", "b16", "b18", "衝突", 0.7, 0.5, al=True)
b.close()
foot(p7, "p7", F.y, [
 ("Renovate／regex manager", "GitHub 上的機器人（下游自選；vendor_kit 不出 bot）：regex manager = 用正規表示式在 version.toml 找版本字串；docker datasource = 去 GHCR 查新 tag；有新版就開 PR 改那一行"),
 ("PR／commit／push／rebase／merge", "PR = 提議把分支併進主線（GitHub 上審查）；commit = 記錄一次修改；push = 傳到 GitHub；rebase = 重排分支（會蓋掉人補的 commit）；merge = 併入主線"),
 ("check.sh／CI／frozen", "下游 CI（自動測試環境）只呼叫 .vendor_kit/ci/check.sh = sync（frozen：不查最新版、不寫 tracked 檔）→ verify → upgrade --dry-run → 工具測試 → 專案測試"),
 ("baseline 落後／待合併", "metadata 最後合併版本 ≠ version.toml：有人只改了 version.toml（如 Renovate）還沒合併 → CI 1、本機 warn；upgrade 先只補到 version.toml 那版然後停（v2.2 D）"),
 ("resolve／apply／--dry-run", "resolve 只讀只算（查目標版、輸出要拉的 image 與指紋）；啟動器拉 image；apply 拿 flock 後重驗指紋才寫；-n = apply --dry-run 唯讀預覽（要先拉 image）"),
 ("B／D／N、逐檔判斷後詢問", "B = baseline（上次合併的範本）、D = 現況（你的檔）、N = 新版（cache 展開）；N 改了才問「換成新版？」，兩邊都改才問「三方合併？」；-y 免問；細表見下一頁"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< vendor_kit:baseline ||||||| ======= >>>>>>> 標記（我們自己的標籤，重入時靠它偵測）；回傳衝突數 → 映射為 2"),
 ("結束狀態 0／1／2", "0 成功；1 失敗（version.toml 不動；指紋不同「請重跑」也是 1）；2 有衝突（留標記、印檔名；baseline 仍推到目標版；解完重跑）—— 2 與自身升級的「請 upgrade vendor_kit」1 是獨立狀態"),
 ("指紋／進度日誌（v2.2 C）", "resolve 輸出讀過的 version.toml、metadata、要動的檔的 hash＋鎖定 digest；apply 重驗，不同 → 1；合併全在暫存完成 → 逐檔原子替換 + metadata 進度日誌，失敗明列已完成／未完成"),
 ("GHCR／image／tag@digest", "GHCR = GitHub 的容器倉庫；image = 打包好的 dist/；tag = 人看的版本名，digest = 內容的 sha256 ID（鎖定用）"),
], ALL - {"inv", "tree"})
pages_v1_b.append(("v1p7", "流程 v2：upgrade ── Renovate 路徑、手動路徑", p7))

# ================= P7b：upgrade ── 逐檔判斷、回退、自身升級 =================
p7b = [v("title", "1", TITLE, "流程 v2：upgrade ── C. 逐檔判斷表、D. 回退、E. 自身升級（§5、v2.1 D、v2.2 B／D）", 40, 20, 1000, 34)]
ny = pend(p7b, "⚠ 待拍板（proposal_v2 §9）\n(5) append 行「原文比對」在 CRLF／尾端空白時的判定（第一版：嚴格相同）。\n已定（v2.2 E）：dist/files/ 第一版禁止 symlink，引擎展開時也驗。")
F = Flow(p7b, COLS7); F.headers(ny + 8)
b = F.band("uC", "C. 逐檔判斷後詢問（每個 init.toml 檔；引擎 merge 模組；§5 表；在 apply 內、拿到 flock 後）＋ C′ 衝突重入（v2.2 D (0)）", v2=True)
b.free("c_in0", F12, "B = baseline/<repo>/<檔>\n（上次合併的範本）", 30, 50, 200, 44)
b.free("c_in1", F12, "D = 專案裡的 <檔>\n（現況，你可能改過）", 30, 114, 200, 44)
b.free("c_in2", F12, "N = 新版 cache/<repo>/<檔>\n（image 展開）", 30, 178, 200, 44)
b.free("c_m", SUB, "逐檔判斷（右表）\n→ 要改的先問（-y 免問）", 290, 106, 150, 60)
b.P("c_e0", "c_in0", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 72), (260, F.y + 136)])
b.P("c_e1", "c_in1", "c_m", "", (1, 0.5), (0, 0.5), [])
b.P("c_e2", "c_in2", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 200), (260, F.y + 136)])
rows = [("新版沒改／你的檔已等於新版\n（N==B 或 D==N）", "不動", "—"),
        ("新版改了、你沒改（D==B、N≠B）", "問「X 換成新版？」", "同意 → 換；拒絕 → 不動"),
        ("兩邊都改（D≠B、N≠B）", "問「你和新版都改了 X，要三方合併嗎？」→ git merge-file --diff3（在暫存做）", "乾淨 → 原子替換寫入；衝突 → 留 <<<<<<< vendor_kit:baseline 標記、回 2；baseline 仍推到目標版；解完重跑直到乾淨"),
        ("新版新增（B 無）", "同 add 列：你沒有 → 建（印出）；已有同名 → 不納管", "不覆蓋、印「已存在，範本在 cache」"),
        ("新版刪除該檔（N 無）", "不刪，只 warn", "你的檔留著"),
        ("append 行（mode=append）", "找到上次加的行（原文相同）→ 問後替換", "找不到 → 不動、印新內容（CRLF／尾端空白判定 [待]）"),
        ("二進位／symlink", "不合併：你未改（D==B）才換", "改過 → 保留 + warn"),
        ("CI=1 且無 -y 又需改檔", "apply 印清單 → 1（version.toml 未動）", "--dry-run 同樣只印清單 → 0")]
tx, ty = 480, 44; cws = [200, 400, 320]
for i, hh in enumerate(["情況", "做法", "結果"]):
    b.free(f"c_h{i}", HDR, hh, tx + sum(cws[:i]), ty, cws[i], 28)
cy = ty + 28
for r, row in enumerate(rows):
    rh = math.ceil(max(need_h(c, 12, w) for c, w in zip(row, cws))) + 4
    for i, (c, w) in enumerate(zip(row, cws)):
        b.free(f"c_r{r}c{i}", TERM_K if i == 0 else TERM_V, c, tx + sum(cws[:i]), cy, w, rh)
    cy += rh
b.free("c_note", NOTE, "--dry-run = 唯讀預覽，只印會問哪些檔。\n衝突解完 → 再跑一次 upgrade 直到乾淨（不另開 accept）。\n（dest 撞名規則見「add」頁）", 1420, 44, 160, 150)
b.P("c_e3", "c_m", "c_h0", "", (1, 0.5), (0, 0.5), [(460, F.y + 136), (460, F.y + 58)])
cy2 = cy + 40
b.free("cx_l", LBL, "C′ 衝突重入（解完衝突後再跑 upgrade；v2.2 D (0)）", 30, cy2, 500, 24)
b.free("cx0", G12, "解完衝突後再跑\njust vendor_kit upgrade <repo>", 30, cy2 + 40, 200, 56)
b.free("cx1", v2(D12), "metadata 記有衝突中檔案\n且檔內仍有我們的標籤\n<<<<<<< vendor_kit:baseline？", 260, cy2 + 30, 230, 76)
b.free("cx2", R12, "是 → 2：停（先解完標記；\n檔案失蹤不算已解）", 520, cy2 + 40, 200, 56)
b.free("cx3", v2(W12), "否：清除衝突狀態 → 接 B 的 (1)(2)\n（version.toml、baseline 已在目標版 → 通常「不動」）", 760, cy2 + 40, 330, 56)
b.P("cx_e0", "cx0", "cx1", "", (1, 0.5), (0, 0.5), [])
b.P("cx_e1", "cx1", "cx2", "", (1, 0.5), (0, 0.5), [])
b.P("cx_e2", "cx1", "cx3", "否", (0.5, 1), (0.5, 1), [(20 + 375, F.y + cy2 + 130), (20 + 925, F.y + cy2 + 130)], pos=0)
b.close()
b = F.band("uD", "D. 回退 ＝ git revert 該升級 commit（version.toml + 初始檔 + baseline 同一 commit）；下次 just 的 sync 只把 cache/ 換回舊版")
b.box("d0", U, 0, G12, "git revert 該升級 commit\n（version.toml + 初始檔 +\nbaseline 一起退回）", 200, extra=10)
b.box("d1", L, 0, W12, fl("下次 just：docker run 引擎 resolve sync\n→ docker pull／cp 舊版 → apply sync"), 240)
b.box("d2", E, 0, SUB, fl("sync：印記 ≠ version.toml → materialize 舊版\n（只寫 cache/；初始檔與 baseline 不碰）"), 360)
b.box("d3", P, 0, F12, fl("cache/<repo>/（舊版；sync 寫）"), 280)
b.box("d3b", P, 1, F12, fl("初始檔、baseline/<repo>/、version.toml\n（由 git revert 還原，不是 sync 寫）"), 280)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3", "寫"); b.D("de4", "d0", "d3b", "revert 還原")
b.close()
b = F.band("uE", "E. vendor_kit 自身升級（Q10 (2)）：兩個觸發點都只「發現不符 → 1 提示 upgrade vendor_kit」；重產薄殼 + gen 只由 upgrade vendor_kit 做（先比對 hash）", v2=True)
b.box("s0", U, 0, v2(G12), "(a) just vendor_kit upgrade\n（不帶 repo，含 vendor_kit 自身）", 200, extra=10)
b.box("s1", L, 0, v2(W12), "docker run <引擎> resolve upgrade（全部）\n→ docker pull 新引擎 → apply", 240)
b.box("s2", E, 0, v2(SUB), fl("resolve 先完整預檢（含 dev 中工具 → 1 提示 undev）；apply：version.toml 第一行 → 新引擎 ref → 停下（其餘工具先不升，薄殼不動）"), 360)
b.box("s2f", P, 0, F12, "version.toml 第一行（新引擎 ref）", 280)
b.box("s3", E, 1, v2(R12), fl("1：統一提示「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」"), 300)
b.box("s4", U, 1, G12, "→ 走下面 (c)", 200)
b.box("s5", U, 2, v2(G12), "(b) 別人 pull 後（version.toml\n第一行已變）打任何 just", 200, extra=10)
b.box("s6", L, 2, v2(W12), "grep 第一行取新引擎 ref → docker pull\n→ docker run 新引擎 resolve sync", 240)
b.box("s7", E, 2, v2(SUB), fl("sync：gen/.stamp ≠ 引擎 ref → 不重寫（sync 只寫 cache/、gen/）"), 360)
b.box("s8", E, 3, v2(R12), fl("1：統一提示「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」"), 300)
b.box("s9", U, 3, G12, "→ 走下面 (c)", 200)
b.H("se1", "s0", "s1"); b.H("se2", "s1", "s2"); b.H("se3", "s2", "s2f", "寫"); b.D("se4", "s2", "s3"); b.H("se5", "s3", "s4")
b.H("se6", "s5", "s6"); b.H("se7", "s6", "s7"); b.D("se9", "s7", "s8"); b.H("se10", "s8", "s9")
b.box("s10", U, 4, v2(G12), "(c) just vendor_kit\nupgrade vendor_kit", 200)
b.box("s11", L, 4, v2(W12), fl("grep version.toml 第一行 → docker pull（已有則略）→ docker run 該引擎 upgrade vendor_kit"), 240)
b.box("s12", E, 4, v2(D12), "現薄殼 == 上次\n產物（hash 在\ngen/.stamp）？", 170, 84, ax="l")
b.box("s12x", E, 4, v2(R12), "否 → 1：被改過，\n列差異不動", 170, ax="r")
b.box("s13", E, 5, v2(SUB), fl("是：flock → 重產薄殼（entry.just、vendor.just、.gitignore、ci/check.sh）+ gen/（.stamp 記新引擎 ref＋薄殼 hash）；第一行未變時先查最新並改第一行"), 360)
b.box("s13f", P, 5, F12, "薄殼（進 git）、gen/（不進 git）", 280)
b.box("s14", U, 5, v2(G12), fl("0：印「請 commit .vendor_kit/ 並再跑原指令」"), 200)
b.H("se11", "s10", "s11"); b.H("se12", "s11", "s12"); b.H("se13", "s12", "s12x", "否"); b.D("se14", "s12", "s13", "是", al=True)
b.H("se15", "s13", "s13f", "寫"); b.H("se16", "s13", "s14")
b.close()
foot(p7b, "p7b", F.y, [
 ("B／D／N", "B = baseline（上次合併時的範本副本，進 git）；D = 現況（專案裡你的那份檔）；N = 新版（目標版 image 展開到 cache/ 的範本）；「D==B」= 你沒改過"),
 ("逐檔判斷後詢問", "三份比：N 改了才問「換成新版？」；兩邊都改才問「三方合併？」；-y 免問；在 apply 內、拿到 flock 後做；全部在暫存完成再逐檔原子替換"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< vendor_kit:baseline ||||||| ======= >>>>>>> 標記（我們自己的標籤）；回傳衝突數 → 映射為結束狀態 2"),
 ("衝突重入（v2.2 D (0)）", "再跑 upgrade 時先看 metadata 的「衝突中檔案」：檔內仍有我們的標籤 → 2 停；檔案失蹤不算已解；都乾淨 → 清除狀態再往下"),
 ("結束狀態 0／1／2", "0 成功；1 失敗不動 version.toml；2 有衝突（留標記、印檔名；baseline 仍推到目標版；解完重跑直到乾淨）"),
 ("--dry-run", "apply --dry-run 唯讀預覽：只印會問哪些檔（哪些要換／合併／append 替換），不動任何檔；不另開 diff"),
 ("append 行", "mode=append 的初始檔：upgrade 找上次加的行（原文相同）→ 問後替換；找不到 → 不動、印新內容"),
 ("二進位／symlink", "二進位 = 不是文字的檔（圖片等）；symlink = 指向另一個路徑的捷徑；兩者不做行內合併：你沒改才換，改過保留 + warn；dist/files/ 第一版禁止 symlink"),
 ("回退／git revert", "git revert = 產生一個反向 commit 把那次升級（version.toml、初始檔、baseline 同一 commit）整組退回；下次 just 的 sync 看印記 ≠ version.toml → 只把 cache/<repo>/ 換回舊版"),
 ("自身升級／統一提示（Q10 (2)）", "version.toml 第一行（引擎 ref）變 → (a) upgrade 不帶 repo 當次、(b) 別人 pull 後下次 just 的 sync：都只退出 1 印「請 just vendor_kit upgrade vendor_kit」；(c) upgrade vendor_kit 比對 hash → 重產薄殼 + gen → 印「請 commit 並再跑原指令」"),
 ("gen/.stamp／hash", "gen/.stamp 記引擎 ref 與上次產出薄殼的 hash（內容指紋）；upgrade vendor_kit 重產前先比對現薄殼 == 上次產物，被改過 → 1 列差異不動；sync 只拿它比對，不寫薄殼"),
], ALL - {"inv", "tree"})
pages_v1_b.append(("v1p7b", "流程 v2：upgrade ── 逐檔判斷、回退、自身升級", p7b))

# ================= P8：dev / undev =================
p8 = [v("title", "1", TITLE, "流程 v2：dev／undev（§2 dev、undev 列；v2.1 B、v2.2 B；<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p8, "本頁無待拍板項。已定：工具 path 覆寫與引擎 tag 覆寫分開處理（v2.1 B）；引擎覆寫記 tag + image ID、docker run --pull never（v2.2 B）；\n工具 path 覆寫由啟動器 -v <dir>/dist:/dist/<repo>:ro 並驗 dist/init.toml 存在（v2.2 B）。", style=NOTE)
F = Flow(p8, COLS5); F.headers(ny + 8)
b = F.band("vA", "dev <repo> -p <dir>：工具 path 覆寫（v2.1 B）—— 用本機工具 repo 的 dist/ 取代 image（不進 git；CI 拒絕；工具必須已在 version.toml）", v2=True)
b.box("d0", U, 0, G12, "just vendor_kit dev <repo>\n-p <dir>", 220, extra=10)
b.box("d1", L, 0, v2(W12), fl("test -f <dir>/dist/init.toml（缺 → 1）\n→ docker run 引擎 dev <repo> -p\n（-v <dir>/dist:/dist/<repo>:ro）"), 280)
b.box("d2", E, 0, D12, fl("CI=1？／<repo>\n不在 version.toml？\n／dist、init.toml\n不合法？"), 170, 100, ax="l")
b.box("d3", E, 0, R12, fl("是 → 1：CI 拒絕 dev／未接入，請先 add <repo>／缺 dist/ 或 init.toml"), 220, ax="r")
b.box("d6", E, 1, v2(SUB), fl("flock → 寫 version.local.toml：<repo> = \"path:<dir>\"\n（.vendor_kit/.gitignore 已排除它；不碰 .git/info/exclude）"), 400)
b.box("d6f", P, 1, F12, fl("＋version.local.toml（不進 git）：<repo> = \"path:<dir>\""), 360)
b.box("d7", E, 2, SUB, "cache/<repo>/ 改為 symlink → <dir>/dist；印記第一行改 path:<dir>", 400)
b.box("d7f", P, 2, F12, fl("cache/<repo>/ → <dir>/dist（symlink）；.stamp 第一行 path:<dir>"), 360)
b.box("d8", U, 3, v2(G12), "0：之後每次 just 用 <dir>\n（sync 跳過該工具 materialize／verify，\n仍檢查 metadata／baseline）", 220, extra=10)
b.box("d9", E, 3, v2(RULE), fl("dev 中的工具：upgrade <repo>／remove <repo> → 1 提示先 undev\n（v2.1 B）；不帶 repo 的 upgrade 預檢也會擋"), 400)
DF0 = "dev 前\nversion.local.toml：無\ncache/<repo>/：從 image 展開\ncache/<repo>/.stamp\n  第一行：index digest"
DF1 = "dev 後（不進 git）\n＋version.local.toml：\n  <repo> = \"path:<dir>\"\ncache/<repo>/ → <dir>/dist\n  （symlink）\n.stamp 第一行：path:<dir>"
TH = max(fit_h(DF0, 170), fit_h(DF1, 170))
b.box("df0", P, 3, FTREE, DF0, 170, TH, ax=0)
b.box("df1", P, 3, v2(FTREE), DF1, 170, TH, ax=190)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3"); b.D("de4", "d2", "d6", "否", al=True)
b.H("de5", "d6", "d6f", "寫"); b.D("de6", "d6", "d7"); b.H("de7", "d7", "d7f", "寫"); b.D("de8", "d7", "d8"); b.H("dfe", "df0", "df1")
b.close()
b = F.band("vI", "dev vendor_kit -i <本機 image tag>：引擎 tag 覆寫（v2.1 B／v2.2 B）—— 只能 tag：docker load 後無 RepoDigests（實測），另記 image ID；驗收測試用同一機制", v2=True)
b.box("v0", U, 0, G12, "just vendor_kit dev vendor_kit\n-i <本機 image tag>", 220, extra=10)
b.box("v1", L, 0, v2(W12), "docker run 引擎 dev vendor_kit -i <tag>\n（tar 先自己 docker load）", 280)
b.box("v2_", E, 0, v2(SUB), fl("CI=1 → 1 拒絕；flock → 寫 version.local.toml：vendor_kit = \"<tag>\"\n＋解析後 image ID（同 tag 重 build 才會被發現）；不動薄殼"), 400)
b.box("v3", P, 0, F12, "＋version.local.toml：vendor_kit = \"<tag>\" + image ID（不進 git）", 360)
b.box("v4", U, 1, G12, "0：本次結束\n（本次仍是舊引擎）", 220)
b.box("vb", E, 1, LBL, "═══ 本次結束 ↑ ／ ↓ 下次 just（改用該 image）═══", 400, 24, minh=24)
b.box("v5", U, 2, G12, "下次打任何 just", 220)
b.box("v6", L, 2, v2(W12), fl("grep 引擎 ref：version.local.toml 覆寫優先\n→ docker run --pull never <tag>（不 pull；\n驗 image ID）→ resolve sync"), 280)
b.box("v7", E, 2, v2(SUB), fl("sync：gen/.stamp ≠ <tag> → 不重寫，1 提示 upgrade vendor_kit（Q10 (2)）"), 400)
b.box("v8", E, 3, v2(R12), fl("1：統一提示「請 just vendor_kit upgrade vendor_kit」"), 300)
b.box("v9", U, 3, v2(G12), fl("打 upgrade vendor_kit（用該本機 image；比對 hash → 重產薄殼 + gen）→ 之後每次 just 都用該 image"), 220)
b.H("ve1", "v0", "v1"); b.H("ve2", "v1", "v2_"); b.H("ve3", "v2_", "v3", "寫"); b.D("ve4", "v2_", "v4")
b.H("ve5", "v5", "v6"); b.H("ve6", "v6", "v7"); b.D("ve8", "v7", "v8"); b.H("ve9", "v8", "v9")
b.close()
b = F.band("vB", "undev <repo>：回到 version.toml 鎖定版（resolve → docker → apply；materialize 失敗 → 1 保留可恢復狀態，v2.2 B）", v2=True)
b.box("u0", U, 0, G12, "just vendor_kit undev <repo>", 220)
b.box("u1", L, 0, W12, "docker run 引擎 resolve undev <repo>", 280)
