ry = tbl(p2, "p2_mt", "1", RX, ry + 32, [("欄位", 180), ("內容", 330), ("誰讀它、做什麼", 390)], [
 ["來源 ref@digest", "這份 baseline 來自哪個工具 image（tag@index digest）", "追溯；upgrade 判斷 baseline 是哪一版"],
 ["最後合併版本", "最後一次逐檔合併時的工具版本", "sync：≠ version.toml → 本機 warn 提示 upgrade、CI 下 1 印指令；upgrade：≠ version.toml → 先補「待合併」"],
 ["完成標記", "add 走完 materialize → 初始檔 → baseline 才寫", "sync：缺 → 1「請 just vendor_kit add <repo>」；add：已接入且完成 → 0 無變更"],
 ["append 過的行", "每個 append 模式檔：我們加進去的那幾行原文", "upgrade：找到原文相同的行才問後替換，找不到不動並印新內容；remove：問後只刪原文相同的"],
 ["衝突中檔案", "upgrade 回 2 時留 <<<<<<< 標記的檔名清單", "upgrade：解完重跑直到乾淨才清空；sync／check.sh：有衝突中檔案就提示"],
 ["（檔案本身）", "兼作 baseline/<repo>/ 空目錄佔位（git 不追蹤空目錄）", "—"],
], marks={(3, 0), (3, 1), (3, 2), (4, 0), (4, 1), (4, 2)})
