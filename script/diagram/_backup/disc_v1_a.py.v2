p3.append(vb("p3_c3", "p3L5", LT12, C3, 1040, cy, 500, c2h))
cy += c2h + 24
p3.append(v("p3_c0", "p3L5", TEXT(12) + "align=left;fontStyle=1;", "vendor_kit 自身 CI（分層，一關過才下一關）", 20, cy, 260, 50))
x = 290; prev = None
for pid, t, w in CH:
    p3.append(v(pid, "p3L5", v2m(L12) if pid == "c_f" else L12, t, x, cy, w, 50))
    if prev: p3.append(e(f"{pid}_e", prev, pid, "", (1, 0.5), (0, 0.5)))
