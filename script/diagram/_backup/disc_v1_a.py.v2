 ("Renovate", "GitHub 機器人（下游自選）：GHCR 有新版就開 PR 改 version.toml 一行；merge 後 upgrade 先補「待合併」"),
 ("一行轉發", "recipe 只寫 verb *args → 交給啟動器 → 引擎解析；動詞清單改了不用改薄殼"),
 ("frozen", "CI=1 時 sync 只檢查不寫、不上網；baseline 落後 version.toml 直接 1 印指令"),
])
pages_v1_a.append(("v1p1", "契約 v2：目的、角色、介面", p1))

# ================= P2 v1p2：專案裡的檔與 version.toml =================
p2 = [v("title", "1", TITLE, "專案裡的檔與 version.toml（契約③，v2 定案）── 誰寫它、誰可以改、進不進 git", 40, 20, 800, 34)]
c, Y = pend("p2", 840, 12, 760,
 "(1) 檔名 version.toml vs lock.toml → 建議：version.toml；它是「該裝哪版」的宣告（人與 Renovate 都會改），不是 lock 產物；"
 "第一行固定引擎 ref 讓啟動器（POSIX sh）只靠 grep 讀、Renovate regex 也最單純")
p2.append(c); Y = max(Y + 16, 70)
# ---- 左：目錄樹（§3：根目錄只剩 justfile + .vendor_kit/）----
TW = {0: 200, 1: 560, 2: 530, 3: 500}
def tnode(pid, level, text, style, y):
    x = 40 + 30 * level
    w = TW[level]
    h = hv(text, w, pad=4)
    p2.append(vb(pid, "1", style, text, x, y, w, h))
    return y + h + 10
def tedge(eid, parent_id, child_id, pw):
    fx = round(14 / pw, 4)
    p2.append(e(eid, parent_id, child_id, "", (fx, 1), (0, 0.5)))
ty = Y + 34
p2.append(v("p2_lbl", "1", TEXT(13) + "align=left;fontStyle=1;", "3. 目錄樹（根目錄只多 .vendor_kit/；每格：用途；寫：誰產生｜改：誰可改）", 40, Y, 640, 28))
ty = tnode("t_root", 0, "<b>專案/</b>", LEAF() + "fontSize=12;fontStyle=1;", ty)
ty = tnode("t_just", 1, "<b>justfile</b> ── 使用者的 just 入口；install 只加一行 import '.vendor_kit/entry.just'（無 → 建；有 → 問／-y）\n寫：install｜改：使用者隨意；uninstall 問後只刪與我們寫的完全相同的那行", v2m(F_USER), ty)
ty = tnode("t_vk", 1, "<b>.vendor_kit/</b> ── 根目錄只多這一個；薄殼 + 狀態 + 快取都在裡面\n寫：install、自身 upgrade（sync 重寫薄殼）｜改：人不改", v2m(F_GIT), ty)
ty = tnode("t_ver", 2, "<b>version.toml</b> ── 進 git：唯一來源。第一行 vendor_kit = \"ghcr.io/…/vendor_kit:vN@sha256:…\"；[tools] 一行一工具 tag@digest\n寫：install／add／upgrade／remove｜改：使用者可手改、Renovate PR 改；sync 只讀", v2m(F_GIT), ty)
ty = tnode("t_vl", 2, "<b>version.local.toml</b> ── 不進 git（我們的 .gitignore 擋）：dev 覆寫 path:<dir>，或 vendor_kit 本機 image tag\n寫：dev／undev｜改：不建議手改；uninstall 一併刪", v2m(F_NOGIT), ty)
ty = tnode("t_gi", 2, "<b>.gitignore</b> ── 進 git，我們自己的：cache/ gen/ version.local.toml .tmp.*（不碰使用者的 .gitignore）\n寫：install｜改：人不改", v2m(F_GIT), ty)
ty = tnode("t_entry", 2, "<b>entry.just</b> ── 進 git：mod vendor_kit 'vendor.just' + import? 'gen/tools.just'（零 set 零 recipe）\n寫：引擎 launcher-gen｜改：人不改", F_GIT, ty)
ty = tnode("t_vj", 2, "<b>vendor.just</b> ── 進 git：動詞 recipe 一行轉發 + sync 前置（set positional-arguments 只放這）\n寫：引擎 launcher-gen（install／自身 upgrade）｜改：人不改", v2m(F_GIT), ty)
ty = tnode("t_ci", 2, "<b>ci/check.sh</b> ── 進 git：下游 CI 呼叫的契約檢查（五步，見契約⑤；隨 upgrade 更新）\n寫：引擎 launcher-gen｜改：人不改", F_GIT, ty)
ty = tnode("t_bl", 2, "<b>baseline/<repo>/</b> ── 進 git：上次合併的範本副本（三方合併的共同祖先）\n寫：add 建立、upgrade 推進（有衝突仍推到新版）｜改：人不改（改了合併就錯）", v2m(F_GIT), ty)
ty = tnode("t_meta", 2, "<b>baseline/<repo>/.vendor_kit.toml</b> ── 進 git：metadata（欄位見右）；兼作空目錄佔位\n寫：add／upgrade｜改：人不改", F_GIT, ty)
ty = tnode("t_gen", 2, "<b>gen/</b> ── 不進 git：引擎產生（sync 每次重生）\n寫：引擎｜改：人不改（會被覆蓋）", F_NOGIT, ty)
ty = tnode("t_tools", 3, "<b>tools.just</b> ── mod <ns> '../cache/<repo>/just/<ns>.just'，一行一命名空間（零 set 零 recipe）\n寫：引擎 launcher-gen｜改：人不改", v2m(F_NOGIT), ty)
ty = tnode("t_gstamp", 3, "<b>.stamp</b> ── 薄殼印記（引擎 ref）；≠ version.toml 第一行 → 用新引擎重寫薄殼 + gen，退出 1 要求重跑\n寫：啟動器／引擎｜改：人不改", F_NOGIT, ty)
ty = tnode("t_repo", 2, "<b>cache/<repo>/</b> ── 不進 git、使用者不可改；materialize 從 image 的 /dist 展開（dev 時改成 symlink 指向 <dir>/dist）\n寫：引擎 materialize｜改：不可改（verify 失敗 → 重裝並 warn）", v2m(F_NOGIT), ty)
ty = tnode("t_rstamp", 3, "<b>.stamp</b> ── 第一行 index digest（或 path:<dir>），之後每檔 sha256\n寫：引擎 materialize｜改：不可改", v2m(F_NOGIT), ty)
ty = tnode("t_files", 3, "<b>files/ …</b> ── 工具檔案（dist/files/ 全部）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty)
ty = tnode("t_init", 3, "<b>init.toml</b> ── 初始檔清單（[[file]] src／dest／mode = \"copy\"|\"append\"）\n寫：引擎 materialize｜改：不可改", v2m(F_NOGIT), ty)
ty = tnode("t_rjust", 3, "<b>just/<ns>.just</b> ── 工具的 just 模組，每檔一個頂層命名空間（<repo>.just 必有；just <repo> …）\n寫：引擎 materialize｜改：不可改", v2m(F_NOGIT), ty)
ty = tnode("t_user", 1, "<b>初始檔</b>（例 Dockerfile、setup.toml…；路徑由 init.toml 的 dest 決定）── 使用者的；進 git\n寫：add 建（已存在不納管；append 模式問後加行）、upgrade 逐檔問後換／三方合併｜改：使用者隨意；remove／uninstall 永不刪，印清單", v2m(F_USER), ty)
for eid, par, ch in [("te1", "t_root", "t_just"), ("te2", "t_root", "t_vk"),
                     ("te3", "t_vk", "t_ver"), ("te4", "t_vk", "t_vl"), ("te5", "t_vk", "t_gi"), ("te6", "t_vk", "t_entry"), ("te7", "t_vk", "t_vj"),
                     ("te8", "t_vk", "t_ci"), ("te9", "t_vk", "t_bl"), ("te10", "t_vk", "t_meta"), ("te11", "t_vk", "t_gen"),
                     ("te12", "t_gen", "t_tools"), ("te13", "t_gen", "t_gstamp"),
                     ("te14", "t_vk", "t_repo"), ("te15", "t_repo", "t_rstamp"), ("te16", "t_repo", "t_files"), ("te17", "t_repo", "t_init"), ("te18", "t_repo", "t_rjust"),
                     ("te19", "t_root", "t_user")]:
    lvl = {"t_root": 0, "t_vk": 1, "t_gen": 2, "t_repo": 2}[par]
    tedge(eid, par, ch, TW[lvl])
tree_end = ty
# ---- 右：會碰使用者東西 / version.toml / version.local.toml / .stamp / metadata / 矩陣 ----
RX, RW = 700, 900
ry = Y
def rblock(pid, label, style, text, y, pad=6):
    p2.append(v(f"{pid}_l", "1", TEXT(13) + "align=left;fontStyle=1;", label, RX, y, RW, 28))
    h = hv(text, RW, pad=pad)
    p2.append(v(pid, "1", style, text, RX, y + 32, RW, h))
    return y + 32 + h + 14
p2.append(v("p2_tc_l", "1", TEXT(13) + "align=left;fontStyle=1;", "「會碰使用者東西」只有兩列（不變量：可以建、要改先問、永不刪、永不覆蓋）", RX, ry, RW, 28))
