D_ROW1 = [
 ("d4_1", LT12, "<b>dist/files/</b>\n全部出貨，不含 symlink；materialize 原樣展開到 .vendor_kit/cache/<repo>/files/", 290),
 ("d4_2", v2m(LT12), "<b>dist/init.toml</b>\n[[file]] src／dest [mode=\"copy\"|\"append\"]，dest 相對專案根；禁止用整檔覆蓋（copy）指向根 .gitignore／.dockerignore／.editorconfig → 要用 append", 290),
 ("d4_3", v2m(LT12), "<b>dist/just/<ns>.just</b>\n每檔一個頂層命名空間，數量工具自決，<repo>.just 必須存在；跨工具撞名 → add 報錯；recipe 用 cd \"{{justfile_directory()}}\" 回專案根（禁止相對 working-directory）", 290),
 ("d4_4", LT12, "<b>Dockerfile.dist</b>\nFROM scratch + COPY dist/ /dist/；沒有程式、不 FROM vendor_kit", 290),
]
D_ROW2 = [
 ("d4_5", v2m(PT12), "<b>image ghcr.io/<org>/<repo>-dist:<tag></b>\n多架構 amd64 + arm64（同一次 buildx、COPY-only；CI 驗兩平台內容一致）；version.toml 與印記記 index digest（#26）；公開／私有工具自決（Q7）", 420),
 ("d4_6", v2m(PT12), "<b>引擎 image ghcr.io/<org>/vendor_kit:vN</b>\n公開；多架構 amd64 + arm64；也出 docker save tar 離線包（#27，bootstrap --local 吃）", 320),
 ("d4_7", LT12, "<b>工具 repo 的 CI</b>\n跑 vendor_kit 出貨的 check.sh --dist：dist 佈局、init.toml 合法（mode 只能 copy|append）、image 可展開、兩平台內容一致", 412),
