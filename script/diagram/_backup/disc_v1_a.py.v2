 ("m_lg", v2m(L12), "<b>launcher-gen</b>：產生薄殼（entry／vendor.just、.gitignore、check.sh）、gen/、根 justfile 一行"),
 ("m_bl", v2m(L12), "<b>baseline</b>：baseline/<repo>/ + metadata（完成標記、append 行、衝突中檔案）"),
 ("m_mg", v2m(L12), "<b>merge</b>：§5 逐檔狀態機（判斷後詢問）+ git merge-file --diff3"),
