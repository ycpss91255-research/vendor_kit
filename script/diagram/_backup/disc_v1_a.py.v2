ry += hv(NOT_T, RW) + 14
p2.append(v("p2_ver_l", "1", TEXT(13) + "align=left;fontStyle=1;", ".vendor_kit/version.toml（進 git；檔名待拍板 (1)，格式已定）", RX, ry, RW, 28))
VER_T = ("vendor_kit = \"ghcr.io/<org>/vendor_kit:vN@sha256:…\"      # 第一行固定：引擎 ref；啟動器 grep 讀\n"
