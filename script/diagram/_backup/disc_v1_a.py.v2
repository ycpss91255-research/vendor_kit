p3.append(v("p3_k0", "p3L5", TEXT(12) + "align=left;fontStyle=1;", "下游專案 CI（GitHub／GitLab 都一樣）：只呼叫 .vendor_kit/ci/check.sh，五步一關過才下一關", 20, 50, 260, KH))
x = 290; prev = None
for pid, t, w in CK:
