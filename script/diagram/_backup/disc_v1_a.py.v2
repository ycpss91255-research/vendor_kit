CH = [("c_a", "env-test", 100), ("c_b", "test-base", 100), ("c_c", "lint／unit／install／merge", 220), ("c_d", "release", 90),
      ("c_e", "release-test（amd64、arm64 原生 runner）", 250), ("c_f", "驗收：剛 build 的引擎 image + 乾淨 fixture repo 跑完整流程", 300)]
JM_T = "just 矩陣 1.33.0 + latest；lint 擋比 1.33 新的功能（ADR 記破壞性變更）；驗收用 dev vendor_kit -i <剛 build 的 tag> 同一機制"
