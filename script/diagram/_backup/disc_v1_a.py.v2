PX = 1320; PW = 280
p4.append(v("p4P", "1", SW(GREEN), "專案目錄（掛載為 /repo）", PX, LY, PW, LH))
p4.append(v("f_note", "p4P", TEXT(12) + "align=left;", "整個目錄 -v $PWD:/repo 掛進引擎；\n引擎只寫箭頭指到的路徑，\nsync 只寫 gitignore 路徑（cache/、gen/）", 15, mpos["m_reg"], 250, MH))
files = [
 ("f_repo", "m_ins", v2m(F_NOGIT), ".vendor_kit/cache/<repo>/（不進 git，不可改）\nfiles/、init.toml、just/、.stamp", "寫入（整批替換）"),
 ("f_ver", "m_ver", v2m(F_GIT), ".vendor_kit/version.toml（進 git）\nversion.local.toml（不進 git；dev 用）", "讀寫"),
 ("f_shell", "m_lg", v2m(F_GIT), "薄殼 .vendor_kit/ 與 gen/\nentry／vendor.just、.gitignore、check.sh、tools.just；根 justfile 一行", "寫入"),
 ("f_bl", "m_bl", F_GIT, ".vendor_kit/baseline/<repo>/（進 git）\n+ .vendor_kit.toml metadata", "寫入"),
]
for pid, m, st, t, lb in files:
    p4.append(v(pid, "p4P", st, t, 15, mpos[m], 250, MH))
    p4.append(e(f"{m}_{pid}", m, pid, lb, (1, 0.5), (0, 0.5)))
uy = mpos["m_mg"]; uh = mpos["m_init"] + MH - uy
p4.append(v("f_user", "p4P", v2m(F_USER), "初始檔（使用者的，進 git）\nDockerfile、.gitignore 的幾行…\n（路徑由 init.toml 的 dest 決定；\n永不刪、永不覆蓋）", 15, uy, 250, uh))
p4.append(e("m_mg_f_user", "m_mg", "f_user", "問後換／三方合併", (1, 0.5), (0, round((MH / 2) / uh, 4))))
p4.append(e("m_init_f_user", "m_init", "f_user", "add 時建／append", (1, 0.5), (0, round((uh - MH / 2) / uh, 4))))
PN_T = "不碰：使用者的 .gitignore、.git/info/exclude；\n根 justfile 只加一行（問／-y）；\n初始檔已存在 → 不納管、不覆蓋"
p4.append(v("p_note", "p4P", NOTE, PN_T, 15, uy + uh + 20, 250, hv(PN_T, 250, pad=8)))
# ---- 跨區的線 ----
my = LH - 30
p4.append(e("mount_repo", "p4P", "p4E", "掛載 /repo", (0, round(my / LH, 4)), (1, round(my / LH, 4))))
ty_abs = LY + 60 + 25
p4.append(e("mount_dist", "tmp", "p4E", "掛載\n/dist/<repo>:ro", (1, 0.5), (0, round((ty_abs - LY) / LH, 4))))
tmp_cx = 40 + GX + GW / 2
p4.append(e("pull_dist", "g_dist", "tmp", "拉 image（docker create／cp，不帶 --platform）", (round((tmp_cx - (40 + 380)) / 640, 4), 1), (0.5, 0), vert=True, pos=-0.5))
eng_x = 1200
p4.append(e("pull_eng", "g_eng", "p4E", "拉 image（docker run）", (round((eng_x - (40 + 1060)) / 480, 4), 1), (round((eng_x - EX) / EW, 4), 0), vert=True, pos=-0.5))
reg_x = EX + MX + 40
p4.append(e("q_reg", "m_reg", "g_dist", "查 tag／digest", (round(40 / MW, 4), 0), (round((reg_x - (40 + 380)) / 640, 4), 1), vert=True, pos=0.5))
h4c = LY + hpos["h4"][0] + hpos["h4"][1] / 2
p4.append(e("run_cli", "h4", "m_cli", "docker run 引擎\n<子命令> …", (1, 0.5), (0, round((h4c - (LY + M0)) / CLI_H, 4))))
Y = LY + LH + 30
p4 += legend("p4", 40, Y, ["purple", "v4mod", "v4host", "green", "yellow"], "實線 = 呼叫／資料流（線上文字 = 做什麼）\n模組間短箭頭 = 依賴方向（A→B：A 用 B）")
p4 += legend("p4b", 40, Y + 70, ["v2git", "v2no", "v2usr", "v3step", "v2chg", "note"], "cli → 七個模組的線 = cli 呼叫它們\n本頁無待拍板便條（見右上小註）")
p4 += terms("p4", 40, Y + 170, [
 ("引擎", "vendor_kit 的程式本體：只以 image 存在（公開、多架構）、只在容器內跑；8 個模組見紫色容器；一個專案只用 version.toml 第一行那一版"),
 ("啟動器", ".vendor_kit/ 裡的 POSIX sh 薄殼，在主機跑：grep version.toml、docker create／cp 抓工具檔、docker run 起引擎；不算引擎模組"),
 ("registry", "引擎模組：查 GHCR 的 tag 與 digest；只有 update／add／upgrade 會用，sync 不上網"),
 ("materialize", "引擎模組（v1 叫 install）：把 /dist/<repo> 展開到 cache/<repo>/、寫印記（index digest）、verify sha256"),
 ("launcher-gen", "引擎模組：產生 .vendor_kit/ 薄殼（entry／vendor.just、.gitignore、check.sh）、gen/tools.just、根 justfile 那一行"),
 ("sync", "vendor.just 每個動詞的自動前置（v1 叫 ensure）：比印記→materialize、比 gen/.stamp→換薄殼退出 1；只寫 cache/、gen/"),
 ("version.toml", ".vendor_kit/version.toml：唯一來源；version.local.toml = dev 覆寫（不進 git）；version 模組讀寫、啟動器只 grep 第一行"),
 ("append 模式", "init 模組對 mode=\"append\" 的初始檔：不建整檔，問後把幾行加進使用者的檔；merge 模組 upgrade 時只動原文相同的行"),
 ("多架構 index／index digest", "工具 image 與引擎 image 都是 amd64 + arm64 的 manifest list；docker 不帶 --platform 挑原生；印記與 version.toml 記 index 的 digest"),
 ("暫存目錄 <tmp>", "啟動器把工具 image 的 /dist 抓到主機的暫存資料夾，再唯讀掛進引擎當 /dist/<repo>；dev 時改掛 <dir>/dist"),
 ("掛載", "docker run -v：把主機目錄接進容器；/repo = 專案目錄（可寫），/dist/<repo> = 工具檔（唯讀）"),
 ("import-linter", "Python 工具：檢查模組間 import 方向，違反圖上箭頭就 CI 失敗"),
 ("純資料 image", "FROM scratch 只 COPY 檔案的 image，沒有程式；只能 docker create／cp，不能 run"),
 ("<repo>", "工具 repo 名；.vendor_kit/cache/<repo>/ = 專案裡展開的工具檔"),
])
pages_v1_a.append(("v1p4", "架構圖 v2：主機、引擎模組、registry", p4))
