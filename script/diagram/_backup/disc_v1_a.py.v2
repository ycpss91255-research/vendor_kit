# ---- ② 啟動器 ↔ 引擎 ----
S1 = "① grep version.toml 第一行\n→ 引擎 ref（version.local.toml 覆寫優先）"
S2 = "② 對每個要處理的工具：\ndocker create <image@digest> /x → docker cp c:/dist/. <tmp>/ → docker rm（多架構 index：不帶 --platform，daemon 挑原生；docker ≥ 19.03）"
S3 = ("③ docker run --rm -u uid:gid -v $PWD:/repo -v <tmp>:/dist/<repo>:ro <引擎> <子命令> …"
      "（dev 時改掛 <dir>/dist；rootless docker 偵測到就不加 -u）")
S4 = "引擎容器執行子命令\n→ 結束狀態 0／1／2 回到 just"
ERR = "否：用新引擎重寫薄殼 + gen → 退出 1\n統一印「vendor_kit 已更新 vX → vY，\n請再跑一次剛才的指令」"
SUB = ("<b>引擎子命令</b>：install | uninstall | add | remove | update | upgrade | dev | undev | sync | help；內部步驟 materialize | verify | merge（不對外）\n"
       "結束狀態 0 成功／1 失敗（不動 version.toml）／2 完成但有衝突；stdout 人類可讀，--porcelain 機器可讀（留給 CI）")
LOCK = "<b>專案目錄 flock</b>\n同一專案同時只跑一個引擎；等 60 秒逾時就失敗；VENDOR_KIT_NO_LOCK=1 跳過"
LSH = "<b>啟動器 = POSIX sh</b>：只用 docker pull／create／cp／run／rm + grep／sed；不裝 python、不解析 toml（所以 version.toml 第一行固定）；主機只需 docker ≥ 19.03（多架構 index）+ just ≥ 1.33 + sh"
ENS = "<b>vendor.just 每個動詞 recipe</b>：先跑 sync 前置（印記 ≠ version.toml → materialize；引擎 ref ≠ gen/.stamp → 換薄殼後退出 1；CI=1 自動 frozen），再 verb *args 一行轉發給啟動器"
ws = [("s1", v2m(L12), S1, 200), ("d1", RHOMBUS + "fontSize=12;", "gen/.stamp\n= 引擎 ref？", 190), ("s2", v2m(L12), S2, 340), ("s3", L12, S3, 400), ("s4", P12, S4, 220)]
hs = {"s1": hv(S1, 200), "d1": 80, "s2": hv(S2, 340), "s3": hv(S3, 400), "s4": hv(S4, 220)}
rowc = 50 + max(hs.values()) / 2
r2y = rowc + max(hs.values()) / 2 + 40
eh = 90; subh = hv(SUB, 560); lockh = hv(LOCK, 380)
r3y = r2y + max(eh, subh, lockh) + 20
r3h = max(hv(LSH, 740), hv(ENS, 750))
l2h = r3y + r3h + 20
p3.append(v("p3L2", "1", SW(NEUTRAL), "契約② 啟動器 ↔ 引擎（每次 just vendor_kit <動詞> 都走這三步；主機只需要 docker + sh + just）", 40, Y, 1560, l2h))
x = 30
prev = None
for pid, st, t, w in ws:
    h = hs[pid]
    p3.append(v(pid, "p3L2", st, t, x, rowc - h / 2, w, h))
    if prev: p3.append(e(f"{pid}_e", prev, pid, "是" if prev == "d1" else "", (1, 0.5), (0, 0.5)))
    prev = pid; x += w + 30
d1x = 30 + 200 + 30; d1c = d1x + 95
p3.append(v("p3_err", "p3L2", v2m(ELLIPSE(RED) + "fontSize=12;"), ERR, d1c - 180, r2y, 360, eh))
p3.append(e("p3_err_e", "d1", "p3_err", "否", (0.5, 1), (0.5, 0), vert=True))
p3.append(vb("p3_sub", "p3L2", v2m(LT12), SUB, d1c + 190, r2y, 560, max(eh, subh)))
p3.append(vb("p3_lock", "p3L2", LT12, LOCK, d1c + 190 + 560 + 30, r2y, 380, max(eh, subh)))
p3.append(vb("p3_sh", "p3L2", LT12, LSH, 30, r3y, 740, r3h))
