b.box("x2r", P, 2, v2(RULE), fl("保護清單在任何 remove 之前生效（v2.5 §10）；逐工具 remove 走保護模式：清單內的檔跳過"), 360)
b.box("x2c", E, 3, v2(SUB), fl("resolve 完 → stdout：保護清單、要刪清單、要問的（append 行、根 justfile 那行）＋ 輸入指紋"), 400)
b.box("x1b", L, 4, v2(W12), fl("docker run <引擎> apply uninstall（-n → apply --dry-run）"), 280)
b.box("x4a", E, 4, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("x4b", E, 5, v2(SUB), "重驗指紋", 240, ax="l")
b.box("x4bx", E, 5, v2(R12), "不同 → 1「請重跑」", 140, ax="r")
b.box("x3cx", U, 6, v2(R12), "是 → 1：印需改清單（frozen）", 220)
b.box("x3c", E, 6, v2(D12), "CI=1 且需改 tracked 檔？", 340, ax="l")
b.box("x3y", U, 7, v2(G12), "是 → 0：只印會刪什麼、會問什麼", 220)
