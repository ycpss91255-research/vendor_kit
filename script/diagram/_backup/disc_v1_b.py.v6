b.box("u5r", L, 6, v2(W12), fl("docker run … -v <tmp>:/dist:ro 引擎 apply undev <repo>"), 280)
b.box("u6a", E, 6, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("u6b", E, 7, v2(SUB), "重驗指紋", 240, ax="l")
b.box("u6bx", E, 7, v2(R12), "不同 → 1「請重跑」", 140, ax="r")
b.box("u6l", E, 8, v2(SUB), "建進度日誌（.vendor_kit/.tmp.*；第一個寫入前）", 400)
b.box("u6lf", P, 8, F12, "＋.vendor_kit/.tmp.*（進度日誌，不進 git）", 360)
