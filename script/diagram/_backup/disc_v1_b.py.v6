# ================= P7b：upgrade ── C. 逐檔判斷、C′ 衝突重入、D. 回退 =================
T7B = [
 ("B／D／N", "B = baseline（上次合併時的範本副本，進 git）；D = 現況（專案裡你的那份檔）；N = 目標版範本 = 啟動器把目標版 image 展開到暫存、掛進引擎的 /dist/<repo>（不是 cache；v2.5 §2）；「D==B」= 你沒改過"),
 ("逐檔判斷後詢問／apply", "apply = 動詞的第二段（拿到 flock、重驗指紋、建日誌後才寫檔）；三份比：N 改了才問「換成新版？」，兩邊都改才問「三方合併？」；-y 免問；拒絕 → 不動、metadata 記 declined；全部在暫存完成再逐檔原子替換；materialize 到 cache 在決定套用之後"),
 ("resolve／apply", "同一動詞兩段：resolve 只讀只算（查目標版、輸出要拉的 image 與輸入指紋，不寫檔）→ 啟動器 docker 拉 image、展開到暫存 → apply 拿 flock 後重驗指紋才寫"),
 ("flock／指紋", "flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎；指紋 = resolve 讀過的檔的 hash＋鎖定 digest，apply 拿鎖後重驗，不同 → 1「請重跑」"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源 ref@digest、最後合併版本、完成標記、append 過的行、拒絕過（declined）、衝突中檔案清單、進度日誌 state；衝突重入靠它的「衝突中檔案」清單"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< vendor_kit:baseline ||||||| ======= >>>>>>> 標記（我們自己的標籤）；回傳衝突數 → 映射為結束狀態 2"),
 ("衝突重入（v2.2 D (0)）", "再跑 upgrade 時 resolve 先看 metadata 的「衝突中檔案」：檔內仍有我們的標籤 → 2 停；檔案失蹤不算已解；都乾淨 → apply 拿鎖、建日誌後清除狀態再往下"),
 ("--dry-run／CI", "apply --dry-run 唯讀預覽：只印會問哪些檔（哪些要換／合併／append 替換；讀 /dist/<repo>），不動任何檔；本機 → 0；CI=1 且需改 tracked 檔 → 1（與 -y 無關）"),
 ("append 行／CRLF", "strategy=append 的初始檔：upgrade 找上次插入的行（CRLF = Windows 換行 \\r\\n，與 LF 視為相同；其餘精確）→ 問後替換；零命中或多處 → 保留只 warn"),
 ("二進位／symlink", "二進位 = 不是文字的檔（圖片等）；symlink = 指向另一個路徑的捷徑；兩者不做行內合併：你沒改才換，改過保留 + warn；dist/files/ 第一版禁止 symlink"),
 ("回退／git revert", "git revert = 產生一個反向 commit 把那次升級（version.toml、初始檔、baseline 同一 commit）整組退回；下次 just 的 sync 看印記 ≠ version.toml → 只把 cache/<repo>/ 換回舊版"),
 ("GHCR／image／印記", "GHCR = GitHub 的容器倉庫；image = 打包好的 dist/；印記 = gen/<repo>.stamp（第一行 index digest，之後每檔 sha256），sync 拿它跟 version.toml 鎖定 digest 比"),
 EXIT3,
]
N7B = "已定（v2.3 §1）：append 行比對 CRLF／LF 視為相同、其餘精確；找不到或多處 → 保留只 warn。已定（v2.2 E）：dist/files/ 第一版禁止 symlink。已定（v2.5 §2）：N 讀暫存 /dist/<repo>，materialize 在決定套用之後。自身升級見「E. 自身升級」頁。"
p7b, F = newpage("流程 v2：upgrade ── C. 逐檔判斷表、C′ 衝突重入、D. 回退（§5、v2.2 D、v2.3 §1、v2.5 §1／§2／§4）", N7B, COLS7)
b = F.band("uC", "C. 逐檔判斷後詢問（每個 init.toml 檔；引擎 merge 模組；§5 表；在 apply 內、拿到 flock、建日誌後）＋ C′ 衝突重入（v2.2 D (0)、v2.5 §3）", v2=True)
tx, ty = 20, 70; cws = [170, 290, 230]
b.free("c_in0", F12, "B = baseline/<repo>/<檔>（上次合併的範本）", 1300, 50, 280, 40)
b.free("c_in1", F12, "D = 專案裡的 <檔>（現況，你可能改過）", 1300, 106, 280, 40)
b.free("c_in2", v2(F12), "N = 目標版範本：暫存 /dist/<repo>/<檔>（不是 cache）", 1300, 162, 280, 40)
b.free("c_m", SUB, "引擎 merge 模組：三份比對，逐檔判斷（左表）→ 要改的先問（-y 免問；拒絕 → 不動、記 declined）", 730, 54, 340, 60)
b.P("c_e0", "c_in0", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 70), (20 + 1276, F.y + 84)])
b.P("c_e1", "c_in1", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 126), (20 + 1276, F.y + 84)])
b.P("c_e2", "c_in2", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 182), (20 + 1276, F.y + 84)])
rows = [("新版沒改／你的檔已等於新版（N==B 或 D==N）", "不動", "—"),
        ("新版改了、你沒改（D==B、N≠B）", "問「X 換成新版？」", "同意 → 換；拒絕 → 不動、metadata 記 declined"),
        ("兩邊都改（D≠B、N≠B）", "問「你和新版都改了 X，要三方合併嗎？」→ git merge-file --diff3（在暫存做）", "乾淨 → 原子替換寫入；衝突 → 留 <<<<<<< vendor_kit:baseline 標記、回 2；baseline 仍推到目標版；解完重跑直到乾淨；拒絕 → 不動、記 declined"),
        ("新版新增（B 無）", "問「要建 X 嗎」（-y 建）；已有同名 → 不納管", "拒絕 → 不建、記 declined（之後不問，dry-run／check.sh 印「有 N 個範本你拒絕過」）；不覆蓋、印「已存在，範本在 cache」"),
        ("新版刪除該檔（N 無）", "不刪，只 warn", "你的檔留著"),
        ("append 行（strategy=append）", "找到上次插入的行（CRLF／LF 視為相同，其餘精確）→ 問後替換", "唯一命中 → 替換；零命中或多處 → 保留只 warn、印新內容；拒絕 → 不動、記 declined"),
        ("二進位／symlink", "不合併：你未改（D==B）才換", "改過 → 保留 + warn"),
        ("CI=1 且需改 tracked 檔", "apply 印清單 → 1（version.toml 未動；與 -y 無關）", "--dry-run 也一樣：CI 需改 tracked 檔 → 1；本機 → 0 只印清單")]
for i, hh in enumerate(["情況", "做法", "結果"]):
    b.free(f"c_h{i}", HDR, hh, tx + sum(cws[:i]), ty, cws[i], 28, minh=28)
cy = ty + 28
for r, row in enumerate(rows):
    rh = max(40, math.ceil(max(need_h(c, 12, w) for c, w in zip(row, cws))) + 4)
    for i, (c, w) in enumerate(zip(row, cws)):
        b.free(f"c_r{r}c{i}", TERM_K if i == 0 else TERM_V, c, tx + sum(cws[:i]), cy, w, rh, minh=rh)
    cy += rh
b.free("c_note", NOTE, "--dry-run = 唯讀預覽，只印會問哪些檔。衝突解完 → 再跑一次 upgrade 直到乾淨。dest 撞名規則見「add」頁。", 1300, 218, 280, 60)
b.P("c_e3", "c_m", "c_h2", "", (0, 0.5), (1, 0.5), [])
cy2 = cy + 30
b.free("cx_l", LBL, "C′ 衝突重入（解完衝突後再跑 upgrade；v2.2 D (0)）—— 偵測在 resolve，清除在 apply（拿鎖、建日誌後）", 20, cy2, 700, 24, minh=24)
b.free("cx0", G12, "解完衝突後再跑 upgrade <repo>", 20, cy2 + 40, 220, 58)
b.free("cx1", v2(D12), "衝突檔仍含我們的標籤？", 730, cy2 + 35, 340, 50)
b.free("cx2", R12, "是 → 2：停（先解完標記）", 1100, cy2 + 36, 200, 58)
b.free("cx3", v2(W12), "否：apply 拿鎖、建日誌後清除衝突狀態 → 接 B 的 (1)(2)（version.toml、baseline 已在目標版 → 通常「不動」）", 730, cy2 + 110, 340, 40)
b.P("cx_e0", "cx0", "cx1", "", (1, 0.5), (0, 0.5), [])
b.P("cx_e1", "cx1", "cx2", "是", (1, 0.5), (0, 0.5), [])
b.P("cx_e2", "cx1", "cx3", "否", (0.5, 1), (0.5, 0), [], vert=True, pos=-0.4)
b.close()
b = F.band("uD", "D. 回退 ＝ git revert 該升級 commit（version.toml + 初始檔 + baseline 同一 commit）；下次 just 的 sync 只把 cache/ 換回舊版")
b.box("d0", U, 0, G12, "git revert 該升級 commit", 220)
b.box("d1a", L, 0, W12, "下次 just：docker run 引擎 resolve sync", 240)
b.box("d2", E, 0, SUB, fl("sync resolve：gen/<repo>.stamp 第一行 ≠ version.toml 鎖定 digest → 待辦「materialize 舊版」"), 360)
b.box("d3b", U, 1, F12, fl("初始檔、baseline/<repo>/、version.toml（由 git revert 還原，不是 sync 寫）"), 220)
b.box("d1b", L, 1, W12, "docker pull 舊版（已有則略）", 240)
b.box("d1g", G, 1, IMG, "<repo>-dist@digest\n（version.toml 還原後的舊版）", 180)
b.box("d1c", L, 2, W12, "docker create <img> /x", 240)
b.box("d1d", L, 3, W12, "docker cp c:/dist/. <tmp>/<repo>/", 240)
b.box("d1e", L, 4, W12, "docker rm 該容器", 240)
b.box("d1f", L, 5, W12, "docker run … -v <tmp>:/dist:ro 引擎 apply sync", 240)
b.box("d2c", E, 5, SUB, fl("materialize 舊版 → cache/<repo>/、寫印記（只寫 cache/、gen/；初始檔與 baseline 不碰）"), 360)
b.box("d3", P, 5, F12, fl("cache/<repo>/、gen/<repo>.stamp（舊版；sync 寫）"), 280)
b.H("de1", "d0", "d1a"); b.H("de2", "d1a", "d2"); b.D("de2b", "d2", "d1b"); b.H("de2g", "d1g", "d1b", "拉 /dist"); b.D("de2c", "d1b", "d1c"); b.D("de2d", "d1c", "d1d"); b.D("de2e", "d1d", "d1e"); b.D("de2f", "d1e", "d1f")
b.H("de2h", "d1f", "d2c"); b.H("de3", "d2c", "d3", "寫"); b.D("de4", "d0", "d3b")
b.close()
foot(p7b, "p7b", F.y, T7B, ALL - {"inv", "tree", "pend", "rule"})
pages_v1_b.append(("v1p7b", "流程 v2：upgrade ── 逐檔判斷、衝突重入、回退", p7b))

# ================= P7bc：upgrade ── E. 自身升級 =================
T7E = [
 ("自身升級（v2.3 §2、v2.5 §7）", "(a) 不帶 repo：resolve 先判斷引擎有沒有新版；有 → 舊引擎 apply（拿鎖、重驗、建日誌）只改第一行 → 啟動器同一次指令內用新引擎跑 upgrade vendor_kit → 1；(b) 別人 pull 後只回 1 提示；(c) upgrade vendor_kit：比對薄殼 → 重產 → 1「請 commit 並再跑原指令」"),
 ("resolve／apply", "同一動詞兩段：resolve 只讀只算（預檢、查引擎最新版、輸出指紋）；apply 拿 flock、重驗指紋、建日誌後才寫；舊引擎的 apply 只改 version.toml 第一行"),
 ("薄殼首行自描述（Q17）／上次產物", "薄殼每檔首行 # vendor_kit-shell/<P> engine=<vX> sha256=<其餘內容 hash>；「薄殼 == 上次產物」= 首行 hash 與內容相符（引擎重算 + 對 image 內模板二次比對）；被改過 → 1 列差異不動"),
 ("gen/.stamp", "不進 git；只記引擎 ref（v2.4 Q17）；只由 install／upgrade vendor_kit 寫；啟動器每次 just 拿它跟 version.toml 第一行比，不符 → 1 提示 upgrade vendor_kit（需要人動作）"),
 ("GHCR／引擎 image／引擎 ref", "GHCR = GitHub 的容器倉庫；引擎 image = ghcr.io/…/vendor_kit:vN；引擎 ref = version.toml 第一行指到的那一個（tag@digest）"),
 ("image ID／--pull never／local 覆寫", "本機引擎覆寫（dev vendor_kit -i）在 version.local.toml 記 tag + image ID；自身升級遇覆寫用該本機 image 跑，docker run --pull never（不去 GHCR 拉）"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源、最後合併版本、完成標記、append 行、declined、進度日誌 state；不帶 repo 的 upgrade 預檢會讀每個工具的 metadata"),
 ("flock／指紋／進度日誌", "flock = 專案目錄鎖（60 秒），鎖在引擎；指紋 = resolve 讀過的檔的 hash，apply 重驗，不同 → 1「請重跑」；進度日誌 = 第一個寫入前建、最後一步刪"),
 ("dev 覆寫／undev", "工具在 version.local.toml 有 path:<dir> 覆寫；不帶 repo 的 upgrade 預檢遇到 → 1 提示先 undev（v2.5 §6）"),
 ("--protocol P", "薄殼每次呼叫附 --protocol P（v2.4 Q16）；舊薄殼跑新 major 引擎的一般動詞 → 乾淨回 3 提示先 upgrade vendor_kit；救援路徑（install／upgrade vendor_kit／sync 不符提示）永久可用"),
 EXIT3,
]
N7E = "已定（v2.3 §2、v2.5 §7）：自身升級統一版 —— (a) 不帶 repo：resolve 先判斷「引擎有新版？」，否 → 只升工具；是 → 舊引擎 apply（拿鎖、重驗、建日誌）只改第一行 → 啟動器：local 覆寫有 vendor_kit= → 用該 image --pull never，否則 pull 新引擎 → 新引擎 upgrade vendor_kit；結束 1 = 需要人動作（橙）。"
p7bc, F = newpage("流程 v2：upgrade ── E. vendor_kit 自身升級（v2.2 A／B、v2.3 §2、v2.4 Q16／Q17、v2.5 §7）", N7E, COLS7)
b = F.band("uE", "E. vendor_kit 自身升級（v2.3 §2 統一版、v2.5 §7）：(a) upgrade 不帶 repo 當次換新引擎並重產薄殼；(b) 別人 pull 後只回 1 提示；(c) upgrade vendor_kit 比對薄殼 → 重產 → 1；install 修復也走同樣比對", v2=True)
b.box("s0", U, 0, v2(G12), "(a) upgrade 不帶 repo（含 vendor_kit 自身）", 220)
b.box("s1", L, 0, v2(W12), "docker run 舊引擎 resolve upgrade（全部）", 240)
b.box("s2a", E, 0, v2(SUB), fl("resolve：先完整預檢（含 dev 中工具 → 1 提示 undev）"), 360)
b.box("s2n", U, 1, v2(G12), "否 → 只升工具（走 B，對每個工具）", 220)
b.box("s2q", E, 1, v2(D12), "引擎有新版？", 240, ax="l")
b.box("s2b", E, 2, v2(SUB), "是：apply（舊引擎）：flock 專案目錄", 360)
b.box("s2c", E, 3, v2(SUB), "重驗指紋（不同 → 1「請重跑」）", 360)
b.box("s2d", E, 4, v2(SUB), "建進度日誌（第一個寫入前）", 360)
b.box("s2e", E, 5, v2(SUB), fl("只改 version.toml 第一行 → 新引擎 ref（其餘工具等重跑原指令）"), 360)
b.box("s2f", P, 5, F12, "version.toml 第一行 = 新引擎 ref", 280)
b.box("s2g", E, 6, v2(SUB), "刪進度日誌 → 回報啟動器「引擎已變」", 360)
b.box("s2l", L, 7, v2(D12), "local 覆寫有 vendor_kit=？", 240)
b.box("s2ln", L, 8, v2(W12), "否：docker pull 新引擎", 110, ax="l")
b.box("s2ly", L, 8, v2(W12), "是：用該本機 image（--pull never）", 110, ax="r")
b.box("s2gi", G, 8, IMG, "vendor_kit:vY\n（新引擎）", 180)
b.box("s4", U, 9, v2(G12), "→ 同一次指令內接 (c) 的引擎段（用新引擎）", 220)
b.box("s2r", L, 9, v2(W12), "docker run 新引擎 upgrade vendor_kit", 240)
b.box("s5", U, 10, v2(G12), "(b) 別人 pull 後（第一行已變）打任何 just", 220)
b.box("s6a", L, 10, v2(W12), "啟動器：grep version.toml 第一行", 240)
b.box("s8", U, 11, v2(O12), fl("否 → 1：印「已更新 vX → vY，請 upgrade vendor_kit」→ 走 (c)"), 220)
b.box("s6q", L, 11, v2(D12), "gen/.stamp 的引擎 ref == 第一行？", 240)
b.box("s6y", L, 12, G12, "是 → 正常跑（sync 頁）", 240)
b.H("se1", "s0", "s1"); b.H("se2", "s1", "s2a"); b.D("se2q", "s2a", "s2q", al=True); b.H("se2n", "s2q", "s2n", "否")
b.D("se3", "s2q", "s2b", "是", al=True); b.D("se3c", "s2b", "s2c"); b.D("se3d", "s2c", "s2d"); b.D("se3e", "s2d", "s2e"); b.H("se4", "s2e", "s2f", "寫")
b.D("se3g", "s2e", "s2g"); b.D("se5", "s2g", "s2l"); b.D("se5n", "s2l", "s2ln", "否", 0.25, 0.5, al=True); b.D("se5y", "s2l", "s2ly", "是", 0.75, 0.5, al=True)
b.H("se6", "s2ly", "s2gi", "讀本機"); b.D("se6n", "s2ln", "s2r", al=True); b.D("se6y", "s2ly", "s2r", al=True); b.H("se7", "s2r", "s4")
b.H("se8", "s5", "s6a"); b.D("se8q", "s6a", "s6q"); b.H("se9", "s6q", "s8", "否"); b.D("se9y", "s6q", "s6y", "是")
b.close()
