# ================= P6：sync（1）第 1 段 resolve =================
T6 = [
 ("sync", "vendor.just 的前置 recipe：每次 just 自動跑；可寫範圍只有 cache/<repo>/、gen/tools.just、gen/<repo>.stamp（永不寫薄殼、永不寫 gen/.stamp）；範圍 = 全部工具；無待辦 → 快路徑只跑一次檢查（不起第二個容器）"),
 ("resolve／apply", "同一動詞兩段：resolve 只讀只算，把待辦清單（要拉哪些 image、要重裝什麼、要不要重生 tools.just）＋輸入指紋以 stdout 一行一項回啟動器；apply 拿 flock 後重驗指紋才寫"),
 ("stdout／stderr／指紋", "stdout = 給啟動器讀的結果（固定欄位）；stderr = 給人看的診斷；指紋 = resolve 讀過的 version.toml、metadata 等的 hash，apply 重驗，不同 → 1「請重跑」"),
 ("frozen（CI=1）", "CI 下只准寫 cache/、gen/；不查最新版（只拉鎖定版）；任何需要寫 tracked 檔的情況 → 1 印清單（與 -y 無關）；警告升為失敗：薄殼不符、baseline 落後、未完成接入、任何 version.local.toml 覆寫 → 1"),
 ("統一提示（Q10 (2)）", "啟動器發現引擎 ref ≠ gen/.stamp → 不重寫，退出 1 固定印「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」（需要人動作，橙）；install／upgrade vendor_kit 跳過這關"),
 ("薄殼／引擎 ref／hash", "薄殼 = .vendor_kit/ 裡 vendor_kit 自己的 tracked 檔（entry.just、vendor.just、.gitignore、ci/check.sh；首行自描述）；引擎 ref = version.toml 第一行的引擎 image 版本；hash = 內容指紋"),
 ("gen/ 三種檔", "gen/tools.just：每個 <ns>.just 一行 mod，sync／add／remove／upgrade 重生；gen/.stamp：只記引擎 ref，只由 install／upgrade vendor_kit 寫；gen/<repo>.stamp：每工具印記（第一行 index digest 或 path:，之後每檔 sha256）"),
 ("materialize／印記／index digest", "把啟動器 docker create/cp 取來的 /dist/<repo> 展開到 cache/<repo>/；印記 gen/<repo>.stamp 第一行 = index digest（多架構 image 總目錄的 sha256 ID；dev 時是 path:<dir>）"),
 ("image tag／digest／image ID", "tag = 人看的版本名（可重 build 換內容）；digest = 從倉庫拉來的內容 sha256（鎖定用）；image ID = 本機 image 內容的 ID —— 引擎覆寫用本機 tag，沒有 digest，所以另記 image ID（同 tag 重 build 才會被發現）"),
 ("verify／sha256", "sha256 = 檔案內容算出的指紋；verify 把 cache/<repo>/ 每個檔的 sha256 跟印記比；不符 → 重裝 + warn（使用者不可改 cache/）；cache 缺或印記變了就直接重裝，不 verify"),
 ("metadata／完成標記／落後", "baseline/<repo>/.vendor_kit.toml：無完成標記 = add 沒做完 → 1；最後合併版本 ≠ version.toml = 有人只改了 version.toml → 提示 upgrade（CI → 1）"),
 ("mod／recipe", "mod = 把工具的 just 檔掛成一個命名空間（just <ns> …）的那一行；recipe = justfile 裡的一條指令；gen/tools.just 只有 mod 行、沒有 recipe"),
 ("symlink", "指向另一個路徑的捷徑；dev 中的工具 cache/<repo>/ 不放檔案，而是指到本機工具 repo 的 dist/，所以 sync 跳過它的 materialize／verify"),
 ("覆寫兩種（v2.1 B／v2.2 B）", "引擎覆寫 vendor_kit = \"<tag>\"＋image ID → 啟動器用該本機 image（--pull never）；工具覆寫 <repo> = \"path:<dir>\" → cache 是 symlink，仍查 metadata／baseline"),
 ("GHCR／image／daemon／CI／flock", "GHCR = GitHub 容器倉庫；image = 打包好的 dist/；daemon = 主機的 docker 服務；CI = 自動測試環境（CI=1 → frozen）；flock = 專案目錄鎖（60 秒），鎖在引擎"),
 EXIT3,
]
N6 = "已定（Q10 (2)、v2.3 §2）：薄殼／gen 與 version.toml 引擎不符 → 啟動器只回 1 提示 just vendor_kit upgrade vendor_kit（需要人動作）；install／upgrade vendor_kit 跳過這關。已定（v2.5 §9）：sync 可寫範圍 = cache/<repo>/、gen/tools.just、gen/<repo>.stamp；快路徑前要先判斷 tools.just 缺或需重生。"
p6, F = newpage("流程 v2：sync（1）第 1 段 resolve（§2／§6、v2.2 A／B／E、v2.3 §2～§4、v2.5 §9）", N6, COLS5)
b = F.band("eA", "sync（任何 just 指令的前置；CI=1 自動 frozen）：第 1 段 = 啟動器比對 gen/.stamp（install／upgrade vendor_kit 跳過）→ 引擎 resolve sync（不寫任何檔）→ 無待辦 → 快路徑 0；有待辦 → 第 2 段見「sync（2）」頁", v2=True)
b.box("n0", U, 0, G12, "打任何 just 指令（sync 自動前置）", 220)
b.box("n1", L, 0, v2(W12), fl("grep version.toml 第一行取引擎 ref（version.local.toml 的 vendor_kit 覆寫優先）"), 280)
b.files("n2", P, 0, "讀", [".vendor_kit/version.toml（進 git）", ".vendor_kit/version.local.toml（不進 git，dev 用）"], 360)
b.box("n3n", U, 1, v2(O12), fl("否 → 1：印「vendor_kit 已更新 vX → vY，請 upgrade vendor_kit」"), 220)
b.box("n3", L, 1, v2(D12), "gen/.stamp 的引擎 ref ＝ 第一行？", 260, ax="r")
b.box("n6", P, 1, v2(RULE), fl("統一提示（Q10 (2)、v2.3 §2）：啟動器發現 gen/.stamp ≠ 引擎 ref → 退出 1 印「vendor_kit 已更新 vX → vY，請 just vendor_kit upgrade vendor_kit」；不自動重寫、不自動續跑；install／upgrade vendor_kit 不受此關（啟動器對這兩個動詞跳過比對）"), 360)
b.box("n1b", L, 2, v2(W12), fl("是：docker run <引擎> resolve sync（覆寫時用該本機 image，--pull never）"), 280)
b.box("n6b", P, 2, v2(RULE), fl("薄殼重產（v2.2 A、Q10 (2)、Q17）：只由 install 與 upgrade vendor_kit 做；做之前比對現內容 == 上次產物（首行自描述 hash），相同 → 重產，被改過 → 1 列差異不動；sync 永不寫薄殼"), 360)
b.box("ncx", U, 3, v2(R12), "是 → 1：CI 拒絕本機覆寫（frozen）", 220)
b.box("nc", E, 3, v2(D12), "CI=1 且有 local 覆寫？", 330, ax="l")
b.box("nf", P, 3, v2(RULE), fl("frozen（CI=1，v2.2 A、v2.5 §1）= 只准寫 cache/、gen/；不查最新版；仍拉鎖定版 image；任何需要寫 tracked 檔 → 1（與 -y 無關）；升為失敗的警告：薄殼不符、baseline 落後、未完成接入、任何 local 覆寫"), 360)
b.box("nl", G, 4, LBL, "← 對每個工具重複\n（範圍 = 全部；先比印記，便宜）", 220, 40, minh=40)
b.box("t0", E, 4, v2(D12), "path 覆寫（dev 中）？", 250, ax="l")
b.box("t0s", E, 4, v2(W12), fl("是：跳過 materialize／verify，仍查 metadata、baseline ↓"), 130, ax="r")
b.box("t0r", P, 4, v2(RULE), fl("覆寫兩種（v2.1 B）：引擎 vendor_kit = \"<tag>\"＋image ID → 啟動器用該本機 image；工具 <repo> = \"path:<dir>\" → cache/<repo>/ 是 symlink，跳過 materialize／verify"), 360)
b.box("t1", E, 5, v2(D12), "cache 缺或印記 ≠ 鎖定 digest？", 240, ax="l")
b.box("t1y", E, 5, v2(W12), fl("是：列待辦「materialize 鎖定版」（不 verify 舊 cache）"), 130, ax="r")
b.box("t2", E, 6, D12, "verify：每檔 sha256 ＝ 印記？", 240, ax="l")
b.box("t2n", E, 6, W12, fl("否：列待辦「重裝 + warn（cache 被改過）」"), 130, ax="r")
b.box("t3a", U, 7, R12, "否 → 1：從未完成接入，請 add <repo>", 220)
