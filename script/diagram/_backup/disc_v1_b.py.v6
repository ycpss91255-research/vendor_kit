# ================= P8：dev =================
T8 = [
 ("dev／undev", "用本機工具 repo 的 dist/ 取代 image（開發工具本身用；工具必須已在 version.toml）／回到 version.toml 鎖定版；dev 自身則是換引擎 image"),
 ("覆寫兩種（v2.1 B）", "工具 path 覆寫 <repo> = \"path:<dir>\"：cache/<repo>/ 變 symlink，sync 跳過該工具 materialize／verify 但仍檢查 metadata、baseline；引擎 tag 覆寫 vendor_kit = \"<tag>\"＋image ID：啟動器改用該本機 image"),
 ("resolve／apply", "undev 分兩段：resolve 只讀只算（列要拉的鎖定版 image、輸出指紋，不寫檔）→ 啟動器拉 image → apply 拿 flock、重驗指紋、建日誌後才刪覆寫、拆 symlink、重新 materialize；dev 不拉 image"),
 ("version.local.toml", ".vendor_kit/version.local.toml，不進 git（.vendor_kit/.gitignore 排除；不碰 .git/info/exclude）；記 <repo> = \"path:<dir>\" 或 vendor_kit = \"<tag>\" + image ID（成對，undev 一起撤）"),
 ("symlink／印記／materialize", "symlink = 指向另一個路徑的捷徑：dev 時 cache/<repo>/ 不放檔案，而是指到 <dir>/dist；印記 gen/<repo>.stamp 在 symlink 外，第一行 path:<dir> 或 index digest（多架構 image 的 sha256 ID）；materialize = 把 image 的 /dist 展開到 cache/<repo>/"),
 ("image tag／image ID／RepoDigests", "tag = 人取的版本名（可重 build 換內容）；image ID = 本機 image 內容的 ID（同 tag 重 build 才會被發現）；RepoDigests = 從倉庫拉來才有的 digest，docker load 的 tar 沒有 → 自身 dev 只能用 tag"),
 ("GHCR／tar／docker load", "GHCR = GitHub 的容器倉庫（正常情況引擎 image 從這裡 pull）；tar = 離線包（docker save 存的 image 檔）；docker load = 把 tar 讀進本機 docker，之後才能用 -i <tag> 指定它"),
 ("--pull never／掛載 -v", "docker run --pull never = 只用本機 image，不去 GHCR 拉；-v <dir>/dist:/dist/<repo>:ro = 把本機目錄唯讀掛進容器"),
 ("統一提示／gen/.stamp（Q10 (2)）", "gen/.stamp 只記引擎 ref（或本機 tag）；啟動器先比對它 ≠ 現在要用的引擎 → 不起容器、只退出 1 印「請 just vendor_kit upgrade vendor_kit」（需要人動作，橙）；upgrade vendor_kit 比對薄殼首行自描述才重產薄殼"),
 ("metadata／baseline", "baseline/<repo>/.vendor_kit.toml：完成標記、最後合併版本等；dev 中 sync 仍檢查這兩項（未完成接入 → 1；baseline 落後 → warn／CI 1）"),
 ("flock／指紋／進度日誌／CI", "flock = 專案目錄鎖（60 秒），鎖在引擎；指紋 = resolve 讀過的檔的 hash，apply 重驗；進度日誌（undev 用 .vendor_kit/.tmp.*）第一個寫入前建、最後刪；CI = 自動測試環境，CI=1 時 dev 一律拒絕、sync 看到任何覆寫 → 1"),
 EXIT3,
]
N8 = "已定：工具 path 覆寫與引擎 tag 覆寫分開處理（v2.1 B）；引擎覆寫記 tag + image ID、--pull never（v2.2 B）；每工具印記在 gen/<repo>.stamp，不放在 symlink 內（v2.3 §3）；undev 走 resolve → docker → apply，撤覆寫行含 image ID、建日誌後才動（v2.5 §10）。"
p8, F = newpage("流程 v2：dev（§2 dev 列；v2.1 B、v2.2 B、v2.3 §3；<repo> = 工具 repo 名）", N8, COLS5)
b = F.band("vA", "dev <repo> -p <dir>：工具 path 覆寫（v2.1 B）—— 用本機工具 repo 的 dist/ 取代 image（不進 git；CI 拒絕；工具必須已在 version.toml；不經 docker create/cp）", v2=True)
b.box("d0", U, 0, G12, "just vendor_kit dev <repo> -p <dir>", 220)
b.box("d1q", L, 0, v2(D12), "<dir>/dist/init.toml 存在？", 260)
b.box("d1x", U, 1, v2(R12), "否 → 1：<dir>/dist/init.toml 不存在", 220)
b.box("d1", L, 1, v2(W12), fl("是：docker run 引擎 dev <repo> -p（-v <dir>/dist:/dist/<repo>:ro）"), 200, ax="r")
b.box("d3a", U, 2, R12, "是 → 1：CI 拒絕 dev", 220)
b.box("d2a", E, 2, D12, "CI=1？", 130, ax="l")
b.box("d2b", E, 2, D12, "已接入 <repo>？", 240, ax="r")
b.box("d3c", U, 3, R12, "否 → 1：dist/ 或 init.toml 不合法", 220)
b.box("d2c", E, 3, D12, "dist 合法？", 180, ax="l")
b.box("d3b", E, 3, R12, "否 → 1：未接入，請先 add <repo>", 190, ax="r")
b.box("d6a", E, 4, v2(SUB), "是：flock 專案目錄（60 秒）", 400)
b.box("d6", E, 5, v2(SUB), fl("寫 version.local.toml：<repo> = \"path:<dir>\"（.vendor_kit/.gitignore 已排除它；不碰 .git/info/exclude）"), 400)
b.box("d6f", P, 5, F12, fl("＋version.local.toml（不進 git）：<repo> = \"path:<dir>\""), 360)
b.box("d7", E, 6, SUB, "cache/<repo>/ 改為 symlink → <dir>/dist（本機工具 repo 的 dist/，唯讀）", 400)
b.box("d7f", P, 6, F12, "cache/<repo>/ → <dir>/dist（symlink，內容不複製）", 360)
b.box("d7b", E, 7, v2(SUB), fl("寫印記 gen/<repo>.stamp 第一行 = path:<dir>（印記不放在 symlink 裡）"), 400)
b.box("d7bf", P, 7, F12, "gen/<repo>.stamp 第一行：path:<dir>（不進 git）", 360)
b.box("d8", U, 8, v2(G12), "0：之後每次 just 用 <dir>", 220)
b.box("d9", E, 8, v2(RULE), fl("dev 中的工具：sync 跳過它的 materialize／verify，仍檢查 metadata／baseline；upgrade <repo>／remove <repo> → 1 提示先 undev（v2.1 B、v2.5 §6）；不帶 repo 的 upgrade 預檢也會擋"), 300, ax="r")
b.H("de1", "d0", "d1q"); b.DL("de1x", "d1q", "d1x", "否", 0.15); b.D("de1y", "d1q", "d1", "是", 0.65, 0.5, al=True); b.D("de2", "d1", "d2a")
b.H("de3", "d2a", "d3a", "是"); b.H("de4", "d2a", "d2b", "否")
b.D("de5", "d2b", "d2c", "是", 0.3, 0.5); b.D("de6", "d2b", "d3b", "否", 0.7, 0.5, al=True); b.H("de7", "d2c", "d3c", "否")
b.D("de8", "d2c", "d6a", "是", al=True); b.D("de8b", "d6a", "d6"); b.H("de9", "d6", "d6f", "寫"); b.D("de10", "d6", "d7"); b.H("de11", "d7", "d7f", "寫")
b.D("de12", "d7", "d7b"); b.H("de13", "d7b", "d7bf", "寫"); b.DL("de14", "d7b", "d8", "", 0.1)
b.close()
b = F.band("vI", "dev vendor_kit -i <本機 image tag>：引擎 tag 覆寫（v2.1 B／v2.2 B）—— 只能 tag：docker load 後無 RepoDigests（實測），另記 image ID；驗收測試用同一機制", v2=True)
b.box("v0", U, 0, G12, "dev vendor_kit -i <本機 image tag>", 220)
b.box("v1", L, 0, v2(W12), "docker run 引擎 dev vendor_kit -i <tag>\n（tar 先自己 docker load）", 280)
b.box("v2x", U, 1, R12, "是 → 1：CI 拒絕 dev", 220)
b.box("v2q", E, 1, D12, "CI=1？", 130, ax="l")
b.box("v2a", E, 2, v2(SUB), "否：flock 專案目錄（60 秒）", 400)
b.box("v2b", E, 3, v2(SUB), fl("寫 version.local.toml：vendor_kit = \"<tag>\"＋image ID（不動薄殼）"), 400)
b.box("v3", P, 3, F12, "＋version.local.toml：vendor_kit = \"<tag>\" + image ID（不進 git；同 tag 重 build 才會被發現）", 360)
b.box("v2z", U, 3, v2(G12), "0：之後每次 just 用該本機 image", 220)
b.box("v5", U, 5, G12, "下次打任何 just", 220)
