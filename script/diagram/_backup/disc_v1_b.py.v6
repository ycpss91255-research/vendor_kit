b.box("x4l", E, 8, v2(SUB), "建進度日誌（.vendor_kit/.tmp.*；第一個寫入前）", 400)
b.box("x4lf", P, 8, F12, "＋.vendor_kit/.tmp.*（進度日誌，不進 git）", 360)
b.box("x4x", U, 9, v2(R12), "任一失敗 → 1 中止，列出已完成部分", 220)
b.box("x4", E, 9, v2(SUB), fl("逐工具 remove（保護模式；步驟同「remove」頁的 apply 寫入段）"), 400)
b.box("x5a", E, 10, v2(SUB), "全部成功：刪薄殼四檔（hash 相符者）", 400)
b.files("x5af", P, 10, "－薄殼四檔（保護清單內的保留）", [".vendor_kit/.gitignore", ".vendor_kit/entry.just", ".vendor_kit/vendor.just", ".vendor_kit/ci/check.sh"], 360)
b.box("x5b", E, 11, v2(SUB), "刪 version.toml（hash 相符者）", 400)
