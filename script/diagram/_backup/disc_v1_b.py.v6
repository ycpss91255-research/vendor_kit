b.H("ve1", "v0", "v1"); b.D("ve2", "v1", "v2q"); b.H("ve3", "v2q", "v2x", "是"); b.D("ve4", "v2q", "v2a", "否", al=True); b.D("ve4b", "v2a", "v2b"); b.H("ve5", "v2b", "v3", "寫")
