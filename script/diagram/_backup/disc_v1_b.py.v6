# ================= P8c：undev =================
p8c, F = newpage("流程 v2：undev（§2 undev 列；v2.2 B、v2.3 §5、v2.5 §3／§10；<repo> = 工具 repo 名）", N8, COLS5)
b = F.band("vB", "undev <repo>：回到 version.toml 鎖定版 = resolve → docker → apply（要重新 materialize，v2.3 §5；建日誌後才動，v2.5 §10；失敗 → 1 保留可恢復狀態，v2.2 B）", v2=True)
b.box("u0", U, 0, G12, "just vendor_kit undev <repo>", 220)
b.box("u1", L, 0, W12, "docker run 引擎 resolve undev <repo>", 280)
