b.box("vb", L, 4, LBL, "═══ 下次 just（改用該本機 image；啟動器先比對 gen/.stamp 再起容器）═══", 560, 24, ax="l", minh=24)
b.box("v8", U, 6, v2(O12), "否 → 1：提示 upgrade vendor_kit", 220)
