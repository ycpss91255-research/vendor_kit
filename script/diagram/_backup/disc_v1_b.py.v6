b.box("s13cf", P, 8, F12, "gen/tools.just（不進 git）", 280)
b.box("s14", U, 9, v2(O12), fl("1：印「已升級引擎 vX→vY 並重產薄殼，請 commit 並再跑原指令」"), 220)
b.H("se11", "s10", "s11a"); b.D("se11q", "s11a", "s11q"); b.D("se11n", "s11q", "s11n", "否", 0.25, 0.5, al=True); b.D("se11y", "s11q", "s11y", "是", 0.75, 0.5, al=True)
b.H("se11g", "s11y", "s11g", "讀本機"); b.D("se11rn", "s11n", "s11r", al=True); b.D("se11ry", "s11y", "s11r", al=True)
b.H("se12", "s11r", "s12a"); b.D("se12b", "s12a", "s12b", al=True); b.H("se12x", "s12b", "s12bx"); b.D("se13", "s12b", "s12", al=True)
b.H("se14", "s12", "s12x", "否"); b.D("se15", "s12", "s13", "是", al=True); b.H("se16", "s13", "s13f", "寫")
