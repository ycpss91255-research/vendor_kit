# ================= P7：upgrade ── A. Renovate 路徑 =================
T7 = [
 ("Renovate／regex manager", "GitHub 上的機器人（下游自選；vendor_kit 不出 bot）：regex manager = 用正規表示式在 version.toml 找版本字串；docker datasource = 去 GHCR 查新 tag；有新版就開 PR 改那一行"),
 ("PR／commit／push／rebase／merge", "PR = 提議把分支併進主線（GitHub 上審查）；commit = 記錄一次修改；push = 傳到 GitHub；rebase = 重排分支（會蓋掉人補的 commit）；merge = 併入主線"),
 ("check.sh／CI／frozen", "下游 CI（自動測試環境）只呼叫 .vendor_kit/ci/check.sh = sync（frozen：不查最新版、不寫 tracked 檔）→ verify → upgrade --dry-run → 工具測試 → 專案測試；CI=1 需改 tracked 檔 → 1（與 -y 無關）"),
 ("baseline 落後／待合併", "最後合併版本 ≠ version.toml：有人只改了 version.toml（如 Renovate）→ CI 1（PR 紅，需要人動作）、本機 warn；upgrade 先只補到那版就停，印「另有新版，再跑一次可升」；補合併衝突也立刻 2"),
 ("resolve／apply／--dry-run", "resolve 只讀只算（查目標版、輸出要拉的 image 與指紋，不寫檔）；啟動器拉 image；apply 拿 flock 後重驗指紋才寫（v2.5 §3 順序）；-n = apply --dry-run 唯讀預覽（要先拉 image）"),
 ("flock／指紋／進度日誌", "flock = 專案目錄鎖（60 秒），鎖在引擎；指紋 = resolve 讀過的檔的 hash＋鎖定 digest，apply 重驗；進度日誌 = metadata state=in-progress，第一個寫入前建、最後一步刪"),
 ("dev 覆寫／undev", "工具在 version.local.toml 有 path:<dir> 覆寫 = 用本機 dist/ 取代 image；upgrade <repo>／remove <repo> 都先擋 → 1 提示先 undev（v2.5 §6）；不帶 repo 的 upgrade 預檢也擋"),
 ("materialize／印記", "引擎內部步驟：apply 決定套用後把目標版 /dist/<repo> 展開到 cache/<repo>/（暫存 → 原子替換）；印記 gen/<repo>.stamp 第一行 index digest，之後每檔 sha256"),
 ("B／D／N、逐檔判斷後詢問", "B = baseline（上次合併的範本）、D = 現況（你的檔）、N = 目標版範本（啟動器展開到暫存、掛進引擎的 /dist/<repo>，不是 cache）；N 改了才問「換成新版？」，兩邊都改才問「三方合併？」；-y 免問；拒絕 → 不動、記 declined；細表見下一頁"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源 ref@digest、最後合併版本、完成標記、append 過的行（實際插入的行）、拒絕過（declined）、衝突中檔案清單、進度日誌 state；upgrade 讀它決定待合併與衝突重入，apply 內更新"),
 ("gen／mod", "gen/tools.just（不進 git）每個 <ns>.just 一行 mod = 把工具的 just 檔掛成一個命名空間（just <ns> …）；新版的 just/ 可能增減檔，所以 upgrade 重生它"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< vendor_kit:baseline ||||||| ======= >>>>>>> 標記（我們自己的標籤，重入時靠它偵測）；回傳衝突數 → 映射為 2"),
 ("CRLF／append 行", "CRLF = Windows 換行（\\r\\n）；upgrade 找上次 append 的行時 CRLF／LF 視為相同、其餘精確；零命中或多處 → 保留只 warn"),
 ("GHCR／image／tag@digest", "GHCR = GitHub 的容器倉庫；image = 打包好的 dist/；tag = 人看的版本名，digest = 內容的 sha256 ID（鎖定用）"),
 EXIT3,
]
N7 = "已定（v2.3 §1）：append 行「原文比對」CRLF／LF 視為相同、其餘精確；找不到或多處 → 保留只 warn。已定（v2.5 §3／§6）：apply 順序 = flock → 重驗 → dry-run 分支 → 建日誌 → 清除衝突狀態與其他寫入 → 刪日誌；目標工具在 dev 覆寫中 → 1 先 undev。"
p7, F = newpage("流程 v2：upgrade ── A. Renovate 路徑（§2／§7、v2.2 D、v2.3 §7、v2.5 §1／§7）", N7, COLS7)
b = F.band("uA", "A. Renovate 路徑（下游自選，vendor_kit 不出 bot）：機器人只改 version.toml 一行；PR 的 CI 以新版跑完整流程；baseline 落後 → PR 紅（需要人補合併）；補合併在 PR 分支上完成、CI 綠後才 merge", v2=True)
b.box("a0", RN, 0, G12, "Renovate 定期查 GHCR", 160)
b.box("a1", G, 0, IMG, "<repo>-dist\n出新 tag@digest", 180)
b.box("a2", RN, 1, W12, "開 PR（獨立分支）：只改 version.toml 該工具一行（tag@digest）", 160)
b.box("a3", P, 1, F12, "version.toml（PR 分支）\n<repo> 行 = 新 tag@digest", 280)
b.box("a4a", L, 2, W12, "PR 的 CI 呼叫 .vendor_kit/ci/check.sh（以新版跑完整流程）", 220)
b.box("a4r", E, 2, RULE, "一行改動本身不可能出錯，不構成通過依據\n→ PR 的 CI 必須以新版跑完整流程", 360)
b.box("a4b", L, 3, W12, "check.sh ①：sync（frozen）", 220)
b.box("a5", U, 4, v2(O12), fl("1 → PR 紅：需要人補合併（印「本機 upgrade <repo> -y 後 push」）"), 220)
b.box("a4q", E, 4, v2(D12), "baseline 落後？（最後合併版本 ≠ version.toml）", 360)
b.box("a4c", L, 5, W12, "否：check.sh ②：verify", 220)
b.box("a4d", L, 6, W12, "check.sh ③：upgrade --dry-run", 220)
b.box("a4e1", L, 7, W12, "check.sh ④：工具測試", 220)
b.box("a6a", U, 7, v2(W12), "PR 作者本機：切到 PR 分支", 220)
b.box("a9", P, 7, NOTE, fl("Renovate 預設不動有人推過的分支；PR body 加警告：勿勾 rebase（會蓋掉人補的合併 commit）。vendor_kit 無 bot。"), 280)
b.box("a4e2", L, 8, W12, "check.sh ⑤：專案測試", 220)
b.box("a6b", U, 8, v2(W12), fl("upgrade <repo> -y（走 B，固定補到 PR 鎖定版）"), 220)
b.box("a6c", U, 9, W12, "commit、push", 220)
b.box("a7", L, 9, W12, "PR 分支 CI 再跑完整流程（同上）→ 綠", 150, ax="r")
b.box("a8", RN, 10, G12, "merge PR（CI 綠後才 merge）", 180)
b.H("ae1", "a0", "a1", "查"); b.D("ae2", "a1", "a2", "有新版"); b.H("ae3", "a2", "a3", "改一行")
b.D("ae4", "a2", "a4a"); b.D("ae4b", "a4a", "a4b"); b.D("ae4q", "a4b", "a4q")
b.H("ae5", "a4q", "a5", "是"); b.D("ae5n", "a4q", "a4c", "否"); b.D("ae5c", "a4c", "a4d"); b.D("ae5d", "a4d", "a4e1"); b.D("ae5e", "a4e1", "a4e2")
b.D("ae6", "a5", "a6a"); b.D("ae6b", "a6a", "a6b"); b.D("ae6c", "a6b", "a6c"); b.H("ae7", "a6c", "a7")
b.D("ae8", "a4e2", "a8", "綠", 0.14, 0.5); b.DL("ae9", "a7", "a8", "綠")
b.close()
foot(p7, "p7", F.y, T7, ALL - {"inv", "tree", "pend"})
