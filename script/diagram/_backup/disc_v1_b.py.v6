# ================= P8bc：uninstall =================
p8bc, F = newpage("流程 v2：uninstall（§2；v2.2 E、v2.3 §6、v2.5 §3／§10）", N8B, COLS5)
b = F.band("vD", "uninstall：全部拆掉（install 的反向；bootstrap.sh 的反向也是它）= resolve（預檢、保護清單）→ apply（逐工具 remove 走保護模式 → 只刪 hash 相符的自產檔 → 根 justfile 那行 → 最後刪日誌）；不 rm -rf .vendor_kit/", v2=True)
b.box("x0", U, 0, G12, "just vendor_kit uninstall（-y、-n）", 220)
b.box("x1", L, 0, v2(W12), "docker run <引擎> resolve uninstall（不經 docker create/cp）", 280)
b.box("x2x", U, 1, v2(R12), "否 → 1：預檢失敗（如 dev 中、未完成接入）", 220)
b.box("x2", E, 1, v2(D12), "預檢全部工具通過？", 250, ax="l")
