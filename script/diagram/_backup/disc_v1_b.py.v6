b.box("m6", E, 3, v2(SUB), fl("否：resolve（不寫）：讀 metadata（append 過的行、完成標記）→ 列要刪的：version.toml 行、cache/<repo>/、gen/<repo>.stamp、baseline/<repo>/、gen/tools.just 的 mod 行；要問的 append 行 → stdout ＋ 輸入指紋"), 400)
b.box("m8", L, 4, v2(W12), fl("docker run <引擎> apply remove <repo>（-n → apply --dry-run）"), 280)
b.box("m9a", E, 4, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
