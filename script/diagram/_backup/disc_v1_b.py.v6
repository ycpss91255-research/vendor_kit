b.box("m9d", E, 11, W12, "唯一：刪那幾行", 120, ax="r")
b.box("m9f", P, 11, F12, "初始檔（只移除我們 append 的行；其餘不動；永不刪檔）", 360)
b.box("m10a", E, 12, v2(SUB), "刪 baseline/<repo>/（含 metadata）", 400)
