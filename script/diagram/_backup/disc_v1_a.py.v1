ty = tnode("t_rjust", 2, "<b>just/<repo>.just</b> ── 工具自己的 just 模組（just <repo> …、just docker …）\n寫：引擎 install｜改：不可改", F_NOGIT, ty)
ty = tnode("t_user", 1, "<b>初始檔</b>（例 Dockerfile、setup.toml…；路徑由 init.toml 的 dest 決定）── 使用者的；進 git\n寫：add 複製（已存在只 warn）、upgrade 三方合併｜改：使用者隨意；remove 保留並印清單", F_USER, ty)
for eid, par, ch in [("te1", "t_root", "t_just"), ("te2", "t_root", "t_ver"), ("te3", "t_root", "t_vl"), ("te4", "t_root", "t_vk"),
                     ("te5", "t_vk", "t_entry"), ("te6", "t_vk", "t_vj"), ("te7", "t_vk", "t_ci"), ("te8", "t_vk", "t_bl"), ("te9", "t_vk", "t_meta"), ("te10", "t_vk", "t_gen"),
                     ("te11", "t_gen", "t_tools"), ("te12", "t_gen", "t_gstamp"),
                     ("te13", "t_root", "t_repo"), ("te14", "t_repo", "t_rstamp"), ("te15", "t_repo", "t_files"), ("te16", "t_repo", "t_init"), ("te17", "t_repo", "t_rjust"),
                     ("te18", "t_root", "t_user")]:
    lvl = {"t_root": 0, "t_vk": 1, "t_gen": 2, "t_repo": 1}[par]
    tedge(eid, par, ch, TW[lvl])
tree_end = ty
# ---- 右：.version / .version.local / .stamp / metadata ----
RX, RW = 700, 900
ry = Y
def rblock(pid, label, style, text, y, pad=6):
    p2.append(v(f"{pid}_l", "1", TEXT(13) + "align=left;fontStyle=1;", label, RX, y, RW, 28))
    h = hv(text, RW, pad=pad)
    p2.append(v(pid, "1", style, text, RX, y + 32, RW, h))
    return y + 32 + h + 14
ry = rblock("p2_ver", ".version（進 git；格式建議，待拍板 (1)）", CODE,
 "vendor_kit = \"ghcr.io/ycpss91255-research/vendor_kit:v3@sha256:…\"   # 第一行固定；啟動器 grep 讀\n"
 "[tools]\n"
 "base = \"ghcr.io/ycpss91255-docker/base-dist:v1.4.0@sha256:…\"          # 每工具一行 tag@digest", ry)
ry = rblock("p2_vl", ".version.local（不進 git；dev 寫、undev 刪；ensure 讀到 path: 就跳過 install／verify）", CODE,
 "<repo> = \"path:<dir>\"          # 例：base = \"path:/home/me/src/base\"（指向工具 repo，內含 dist/）", ry)
ry = rblock("p2_st", ".<repo>/.stamp 印記（install 寫；verify 逐檔比 sha256）", CODE,
 "ghcr.io/<org>/<repo>-dist:v1.4.0@sha256:…    # 第一行：image@digest；dev 時為 path:<dir>\n"
 "<sha256>  files/…                              # 之後每檔一行 sha256\n"
 "<sha256>  init.toml\n"
 "<sha256>  just/<repo>.just", ry)
p2.append(v("p2_mt_l", "1", TEXT(13) + "align=left;fontStyle=1;", "baseline/<repo>/.vendor_kit.toml metadata（add／upgrade 寫；欄位名待定，內容如下）", RX, ry, RW, 28))
ry = tbl(p2, "p2_mt", "1", RX, ry + 32, [("欄位", 180), ("內容", 330), ("誰讀它、做什麼", 390)], [
 ["來源 image@digest", "這份 baseline 來自哪個工具 image（tag@digest）", "追溯；upgrade 判斷 baseline 是哪一版"],
 ["最後合併版本", "最後一次三方合併時的工具版本", "ensure：≠ .version → 本機 warn 提示 upgrade、CI 下 1；upgrade：≠ .version → 先補「待合併」（Renovate merge 後）"],
 ["接入完成標記", "add 走完 install → 初始檔 → baseline 才寫", "ensure：缺 → 1「請 just vendor_kit add <repo>」；add：缺 → 續作可辨識的未完成接入"],
 ["（檔案本身）", "兼作 baseline/<repo>/ 空目錄佔位（git 不追蹤空目錄）", "—"],
])
ry += 14
RULE_T = "<b>規則摘要</b>\n・.version 是唯一來源：ensure 每次 just 都拿它對印記，不一致就重裝（只寫 gitignore 路徑）\n・進 git 的檔只有 .version、justfile 那行、.vendor_kit/（不含 gen/）、初始檔；其餘引擎隨時可重建\n・人只改：justfile、初始檔、.version（手動升版）；其他改了會被覆蓋或造成合併錯誤"
p2.append(vb("p2_rule", "1", LT12, RULE_T, RX, ry, RW, hv(RULE_T, RW)))
ry += hv(RULE_T, RW) + 14
p2.append(v("p2_mx_l", "1", TEXT(13) + "align=left;fontStyle=1;", "動詞 × 檔案：誰寫什麼（寫 = 產生／覆蓋；刪 = 移除；— = 不碰；依 §1／§5）", RX, ry, RW, 28))
MXC = [("動詞", 110), (".version", 90), (".version.local", 120), ("justfile", 90), ("薄殼", 90), ("baseline/", 100), ("gen/", 110), (".<repo>/", 100), ("初始檔", 90)]
ry = tbl(p2, "p2_mx", "1", RX, ry + 32, MXC, [
 ["bootstrap.sh", "寫（先只有 vendor_kit 行）", "—", "加一行 import", "寫", "（交給 add）", "（交給 add）", "（交給 add）", "（交給 add）"],
 ["add", "加一行", "—", "—", "—", "建", "重生", "install", "複製（已存在 warn）"],
 ["upgrade", "改一行", "—", "—", "自身升級才換", "推進", "重生", "install", "三方合併（衝突留標記）"],
 ["dev／undev", "—", "加行／刪行", "—", "—", "—", "—", "改指向／重裝", "—"],
 ["remove", "刪一行", "—", "—", "—", "刪", "刪該工具 recipe", "刪", "保留並印清單"],
 ["uninstall", "刪", "刪", "那行相同才刪", "刪", "刪（隨 remove）", "刪（隨薄殼）", "刪（隨 remove）", "保留"],
 ["ensure", "—（只讀）", "—（只讀）", "—", "—", "—（只讀）", "重生", "install／重裝", "—"],
 ["update", "—", "—", "—", "—", "—", "—", "—", "—"],
])
ry += 14
RENO_T = "<b>.version 怎麼被讀</b>\n・啟動器（sh）：grep 第一行 → 引擎 ref；不解析 toml\n・引擎 version 模組：toml 讀寫 + .version.local 覆寫；flock\n・Renovate：regex manager + docker datasource，抓每行的 currentValue（tag）+ currentDigest，PR 只改那一行"
p2.append(vb("p2_reno", "1", LT12, RENO_T, RX, ry, RW, hv(RENO_T, RW)))
ry += hv(RENO_T, RW) + 14
Y = max(tree_end, ry) + 10
p2 += legend("p2", 40, Y, ["v2git", "v2no", "v2usr", "v2code", "note"], "樹線 = 目錄包含（上 → 下）\n黃底紅框便條 = 待你拍板")
p2 += terms("p2", 40, Y + 110, [
 ("唯一來源", ".version：專案「該裝哪版」只看它；其他檔（印記、baseline、gen/）都由它推導"),
 ("印記 .stamp", "install 寫在 .<repo>/ 的檔：第一行 = 裝的是哪個 image@digest（或 path:<dir>），其餘每檔 sha256；verify 逐檔比"),
 ("薄殼印記 gen/.stamp", "啟動器記「gen/ 是哪個引擎產生的」；≠ .version 第一行 → 用新引擎重寫 gen/ 與薄殼"),
 ("metadata .vendor_kit.toml", "baseline/<repo>/ 裡的小檔：來源 image@digest、最後合併版本、接入完成標記；兼作空目錄佔位"),
 ("薄殼", ".vendor_kit/ 進 git 的最小啟動器：entry.just、vendor.just、ci/check.sh；只轉發、不做事"),
 ("gen/", "引擎每次 ensure 重生的檔（tools.just、.stamp）；不進 git，壞了刪掉重跑 just 即可"),
 ("初始檔", "工具 init.toml 列出、add 時複製到專案的檔（例 Dockerfile）；歸使用者，進 git；upgrade 時三方合併"),
 (".git/info/exclude", "git 的本機忽略清單（不進 git）；dev 把 .version.local 寫進去，uninstall 拿掉"),
 ("tag@digest", "image 的版本標籤 + 內容 sha256；tag 給人看、digest 鎖內容"),
])
pages_v1_a.append(("v1p2", "契約 v1：專案裡的檔與 .version", p2))

# ================= P3 v1p3：工具 repo 要交的、啟動器↔引擎、CI =================
p3 = [v("title", "1", TITLE, "工具 repo 要交的（契約④）、啟動器 ↔ 引擎（契約②）、CI（契約⑤）", 40, 20, 760, 34)]
c, Y = pend("p3", 820, 12, 780,
 "(2) dist image 單架構 linux/amd64（vs 多架構 index）→ 建議：單架構；純資料沒有架構差異，一份內容一個 digest，Renovate 的 currentDigest 與 .version 才穩定；啟動器固定 --platform 拉，arm64 主機也能用\n"
 "(10) image 公開／私有 → 建議：公開（GHCR public）；下游 GitLab CI 就不用 bot PAT、Renovate 也免 token；若須私有則走 ⑤ 的 docker login 流程")
p3.append(c); Y = max(Y + 16, 70)
# ---- ④ 工具 repo 要交的 ----
DIST_T = ("<repo>/                    # 工具 repo\n"
 "├─ dist/\n"
 "│  ├─ files/…            # 全部出貨，不含 symlink\n"
 "│  ├─ init.toml          # [[file]] src/dest\n"
 "│  └─ just/<repo>.just   # 工具自己的 recipe\n"
 "└─ Dockerfile.dist         # FROM scratch + COPY dist/ /dist/")
D_ROW1 = [
 ("d4_1", LT12, "<b>dist/files/</b>\n全部出貨，不含 symlink；install 原樣展開到 .<repo>/files/", 290),
 ("d4_2", LT12, "<b>dist/init.toml</b>\n[[file]] src／dest，dest 相對專案根；add 時複製、upgrade 時三方合併", 290),
 ("d4_3", LT12, "<b>dist/just/<repo>.just</b>\n工具自己的 recipe（just <repo> …）；第一行可 just vendor_kit ensure", 290),
 ("d4_4", LT12, "<b>Dockerfile.dist</b>\nFROM scratch + COPY dist/ /dist/；沒有程式、不 FROM vendor_kit", 290),
]
D_ROW2 = [
 ("d4_5", PT12, "<b>image ghcr.io/<org>/<repo>-dist:<tag></b>\n單架構 linux/amd64 純資料；啟動器固定 --platform linux/amd64 拉；一份內容一個 digest（待拍板 (2)）", 420),
 ("d4_6", PT12, "<b>引擎 image vendor_kit:vN</b>\n多架構 amd64 + arm64（引擎有程式才需要；工具 image 不需要）", 320),
 ("d4_7", LT12, "<b>工具 repo 的 CI</b>\n跑 vendor_kit 出貨的 check.sh --dist：dist 佈局、init.toml 合法、image 可展開（amd64 builder）", 412),
]
dh = hv(DIST_T, 300, pad=6)
r1h = max(hv(t, w) for _, _, t, w in D_ROW1); r2h = max(hv(t, w) for _, _, t, w in D_ROW2)
l4h = 50 + max(dh, r1h + 16 + r2h) + 20
p3.append(v("p3L4", "1", SW(NEUTRAL), "契約④ 工具 repo 要交的（供應側；改了要升 major 並公告）", 40, Y, 1560, l4h))
p3.append(v("p3_dist", "p3L4", CODE, DIST_T, 20, 50, 300, dh))
x = 340
for pid, st, t, w in D_ROW1:
    p3.append(vb(pid, "p3L4", st, t, x, 50, w, r1h)); x += w + 16
x = 340
for pid, st, t, w in D_ROW2:
    p3.append(vb(pid, "p3L4", st, t, x, 50 + r1h + 16, w, r2h)); x += w + 16
Y += l4h + 20
# ---- ② 啟動器 ↔ 引擎 ----
S1 = "① grep .version 第一行\n→ 引擎 ref（image@digest）"
S2 = "② 對每個要處理的工具：\ndocker create --platform linux/amd64 <image@digest> /x → docker cp c:/dist/. <tmp>/ → docker rm"
S3 = ("③ docker run --rm -u $(id -u):$(id -g) -v $PWD:/repo -v <tmp>:/dist/<repo>:ro [-v <devdir>:/dist/<repo>:ro] <引擎> <子命令> --repo <repo> …"
      "（rootless docker 偵測到就不加 -u）")
S4 = "引擎容器執行子命令\n→ 結束狀態 0／1／2 回到 just"
ERR = "否：用新引擎跑 bootstrap --repair-shell\n重寫 gen/ 與薄殼 → exit 1\n「已更新 vendor_kit，請重跑」"
SUB = ("<b>引擎子命令</b>：install | init | verify | merge | add | remove | upgrade | update | dev | undev | uninstall | bootstrap\n"
       "結束狀態 0 成功／1 失敗（不動 .version）／2 完成但有衝突；stdout 人類可讀，--porcelain 機器可讀（留給 CI）")
LOCK = "<b>專案目錄 flock</b>\n同一專案同時只跑一個引擎；等 60 秒逾時就失敗；VENDOR_KIT_NO_LOCK=1 跳過"
LSH = "<b>啟動器 = POSIX sh</b>：只用 docker pull／create／cp／run／rm + grep／sed；不裝 python、不解析 toml（所以 .version 第一行固定）"
ENS = "<b>vendor.just 每個動詞 recipe</b>：先跑 ensure 前置（印記 ≠ .version → install；CI=1 自動 frozen），再 verb *args 一行轉發給啟動器"
ws = [("s1", L12, S1, 200), ("d1", RHOMBUS + "fontSize=12;", "gen/.stamp\n= 引擎 ref？", 190), ("s2", L12, S2, 340), ("s3", L12, S3, 400), ("s4", P12, S4, 220)]
hs = {"s1": hv(S1, 200), "d1": 80, "s2": hv(S2, 340), "s3": hv(S3, 400), "s4": hv(S4, 220)}
rowc = 50 + max(hs.values()) / 2
r2y = rowc + max(hs.values()) / 2 + 40
eh = 80; subh = hv(SUB, 560); lockh = hv(LOCK, 380)
r3y = r2y + max(eh, subh, lockh) + 20
r3h = max(hv(LSH, 740), hv(ENS, 780))
l2h = r3y + r3h + 20
p3.append(v("p3L2", "1", SW(NEUTRAL), "契約② 啟動器 ↔ 引擎（每次 just vendor_kit <動詞> 都走這三步；主機只需要 docker + sh）", 40, Y, 1560, l2h))
x = 30
prev = None
for pid, st, t, w in ws:
    h = hs[pid]
    p3.append(v(pid, "p3L2", st, t, x, rowc - h / 2, w, h))
    if prev: p3.append(e(f"{pid}_e", prev, pid, "是" if prev == "d1" else "", (1, 0.5), (0, 0.5)))
    prev = pid; x += w + 30
d1x = 30 + 200 + 30; d1c = d1x + 95
p3.append(v("p3_err", "p3L2", ELLIPSE(RED) + "fontSize=12;", ERR, d1c - 160, r2y, 320, eh))
p3.append(e("p3_err_e", "d1", "p3_err", "否", (0.5, 1), (0.5, 0), vert=True))
p3.append(vb("p3_sub", "p3L2", LT12, SUB, d1c + 190, r2y, 560, max(eh, subh)))
p3.append(vb("p3_lock", "p3L2", LT12, LOCK, d1c + 190 + 560 + 30, r2y, 380, max(eh, subh)))
p3.append(vb("p3_sh", "p3L2", LT12, LSH, 30, r3y, 740, r3h))
p3.append(vb("p3_ens", "p3L2", LT12, ENS, 790, r3y, 750, r3h))
Y += l2h + 20
# ---- ⑤ CI ----
C1 = ("<b>下游專案 CI（GitHub Actions／GitLab CI 都一樣）</b>\n只呼叫 .vendor_kit/ci/check.sh = ensure（CI=1 自動 frozen）+ verify + 工具 smoke（工具 just 模組自帶的 just <repo> check，若有）；"
      "Renovate PR 若「baseline 落後」→ check.sh 回 1，PR 作者本機 upgrade 補合併後才綠")
C2 = "<b>GitLab 拉 GHCR 私有 image</b>\nbot 帳號的 classic PAT → docker login ghcr.io（放 CI 變數）；image 公開則免（待拍板 (10)）"
C3 = "<b>工具 repo 的 CI</b>\ncheck.sh --dist：dist 佈局、init.toml 合法、image 可展開、amd64 builder（同契約④）"
c1h = max(hv(C1, 620), hv(C2, 440), hv(C3, 440))
CH = [("c_a", "env-test", 120), ("c_b", "test-base", 120), ("c_c", "lint／unit／install／init／merge", 300), ("c_d", "release", 110), ("c_e", "release-test（amd64、arm64 原生 runner）", 330)]
l5h = 50 + c1h + 24 + 50 + 20
p3.append(v("p3L5", "1", SW(NEUTRAL), "契約⑤ CI（下游只呼叫 check.sh；工具 repo 跑 check.sh --dist；vendor_kit 自身分層）", 40, Y, 1560, l5h))
p3.append(vb("p3_c1", "p3L5", LT12, C1, 20, 50, 620, c1h))
p3.append(vb("p3_c2", "p3L5", LT12, C2, 660, 50, 440, c1h))
p3.append(vb("p3_c3", "p3L5", LT12, C3, 1120, 50, 420, c1h))
cy = 50 + c1h + 24
p3.append(v("p3_c0", "p3L5", TEXT(12) + "align=left;fontStyle=1;", "vendor_kit 自身 CI（分層，一關過才下一關）", 20, cy + 5, 300, 40))
x = 330; prev = None
for pid, t, w in CH:
    p3.append(v(pid, "p3L5", L12, t, x, cy, w, 50))
    if prev: p3.append(e(f"{pid}_e", prev, pid, "", (1, 0.5), (0, 0.5)))
    prev = pid; x += w + 30
Y += l5h + 20
p3 += legend("p3", 40, Y, ["neutral", "rhomb", "v3err", "v3img", "v3step", "v2code", "note"], "實線 = 執行順序\n黃底紅框便條 = 待你拍板")
p3 += terms("p3", 40, Y + 110, [
 ("dist/", "工具 repo 出貨的目錄：files/（裝進 .<repo>/ 的全部）、init.toml（初始檔清單）、just/<repo>.just（工具自己的 recipe）"),
 ("Dockerfile.dist", "只有 FROM scratch + COPY dist/ /dist/ 的 Dockerfile；產出「純資料 image」，沒有程式、不會被執行"),
 ("單架構 amd64", "image 只有 linux/amd64 一份；資料檔不分架構，啟動器固定 --platform linux/amd64 拉（arm64 主機也能）"),
 ("docker create／cp", "不執行容器，只建一個容器殼再把 /dist 複製出來；純資料 image 沒有程式所以不能 docker run"),
 ("引擎 ref", ".version 第一行的 vendor_kit image@digest；啟動器用它 docker run 引擎，也寫進 gen/.stamp"),
 ("--repair-shell", "引擎的內部子命令：用鎖定的引擎重寫 gen/ 與薄殼；啟動器發現 gen/.stamp 過期時自動跑"),
 ("flock", "Linux 的檔案鎖；引擎對專案目錄上鎖，避免兩個 just 同時安裝互相踩"),
 ("--porcelain", "機器可讀的輸出格式（借 git 的名字）；第一版只保留旗標給 CI，人看 stdout"),
 ("check.sh", "vendor_kit 出貨、進 git 的腳本：下游 CI 呼叫（ensure frozen + verify + smoke）；工具 repo 用 --dist 檢查出貨"),
 ("bot PAT", "GitLab 專用：一個機器人 GitHub 帳號的 classic personal access token，用來 docker login ghcr.io"),
])
pages_v1_a.append(("v1p3", "契約 v1：工具 repo、啟動器↔引擎、CI", p3))

# ================= P4 v1p4：架構圖 v1 ── 主機、引擎模組、registry =================
p4 = [v("title", "1", TITLE, "架構圖 v1 ── 主機、引擎模組、registry（線上文字 = 拉 image／掛載／寫入）", 40, 20, 820, 34)]
c, GY = pend("p4", 880, 12, 720,
 "(5) vendor_kit 自身升級：.version 第一行變 → 啟動器換薄殼後停下、要求重跑（vs 自動 re-exec）→ 建議：停下重跑；啟動器是 POSIX sh 薄殼，自動 re-exec 要處理參數轉發與遞迴保護，第一版不值得\n"
 "・啟動器不算引擎模組（主機側薄殼，紅粗框）：只做 grep／docker create／cp／run，邏輯全在引擎 8 模組；import-linter 管模組間依賴，模組不可依賴工作目錄")
p4.append(c); GY = max(GY + 16, 80)
# ---- GHCR ----
p4.append(v("p4G", "1", SW(PURPLE).replace("strokeColor=#000000", "strokeColor=#9673a6"), "GHCR（ghcr.io）── 兩種 image；拉取都由主機上的啟動器執行，引擎容器內不呼叫 docker", 40, GY, 1560, 140))
p4.append(vb("g_note", "p4G", LT12, "<b>registry 模組只查 tag／digest</b>\n（update／add／upgrade 用）；ensure 不上網", 20, 50, 340, 70))
p4.append(vb("g_dist", "p4G", PT12, "<b>工具 image ghcr.io/<org>/<repo>-dist:<tag></b>\n單架構 linux/amd64、純資料（FROM scratch，只有 /dist）；一份內容一個 digest，.version 記 tag@digest", 380, 50, 640, 70))
p4.append(vb("g_eng", "p4G", PT12, "<b>引擎 image ghcr.io/<org>/vendor_kit:vN</b>\n多架構 amd64 + arm64；一個專案只用 .version 第一行指定的那一版", 1060, 50, 480, 70))
LY = GY + 140 + 30; LH = 660
# ---- 主機 ----
p4.append(v("p4H", "1", SW(NEUTRAL), "主機（使用者的電腦／CI runner）── 只需要 docker + sh + just", 40, LY, 680, LH))
HX = 20; HW = 260
h_items = [
 ("h0", ELLIPSE(YELLOW) + "fontSize=12;", "使用者打 just vendor_kit <動詞> …\n（或 just <repo> …）", 56),
 ("h1", F_USER, "根 justfile（使用者的，進 git）\nimport '.vendor_kit/entry.just'", 50),
 ("h2", F_GIT, ".vendor_kit/entry.just（進 git）\nmod vendor_kit 'vendor.just'\nimport? 'gen/tools.just'", 72),
 ("h3", F_GIT, ".vendor_kit/vendor.just（進 git）\n動詞 recipe：先 ensure 前置，\n再一行 verb *args 轉發", 72),
 ("h4", L12.replace("fillColor=#ffffff", f"fillColor={RED}") + "strokeWidth=2;", "啟動器 sh（主機側薄殼，非引擎模組）\ndocker create／cp 工具 image → 暫存\ndocker run 引擎（掛 /repo、/dist/<repo>）\ngen/.stamp ≠ 引擎 ref → 換薄殼、要求重跑", 104),
]
hy = 50; hpos = {}
for pid, st, t, h in h_items:
    p4.append(v(pid, "p4H", st, t, HX, hy, HW, h)); hpos[pid] = (hy, h); hy += h + 30
labels = {("h0", "h1"): "讀", ("h1", "h2"): "import", ("h2", "h3"): "mod vendor_kit", ("h3", "h4"): "verb *args（先 ensure）"}
for (a, b), lb in labels.items():
    p4.append(e(f"{a}{b}_e", a, b, lb, (0.5, 1), (0.5, 0), vert=True))
GX = 380; GW = 290
p4.append(v("tmp", "p4H", L12, "暫存目錄 <tmp>（主機）\n工具 image 的 /dist 展開副本", GX, 60, GW, 50))
p4.append(v("g1", "p4H", F_NOGIT, ".vendor_kit/gen/tools.just（不進 git，ensure 重生）\nmod <repo> '../../.<repo>/just/<repo>.just'", GX, hpos["h2"][0], GW, hpos["h2"][1]))
p4.append(v("g2", "p4H", L12, "just <repo> …：跑工具自己的 recipe\n（.<repo>/just/<repo>.just；\n第一行可 just vendor_kit ensure）", GX, hpos["h3"][0], GW, hpos["h3"][1]))
p4.append(e("h2g1_e", "h2", "g1", "import?（有才載）", (1, 0.5), (0, 0.5)))
p4.append(e("g1g2_e", "g1", "g2", "mod <repo>", (0.5, 1), (0.5, 0), vert=True))
p4.append(v("h_note", "p4H", NOTE, "ensure 每次 just 都跑：只比印記，便宜；\n印記 ≠ .version → install；verify 失敗 → 重裝 + warn；\nCI=1 自動 frozen（只檢查不寫）", GX, hpos["h4"][0] + hpos["h4"][1] + 20, GW, 72))
# ---- 引擎容器 ----
EX = 790; EW = 460
p4.append(v("p4E", "1", PURPLE_SW.replace("fontSize=18", "fontSize=16"), "引擎容器 vendor_kit:vN（8 個模組）", EX, LY, EW, LH))
MX = 170; MW = 260; MH = 60; MG = 20; M0 = 50
mods = [
 ("m_reg", "<b>registry</b>：GHCR tag／digest 查詢（只 update／add／upgrade 用）"),
 ("m_ins", "<b>install</b>：/dist 展開到 .<repo>/、寫印記、verify（sha256）"),
 ("m_ver", "<b>version</b>：.version／.version.local 讀寫，專案目錄 flock"),
 ("m_lg", "<b>launcher-gen</b>：產生 entry／vendor.just、gen/tools.just、check.sh"),
 ("m_bl", "<b>baseline</b>：baseline/<repo>/ + metadata 讀寫"),
 ("m_mg", "<b>merge</b>：三方合併檔案語意 + git merge-file --diff3"),
 ("m_init", "<b>init</b>：init.toml 逐檔複製（已存在只 warn）"),
]
mpos = {}
for i, (pid, t) in enumerate(mods):
    y = M0 + i * (MH + MG); mpos[pid] = y
    p4.append(vb(pid, "p4E", L12.replace("fillColor=#ffffff", f"fillColor={RED}") + "align=left;spacingLeft=6;", t, MX, y, MW, MH))
CLI_H = M0 + 7 * (MH + MG) - MG - M0
p4.append(vb("m_cli", "p4E", L12.replace("fillColor=#ffffff", f"fillColor={RED}"), "<b>cli</b>\n子命令、\n結束狀態\n0／1／2、\n--porcelain\n\n→ 呼叫\n右邊七個", 20, M0, 110, CLI_H))
for pid, _ in mods:
    fy = round((mpos[pid] + MH / 2 - M0) / CLI_H, 4)
    p4.append(e(f"cli_{pid}", "m_cli", pid, "", (1, fy), (0, 0.5)))
p4.append(e("dep1", "m_ins", "m_ver", "", (0.5, 1), (0.5, 0)))
p4.append(e("dep2", "m_lg", "m_ver", "", (0.5, 0), (0.5, 1)))
p4.append(e("dep3", "m_mg", "m_bl", "", (0.5, 0), (0.5, 1)))
# ---- 專案目錄 ----
PX = 1320; PW = 280
p4.append(v("p4P", "1", SW(GREEN), "專案目錄（掛載為 /repo）", PX, LY, PW, LH))
p4.append(v("f_note", "p4P", TEXT(12) + "align=left;", "整個目錄 -v $PWD:/repo 掛進引擎；\n引擎只寫箭頭指到的路徑，\nensure 只寫 gitignore 路徑", 15, mpos["m_reg"], 250, MH))
files = [
 ("f_repo", "m_ins", F_NOGIT, ".<repo>/（不進 git，使用者不可改）\nfiles/、init.toml、just/、.stamp", "寫入（整批替換）"),
 ("f_ver", "m_ver", F_GIT, ".version（進 git）\n.version.local（不進 git；dev 用）", "讀寫"),
 ("f_shell", "m_lg", F_GIT, "薄殼 .vendor_kit/ 與 gen/\nentry／vendor.just、check.sh、tools.just", "寫入"),
 ("f_bl", "m_bl", F_GIT, ".vendor_kit/baseline/<repo>/（進 git）\n+ .vendor_kit.toml metadata", "寫入"),
]
for pid, m, st, t, lb in files:
    p4.append(v(pid, "p4P", st, t, 15, mpos[m], 250, MH))
    p4.append(e(f"{m}_{pid}", m, pid, lb, (1, 0.5), (0, 0.5)))
uy = mpos["m_mg"]; uh = mpos["m_init"] + MH - uy
p4.append(v("f_user", "p4P", F_USER, "初始檔（使用者的，進 git）\nDockerfile、setup.toml…\n（路徑由 init.toml 的 dest 決定）", 15, uy, 250, uh))
p4.append(e("m_mg_f_user", "m_mg", "f_user", "三方合併寫入", (1, 0.5), (0, round((MH / 2) / uh, 4))))
p4.append(e("m_init_f_user", "m_init", "f_user", "add 時複製", (1, 0.5), (0, round((uh - MH / 2) / uh, 4))))
# ---- 跨區的線 ----
# 專案目錄 → 引擎：掛載 /repo（底部）
my = LH - 30
p4.append(e("mount_repo", "p4P", "p4E", "掛載 /repo", (0, round(my / LH, 4)), (1, round(my / LH, 4))))
# 暫存 → 引擎：掛載 /dist/<repo>
ty_abs = LY + 60 + 25
p4.append(e("mount_dist", "tmp", "p4E", "掛載\n/dist/<repo>:ro", (1, 0.5), (0, round((ty_abs - LY) / LH, 4))))
# 工具 image → 暫存：拉 image
tmp_cx = 40 + GX + GW / 2
p4.append(e("pull_dist", "g_dist", "tmp", "拉 image（docker create／cp）", (round((tmp_cx - (40 + 380)) / 640, 4), 1), (0.5, 0), vert=True, pos=-0.5))
# 引擎 image → 引擎容器：拉 image
eng_x = 1200
p4.append(e("pull_eng", "g_eng", "p4E", "拉 image（docker run）", (round((eng_x - (40 + 1060)) / 480, 4), 1), (round((eng_x - EX) / EW, 4), 0), vert=True, pos=-0.5))
# registry → 工具 image：查 tag/digest
reg_x = EX + MX + 40
p4.append(e("q_reg", "m_reg", "g_dist", "查 tag／digest", (round(40 / MW, 4), 0), (round((reg_x - (40 + 380)) / 640, 4), 1), vert=True, pos=0.5))
# 啟動器 → cli：docker run
h4c = LY + hpos["h4"][0] + hpos["h4"][1] / 2
p4.append(e("run_cli", "h4", "m_cli", "docker run 引擎\n<子命令> --repo <repo> …", (1, 0.5), (0, round((h4c - (LY + M0)) / CLI_H, 4))))
Y = LY + LH + 30
p4 += legend("p4", 40, Y, ["purple", "v4mod", "v4host", "green", "yellow"], "實線 = 呼叫／資料流（線上文字 = 做什麼）\n模組間短箭頭 = 依賴方向（A→B：A 用 B）")
p4 += legend("p4b", 40, Y + 70, ["v2git", "v2no", "v2usr", "v3step", "note"], "cli → 七個模組的線 = cli 呼叫它們\n黃底紅框便條 = 待你拍板")
p4 += terms("p4", 40, Y + 170, [
 ("引擎", "vendor_kit 的程式本體：只以 image 存在、只在容器內跑；8 個模組見紫色容器；一個專案只用 .version 第一行那一版"),
 ("啟動器", ".vendor_kit/ 裡的 POSIX sh 薄殼，在主機跑：grep .version、docker create／cp 抓工具檔、docker run 起引擎；不算引擎模組"),
 ("registry", "引擎模組：查 GHCR 的 tag 與 digest；只有 update／add／upgrade 會用，ensure 不上網"),
 ("launcher-gen", "引擎模組：產生 .vendor_kit/ 薄殼（entry／vendor.just、check.sh）與 gen/tools.just"),
 ("暫存目錄 <tmp>", "啟動器把工具 image 的 /dist 抓到主機的暫存資料夾，再唯讀掛進引擎當 /dist/<repo>；dev 時改掛本機目錄"),
 ("掛載", "docker run -v：把主機目錄接進容器；/repo = 專案目錄（可寫），/dist/<repo> = 工具檔（唯讀）"),
 ("import-linter", "Python 工具：檢查模組間 import 方向，違反圖上箭頭就 CI 失敗"),
 ("純資料 image", "FROM scratch 只 COPY 檔案的 image，沒有程式；只能 docker create／cp，不能 run"),
 ("<repo>", "工具 repo 名（例 base）；.<repo>/ = 專案裡裝好的工具檔"),
])
pages_v1_a.append(("v1p4", "架構圖 v1：主機、引擎模組、registry", p4))
