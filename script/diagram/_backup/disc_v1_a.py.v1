# ---- 左：目錄樹 ----
TW = {0: 200, 1: 560, 2: 530, 3: 500}
def tnode(pid, level, text, style, y):
    x = 40 + 30 * level
    w = TW[level]
    h = hv(text, w, pad=4)
    p2.append(vb(pid, "1", style, text, x, y, w, h))
    return y + h + 10
def tedge(eid, parent_id, child_id, pw):
    fx = round(14 / pw, 4)
    p2.append(e(eid, parent_id, child_id, "", (fx, 1), (0, 0.5)))
