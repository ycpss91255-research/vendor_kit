b.box("b14f", P, 7, F12, "baseline/<repo>/、.vendor_kit.toml", 280)
b.box("b15", U, 8, G12, "0：印摘要 → commit\n.version、初始檔、baseline\n（同一 commit）", 200, extra=10)
