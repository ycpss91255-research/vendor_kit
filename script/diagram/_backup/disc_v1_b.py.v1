b.box("a3", L, 1, W12, "詢問工具與版本（或用 --tool／-t／-y）\n非互動缺參數 → 1；EOF 不算同意\n→ docker pull 引擎 image", 280)
b.box("a4", G, 1, P12, "ghcr.io/…/vendor_kit:vN\n（多架構 amd64+arm64）", 220)
b.box("a5", E, 2, P12, "bootstrap：寫 .version（先只有 vendor_kit 行）、\n根 justfile 加一行 import、.vendor_kit/ 薄殼\n（entry.just、vendor.just、ci/check.sh、gen/）", 400)
b.box("a6", P, 2, F12, "＋.version（vendor_kit 行）\n＋justfile 一行 import '.vendor_kit/entry.just'\n＋.vendor_kit/（薄殼）", 360)
b.box("a7", E, 3, P12, "對每個 --tool 跑 add <repo>（見下半 5b）", 400)
b.box("a8", E, 4, D12, "任一步\n失敗？", 110, 70, ax="l")
b.box("a9", E, 4, R12, "1：不留半成品\n（暫存目錄整個丟掉，專案不留任何檔）", 270, 76, ax="r")
b.box("a10", U, 5, G12, "0：印摘要與清單：\ngit add .version justfile\n.vendor_kit/ 與初始檔", 220, extra=10)
b.H("ae1", "a0", "a1"); b.H("ae2", "a1", "a2", "有")
b.D("ae3", "a1", "a3", "無"); b.H("ae4", "a3", "a4", "拉"); b.D("ae5", "a4", "a5")
b.H("ae6", "a5", "a6", "寫"); b.D("ae7", "a5", "a7"); b.D("ae8", "a7", "a8")
b.H("ae9", "a8", "a9", "是"); b.D("ae10", "a8", "a10", "否")
b.close()
b = F.band("bR", "5a′ bootstrap.sh --repair（一行：只重寫薄殼）")
b.box("r0", U, 0, G12, "bootstrap.sh --repair", 220)
b.box("r1", L, 0, W12, "grep .version 第一行 → 鎖定的引擎\n拉不到就失敗（不得用腳本內建引擎）", 280)
b.box("r2", E, 0, P12, "bootstrap --repair-shell：只重寫 .vendor_kit/ 薄殼與 gen/\n（.version、初始檔、baseline 都不動）", 400)
b.box("r3", P, 0, F12, ".vendor_kit/ 薄殼、gen/（重寫）", 360)
b.H("re1", "r0", "r1"); b.H("re2", "r1", "r2"); b.H("re3", "r2", "r3", "寫")
b.close()
b = F.band("bB", "5b add <repo>（bootstrap 對每個 --tool 呼叫；平時使用者也直接打）")
b.box("c0", U, 0, G12, "just vendor_kit add <repo>\n（-t <tag>、-s <image>、-n）", 220, extra=10)
b.box("c1", L, 0, W12, "flock 專案目錄（60 秒；\nVENDOR_KIT_NO_LOCK=1 可關）\n→ docker run 引擎 add --repo <repo>", 280)
b.box("c2", E, 1, P12, "add：查 tag（預設最新／--tag）與 digest", 400)
b.box("c3", G, 1, P12, "ghcr.io/<org>/<repo>-dist\n（-s <image> 可改來源）", 220)
b.box("c4", E, 2, D12, "已接入？\n（.version 有\n<repo> 行）", 150, 90, ax="l")
b.box("c5", E, 2, D12, "metadata 有\n完成標記？", 130, 80, ax=210)
b.box("c6", G, 2, G12, "0：已接入，無變更\n（-t 與鎖定不同 → 1，\n提示改用 upgrade）", 220, 80)
b.box("c7", E, 3, W12, "寫 .version：\n<repo> = \"…:<tag>@sha256:…\"", 190, ax="l")
b.box("c8", E, 3, W12, "續作：只做缺的步驟\n（不補使用者刻意刪的檔）", 190, ax="r")
b.box("c9", L, 4, W12, "docker create --platform linux/amd64\n→ docker cp c:/dist/. → docker rm", 280)
