CF0 = "add 前\n專案/\n├ justfile\n├ .version（只有 vendor_kit 行）\n└ .vendor_kit/\n   ├ entry.just\n   ├ vendor.just\n   ├ ci/check.sh\n   ├ baseline/（空）\n   └ gen/（不進 git）"
