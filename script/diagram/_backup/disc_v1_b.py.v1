"""提案 v1 流程四頁（v1p5–v1p8）。唯一依據：decisions/proposal_v1.md §5（§1 表格為行為規格）。
只定義 pages_v1_b = [(pid, name, cells), ...]；不寫檔（run_v1_b.py 負責組 mxfile）。"""
import glob, re, math
_latest = sorted(glob.glob("gen[0-9]*.py"), key=lambda p: int(re.findall(r"\d+", p)[0]))[-1]
exec(open(_latest).read().split("# ================= Page 1")[0])   # helper：v/e/page/legend_flow/terms/SW/LEAF/FILE/NOTE/ELLIPSE/PURPLE_LEAF/TITLE/EDGE/顏色

# ---------- 12pt 樣式 ----------
def _12(st): return st.replace("fontSize=14", "fontSize=12")
W12 = _12(LEAF()); F12 = _12(FILE); P12 = _12(PURPLE_LEAF); G12 = _12(ELLIPSE(GREEN)); R12 = _12(ELLIPSE(RED)); D12 = _12(RHOMBUS)
FTREE = F12 + "align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;"          # 前／後目錄差異
RULE = (f"rounded=1;whiteSpace=wrap;html=1;fillColor={YELLOW};strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;"
        "align=left;verticalAlign=middle;spacingLeft=8;")                          # 醒目規則格
PENDR = NOTE.replace("strokeColor=#999999", "strokeColor=#b85450;strokeWidth=2").replace("fillColor=#ffffff", "fillColor=#fff2cc") + "fontStyle=1;"
HDR = "rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;"
BAND = SW(NEUTRAL, 12).replace("startSize=38", "startSize=30")
LBL = TEXT(12) + "align=left;fontStyle=1;"

def fit_h(text, w, minh=40, extra=0):
    """文字塞得進的高度（與 check_overflow 同一套估法）。"""
    return max(minh, math.ceil(need_h(text, 12, w)) + 2 + extra)

# ---------- 泳道流程佈局 ----------
class Flow:
    """cols: [(名稱, x, w)]（絕對座標）。band() 開一個情境分組；box() 放格子（欄, 列）；H/D/U 拉線；close() 排版並輸出。"""
    def __init__(self, cells, cols, band_x=20, band_w=1580, gap=30):
        self.cells, self.cols, self.bx, self.bw, self.gap = cells, {n: (x, w) for n, x, w in cols}, band_x, band_w, gap
        self.abs = {}; self.y = 0; self.n = 0
    def headers(self, y):
        for i, (n, (x, w)) in enumerate(self.cols.items()):
            self.cells.append(v(f"hdr{i}", "1", HDR, n, x, y, w, 28))
        self.y = y + 44
    def band(self, bid, title, pad=14):
        return _Band(self, bid, title, pad)

class _Band:
    def __init__(self, f, bid, title, pad):
        self.f, self.bid, self.title, self.pad = f, bid, title, pad
        self.boxes, self.edges, self.extra = [], [], []
    def box(self, cid, col, row, style, text, w, h=None, ax="c", minh=40, extra=0):
        """ax: 'c' 置中／'l' 靠欄左／'r' 靠欄右／數字 = 欄左偏移。h 未給就依文字算。"""
        if h is None: h = fit_h(text, w, minh, extra + (12 if style.startswith("ellipse") else 0))
        self.boxes.append(dict(id=cid, col=col, row=row, st=style, text=text, w=w, h=h, ax=ax)); return cid
    def free(self, cid, style, text, x, y, w, h=None):
        """不參與排版的格子（band 內相對座標）；h 未給就依文字算。"""
        if h is None: h = fit_h(text, w, 40)
        self.extra.append((cid, style, text, x, y, w, h))
    def H(self, eid, s, t, label="", sy=0.5): self.edges.append(("H", eid, s, t, label, sy))
    def D(self, eid, s, t, label="", sx=0.5, tx=0.5, dy=0): self.edges.append(("D", eid, s, t, label, sx, tx, dy))
    def U(self, eid, s, t, label="", sx=0.5, tx=0.5, dy=0): self.edges.append(("U", eid, s, t, label, sx, tx, dy))
    def P(self, eid, s, t, label="", exit=None, entry=None, pts=(), pos=None, vert=None):
        self.edges.append(("P", eid, s, t, label, exit, entry, pts, pos, vert))
    def close(self):
        f = self.f; g = f.gap; A = f.abs; RT = {}
        nrows = max([b["row"] for b in self.boxes], default=-1) + 1
        rh = [max([b["h"] for b in self.boxes if b["row"] == r] or [0]) for r in range(nrows)]
        top = [0] * nrows; y = f.y + 30 + self.pad
        for r in range(nrows): top[r] = y; y += rh[r] + g
        bh = 30 + self.pad + sum(rh) + max(nrows - 1, 0) * g + self.pad
        if self.extra: bh = max(bh, max(yy + h for _, _, _, _, yy, _, h in self.extra) + self.pad)
        bx, by = f.bx, f.y
        f.cells.append(v(self.bid, "1", BAND, self.title, bx, by, f.bw, bh))
        for b in self.boxes:
            cx, cw = f.cols[b["col"]]
            if b["ax"] == "c": x = cx + (cw - b["w"]) / 2
            elif b["ax"] == "l": x = cx
            elif b["ax"] == "r": x = cx + cw - b["w"]
            else: x = cx + b["ax"]
            yy = top[b["row"]] + (rh[b["row"]] - b["h"]) / 2
            A[b["id"]] = (x, yy, b["w"], b["h"]); RT[b["id"]] = top[b["row"]]
            f.cells.append(v(b["id"], self.bid, b["st"], b["text"], round(x - bx), round(yy - by), b["w"], b["h"]))
        for cid, st, text, x, yy, w, h in self.extra:
            f.cells.append(v(cid, self.bid, st, text, x, yy, w, h)); A[cid] = (bx + x, by + yy, w, h); RT[cid] = by + yy
        for ed in self.edges:
            kind, eid, s, t = ed[:4]
            sx0, sy0, sw, sh = A[s]; tx0, ty0, tw, th = A[t]
            if kind == "H":
                _, _, _, _, label, sy = ed
                if tx0 > sx0: f.cells.append(e(eid, s, t, label, (1, sy), (0, sy)))
                else: f.cells.append(e(eid, s, t, label, (0, sy), (1, sy)))
            elif kind in ("D", "U"):
                _, _, _, _, label, sxr, txr, dy = ed
                ex, nx = sx0 + sxr * sw, tx0 + txr * tw
                if 1 <= abs(ex - nx) < 40:          # 小折角很醜：把出／入點對齊成一直線
                    r = (nx - sx0) / sw
                    if 0.1 <= r <= 0.9: sxr, ex = r, nx
                    else:
                        r = (ex - tx0) / tw
                        if 0.1 <= r <= 0.9: txr, nx = r, ex
                if kind == "D":
                    ey, ny = sy0 + sh, ty0; gy = RT[t] - g / 2 + dy; exit_, entry = (round(sxr, 3), 1), (round(txr, 3), 0)
                else:
                    ey, ny = sy0, ty0; gy = RT[s] - g / 2 + dy; exit_, entry = (round(sxr, 3), 0), (round(txr, 3), 0)
                if abs(ex - nx) < 1:
                    f.cells.append(e(eid, s, t, label, exit_, entry, vert=True if label else None, pos=-0.6 if label else None))
                else:
                    pts = [(ex, gy), (nx, gy)]
                    L1, L2, L3 = abs(gy - ey), abs(nx - ex), abs(ny - gy); tot = L1 + L2 + L3
                    pos = 2 * ((L1 + L2 / 2) / tot) - 1
                    f.cells.append(_edge(eid, s, t, label, exit_, entry, pts, pos))
            else:
                _, _, _, _, label, exit_, entry, pts, pos, vert = ed
                f.cells.append(_edge(eid, s, t, label, exit_, entry, pts, pos, vert))
        f.y = by + bh + 24
        return self

def _edge(eid, s, t, label, exit_, entry, pts, pos=None, vert=None):
    st = EDGE + f"exitX={exit_[0]};exitY={exit_[1]};exitDx=0;exitDy=0;entryX={entry[0]};entryY={entry[1]};entryDx=0;entryDy=0;"
    if vert: st += "align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;"
    arr = "".join(f'<mxPoint x="{round(px)}" y="{round(py)}"/>' for px, py in pts)
    xa = "" if pos is None else f' x="{pos:.2f}"'
    return (f'<mxCell id="{eid}" value="{esc(label)}" style="{st}" edge="1" parent="1" source="{s}" target="{t}">'
            f'<mxGeometry{xa} relative="1" as="geometry"><Array as="points">{arr}</Array></mxGeometry></mxCell>')

def pend(cells, text, x=1080, w=520):
    h = fit_h(text, w, 60, 10)
    cells.append(v("pend", "1", PENDR, text, x, 12, w, h)); return 12 + h

def foot(cells, prefix, y, rows, legend_extra=()):
    lg = [c.replace("fontSize=14", "fontSize=12") for c in legend_flow(prefix, 40, y, files=True, note=False)]
    cells += lg
    x = 40
    for i, (st, t, w) in enumerate([(NOTE, "便條：補充說明", 130)] + list(legend_extra)):
        cells.append(v(f"{prefix}_lgx{i}", "1", st, t, x, y + 70, w, 40)); x += w + 20
    cells += terms(prefix, 40, y + 160, rows, kw=190, vw=1370)

COLS5 = [("使用者", 40, 220), ("啟動器（主機 sh）", 280, 280), ("引擎容器", 580, 400), ("GHCR", 1000, 220), ("專案目錄", 1240, 360)]
COLS7 = [("使用者", 40, 200), ("Renovate（GitHub 上）", 260, 200), ("啟動器（主機 sh）", 480, 240), ("引擎容器", 740, 360), ("GHCR", 1120, 180), ("專案目錄", 1320, 280)]
U, L, E, G, P, RN = "使用者", "啟動器（主機 sh）", "引擎容器", "GHCR", "專案目錄", "Renovate（GitHub 上）"
pages_v1_b = []

# ================= P5：bootstrap（第一次）+ add =================
p5 = [v("title", "1", TITLE, "流程：bootstrap（第一次）+ add ── §5a／§5b（<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p5, "⚠ 待你回覆（proposal §8）\n(6) bootstrap 第二次拒絕：已有 .version 且無 --repair → 1，提示改用 just vendor_kit add。\n建議：維持拒絕。接工具＝add、修薄殼＝--repair，bootstrap 只做一次，.version 才永遠只有一個來源；誤跑也不會覆蓋既有接入。")
F = Flow(p5, COLS5); F.headers(ny + 14)
b = F.band("bA", "5a bootstrap（第一次，只做一次；失敗 → 什麼都不留，暫存目錄原子替換；bootstrap.sh 不自刪）")
b.box("a0", U, 0, G12, "下載 release 的 bootstrap.sh\n並執行（可帶 --tool <repo>…\n-t <tag>、-s <image>、-y）", 220, extra=10)
b.box("a1", L, 0, D12, "已有\n.version？", 100, 70, ax="l")
