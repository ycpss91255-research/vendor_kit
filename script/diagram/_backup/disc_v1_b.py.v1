b.box("c14", U, 6, G12, "0：印摘要（含 warn）\n→ git add .version、\nbaseline/、初始檔", 220, extra=10)
b.H("ce1", "c0", "c1"); b.D("ce2", "c1", "c2"); b.H("ce3", "c2", "c3", "查")
b.D("ce4", "c2", "c4", "", 0.5, 0.5); b.H("ce5", "c4", "c5", "是"); b.H("ce6", "c5", "c6", "是")
b.D("ce7", "c4", "c7", "否"); b.D("ce8", "c5", "c8", "否")
