b.H("ze1", "z0", "z1", "寫"); b.H("ze2", "z0", "z2")
b.close()
foot(p6, "p6", F.y, [
 ("ensure", "vendor.just 的前置 recipe：每次 just 自動跑；只讀 .version、只寫 .<repo>/ 與 gen/"),
 ("frozen（CI=1）", "CI 下 ensure 只檢查不放行：baseline 落後 .version 就回 1（本機只 warn）"),
 ("印記第一行", ".<repo>/.stamp 第一行 = 裝的是哪個 image@digest（dev 時是 path:<dir>）；≠ .version 就 install"),
 ("verify", "把 .<repo>/ 每個檔的 sha256 跟印記比；不符 → 重裝 + warn（使用者不可改 .<repo>/）"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：來源 image@digest、最後合併版本、接入完成標記"),
 ("完成標記／落後", "無完成標記 = add 沒做完 → 1；最後合併版本 ≠ .version = 有人只改了 .version → 提示 upgrade"),
 ("gen/", ".vendor_kit/gen/：tools.just（每工具一行 mod）與 .stamp（薄殼印記）；引擎每次重生，不進 git"),
 ("path 覆寫", ".version.local 裡 <repo> = \"path:<dir>\"（dev）；ensure 跳過該工具的 install／verify"),
], legend_extra=[(RULE, "黃粗框：規則", 130)])
pages_v1_b.append(("v1p6", "流程：ensure（每次 just 都跑）", p6))

# ================= P7：upgrade =================
p7 = [v("title", "1", TITLE, "流程：upgrade ── Renovate 路徑、手動路徑、三方合併、回退、自身升級（§5d）", 40, 20, 940, 34)]
ny = pend(p7, "⚠ 待你回覆（proposal §8）\n(4) upgrade 含 install＋三方合併＋推 baseline（推翻「只改 .version 就停」）。建議：採用；一個指令走完，回退只 revert 一個 commit。\n(5) 自身升級停下要求重跑（不自動 re-exec）。建議：採用；re-exec 會讓新舊 sh 混跑，難除錯。\n(7) Renovate 路徑要 PR 作者本機補 upgrade（vs CI bot commit）。建議：第一版本機補；bot commit 要 push 權限與衝突處理，之後再加。\n(8) 三方合併第一版邊界：二進位／symlink 不合併。建議：採用；改過就保留＋warn，不猜。", x=1000, w=600)
F = Flow(p7, COLS7); F.headers(ny + 14)
b = F.band("uA", "A. Renovate 路徑：機器人只改 .version 一行，合併由 PR 作者本機補")
b.box("a0", RN, 0, G12, "Renovate 定期查 GHCR\n（regex manager、docker datasource）", 200, extra=10)
b.box("a1", G, 0, P12, "<repo>-dist\n出新 tag@digest", 180)
b.box("a2", RN, 1, W12, "開 PR：改 .version 該工具一行\n（currentValue + currentDigest）", 200)
b.box("a3", P, 1, F12, ".version（PR 分支）\n<repo> 行 = 新 tag@digest", 280)
b.box("a4", L, 2, W12, "CI 跑 .vendor_kit/ci/check.sh\n（ensure frozen + verify）", 240)
b.box("a5", E, 2, R12, "1：baseline 落後 .version\n→ PR 紅，印「請本機\njust vendor_kit upgrade <repo>」", 300, 80)
b.box("a6", U, 3, W12, "PR 作者本機：切到 PR 分支 →\njust vendor_kit upgrade <repo>\n（走 B 補合併）→ commit、push", 200)
b.box("a7", L, 4, W12, "CI 再跑 check.sh → 綠", 240)
b.box("a8", U, 4, G12, "merge PR", 200)
b.H("ae1", "a0", "a1", "查"); b.D("ae2", "a1", "a2", "有新版"); b.H("ae3", "a2", "a3", "改一行")
b.D("ae4", "a2", "a4"); b.H("ae5", "a4", "a5"); b.D("ae6", "a5", "a6", "", 0.5, 0.5)
b.D("ae7", "a6", "a7"); b.H("ae8", "a7", "a8", "綠")
b.close()
b = F.band("uB", "B. 手動路徑：just vendor_kit upgrade [<repo>]（不帶 repo = 全部含 vendor_kit 自身）")
b.box("b0", U, 0, G12, "just vendor_kit upgrade <repo>\n（-t <tag>、-n/--dry-run）", 200, extra=10)
b.box("b1", L, 0, W12, "flock → docker run 引擎\nupgrade --repo <repo>", 240)
b.box("b2", E, 0, P12, "upgrade：先補待合併（.version 已到 B、\nbaseline 仍 A）；否則查最新（或 --tag；\n比現版舊 → warn 仍執行）", 360)
b.box("b3", G, 0, P12, "<repo>-dist\n最新 tag@digest", 180)
b.box("b4", E, 1, D12, "有 baseline/\n<repo>/？", 180, 80, ax="l")
b.box("b5", E, 1, R12, "1：無 baseline，\n請先 add <repo>", 160, 70, ax="r")
b.box("b6", E, 2, D12, "--dry-run？", 180, 70, ax="l")
b.box("b7", E, 2, G12, "0：只印會改什麼\n（＝舊 diff），不動檔", 160, 70, ax="r")
b.box("b8", E, 3, W12, "改 .version：<repo> 行 → 新 tag@digest", 360)
b.box("b8f", P, 3, F12, ".version（<repo> 行）", 280)
b.box("b9", L, 4, W12, "docker create/cp 取新版 /dist\n（--platform linux/amd64）", 240)
b.box("b10", E, 4, P12, "install：展開到 .<repo>/、寫印記", 360)
b.box("b10f", P, 4, F12, ".<repo>/（新版）", 280)
b.box("b11", E, 5, P12, "merge：對 init.toml 每個檔做三方合併\n（baseline／現況／新版，見 C）", 360)
b.box("b11f", P, 5, F12, "初始檔（合併後；衝突留 <<<<<<< 標記）", 280)
