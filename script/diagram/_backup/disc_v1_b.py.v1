b.box("u0", U, 0, G12, "just vendor_kit undev <repo>", 220)
b.box("u1", L, 0, W12, "flock；docker run 引擎 undev", 280)
b.box("u2", E, 0, D12, "有 dev 覆寫？", 170, 70, ax="l")
b.box("u3", E, 0, G12, "0：未啟用 dev（提示）", 200, 60, ax="r")
b.box("u4", E, 1, P12, "刪 .version.local 該行 → 重裝 .version 版\n（install：拆 symlink、重新展開、印記 image@digest）", 400)
b.box("u5", P, 1, F12, ".version.local 少一行；.<repo>/（重新展開）", 360)
b.box("u6", U, 2, G12, "0", 220)
b.H("ue1", "u0", "u1"); b.H("ue2", "u1", "u2"); b.H("ue3", "u2", "u3", "否"); b.D("ue4", "u2", "u4", "是", 0.5, 0.5)
b.H("ue5", "u4", "u5", "寫"); b.D("ue6", "u4", "u6")
b.close()
b = F.band("vC", "5f remove <repo>：拆掉一個工具（初始檔保留；第一版不開 --purge，用 git rm）")
b.box("m0", U, 0, G12, "just vendor_kit remove <repo>\n（-n/--dry-run）", 220, extra=10)
b.box("m1", L, 0, W12, "flock；docker run 引擎 remove", 280)
b.box("m2", E, 0, D12, "已接入？", 170, 70, ax="l")
b.box("m3", E, 0, G12, "0：未接入（提示）", 200, 60, ax="r")
b.box("m4", E, 1, D12, "有 dev 覆寫？", 170, 70, ax="l")
b.box("m5", E, 1, R12, "1：請先 undev <repo>", 200, 60, ax="r")
b.box("m6", E, 2, P12, "刪 .version 該行、.<repo>/、baseline/<repo>/、\ngen/tools.just 該工具那行", 400)
b.box("m7", P, 2, F12, "－.version <repo> 行 －.<repo>/\n－baseline/<repo>/ －gen/tools.just 該行\n（初始檔留著）", 360)
b.box("m8", U, 3, G12, "0：印「以下初始檔保留，\n若不需要請 git rm：…」", 220, extra=10)
b.H("me1", "m0", "m1"); b.H("me2", "m1", "m2"); b.H("me3", "m2", "m3", "否"); b.D("me4", "m2", "m4", "是")
b.H("me5", "m4", "m5", "是"); b.D("me6", "m4", "m6", "否", 0.5, 0.5); b.H("me7", "m6", "m7", "刪"); b.D("me8", "m6", "m8")
b.close()
b = F.band("vD", "5f′ uninstall：全部拆掉（bootstrap 的反向）")
b.box("x0", U, 0, G12, "just vendor_kit uninstall\n（-y、-n/--dry-run）", 220, extra=10)
b.box("x1", L, 0, W12, "docker run 引擎 uninstall", 280)
b.box("x2", E, 0, P12, "逐工具 remove（同上；有 dev 覆寫 → 1）", 400)
b.box("x3", E, 1, P12, "刪 .vendor_kit/、.version、.version.local、\n.git/info/exclude 內我們加的行", 400)
b.box("x3f", P, 1, F12, "－.vendor_kit/ －.version －.version.local\n（初始檔留著）", 360)
b.box("x4", E, 2, D12, "根 justfile 那行\n＝ bootstrap\n寫入的？", 170, 90, ax="l")
b.box("x5", E, 2, W12, "只刪那一行\nimport '.vendor_kit/entry.just'", 200, ax="r")
b.box("x5f", P, 2, F12, "justfile（少一行）", 360)
b.box("x6", E, 3, W12, "不動 justfile；印指示\n「請自行移除那行 import」", 170, ax="l")
b.box("x7", U, 4, G12, "0：印摘要\n（保留的初始檔清單）", 220, extra=10)
b.H("xe1", "x0", "x1"); b.H("xe2", "x1", "x2"); b.D("xe3", "x2", "x3"); b.H("xe4", "x3", "x3f", "刪")
b.D("xe5", "x3", "x4", "", 0.5, 0.5); b.H("xe6", "x4", "x5", "相同"); b.H("xe7", "x5", "x5f", "寫")
b.D("xe8", "x4", "x6", "不同", 0.5, 0.5); b.D("xe9", "x5", "x7", "", 0.5, 0.5); b.D("xe10", "x6", "x7", "", 0.5, 0.5)
b.close()
foot(p8, "p8", F.y, [
 ("dev / undev", "用本機工具 repo 的 dist/ 取代 image（開發工具本身用）／回到 .version 鎖定版"),
 (".version.local", "不進 git（dev 寫 .git/info/exclude）；記 <repo> = \"path:<dir>\"，覆寫 .version 該工具"),
 ("symlink", "dev 時 .<repo>/ 是指向 <dir>/dist 的符號連結；印記第一行 path:<dir>；ensure 看到就跳過 install／verify"),
 ("remove", "刪 .version 行、.<repo>/、baseline/<repo>/、gen 內 recipe；初始檔保留並印清單"),
 ("--purge", "連初始檔一起刪；第一版不開（用 git rm）"),
 ("uninstall", "逐工具 remove → 刪 .vendor_kit/、.version、.version.local；根 justfile 那行只在與 bootstrap 寫入相同時才刪"),
 (".git/info/exclude", "repo 本機的 gitignore（不進 git）；dev 把 .version.local 加進去，uninstall 拿掉"),
 ("初始檔", "init 依 init.toml 複製到專案的檔（歸使用者、進 git）；remove／uninstall 都不刪"),
], legend_extra=[(FTREE, "虛線樹：目錄差異", 150)])
pages_v1_b.append(("v1p8", "流程：dev/undev、remove/uninstall", p8))
