# ---- C. 三方合併小圖（不是泳道；自由排） ----
b = F.band("uC", "C. 三方合併（每個 init.toml 檔；引擎 merge 模組）")
TBL_H = "rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;"
b.free("c_in0", F12, "baseline/<repo>/<檔>\n（上次合併的範本）", 30, 50, 200, 44)
b.free("c_in1", F12, "專案裡的 <檔>\n（現況，使用者可能改過）", 30, 114, 200, 44)
b.free("c_in2", F12, "新版 /dist/files/<檔>\n（image 展開）", 30, 178, 200, 44)
b.free("c_m", P12, "merge：\n逐檔判斷（右表）", 290, 114, 150, 44)
b.P("c_e0", "c_in0", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 72), (260, F.y + 136)])
b.P("c_e1", "c_in1", "c_m", "", (1, 0.5), (0, 0.5), [])
b.P("c_e2", "c_in2", "c_m", "", (1, 0.5), (0, 0.5), [(260, F.y + 200), (260, F.y + 136)])
rows = [("三方都有", "git merge-file --diff3", "乾淨 → 寫入；衝突 → 留 <<<<<<< 標記，整個 upgrade 回 2（不推 baseline）"),
        ("新版新增", "使用者沒有 → 直接建；使用者已有同名 → 以空 base 合併", "多半衝突 → 標記，回 2"),
        ("新版刪除", "使用者沒改（現況 = baseline）→ 刪；改過 → 保留", "改過：保留 + warn"),
        ("使用者已刪", "baseline 有、現況無 → 維持刪除", "不重建，不 warn"),
        ("二進位／symlink", "不合併：先確認使用者未改（現況 = baseline）", "未改 → 新版覆蓋；改過 → 保留 + warn")]
tx, ty = 480, 44; cws = [140, 400, 380]
for i, hh in enumerate(["情況", "做法", "結果"]):
    b.free(f"c_h{i}", TBL_H, hh, tx + sum(cws[:i]), ty, cws[i], 28)
cy = ty + 28
for r, row in enumerate(rows):
    rh = math.ceil(max(need_h(c, 12, w) for c, w in zip(row, cws))) + 4
    for i, (c, w) in enumerate(zip(row, cws)):
        b.free(f"c_r{r}c{i}", TERM_K if i == 0 else TERM_V, c, tx + sum(cws[:i]), cy, w, rh)
    cy += rh
b.free("c_note", NOTE, "多工具的 init.toml 指到同一路徑 → 報錯。\n衝突解完 → 再跑一次 upgrade 即可（不另開 accept）。", 1420, 44, 150, 130)
b.P("c_e3", "c_m", "c_h0", "", (1, 0.5), (0, 0.5), [(460, F.y + 136), (460, F.y + 58)])
b.close()
b = F.band("uD", "D. 回退 ＝ git revert　　E. vendor_kit 自身升級 ＝ 換薄殼、要求重跑")
b.box("d0", U, 0, G12, "git revert 該升級 commit\n（.version + 初始檔 +\nbaseline 同一 commit）", 200, extra=10)
b.box("d1", L, 0, W12, "下次 just：ensure 看到\n印記 ≠ .version → install 舊版", 240)
b.box("d2", E, 0, P12, "install 舊版（合併結果與 baseline\n已由 revert 一起退回）", 360)
b.box("d3", P, 0, F12, ".<repo>/（舊版）、初始檔、baseline（退回）", 280)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3", "寫")
b.box("s0", L, 1, W12, "E：.version 第一行變（走 A 或 B）\n→ 下次 just：gen/.stamp ≠ 第一行", 240)
b.box("s1", E, 1, P12, "新引擎 bootstrap --repair-shell\n重寫 gen/ 與 .vendor_kit/ 薄殼", 360)
b.box("s2", P, 1, F12, "gen/、.vendor_kit/ 薄殼（重寫）", 280)
b.box("s3", L, 2, R12, "1：印「已更新 vendor_kit，\n請重跑」（不自動 re-exec）", 240, 70)
b.box("s4", U, 2, G12, "重跑原指令\n（其餘工具接著升）", 200, extra=10)
b.H("se1", "s0", "s1"); b.H("se2", "s1", "s2", "寫"); b.D("se3", "s1", "s3", "", 0.5, 0.5); b.H("se4", "s3", "s4")
b.close()
foot(p7, "p7", F.y, [
 ("Renovate", "GitHub 上的機器人：regex manager + docker datasource 看 .version；有新 tag 就開 PR 改那一行"),
 ("check.sh", ".vendor_kit/ci/check.sh：下游 CI 只呼叫它 = ensure（frozen）+ verify + 工具 smoke"),
 ("baseline 落後", "metadata 最後合併版本 ≠ .version：有人只改了 .version 還沒合併 → CI 1、本機 warn"),
 ("三方合併", "baseline（上次範本）／現況（使用者的檔）／新版（新範本）三份比，把範本的改動套到使用者的檔"),
 ("git merge-file --diff3", "git 的三方合併指令；衝突時在檔內留 <<<<<<< ||||||| ======= >>>>>>> 標記"),
 ("結束狀態 0／1／2", "0 成功；1 失敗不動 .version；2 有衝突（.version 已改、baseline 不推、留標記與檔名清單）"),
 ("--dry-run", "只印會改什麼（= 舊的 diff），不動任何檔"),
 ("回退", "git revert 升級的那個 commit；下次 just 的 ensure 自動裝回舊版 .<repo>/"),
 ("自身升級", ".version 第一行（引擎 ref）變 → 啟動器換薄殼後停下、要求重跑，不自動 re-exec"),
])
pages_v1_b.append(("v1p7", "流程：upgrade ── Renovate 路徑、手動路徑、三方合併、回退", p7))

# ================= P8：dev/undev、remove/uninstall =================
p8 = [v("title", "1", TITLE, "流程：dev／undev、remove／uninstall（§5e、§5f）", 40, 20, 1000, 34)]
ny = pend(p8, "⚠ 待你回覆（proposal §8）\n(6) remove 不開 --purge：初始檔保留並印清單，要刪用 git rm。建議：採用；刪使用者的檔交給 git 最安全。\n(6) uninstall 動根 justfile 那行：只在與 bootstrap 寫入完全相同時才刪，否則印指示。建議：採用；避免誤傷使用者改過的 justfile。\n(11) dev 支援 vendor_kit 自身：第一版不做。建議：同意；薄殼由引擎產生，dev 自身要另一套 re-exec 邏輯。")
F = Flow(p8, COLS5); F.headers(ny + 14)
b = F.band("vA", "5e dev <repo> -p <dir>：用本機工具 repo 取代 image（不進 git；CI 下拒絕；第一版不支援 vendor_kit 自身）")
