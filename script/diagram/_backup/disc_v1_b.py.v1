b.box("d4", E, 1, P12, "寫 .version.local：<repo> = \"path:<dir>\"\n（並寫 .git/info/exclude 確保不進 git）", 400)
b.box("d5", E, 2, P12, ".<repo>/ 改為 symlink → <dir>/dist\n印記第一行改 path:<dir>", 400)
b.box("d6", U, 3, G12, "0：之後每次 just 直接用 <dir>\n（ensure 跳過 install／verify；\nupgrade 的合併來源不受影響）", 220, extra=10)
b.H("de1", "d0", "d1"); b.H("de2", "d1", "d2"); b.H("de3", "d2", "d3", "否"); b.D("de4", "d2", "d4", "是", 0.5, 0.5)
b.D("de5", "d4", "d5"); b.D("de6", "d5", "d6")
b.free("df_l", LBL, "dev 前 → 後（專案目錄）", 1220, 44, 340, 24)
