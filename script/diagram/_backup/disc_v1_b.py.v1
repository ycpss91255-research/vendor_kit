foot(p5, "p5", F.y, [
 ("bootstrap.sh", "release 附的 POSIX sh；第一次接入用，只做一次；--repair 只重寫薄殼"),
 ("薄殼 .vendor_kit/", "entry.just、vendor.just、ci/check.sh（進 git）＋ gen/（不進 git）；引擎產生，人不改"),
