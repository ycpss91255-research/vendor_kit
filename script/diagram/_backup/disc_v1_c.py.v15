b.box("w4f", P, 12, F12, "cache/<repo>/、gen/<repo>.stamp、gen/tools.just（只寫不進 git 的）", 280)
b.box("w5c", UO, 13, G12, "→ 0：成功、不起 pull（驗收 §7.4-17）", 230)
b.D("wf0", "w4x0", "w4x1", al=True); b.D("wf1", "w4x1", "w4p"); b.DL("wf2", "w4p", "w4l"); b.D("wf3", "w4l", "w4l2"); b.H("wf3x", "w4l2", "w4lx", "≠"); b.D("wf4", "w4l2", "w4vq", al=True)
b.D("wf5", "w4vq", "w4v", "是", al=True); b.D("wf6", "w4v", "w4v1q", al=True); b.H("wf6y", "w4v1q", "w5", "是"); b.D("wf7", "w4v1q", "w4r", "否", al=True)
b.D("wf8", "w4r", "w4v2"); b.D("wf9", "w4v2", "w4v2q", al=True); b.H("wf9x", "w4v2q", "w4v2x", "否"); b.DL("wf9y", "w4v2q", "w5b", "是")
b.H("wf10", "w4r0", "w4f", "寫"); b.DL("wf11", "w4r0", "w5c")
