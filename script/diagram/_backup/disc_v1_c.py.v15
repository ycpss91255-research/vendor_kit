b.box("o10e2", E, 15, SUB, "重驗指紋（與 vk-resolve 的 fingerprint 比）", 320)
b.box("o10dy", UO, 16, G12, "是 → 0：唯讀預覽會建／會問哪些檔（不建進度檔）", 230)
b.box("o10dq", E, 16, D12, "--dry-run？", 200, ax="l")
b.box("o10pg", E, 17, SUB, "否：metadata 建 [progress]（第一個寫入前）", 320)
