 ["add <repo>[@<tag>]", "接入完成；已接入且完成 → 無變更；dry-run 本機", "@<tag> 與鎖定不同（改用 upgrade）；私有且無憑證又未指定 @<tag>（6-3）；dest 不合法／撞名；<ns> 撞名；CI 需改 tracked；指紋不同（6-12）；未完成交易恢復失敗（6-27）", "pull 失敗／逾時；dist 含 symlink；寫入失敗（version.toml 一律未動）", "—", "6-18／6-19"],
 ["remove <repo>", "完成（初始檔永不刪、印清單）；未接 → 提示", "本機覆寫中（先 undev）；CI 需改 tracked；指紋不同", "寫入失敗（可恢復狀態）", "—", "6-18／6-19"],
 ["update [<repo>]", "已列出（有新版也 0；末行 6-15）", "未完成交易（6-33）；任一目標查詢失敗（含無憑證 6-3：設 token 或 upgrade <repo>@<tag>；即使另有新版）", "—", "--exit-code 且有新版", "6-18／6-19"],
 ["upgrade [<repo>[@<tag>]]", "完成；無新版；(1) 補齊待合併後停（6-14）；dry-run 本機", "無基準版（先 add）；本機覆寫中（先 undev）；CI 需改 tracked（6-5）；指紋不同；自身升級後「請 commit 並再跑原指令」（6-2；已改第一行是明列例外）；6-2b", "pull 失敗；git merge-file I/O 錯誤；寫入失敗（工具層 version.toml 不動）", "合併衝突（留標記、基準版仍推）；合併結果 TOML／just 解析失敗（留原檔、基準版不推）；(0) 仍有衝突標記", "@<舊版> 無法無損讀（6-10）；6-18／6-19"],
 ["dev <repo>／vendor_kit", "覆寫寫入 version.local.toml", "工具不在 version.toml；缺 <dir>/dist/init.toml；CI 拒絕；-p／-i 互斥用錯", "—", "—", "6-18／6-19；-i 舊引擎介面版／檔案版低於薄殼首行且要重產 進 git 的薄殼 → 拒絕"],
 ["undev <repo>／vendor_kit", "完成；未啟用 → 提示", "指紋不同", "重新 fetch 失敗（保留可恢復狀態）", "—", "6-18／6-19"],
 ["sync [<repo>] [--verify]", "快路徑（不起容器）；fetch／verify 完成", "薄殼不符（6-1，不重寫）；未完成接入（6-13）；CI 下基準版落後（6-5）；CI 下任何本機覆寫；未完成交易（6-33）", "pull 失敗／逾時；verify 失敗且重裝失敗", "—", "6-18／6-19"],
 ["prune", "完成（印刪了什麼、保留什麼；活躍 .tmp.* 只列出）；dry-run 零刪除", "vk-resolve 不合（6-30）；無 tty 需問（6-4）", "任一 docker rm／image rm／network rm／volume rm 失敗（摘要全列）", "—", "6-18／6-19"],
 ["help／h", "印說明（不觸網、不安裝）", "—", "—", "—", "P < 最低介面版 → 3 + 6-18（零寫入；任何動詞含 help、救援路徑皆同）"],
 ["ci/check.sh", "⓪～⑤ 全過", "⓪ version.local.toml 被 track；① sync 的 1；② verify 印記不符；③ upgrade --dry-run 需改 進 git 的檔（印清單）", "④⑤ 工具／專案測試原碼傳出", "③ 仍有衝突標記", "① 的 3（P < 最低介面版 6-18／6-19）"],
]
FE = {}
for r in range(len(ROWS_E)):
    FE[(r, 1)] = C_OK; FE[(r, 2)] = C_ACT; FE[(r, 3)] = C_FAIL; FE[(r, 4)] = C_ACT; FE[(r, 5)] = C_ACT
for r in range(len(ROWS_E)):
    for c in range(1, 6):
        if ROWS_E[r][c] == "—": FE[(r, c)] = "#ffffff"
y = table(p14, "te", 40, y, [("動詞", 170), ("0 成功（綠）", 250), ("1 需人處理（橙：印指令）", 420), ("1 失敗（紅）", 260), ("2 衝突／有新版（橙）", 240), ("3 版本不合（橙；零寫入）", 210)], ROWS_E, FE) + 24
y0 = y
y1 = box(p14, "k14a", RULE, "多工具彙總（已定，Q27）：不帶 repo 的動詞先完整預檢（任一預檢失敗才整體不動）→ 做得完的做完 → 最後回最需要處理的碼：失敗 1 > 衝突 2 > 有新版 2 > 0；update 同時遇 1 與 2 → 1；訊息全列；舊薄殼對未知碼原樣傳出、不吞", 40, y0, 500)
y2 = box(p14, "k14b", RULE, "結束碼 3 邊界（已定，Q23、v2.7-4）：介面版／檔案版不合，須先升級或退回才能繼續；P < 最低介面版 → 任何動詞（含 help、救援路徑）都回 3 + 6-18；回 3 時零寫入、無任何例外；新舊以介面版／檔案版比較，不用版本字串；最低介面版檢查先於任何上網；網路／認證／不存在 → 1，不得偽裝成 3；既定回 1（印記不符、薄殼被改、自身升級完成要重跑）維持 1", 560, y0, 520)
y3 = box(p14, "k14c", RULE, "CI 對應動作（已定）：0 → 過（merge）；1 → 修（照訊息裡的指令：本機 upgrade <repo> -y 後 commit 並 push／add／undev／git checkout 還原薄殼／加 -y／設 token）；2 → 解衝突（編輯檔案去掉 <<<<<<< vendor_kit:baseline 標記 → 重跑 upgrade 直到乾淨）；3 → 換版本（upgrade vendor_kit／git revert／bootstrap.sh 重建）", 1100, y0, 490)
y = max(y1, y2, y3) + 16
y1 = box(p14, "k14d", NOTE, "圖上顏色對應（v2.6-15、v2.7-8）：0 = 綠橢圓；1 需人處理（印指令：請先 undev／請先 add／請先 git init／請重跑／請 upgrade vendor_kit／請設 token 或指定 @<tag>）= 橙橢圓；2 = 橙；3 = 橙；1 失敗（拉不到、寫入失敗、驗證失敗）= 紅橢圓", 40, y, 500)
y2 = box(p14, "k14e", NOTE, "check.sh 整體結束碼 = 第一個失敗步驟的碼：⓪ local 被 track → 1；① sync 1／3；② verify 1；③ upgrade --dry-run：需改 tracked → 1、仍有衝突標記 → 2；④⑤ 原碼傳出（1／2／3 語意只對 vendor_kit 自身步驟成立）；⓪–⑤ 六步、一關過才下一關", 560, y, 520)
y3 = box(p14, "k14f", NOTE, "「—」= 該動詞沒有這個結束碼；表內 6-N = interface_spec §6 逐字訊息編號；dry-run 在本機一律 0（CI 模式且需改 進 git 的檔 → 1）；EOF／Ctrl-C 中止 apply → 1、不套用、不記 declined；sync --verify（F5 已定）= 每檔 sha256 全驗，結束碼同 sync", 1100, y, 490)
y = max(y1, y2, y3) + 30
foot(p14, "p14", y, T14, {"rule", "note", "hdr", "c0", "cx", "c1", "cell"}, conv=False)
pages_v1_c.append(("v1p14", "結束碼決策表 v2", p14))

# ================= P15：vendor_kit release（1）build → 測試 → 驗收 =================
COLS_RL = [("維護者（VK）", 40, 220), ("GitHub Actions", 280, 560), ("GHCR", 860, 320), ("Release 資產", 1200, 390)]
MT, GA, GH, RA = "維護者（VK）", "GitHub Actions", "GHCR", "Release 資產"
T15 = [
 ("release", "vendor_kit 引擎的一次發行：候選 → 兩平台各自 build → release-test → 驗收（完整 §7.4 矩陣）→ 兩平台一致 → 推候選 tag → 產資產 → 正式 GHCR image tag vN + Git tag vN → Release；任一關失敗就不成為正式版；已釋出 image／Release 資產／fixture 永不刪"),
 ("候選 tag／正式 tag", "候選 image 先以候選 tag（vN-rc.<n> 或 candidate-<sha>）推上 GHCR；index inspect 與資產都對候選 tag 做；全過才 docker buildx imagetools create 打正式 GHCR image tag vN（不重 build、index digest 不變）；Git tag vN 是 repo 上的另一個物件，圖上分開標"),
 ("多架構 image／index digest（#26）", "兩個 runner（amd64、arm64 原生）各自單平台 build + release-test，綠了才 push-by-digest，由單一 job 以 docker buildx imagetools create 合成 index（不是同一次 buildx --platform 多平台；兩 runner 各自 push 同 tag 會互相覆蓋）；index 的 sha256 = version.toml 鎖定用的 digest"),
 ("release-test", "amd64 與 arm64 原生 runner（不用 QEMU 當閘門）各跑 env-test + 一條完整主機流程（install → add → upgrade → dev/undev → remove → prune → uninstall）；rootless docker 與 Podman 進矩陣；just 1.33.0 + latest"),
 ("env-test", "release-test 的第一段：在乾淨 runner 驗主機需求（docker ≥ 19.03、just ≥ 1.33.0、POSIX sh、git）與引擎 image LABEL 齊全；過了才跑完整主機流程"),
 ("驗收（§7.4）", "完整驗收矩陣 35 條（逐條見契約⑤頁的驗收矩陣）：最低介面版以來每個已釋出 bootstrap.sh(r) + 引擎 image r 建 fixture 驅動候選 C；連升；跳升；降版；離線包；私有 registry；append；空白路徑；worktree；rootless／Podman；prune；多工具；F1；無 tty；Renovate；動詞集合；執行紀錄 fail-closed…；缺任一不得出貨（§8-12）"),
 ("fixture", "驗收用的乾淨小 git repo：用已釋出的 bootstrap.sh(r) 接入後把第一行改成候選 C 跑完整流程；禁止由候選樹複製、禁 stub 引擎；fixture 永不刪"),
 ("兩平台一致檢查", "下游 dist：兩平台逐檔位元組一致（路徑、型別、hash、權限、禁 symlink）；引擎 image：兩平台 LABEL（….protocol、….schema）一致；index inspect 斷言含 linux/amd64 與 linux/arm64"),
 ("bootstrap.sh（release 資產）", "release 附的 POSIX sh 薄層，內嵌所屬引擎的完整 ref（ghcr.io/<org>/vendor_kit:vN@sha256:<index digest>）；檔名固定：releases/download/vN/bootstrap.sh，README 連 releases/latest/download/bootstrap.sh；離線契約入口 = bootstrap.sh --local <tar>"),
 ("tar／.digest／SHA256SUMS（#27、Q26）", "各平台 docker save 的 tar 旁附同名 .digest 旁檔（一行 sha256:<hex64> = 正式 index digest）；SHA256SUMS 涵蓋 bootstrap.sh、各平台 tar 與 .digest、離線包、lnav format 檔（不含自身）；離線包 vendor_kit-vN-local.tar.gz 含 bootstrap.sh、各平台 tar + .digest，另附 local_bootstrap.sh 便利包裝（非契約，v2.7-1）；Release 另附 lnav format 檔（§4.10）"),
 ("LABEL", "引擎 image build 時帶 io.github.<org>.vendor_kit=1、….protocol=<floor_P>-<current_P>、….schema=<N>（啟動器不起容器即可判最低介面版）"),
 ("SemVer", "版本號 major.minor.patch；update 取 tags/list 中 SemVer 最大的正式版（預發行如 -rc 排除）；major = 提高最低介面版或需要下游使用者手動步驟；minor = 新功能（含介面版 +1、新增欄位）；patch = 修正；Renovate preset 建議 major 分開 PR"),
]
N15 = "已定（#26 多架構、#27 bootstrap.sh 交付、Q26 .digest、v2.7-1、v2.15-9／-15、interface_spec §4.7 image 命名／label、§7.4 驗收、§8-12；decisions/multiarch 最終建議）：兩架構原生 runner 分建分測、綠了才 push-by-digest 再由單一 job 合成 index；候選驗收（完整 §7.4 矩陣）在正式 release 之前；候選 image 先推候選 tag，全過才打正式 vN（digest 不變）；bootstrap.sh 內嵌完整 ref；各平台 tar + .digest + SHA256SUMS 進 Release；local_bootstrap.sh 只是便利包裝（非契約）；失敗不進正式 tag；已釋出物永不刪。"
p15, F = newpage_c("流程 v2：vendor_kit release（1）── build → release-test → 驗收（#26／#27、§7.4）", N15, COLS_RL)
b = F.band("bR", "release vN（1）：兩平台各自 build → release-test → 驗收（完整 §7.4 矩陣）→ 兩平台一致檢查 → 全部通過？否 → 候選作廢；是 → 續「release（2）」頁推候選 tag 與資產", v2=True)
b.box("v0", MT, 0, G12, "推候選（候選 commit／workflow_dispatch 指定 vN）", 220)
b.box("v1", GA, 0, W12, "workflow 觸發：amd64 job + arm64 job（原生 runner）", 560)
b.box("v2", GA, 1, W12, "build（#26）：兩 runner 各自單平台 buildx build（同一份 Dockerfile；LABEL =1／.protocol／.schema）", 560)
b.box("v3a", GA, 2, W12, "release-test（各平台原生）：env-test", 560)
b.box("v3n", RA, 2, NOTE, "release-test 矩陣：rootless docker、Podman；just 1.33.0 + latest", 390)
b.box("v3b", GA, 3, W12, "release-test：完整主機流程 install → add → upgrade → dev/undev → remove → prune → uninstall", 560)
b.box("v3n2", RA, 3, NOTE, "原生 runner 各跑一次；不用 QEMU 當閘門", 390)
b.box("v3x", MT, 4, R12, "否 → 失敗：候選作廢（不推 image、不發 Release）", 220)
b.box("v3q", GA, 4, D12, "release-test 兩平台都綠？", 300, ax="l")
b.box("v4a", GA, 5, W12, "是：驗收：以已釋出 bootstrap.sh(r) + 引擎 image r 建 fixture（最低介面版以來每一版）", 560)
b.box("v4g", GH, 5, IMG, "已釋出引擎 image r（最低介面版以來每一版；永不刪）", 320)
b.box("v4r", RA, 5, F12, "已釋出 bootstrap.sh(r)（Release 資產；永不刪）", 390)
b.box("v4b", GA, 6, W12, "fixture 的 version.toml 第一行改成候選 C（dev vendor_kit -i <剛 build 的 tag> 同一機制）", 560)
b.box("v4c", GA, 7, W12, "執行完整 §7.4 驗收矩陣（35 條，逐條見契約⑤頁的驗收矩陣；缺任一不得出貨）", 560)
b.box("v4x", MT, 8, R12, "否 → 失敗：候選作廢；印失敗的條號", 220)
b.box("v4q", GA, 8, D12, "驗收 35 條全過？", 300, ax="l")
b.box("v6a", GA, 9, W12, "是：兩平台一致檢查：下游 dist 逐檔位元組一致", 560)
b.box("v6n", RA, 9, NOTE, "已定（decisions/multiarch）：不能靠單一 bake --push 帶測試就宣稱「失敗就不發佈」；分架構各自 build／test，綠了才 push-by-digest，最後由單一 job 合成 index；兩 runner 各自 push 同 tag 會互相覆蓋", 390)
b.box("v6b", GA, 10, W12, "兩平台一致檢查：引擎 image 兩平台 LABEL（protocol／schema）一致", 560)
b.box("v7x", MT, 11, R12, "否 → 失敗：不推 image、不發 Release、不進正式 tag（候選作廢）", 220)
b.box("v7", GA, 11, D12, "兩平台一致？", 220, ax="l")
b.box("v7z", GA, 12, ENTRY, "是 → 續「release（2）」頁：push-by-digest → 候選 tag index → bootstrap.sh／tar／.digest → 正式 tag → Release", 560)
b.H("ve0", "v0", "v1"); b.D("ve1", "v1", "v2"); b.D("ve2", "v2", "v3a"); b.H("ve2n", "v3a", "v3n"); b.D("ve2b", "v3a", "v3b"); b.H("ve2n2", "v3b", "v3n2"); b.D("ve3", "v3b", "v3q", al=True)
b.H("ve3x", "v3q", "v3x", "否"); b.D("ve3y", "v3q", "v4a", "是", al=True)
b.H("ve4", "v4a", "v4g", "拉")
_A = geo(b); _ax, _ay, _aw, _ah = _A["v4a"]; _rx, _ry, _rw, _rh = _A["v4r"]; _gy = _ay + _ah + F.gap / 2
b.P("ve4r", "v4a", "v4r", "取", (0.9, 1), (0.5, 1), [(_ax + 0.9 * _aw, _gy), (_rx + _rw / 2, _gy)], pos=0.2, vert="below")   # 由 v4a 取 bootstrap.sh(r)，不從 image 指向檔案（r11）
b.D("ve4b", "v4a", "v4b"); b.D("ve4c", "v4b", "v4c"); b.D("ve4q", "v4c", "v4q", al=True); b.H("ve4x", "v4q", "v4x", "否"); b.D("ve5", "v4q", "v6a", "是", al=True)
b.H("ve6n", "v6a", "v6n"); b.D("ve6b", "v6a", "v6b"); b.D("ve7", "v6b", "v7", al=True); b.H("ve8", "v7", "v7x", "否")
b.D("ve9", "v7", "v7z", "是", al=True)
b.close()
foot(p15, "p15", F.y, T15, {"note", "img", "hdr", "v2", "entry"}, conv=False, white="白：CI job 做")   # release 流程不是啟動器／引擎執行：無執行紀錄約定
pages_v1_c.append(("v1p15", "流程 v2：vendor_kit release（1）build 與驗收", p15))

# ================= P15c：vendor_kit release（2）推 image → 資產 → Release =================
p15c, F = newpage_c("流程 v2：vendor_kit release（2）── 推候選 tag → 資產 → 正式 tag → Release（#26／#27、Q26）", N15, COLS_RL)
b = F.band("bR2", "release vN（2）：全過才 push-by-digest → 單一 job 合成 index 打候選 tag（inspect 斷言兩平台）→ 產 bootstrap.sh → tar + .digest → 離線包 → lnav format → SHA256SUMS → 正式 GHCR image tag vN（digest 不變）→ Git tag vN → 發布 Release", v2=True)
b.box("v8e", GA, 0, ENTRY, "來自「release（1）」頁：build／release-test／驗收／兩平台一致全部通過", 560)
b.box("v8a", GA, 1, W12, "兩平台各自 push-by-digest（不打 tag）", 560)
b.box("v8ag", GH, 1, IMG, "ghcr.io/<org>/vendor_kit@sha256:<amd64 digest>、@sha256:<arm64 digest>", 320)
b.box("v8b", GA, 2, W12, "單一 job：docker buildx imagetools create -t vendor_kit:vN-rc.<n> <兩個 digest> → 合成 index（候選 GHCR image tag）", 560)
b.box("v8bg", GH, 2, IMG, "ghcr.io/<org>/vendor_kit:vN-rc.<n> @sha256:<index digest>（多架構；候選 tag）", 320)
b.box("v8c", GA, 3, W12, "docker buildx imagetools inspect <index>", 560)
b.box("v8cx", MT, 4, R12, "否 → 失敗：候選 tag 留著、不打正式 vN、不發 Release（候選作廢）", 220)
b.box("v8cq", GA, 4, D12, "index 含 linux/amd64 + linux/arm64？", 300, ax="l")                  # 斷言失敗要有終點（§8-12；r11）
b.box("v9", GA, 5, W12, "是：產 bootstrap.sh：內嵌完整引擎 ref（vendor_kit:vN@index digest；digest 與候選 tag 相同）；檔名固定", 560)
b.box("v9r", RA, 5, F12, "bootstrap.sh（releases/download/vN/；latest 連結指向最新）", 390)
b.box("v10a", GA, 6, W12, "docker save 各平台 image → vendor_kit-vN-amd64.tar、vendor_kit-vN-arm64.tar", 560)
b.box("v10ar", RA, 6, F12, "vendor_kit-vN-<平台>.tar（各平台一個）", 390)
b.box("v10b", GA, 7, W12, "寫同名 .digest 旁檔（一行 sha256:<hex64> = index digest）", 560)
b.box("v10br", RA, 7, F12, "vendor_kit-vN-<平台>.tar.digest", 390)
b.box("v10c", GA, 8, W12, "組離線包 vendor_kit-vN-local.tar.gz", 560)
b.files("v10cr", RA, 8, "離線包內容", ["bootstrap.sh（契約入口：bootstrap.sh --local <tar>）", "各平台 tar + .tar.digest", "local_bootstrap.sh：便利包裝（非契約；偵測架構、挑 tar、exec bootstrap.sh --local）"], 390)
