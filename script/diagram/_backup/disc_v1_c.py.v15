b.H("ue0", "u0", "u0l"); b.D("ue0l", "u0l", "u1q", al=True); b.H("ue0x", "u1q", "u1x", "是"); b.D("ue0q", "u1q", "u1", "否", al=True); b.D("ue0b", "u1", "u1r"); b.H("ue1", "u1r", "u2"); b.H("ue2", "u2", "u2f", "讀"); b.D("ue3", "u2", "u3", al=True)
