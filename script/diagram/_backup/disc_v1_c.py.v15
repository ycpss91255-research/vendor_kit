b.box("u2f", P, 3, F12, "version.toml（只讀：引擎 ref、[tools]）", 280)
b.box("u3x", U, 4, O12, "是 → 1 + 6-33：請先重跑原動詞（不恢復、不寫檔；末行仍印 6-15）", 220)
b.box("u3", E, 4, D12, "有未完成交易（.tmp.<verb>.*.toml／[progress]）？", 400, ax="l")
b.box("u4l", E, 5, LBL, "否 ↓ 對每個目標（[tools] 每工具 + vendor_kit 自身）逐一查 registry（迴圈）", 400, 24, ax="l", minh=24)
b.box("u5", E, 6, D12, "registry 不要求認證（公開）？", 300, ax=58)
b.box("u5g", RG, 6, v2(SUB), "是：GET /v2/<name>/tags/list（分頁）", 130, ax="r")
