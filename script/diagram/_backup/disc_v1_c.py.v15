p13.append(v("l13b", "1", LBL, "(b) 舊引擎 × 檔案 schema（每檔各自 schema = N；讀取門檻只看 schema）", 40, y, 900, 24)); y += 30
ROWS_B = [
 ["同檔案版、有未知欄位", "讀時忽略未知欄位", "寫時保留未知欄位（不能保留 → 拒絕寫）；只拒絕型別錯／重複宣告", "0（型別錯／重複宣告 → 1）"],
 ["檔案版 < 引擎（舊檔）", "可讀：記憶體轉換（讀任一舊檔案版 → 當前檔案版，不鏈式）", "只在本來要寫該檔的明確動作才寫回當前檔案版；metadata 遷移由 upgrade vendor_kit 做、dry-run 明列；同一專案短暫混合檔案版合法", "0"],
