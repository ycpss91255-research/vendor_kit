# ================= P16cc：離線包（3）斷網 sync：快路徑 → inspect → resolve =================
T16C = [_T16["離線包（#27、Q26）"], _T16["離線可用（Q26）"], _T16["sync 快路徑（Q22）／--verify（F5）"], _T16["image ID 記錄"], T_RESOLVE, T_MSG]
