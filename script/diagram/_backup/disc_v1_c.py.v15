p16c, F = newpage_c("流程 v2：離線包（2）── 另備工具 tar → add --local 逐工具（Q26、§4.8、§7.4-16）", N16, COLS_OF2, gap=14)
b = F.band("bO1b", "離線接工具（v2.8-5、v2.10-3）：另備工具 tar → 每工具各跑一次 add <repo> --local <tar>：驗 .tar → load → .digest → image ID → resolve → 驗 vk-resolve → create／cp → apply（flock → 重驗 → --dry-run → [progress] → 寫入）", v2=True)
b.box("oo0", UO, 0, ENTRY, "來自「離線包（1）」頁：install 完成（引擎可離線跑）", 230)
