b.box("u6g", RG, 8, v2(SUB), "是：WWW-Authenticate 換 token → tags/list", 130, ax="l")
b.box("u6r", P, 8, RULE, "已定（Q11）：無憑證時不支援需認證的版本列舉；token 只在 update 單段及 upgrade 的 resolve 以 -e 傳，不寫 log、不傳給工具；GHCR 已測試，其他 registry 依標準協定可用但未驗證", 280)
b.box("u7q", E, 9, v2(D12), "查詢成功？", 200, ax=108)
b.box("u7f", E, 10, v2(SUB), "該目標記 1：無憑證 → 6-3（不查）；查詢失敗 → 分類：認證／網路／回應／解析 → 繼續下一目標", 220, ax=12)
b.box("u8a", E, 10, SUB, "是：取 SemVer 最大正式版（排除預發行）", 150, ax="r")
b.box("u8b", E, 11, SUB, "與現版比較 → 記「現版 → 最新」", 150, ax="r")
b.box("u8q", E, 12, D12, "還有下一個目標？", 300, ax=58)
b.box("u9", E, 13, SUB, "否：彙總（Q27）：全部目標查完；每個目標一行（查到的「現版 → 最新」、失敗的分類與 6-3）；訊息全列", 400)
b.box("u10", E, 14, SUB, "末行固定印 6-15：「套用：just vendor_kit upgrade」", 400)
b.box("u11x", U, 15, O12, "是 → 1：查詢失敗（6-3：設 token 或指定 <repo>@<tag>；其他分類印原因；即使另有新版）", 220)
b.box("u11", E, 15, D12, "任一目標查詢失敗（1）？", 300, ax="l")
b.box("u12y", U, 16, O12, "是 → 2：有新版（給 CI 用）", 220)
