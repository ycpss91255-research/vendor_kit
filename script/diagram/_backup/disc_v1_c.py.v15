b.box("w2b", LA, 5, W12, "否／相符：docker image inspect <version.toml 的正式 ref@digest>", 400)
b.box("w3d", DK, 5, IMG, "本機已有 image（docker load 過的）", 240)
b.box("w3", LA, 6, D12, "本機有該 image？", 220, ax="l")
