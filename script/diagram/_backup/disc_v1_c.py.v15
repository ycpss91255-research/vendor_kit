b.D("oe26g", "o10dq", "o10pg", "否", al=True); b.H("oe26pf", "o10pg", "o10pgf", "建"); b.D("oe26h", "o10pg", "o10e3"); b.H("oe27", "o10e3", "o10f", "寫"); b.D("oe27z", "o10e3", "o10z"); b.D("oe27z2", "o10z2", "o10e4"); b.H("oe27c", "o10e4", "o10f2", "寫")
