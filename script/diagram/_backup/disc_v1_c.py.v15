b.box("o10re", E, 9, SUB, "resolve（不寫）：算 extract 清單與輸入指紋（不查 registry）", 320)
b.box("o10re2", E, 10, SUB, "stdout vk-resolve/1：extract|<repo>|<本機 ref>、fingerprint、apply|yes、end|N", 320)
b.box("o10vx", UO, 11, R12, "不合 → 1 + 6-30：不動 docker", 230)
b.box("o10v", LA, 11, v2(D12), "收完整份、驗首尾／筆數／kind：文法合？", 300, ax="l")
