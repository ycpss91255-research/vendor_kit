b.box("w3pq", LA, 8, D12, "pull 成功？", 220, ax="l")
b.box("w4", LA, 9, W12, "是／有：docker run（不 pull）resolve sync（永不 -t）", 400)
b.box("w4ex", UO, 10, R12, "≠ → 1：image ID ≠ metadata local_image_id（離線對照 index digest）", 230)
b.box("w4e", E, 10, SUB, "resolve sync：驗 image ID == metadata local_image_id；算 extract 清單與指紋", 320)
b.box("w4qy", UO, 11, G12, "是 → 0：apply|no，不起第二個容器", 230)
b.box("w4q", E, 11, v2(D12), "算出 apply|no？（印記／cache／tools.just 全相符、無未完成交易、metadata 完成標記、非 --verify／CI 模式）", 320, ax="l")
b.box("w4z", E, 12, ENTRY, "否 → 續「離線包（3′）」頁：docker create／cp → apply sync（flock → 指紋 → 先驗既有 cache，不符才重裝一次）", 320)
