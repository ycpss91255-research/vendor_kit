"""討論用草圖：src/discussion.drawio（不進 git）。每題一頁；定案後那頁搬進正式產生器。"""
import glob, re
_latest = sorted(glob.glob("gen[0-9]*.py"), key=lambda p: int(re.findall(r"\d+", p)[0]))[-1]
exec(open(_latest).read().split("# ================= Page 1")[0])   # 只取 helper（顏色、v/e/page/legend/terms）

OPT = "rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
OPT_REC = OPT.replace("fillColor=#ffffff", f"fillColor={GREEN}")
def opt(pid, x, y, w, h, title, body, rec=False):
    return v(pid, "1", OPT_REC if rec else OPT, f"<b>{title}</b>\n{body}", x, y, w, h)

pages = []

# ================= 討論 D0：使用方式（乙版）— 三個時刻，三條線；<repo> = 工具 repo 名 =================
d0 = [v("title", "1", TITLE, "使用方式（乙版）：三個時刻各一條線（<repo> = 工具 repo 名，例：base）", 40, 20, 1100, 30)]
def lane(bid, title, y, h=150):
    d0.append(v(bid, "1", SW(NEUTRAL), title, 40, y, 1620, h))
def chain(bid, items, y=55, x0=30, gap=30, h=50):
    x = x0; prev = None
    for cid, st, text, w in items:
        d0.append(v(cid, bid, st, text, x, y, w, h))
        if prev: d0.append(e(f"{cid}_e", prev, cid, "", (1, 0.5), (0, 0.5)))
        prev = cid; x += w + gap
CODE = "rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;"
# ① 第一次
lane("L1", "① 第一次接上（使用者，只做一次）", 70, 310)
chain("L1", [
 ("a0", ELLIPSE(GREEN), "跑 bootstrap.sh", 150),
  ("a1", FILE, "生成四個檔：\n.version、justfile、\n.vendor_kit/、renovate.json", 280),
 ("a2", LEAF(), "bootstrap.sh 結尾印：\n「下一步：在 .version 加工具，\n然後 just vendor_kit init」", 230),
 ("a3", LEAF(), "在 .version 加一行：\n要用的工具 + 版本", 170),
 ("a4", ELLIPSE(GREEN), "just vendor_kit init", 170),
 ("a5", PURPLE_LEAF, "引擎：裝工具檔 .<repo>/\n複製初始檔", 180),
 ("a6", ELLIPSE(GREEN), "完成", 100),
], h=60)
# 第二列：每個動作「之後」專案裡長什麼樣（＋ = 這步新增）
STATE = FILE + "align=left;spacingLeft=8;fontFamily=Courier New;fontSize=12;verticalAlign=top;spacingTop=4;"
def state(cid, under, text, w, h=160):
    d0.append(v(cid, "L1", STATE, text, under, 140, w, h))
d0.append(v("row2", "L1", TEXT(12) + "align=left;fontStyle=1;", "每一步之後，專案裡有什麼（＋ = 這步新增）", 30, 118, 400, 20))
state("s0", 30,  "之前（空 repo）\nmy_robot/\n└─ .git/", 150)
state("s1", 210, "之後\n＋.version（版本清單）\n＋justfile（just 入口）\n＋.vendor_kit/（啟動器）\n＋renovate.json（Renovate 機器人的設定：\n  有新版就自動開 PR 改 .version）", 280)
state("s2", 520, "（bootstrap.sh 已自刪）\n畫面：\n下一步：\n1. 在 .version 加一行\n2. just vendor_kit init", 230)
state("s3", 780, ".version 之後\nvendor_kit = \"…\"\n＋base = \"ghcr.io/…/\n  base-dist:v1@sha256:…\"", 170)
state("s5", 1180, "之後\n＋.base/（工具檔，不進 git）\n＋Dockerfile\n＋setup.toml\n＋script/entrypoint.sh\n＋script/hooks/…\n＋.vendor_kit/baseline/base/", 180)
state("s6", 1390, "commit 時\n進 git：.version、justfile、\nrenovate.json、.vendor_kit/、\nDockerfile、setup.toml、script/\n不進 git：.base/", 200)
prev = None
for b in ["s0","s1","s2","s3","s5","s6"]:
    if prev: d0.append(e(f"{b}_e", prev, b, "", (1, 0.2), (0, 0.2)))
    prev = b
# ② 日常
lane("L2", "② 日常（使用者，每天）", 410)
chain("L2", [
 ("b0", ELLIPSE(GREEN), "打工具的指令\n例：just docker build\n（指令與 Dockerfile 都是\n工具 base 提供的，不是 vendor_kit）", 230),
 ("b1", LEAF(), "自動：讀 .version", 130),
 ("b2", LEAF(), "自動：抓工具檔案\n（docker cp）", 150),
 ("b3", PURPLE_LEAF, "引擎：版本不同→重裝\n相同→檢查沒被改", 200),
 ("b4", LEAF(), "跑工具檔 .<repo>/\n裡的 build 腳本", 150),
 ("b5", ELLIPSE(GREEN), "完成", 100),
], h=70)
d0.append(v("b_err", "L2", ELLIPSE(RED), "被手改→中止", 1330, 55, 150, 70))
d0.append(e("b_err_e", "b3", "b_err", "", (0.5, 0), (0, 0.5)))
# ③ 升級
lane("L3", "③ 升級（Renovate 機器人 + 使用者）", 590, 200)
chain("L3", [
 ("c0", ELLIPSE(GREEN), "Renovate 開 PR\n改 .version 一行", 160),
 ("c1", LEAF(), "CI 腳本 1\n裝（install）", 120),
 ("c2", LEAF(), "CI 腳本 2\n驗（verify）", 120),
 ("c3", LEAF(), "CI 腳本 3\n工具的 build", 120),
 ("c4", RHOMBUS, "都過？", 120),
 ("c5", LEAF(), "merge → 下次 just\n自動裝新版（同②）", 170),
 ("c6", ELLIPSE(GREEN), "just vendor_kit diff <repo>\n比「工具的新版範本」vs\n「你的檔」（不是比 vendor_kit）", 230),
 ("c7", LEAF(), "看差異\n改自己的檔", 120),
 ("c8", ELLIPSE(GREEN), "just vendor_kit accept <repo>\n記住：這版範本我看過了", 200),
], x0=20, gap=20)
d0.append(v("c_err", "L3", ELLIPSE(RED), "不合併：PR 留著，\n使用者自己判斷原因", 580, 120, 200, 50))
d0.append(e("c_err_e", "c4", "c_err", "否", (0.5, 1), (0.5, 0), vert=True))
d0.append(v("z_n", "1", NOTE, "指令分層對齊 base：根 justfile 只 import；just vendor_kit … 是引擎的（init/diff/accept/upgrade）；just docker … 是工具自己帶的，vendor_kit 不定義它。\n乙版 = 工具 image 只放檔案；引擎只有 vendor_kit:vN 一份。②的「抓工具檔案」就是乙版多的一步。", 40, 800, 1500, 44))
d0 += legend_flow("d0", 40, 874, files=True, note=True)
pages.insert(0, ("d0", "使用方式（乙版）", d0))

# ================= 討論 D1：#6 本地開發模式 =================
d1 = [v("title", "1", TITLE, "討論 #6：本地開發模式 ── 改工具本身時，怎麼在專案裡立刻試，不用每改一行就 build + push image", 40, 20, 1500, 30)]
d1.append(v("d1_pre", "1", NOTE, "前例（agy，14 個工具）：本地路徑一律放在「不進 git 的覆蓋檔」或 CLI 旗標，不改正式版本檔 —— Go 的 go.work（提案明寫「不應 check in」）、docker compose 的 compose.override.yaml、mise.local.toml、Cargo 的 .cargo/config.toml [patch]、Terraform 的 dev_overrides（放 CLI 設定檔，不放 .tf）。\n本地路徑的東西一律不做 checksum（go.sum、Cargo.lock、pnpm lockfile 都不記），改成每次執行印醒目警告（Terraform：「Provider development overrides are in effect」）。", 40, 60, 1500, 70))
d1.append(opt("d1_a", 40, 150, 360, 150, "A：.version 直接寫 path:../tool", "優：只有一個檔。\n缺：git diff 被污染、容易誤 commit、CI 要另外擋；前例一致反對（Go 因此才做 go.work）。"))
d1.append(opt("d1_b", 420, 150, 360, 150, "B：.version.local 覆蓋（gitignore）", "優：git 乾淨、零誤 commit；跟 go.work / compose.override 同一型。\n缺：多一個檔要知道它存在。"))
d1.append(opt("d1_c", 800, 150, 360, 150, "C：只用環境變數／指令旗標", "優：完全暫時，關掉 shell 就沒了。\n缺：每個 shell 都要設，CI 與同事看不到你在用本地版。"))
d1.append(opt("d1_d", 1180, 150, 360, 150, "D（agy 建議）：B + C", "優先序：環境變數 > .version.local > .version。\n平常用 B；臨時單次用 C。\n再給兩個指令：just dev <name> <path>、just undev <name>。", rec=True))
# 建議流程（D）
d1.append(v("d1_flow", "1", SW(NEUTRAL), "方案 D 的流程", 40, 330, 1500, 330))
d1.append(v("f0", "d1_flow", ELLIPSE(GREEN), "just dev <name> ../tool", 30, 60, 200, 50))
d1.append(v("f1", "d1_flow", LEAF(), "寫 .version.local：\n<name> = \"path:../tool\"", 270, 60, 220, 50))
d1.append(v("f2", "d1_flow", LEAF(), "啟動器讀版本：環境變數 >\n.version.local > .version", 530, 60, 220, 50))
d1.append(v("f3", "d1_flow", PURPLE_LEAF, "docker run vendor_kit:vN\n-v ../tool/dist:/dist:ro --dev install", 790, 60, 260, 50))
d1.append(v("f4", "d1_flow", FILE, ".<name>/（印記第一行 = dev:../tool）", 1090, 60, 260, 50))
d1.append(v("f5", "d1_flow", LEAF(), "之後每次 just：印記是 dev: →\n不比指紋、印醒目警告、重新同步 dist", 510, 160, 260, 50))
d1.append(v("f6", "d1_flow", ELLIPSE(GREEN), "just undev <name>", 30, 250, 200, 50))
d1.append(v("f7", "d1_flow", LEAF(), "刪 .version.local 那行", 270, 250, 220, 50))
d1.append(v("f8", "d1_flow", LEAF(), "下次 just 回到 .version 的正式 image，\n重裝 .<name>/", 530, 250, 260, 50))
d1.append(v("f9", "d1_flow", NOTE, ".version.local 由 bootstrap 寫進 .gitignore；\n檔案不存在 = 沒有人在用本地版（平常狀態）", 1090, 160, 260, 50))
d1.append(e("fe0", "f0", "f1", "", (1, 0.5), (0, 0.5)))
d1.append(e("fe1", "f1", "f2", "", (1, 0.5), (0, 0.5)))
d1.append(e("fe2", "f2", "f3", "", (1, 0.5), (0, 0.5)))
d1.append(e("fe3", "f3", "f4", "寫出", (1, 0.5), (0, 0.5)))
d1.append(e("fe4", "f2", "f5", "", (0.5, 1), (0.5, 0)))
d1.append(e("fe5", "f6", "f7", "", (1, 0.5), (0, 0.5)))
d1.append(e("fe6", "f7", "f8", "", (1, 0.5), (0, 0.5)))
d1.append(v("d1_q", "1", NOTE, "決議（2026-09-17）：採 B（.version.local），不用環境變數 —— 出問題時要能從檔案追到原因。\n仍待答：\n1. 採 D？（或只要 B）\n2. dev 模式下 .<name>/ 每次 just 重新同步（複製）dist，還是不裝、直接指到 ../tool/dist？（複製：跟正式版行為一致、慢一點；直接指：改了立刻生效，但印記／腳本路徑要特別處理）\n3. 印記第一行用 dev:<路徑> 標記，verify 看到就跳過並警告 —— 可以接受「開發模式下沒有完整性檢查」嗎？（前例全部都這樣做）", 40, 690, 1500, 90))
d1 += legend_flow("d1", 40, 810, files=True, note=True)
d1 += terms("d1", 40, 920, [
 ("本地開發模式", "開發工具本身的人，把專案指到自己電腦上的工具原始碼（而不是 GHCR 上的 image）來試"),
 (".version.local", "跟 .version 同格式的覆蓋檔，不進 git；有它就優先用它的那一行"),
 ("dev: 前綴", "印記第一行寫 dev:<路徑> 代表這個 .<name>/ 來自本地路徑，不是正式 image"),
 ("go.work / compose.override", "Go 與 docker compose 各自的「本地覆蓋檔」前例，都明訂不進 git"),
])
pages.append(("d1", "討論 #6：本地開發模式", d1))

# ================= 討論 D2a：#11 圖解（先看這頁） =================
CODE = "rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;"
d2a = [v("title", "1", TITLE, "#11 圖解：just diff 為什麼要「三方」── 用一個 Dockerfile 的例子", 40, 20, 1200, 30)]
# 三份檔
d2a.append(v("x_t", "1", TEXT(14) + "fontStyle=1;align=left;", "三份東西", 40, 70, 300, 24))
d2a.append(v("x1", "1", CODE, "範本 v1（你當初 init 拿到的）\nFROM ubuntu:22.04\nRUN apt install curl", 40, 100, 300, 80))
d2a.append(v("x2", "1", CODE, "你的 Dockerfile（你改過：加了 git）\nFROM ubuntu:22.04\nRUN apt install curl git", 380, 100, 300, 80))
d2a.append(v("x3", "1", CODE, "範本 v2（工具升級後，在 image 裡：改成 24.04）\nFROM ubuntu:24.04\nRUN apt install curl", 720, 100, 340, 80))
# 二方
d2a.append(v("g_two", "1", SW(NEUTRAL), "現在的做法：二方 ── 只拿「範本 v2」跟「你的檔」比", 40, 220, 700, 200))
d2a.append(v("t1", "g_two", CODE, "diff 你的檔 → 範本 v2\n- FROM ubuntu:22.04\n+ FROM ubuntu:24.04\n- RUN apt install curl git\n+ RUN apt install curl", 20, 50, 320, 110))
d2a.append(v("t2", "g_two", NOTE, "兩種改動混在一起：\n22.04→24.04 是工具改的（你該跟進）\ngit 被拿掉 是因為你自己加的（不該動）\n看 diff 的人分不出來", 360, 50, 320, 110))
# 三方
d2a.append(v("g_three", "1", SW(NEUTRAL), "三方 ── 多留一份「範本 v1」當基準，就能拆開", 780, 220, 760, 200))
d2a.append(v("u1", "g_three", CODE, "範本 v1 → 範本 v2 = 工具改了什麼\n- FROM ubuntu:22.04\n+ FROM ubuntu:24.04", 20, 50, 350, 70))
d2a.append(v("u2", "g_three", CODE, "範本 v1 → 你的檔 = 你改了什麼\n- RUN apt install curl\n+ RUN apt install curl git", 390, 50, 350, 70))
d2a.append(v("u3", "g_three", NOTE, "兩邊改的不是同一行 → 沒有衝突：你只要把 FROM 改成 24.04 就跟進完成。\n若兩邊改到同一行 → 標「兩邊都改」，由你決定。", 20, 130, 720, 50))
# 基準的一生
d2a.append(v("g_life", "1", SW(NEUTRAL), "「範本 v1」（基準）放哪、怎麼更新", 40, 450, 1500, 230))
d2a.append(v("l0", "g_life", ELLIPSE(GREEN), "just init", 30, 60, 140, 50))
d2a.append(v("l1", "g_life", FILE, "初始檔（Dockerfile…）\n歸你，之後隨你改", 210, 60, 220, 50))
d2a.append(v("l2", "g_life", FILE, ".vendor_kit/base/<name>/\n= 範本 v1 的副本（進 git，人不改）", 470, 60, 260, 50))
d2a.append(v("l3", "g_life", ELLIPSE(GREEN), "升級後 just diff", 30, 150, 140, 50))
d2a.append(v("l4", "g_life", LEAF(), "三方比對：base vs image 裡的新範本 vs 你的檔\n只印出來，不改任何檔", 210, 150, 340, 50))
d2a.append(v("l5", "g_life", ELLIPSE(GREEN), "你看完、跟進完\njust accept <name>", 800, 150, 200, 50))
d2a.append(v("l6", "g_life", FILE, ".vendor_kit/base/<name>/\n換成範本 v2（下次升級的基準）", 1060, 150, 300, 50))
d2a.append(v("l7", "g_life", NOTE, "為什麼不放 .<name>/：升級時整批換掉、換台電腦 clone 也沒有 → 需要它的時候剛好不在。", 790, 60, 570, 50))
d2a.append(e("le0", "l0", "l1", "建立", (1, 0.5), (0, 0.5)))
d2a.append(e("le1", "l1", "l2", "同時存一份副本", (1, 0.5), (0, 0.5)))
