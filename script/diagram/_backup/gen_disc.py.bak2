# ================= 討論 D2：#11 diff 三方比對 =================
d2 = [v("title", "1", TITLE, "討論 #11：just diff 要不要三方比對 ── 分清楚「工具改了什麼」和「你改了什麼」", 40, 20, 1500, 30)]
d2.append(v("d2_pre", "1", NOTE, "前例（子代理查證；經 Claude + codex 雙軌分析更正）：Copier、Cruft 存「舊版模板的 git commit + 當時的變數」，升級時重新產生舊版做合併（Copier 預設產 .rej，加 --conflict inline 才留 <<<<<<< 標記；Cruft 一律 .rej）；Debian 的 ucf 把舊版整份存起來、diff3 後先給你看再寫；dpkg 只存舊版 hash，但這樣已能把每個檔分成四類（沒人改／只有你改／只有工具改／兩邊都改）；Rails、Yeoman 什麼都不存，逐檔問你要不要覆蓋。\n實作更正：「兩份二方 diff 取重疊 = 衝突」是錯的（你已手動套上同樣改動會被誤判；hunk 含上下文；插入是零長度）。真正的三方要自己寫 diff3（difflib 之上約 100–150 行，要有測試）。", 40, 60, 1500, 90))
d2.append(opt("d2_a", 40, 160, 480, 150, "A：維持二方（現況）", "新版模板 vs 你的檔，一份 diff。\n優：零成本。\n缺：工具改的和你改的混在一起，升級後看不出哪些是該跟進的。"))
d2.append(opt("d2_b", 540, 160, 480, 150, "B（雙軌分析一致建議）：三方，只顯示不寫回", "第一版：每個檔分成五類（沒人改／只有工具改／只有你改／兩邊都改／你已套上相同內容）＋ 印「舊→新（工具改了）」「舊→你的（你改了）」兩份 diff，行級只標「可能重疊」；處理新增／移除的模板檔。\n第二版：自寫 diff3，行級精確判定。\n優：符合「工具不改使用者檔」。缺：要保留舊版模板副本，多一個 accept 指令。", rec=True))
d2.append(opt("d2_c", 1040, 160, 500, 150, "C：三方 + 自動合併寫回", "Copier / Cruft 做法：沒衝突的自動套用，有衝突留標記。\n優：最省事。\n缺：直接違反「不自動改使用者檔」；容器內沒有 3-way 工具，要另外帶 merge3 或 git。"))
# 舊版副本放哪
d2.append(v("d2_where", "1", SW(NEUTRAL), "B 需要的「舊版模板副本」放哪？", 40, 340, 1500, 200))
d2.append(opt("d2_w1", 20, 50, 460, 120, "(i) 放 .<name>/ 裡", "升級時 .<name>/ 整批覆蓋 → 副本跟著消失；而且 .<name>/ 不進 git，換台機器 clone 下來根本沒有舊版。否決。", ))
d2.append(opt("d2_w2", 500, 50, 480, 120, "(ii) 進 git：.vendor_kit/base/<name>/（雙軌一致）", "存「渲染後的初始檔副本」＋ metadata（image、每檔 sha256）。fresh clone、CI、離線都有；跟 dist 版型演進脫鉤。\ninit 從第一版就寫基準（否則之後所有專案都沒基準）。\n前提：#20 的「.vendor_kit/ 升級整個換新」要改成「只換程式檔，base/ 不動」。", rec=True))
d2.append(opt("d2_w3", 1000, 50, 480, 120, "(iii) 用舊 image digest 重取", "容器內沒有 docker，得由啟動器在主機 docker cp 舊 image 的 /dist 再掛進來 → 啟動器變厚；#14 引入變數後還要存變數。\n雙軌一致：不當自動備援，缺基準就退回二方並明說；日後頂多當明確執行的復原功能。"))
# B 的流程
d2.append(v("d2_flow", "1", SW(NEUTRAL), "方案 B 的 just diff 流程", 40, 570, 1500, 260))
d2.append(v("g0", "d2_flow", ELLIPSE(GREEN), "just diff", 30, 60, 160, 50))
d2.append(v("g1", "d2_flow", RHOMBUS, "有舊版副本\n（base）？", 230, 45, 180, 80))
d2.append(v("g2", "d2_flow", LEAF(), "三方：base→新版 = 工具改了\nbase→你的檔 = 你改了；重疊 = 兩邊都改", 460, 60, 320, 50))
d2.append(v("g3", "d2_flow", LEAF(), "二方（現況），並提示「沒有基準」", 460, 160, 320, 50))
d2.append(v("g4", "d2_flow", LEAF(), "印出三段（不改任何檔）", 830, 60, 220, 50))
d2.append(v("g5", "d2_flow", RHOMBUS, "使用者：看完了，\n更新基準？", 1100, 45, 180, 80))
d2.append(v("g6", "d2_flow", FILE, ".vendor_kit/base/<name>/ 換成新版模板", 1320, 60, 160, 50))
d2.append(v("g7", "d2_flow", ELLIPSE(GREEN), "結束", 1140, 165, 100, 40))
d2.append(e("ge0", "g0", "g1", "", (1, 0.5), (0, 0.5)))
d2.append(e("ge1", "g1", "g2", "有", (1, 0.5), (0, 0.5)))
d2.append(e("ge2", "g1", "g3", "沒有", (0.5, 1), (0, 0.5), vert=True))
d2.append(e("ge3", "g2", "g4", "", (1, 0.5), (0, 0.5)))
d2.append(e("ge4", "g4", "g5", "", (1, 0.5), (0, 0.5)))
d2.append(e("ge5", "g5", "g6", "是", (1, 0.5), (0, 0.5)))
d2.append(e("ge6", "g5", "g7", "否", (0.5, 1), (0.5, 0), vert=True))
d2.append(e("ge7", "g3", "g7", "", (1, 0.5), (0, 0.5)))
d2.append(v("d2_q", "1", NOTE, "雙軌一致的部分（不用再問）：採 B；副本放 (ii) 進 git；更新基準用獨立指令 just accept <name>（docker run --rm 沒有 TTY，diff 結尾問不到；且推進基準本身是決策）；accept 的語意 = 「這版我全看過了」，寫入的是新版模板不是你的檔；缺基準退回二方並明說。\n要你決定：\n1. .vendor_kit/base/ 要不要納入 verify 印記？（納入 = 不能手改基準；不納入 = 可手改但不受保護）建議納入。\n2. 舊專案 init 時「已存在、跳過」的檔，要不要也寫基準（= 當時那版模板）？建議要，否則那些檔永遠只有二方。\n3. just diff 要不要有結束狀態語意（0 無差異／1 工具有改／2 可能重疊）給 CI 用？建議要。\n4. 兩個工具 init 到同一個檔（.gitignore、hooks）怎麼辦？建議 init 直接禁止撞路徑，報錯。", 40, 860, 1500, 110))
d2 += legend_flow("d2", 40, 1000, files=True, note=True)
d2 += terms("d2", 40, 1110, [
 ("二方 / 三方比對", "二方 = 兩份檔直接比；三方 = 多一份「共同的舊版」當基準，才能分出誰改了什麼"),
 ("基準（base）", "上一次你確認過的那版模板副本；三方比對的第三份"),
 ("difflib", "Python 內建的比對工具，只會二方；三方靠兩次二方取重疊"),
 ("Copier / Cruft / ucf / dpkg", "模板升級工具（前兩者）與 Debian 設定檔升級機制（後兩者）的前例"),
])
pages.append(("d2", "討論 #11：diff 三方比對", d2))

# ================= 討論 D3：#13 並行安裝的 lock =================
d3 = [v("title", "1", TITLE, "討論 #13：兩個 just 同時安裝 ── 要不要 lock、怎麼做", 40, 20, 1500, 30)]
d3.append(v("d3_sc", "1", SW(NEUTRAL), "情境：什麼叫「兩個同時安裝」", 40, 60, 1500, 210))
d3.append(v("sc_t", "d3_sc", TEXT(12) + "align=left;", "你剛 merge 了升級 PR（.version 變了）。接著這三種情況任一種都會讓兩個 vendor_kit 容器「同時」對同一個 .<name>/ 做 install：\n① 你開兩個終端機，一個打 just build、另一個打 just run；② CI 在跑 just，你也在同一台機器打 just；③ IDE 的工作（save 時自動 just）跟你手打撞在一起。", 12, 40, 1470, 50))
d3.append(v("sc_a", "d3_sc", PURPLE_LEAF, "容器 A：install\n寫暫存目錄 → 刪舊 .<name>/ → 改名", 20, 105, 300, 50))
d3.append(v("sc_b", "d3_sc", PURPLE_LEAF, "容器 B：install（晚半秒）\n寫暫存目錄 → 刪舊 .<name>/ → 改名", 20, 160, 300, 44))
d3.append(v("sc_r", "d3_sc", ELLIPSE(RED), "結果：A 剛改名完，B 又刪掉再改名；或 B 改名時目標已存在而失敗；\n最慘是 just build 讀腳本的那一瞬間 .<name>/ 根本不存在", 360, 100, 560, 100))
d3.append(v("sc_n", "d3_sc", NOTE, "鎖的意思：B 看到 A 在裝，就等 A 裝完；輪到 B 時發現已經是新版，直接跳過。\n沒有鎖 = 兩個人同時搬同一個櫃子。", 950, 100, 530, 100))
d3.append(e("sce", "sc_a", "sc_r", "交錯", (1, 0.5), (0, 0.3)))
d3.append(e("sce2", "sc_b", "sc_r", "", (1, 0.5), (0, 0.82)))
d3.append(v("d3_pre", "1", NOTE, "前例（agy，10 個工具）：apt/dpkg、Cargo、Nix、Bazel、uv、Go 都用 flock/fcntl 檔案鎖（核心自動釋放、沒有殘鎖問題）；Git 用 O_EXCL 建 index.lock（立即失敗，殺掉後要手動刪）；npm/pnpm 的 store 用 mkdir 目錄鎖 + mtime 判殘鎖（常出「stale lock」問題）；Terraform 用 lock 紀錄，永不過期要 force-unlock。\n前例沒有人拿「暫存目錄存在」當鎖（rsync、apt、Nix、Go、Maven 都是另外持鎖）。\n重要發現：我們現在的「先 rmtree 舊目錄再 rename 暫存目錄」不是原子替換 —— 中間有一瞬間 .<name>/ 不存在；兩個 install 交錯時第二個 rename 會失敗（目標非空）。", 40, 290, 1500, 90))
d3.append(opt("d3_a", 40, 400, 480, 160, "A：不鎖，靠暫存目錄 + rename", "每個 install 用自己的暫存目錄名（加 pid、亂數）。\n優：沒有殘鎖問題。\n缺：替換那一瞬間的競態還在；N 個 shell 就重裝 N 次；崩潰留下的暫存目錄要另外清。"))
d3.append(opt("d3_b", 540, 400, 480, 160, "B：mkdir .<name>.lock/ 當鎖", "有目錄 = 有人在裝 → 等 N 秒再失敗。\n優：所有檔案系統（含 NFS、macOS Docker Desktop、WSL）都可靠、實作最簡單。\n缺：容器被殺（Ctrl-C、OOM）會留殘鎖；用 mtime／PID 判殘鎖在容器裡都不可靠（PID 空間不同、時鐘偏差）。"))
d3.append(opt("d3_c", 1040, 400, 500, 160, "C（雙軌一致）：flock，但鎖的是專案目錄本身", "flock /repo 目錄（不建鎖檔：鎖檔放 .vendor_kit/ 或 .<name>/ 會被整批替換而失效；放根目錄要改使用者的 .gitignore）。一個專案一把鎖：install 排他、verify 共享。\n優：核心自動釋放，零殘鎖；已在本機實測兩個容器 + 主機三方互斥成立；Python 標準庫就有。\n缺：macOS Docker Desktop（已知未修 bug）、WSL /mnt/c、NFS 上不保證互斥 → 明寫只保證原生 Linux。", rec=True))
d3.append(v("d3_flow", "1", SW(NEUTRAL), "方案 C 的 install（第 5 頁 install 泳道會改成這樣）", 40, 590, 1500, 300))
d3.append(v("h0", "d3_flow", ELLIPSE(GREEN), "開始 install", 30, 60, 160, 50))
d3.append(v("h1", "d3_flow", LEAF(), "flock 專案目錄（排他）\n拿不到：1 秒後印訊息，等最多 60 秒", 230, 60, 260, 50))
d3.append(v("h2", "d3_flow", RHOMBUS, "拿到鎖後重讀 .version\n與印記：已是目標版本？", 530, 45, 200, 80))
d3.append(v("h3", "d3_flow", LEAF(), "清殘留 .<name>.tmp.* → 寫暫存目錄（亂數名）\n→ 寫印記 → 刪舊 → 改名（全程在鎖內）", 780, 60, 320, 50))
d3.append(v("h4", "d3_flow", LEAF(), "釋放鎖", 1140, 60, 120, 50))
d3.append(v("h5", "d3_flow", ELLIPSE(GREEN), "成功結束", 1300, 60, 160, 50))
d3.append(v("h6", "d3_flow", LEAF(), "跳過複製，仍跑一次 verify", 530, 170, 200, 50))
d3.append(v("h7", "d3_flow", ELLIPSE(RED), "逾時：中止、不動任何檔\n「另一個 vendor_kit 仍持有鎖，docker ps 查」", 230, 160, 260, 60))
d3.append(v("h8", "d3_flow", NOTE, "verify 拿同一把鎖（共享）。鎖只保護容器內的 install/verify；主機端腳本在執行中仍可能撞到「刪舊→改名」的空窗（見待決 2）。", 780, 160, 460, 50))
d3.append(e("he0", "h0", "h1", "", (1, 0.5), (0, 0.5)))
d3.append(e("he1", "h1", "h2", "拿到", (1, 0.5), (0, 0.5)))
d3.append(e("he2", "h1", "h7", "逾時", (0.5, 1), (0.5, 0), vert=True))
d3.append(e("he3", "h2", "h3", "否", (1, 0.5), (0, 0.5)))
d3.append(e("he4", "h2", "h6", "是", (0.5, 1), (0.5, 0), vert=True))
d3.append(e("he5", "h3", "h4", "", (1, 0.5), (0, 0.5)))
d3.append(e("he6", "h4", "h5", "", (1, 0.5), (0, 0.5)))
d3.append('<mxCell id="he7" value="" style="' + EDGE + 'exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="d3_flow" source="h6" target="h4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="195"/></Array></mxGeometry></mxCell>')
d3.append(v("d3_q", "1", NOTE, "雙軌一致（不用再問）：採 C、鎖專案目錄本身；逾時預設 60 秒（環境變數可改，0 = 立即失敗給 CI）；鎖不支援（NFS 等）→ 直接失敗，不自動退回 B，給 VENDOR_KIT_NO_LOCK=1 逃生口；暫存目錄用亂數名並順手清殘留；docker run 加 --init 讓中止訊號能傳給程式；symlink 切換不做；測試閘門要有「兩個容器同時裝」的案例。\n對 agy 的更正：Nix 用的是 flock 不是 fcntl；macOS Docker Desktop 上「同一 VM 內容器互鎖仍可」沒依據（實際上也壞）；多個引用連結對錯題。\n要你決定：\n1. 支援平台：只保證原生 Linux，macOS Docker Desktop／WSL 印警告不保證？（建議是）\n2. 主機端腳本執行到一半時 .<name>/ 被另一個 just 換掉，要防到哪層？(a) 接受、寫進限制（建議第一版）；(b) 目錄任何瞬間都完整 → 用 Linux 的 RENAME_EXCHANGE 原子交換；(c) 同一次執行全程同版本 → 要改成版本目錄，大工程。\n3. 執行中 .version 被改（另一邊在 git checkout）：照原本讀到的版本裝完，還是取消？（建議裝完，下次 just 再對齊）", 40, 930, 1500, 130))
d3 += legend_flow("d3", 40, 1090, note=True)
d3 += terms("d3", 40, 1200, [
 ("flock", "Linux 的檔案鎖：程序結束或被殺，核心自動解鎖，不會留殘鎖"),
 ("殘鎖（stale lock）", "拿鎖的程序死了但鎖檔還在，後面的人永遠等不到；mkdir 鎖的典型問題"),
 ("原子替換", "外面的人看到的不是完整舊版就是完整新版，沒有中間狀態；目前的 rmtree + rename 做不到，要靠鎖蓋住"),
 ("virtiofs / 9p", "macOS Docker Desktop 與 WSL 把主機目錄掛進容器用的檔案系統，檔案鎖在上面不可靠"),
 ("RENAME_EXCHANGE", "Linux 的系統呼叫：把兩個目錄一口氣互換，外面的人看不到中間狀態；NFS 不支援"),
 ("--init", "docker run 的選項：讓容器裡有個小程式負責轉送「停止」訊號，Python 才來得及清暫存目錄"),
])
pages.append(("d3", "討論 #13：並行安裝 lock", d3))

# ================= 討論 D4：#12 verify 比什麼 =================
d4 = [v("title", "1", TITLE, "討論 #12：verify 的基準與範圍 ── 每次 just 都要跑，比什麼、比多細", 40, 20, 1500, 30)]
d4.append(v("d4_pre", "1", NOTE, "前例（agy；經雙軌分析更正）：agy 的表有三列寫反（Terraform 其實每次 plan/apply 都對 provider 目錄重算 hash 跟進 git 的鎖檔比 —— 這才是最像我們的前例；Go 的 verify 基準也是本地可寫的檔；pip 只重寫 RECORD 不驗）。可信的部分：Nix 比整棵樹（含執行位、symlink）且 store 唯讀；dpkg/rpm 比本地清單。\n關鍵事實（雙方都查了原型）：verify 本來就在「該工具自己的 image」容器裡跑，而那個 image 裡就有 /dist —— 所以「從 image 重取要多起容器、要上網」是錯的：不用多起容器、不碰網路，只是多讀一份檔（實測 200 檔雙邊 hash 42 ms，docker run 本身就 250 ms）。\n另一個關鍵：A、B 的印記跟被驗的檔在同一目錄、同一個使用者可寫 —— 改檔案順便改印記就過關，只能防「不小心」，防不了「故意」。", 40, 60, 1500, 110))
d4.append(opt("d4_a", 40, 170, 480, 150, "A：只比印記裡的內容 hash（現況）", "優：已實作、夠快。\n缺：抓不到多餘檔、執行位、symlink（原型 rglob 會跟隨 symlink，可讀到樹外）；基準是可寫的印記，只防不小心。"))
d4.append(opt("d4_b", 540, 170, 480, 150, "B：印記 + 檔案集合 + 權限位 + stat 快取（原草稿傾向，雙軌否決）", "缺：基準仍是可寫的印記；stat 快取只省約 10 ms 卻帶來 mtime 粒度、同長度改寫漏抓、跨平台 mode 誤報、兩條驗證路徑要測；「快」在閘門裡量不出來。\n可取的部分（檢查範圍要比 A 寬）併入 C。"))
d4.append(opt("d4_c", 1040, 170, 500, 150, "C（雙軌一致建議）：基準 = 鎖定 image 裡的 /dist", "在本來就會起的工具容器內，對 /dist/files 與掛進來的 .<name>/ 做「兩棵樹 diff」：檔案集合（缺、多都失敗，只豁免 .stamp）＋內容 sha256＋執行位（只比該 +x 有沒有 +x）＋型別（lstat 不跟隨 symlink）；不比 mtime、owner。\n同一個函式給 install / verify / release-test 用。\n印記降級為「裝的是哪版」的快取鍵 + 給人追溯，不簽章。\n優：基準不可寫、由 .version 的 digest 鎖定（notes §6 原意）；故意改也抓得到；程式更少。", rec=True))
d4.append(v("d4_flow", "1", SW(NEUTRAL), "方案 C 的 verify（第 5 頁 verify 泳道會改成這樣）", 40, 370, 1500, 250))
d4.append(v("k0", "d4_flow", ELLIPSE(GREEN), "開始 verify", 30, 60, 160, 50))
d4.append(v("k1", "d4_flow", LEAF(), "印記第一行 = 啟動器傳進來的 .version 字串？\n（不是 → 走 install）", 230, 60, 300, 50))
d4.append(v("k2", "d4_flow", RHOMBUS, "/dist 與 .<name>/\n檔案集合相同？", 570, 45, 200, 80))
d4.append(v("k3", "d4_flow", LEAF(), "逐檔比：sha256、執行位、\n型別（symlink 不跟隨）", 810, 60, 260, 50))
d4.append(v("k4", "d4_flow", RHOMBUS, "全部相符？", 1110, 45, 180, 80))
d4.append(v("k5", "d4_flow", ELLIPSE(GREEN), "通過", 1330, 60, 140, 50))
d4.append(v("k6", "d4_flow", ELLIPSE(RED), "失敗：列出缺／多／被改的檔，\n中止並提示刪掉重裝（不自動重裝）", 520, 160, 300, 50))
d4.append(e("ke0", "k0", "k1", "", (1, 0.5), (0, 0.5)))
d4.append(e("ke1", "k1", "k2", "", (1, 0.5), (0, 0.5)))
d4.append(e("ke2", "k2", "k3", "是", (1, 0.5), (0, 0.5)))
d4.append(e("ke3", "k3", "k4", "", (1, 0.5), (0, 0.5)))
d4.append(e("ke4", "k4", "k5", "是", (1, 0.5), (0, 0.5)))
d4.append(e("ke5", "k2", "k6", "否", (0.5, 1), (0.5, 0), vert=True))
d4.append('<mxCell id="ke6" value="否" style="' + EDGE + 'exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="d4_flow" source="k4" target="k6"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="185"/></Array></mxGeometry></mxCell>')
d4.append(v("d4_q", "1", NOTE, "雙軌一致（不用再問）：採 C；多餘檔中止（理由：.<name>/ 是整批替換的目錄，下次升級會無聲刪掉它；警告不可強制）；印記不簽章；第一版不做 stat 快取（dist 上百 MB 再說）；verify 失敗中止、不自動重裝；.vendor_kit/ 是例外（沒有 /dist，基準 = image 內程式重新產生 vendor.just 再比）。\n要你決定：\n1. 有沒有任何工具會在執行期往 .<name>/ 寫東西（log、快取、產生的 compose）？有的話「多餘檔 = 失敗」要先把它們搬出去。（base 現況？）\n2. dist 裡有沒有 symlink？沒有就第一版直接禁止 symlink，最省事。\n3. 主機只支援 Linux 嗎？（macOS Docker Desktop／Windows 掛載的權限位會誤報）\n4. 時間預算 0.5 秒是算「容器內 verify」還是「整個 just」？後者兩個工具就超過（每次 docker run 約 250 ms，跟 hash 無關）。", 40, 650, 1500, 120))
d4 += legend_flow("d4", 40, 800, note=True)
d4 += terms("d4", 40, 910, [
 ("mode / 權限位", "檔案的讀寫執行權限（例如可執行）；改了它不會動到內容 hash，所以要另外比"),
 ("stat / size / mtime", "不打開檔案就能拿到的資訊：大小、最後修改時間；先比這些能省掉大部分 hash 計算"),
 ("檔案集合", "印記列的檔名清單 vs 目錄裡實際有的檔名：少的 = 缺檔，多的 = 多餘檔"),
 ("cosign / minisign", "幫檔案簽名的工具，能證明印記是工具寫的不是別人偽造的；本題先不採用"),
])
pages.append(("d4", "討論 #12：verify 比什麼", d4))

doc = '<mxfile host="app.diagrams.net">' + "".join(page(pid, name, cells) for pid, name, cells in pages) + "</mxfile>"
