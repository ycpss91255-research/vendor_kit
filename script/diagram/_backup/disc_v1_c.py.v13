b.box("o2", UO, 6, W12, "sh bootstrap.sh --local <引擎 tar> [-y]（契約入口；-t <repo> 走 registry 需網路，離線機不帶）", 230)
b.box("o2s", SH, 6, v2(W12), "先建 log/bootstrap/<ts>-<id8>.jsonl 並寫 launcher_start（失敗 → 1 + 6-38，零寫入）", 400)
b.box("o5x", UO, 7, O12, "否 → 1 + 6-16：請先 git init", 230)
b.box("o5", SH, 7, D12, "在 git repo 內？", 300, ax="l")
b.box("o6x", UO, 8, O12, "否 → 1 + 6-23：請裝 GitHub release 版 just", 230)
b.box("o6", SH, 8, D12, "just ≥ 1.33.0？", 300, ax="l")
b.box("o3", SH, 9, D12, "--local 值含 / 或以 .tar 結尾？", 300, ax="l")
b.box("o3n", P, 9, RULE, "已定（B1；grilling 2026-09-19 末條、v2.7-2、v2.8-4、v2.9-1）三分支：值含 / 或以 .tar 結尾 → 檔案路徑（先驗存在，否則 1）→ docker load；其餘 → image tag（不 load、不讀 .digest）；既存檔且可解讀為 tag → 1 + 6-37 消歧（請寫 ./<v> 或完整 ref）；前置檢查（git repo／just）不分型別一律先做", 280)
b.box("o3bx", UO, 10, O12, "否 → 1：檔案路徑必須存在", 230)
b.box("o3b", SH, 10, D12, "該路徑的檔案存在？", 240, ax=30)
b.box("o3t", SH, 10, W12, "否 → tag 形：不 load、不讀 .digest（本機須已有該 image）", 120, ax="r")
b.box("o3cx", UO, 11, O12, "是 → 1 + 6-37：值歧義（既存檔也像 tag），請寫 ./<v> 或完整 ref", 230)
b.box("o3c", SH, 11, D12, "值同時可解讀為 image tag？", 300, ax="l")
b.box("o4x", UO, 12, O12, "否 → 1：同名 .tar.digest 旁檔缺", 230)
b.box("o4", SH, 12, D12, "同名 .tar.digest 存在？", 300, ax="l")
b.box("o6c", SH, 13, W12, "docker load < <引擎 tar>", 300, ax="l")
b.box("o6d", DK, 13, IMG, "本機 image vendor_kit:vN（只有 tag、無 RepoDigests）", 170, ax="l")
b.box("o7a", SH, 14, W12, "讀 <tar>.digest → 正式 index digest", 300, ax="l")
b.box("o7b", SH, 15, W12, "docker image inspect --format '{{.Id}}' → image ID（tag 形由此匯入：跳過 load 與 .digest）", 400)
b.box("o7bd", DK, 15, NOTE, "結果：回 image ID（sha256:<hex64>）", 170, ax="l")
b.box("o8", SH, 16, W12, "docker run 本機 image install（本機有 → 不 pull）", 400)
b.box("o8e", E, 16, SUB, "install：建薄殼五檔、gen/.stamp、baseline/.gitkeep；version.toml 第一行 = 正式 ref@digest（tar 形：.digest 旁檔；tag 形：既有 version.toml 值，第一次接入用 bootstrap.sh 內嵌引擎 ref）", 320)
b.files("o8f", P, 16, "install 寫", ["version.toml 第一行（正式 ref@digest）", "薄殼五檔（含 log.sh）、gen/.stamp、.gitkeep、justfile 一行、.dockerignore 四行"], 280)
b.box("o8x", UO, 17, v2(R12), "是 → 1：中止（清半成品、保留 log/）", 230)
b.box("o8q", SH, 17, D12, "install 失敗？", 220, ax="l")
b.box("o9", SH, 18, W12, "否：install 成功後寫 version.local.toml：vendor_kit = \"vendor_kit:vN\" + vendor_kit_image_id", 400)
b.box("o9f", P, 18, F12, "version.local.toml（不進 git）：本機 tag + image ID", 280)
b.box("o9z", SH, 19, LBL, "↓ 續「離線包（2）」頁：工具由使用者另備工具 tar，逐一 add <repo> --local <工具 tar>；之後斷網 sync", 400, 24, ax="l", minh=24)
b.D("oe0", "o0", "o1"); b.D("oe1", "o1", "o1w", al=True); b.D("oe1a", "o1w", "o1a", al=True); b.D("oe1b", "o1a", "o1b"); b.D("oe1c", "o1b", "o1c"); b.D("oe1w", "o1c", "o2")
b.H("oe2", "o2", "o2s"); b.D("oe2l", "o2s", "o5", al=True)
b.H("oe6x", "o5", "o5x", "否"); b.D("oe6b", "o5", "o6", "是", al=True); b.H("oe6bx", "o6", "o6x", "否"); b.D("oe6c", "o6", "o3", "是", al=True)
b.RD("oe3t", "o3", "o3t", "否"); b.D("oe3b", "o3", "o3b", "是", al=True); b.H("oe3bx", "o3b", "o3bx", "否")
b.D("oe3c", "o3b", "o3c", "是", al=True); b.H("oe3cx", "o3c", "o3cx", "是")
b.D("oe4", "o3c", "o4", "否", al=True); b.H("oe5", "o4", "o4x", "否"); b.D("oe7", "o4", "o6c", "是", al=True)
b.H("oe8", "o6c", "o6d", "載"); b.D("oe9", "o6c", "o7a"); b.D("oe9b", "o7a", "o7b", al=True); b.H("oe9d", "o7b", "o7bd"); b.D("oe10", "o7b", "o8")
_A = geo(b); _tx, _ty, _tw, _th = _A["o3t"]; _bx, _by, _bw, _bh = _A["o7b"]; _gy = _by - F.gap / 2   # tag 形匯入：繞 daemon 欄右側（x=910）下來，從列間縫隙進 o7b 頂端（不穿「載」線）
b.P("oe3tj", "o3t", "o7b", "tag 形：跳過 load／.digest", (1, 0.5), (round((650 - _bx) / _bw, 3), 0), [(910, _ty + _th / 2), (910, _gy), (650, _gy)], pos=-0.85, vert="below")
b.H("oe11", "o8", "o8e"); b.H("oe12", "o8e", "o8f", "寫")
b.D("oe13", "o8", "o8q", al=True); b.H("oe13x", "o8q", "o8x", "是"); b.D("oe13n", "o8q", "o9", "否", al=True); b.H("oe14", "o9", "o9f", "寫"); b.D("oe15", "o9", "o9z", al=True)
b.close()
foot(p16, "p16", F.y, [r for r in T16 if not r[0].startswith("sync 快路徑")], ALLC - {"inv", "pend", "tree", "state", "entry", "c0", "cx", "c1", "cell"})
pages_v1_c.append(("v1p16", "流程 v2：離線包（1）bootstrap.sh --local", p16))

# ================= P16c：離線包（2）add --local 與斷網 sync =================
p16c, F = newpage_c("流程 v2：離線包（2）── 另備工具 tar → add --local 逐工具 → 斷網 sync（Q26、§4.8、§7.4-17）", N16, COLS_OF2, gap=14)
b = F.band("bO1b", "離線接工具（v2.8-5、v2.10-3）：工具 tar 由工具 repo 提供、使用者另備 → 每個工具各跑一次 add <repo> --local <工具 tar>（只收 tar）：驗 .tar 存在 → load → 讀 .digest → image ID → resolve → create／cp → apply（flock → 重驗 → 寫入）", v2=True)
b.box("oo0", UO, 0, ENTRY, "來自「離線包（1）」頁：install 完成（引擎可離線跑；已寫 launcher_start）", 230)
b.box("oo1", UO, 1, W12, "有網路的機器取得工具 tar + 同名 .tar.digest（由工具 repo 提供；不在 vendor_kit 離線包內）→ 帶到離線機", 230)
b.box("oo1n", P, 1, RULE, "已定（v2.8-5）：vendor_kit 離線包只含引擎；-t <repo> 走 registry（需網路）；離線接工具 = 使用者另備工具 tar（工具 repo 的 docker save + .digest），逐工具 add <repo> --local <工具 tar>；離線 upgrade 不支援", 280)
b.box("o10l", UO, 2, LBL, "↓ 每個工具各跑一次（一次一個）：", 230, 24, ax="l", minh=24)
b.box("o10", UO, 3, W12, "just vendor_kit add <repo> --local <工具 tar> [-y]", 230)
b.box("o10qx", UO, 4, O12, "否 → 1：add --local 只接受 tar（tag 形只有 bootstrap.sh）", 230)
b.box("o10q", LA, 4, D12, "值是存在的 .tar 檔？", 300, ax="l")
b.box("o10a", LA, 5, W12, "是：docker load < <工具 tar>", 400)
b.box("o10d", DK, 5, IMG, "本機 image <repo>-dist:<tag>", 240)
b.box("o10b", LA, 6, W12, "讀 <工具 tar>.digest → 正式 index digest（旁檔缺 → 1）", 400)
b.box("o10c", LA, 7, W12, "docker image inspect --format '{{.Id}}' → image ID", 400)
b.box("o10cd", DK, 7, NOTE, "結果：回 image ID（sha256:<hex64>）", 240)
b.box("o10r", LA, 8, W12, "docker run 引擎 resolve add <repo> --local（帶 index digest + image ID；永不 -t）", 400)
b.box("o10re", E, 8, SUB, "resolve（不寫）：算計畫、指紋；stdout vk-resolve/1 回啟動器", 320)
b.box("o10p", LA, 9, W12, "docker create／cp 取本機 image 的 dist 到暫存（不 pull）", 400)
b.box("o10p2", LA, 10, W12, "docker run 引擎 apply add（暫存唯讀掛進 /dist）", 400)
b.box("o10e", E, 10, SUB, "apply add：拿 flock 專案目錄（60 秒；逾時 → 1 + 6-26）", 320)
b.box("o10e2", E, 11, SUB, "重驗指紋（與 vk-resolve 的 fingerprint 比；不同 → 1 + 6-12「請重跑」）", 320)
b.box("o10e3", E, 12, SUB, "寫 metadata：source + local_image_id（其餘寫入見「add（2）」頁）", 320)
b.files("o10f", P, 12, "add 寫（同「add（2）」頁）", ["metadata：source + local_image_id", "cache/<repo>/、gen/<repo>.stamp"], 280)
b.box("o10e4", E, 13, SUB, "寫 version.toml [tools] 行：正式 ref@digest（最後寫）", 320)
b.box("o10f2", P, 13, F12, "version.toml [tools] 行（正式 ref@digest；與線上接入相同）", 280)
b.box("o11", UO, 14, G12, "0：該工具接入完成（version.toml 同線上）；下一個工具再跑 add", 230)
b.D("oe20", "oo0", "oo1"); b.D("oe20l", "oo1", "o10l", al=True); b.D("oe21", "o10l", "o10", al=True); b.D("oe21q", "o10", "o10q", al=True)
b.H("oe21x", "o10q", "o10qx", "否")
b.D("oe22", "o10q", "o10a", "是", al=True); b.H("oe22d", "o10a", "o10d", "載"); b.D("oe23", "o10a", "o10b")
b.D("oe24", "o10b", "o10c"); b.H("oe24d", "o10c", "o10cd"); b.D("oe25", "o10c", "o10r"); b.H("oe25e", "o10r", "o10re"); b.DL("oe26", "o10re", "o10p", "vk-resolve")
b.D("oe26b", "o10p", "o10p2"); b.H("oe26e", "o10p2", "o10e"); b.D("oe26f", "o10e", "o10e2"); b.D("oe26g", "o10e2", "o10e3"); b.H("oe27", "o10e3", "o10f", "寫"); b.D("oe27b", "o10e3", "o10e4"); b.H("oe27c", "o10e4", "o10f2", "寫"); b.DL("oe28", "o10e4", "o11")
b.close()
b = F.band("bO2", "之後（Q26）：斷網下 sync／build 必成功 —— 啟動器先 docker image inspect，本機有就不 pull；離線 upgrade 不支援", v2=True)
b.box("w0", UO, 0, G12, "斷網：just <ns> build（自動 _sync）／just vendor_kit sync（已寫 launcher_start）", 230)
b.box("w1", LA, 0, W12, "快路徑：grep 比對 gen/*.stamp 第一行 vs version.toml；全相符 → 不起容器 → 0（sync --verify 或 CI 為真則全驗）", 400)
b.box("w2", LA, 1, W12, "有差：docker image inspect <ref>（version.toml 的正式 ref）", 400)
b.box("w2r", P, 1, RULE, "已定（v2.6-1、19條-11）：不用 --pull never（docker 19.03 無此旗標）；先 inspect 本機有就直接 docker run；離線 upgrade 不支援（只涵蓋 install／add --local）", 280)
b.box("w3x", UO, 2, R12, "無 → 1 + 6-31：拉不到（--timeout 內結束、不 hang）", 230)
b.box("w3", LA, 2, D12, "本機有該 image？", 220, ax="l")
b.box("w3d", DK, 1, IMG, "本機已有 image（docker load 過的）", 240)
b.box("w4", LA, 3, W12, "有：直接 docker run（不 pull）resolve／apply sync", 400)
b.box("w4e", E, 3, SUB, "sync：驗 image ID == metadata local_image_id（離線對照 index digest；不符 → 1）", 320)
b.box("w4e2", E, 4, SUB, "materialize／verify cache（印記不符 → 重展開；verify 逐檔 sha256）", 320)
b.box("w4f", P, 4, F12, "cache/<repo>/、gen/<repo>.stamp、gen/tools.just（只寫不進 git 的）", 280)
b.box("w5", UO, 5, G12, "0：成功、不起 pull（驗收 §7.4-17）", 230)
b.H("we0", "w0", "w1"); b.D("we1", "w1", "w2"); b.D("we2", "w2", "w3", al=True); b.H("we3", "w3", "w3x", "無")
b.H("we4", "w2", "w3d"); b.D("we5", "w3", "w4", "有", al=True); b.H("we6", "w4", "w4e"); b.D("we6b", "w4e", "w4e2"); b.H("we7", "w4e2", "w4f", "寫"); b.DL("we8", "w4", "w5")
b.close()
foot(p16c, "p16c", F.y, [r for r in T16 if not (r[0].startswith("bootstrap.sh --local") or r[0].startswith("local_bootstrap") or r[0] == "version.local.toml")], ALLC - {"inv", "pend", "tree", "state", "c0", "cx", "c1", "cell"})
pages_v1_c.append(("v1p16c", "流程 v2：離線包（2）add --local 與斷網 sync", p16c))
