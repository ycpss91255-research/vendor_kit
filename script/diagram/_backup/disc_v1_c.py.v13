# ================= P11：初始檔五態 =================
COLS_ST = [("deleted", 40, 290), ("managed", 350, 290), ("declined", 660, 290), ("appended", 970, 290), ("unmanaged", 1280, 290)]
SD, SM, SC, SA, SU = "deleted", "managed", "declined", "appended", "unmanaged"
T11 = [
 ("初始檔／範本", "工具 dist/init.toml 每個 [[file]]（src、dest、strategy = copy｜append）：add 時建到專案（dest）、upgrade 時逐檔判斷；歸使用者、進 git"),
 ("metadata [[file]].state（Q15、16 條）", "baseline/<repo>/.vendor_kit.toml 對每個範本一筆：state 單一列舉 managed／appended／declined／unmanaged／deleted；declined_hash（選填）= 最近一次被拒絕的那版範本 N 的 sha256；lines（只在 appended）= 實際插入的行原文"),
 ("declined 語意（v2.7-3）", "state=declined 只用於「範本要建的新檔被拒、從未建立」；已納管（managed／appended）的檔拒絕本次更新 → state 不變、只記 declined_hash（畫成自環）；add 時 append 檔已存在且拒絕 → unmanaged（本來就有、沒納管）；二進位拒絕同"),
 ("B／D／N", "B = baseline（上次合併時的範本副本，進 git）；D = 現況（專案裡你的那份檔）；N = 目標版範本 = 啟動器把目標版 image 展開到暫存、掛進引擎的 /dist/<repo>（不是 cache；v2.5 §2）；「D==B」= 你沒改過"),
 ("upgrade 逐檔判斷（managed）", "D 缺 → deleted；D==N 或 B==N → 不動；D==B → 問「X 換成新版？」；三者皆異 → 問後 git merge-file --diff3（衝突 → 2）；不論結果 baseline 推到 N（解析失敗除外）；二進位／symlink 未改 → 問後換、改過保留 + warn；拒絕 → 記 declined_hash、state 維持 managed"),
 ("declined 再問規則（Q14／Q15）", "新版 N 的 hash ≠ declined_hash → 再問一次「要建 X 嗎」（同意 → 建 → managed；拒絕 → 仍 declined、更新 declined_hash）；相同 → 不問，只印 6-6／6-8；EOF／Ctrl-C 不算拒絕、不記 declined"),
 ("append 行（Q6／Q12／Q13）", "strategy=append 的檔已存在 → 問「要在 X 加這幾行嗎」；同意 → 插入並記 lines；upgrade 用原文比對（CRLF／LF 等價）找上次插入的行：唯一命中 → 問後替換、零命中 → 不動只印新內容、多處 → 保留並 warn；remove／uninstall 問後只刪原文相同的行"),
 ("dry-run／check.sh 印什麼", "upgrade --dry-run 與 ci/check.sh ③ 印 6-6「有 N 個範本你拒絕過」、6-7「X 沒納管，與範本差 N 行」、6-8「Y 你拒絕過，vZ 有新版」；不動檔、不紅燈（CI 需改 tracked 檔才 1）"),
 ("6-11", "add 遇 copy 檔已存在：「<X> 已存在，未納管；範本在 .vendor_kit/cache/<repo>/files/ 可自行比對」"),
 ("永不刪", "不變量：vendor_kit 對使用者的檔可以建、要改先問、永不刪、永不覆蓋；remove／uninstall 只印初始檔清單（要刪用 git rm）；新版刪除的檔（N 缺）只 warn 不刪"),
 EXIT4,
]
N11 = "已定（Q14、Q15、v2.6 16 條、v2.7-3、interface_spec §4.3）：metadata 對每個範本記單一 state（五值）+ declined_hash + lines；declined 只用於新檔被拒、從未建立；已納管檔拒絕換版／合併時 state 不變只記 declined_hash（自環）；add 時 append 檔已存在且拒絕 → unmanaged；新版 hash 不同才再問；unmanaged／declined 只在 dry-run／check.sh 提醒、不動檔不紅燈；使用者刪了已納管檔 → deleted、upgrade 維持刪除。"
p11, F = newpage_c("狀態機 v2：初始檔五態 ── metadata [[file]].state 與轉移（interface_spec §4.3、Q14／Q15、v2.7-3）", N11, COLS_ST, gap=130, headers=False)
b = F.band("bS", "初始檔五態：每個範本一筆 state；箭頭 = 動詞：條件（自環 = 拒絕但狀態不變，只記 declined_hash）；每格一件事（狀態 → 轉入條件 → upgrade 時 → dry-run／check.sh 印什麼）；remove／uninstall 一律到終點", v2=True)
b.box("s0", SC, 0, G12, "起點：範本存在於工具 dist/init.toml 的 [[file]]（src／dest／strategy）", 280)
b.box("st_d", SD, 1, STATE, "deleted\n使用者刪了已納管檔", 160, 57, ax="l")
b.box("st_m", SM, 1, STATE, "managed\n已納管（vendor_kit 建的 copy 檔）", 160, 57, ax="l")
b.box("st_c", SC, 1, STATE, "declined\n新檔被拒、從未建立", 160, 57, ax="l")
b.box("st_a", SA, 1, STATE, "appended\n已插入行（strategy=append）", 160, 57, ax="l")
b.box("st_u", SU, 1, STATE, "unmanaged\n本來就有、沒納管", 160, 57, ax="l")
b.box("in_d", SD, 2, NOTE, "轉入：upgrade 逐檔判斷發現 D 缺（使用者刪了已納管檔）→ state=deleted", 190, ax="r")
b.box("in_m", SM, 2, NOTE, "轉入：add 時 dest 不存在 → 建；upgrade 新版新增檔、問「要建 X 嗎」同意 → 建；declined 再問後同意 → 建", 190, ax="r")
b.box("in_c", SC, 2, NOTE, "轉入：upgrade 新版新增檔、問「要建 X 嗎」後明確答否（EOF／Ctrl-C 不算）→ 從未建立、記 declined_hash", 190, ax="r")
b.box("in_a", SA, 2, NOTE, "轉入：add 時 strategy=append 且檔已存在、問「要在 X 加這幾行嗎」同意 → 插入並記 lines（原本就有的相同行不認領）", 190, ax="r")
b.box("in_u", SU, 2, NOTE, "轉入：add 時 copy 檔已存在 → 不納管、不覆蓋（-y 也不覆蓋），印 6-11；add 時 append 檔已存在、問後拒絕 → 同樣 unmanaged（只記 declined_hash）", 190, ax="r")
b.box("up_d", SD, 3, NOTE, "upgrade 時：維持刪除（不重建、不合併）；baseline 仍推到 N", 190, ax="r")
b.box("up_m", SM, 3, NOTE, "upgrade 時（仍 managed）：D==N／B==N 不動；D==B 問後寫 N；皆異問後三方合併（衝突 → 2）；拒絕 → 只記 declined_hash（自環）；baseline 推到 N", 190, ax="r")
b.box("up_c", SC, 3, NOTE, "upgrade 時：N 的 hash ≠ declined_hash → 再問；相同 → 不問（仍 declined）", 190, ax="r")
b.box("up_a", SA, 3, NOTE, "upgrade 時（仍 appended）：原文比對找 lines：唯一命中 → 問後替換（拒絕 → 只記 declined_hash，自環）；零命中 → 不動只印新內容；多處 → 保留並 warn", 190, ax="r")
b.box("up_u", SU, 3, NOTE, "upgrade 時：永遠不動（不合併、不覆蓋）；仍 unmanaged", 190, ax="r")
b.box("pr_d", SD, 4, NOTE, "dry-run／check.sh 印：維持刪除（不重建）；不紅燈", 190, ax="r")
b.box("pr_m", SM, 4, NOTE, "dry-run／check.sh 印：會問哪些檔（換新版／三方合併）；有 declined_hash 且新版相同 → 6-6；CI 需改 tracked 檔 → 1 印清單", 190, ax="r")
b.box("pr_c", SC, 4, NOTE, "dry-run／check.sh 印：6-6「有 N 個範本你拒絕過」；新版有更新 → 6-8「Y 你拒絕過，vZ 有新版」；不紅燈", 190, ax="r")
b.box("pr_a", SA, 4, NOTE, "dry-run／check.sh 印：找到 lines → 會問替換；找不到 → 印新內容；多處 → warn", 190, ax="r")
b.box("pr_u", SU, 4, NOTE, "dry-run／check.sh 印：6-7「X 沒納管，與範本差 N 行」；不紅燈", 190, ax="r")
for _k, _col in (("d", SD), ("m", SM), ("c", SC), ("a", SA), ("u", SU)):
    b.box(f"end_{_k}", _col, 5, G12, "終點：remove <repo>／uninstall → 這筆 state 隨 metadata 消失", 160, ax="l")
b.box("s_endn", SD, 6, NOTE, "終點（任一狀態皆同）：remove <repo>／uninstall → 初始檔保留並印清單（append 行問後只刪原文相同的）；metadata 隨 baseline/<repo>/ 刪除 → 狀態消失；要刪初始檔請自行 git rm", 1530, ax=0)
b.D("se_c", "s0", "st_c", "upgrade：拒絕建新檔", 0.5, 0.5)
b.D("se_m", "s0", "st_m", "add：建；upgrade：新增檔同意建", 0.1, 0.5, dy=0)
b.D("se_a", "s0", "st_a", "add：append 檔已存在、同意插入", 0.65, 0.5, dy=24)
b.D("se_u", "s0", "st_u", "add：copy 已存在；append 已存在但拒絕", 0.9, 0.5, dy=-24)
b.H("se_md", "st_m", "st_d", "upgrade：D 缺")
b.H("se_cm", "st_c", "st_m", "upgrade：再問→同意建")
for _k in ("d", "m", "c", "a", "u"):
    b.D(f"se_end_{_k}", f"st_{_k}", f"end_{_k}")
selfloop(b, "sl_m", "st_m", "upgrade：拒絕換版／三方合併 → 只記 declined_hash（仍 managed）")
selfloop(b, "sl_c", "st_c", "upgrade：再問後仍拒絕 → 更新 declined_hash（仍 declined）")
selfloop(b, "sl_a", "st_a", "upgrade：拒絕替換 lines → 只記 declined_hash（仍 appended）")
selfloop(b, "sl_u", "st_u", "upgrade：永遠不動（仍 unmanaged）")
b.close()
foot(p11, "p11", F.y, T11, {"note", "state", "v2"})
pages_v1_c.append(("v1p11", "狀態機 v2：初始檔五態", p11))

# ================= P12：交易與進度日誌 =================
COLS_TX = [("使用者", 40, 240), ("引擎容器（apply 段）", 300, 480), ("專案目錄", 800, 380), ("規則／說明", 1200, 390)]
EA, PA, XA = "引擎容器（apply 段）", "專案目錄", "規則／說明"
T12 = [
 ("install 的日誌（v2.13 P5）", "第一次 install 也建 .vendor_kit/.tmp.install.<id>.toml（統一規則、無例外）：它同時是「不留半成品」的清除清單，失敗依它移除已寫的檔（log/ 保留）、成功後刪；修復型 install 同一規則、與其他可寫動詞一樣走恢復"),
 ("恢復", "可寫動詞（install／add／remove／upgrade／undev／uninstall）開始前偵測到未完成交易 → 先依日誌把交易走完（done 略過、pending 補做、consents 不再問）再繼續本次；失敗 → 1 印 6-27「未恢復：<檔名>」逐檔列出、日誌留著"),
 ("兩種位置", "add／upgrade <repo> 記在 metadata [progress]；remove／uninstall 放 .tmp.* 因 metadata 會被刪，undev／prune 沒有工具 metadata；upgrade vendor_kit 的 .tmp.upgrade.<id>.toml 另記舊引擎 ref、目標 ref、計畫 image ID；<id> = 本次 trace_id"),
 T_FP,
 ("交易／apply", "一次會寫檔的動詞執行 = 一筆交易：apply 拿 flock → 重驗指紋 → dry-run 分支 → 建進度日誌（第一個寫入前）→ 逐步寫入 → 最後一步刪日誌；回 3 一律零寫入；工具層回 1 時 version.toml 不動"),
 ("唯讀動詞不恢復", "sync／update 偵測到未完成交易只印 6-33「偵測到未完成的 <verb>（<id>）。請先重跑：just vendor_kit <verb> <targets>」→ 1，不寫任何檔；help 不受影響"),
 ("原子替換／暫存", "每個寫入先寫到暫存（合併也在暫存完成），確認沒問題再逐檔一次換上（rename）；gen/tools.just 最後寫、與 cache 同一 apply 內原子替換；中斷只會留下「已換上」與「未換上」兩種檔，不留半寫的檔"),
 ("prune 特例（v2.7-7）", "prune 遇活躍（未恢復）日誌：只列出並印 6-33、不刪、不視為未完成交易（不擋 prune、不恢復）；prune 自己的 apply 也建 .tmp.prune.<id>.toml（清理前建、清理後刪；v2.9-6），與其他可寫動詞一樣走恢復"),
 ("進度日誌", "記錄交易進度的 TOML：state=\"in-progress\"、verb、id、started、targets、done／pending、consents；存在 = 上次沒走完；add／upgrade <repo> 記在 metadata [progress]，其餘可寫動詞放 .vendor_kit/.tmp.<verb>.<id>.toml（第一次 install 也建，v2.13 P5）；可寫動詞先恢復、sync／update 印 6-33 結束 1、help 仍 0"),
 T_MSG, EXIT4,
]
N12 = "已定（v2.2 C、v2.4-12、v2.5-3、v2.6-9、v2.7-7、v2.8-2、interface_spec §0 進度日誌、§4.3 [progress]、§4.6）：apply 順序 = flock → 重驗指紋 → dry-run 分支 → 建進度日誌（第一個寫入前）→ 寫入 → 最後一步刪日誌（uninstall 在根 justfile 那行之後）；中斷 → 1 明列已完成／未完成；下次可寫動詞先恢復（失敗 6-27）、唯讀動詞只提示 6-33 不恢復；prune 特例：活躍日誌只列出不刪、不視為未完成交易；install 無例外（v2.13 P5）：第一次也建 .tmp.install.<id>.toml，兼不留半成品的清除清單。"
p12, F = newpage_c("狀態機 v2：交易與進度日誌（interface_spec §0、§3.2 apply、§4.3 [progress]、§4.6）", N12, COLS_TX, gap=14)
b = F.band("bT1", "交易生命週期（所有可寫動詞的 apply 段，含第一次 install；v2.13 P5）：拿鎖 → 重驗指紋 → dry-run 分支 → 建日誌 → 逐步寫入（每步 ① 寫暫存 ② 原子替換 ③ 日誌 done）→ 刪日誌；中斷 → 1、日誌留著", v2=True)
