b.files("t4f", PA, 3, "日誌位置（依動詞）", ["add／upgrade <repo>：baseline/<repo>/.vendor_kit.toml [progress]", "remove／uninstall／undev／prune：.vendor_kit/.tmp.<verb>.<id>.toml", "install（第一次與修復型）：.vendor_kit/.tmp.install.<id>.toml（第一次 = 不留半成品的清除清單）", "upgrade vendor_kit：.vendor_kit/.tmp.upgrade.<id>.toml（改第一行前建、新引擎重產薄殼後刪；v2.11）"], 380)
b.box("t4n", XA, 3, RULE, "已定（v2.13 P5）install 無例外：第一次 install 也建 .tmp.install.<id>.toml，它同時是「不留半成品」的清除清單（失敗依它移除已寫的檔，log/ 保留）；修復型同。其餘兩種位置：remove／uninstall 會刪 metadata、undev／prune 沒有工具 metadata → 放 .vendor_kit/.tmp.*（自有 .gitignore 擋）；upgrade vendor_kit 也建 .tmp.upgrade.<id>.toml（v2.11）；<id> = 本次 trace_id", 390)
b.box("t5", EA, 4, SUB, "逐步寫入 ①：寫暫存檔（合併也在暫存完成；詢問取得的同意先記進 consents）", 480)
