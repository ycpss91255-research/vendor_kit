# ---- 專案目錄 ----
PX, PW = 1320, 280
p4.append(v("p4P", "1", SW(GREEN), "專案目錄（掛載為 /repo）", PX, LY, PW, LH))
FN_T = "整個專案目錄 -v $PWD:/repo 掛進引擎（可寫）；引擎只寫箭頭指到的路徑；工具檔另從 <tmp> 唯讀掛 /dist"
p4.append(v("f_note", "p4P", NOTE, FN_T, 15, 50, 240, hv(FN_T, 240, pad=8)))
files = [
 ("f_ver", F_GIT, "version.toml（進 git）", 15, R["ver"][0], 36, True),
 ("f_vl", F_NOGIT, "version.local.toml（dev 覆寫）", 15, R["ver"][0] + 40, 36, True),
 ("f_repo", F_NOGIT, "cache/<repo>/（不進 git，不可改）\nfiles/、init.toml、just/、.stamp", 15, R["mat"][0], 76, True),
 ("f_bl", F_GIT, "baseline/<repo>/（進 git）\n範本副本 + .vendor_kit.toml metadata", 15, R["bl"][0], 76, True),
 ("f_user", F_USER, "初始檔（使用者的，進 git）\nDockerfile…、.gitignore 的幾行\n路徑由 init.toml 的 dest 決定；\n永不刪、永不覆蓋", 15, R["im"][0], 96, True),
 ("f_shell", F_GIT, "薄殼（進 git）：entry.just、\nvendor.just、.gitignore、\ncheck.sh、根 justfile 一行", 15, R["lg"][0], 56, True),
 ("f_gen", F_NOGIT, "gen/（不進 git，重生）：\ntools.just、.stamp（薄殼 hash）", 15, R["lg"][0] + 64, 56, True),
]
for pid, st, t, x, y, h, tg in files:
    p4 += vt(pid, "p4P", st, t, x, y, 240, h, tagged=tg)
p4.append(e("w_ver", "m_ver", "f_ver", "讀寫", (1, round(18 / 76, 4)), (0, 0.5)))
p4.append(e("w_vl", "m_ver", "f_vl", "讀（覆寫）", (1, round(58 / 76, 4)), (0, 0.5)))
p4.append(e("w_repo", "m_mat", "f_repo", "整批替換", (1, 0.5), (0, 0.5)))
p4.append(e("w_bl", "m_bl", "f_bl", "寫", (1, 0.5), (0, 0.5)))
p4.append(e("w_user", "grp_im", "f_user", "建／append\n問後合併", (1, 0.5), (0, 0.5)))
p4.append(e("w_shell", "m_lg", "f_shell", "薄殼 just 檔", (1, round(28 / 120, 4)), (0, 0.5)))
p4.append(e("w_gen", "m_lg", "f_gen", "重生", (1, round(92 / 120, 4)), (0, 0.5)))
# ---- 跨區的線 ----
h4c = hy["h4"] + hh["h4"] / 2
p4.append(e("run_cli", "h4", "m_cli", "docker run 引擎\nresolve／apply <動詞>", (1, 0.5), (0, fy(h4c)), pos=-0.5))
p4.append(e("mount_dist", "tmp", "p4E", "掛載\n/dist:ro", (1, 0.5), (0, round((50 + tmph / 2) / LH, 4))))
p4.append(e("pull_eng", "g_eng", "p4H", "docker pull 引擎 image\n（引擎覆寫 → 本機 image，--pull never）", (0.5, 1), (round((40 + 20 + 220 - HXo) / HW, 4), 0), vert=True))
gx = 590
p4.append(e("pull_dist", "g_dist", "p4H", "docker pull／create／cp\n→ 工具 /dist 抓到 <tmp>", (round((gx - (40 + 480)) / 620, 4), 1), (round((gx - HXo) / HW, 4), 0), vert=True))
qx = EX + MX + MW / 2
p4.append(e("q_reg", "p4E", "g_dist", "registry 查 tag／index digest", (round((qx - EX) / EW, 4), 0), (round((qx - (40 + 480)) / 620, 4), 1), vert=True))
Y = LY + LH + 30
p4 += lgd("p4", 40, Y, ["v4eng", "v4mod", "v4unit", "v4host", "v4hgrp", "v4pgrp"], "實線 = 資料流（線上文字 = 傳什麼）\n雙箭頭 = 來回都有\n順序與判斷見流程頁")
p4 += lgd("p4b", 40, Y + 60, ["v2git", "v2no", "v2usr", "v2code", "v2tag", "v4frame", "note"], "黃橢圓 = 使用者（外部）\n本頁無待拍板便條（見右上小註）")
p4 += terms("p4", 40, Y + 160, [
 ("引擎", "vendor_kit 的程式本體：只以 image 存在（公開、多架構）、只在容器內跑；8 個模組見紫色容器；一個專案用 version.toml 第一行那一版（version.local.toml 可覆寫成本機 image）"),
 ("啟動器", ".vendor_kit/ 裡的 POSIX sh 薄殼，在主機跑：grep version.toml、docker pull／create／cp 抓工具檔、docker run 起引擎 resolve／apply；不算引擎模組"),
 ("模組／最小單元", "模組 = 引擎裡一塊獨立責任的程式（紅框）；最小單元 = 模組裡可以單獨測的最小功能（白小框）"),
 ("cli", "引擎的入口模組：解析子命令與參數、負責所有詢問（-y 免問）、決定結束狀態 0／1／2，並呼叫其他模組"),
 ("version", "讀寫 version.toml／version.local.toml；apply 拿 flock；產生／重驗輸入指紋；寫 metadata 進度日誌"),
 ("registry", "查 GHCR 的 tag 與 index digest（update／add／upgrade 用；私有 registry 用 VENDOR_KIT_REGISTRY_TOKEN）；sync 不查最新版，只拉鎖定版"),
 ("materialize", "把主機掛進來的 /dist/<repo> 展開到 cache/<repo>/（先驗路徑：不越出、無 symlink）、寫印記（index digest）、verify sha256"),
 ("init／merge", "init 建初始檔或 append 幾行；merge 在 upgrade 時對每個檔跑狀態機（沒改→換、都改→三方合併）+ git merge-file；兩者都把檔案清單與逐檔決定交給 baseline"),
 ("baseline", "維護 baseline/<repo>/ 範本副本與 .vendor_kit.toml metadata（完成標記、append 行、衝突中檔案、進度日誌）"),
 ("launcher-gen", "產生 .vendor_kit/ 薄殼（entry／vendor.just、.gitignore、check.sh）、gen/tools.just 與 .stamp、根 justfile 那一行；薄殼只由 install／upgrade vendor_kit 呼叫重產，重產前比對現內容（被改過 → 1 列差異不動）；sync 只重生 tools.just"),
 ("flock", "Linux 檔案鎖：version 模組在 apply 開始時對專案目錄上鎖，避免兩個 just 同時寫"),
 ("sha256／index digest", "sha256 = 內容指紋；index digest = 多架構 image（amd64 + arm64 manifest list）的 sha256；印記與 version.toml 記它"),
 ("buildx", "docker 的多架構建置工具：同一次 build 產 amd64 + arm64，合成一個多架構 index"),
 ("GHCR／image", "GHCR = GitHub 的 image 倉庫；image = docker 打包檔：工具 image 是純資料包（FROM scratch 只 COPY），引擎 image 是會跑的程式"),
 ("recipe／mod／import", "recipe = justfile 裡一條指令；mod <ns> '檔' 把檔掛成命名空間 just <ns> …；import '檔' 把內容直接併進來（import? = 檔不在也不報錯）"),
 ("命名空間", "just <ns> <recipe> 前面的 <ns>；每個工具的 just/<ns>.just 一檔一個，gen/tools.just 一行掛一個"),
 ("暫存目錄 <tmp>", "啟動器把工具 image 的 /dist 抓到主機的暫存資料夾，再唯讀掛進引擎當 /dist/<repo>；dev 時改掛 <dir>/dist"),
 ("掛載", "docker run -v：把主機目錄接進容器；/repo = 專案目錄（可寫），/dist = 工具檔（唯讀）"),
 ("resolve／apply", "同一個引擎 image 的兩個編排用子命令：resolve 只讀、算清單與指紋；apply 拿鎖、重驗指紋、寫檔；流程見 p3 契約④"),
 ("<repo>", "工具 repo 名；.vendor_kit/cache/<repo>/ = 專案裡展開的工具檔"),
])
pages_v1_a.append(("v1p4", "架構圖 v2：主機、引擎模組、registry", p4))
