# ---- 左：目錄樹 ----
TW = {0: 200, 1: 520, 2: 490, 3: 460}
TN = {}   # id → (x, y, w, h)
def tnode(pid, level, text, style, y, tagged=False):
    x = 40 + 30 * level; w = TW[level]
    h = hvt(text, w - 12, tagged, pad=6)
    p2.extend(vt(pid, "1", style, text, x, y, w, h, tagged=tagged))
    TN[pid] = (x, y, w, h)
    return y + h + 10
def tedge(eid, par, ch):
    """樹線：從父框底部（左邊 14px 處）往下，再從左側進子框中線。"""
    px, py, pw, ph = TN[par]; cx, cy, cw, chh = TN[ch]
    tx = px + 14
    p2.append(ew(eid, par, ch, "", (round(14 / pw, 4), 1), (0, 0.5), [(tx, cy + chh / 2)]))
ty = Y + 34
p2.append(v("p2_lbl", "1", TEXT(13) + "align=left;fontStyle=1;", "3. 目錄樹（根目錄只多 .vendor_kit/；每格：用途；寫：誰產生｜改：誰可改）", 40, Y, 560, 28))
ty = tnode("t_root", 0, "<b>專案/</b>", LEAF() + "fontSize=12;fontStyle=1;", ty)
ty = tnode("t_just", 1, "<b>justfile</b> ── 使用者的 just 入口；install 只加一行 import '.vendor_kit/entry.just'（無 → 建；有 → 問／-y；已含 → 不再加）\n寫：install｜改：使用者隨意；uninstall 問後只刪與我們寫的完全相同的那行", F_USER, ty, True)
ty = tnode("t_vk", 1, "<b>.vendor_kit/</b> ── 根目錄只多這一個；薄殼 + 狀態 + 快取都在裡面\n寫：install、upgrade vendor_kit 重產薄殼（先比對現內容 == 上次產物；sync 不寫薄殼）｜改：人不改；uninstall 只刪 hash 相符的自產檔", F_GIT, ty, True)
ty = tnode("t_ver", 2, "<b>version.toml</b> ── 進 git：唯一來源。第一行 vendor_kit = \"ghcr.io/…/vendor_kit:vN@sha256:…\"；[tools] 一行一工具 tag@digest\n寫：install／add／upgrade／remove（apply 最後才寫）｜改：使用者可手改、Renovate PR 改；sync 只讀", F_GIT, ty, True)
ty = tnode("t_vl", 2, "<b>version.local.toml</b> ── 不進 git（我們的 .gitignore 擋）：工具覆寫 path:<dir>；引擎覆寫本機 image tag + image ID\n寫：dev／undev｜改：不建議手改；uninstall 一併刪；CI=1 有任何覆寫 → sync 回 1", F_NOGIT, ty, True)
ty = tnode("t_gi", 2, "<b>.gitignore</b> ── 進 git，我們自己的：cache/ gen/ version.local.toml .tmp.*（使用者的 .gitignore 除非工具 mode=append 且你同意，否則不碰）\n寫：install｜改：人不改", F_GIT, ty, True)
ty = tnode("t_entry", 2, "<b>entry.just</b> ── 進 git：mod vendor_kit 'vendor.just' + import? 'gen/tools.just'（零 set 零 recipe）\n寫：引擎 launcher-gen｜改：人不改", F_GIT, ty)
ty = tnode("t_vj", 2, "<b>vendor.just</b> ── 進 git：動詞 recipe 一行轉發 + sync 前置（set positional-arguments 只放這）\n寫：引擎 launcher-gen（install／upgrade vendor_kit）｜改：人不改", F_GIT, ty, True)
ty = tnode("t_ci", 2, "<b>ci/check.sh</b> ── 進 git：下游 CI 呼叫的契約檢查（五步，見契約⑤；隨 upgrade 更新）\n寫：引擎 launcher-gen｜改：人不改", F_GIT, ty)
ty = tnode("t_bl", 2, "<b>baseline/<repo>/</b> ── 進 git：上次合併的範本副本（三方合併的共同祖先；歷史狀態，不由 version.toml 推導）\n寫：add 建立、upgrade 推進（有衝突仍推到新版）｜改：人不改（改了合併就錯）", F_GIT, ty, True)
ty = tnode("t_meta", 2, "<b>baseline/<repo>/.vendor_kit.toml</b> ── 進 git：metadata（欄位見右）；兼作空目錄佔位\n寫：add／upgrade｜改：人不改", F_GIT, ty)
ty = tnode("t_gen", 2, "<b>gen/</b> ── 不進 git：引擎產生（sync 重生）\n寫：引擎｜改：人不改（會被覆蓋）", F_NOGIT, ty)
ty = tnode("t_tools", 3, "<b>tools.just</b> ── mod <ns> '../cache/<repo>/just/<ns>.just'，一行一命名空間（一工具可多行；零 set 零 recipe）\n寫：引擎 launcher-gen｜改：人不改", F_NOGIT, ty, True)
ty = tnode("t_gstamp", 3, "<b>.stamp</b> ── 薄殼印記：引擎 ref + 薄殼產物 hash；≠ version.toml 第一行 → sync 退出 1 提示 upgrade vendor_kit（不重寫）\n寫：引擎 launcher-gen（install／upgrade vendor_kit）｜改：人不改", F_NOGIT, ty, True)
ty = tnode("t_repo", 2, "<b>cache/<repo>/</b> ── 不進 git、使用者不可改；materialize 從主機拉好的 /dist 展開（dev 時是 symlink → <dir>/dist）\n寫：引擎 materialize｜改：不可改（verify 失敗 → 重裝並 warn）", F_NOGIT, ty, True)
ty = tnode("t_rstamp", 3, "<b>.stamp</b> ── 第一行 index digest（或 path:<dir>），之後每檔 sha256\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_files", 3, "<b>files/ …</b> ── 工具檔案（dist/files/ 全部；不含 symlink，展開時驗）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty)
ty = tnode("t_init", 3, "<b>init.toml</b> ── 初始檔清單（[[file]] src／dest／mode = \"copy\"|\"append\"）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_rjust", 3, "<b>just/<ns>.just</b> ── 工具的 just 模組，每檔一個頂層命名空間（<repo>.just 必有）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_user", 1, "<b>初始檔</b>（例 Dockerfile、setup.toml…；路徑由 init.toml 的 dest 決定）── 使用者的；進 git\n寫：add 建（已存在不納管；append 模式問後加行）、upgrade 逐檔問後換／三方合併｜改：使用者隨意；remove／uninstall 永不刪，印清單", F_USER, ty, True)
for eid, par, ch in [("te1", "t_root", "t_just"), ("te2", "t_root", "t_vk"),
                     ("te3", "t_vk", "t_ver"), ("te4", "t_vk", "t_vl"), ("te5", "t_vk", "t_gi"), ("te6", "t_vk", "t_entry"), ("te7", "t_vk", "t_vj"),
                     ("te8", "t_vk", "t_ci"), ("te9", "t_vk", "t_bl"), ("te10", "t_vk", "t_meta"), ("te11", "t_vk", "t_gen"),
                     ("te12", "t_gen", "t_tools"), ("te13", "t_gen", "t_gstamp"),
                     ("te14", "t_vk", "t_repo"), ("te15", "t_repo", "t_rstamp"), ("te16", "t_repo", "t_files"), ("te17", "t_repo", "t_init"), ("te18", "t_repo", "t_rjust"),
                     ("te19", "t_root", "t_user")]:
    tedge(eid, par, ch)
tree_end = ty
# ---- 右欄 ----
RX, RW = 620, 980
ry = Y
def rlabel(pid, label, y):
    p2.append(v(f"{pid}_l", "1", TEXT(13) + "align=left;fontStyle=1;", label, RX, y, RW, 28)); return y + 32
def rbox(pid, style, text, y, tagged=False, pad=6):
    h = hvt(text, RW, tagged, pad=pad)
    p2.extend(vt(pid, "1", style, text, RX, y, RW, h, tagged=tagged)); return y + h + 14
ry = rlabel("p2_tc", "「會碰使用者東西」只有兩列（不變量：可以建、要改先問、永不刪、永不覆蓋）", ry)
ry = tbl(p2, "p2_tc", "1", RX, ry, [("東西", 200), ("怎麼碰", 780)], [
 ["根 justfile 一行", "install：無 → 建；有 → 問「要加這一行嗎」（-y 直接加並印出）；已含 → 不再加｜uninstall：問「要刪這一行嗎」，只刪與我們寫的完全相同的行"],
 ["初始檔（init.toml 的 dest）", "add：無 → 建（印出建了什麼）；有 → 不納管、不覆蓋；append 模式問後加行｜upgrade：逐檔判斷後問（§5）｜remove／uninstall：永不刪，印清單；append 行經詢問可刪"],
], marks={(0, 0), (1, 0)})
ry = rbox("p2_not", RULE, "<b>不碰</b>：使用者的 .gitignore（除非工具以 mode=append 宣告且你同意）、.git/info/exclude（v1 的 dev 會寫 exclude，v2 拿掉）；我們要忽略的路徑全放 .vendor_kit/.gitignore", ry, True)
ry = rlabel("p2_ver", ".vendor_kit/version.toml（進 git；檔名待拍板 (1)，格式已定）", ry)
ry = rbox("p2_ver", CODE, "vendor_kit = \"ghcr.io/<org>/vendor_kit:vN@sha256:…\"      # 第一行固定：引擎 ref；啟動器 grep 讀\n"
 "[tools]\n<repo> = \"ghcr.io/<org>/<repo>-dist:<tag>@sha256:…\"       # 每工具一行 tag@digest（digest = 多架構 index digest）", ry, True)
ry = rlabel("p2_vl", ".vendor_kit/version.local.toml（不進 git；dev 寫、undev 刪；sync 讀到工具覆寫就跳過 pull／verify；CI=1 有任何覆寫 → 1）", ry)
ry = rbox("p2_vl", CODE, "<repo> = \"path:<dir>\"                 # dev <repo> -p <dir>：cache/<repo>/ 變 symlink → <dir>/dist；啟動器掛 -v <dir>/dist:/dist/<repo>:ro\n"
 "vendor_kit = \"<tag>\"                  # dev vendor_kit -i <tag>：本機引擎 image，只能 tag（docker load 後無 RepoDigests）\n"
 "vendor_kit_image_id = \"sha256:…\"      # 解析後的 image ID：同 tag 重 build 才會被發現；docker run --pull never", ry, True)
ry = rlabel("p2_st", ".vendor_kit/cache/<repo>/.stamp 印記（materialize 寫；verify 逐檔比 sha256）", ry)
ry = rbox("p2_st", CODE, "sha256:…                                      # 第一行：多架構 index digest；dev 時為 path:<dir>\n"
 "<sha256>  files/…                              # 之後每檔一行 sha256\n<sha256>  init.toml\n<sha256>  just/<ns>.just", ry, True)
ry = rlabel("p2_gs", ".vendor_kit/gen/.stamp 薄殼印記（launcher-gen 寫；sync 比對）", ry)
ry = rbox("p2_gs", CODE, "ghcr.io/<org>/vendor_kit:vN@sha256:…          # 第一行：產生薄殼的引擎 ref（引擎覆寫時為 <tag>）\n"
 "<sha256>  entry.just                           # 之後：每個自產 tracked 薄殼檔的產物 hash（upgrade vendor_kit／install 重產前比對用）\n<sha256>  vendor.just\n<sha256>  ci/check.sh\n<sha256>  .gitignore", ry, True)
ry = rlabel("p2_mt", "baseline/<repo>/.vendor_kit.toml metadata（add／upgrade 寫）", ry)
ry = tbl(p2, "p2_mt", "1", RX, ry, [("欄位", 180), ("內容", 380), ("誰讀它、做什麼", 420)], [
 ["來源 ref@digest", "這份 baseline 來自哪個工具 image（tag@index digest）", "追溯；upgrade 判斷 baseline 是哪一版"],
 ["最後合併版本", "最後一次逐檔合併時的工具版本", "sync：≠ version.toml → 本機 warn 提示 upgrade、CI 下 1；upgrade：≠ version.toml → 先補「待合併」到該版然後停"],
 ["完成標記", "add 走完 materialize → 初始檔 → baseline 才寫", "sync：缺 → 1「請 just vendor_kit add <repo>」；add：已接入且完成 → 0 無變更"],
 ["append 過的行", "每個 append 模式檔：我們加進去的那幾行原文（各工具分開記）", "upgrade：找到原文相同的行才問後替換，找不到不動並印新內容；remove：問後只刪原文相同的"],
 ["衝突中檔案", "upgrade 回 2 時留 <<<<<<< vendor_kit:baseline 標記的檔名清單", "upgrade：仍含我們的標籤 → 2 停（檔案失蹤不算已解）；解完重跑才清空；sync／check.sh 提示"],
 ["進度日誌", "state=in-progress：apply 逐檔原子替換時列已完成／未完成", "任何動詞開始前：有未完成 → 先恢復再繼續；失敗時明列"],
 ["（檔案本身）", "兼作 baseline/<repo>/ 空目錄佔位（git 不追蹤空目錄）", "—"],
], marks={(3, 0), (4, 0), (5, 0)})
ry += 14
ry = rbox("p2_rule", RULE, "<b>規則摘要</b>\n・version.toml 是唯一來源：sync 每次 just 拿它對印記，不一致就 materialize（只拉鎖定版）；apply 拿鎖後先重驗 resolve 給的輸入指紋，不同 → 1「請重跑」\n"
 "・自動化（sync）只碰不進 git 的東西（cache/、gen/）：不碰使用者的檔、不寫薄殼；薄殼 ≠ version.toml 第一行引擎 → 1 提示 upgrade vendor_kit；薄殼重產只由 upgrade vendor_kit／install 做，先比對現內容 == gen/.stamp 的產物 hash（被改過 → 1 列差異不動）\n"
 "・baseline 是上次合併的歷史狀態，不由 version.toml 推導（待合併時 version 已 B、baseline 仍 A）\n"
 "・進 git 的只有：justfile 那行、.vendor_kit/（不含 cache/、gen/、version.local.toml）、初始檔；人只改：justfile、初始檔、version.toml（手動升版）", ry, True)
ry = rlabel("p2_mx", "動詞 × 檔案（寫 = 產生／覆蓋；刪 = 移除；— = 不碰；依 §2／§5／v2.2）── 表 A：進 git 的宣告與薄殼", ry)
MXA = [("動詞", 120), ("version.toml", 215), ("version.local.toml", 215), ("根 justfile", 215), ("薄殼（tracked）", 215)]
ry = tbl(p2, "p2_mx", "1", RX, ry, MXA, [
 ["install", "寫第一行（引擎 ref）", "—", "無 → 建；有 → 問加一行；已含 → 不再加", "用引擎重寫（先比對現內容）"],
 ["uninstall", "刪", "刪", "問後只刪相同的行", "只刪 hash 相符的自產檔"],
 ["add", "最後加一行", "—", "—", "—"],
 ["remove", "刪一行", "—", "—", "—"],
 ["upgrade", "最後改一行", "—", "—", "upgrade vendor_kit：比對後重產"],
 ["dev／undev", "—", "加行／刪行", "—", "—"],
 ["sync", "—（只讀）", "—（只讀；CI=1 有覆寫 → 1）", "—", "不寫（不符 → 1 提示 upgrade vendor_kit）"],
 ["update", "—", "—", "—", "—"],
], marks={(0, 0), (1, 0), (6, 0), (6, 4)})
ry += 14
ry = rlabel("p2_my", "表 B：baseline／gen／cache／初始檔", ry)
MXB = [("動詞", 120), ("baseline/ + metadata", 215), ("gen/", 215), ("cache/<repo>/", 215), ("初始檔", 215)]
ry = tbl(p2, "p2_my", "1", RX, ry, MXB, [
 ["install", "建空目錄", "重生", "—", "—"],
 ["uninstall", "刪", "刪", "刪", "永不刪；append 行經詢問可刪"],
 ["add", "建 + metadata（完成標記、append 行）", "重生", "materialize", "無 → 建；有 → 不納管；append 問後加"],
 ["remove", "刪", "刪該工具的 mod 行", "刪", "永不刪；append 行問後刪"],
 ["upgrade", "推進（衝突仍推）+ 進度日誌", "重生", "materialize", "逐檔問：換／三方合併／append 替換"],
 ["dev／undev", "—", "—", "symlink／重新 materialize", "—"],
 ["sync", "—（只讀完成標記、落後）", "重生", "materialize／重裝（只拉鎖定版）", "—"],
 ["update", "—", "—", "—", "—"],
], marks={(1, 4), (2, 4), (3, 2), (3, 4), (4, 1), (4, 4), (5, 3), (6, 0)})
ry += 14
ry = rbox("p2_reno", RULE, "<b>version.toml 怎麼被讀</b>\n・啟動器（sh）：grep 第一行 → 引擎 ref（version.local.toml 覆寫優先）；不解析 toml（resolve 的 stdout 才是它的輸入）\n"
 "・引擎 version 模組：toml 讀寫 + version.local.toml 覆寫；flock；apply 最後才寫 version.toml\n"
 "・Renovate：regex manager + docker datasource，抓每行的 currentValue（tag）+ currentDigest，PR 只改那一行", ry)
Y = max(tree_end, ry) + 10
p2 += lgd("p2", 40, Y, ["v2git", "v2no", "v2usr", "v2code"], "樹線 = 目錄包含（上 → 下）\n每格右上角綠標籤 = v2 改")
p2 += lgd("p2b", 40, Y + 60, ["v2tag", "pendn", "ruleb", "tblh"], "本頁沒有分組框\n細節與流程見流程頁")
p2 += terms("p2", 40, Y + 160, [
 ("唯一來源", "version.toml：專案「該裝哪版」只看它；印記、gen/、薄殼由它推導；baseline 是上次合併的歷史狀態，不由它推導"),
 ("version.local.toml", "同目錄的 dev 覆寫（不進 git）：<repo> = \"path:<dir>\" 或 vendor_kit = \"<本機 image tag>\" + image ID；啟動器與引擎讀到就用它"),
 ("印記 .stamp", "materialize 寫在 cache/<repo>/ 的檔：第一行 = 裝的是哪個 index digest（或 path:<dir>），其餘每檔 sha256；verify 逐檔比"),
 ("index digest", "多架構 image 的 manifest list 的 sha256（amd64、arm64 共用一個）；version.toml 與印記都記它，不記單平台 digest"),
 ("薄殼印記 gen/.stamp", "launcher-gen 記「gen/ 與薄殼是哪個引擎產生的」+ 每個薄殼檔的產物 hash；≠ version.toml 第一行 → sync 退出 1 提示 upgrade vendor_kit；重產時拿它比對"),
 ("metadata .vendor_kit.toml", "baseline/<repo>/ 裡的小檔：來源 ref@digest、最後合併版本、完成標記、append 過的行、衝突中檔案、進度日誌；兼作空目錄佔位"),
 ("薄殼", ".vendor_kit/ 進 git 的最小啟動器：entry.just、vendor.just、.gitignore、ci/check.sh；只轉發、不做事"),
 ("gen/", "引擎產生的檔（tools.just 由 sync 重生；.stamp 由 launcher-gen 寫）；不進 git；.stamp 缺或不符 → sync 提示 upgrade vendor_kit"),
 ("cache/<repo>/", "工具 image 的 /dist 展開副本（v1 叫 .<repo>/，v2 收進 .vendor_kit/）；不進 git、不可改；dev 時是 symlink"),
 ("materialize", "引擎內部步驟：把主機拉好的 /dist 展開到 cache/<repo>/ → 寫印記 → verify；add／upgrade／undev／sync 都會呼叫"),
 ("sync", "每次 just 的自動前置（v1 叫 ensure）：只寫 cache/、gen/，不寫薄殼（不符 → 1 提示 upgrade vendor_kit）；CI=1 frozen；範圍預設全部工具；無變更時走快路徑"),
 ("frozen", "CI=1 的 sync：只准寫 cache/、gen/；不查最新版；薄殼不符、baseline 落後、未完成接入、任何 local 覆寫 → 1"),
 ("append 模式", "init.toml 的 mode=\"append\"：檔不存在 → 建；存在 → add 問後把幾行加進使用者的檔（原文記在 metadata）；upgrade／remove 只動原文相同的行"),
 ("初始檔", "工具 init.toml 列出、add 時建到專案的檔（例 Dockerfile）；歸使用者，進 git；已存在就不納管；upgrade 逐檔問"),
 ("tag@digest", "image 的版本標籤 + index digest；tag 給人看、digest 鎖內容"),
 ("sha256", "內容的指紋（雜湊）；digest、印記、薄殼產物 hash 都是 sha256"),
 ("image ID", "docker 本機給每個 image 內容的 sha256；同一個 tag 重 build 後 ID 會變，所以引擎覆寫連 ID 一起記"),
 ("RepoDigests", "docker 記錄 image 從哪個 registry 以哪個 digest 拉來的欄位；docker load 的 image 沒有，所以本機引擎只能用 tag"),
 ("symlink", "指向另一個路徑的捷徑檔；dev 時 cache/<repo>/ 指向 <dir>/dist；dist/files/ 裡不准有"),
 ("命名空間／mod", "just 的 mod <ns> '檔' 把一個 .just 檔掛成 just <ns> … 可用的一組指令；tools.just 一行一個"),
 ("Renovate", "GitHub 機器人（下游自選）：GHCR 有新版就開 PR 改 version.toml 一行；人在 PR 分支補完合併、CI 綠後 merge"),
 ("regex manager／docker datasource", "Renovate 的兩個設定：regex manager 用正規表示式在 version.toml 找每行的 tag 與 digest；docker datasource 去 registry 查有沒有新 tag"),
 ("currentValue／currentDigest", "Renovate regex 抓到的兩個值：currentValue = 現在的 tag、currentDigest = 現在的 sha256；PR 就是把它們換成新的"),
 ("flock", "Linux 檔案鎖：引擎 apply 對專案目錄上鎖，避免兩個 just 同時寫；等 60 秒逾時 → 失敗"),
 ("輸入指紋", "resolve 輸出的「它看到的 version.toml、metadata、要動的使用者檔 hash + 鎖定 digest」；apply 拿鎖後重驗，不同 → 1 請重跑"),
 ("GHCR／image／CI", "GHCR = GitHub 的 image 倉庫；image = docker 打包檔（工具 image 只是資料包）；CI = push 後自動跑的檢查"),
])
pages_v1_a.append(("v1p2", "契約 v2：專案裡的檔與 version.toml", p2))

# ================= P3 v1p3：契約③ 工具 repo、④ 啟動器↔引擎、⑤ CI =================
p3 = [v("title", "1", TITLE, "契約③ 工具 repo 要交的、契約④ 啟動器 ↔ 引擎、契約⑤ CI ── v2.2 定案", 40, 20, 860, 34),
      v("p3_num", "1", TEXT(12) + "align=left;", NUM_T, 40, 56, 860, 26)]
c, Y = pend("p3", 920, 12, 680,
 "(5) upgrade／remove 對 append 行的「原文比對」遇到 CRLF／尾端空白怎麼判定 → 建議：第一版嚴格相同（byte 相同才算找到；"
 "找不到 → 不動、印新內容讓人自己補），之後有需求再加正規化；check.sh --dist 順便擋 init.toml 來源檔含 CRLF\n"
 "[待] dist/files/ 是否允許 symlink → 建議：第一版禁止（check.sh --dist 擋；引擎展開時也驗）")
p3.append(c); Y = max(Y + 16, 96)
# ---- ③ 工具 repo 要交的 ----
DIST_T = ("<repo>/                  # 工具 repo\n"
 "├─ dist/\n"
 "│  ├─ files/…            # 全部出貨（原樣展開）\n"
 "│  ├─ init.toml          # 初始檔清單 [[file]] src／dest／mode\n"
 "│  └─ just/<ns>.just     # 每檔一個命名空間\n"
 "└─ Dockerfile.dist       # FROM scratch + COPY dist/ /dist/")
DW = 420; RXd = 460; R1W = (1540 - RXd - 3 * 16) // 4; R2W = (1540 - RXd - 2 * 16) // 3
D_ROW1 = [
 ("d4_1", LT12, "<b>dist/files/</b>\n全部出貨；materialize 原樣展開到 .vendor_kit/cache/<repo>/files/；symlink 第一版禁止（待拍板，見右上）", False),
 ("d4_2", LT12, "<b>dist/init.toml</b>\n[[file]] src／dest [mode=\"copy\"|\"append\"]，dest 相對專案根；禁止用 copy 指向根 .gitignore／.dockerignore／.editorconfig → 要用 append", True),
 ("d4_3", LT12, "<b>dist/just/<ns>.just</b>\n每檔一個頂層命名空間，數量工具自決，<repo>.just 必須存在；跨工具撞名 → add 報錯；recipe 用 cd \"{{justfile_directory()}}\" 回專案根", True),
 ("d4_4", LT12, "<b>Dockerfile.dist</b>\nFROM scratch + COPY dist/ /dist/；沒有程式、不 FROM vendor_kit", False),
]
D_ROW2 = [
 ("d4_5", PT12, "<b>image ghcr.io/<org>/<repo>-dist:<tag></b>\n多架構 amd64 + arm64（同一次 buildx、COPY-only；CI 驗兩平台內容一致）；version.toml 與印記記 index digest（#26）；公開／私有工具自決（Q7）", True),
 ("d4_6", PT12, "<b>引擎 image ghcr.io/<org>/vendor_kit:vN</b>\n公開；多架構 amd64 + arm64；也出 docker save tar 離線包（#27，bootstrap --local 吃）", True),
 ("d4_7", LT12, "<b>工具 repo 的 CI</b>\n跑 vendor_kit 出貨的 check.sh --dist：dist 佈局、init.toml 合法（mode 只能 copy|append）、image 可展開、兩平台內容一致", False),
]
DEST_T = ("<b>dest 規則（引擎在任何寫入前驗，不只供應端 lint）</b>：dest 正規化後不得越出 repo、不得指向 .vendor_kit/；"
 "兩工具同 dest：copy/copy、copy/append → add 拒絕；append/append → 允許，各工具的行分開記錄，重疊或歸屬不明 → 拒絕；add 與 upgrade 都檢查")
dh = hv(DIST_T, DW, pad=6)
r1h = max(hvt(t, R1W, tg) for _, _, t, tg in D_ROW1); r2h = max(hvt(t, R2W, tg) for _, _, t, tg in D_ROW2)
desth = hvt(DEST_T, 1520, True)
l4h = 50 + max(dh, r1h + 16 + r2h) + 16 + desth + 20
p3.append(v("p3L4", "1", SW(NEUTRAL), "契約③ 工具 repo 要交的（供應側；改了要升 major 並公告）", 40, Y, 1560, l4h))
p3.append(v("p3_dist", "p3L4", CODE, DIST_T, 20, 50, DW, dh))
x = RXd
for pid, st, t, tg in D_ROW1:
    p3.extend(vt(pid, "p3L4", st, t, x, 50, R1W, r1h, tagged=tg)); x += R1W + 16
x = RXd
for pid, st, t, tg in D_ROW2:
    p3.extend(vt(pid, "p3L4", st, t, x, 50 + r1h + 16, R2W, r2h, tagged=tg)); x += R2W + 16
p3.extend(vt("p3_dest", "p3L4", RULE, DEST_T, 20, 50 + max(dh, r1h + 16 + r2h) + 16, 1520, desth, tagged=True))
Y += l4h + 20
# ---- ④ 啟動器 ↔ 引擎 ----
S1 = "① grep version.toml 第一行\n→ 引擎 ref（version.local.toml 覆寫優先）"
S2 = ("② docker run 引擎 resolve <動詞>\n讀 version.toml／local、查 registry（frozen 不查）→ 算出要拉哪些 image@digest；"
      "stdout 第一行 vk-resolve/1，之後一行一項 + 輸入指紋（固定欄位、安全字元）；診斷走 stderr；不寫檔")
S3 = ("③ 主機 docker（每個要拉的 image）\ndocker pull（已有則略）→ docker create <img> /x → docker cp c:/dist/. <tmp>/<repo>/ → docker rm"
      "（不帶 --platform，daemon 挑原生；啟動器不 eval）")
S4 = ("④ docker run … -v <tmp>:/dist:ro 引擎 apply <動詞>\n拿 flock（version 模組）→ 重驗指紋（不同 → 1「請重跑」）→ 所有合併在暫存完成 → 逐檔詢問（-y 免問）"
      "→ 逐檔原子替換 + metadata 進度日誌 → version.toml 最後寫")
S5 = "結束狀態\n0／1／2 回到 just"
ERR = "否：不重寫薄殼 → 退出 1\n印「vendor_kit 引擎 vX → vY 與薄殼不符，請 just vendor_kit upgrade vendor_kit」\n（重產薄殼 + gen 只由 upgrade vendor_kit／install 做，先比對）"
DRY = "<b>-n／--dry-run</b>：② ③ 照跑（要拉的 image 一樣拉、展開到暫存），④ 改跑 apply --dry-run 唯讀預覽會建／會問哪些檔 → 0；CI 無 -y 又需改 tracked 檔 → 1（version.toml 不動）"
SUB = ("<b>引擎子命令</b>：install | uninstall | add | remove | update | upgrade | dev | undev | sync | help；啟動器編排用：resolve／apply；內部步驟 materialize | verify | merge（不對外）\n"
       "結束狀態 0 成功／1 失敗（不動 version.toml；含「請 upgrade vendor_kit」與自身升級後「請 commit 並再跑原指令」）／2 衝突（git merge-file 衝突數 → 2），或 update --exit-code 有新版；stdout 人類可讀，診斷 stderr")
LOCK = "<b>專案目錄 flock</b>：鎖在引擎 version 模組（apply 一開始拿），啟動器不鎖；等 60 秒逾時就失敗；VENDOR_KIT_NO_LOCK=1 跳過。失敗時進度日誌明列已完成／未完成，下次任何動詞先恢復"
LSH = ("<b>啟動器 = POSIX sh</b>：只用 docker pull／create／cp／run／rm + grep／sed；不裝 python、不解析 TOML（resolve 的 stdout 就是它的輸入，不 eval）；"
       "主機只需 docker ≥ 19.03（多架構 index）+ just ≥ 1.33 + sh；docker run 加 -u uid:gid（rootless docker 偵測到就不加）、只有互動才 -it（CI／-y 不加 -t）；"
       "引擎覆寫 vendor_kit=<tag> 時 docker run --pull never；工具 path 覆寫改掛 -v <dir>/dist:/dist/<repo>:ro 並驗 dist/init.toml 存在")
ENS = ("<b>vendor.just 每個動詞 recipe</b>：先跑 sync 前置（同樣走 ②③④；無變更時只跑一次檢查的快路徑，不起第二個容器；CI=1 自動 frozen），再 verb *args 一行轉發給啟動器。"
       "會動 image 的動詞（add／upgrade／sync）走 ②③④；其他動詞沒有東西要拉，不經 ③。私有 registry 查最新 tag：引擎需 VENDOR_KIT_REGISTRY_TOKEN，或改用 -t 指定版本（主機 docker pull 走主機認證）")
ws = [("s1", L12, S1, 170), ("d1", RHOMBUS + "fontSize=12;", "gen/.stamp\n= 引擎 ref？", 150), ("s2", L12, S2, 290), ("s3", L12, S3, 300), ("s4", L12, S4, 310), ("s5", P12, S5, 140)]
hs = {pid: (80 if pid == "d1" else hv(t, w)) for pid, _, t, w in ws}
rowc = 50 + max(hs.values()) / 2
r2y = rowc + max(hs.values()) / 2 + 40
eh = hv(ERR, 300); dryh = hvt(DRY, 300, True); subh = hvt(SUB, 410, True); lockh = hvt(LOCK, 309, True)
r2h = max(eh, dryh, subh, lockh)
r3y = r2y + r2h + 20
r3h = max(hvt(LSH, 740, True), hvt(ENS, 750, True))
l2h = r3y + r3h + 20
p3.append(v("p3L2", "1", SW(NEUTRAL), "契約④ 啟動器 ↔ 引擎（兩段執行：引擎 resolve → 主機 docker → 引擎 apply；主機只需要 docker + sh + just）", 40, Y, 1560, l2h))
x = 30; prev = None; xs = {}
for pid, st, t, w in ws:
