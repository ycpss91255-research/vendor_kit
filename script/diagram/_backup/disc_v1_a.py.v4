 "v4host":(HOST, "紅底紅粗框：啟動器（主機側薄殼）", 240, 40, 10),
 "v4hgrp":(GRP, "淺灰底：主機分組", 150, 40, 10),
 "v4pgrp":(refill(L12, GREEN), "綠底：專案目錄分組", 160, 40, 10),
 "v4frame":(FRAME + "fontSize=12;", "點線框：init／merge 共用箭頭", 200, 40, 10),
})
def lgd(prefix, x, y, keys, note):
    c = legend(prefix, x, y, keys, note)
    if "v2tag" in keys:
        i = keys.index("v2tag"); cx = x + sum(LEGEND_ITEMS[k][2] + 20 for k in keys[:i])
        c.append(tag(f"{prefix}_lg{i}", "1", cx, y + 10, LEGEND_ITEMS["v2tag"][2]))
    return c
