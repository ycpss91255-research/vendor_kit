def uw(s):
    import unicodedata
    return sum(10 if unicodedata.east_asian_width(ch) in ("W", "F") else 6 for ch in s) + 18
def units(prefix, x, y, w, h, labels):
    out = []; ux = x + 6
    for i, s in enumerate(labels):
        out.append(v(f"{prefix}_u{i}", "p4E", UNIT, s, ux, y + h - 32, uw(s), 24)); ux += uw(s) + 6
    assert ux - 6 <= x + w, (prefix, ux, x + w)
    return out
