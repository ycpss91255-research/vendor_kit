b.box("b18r", P, 7, v2(RULE), fl("多工具彙總（Q27）：不帶 repo 的 upgrade 做得完的做完，最後回最需要處理的碼：失敗 1 > 衝突 2 > 有新版 2 > 0；訊息全列；待合併補完後另有新版 → 印「已補齊 <repo> 至 vB；另有新版 vX，再跑一次可升」"), 280)
footer(b, F, 8, [("b17", v2(G12), "0：印摘要 → commit"), ("b18", O12, fl("2：印衝突檔名（含解析失敗的檔；解完再跑直到乾淨；baseline 已在目標版）")), ("b16x", v2(R12), "1：寫入失敗，明列已完成／未完成")], lpw=115)
