pullseg(b, 1, ("c9a", "c9p", "c9g"), ("docker image inspect：本機有？", "無：docker pull", "<repo>-dist@digest\n（鎖定的那一版）"), ("c9b", v2(W12), "docker create <image> /x"))
b.box("c9c", L, 4, v2(W12), "docker cp c:/dist/. <tmp>/<repo>/（主機暫存）", 280)
b.box("c9d", L, 5, v2(W12), "docker rm 該容器", 280)
b.box("c10", L, 6, v2(W12), fl("docker run … -v <tmp>:/dist:ro\n<引擎> apply add <repo>（--dry-run 原樣轉發）"), 280)
b.box("c10e", E, 6, v2(SUB), EST_A, 400)   # apply 容器（v2.14-2）
b.box("c11a", E, 7, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("c11b", E, 8, v2(SUB), "重驗 resolve 的輸入指紋", 400)
b.box("c12", E, 9, v2(D12), fl("相同 → init.toml 的 dest 全部合法？（任何寫入前檢查）"), 400, ax="l")
b.box("c12r", P, 9, v2(RULE), fl("dest 規則（v2.2 E）：兩工具 copy/copy、copy/append 同 dest → 拒絕；append/append 允許（各工具的行分開記；重疊或歸屬不明 → 拒絕）；正規化後不得越出 repo、不得指向 .vendor_kit/；dist 含 symlink → 拒絕"), 360)
b.box("c12b", E, 10, v2(D12), fl("just/<ns>.just 的 <ns> 撞名？（其他工具／根 justfile recipe／保留名 vendor_kit）"), 400, ax="l")
b.box("c12br", P, 10, v2(RULE), fl("命名空間撞名（v2.5 §5）：<ns> 與 (a) 其他已接工具 (b) 根 justfile 既有 recipe／module (c) 保留名 vendor_kit 相同 → 1 拒絕（撞名整個 just 會掛）"), 360)
b.box("c14", E, 11, v2(D12), "CI 為真（frozen）且需改 tracked 檔？", 340, ax=30)
b.box("c13", E, 12, D12, "--dry-run？", 240, ax=80)
b.box("c13z", E, 13, LBL, "否 ↓ 續「add（2）」頁：apply 寫入段", 300, 24, ax="l", minh=24)
footer(b, F, 14, [
 ("c13y", v2(G12), "0：唯讀預覽（印會建／會問哪些檔；讀 /dist/<repo>）"),
 ("c11x", v2(O12), "1：指紋不同「請重跑」"),
 ("c12x", v2(O12), fl("1：dest 不合法（請修 init.toml／dest）")),
 ("c12bx", v2(O12), fl("1：命名空間撞名（請改名／移除撞名者）")),
 ("c14x", v2(O12), fl("1：印需改清單（frozen；請在本機執行後 commit 並 push）")),
 ("c9px", v2(R12), fl("1 + 6-24／6-31：pull 失敗／逾時（離線可用 --local <tar>）")),
])
b.D("ce13e", "c9e", "c9a", "", 0.5, 0.5)
b.D("ce12c", "c9b", "c9c"); b.D("ce12d", "c9c", "c9d"); b.D("ce13d", "c9d", "c10")
b.H("ce14", "c10", "c10e"); b.D("ce14e", "c10e", "c11a"); b.D("ce14b", "c11a", "c11b")
