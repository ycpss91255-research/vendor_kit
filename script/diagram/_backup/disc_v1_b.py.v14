b.D("we2s", "w2s2", "w1b", "", 0.2, 0.5); b.H("we2a", "w1b", "w1be"); b.D("we2ae", "w1be", "w2a"); b.D("we2b", "w2a", "w2b"); b.D("we2l", "w2b", "w2l"); b.H("we2lf", "w2l", "w2lf", "寫")
