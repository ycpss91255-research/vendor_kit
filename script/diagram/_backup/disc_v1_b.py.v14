b.box("cr", P, 6, v2(RULE), fl("復原（v2.2 C、v2.5 §3）：進度日誌第一個寫入前建、最後一步刪；合併全在暫存完成 → 逐檔原子替換；失敗 → 1 明列已完成／未完成，下次可寫動詞先恢復"), 360)
b.box("c18", E, 7, v2(D12), "strategy = append？", 200, ax="l")
b.box("c19", E, 7, SUB, fl("否：不納管（state=unmanaged）、不覆蓋，印「已存在，範本在 cache」"), 180, ax="r")
b.box("c20q", E, 8, v2(D12), "問「要在 X 加這幾行嗎」？（-y 免問）", 320, ax="l")   # 第 9 列留空：菱形到 c20／c20n 線長 40，「是」「否」標籤不壓框緣（r8）
b.box("c20n", E, 10, v2(SUB), fl("否：不寫；state=unmanaged 只記 declined_hash"), 150, ax="l")
b.box("c20", E, 10, SUB, fl("是：append 那幾行（state=appended；實際插入的行之後記進 metadata）"), 200, ax=180)   # 離 x=990 匯流排 30（r12 ce29）
b.box("c20l", E, 11, v2(D12), "還有下一個 [[file]]？", 320, ax=40)
b.box("c21", E, 12, SUB, "否：寫 baseline/<repo>/（範本副本）", 400)
b.box("c21f", P, 12, F12, "＋baseline/<repo>/（進 git）", 360)
b.box("c21b", E, 13, v2(SUB), fl("寫 metadata：來源 ref@digest、最後合併版本（離線 tar 另記 local_image_id）"), 400)
b.box("c21bf", P, 13, F12, "＋baseline/<repo>/.vendor_kit.toml（進 git）", 360)
b.box("c21c", E, 14, v2(SUB), fl("寫 metadata：每個 dest 的 state（managed／appended／unmanaged；新檔被拒才 declined）、declined_hash、append 行（lines）"), 400)
b.box("c21cf", P, 14, F12, ".vendor_kit.toml（[[file]] 各 dest 的 state／declined_hash／lines）", 360)
b.box("c21d", E, 15, v2(SUB), "寫 metadata：完成標記（complete）", 400)
b.box("c21df", P, 15, F12, ".vendor_kit.toml（complete = true）", 360)
b.box("c22", E, 16, v2(SUB), fl("重生 gen/tools.just（每個 <ns>.just 一行 mod?；一工具可多行）"), 400)
b.box("c22f", P, 16, F12, "gen/tools.just（不進 git；mod? 行）", 360)
b.box("c23", E, 17, v2(SUB), fl("最後寫 version.toml [tools]：<repo> = \"…:<tag>@sha256:…\""), 400)
b.box("c23f", P, 17, F12, "＋version.toml [tools] 行（進 git）", 360)
b.box("c23b", E, 18, v2(SUB), "成功：刪進度日誌（最後一步）", 400)
footer(b, F, 19, [("c24", G12, "0：印摘要，提示 git add"), ("c23x", v2(R12), "1：寫入失敗，明列已完成／未完成")])
b.D("ce23a", "c13c", "c15a"); b.H("ce23b", "c15a", "c15af", "寫"); b.D("ce23c", "c15a", "c15"); b.D("ce23cc", "c15", "c15c"); b.H("ce23", "c15c", "c15f", "寫")
