footer_edges(F, [("ce12px", "c9p", "失敗", "l"), ("ce15", "c11b", "不同", "l"), ("ce17", "c12", "否", "l"), ("ce18x", "c12b", "是", "l"), ("ce19", "c14", "是", "l"), ("ce21", "c13", "是", "l")],
             [("c13y",)*3, ("c11x",)*3, ("c12x",)*3, ("c12bx",)*3, ("c14x",)*3, ("c9px",)*3])
