b.box("c2a", E, 6, v2(SUB), "resolve（不寫任何檔）：讀 version.toml", 400)
b.box("c4", E, 7, D12, "已接入 <repo>？", 310, ax="l")   # r12：已接入且完成 → 0 先於查 registry（c2pq 順序）
b.box("c5", E, 8, D12, "metadata 有完成標記？", 310, ax="l")
b.box("c5t", E, 9, D12, "@<tag> 與鎖定不同？", 220, ax=45)
b.box("c8", E, 9, SUB, fl("否：續作，只做缺的步驟（不補刻意刪的檔）"), 120, ax="r")
b.box("c2b", E, 10, v2(SUB), fl("查 tag（預設最新正式版／@<tag>）與 index digest（--source 改來源）"), 400)
b.box("c3", G, 10, IMG, "ghcr.io/<org>/<repo>-dist\n（工具 image；多架構 index digest）", 220)
b.box("c2pq", E, 11, v2(D12), fl("私有 image 且未指定 @<tag> 且無憑證？"), 310, ax="l")   # v2.9 §2
b.box("c2c", E, 12, v2(SUB), fl("否：產生執行計畫（要拉的 image@digest、mount、apply 與否）"), 400)
b.box("c2d", E, 13, v2(SUB), fl("產生輸入指紋（version.toml、metadata、要動的使用者檔 hash、鎖定 digest）"), 400)   # r12：拆兩格
b.box("c2d2", E, 14, v2(SUB), fl("stdout vk-resolve/1：計畫＋指紋回啟動器"), 400)
b.box("c9z", E, 15, LBL, "↓ 續「add（1′）」頁：啟動器 docker inspect → pull → create → cp → rm → apply 前置", 400, 24, ax="l", minh=24)
footer(b, F, 16, [
 ("c6", G12, "0：已接入且完成，無變更"),
 ("c2px", v2(O12), fl("1 + 6-3：私有 image，請指定 @<tag> 或提供 registry 憑證")),
