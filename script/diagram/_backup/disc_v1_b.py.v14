b.box("s12h", L, 3, v2(W12), fl("啟動器：apply 後再 grep version.toml 第一行（與 apply 前比；不從 stdout 讀）"), 280)   # r12：s12h 拆三格
b.box("s12hq", L, 4, v2(D12), fl("第一行變了且 == 計畫的 engine？"), 280)
