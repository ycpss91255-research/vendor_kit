b.D("de8", "d2c", "d6a", "是", 0.5, 0.5); b.D("de8b", "d6a", "d6"); b.H("de9", "d6", "d6f", "寫"); b.D("de10", "d6", "d7"); b.H("de11", "d7", "d7f", "寫")
