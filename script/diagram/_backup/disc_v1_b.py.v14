b.box("w2g", E, 11, v2(SUB), "是／已刪：刪進度日誌（最後一步）", 400)
b.box("wb", L, 12, LBL, "═══ 下次 just（改用 version.toml 的引擎；啟動器先比對 gen/.stamp 再起容器）═══", 560, 24, ax="l", minh=24)
b.box("w4", U, 13, G12, "下次打任何 just", 220)
b.box("w5a", L, 13, v2(W12), "（已寫 launcher_start）grep version.toml 第一行取引擎 ref（local 已無覆寫）", 280)
b.box("w6", L, 14, v2(D12), "gen/.stamp 的引擎 ref == 第一行？", 270)
pullseg(b, 15, ("w5b", "w5p", "w5g"), ("是 → docker image inspect：本機有？", "無：docker pull 該引擎", "vendor_kit:vN（version.toml 的引擎）"), ("w5c", v2(W12), "docker run 該引擎 resolve sync"))
b.box("w5ce", E, 17, v2(SUB), EST_R, 400)   # r12：下次 just 的 resolve 容器 engine_start（w5c）
b.box("w9", E, 18, LBL, "→ 正常跑（「sync（1′）」頁）", 400, 24, ax="l", minh=24)
footer(b, F, 19, [("w2z", v2(G12), "0：本次結束（下次 just 用 version.toml 的引擎）"), ("w3", G12, "0：未啟用（提示）"), ("w2bx", v2(O12), "1：指紋不同「請重跑」"), ("w7", v2(O12), fl("1 + 6-1：vendor_kit 已更新，請執行 just vendor_kit upgrade vendor_kit（不重寫）")), ("w2x", v2(R12), "1：失敗 → 保留可恢復狀態（下次可寫動詞先恢復）"), ("w5px", v2(R12), fl("1 + 6-24／6-31：pull 失敗／逾時"))])   # r12：w5p 加紅出口
