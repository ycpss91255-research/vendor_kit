footer(b, F, 11, [("d8", v2(G12), "0：之後每次 just 用 <dir>"), ("d1x", v2(O12), "1：<dir>/dist/init.toml 不存在"), ("d3a", O12, "1：CI 拒絕 dev（請在本機執行）"), ("d3b", O12, "1：未接入，請先 add <repo>"), ("d3c", O12, "1：dist/ 或 init.toml 不合法")])
