b.D("me12m", "m9s", "m9m", al=True)
b.D("me13w", "m9m", "m9w", "否", al=True); b.RD("me13d", "m9m", "m9d", "是")
b.H("me13f", "m9d", "m9f", "寫")
b.D("me14w", "m9w", "m9l2", al=True); b.D("me14d", "m9d", "m9l2", "", 0.5, 0.5)
b.LL("me14y", "m9l2", "m9m", "是", busx=600); b.D("me14n", "m9l2", "m10a", "否", 0.5, 0.5)
b.H("me15a", "m10a", "m10af", "刪"); b.D("me15b", "m10a", "m10b"); b.H("me15bf", "m10b", "m10bf", "刪"); b.D("me15c", "m10b", "m10c"); b.H("me15cf", "m10c", "m10cf", "刪")
b.D("me15d", "m10c", "m10d"); b.H("me15df", "m10d", "m10df", "寫"); b.D("me15e", "m10d", "m10e"); b.H("me15ef", "m10e", "m10ef", "刪")
b.D("me16", "m10e", "m10g", "", 0.6, 0.6, al=True)
b.close()
footer_edges(F, [("me16x", "m10e", "失敗（任一步）", "l")], [("m11",)*3, ("m10x",)*3], main=("me17", "m10g", "", 0.5))
foot(p8b2, "p8b2", F.y, _t8b("保護清單", "dev 覆寫", "CI 為真"), ALL - {"inv", "tree", "pend", "rule"} | {"entry"})
pages_v1_b.append(("v1p8bccc", "流程 v2：remove（2）寫入段", p8b2))

# ================= P8bc：uninstall =================
p8bc, F = newpage("流程 v2：uninstall（1）resolve → apply 前置（§2；v2.2 E、v2.3 §6、v2.5 §3／§10）", N8B, COLS5)
b = F.band("vD", "uninstall（1）：全部拆掉（install 的反向；bootstrap.sh 的反向也是它）= resolve（預檢 → hash → 保護清單 → 計畫 → 詢問清單 → 指紋 → stdout）→ apply 前置（拿鎖、重驗、frozen、dry-run）；寫入段見「uninstall（2）」頁；不 rm -rf .vendor_kit/", v2=True)
b.box("x0", U, 0, G12, "just vendor_kit uninstall（-y、--dry-run）", 220)
b.box("x0l", L, 0, v2(W12), fl("建 log 檔並寫 launcher_start（失敗 → 1 + 6-38，零寫入）"), 220)
b.box("x1", L, 1, v2(W12), "docker run <引擎> resolve uninstall（不經 docker create/cp）", 280)
b.box("x1e", E, 1, v2(SUB), EST_R, 400)
b.box("x2", E, 2, v2(D12), "預檢全部工具通過？", 250, ax="l")
b.box("x2b", E, 3, v2(SUB), fl("是：算每個自產檔的 hash（薄殼、version.toml、config.toml、gen/、cache/、baseline/；不動任何東西）"), 400)   # r12：清單含 config.toml（v2.13 P6）
b.box("x2bb", E, 4, v2(SUB), fl("分類：hash 相符 → 可刪清單；未知或被改的 → 保護清單（之後一律保留並回報）"), 400)
b.box("x2r", P, 4, v2(RULE), fl("保護清單在任何 remove 之前生效（v2.5 §10）；逐工具 remove 走保護模式：清單內的檔跳過"), 360)
b.box("x2c", E, 5, v2(SUB), fl("產生執行計畫：可刪清單＋保護清單（逐工具 remove 的順序）"), 400)
b.box("x2d", E, 6, v2(SUB), fl("產生詢問清單：append 行、根 justfile 那行、根 .dockerignore 四行"), 400)
b.box("x2e", E, 7, v2(SUB), fl("產生輸入指紋（version.toml、各 metadata、要動的使用者檔 hash）"), 400)   # r12：拆兩格
b.box("x2e2", E, 8, v2(SUB), fl("stdout vk-resolve/1：計畫＋詢問清單＋指紋回啟動器"), 400)
b.box("x1b", L, 9, v2(W12), fl("docker run <引擎> apply uninstall（--dry-run 原樣轉發）"), 280)
b.box("x1be", E, 9, v2(SUB), EST_A, 400)   # apply 容器（v2.14-2）
b.box("x4a", E, 10, v2(SUB), "apply：flock 專案目錄（60 秒）", 400)
b.box("x4b", E, 11, v2(SUB), "重驗指紋", 400)
b.box("x3c", E, 12, v2(D12), "相同 → CI 為真（frozen）且需改 tracked 檔？", 340, ax="l")
b.box("x3", E, 13, D12, "否 → --dry-run？", 240, ax=50)
b.box("x4z", E, 14, LBL, "否 ↓ 續「uninstall（2）」頁：建日誌 → 逐工具 remove → 刪自產檔 → 根 justfile 那行 → 刪日誌", 400, 24, ax="l", minh=24)
footer(b, F, 15, [("x3y", v2(G12), "0：只印會刪什麼、會問什麼"), ("x2x", v2(O12), fl("1：預檢失敗（dev 中 → 請先 undev；未完成接入 → 請先 add）")), ("x4bx", v2(O12), "1：指紋不同「請重跑」"), ("x3cx", v2(O12), fl("1：印需改清單（frozen；請在本機執行後 commit 並 push）"))])
b.H("xe1", "x0", "x0l"); b.D("xe1l", "x0l", "x1", al=True); b.H("xe1e", "x1", "x1e"); b.D("xe2", "x1e", "x2", "", 0.5, 0.5)
b.D("xe4", "x2", "x2b", "是", 0.5, 0.5); b.D("xe4b", "x2b", "x2bb"); b.D("xe4c", "x2bb", "x2c"); b.D("xe4d", "x2c", "x2d"); b.D("xe4e", "x2d", "x2e"); b.D("xe4e2", "x2e", "x2e2")
b.D("xe5", "x2e2", "x1b", "", 0.2, 0.5); b.H("xe5b", "x1b", "x1be"); b.D("xe5be", "x1be", "x4a"); b.D("xe5c", "x4a", "x4b"); b.D("xe5d", "x4b", "x3c", al=True)
b.D("xe5f", "x3c", "x3", "否", al=True); b.D("xe7", "x3", "x4z", al=True)
b.close()
footer_edges(F, [("xe3", "x2", "否", "l"), ("xe5x", "x4b", "不同", "l"), ("xe5e", "x3c", "是", "l"), ("xe6", "x3", "是", "l")], [("x3y",)*3, ("x2x",)*3, ("x4bx",)*3, ("x3cx",)*3])
foot(p8bc, "p8bc", F.y, _t8b("append 行"), ALL - {"inv", "tree", "pend", "note"})
pages_v1_b.append(("v1p8bc", "流程 v2：uninstall（1）resolve → apply 前置", p8bc))

# ================= P8bcc：uninstall（2）寫入段 =================
p8bcc, F = newpage("流程 v2：uninstall（2）apply 寫入段（§2；v2.2 E、v2.3 §6、v2.5 §3／§10、v2.6 Q22 補、v2.8 §1）", N8B, COLS5)
b = F.band("vD2", "uninstall（2）寫入段（承「uninstall（1）」頁）：建日誌 → 逐工具 remove（保護模式）→ 只刪 hash 相符的自產檔（config.toml == baseline 副本才刪，v2.13 P6）→ justfile 那行、.dockerignore 四行問後逐行刪 → 刪日誌 → .vendor_kit/ 保留（只剩 log/）", v2=True)
b.box("x4e", E, 0, ENTRY, "來自「uninstall（1）」頁：apply 檢查通過（非 dry-run；已寫 launcher_start）", 300)
b.box("x4l", E, 1, v2(SUB), "建進度日誌（.vendor_kit/.tmp.uninstall.<id>.toml；第一個寫入前）", 400)
b.box("x4lf", P, 1, F12, "＋.vendor_kit/.tmp.uninstall.<id>.toml（進度日誌，不進 git）", 360)
b.box("x4", E, 2, v2(SUB), fl("逐工具 remove（保護模式；步驟同「remove（2）」頁；append 行紀錄已由 resolve 計畫帶出）"), 400)
b.box("x5a", E, 3, v2(SUB), "全部成功：刪薄殼五檔（hash 相符者）", 400)
b.files("x5af", P, 3, "－.vendor_kit/ 薄殼五檔（保護清單內的保留）", [".gitignore", "entry.just", "vendor.just", "log.sh", "ci/check.sh"], 360, cols=3)
b.box("x5b", E, 4, v2(SUB), "刪 version.toml（hash 相符者）", 400)
b.box("x5bf", P, 4, F12, "－version.toml（進 git）", 360)
b.box("x5c", E, 5, v2(SUB), "刪 version.local.toml（有的話；hash 相符者）", 400)
b.box("x5cf", P, 5, F12, "－version.local.toml（不進 git）", 360)
b.box("x5cg", E, 6, v2(SUB), fl("刪 config.toml（hash == baseline/vendor_kit/config.toml 副本才刪；被改過 → 保留並列出，v2.13 P6）"), 400)
b.box("x5cgf", P, 6, v2(F12), "－config.toml（進 git；只刪未改過的）", 360)
b.box("x5d", E, 7, v2(SUB), fl("刪 gen/ 內剩下的自產檔（hash 相符者）"), 400)
b.files("x5df", P, 7, "－gen/ 兩檔（不進 git）", ["gen/.stamp", "gen/tools.just"], 360, cols=2)
b.box("x5e", E, 8, v2(SUB), fl("刪 baseline/ 內剩下的自產檔（hash 相符者；v2.8 §1；.dockerignore 的 append 行紀錄已由 resolve 計畫帶出）"), 400)
b.files("x5ef", P, 8, "－baseline/ 根檔（進 git）", ["baseline/.gitkeep", "baseline/.vendor_kit.toml", "config.toml 副本"], 360, cw=(140, 198))
b.box("x5dd", E, 9, v2(SUB), fl("刪已空的子目錄 baseline/、gen/、cache/、ci/（rmdir，不 rm -rf；log/ 不刪，v2.14-6）"), 400)
b.box("x6", E, 10, D12, "根 justfile 有我們那一行？", 380, ax="r")
b.box("x5r", P, 10, v2(RULE), fl("初始檔留著（永不刪，印清單）；使用者的 .gitignore／.dockerignore 只動我們 append 過且你同意的那幾行（v2.1 A、Q22 補）"), 360)
b.box("x8", U, 11, SUB, fl("無／否：印指示（請自行移除 import 那行）"), 220)   # 移到左欄，讓菱形加寬成一行（頁高）
b.box("x7", E, 11, v2(D12), "有 → 問「要刪這一行嗎」？", 380, ax="r")
b.box("x7y", E, 12, SUB, "是：只刪那一行", 140, ax=200)
b.box("x7f", P, 12, F12, "justfile（少一行：import '.vendor_kit/entry.just'）", 360)
b.box("x9a", E, 13, v2(D12), "根 .dockerignore 存在？", 380, ax="r")
b.box("x9b", E, 14, v2(D12), fl("有 → 仍有與紀錄相同的行？"), 380, ax="r")
b.box("x9r", P, 14, v2(RULE), fl("append 行逐行比對（§4.3、v2.9 §5；CRLF／LF 等價）：紀錄的每一行仍與原文相同 → 刪該行；不同／缺 → 跳過並 warn；不是全有／全無；零命中 → 不動"), 360)
b.box("x9q", E, 15, v2(D12), fl("有 → 問「要刪這幾行嗎」？"), 380, ax="r")
b.box("x9z", E, 16, v2(SUB), fl("無／否：不動 .dockerignore"), 110, ax=-30)   # r12：匯流排離 x9q 左尖 ≥ 40（xe16an）
b.box("x9y", E, 16, v2(SUB), fl("是：逐行只刪仍相同的行；不同／缺的行跳過 warn"), 230, ax="r")
b.box("x9f", P, 16, v2(F12), ".dockerignore（只少仍相同的那幾行；其餘不動）", 360)
b.box("x5z", E, 17, v2(SUB), "刪進度日誌（最後一步；根 justfile 那行之後）= 交易完成", 400)
b.box("x5k", P, 17, v2(NOTE), fl("不 rmdir .vendor_kit/（只剩 log/；uninstall 自己也在寫 log，v2.14-6）；log/ 留存可手動刪"), 360)   # r12：非動作 → 便條
footer(b, F, 18, [("x5y", v2(G12), fl("0：印摘要（log/ 留存可手動刪；保護清單內的檔保留）")), ("x4x", v2(R12), "1：任一工具 remove 失敗 → 中止，列出已完成部分")])
b.D("xe7", "x4e", "x4l"); b.H("xe7f", "x4l", "x4lf", "寫"); b.D("xe8", "x4l", "x4")
b.D("xe10", "x4", "x5a"); b.H("xe10f", "x5a", "x5af", "刪"); b.D("xe10b", "x5a", "x5b"); b.H("xe10bf", "x5b", "x5bf", "刪")
b.D("xe10c", "x5b", "x5c"); b.H("xe10cf", "x5c", "x5cf", "刪"); b.D("xe10cg", "x5c", "x5cg"); b.H("xe10cgf", "x5cg", "x5cgf", "刪"); b.D("xe10d", "x5cg", "x5d"); b.H("xe10df", "x5d", "x5df", "刪")   # config.toml 依 v2.13 P6
b.D("xe10dd", "x5d", "x5e"); b.H("xe10ef", "x5e", "x5ef", "刪"); b.D("xe10e", "x5e", "x5dd")   # gen/／baseline/ 拆兩格（r9）
b.D("xe12", "x5dd", "x6", "", 0.5, 0.5); b.LD("xe13", "x6", "x8", "無", busx=150, vert="left"); b.D("xe14", "x6", "x7", "有", al=True)
b.H("xe14n", "x7", "x8", "否"); b.D("xe14y", "x7", "x7y", "是", al=True); b.H("xe15", "x7y", "x7f", "寫")
b.D("xe16z", "x8", "x9a", al=True); b.D("xe16y", "x7y", "x9a", "", 0.5, 0.5)
b.D("xe16a", "x9a", "x9b", "有", al=True); b.D("xe16b", "x9b", "x9q", "有", al=True); b.D("xe16q", "x9q", "x9y", "是", 0.7, 0.5, al=True); b.H("xe16f", "x9y", "x9f", "寫")
b.LD("xe16an", "x9a", "x9z", "無", busx=560, vert="left"); b.LD("xe16bn", "x9b", "x9z", "無", busx=560, vert="left"); b.D("xe16qn", "x9q", "x9z", "否", 0.3, 0.5)
b.D("xe16v", "x9y", "x5z", al=True); b.D("xe16w", "x9z", "x5z", al=True)
b.close()
footer_edges(F, [("xe9", "x4", "失敗", "l")], [("x5y",)*3, ("x4x",)*3], main=("xe17", "x5z", "", 0.5))
foot(p8bcc, "p8bcc", F.y, _t8b("dev 覆寫", "CI 為真") + [VL_T], ALL - {"inv", "tree", "pend"} | {"entry"})
