footer(b, F, 14, [("m11", G12, "0：印「以下初始檔保留，若不需要請 git rm：…」"), ("m10x", v2(R12), "1：寫入失敗，明列已完成／未完成")])
b.D("me11e", "m9e", "m9l"); b.H("me11f", "m9l", "m9lf", "寫"); b.D("me11h", "m9l", "m9h", al=True)
