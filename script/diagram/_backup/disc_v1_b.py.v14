footer_edges(F, [("we2n", "w2q", "否", "l"), ("we2bx", "w2b", "不同", "l"), ("we3x", "w2", "失敗", "l"), ("we4", "w2g", "", "l"), ("we7", "w6", "否", "l"), ("we8px", "w5p", "失敗", "l")],
