footer_edges(F, [("be26x", "b16", "失敗（任一步）", "l"), ("be29", "b16q", "是", "l")], [("b17",)*3, ("b18",)*3, ("b16x",)*3], main=("be28", "b16q", "否", 0.5))
foot(p7cq, "p7cq", F.y, _t7("Renovate", "PR／commit", "check.sh", "materialize"), ALL - {"inv", "tree", "pend", "note"} | {"entry"})
pages_v1_b.append(("v1p7cccc", "流程 v2：upgrade ── B. 手動路徑（2′）收尾寫入", p7cq))

# ================= P7b：upgrade ── C. 逐檔判斷、C′ 衝突重入 =================
T7B = [
 BDN_T,
 ("逐檔判斷後詢問／apply", "apply = 動詞的第二段（拿到 flock、重驗指紋、建日誌後才寫檔）；三份比：N 改了才問「換成新版？」，兩邊都改才問「三方合併？」；-y 免問；拒絕 → 不動、記 declined_hash，新檔被拒才 state=declined；全部在暫存完成再逐檔原子替換"),
 RA_T,
 ("flock／指紋", "flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎；指紋 = resolve 讀過的檔的 hash＋鎖定 digest，apply 拿鎖後重驗，不同 → 1「請重跑」"),
 MD_T, GM_T,
 ("衝突重入（v2.2 D (0)）", "再跑 upgrade 時 resolve 先看 metadata 的「衝突中檔案」：檔內仍有我們的標籤 → 2 停；檔案失蹤不算已解；都乾淨 → apply 拿鎖、建日誌後清除狀態再往下"),
 ("--dry-run／CI 為真", "apply --dry-run 唯讀預覽：只印會問哪些檔（哪些要換／合併／append 替換；讀 /dist/<repo>），不動任何檔；本機 → 0；CI 為真（CI 非空且不為 0／false = frozen）且需改 tracked 檔 → 1（-y 不解除）"),
 ("append 行／CRLF", "strategy=append 的初始檔：upgrade 找上次插入的行（CRLF = Windows 換行 \\r\\n，與 LF 視為相同；其餘精確）→ 問後替換；零命中或多處 → 保留只 warn"),
 ("二進位／symlink", "二進位 = 不是文字的檔；symlink = 指向另一個路徑的捷徑；兩者不做行內合併：你沒改 → 問「X 是二進位檔，要換成新版嗎？」答應才換（v2.6 §8）；改過保留 + warn；dist/files/ 第一版禁止 symlink"),
 ("回退／git revert", "git revert = 產生一個反向 commit 把那次升級（version.toml、初始檔、baseline 同一 commit）整組退回；下次 just 的 sync 看印記 ≠ version.toml → 只把 cache/<repo>/ 換回舊版（見「D. 回退」頁）"),
 ("印記／declined／declined_hash", "印記 = gen/<repo>.stamp（第一行 index digest，之後每檔 sha256），sync 拿它跟 version.toml 鎖定 digest 比；state=declined 只用於「範本要建的新檔被拒」；已納管檔拒絕本次更新 → state 不變、只記 declined_hash（被拒那版 N 的 sha256），N 再變才再問（v2.7 §3）"),
 *LOGT, EXIT3,
]
def _t7b(*drop): return [t for t in T7B if not t[0].startswith(drop)]
N7B = "已定（v2.3 §1）：append 行比對 CRLF／LF 視為相同、其餘精確；找不到或多處 → 保留只 warn。已定（v2.2 E）：dist/files/ 第一版禁止 symlink。已定（v2.5 §2）：N 讀暫存 /dist/<repo>，materialize 在決定套用之後。自身升級見「E. 自身升級」頁；回退見「D. 回退」頁。"
p7b, F = newpage("流程 v2：upgrade ── C. 逐檔判斷表、C′ 衝突重入（§5、v2.2 D、v2.3 §1、v2.5 §1／§2／§4）", N7B, COLS7)
b = F.band("uC", "C. 逐檔判斷後詢問（每個 init.toml 檔；引擎 merge 模組；§5 表；在 apply 內、拿到 flock、建日誌後）＋ C′ 衝突重入（v2.2 D (0)、v2.5 §3）", v2=True)
tx, ty = 20, 70; cws = [170, 290, 230]
b.free("c_in0", F12, "B = baseline/<repo>/<檔>（上次合併的範本）", 1300, 50, 280, 40)
b.free("c_in1", F12, "D = 專案裡的 <檔>（現況，你可能改過）", 1300, 106, 280, 40)
b.free("c_in2", v2(F12), "N = 目標版範本：暫存 /dist/<repo>/<檔>（不是 cache）", 1300, 162, 280, 40)
b.free("c_m", SUB, "引擎 merge 模組：三份比對，逐檔判斷（左表；總說明格）", 730, 54, 340, 40)   # r12：一格一事（詢問／拒絕另格）
b.free("c_m2", SUB, "要改的先問（-y 免問；拒絕 → 不動、記 declined_hash；新檔才 state=declined）", 730, 110, 340, 48)
b.P("c_e0", "c_in0", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 70), (20 + 1276, F.y + 74)])
b.P("c_e1", "c_in1", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 126), (20 + 1276, F.y + 74)])
b.P("c_e2", "c_in2", "c_m", "", (0, 0.5), (1, 0.5), [(20 + 1276, F.y + 182), (20 + 1276, F.y + 74)])
b.P("c_em", "c_m", "c_m2", "", (0.5, 1), (0.5, 0), [])
rows = [("新版沒改／你的檔已等於新版（N==B 或 D==N）", "不動", "—"),
        ("你刪了已納管的檔（D 缺）", "不問、不重建", "state=deleted，維持刪除（§4.3）"),
        ("新版改了、你沒改（D==B、N≠B）", "問「X 換成新版？」", "同意 → 換；拒絕 → 不動、state 不變只記 declined_hash（目標新版再次更新時再問）"),
        ("兩邊都改（D≠B、N≠B）", "問「你和新版都改了 X，要三方合併嗎？」", "同意 → git merge-file --diff3（在暫存做）：乾淨 → 原子替換寫入；衝突 → 留 <<<<<<< vendor_kit:baseline 標記、回 2；baseline 仍推到目標版；解完重跑直到乾淨；拒絕 → 不動、state 不變只記 declined_hash"),
        ("新版新增（B 無）", "問「要建 X 嗎」（-y 建）；已有同名 → 不納管；dest 在 CI 路徑時訊息醒目", "拒絕 → 不建、state=declined（唯一會用 declined 的情況；之後不再問；目標新版再次更新時重新詢問；dry-run／check.sh 印「有 N 個範本你拒絕過」）；不覆蓋、印「已存在，範本在 cache」"),
        ("新版刪除該檔（N 無）", "不刪，只 warn", "你的檔留著"),
        ("append 行（strategy=append）", "找到上次插入的行（CRLF／LF 視為相同，其餘精確）→ 問後替換", "唯一命中 → 替換；零命中或多處 → 保留只 warn、印新內容；拒絕 → 不動、state 維持 appended 只記 declined_hash"),
        ("二進位／symlink", "不合併：你未改（D==B）→ 問「X 是二進位檔，要換成新版嗎？」（-y 免問）", "同意 → 換；拒絕 → 不動、state 不變只記 declined_hash（新版再更新時再問）；改過 → 保留 + warn"),
        ("CI 為真（frozen）且需改 tracked 檔", "apply 印清單 → 1（version.toml 未動；-y 不解除 frozen）", "--dry-run 也一樣：CI 為真且需改 tracked 檔 → 1；本機 → 0 只印清單")]
for i, hh in enumerate(["情況", "做法", "結果"]):
    b.free(f"c_h{i}", HDR, hh, tx + sum(cws[:i]), ty, cws[i], 28, minh=28)
cy = ty + 28
for r, row in enumerate(rows):
    rh = max(40, math.ceil(max(need_h(c, 12, w) for c, w in zip(row, cws))) + 4)
    for i, (c, w) in enumerate(zip(row, cws)):
        b.free(f"c_r{r}c{i}", TERM_K if i == 0 else TERM_V, c, tx + sum(cws[:i]), cy, w, rh, minh=rh)
    cy += rh
b.free("c_note", NOTE, "--dry-run = 唯讀預覽，只印會問哪些檔。衝突解完 → 再跑一次 upgrade 直到乾淨（2 = 需要人解衝突，橙）。dest 撞名規則見「add（1′）」頁；四種詢問各一格見「B（2）」頁。", 1300, 218, 280, 60)
b.P("c_e3", "c_m2", "c_h2", "", (0, 0.5), (1, 0.5), [])
cy2 = cy + 30
b.free("cx_l", LBL, "C′ 衝突重入（解完衝突後再跑 upgrade；v2.2 D (0)）—— 偵測在 resolve，清除在 apply（拿鎖、建日誌後）；終點見「B. 手動路徑（1）」頁", 20, cy2, 700, 24, minh=24)
_cxc = cy2 + 69                                                                     # 三格中心同高（review r6：cx_e0／cx_e1 不再有小折）
_h0, _h1 = fit_h("解完衝突後再跑 upgrade <repo>", 220, 58, 0, G12), fit_h("衝突檔仍含我們的標籤？（檔案失蹤不算已解）", 340, 50, 0, D12)
b.free("cx0", G12, "解完衝突後再跑 upgrade <repo>", 20, _cxc - _h0 / 2, 220, _h0)
b.free("cx1", v2(D12), "衝突檔仍含我們的標籤？（檔案失蹤不算已解）", 730, _cxc - _h1 / 2, 340, _h1)   # r12：檔案失蹤不算已解（cx1）
b.free("cx2", v2(LBL), "是 → 2：停，先解完標記再重跑（= 「B. 手動路徑（1）」頁 (0) 的橙終點）", 1100, _cxc - 20, 300, 40)   # r12：跨頁出口用文字（cx2／cx3）
b.free("cx3", v2(LBL), "否 → 接「B. 手動路徑（1）」頁 (1)(2)：apply 拿鎖、建日誌後清除衝突狀態", 730, cy2 + 140, 340, 40)
b.P("cx_e0", "cx0", "cx1", "", (1, 0.5), (0, 0.5), [])
b.P("cx_e1", "cx1", "cx2", "是", (1, 0.5), (0, 0.5), [])
b.P("cx_e2", "cx1", "cx3", "否", (0.5, 1), (0.5, 0), [], vert=True, pos=-0.4)
b.close()
foot(p7b, "p7b", F.y, T7B + [REN_T], ALL - {"inv", "tree", "pend", "rule"})
pages_v1_b.append(("v1p7b", "流程 v2：upgrade ── 逐檔判斷、衝突重入", p7b))

# ================= P7bd：upgrade ── D. 回退 =================
p7bd, F = newpage("流程 v2：upgrade ── D. 回退 = git revert 該升級 commit（§5、v2.5 §1／§9）", N7B, COLS7)
b = F.band("uD", "D. 回退 ＝ git revert 該升級 commit（version.toml + 初始檔 + baseline 同一 commit）；下次 just 的 sync（resolve → docker → apply，各容器先 engine_start）只把 cache/ 換回舊版", v2=True)
b.box("d0", U, 0, G12, "git revert 該升級 commit", 220)
b.box("d1a", L, 0, v2(W12), fl("下次 just（已寫 launcher_start）：docker run 引擎 resolve sync"), 240)
b.box("d1ae", E, 0, v2(SUB), EST_R, 360)   # r12：resolve 容器 engine_start
b.files("d3b", U, 1, "由 git revert 還原（不是 sync 寫）", ["初始檔", "baseline/<repo>/", "version.toml"], 220)   # r12：一格一檔
b.box("d2", E, 1, SUB, fl("sync resolve：gen/<repo>.stamp 第一行 ≠ version.toml 鎖定 digest → 待辦「materialize 舊版」"), 360)
pullseg(b, 2, ("d1b", "d1p", "d1g"), ("inspect：舊版本機有？", "無：docker pull", "<repo>-dist@digest\n（version.toml 還原後的舊版）"), ("d1c", W12, "docker create <img> /x"), w=(240, 180, 240), imgw=160)
b.box("d1d", L, 5, W12, "docker cp c:/dist/. <tmp>/<repo>/", 240)
b.box("d1e", L, 6, W12, "docker rm 該容器", 240)
b.box("d1f", L, 7, W12, "docker run … -v <tmp>:/dist:ro 引擎 apply sync", 240)
b.box("d1fe", E, 7, v2(SUB), EST_A, 360)   # r12：apply 容器 engine_start
b.box("d2c", E, 8, SUB, fl("materialize 舊版：/dist/<repo> 複製到暫存目錄（初始檔與 baseline 不碰）"), 360)
b.box("d2c2", E, 9, SUB, fl("暫存 → cache/<repo>/（原子替換）"), 360)
b.box("d3", P, 9, F12, fl("cache/<repo>/（舊版；sync 寫）"), 280)
b.box("d2c3", E, 10, SUB, fl("寫印記 gen/<repo>.stamp（舊版 index digest）"), 360)
b.box("d3s", P, 10, F12, fl("gen/<repo>.stamp（舊版；sync 寫）"), 280)
footer(b, F, 11, [("d8", v2(G12), fl("0：接著跑原本的 recipe（cache 已是舊版）")), ("d1px", v2(R12), fl("1 + 6-24／6-31：pull 失敗／逾時"))], lpw=115)
b.H("de1", "d0", "d1a"); b.H("de1e", "d1a", "d1ae"); b.D("de2", "d1ae", "d2"); b.D("de2b", "d2", "d1b", "", 0.5, 0.5)
b.D("de2d", "d1c", "d1d"); b.D("de2e", "d1d", "d1e"); b.D("de2f", "d1e", "d1f")
b.H("de2h", "d1f", "d1fe"); b.D("de2he", "d1fe", "d2c"); b.D("de2i", "d2c", "d2c2"); b.H("de3", "d2c2", "d3", "寫"); b.D("de2j", "d2c2", "d2c3"); b.H("de3s", "d2c3", "d3s", "寫"); b.D("de4", "d0", "d3b")
b.close()
bypass(F, p7bd, "de2y", "d1b", "d1c")
footer_edges(F, [("de2px", "d1p", "失敗", "l")], [("d8",)*3, ("d1px",)*3], main=("de5", "d2c3", "", 0.5))
foot(p7bd, "p7bd", F.y, _t7b("逐檔判斷後詢問", "衝突重入", "--dry-run", "append 行", "二進位") + [PULLX_T, SYNC_T, REN_T], ALL - {"inv", "tree", "pend", "rule"})
pages_v1_b.append(("v1p7bd", "流程 v2：upgrade ── D. 回退", p7bd))

# ================= P7bc：upgrade ── E. 自身升級 =================
T7E = [
 ("自身升級（v2.3 §2、v2.5 §7、v2.6 §5、v2.7 §5）", "(a) 不帶 repo：resolve 先判斷引擎有沒有新版；有 → 啟動器先 pull 新引擎（覆寫時驗 ID）→ 舊引擎 apply 只改第一行 → 啟動器 apply 前後 grep 第一行、變了就同一次指令內用新引擎跑 upgrade vendor_kit → 1；(b) 別人 pull 後只回 1 提示；(c) upgrade vendor_kit[@<tag>]：目標 ≠ 現 ref → 建日誌、改第一行、新引擎重產後刪日誌 → 1；無新版 → 薄殼相符 → 0、否則重產 → 1；@舊版無法無損讀 → 3"),
 RA_T, E2B_T,
 ("進度日誌（upgrade vendor_kit；v2.11）", "upgrade vendor_kit 也建 .tmp.upgrade.<id>.toml（統一規則）：改 version.toml 第一行之前建，記舊引擎 ref、目標引擎 ref、計畫 image ID、done／pending；新引擎重產薄殼完成後刪；未完成 → 可寫動詞先恢復（= 重跑 upgrade vendor_kit）、sync／update 印 6-33 結束 1、help 仍 0"),
 ("薄殼首行自描述（Q17）／上次產物／相符", "薄殼每檔首行 # vendor_kit-shell/<P> engine=<vX> sha256=<其餘內容 hash>；「== 上次產物」= 首行 hash 與內容相符，被改過 → 1 列差異不動；「薄殼相符」= 首行 engine 已是本引擎且 gen/.stamp 相符 → 0 無變更"),
 GS_T, GT_T,
 ("GHCR／registry／引擎 image／引擎 ref", "GHCR = GitHub 的容器倉庫（registry）；引擎 image = ghcr.io/…/vendor_kit:vN；引擎 ref = version.toml 第一行指到的那一個（tag@digest）；查 registry = 列 tags 取最新正式版（frozen 或 @<tag> 不查）"),
 ("image ID／docker image inspect／local 覆寫", "本機引擎覆寫（dev vendor_kit -i）在 version.local.toml 記 tag + image ID；啟動器每次先 docker image inspect：本機有就不 pull（覆寫時 .Id 必須 == 記的 image ID，否則 1）；不用 --pull never（docker 19.03 無此旗標）"),
 MD_T, FIP_T,
 ("dev 覆寫／undev／多工具彙總（Q27）", "工具在 version.local.toml 有 path:<dir> 覆寫；不帶 repo 的 upgrade 預檢遇到 → 1 提示先 undev（v2.5 §6）；多工具做得完的做完，最後回最需要處理的碼：1 > 2 > 0，訊息全列"),
 ("--protocol P／降版（Q19）／結束碼 3", "薄殼每次呼叫附 --protocol P（v2.4 Q16）；舊薄殼跑新 major 引擎 → 乾淨回 3 提示先 upgrade vendor_kit；upgrade vendor_kit@<舊版>：目標引擎（image LABEL 的 P／schema）能無損讀現有檔才做，否則改檔前拒絕 3 印 6-10（零寫入）；救援路徑永久可用"),
 *LOGT, EXIT3,
]
def _t7e(*drop): return [t for t in T7E if not t[0].startswith(drop)]
N7E = "已定（v2.3 §2、v2.5 §7、v2.6 §1／§5、v2.7 §5、v2.11）：(a) 不帶 repo：resolve 先判斷「引擎有新版？」，否 → 只升工具；是 → 啟動器先 pull 新引擎（§3.3 engine 記錄；覆寫時驗 image ID）→ 舊引擎 apply（拿鎖、重驗、建 .tmp.upgrade 日誌）只改第一行 → 啟動器 grep 第一行變了 → 用新引擎跑 upgrade vendor_kit；(c) 先查 registry（@<tag>／frozen 不查）→ 有新版／只重產／無變更；結束 1 = 需要人動作（橙）。"
p7bc, F = newpage("流程 v2：upgrade ── E. vendor_kit 自身升級 (a)(b)（v2.2 A／B、v2.3 §2、v2.5 §7、v2.6 §5）", N7E, COLS5W)
b = F.band("uE", "E. vendor_kit 自身升級：(a) upgrade 不帶 repo 當次換新引擎並重產薄殼（啟動器先 pull 新引擎 → 舊引擎建 .tmp.upgrade 日誌、改第一行 → 新引擎重產後刪日誌）；(b) 別人 pull 後只回 1 提示（sync 頁）；(c) upgrade vendor_kit 見「E(c)」頁", v2=True)
b.box("s0", U, 0, v2(G12), "(a) upgrade 不帶 repo（含 vendor_kit 自身）", 220)
b.box("s0l", L, 0, v2(W12), fl("建 log 檔並寫 launcher_start（失敗 → 1 + 6-38，零寫入）"), 280)
b.box("s1", L, 1, v2(W12), "docker run 舊引擎 resolve upgrade（全部）", 280)
b.box("s2a0", E, 1, v2(SUB), EST_R, 360)   # resolve 容器（v2.14-2）
b.box("s2a", E, 2, v2(SUB), fl("resolve：先完整預檢（dev 中工具、新版新增 <ns>／dest 的全域撞名）"), 360)
b.box("s2dq", E, 3, v2(D12), "含 dev 中工具？", 260, ax="l")   # r12：菱形＋橙出口（s2a）
b.box("s2q", E, 4, v2(D12), "否 → 引擎有新版？", 260, ax="l")
b.box("s2n", E, 4, LBL, "否 → 只升工具：每個工具走「B（1）」頁（Q27）", 100, ax="r", minh=40)
pullseg(b, 5, ("s2ln", "s2lp", "s2gi"), ("是 → inspect 新引擎：本機有？", "無：docker pull 新引擎", "vendor_kit:vY\n（新引擎）"), ("s2lv", v2(D12), fl("覆寫中且 .Id ≠ 記的 image ID？")), w=(280, 200, 280))   # r12：新引擎 pull 移到 apply 之前（§3.3 engine 記錄）
b.box("s2r0", L, 8, v2(W12), "否：docker run 舊引擎 apply upgrade", 280)
b.box("s2b0", E, 8, v2(SUB), EST_A, 360)   # apply 容器（v2.14-2）
b.box("s2b", E, 9, v2(SUB), "apply（舊引擎）：flock 專案目錄", 360)
b.box("s2c", E, 10, v2(SUB), "重驗指紋", 360)
b.box("s2d", E, 11, v2(SUB), fl("相同 → 建進度日誌 .tmp.upgrade.<id>.toml（記舊引擎 ref、目標引擎 ref、計畫 image ID；改第一行之前，v2.11）"), 360)
b.box("s2df", P, 11, v2(F12), "＋.vendor_kit/.tmp.upgrade.<id>.toml（進度日誌，不進 git；新引擎重產薄殼完成後才刪）", 280)
b.box("s2e", E, 12, v2(SUB), fl("只改 version.toml 第一行 → 新引擎 ref（其餘工具等重跑原指令；日誌留給新引擎）"), 360)
b.box("s2f", P, 12, F12, "version.toml 第一行 = 新引擎 ref", 280)
b.box("s2h", L, 13, v2(W12), fl("apply 後再 grep version.toml 第一行（local 覆寫 vendor_kit= 優先；v2.6 §5，不從 stdout 讀）"), 280)
b.box("s2h2", L, 14, v2(D12), fl("第一行變了且 == 計畫的 engine？"), 280)
b.box("s2r", L, 15, v2(W12), fl("是：docker run 新引擎 upgrade vendor_kit（同一 TRACEPARENT、同一 log 檔）"), 280)
b.box("s4", E, 15, LBL, "→ 接「E(c)（1）」頁「docker run 該引擎」格（同一次指令內；接手 §3.4，結束碼原樣傳出）", 360, 24, ax="l", minh=24)
b.box("sb", L, 16, LBL, "(b) 別人 pull 後（第一行已變）打任何 just：走「sync（1）」頁 gen/.stamp 比對 → 1 + 6-1「請 upgrade vendor_kit」→ 打 (c)", 700, 24, ax="l", minh=24)   # r12：(b) 與 sync（1）重複，改成引用
footer(b, F, 17, [("s2dx", v2(O12), "1：請先 undev dev 中的工具（v2.5 §6）"), ("s2cx", v2(O12), "1：指紋不同「請重跑」"), ("s2lx", v2(R12), fl("1 + 6-24／6-31：新引擎拉不到／ID 不符（第一行未改）")), ("s2hx", v2(R12), fl("1：apply 未改第一行（印 apply 的錯誤）"))], lpw=150)
b.H("se1", "s0", "s0l"); b.D("se1l", "s0l", "s1"); b.H("se2", "s1", "s2a0"); b.D("se2a", "s2a0", "s2a"); b.D("se2dq", "s2a", "s2dq", al=True); b.D("se2q", "s2dq", "s2q", "否", al=True); b.H("se2n", "s2q", "s2n", "否")
b.D("se3", "s2q", "s2ln", "是", 0.5, 0.5)
b.D("se6vr", "s2lv", "s2r0", "否", al=True)
b.H("se3b0", "s2r0", "s2b0"); b.D("se3b", "s2b0", "s2b"); b.D("se3c", "s2b", "s2c"); b.D("se3d", "s2c", "s2d"); b.H("se3df", "s2d", "s2df", "寫"); b.D("se3e", "s2d", "s2e"); b.H("se4", "s2e", "s2f", "寫")
b.D("se5", "s2e", "s2h", "", 0.2, 0.5); b.D("se5h", "s2h", "s2h2", al=True)
b.D("se5l", "s2h2", "s2r", "是", al=True); b.H("se7", "s2r", "s4")
b.close()
bypass(F, p7bc, "se6y", "s2ln", "s2lv")
footer_edges(F, [("se2dx", "s2dq", "是", "l"), ("se6px", "s2lp", "失敗", "l"), ("se6vx", "s2lv", "是", "l"), ("se3cx", "s2c", "不同", "l"), ("se5x", "s2h2", "否", "l")],
             [("s2dx",)*3, ("s2cx",)*3, ("s2lx",)*3, ("s2hx",)*3])
foot(p7bc, "p7bc", F.y, _t7e("--protocol", "薄殼首行", "進度日誌") + [PULLX_T], ALL - {"inv", "tree", "pend", "rule", "note"})
pages_v1_b.append(("v1p7bc", "流程 v2：upgrade ── E. 自身升級 (a)(b)", p7bc))

# ================= P7bcc：upgrade ── E(c) upgrade vendor_kit（1）=================
p7bcc, F = newpage("流程 v2：upgrade ── E(c) upgrade vendor_kit（1）啟動器 → 查 registry → 目標判定（v2.7 §5）", N7E, COLS5W)
b = F.band("uE2", "E(c)（1）upgrade vendor_kit[@<tag>]：launcher_start → inspect／pull → engine_start → 拿鎖、重驗 → 薄殼 == 上次產物？→ @舊版 → 3 → frozen／@<tag>／查 registry → 目標 ≠ 現 ref？是 → 「E(c)（1′）」頁；否 → 「E(c)（2）」頁", v2=True)
b.box("s10", U, 0, v2(G12), fl("(c) just vendor_kit upgrade vendor_kit[@<tag>]"), 220)
b.box("s10l", L, 0, v2(W12), fl("建 log 檔並寫 launcher_start（失敗 → 1 + 6-38，零寫入）"), 280)
b.box("s11a", L, 1, v2(W12), "grep version.toml 第一行取引擎 ref（local 覆寫 vendor_kit= 優先；跳過 gen/.stamp 比對）", 280)
pullseg(b, 2, ("s11n", "s11p", "s11g"), ("docker image inspect：本機有？", "無：docker pull 該引擎", "vendor_kit:vN\n（第一行指到的引擎）"), ("s11v", v2(D12), fl("覆寫中且 .Id ≠ 記的 image ID？")), w=(280, 200, 280))
b.box("s10a", U, 5, ENTRY, fl("來自「E(a)(b)」頁：啟動器已改用新引擎 ref（已寫 launcher_start）"), 220)
b.box("s11r", L, 5, v2(W12), "否：docker run 該引擎 upgrade vendor_kit", 280)
b.box("s12a0", E, 5, v2(SUB), EST_1, 360)   # 單段容器（v2.14-2）
b.box("s12a", E, 6, v2(SUB), "flock 專案目錄（60 秒）", 360)
b.box("s12b", E, 7, v2(SUB), "重驗指紋", 360)
b.box("s12s", E, 8, v2(D12), "相同 → 薄殼 == 上次產物？", 340, ax="l")
b.box("s12sn", P, 8, v2(NOTE), fl("「上次產物」= 薄殼首行自描述的 sha256 與其餘內容相符（Q17；install 頁同）；拿鎖重驗後、任何寫入前檢查，不符 → 1 列差異、零寫入（v2.8 §3）"), 360)
b.box("s12d", E, 9, v2(D12), fl("是 → @<tag> 舊版且無法無損讀？"), 340, ax="l")
b.box("s12t", E, 10, v2(D12), fl("否 → 指定 @<tag>？"), 260, ax="l")   # r12：@<tag> 先於 frozen（spec「frozen 且未指定 → 目標 = 現 ref」）
b.box("s12tt", E, 10, v2(SUB), fl("是：目標 = @<tag>（不查 registry）"), 100, ax="r")
b.box("s12f", E, 11, v2(D12), fl("否 → CI 為真（frozen）？"), 260, ax="l")
b.box("s12fz", E, 11, LBL, "是：不查 registry、不改第一行 → 續「E(c)（2）」頁", 100, ax="r", minh=40)
b.box("s12u", E, 12, v2(SUB), fl("否：查 registry（GHCR）取引擎最新正式版 = 目標"), 260, ax="l")
b.box("s12v", E, 13, v2(D12), "目標引擎 ref ≠ 現 ref？", 240, ax="l")
b.box("s12vz", E, 13, LBL, "否 → 續「E(c)（2）」頁：薄殼比對與重產", 110, ax="r", minh=40)
b.box("s12jz", E, 14, LBL, "是 ↓ 續「E(c)（1′）」頁：建 .tmp.upgrade 日誌 → 改第一行 → 啟動器接手新引擎", 360, 24, ax="l", minh=24)
footer(b, F, 15, [("s12bx", v2(O12), "1：指紋不同「請重跑」"), ("s12sx", v2(O12), fl("1 + 6-28：薄殼被改過，列差異不動（零寫入）")), ("s12dx", v2(O12), fl("3 + 6-10：無法無損讀現有檔（零寫入）")), ("s11x", v2(R12), fl("1：拉不到／image ID 不符（同 tag 重 build）"))], lpw=150)
b.H("se11", "s10", "s10l"); b.D("se11l", "s10l", "s11a"); b.D("se11q", "s11a", "s11n", al=True)
b.D("se11vr", "s11v", "s11r", "否", al=True)   # 成功入口（r9）
b.H("se11e", "s10a", "s11r")
b.H("se12", "s11r", "s12a0"); b.D("se12a", "s12a0", "s12a"); b.D("se12b", "s12a", "s12b"); b.D("se12s", "s12b", "s12s", al=True); b.D("se12d", "s12s", "s12d", "是", al=True)
b.D("se12t", "s12d", "s12t", "否", al=True); b.H("se12tt", "s12t", "s12tt", "是"); b.D("se12f", "s12t", "s12f", "否", al=True)
b.H("se12fz", "s12f", "s12fz", "是"); b.D("se12u", "s12f", "s12u", "否", al=True)   # @<tag>／frozen 拆開（r9）；順序 r12
b.D("se12v", "s12u", "s12v", al=True); b.H("se12vn", "s12v", "s12vz", "否")
b.D("se12j", "s12v", "s12jz", "是", al=True)
b.close()
bypass(F, p7bcc, "se11y", "s11n", "s11v"); bypass(F, p7bcc, "se12tv", "s12tt", "s12v", label="")   # @<tag> 目標繞右側到 s12v（跳過 frozen／查 registry）
footer_edges(F, [("se11px", "s11p", "失敗", "l"), ("se11vx", "s11v", "是", "l"), ("se12x", "s12b", "不同", "l"), ("se12sx", "s12s", "否", "l"), ("se12dx", "s12d", "是", "l")],
             [("s12bx",)*3, ("s12sx",)*3, ("s12dx",)*3, ("s11x",)*3])
foot(p7bcc, "p7bcc", F.y, _t7e("dev 覆寫", "進度日誌") + [PULLX_T, MSG_T], ALL - {"inv", "tree", "pend", "rule"} | {"entry"})
pages_v1_b.append(("v1p7bcc", "流程 v2：upgrade ── E(c) upgrade vendor_kit（1）", p7bcc))

