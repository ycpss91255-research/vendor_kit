footer_edges(F, [("ce38", "c23", "失敗（任一步）", "l")], [("c24",)*3, ("c23x",)*3], main=("ce39", "c23b", "", 0.5))
foot(p5bc, "p5bc", F.y, _t5b("stdout", "輸入指紋", "GHCR", "--local", "dest 撞名", "命名空間"), ALL - {"inv", "pend", "tree"} | {"entry"})
pages_v1_b.append(("v1p5bc", "流程 v2：add（2）apply 寫入段", p5bc))

# ================= P6：sync（1）第 1 段 resolve =================
T6 = [
 SYNC_T,
 ("快路徑（Q22）", "啟動器只用 grep 比對：gen/.stamp 第一行 == 引擎 ref；[tools] 每個 <repo> 的 digest == gen/<repo>.stamp 第一行（或 path:<dir>）；gen/tools.just 存在；無 .tmp.<verb>.*.toml；非 frozen。全相符 → 不起容器、0；否則起引擎 resolve sync"),
 RA_T,
 ("待辦清單／apply|no", "resolve sync 把待辦（要拉哪些 image、要重裝什麼、要不要重生 tools.just）以 stdout 一行一項回啟動器（vk-resolve/1：| 分隔、末行 end|N）；無待辦 → apply|no，不起第二個容器"),
 ("stdout／stderr／指紋", "stdout = 給啟動器讀的結果（固定欄位）；stderr = 給人看的診斷；指紋 = resolve 讀過的 version.toml、metadata 等的 hash，apply 重驗，不同 → 1「請重跑」"),
 FROZEN_T,
 ("統一提示（Q10 (2)）", "啟動器發現引擎 ref ≠ gen/.stamp → 不重寫，退出 1 固定印「vendor_kit 已更新 vX → vY，請執行：just vendor_kit upgrade vendor_kit」（6-1；需要人動作，橙）；install／upgrade vendor_kit 跳過這關；fresh clone 缺 gen/.stamp 時 vX 讀薄殼自描述首行"),
 ("薄殼／引擎 ref／正規行", "薄殼 = .vendor_kit/ 裡 vendor_kit 自己的 tracked 五檔（entry.just、vendor.just、log.sh、.gitignore、ci/check.sh；首行自描述）；引擎 ref = version.toml 的 vendor_kit 正規行指到的引擎 image 版本（啟動器 grep 命中須恰 1；「第一行」只是 install 寫出慣例，§4.1）"),
 ("gen/ 三種檔", "gen/tools.just：每個 <ns>.just 一行 mod?，sync／add／remove／upgrade 重生；gen/.stamp：只記引擎 ref，只由 install／upgrade vendor_kit 寫；gen/<repo>.stamp：每工具印記（第一行 index digest 或 path:，之後每檔 sha256）"),
 ("materialize／印記／index digest", "把啟動器 docker create/cp 取來的 /dist/<repo> 展開到 cache/<repo>/；印記 gen/<repo>.stamp 第一行 = index digest（多架構 image 總目錄的 sha256 ID；dev 時是 path:<dir>）"),
 ("image tag／digest／image ID／image inspect", "tag = 人看的版本名（可重 build）；digest = 從倉庫拉來的內容 sha256（鎖定用）；image ID = 本機 image 內容的 ID；啟動器每次 docker run 前先 inspect：本機有 → 不 pull；引擎覆寫時 .Id 必須等於 version.local.toml 記的 image ID，否則 1"),
 ("verify／sha256", "sha256 = 檔案內容算出的指紋；verify 把 cache/<repo>/ 每個檔的 sha256 跟印記比；不符 → 重裝 + warn（使用者不可改 cache/）；只在 sync --verify、CI 為真、或版本變動那次做；cache 缺或印記變了就直接重裝，不 verify"),
 ("metadata／完成標記／落後", "baseline/<repo>/.vendor_kit.toml：無完成標記 = add 沒做完 → 1「<repo> 未完成接入，請執行：just vendor_kit add <repo>」（6-13）；最後合併版本 ≠ version.toml = 有人只改了 version.toml → 提示 upgrade（CI 為真 → 1 + 6-5）"),
 ("mod?／recipe", "mod? = 把工具的 just 檔掛成一個命名空間（just <ns> …）的那一行；帶問號 = 檔不在也不掛、其他 recipe 與修復入口仍可跑（mod 指向缺檔會讓所有 just 呼叫掛掉）；recipe = justfile 裡的一條指令；gen/tools.just 只有 mod? 行、沒有 recipe"),
 SYM_T, E33_T,
 ("覆寫兩種（v2.1 B／v2.2 B）", "引擎覆寫 vendor_kit = \"<tag>\"＋image ID → 啟動器 inspect 驗 ID 後用該本機 image；工具覆寫 <repo> = \"path:<dir>\" → cache 是 symlink，仍查 metadata／baseline"),
 ("GHCR／image／daemon／flock", "GHCR = GitHub 容器倉庫；image = 打包好的 dist/；daemon = 主機的 docker 服務；flock = 專案目錄鎖（60 秒），鎖在引擎"),
 *LOGT, EXIT3,
]
def _t6(*drop): return [t for t in T6 if not t[0].startswith(drop)]
N6 = "已定（Q10 (2)、v2.3 §2）：薄殼／gen 與 version.toml 引擎不符 → 啟動器只回 1 提示 just vendor_kit upgrade vendor_kit（需要人動作）；install／upgrade vendor_kit 跳過這關。已定（v2.5 §9、Q22）：sync 可寫範圍 = cache/<repo>/、gen/tools.just、gen/<repo>.stamp；啟動器先 grep 快路徑（全相符不起容器）；每檔 sha256 只在 sync --verify、CI 為真、版本變動那次才做（§3.6）。"
p6, F = newpage("流程 v2：sync（1）啟動器：gen/.stamp 比對 → 快路徑（Q22）→ 起引擎（§6、v2.3 §2、v2.5 §9、v2.6）", N6, COLS5)
b = F.band("eA", "sync（recipe 自動前置；CI 為真 → frozen）第 1 段：launcher_start → 比對 gen/.stamp（install／upgrade vendor_kit 跳過）→ 快路徑 grep 全相符 → 寫 sync_fast_path → 0；有差 → inspect／pull → 引擎 resolve sync（「sync（1′）」頁）", v2=True)
b.box("n0", U, 0, G12, "打工具 recipe（_sync 自動前置）或 just vendor_kit sync", 220)
b.box("n0l", L, 0, v2(W12), fl("建 log 檔並寫 launcher_start（失敗 → 1 + 6-38，零寫入）"), 220)
b.box("n1", L, 1, v2(W12), fl("grep version.toml 的 vendor_kit 正規行取引擎 ref（命中須恰 1；version.local.toml 覆寫優先）"), 280)   # r12：正規行，不是「第一行」（§4.1）
b.files("n2", P, 1, "讀", [".vendor_kit/version.toml（進 git）", ".vendor_kit/version.local.toml（不進 git，dev 用）"], 360)
b.box("n3", L, 2, v2(D12), fl("gen/.stamp 的引擎 ref ＝ 正規行？（缺 gen/.stamp → 改讀薄殼首行 engine=）"), 280)   # r12：fresh clone 缺 gen/.stamp（§4.4／6-1）
b.box("n6", P, 2, v2(RULE), fl("統一提示（Q10 (2)、v2.3 §2）：啟動器發現 gen/.stamp ≠ 引擎 ref → 退出 1 印 6-1「vendor_kit 已更新 vX → vY，請執行：just vendor_kit upgrade vendor_kit」；不自動重寫、不自動續跑；install／upgrade vendor_kit 不受此關"), 360)
b.box("nq", L, 3, v2(D12), fl("快路徑：grep 全相符且非 frozen？"), 240, ax=20)
b.box("nqr", P, 3, v2(RULE), fl("快路徑（Q22）：啟動器只 grep：[tools] 每行 digest == gen/<repo>.stamp 第一行（或 path:<dir>）；gen/tools.just 存在；無 .tmp.<verb>.*.toml；CI 不為真；sync 無參數。全相符 → 寫 log 後 0；否則起引擎；每檔 sha256 只在 sync --verify、CI 為真、或版本變動的那次才做（§3.6）"), 360)
b.box("nqf", L, 4, v2(W12), fl("是：log 檔寫 sync_fast_path"), 100, ax="l")   # r12：拆出 launcher_exit（頁尾）
b.box("n6b", P, 4, v2(RULE), fl("薄殼重產（v2.2 A、Q10 (2)、Q17）：只由 install 與 upgrade vendor_kit 做；做之前比對現內容 == 上次產物（首行自描述 hash），相同 → 重產，被改過 → 1 列差異不動；sync 永不寫薄殼"), 360)
b.box("n1i", L, 5, v2(D12), "否 → docker image inspect：本機有？", 180, ax=50)
b.box("n1p", L, 6, v2(W12), "無：docker pull <引擎 ref>", 120, ax="r")
b.box("n1g", G, 6, IMG, "vendor_kit:vN@sha256:…\n（引擎 image）", 220)
b.box("n1v", L, 7, v2(D12), fl("覆寫中且 .Id ≠ 記的 image ID？"), 180, ax=50)
b.box("n1z", L, 8, LBL, "否 ↓ 續「sync（1′）」頁：docker run <引擎> resolve sync → engine_start", 280, 24, ax="l", minh=24)   # r12：docker run 移到 sync（1′）頁首（pull 失敗線可走右匯流排）
footer(b, F, 9, [("nq0", v2(G12), fl("0：不起容器，接著跑原本的 recipe（快路徑）")), ("n3n", v2(O12), fl("1 + 6-1：vendor_kit 已更新 vX → vY，請執行 just vendor_kit upgrade vendor_kit")), ("n1x", v2(R12), fl("1：拉不到／image ID 不符（同 tag 重 build）"))])
b.H("ne1", "n0", "n0l"); b.D("ne1l", "n0l", "n1", al=True); b.H("ne2", "n1", "n2", "讀"); b.D("ne3", "n1", "n3", al=True)   # launcher_start（v2.12）
