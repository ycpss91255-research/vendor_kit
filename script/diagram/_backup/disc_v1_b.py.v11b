b.box("i4_5", E, 9, v2(SUB), fl("產 config.toml 到暫存（含註解與預設 schema=1、[log] keep=50、days=30；已有 → 不產、不動，v2.12）"), 400)
b.box("i4en", E, 10, v2(W12), "否：第一次 = 全新建", 120, ax="l")
