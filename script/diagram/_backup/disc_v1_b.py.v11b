b.H("ce1", "c0", "c0l"); b.D("ce1l", "c0l", "c1", al=True); b.H("ce2", "c1", "c1e"); b.D("ce2e", "c1e", "c2a"); b.D("ce2b", "c2a", "c2b"); b.H("ce3", "c2b", "c3", "查")   # launcher_start／engine_start（v2.12）
