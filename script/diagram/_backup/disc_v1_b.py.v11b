b.D("de2y", "d1b", "d1c", "有", al=True); b.D("de2p", "d1p", "d1c", al=True); b.D("de2d", "d1c", "d1d"); b.D("de2e", "d1d", "d1e"); b.D("de2f", "d1e", "d1f")
