b.D("de5", "d2b", "d2c", "是", 0.3, 0.5); b.D("de6", "d2b", "d3b", "否", 0.7, 0.5, al=True); b.H("de7", "d2c", "d3c", "否")
b.D("de8", "d2c", "d6a", "是", al=True); b.D("de8b", "d6a", "d6"); b.H("de9", "d6", "d6f", "寫"); b.D("de10", "d6", "d7"); b.H("de11", "d7", "d7f", "寫")
