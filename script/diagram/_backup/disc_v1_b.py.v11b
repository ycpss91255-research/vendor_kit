b.box("c2d", E, 10, v2(SUB), fl("產生輸入指紋（version.toml、metadata、要動的使用者檔 hash、鎖定 digest）→ 計畫＋指紋以 stdout 回啟動器"), 400)
b.box("c9a", L, 11, v2(D12), "docker image inspect：本機有？", 170, ax="l")
b.box("c9p", L, 12, v2(W12), "無：docker pull", 100, ax="r")
