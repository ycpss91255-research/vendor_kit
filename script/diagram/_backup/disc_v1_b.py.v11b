b.files("a10f", P, 6, "add 寫（每個工具；見「add（2）」頁）", ["version.toml [tools] 行", "cache/<repo>/", "gen/<repo>.stamp", "初始檔（init.toml 的 dest）", "baseline/<repo>/ + .vendor_kit.toml", "gen/tools.just（重生，mod? 行）"], 360)
