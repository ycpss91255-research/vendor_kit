b.box("s2ln", L, 9, v2(D12), "是 → docker image inspect：本機有？", 220, ax=50)
b.box("s2lp", L, 10, v2(W12), "無：docker pull 新引擎", 80, ax="r")
b.box("s2gi", G, 10, IMG, "vendor_kit:vY\n（新引擎）", 200)
