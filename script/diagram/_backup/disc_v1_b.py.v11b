# ================= P5ccc：bootstrap.sh（2）=================
p5d, F = newpage("流程 v2：bootstrap.sh（2）--local 記錄 → 逐工具 add → 彙總（§2、v2.2 C、v2.5 §8、v2.6 Q26／Q27）", N5, COLS5B)
b = F.band("bA2", "5a′ bootstrap.sh 後半（承「bootstrap.sh（1）」頁）：--local → 寫 version.local.toml → 對每個 -t 呼叫 add（resolve → docker → apply）→ 本次 add 失敗 → 立即中止 1（後續 -t 不執行）；全部成功 → 0；不自刪", v2=True)
