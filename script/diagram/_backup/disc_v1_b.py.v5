b.box("i11f", P, 11, F12, "justfile（尾端＋一行）：\nimport '.vendor_kit/entry.just'", 360)
b.H("ie1", "i0", "i1"); b.D("ie2", "i1", "i2"); b.H("ie3", "i2", "i3", "否")
