foot(p5, "p5", F.y, [
 ("bootstrap.sh", "release 附的 POSIX sh 薄層：檢查 git repo／just ≥ 1.33 → docker pull 引擎（--local 用本機 image）→ 呼叫 install（失敗即中止）→ 對每個 --tool 呼叫 add；再跑 = install"),
 ("release／tar／docker load", "release = GitHub 上發布的一版（附 bootstrap.sh）；tar = 離線包（docker save 存的 image 檔）；docker load = 把 tar 讀進本機 docker"),
 ("GHCR／image／引擎 ref", "GHCR = GitHub 的容器倉庫；image = 打包好的檔案集；引擎 ref = version.toml 第一行指到的引擎 image（ghcr.io/…/vendor_kit:vN@sha256:…）"),
 ("image ID", "本機 image 內容的 ID；--local 時與 tag 一起記進 version.local.toml，同一個 tag 重新 build 過才會被發現"),
 ("install／uninstall", "專案層一對（vendor_kit 自己）：把 vendor_kit 裝進這個 git repo（建 .vendor_kit/ 各檔＋根 justfile 一行）／全部拆掉；再跑 install = 修復（用引擎重寫薄殼，不是只補缺）"),
 ("薄殼 .vendor_kit/", ".gitignore、entry.just、vendor.just、ci/check.sh（進 git；vendor_kit 自己的檔，人不改）＋ version.toml、baseline/（進 git）＋ cache/、gen/、version.local.toml（不進 git）"),
 ("gen/.stamp／hash", "不進 git；記引擎 ref 與上次產出的薄殼各檔 hash（內容指紋）；只由 install／upgrade vendor_kit 寫；再跑 install 先比對「現內容 == 上次產物」，被改過 → 1 列差異不動"),
 ("暫存目錄／原子替換", "先寫到暫存目錄，確認沒問題再逐檔一次換上；第一次 install 失敗 → 丟棄暫存，專案不留任何檔（只對第一次 install 成立）"),
 ("version.toml／version.local.toml", "version.toml 唯一來源（進 git）：第一行引擎 ref、[tools] 每工具一行 tag@digest；local 不進 git：dev 覆寫（工具 path:<dir>，或引擎 image tag + image ID）"),
 ("resolve／apply", "會動 image 的動詞分兩段：resolve 只讀只算（查版本、算要拉哪些 image，不寫檔）→ 啟動器 docker 拉 image → apply 才寫檔（拿鎖、重驗後）；見「add」頁"),
 ("baseline／metadata", "baseline/<repo>/ = 上次合併的範本副本（進 git）；metadata = 其中的 .vendor_kit.toml，記來源版本、完成標記、append 過的行；install 只建空的 baseline/"),
 ("just／recipe／import", "just = 跑指令的工具（像 make）；recipe = justfile 裡的一條指令；import = 把另一個 just 檔載進根 justfile 的那一行"),
 ("docker pull／run／--pull never", "pull = 從 GHCR 下載 image；run = 用 image 起容器跑引擎；--pull never = 只用本機 image，不去 GHCR 拉；多架構 image 由主機 docker 挑原生平台"),
 ("flock／-y", "flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎，啟動器不鎖；-y = 免問（§1：對使用者的檔可建、要改先問、永不刪、永不覆蓋）"),
], ALL - {"inv", "tree"})
pages_v1_b.append(("v1p5", "流程 v2：bootstrap.sh + install", p5))

# ================= P5b：add =================
p5b = [v("title", "1", TITLE, "流程 v2：add <repo> ── §2、§5、v2.2 C／E、v2.3 §1／§3／§6（<repo> = 工具 repo 名）", 40, 20, 1000, 34)]
ny = pend(p5b, "已定（Q12，v2.3 §1）：init.toml 每個 [[file]] 的欄位 strategy = \"copy\" | \"append\"（預設 copy）；append 首次確認後加入並記在 metadata，重跑不重複。\n已定（v2.3 §3）：每工具印記在 gen/<repo>.stamp，cache/<repo>/ 只放展開內容。", style=NOTE)
F = Flow(p5b, COLS5); F.headers(ny + 8)
b = F.band("bB", "5b add <repo>（bootstrap.sh 對每個 --tool 呼叫；平時使用者也直接打）= 引擎 resolve（不寫）→ 啟動器 docker → 引擎 apply（-n = apply --dry-run 唯讀預覽）", v2=True)
b.box("c0", U, 0, G12, "just vendor_kit add <repo>（-y -n…）", 220)
b.box("c1", L, 0, v2(W12), fl("docker run <引擎> resolve add <repo>\n（--local <tar> 先 docker load）"), 280)
b.box("c2", E, 0, v2(SUB), fl("resolve（不寫任何檔）：讀 version.toml；查 tag（預設最新／-t）與 digest（-s 改來源）→ stdout：要拉的 image@digest ＋ 輸入指紋（version.toml、metadata、要動的使用者檔 hash、鎖定 digest）"), 400)
b.box("c3", G, 0, IMG, "ghcr.io/<org>/<repo>-dist\n（工具 image；多架構 index digest）", 220)
