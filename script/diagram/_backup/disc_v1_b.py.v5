b.box("i4f", P, 4, F12, "＋.vendor_kit/{.gitignore, entry.just, vendor.just, ci/check.sh}（進 git）", 360)
b.box("i4c", E, 5, v2(SUB), fl("寫 version.toml 第一行 = 引擎 ref（已有則不動）"), 400)
b.box("i4cf", P, 5, F12, "＋version.toml 第一行（進 git）", 360)
b.box("i4d", E, 6, v2(SUB), fl("寫 gen/.stamp（引擎 ref＋薄殼各檔 hash）"), 400)
b.box("i4df", P, 6, F12, "＋gen/.stamp（不進 git）", 360)
b.box("i5y", U, 7, v2(G12), "是 → 0：只印指示（請自行加那一行）", 220)
b.box("i5", E, 7, v2(D12), "--no-justfile？", 250, ax="l")
b.box("i6", E, 8, D12, "有根 justfile？", 240, ax="l")
b.box("i7", E, 8, W12, "無：建 justfile（2 行）並印出 → 0", 140, ax="r")
b.box("i7f", P, 8, F12, "＋justfile（新建，2 行）：\nimport '.vendor_kit/entry.just'\ndefault: @just --list", 360)
b.box("i9", U, 9, v2(G12), "是 → 0：不再加（冪等）", 220)
