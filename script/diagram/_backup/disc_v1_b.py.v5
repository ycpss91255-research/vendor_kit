b.box("a9x", U, 7, v2(R12), "是 → 1：中止（第一次不留半成品）", 220)
b.box("a9q", L, 7, v2(D12), "install 失敗？", 260, ax="r")
b.box("a10", L, 8, W12, fl("否：對每個 --tool 呼叫 add（resolve → docker → apply）"), 280, ax="l")
b.box("a10e", E, 8, SUB, "add <repo>（見「add」頁）：resolve → 啟動器 docker → apply", 400)
b.box("a10f", P, 8, F12, "＋每個工具：version.toml [tools] 行、cache/<repo>/、gen/<repo>.stamp、初始檔、baseline/<repo>/", 360)
b.box("a12", U, 9, v2(R12), fl("是 → 1：明列已完成／未完成"), 220)
b.box("a11", L, 9, D12, "任一 add 失敗？", 260, ax="r")
b.box("a13", U, 10, G12, "0：印摘要與要 git add 的清單", 220)
b.D("ae1", "a0", "a1"); b.H("ae2", "a1", "a2", "否"); b.D("ae3", "a1", "a3", "是")
b.H("ae4", "a3", "a4", "否"); b.D("ae5", "a3", "a5", "是", al=True); b.H("ae6", "a5", "a8", "是")
b.D("ae8", "a8", "a8b", al=True); b.H("ae8f", "a8b", "a8f", "寫")
