b.box("i2", E, 1, D12, "是 git repo？", 220, ax="l")
b.box("i4", E, 2, v2(SUB), fl("flock 專案目錄 → 產薄殼四檔到暫存\n（.gitignore、entry.just、vendor.just、ci/check.sh）"), 400)
