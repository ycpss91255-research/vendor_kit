b.D("ie6", "i4q", "i4b", "否", al=True); b.H("ie6f", "i4b", "i4f", "寫"); b.D("ie6c", "i4b", "i4c"); b.H("ie6cf", "i4c", "i4cf", "寫")
b.D("ie6d", "i4c", "i4d"); b.H("ie6df", "i4d", "i4df", "寫"); b.D("ie7", "i4d", "i5", al=True); b.H("ie8", "i5", "i5y", "是"); b.D("ie9", "i5", "i6", "否", al=True)
