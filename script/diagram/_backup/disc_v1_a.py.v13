yr = tbl(tmp, "p3_vkt", "p3L2", RX3, y, VK_COLS, VK_ROWS, marks={(3, 0), (5, 0), (6, 0)})
y = max(y + vkh + 8 + vnh, yr) + 14
y = rbox(tmp, "p3_vkr", "p3L2", RULE, VK_R, 30, y, 1510, tagged=True)
y = pair("p3_self", SELF_T, "p3_fast", FAST_T, y)
y = pair("p3_compat", COMPAT_T, "p3_env", ENVR_T, y)
l2h = y + 6
p3b.append(v("p3L2", "1", SW(NEUTRAL), "契約④ 啟動器 ↔ 引擎（每格一件事；① 啟動器 grep → ② resolve → ③ 主機 docker → ④ apply；規則框 = §3、§5 逐條）", 40, Y, 1560, l2h))
# 第一列
x = 30
p3b.append(v("s0a", "p3L2", L12, S0A, x, r1c - h1["s0a"] / 2, W1["s0a"], h1["s0a"])); x += W1["s0a"] + 24
p3b.append(v("s0b", "p3L2", L12, S0B, x, r1c - h1["s0b"] / 2, W1["s0b"], h1["s0b"])); x += W1["s0b"] + 24
