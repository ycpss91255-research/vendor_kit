VL_META = "不進 git（自有 .gitignore 擋）；與 version.toml 同形（同一套讀寫器）；寫入者 dev／undev／bootstrap --local；uninstall 刪；最後一個覆寫撤掉後 undev 刪除整個檔；不交 Renovate；frozen 下存在任何覆寫 → sync 回 1；啟動器先讀它再退回 version.toml"
GEN_ROWS = [
 ["gen/.stamp", "只由 install／upgrade vendor_kit", "第一行 = 產生薄殼的引擎 ref（local 覆寫時為 <tag>），供 sync grep 快速比對；不承擔薄殼 hash；fresh clone 缺此檔時相容判定改用薄殼自描述首行"],
 ["gen/<repo>.stamp", "materialize", "第一行 = 多架構 index digest sha256:<hex64>（與 version.toml 一致；add --local 亦為正式 index digest，本機驗證用 metadata local_image_id）或 dev 時 path:<dir>；無 image:<tag> 形；之後每檔一行 <sha256>  <相對路徑>；verify 逐檔比"],
 ["gen/tools.just", "sync／add／remove／upgrade 重生；最後寫、與 cache 同一 apply 內原子替換", "每個 <ns>.just 一行 mod? <ns> '../cache/<repo>/just/<ns>.just'（一工具可多行），每行上方一行 # <description>；零 set 零 recipe"],
]
GC = [("檔", 180), ("寫入者", 180), ("內容", 390)]
SH_ROWS = [
 ["自描述首行", "entry.just／vendor.just／log.sh／.gitignore 第一行、ci/check.sh 第二行（第一行 shebang）：# vendor_kit-shell/<P> engine=<vX> sha256=<hash>；hash = 首行（含其換行）之後全部位元組 CRLF→LF 正規化後的 sha256；引擎重算比對 + 對 image 內薄殼模板二次比對；不符 → 1 印 6-28 列差異不動；mode 變更只 warn"],
 ["entry.just", "mod vendor_kit 'vendor.just' + import? 'gen/tools.just'；零 set 零 recipe"],
 ["vendor.just", "動詞 recipe 一行轉發 + 啟動器本體（POSIX sh recipe）；set positional-arguments 只放這"],
 [".gitignore", "cache/、gen/、version.local.toml、.tmp.*"],
 ["ci/check.sh", "契約⑤ p3c：shebang、自描述、export CI=1、⓪–⑤ 六步"],
