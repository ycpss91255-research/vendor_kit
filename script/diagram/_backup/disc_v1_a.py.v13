tmp += vt("p3_off", "p3L4", RULE, OFF_T, 790, y, 750, ch_, tagged=True)
y += ch_ + 20
p3.append(v("p3L4", "1", SW(NEUTRAL), "契約③ 工具 repo 要交的（dist 佈局、init.toml、_sync、Dockerfile.dist、image 與 label、離線包）", 40, Y, 1560, y))
