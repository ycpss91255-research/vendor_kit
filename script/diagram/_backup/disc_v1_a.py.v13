p4.append(e("w_vl", "m_ver", "f_vl", "覆寫行（path:／\ntag + image ID）", rel("m_ver", fmid("f_vl")), (0, 0.5), both=True))
p4.append(e("w_repo", "m_mat", "f_repo", "展開的工具檔\n（整批替換）", rel("m_mat", fmid("f_repo")), (0, 0.5)))
p4.append(e("w_stamp", "m_mat", "f_stamp", "index digest\n+ 每檔 sha256", rel("m_mat", fmid("f_stamp")), (0, 0.5), both=True))
p4.append(e("w_bl", "m_bl", "f_bl", "範本副本、metadata", rel("m_bl", fmid("f_bl")), (0, 0.5), both=True))
gy_ = R["im"][0] + R["im"][1] / 2
p4.append(e("w_user", "grp_im", "f_user", "初始檔內容\n（現況／結果）", (1, 0.5), (0, round((gy_ - P["f_user"]) / next(h for q, y, h in pf if q == "f_user"), 4)), both=True))
p4.append(e("w_just", "m_lg", "f_just", "import 那一行", rel("m_lg", fmid("f_just")), (0, 0.5), both=True))
p4.append(e("w_di", "m_lg", "f_di", ".dockerignore\n四行", rel("m_lg", fmid("f_di")), (0, 0.5), both=True))
p4.append(e("w_shell", "m_lg", "f_shell", "薄殼五檔內容\n（首行／模板）", rel("m_lg", fmid("f_shell")), (0, 0.5), both=True))
p4.append(e("w_gen", "m_lg", "f_gen", "tools.just、\n.stamp 內容", rel("m_lg", fmid("f_gen")), (0, 0.5)))
# ---- 跨區的線（啟動器 ↔ 引擎／registry／專案檔）----
# 啟動器底邊出兩條到引擎：mount（x=540，進容器左框）、run_cli（x=560，進 cli 左框；run 先進、mount 在下，兩線不交叉）
MXX, RXX = 540, 560
Y_R, Y_M = LY + 110, LY + 150
pts = [(MXX, HB), (MXX, Y_M), (EX, Y_M)]
p4.append(ew("mount_dist", "h4", "p4E", "-v .tmp.dist.<id>/\n→ /dist/<repo>（唯讀）", (round((MXX - HX) / HW4, 4), 1), (0, round((Y_M - LY) / LH, 4)), pts[1:-1], lab="left", pos=pos_at(pts, 0, y=HB + 22)))
pts = [(RXX, HB), (RXX, Y_R), (EX + 20, Y_R)]
