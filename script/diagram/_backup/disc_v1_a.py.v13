# 第二列
d1c = d1x + W1["d1"] / 2
ERR_X = 30
p3b.append(v("p3_err", "p3L2", ELLIPSE(ORANGE) + "fontSize=12;", ERR, ERR_X, r2y, ERR_W, eh))
AX, AY = 40, Y
midy_err = AY + 50 + row1h + 18
p3b.append(ew("p3_err_e", "d1", "p3_err", "否", (0.5, 1), (0.5, 0), [(AX + d1c, midy_err), (AX + ERR_X + ERR_W / 2, midy_err)], pos=-0.85))
d2x = ERR_X + ERR_W + 24
p3b.append(v("d2", "p3L2", RHOMBUS + "fontSize=12;", D2_T, d2x, r2c - d2h / 2, D2W, d2h))
g2x = d2x + D2W + 24
g2w = GP + W2["s3a"] + 16 + W2["s3b"] + 16 + W2["s3c"] + 16 + W2["s3d"] + 16 + W2["s3e"] + GP + 12
g2y = r2c - GT - GP - ih2 / 2
p3b.append(v("g3", "p3L2", GRP_T, "③ 主機 docker（每筆 pull／extract；不帶 --platform；先收完 vk-resolve 驗文法才動）", g2x, g2y, g2w, g2h))
ux = GP
for pid, t in (("s3a", S3A), ("s3b", S3B), ("s3c", S3C), ("s3d", S3D), ("s3e", S3E)):
    p3b.append(v(pid, "g3", L12, t, ux, GT + GP + (ih2 - h2[pid]) / 2, W2[pid], h2[pid])); ux += W2[pid] + 16
x = g2x + g2w + 24
