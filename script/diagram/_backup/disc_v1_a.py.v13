for i, s in enumerate(["子命令解析", "--protocol P", "resolve／apply", "詢問／-y／tty", "結束碼 0/1/2/3", "呼叫其他模組"]):
    p4.append(v(f"m_cli_u{i}", "p4E", UNIT, s, 30, CLI_Y + 30 + i * 30, 120, 24))
def fy(yrel): return round((yrel - CLI_Y) / CLI_H, 4)
mid = lambda k: R[k][0] + R[k][1] / 2
p4.append(e("d_log", "m_cli", "m_log", "log_event()\n事件名、k=v", (1, fy(mid("m_log"))), (0, 0.5)))
