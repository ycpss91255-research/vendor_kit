Y = LY + LH + 76
Y = footer(p4, "p4", Y, ["v3img", "v4mod", "v4unit", "v4host", "v4hgrp", "v4pgrp", "ruleb", "v2git", "v2no", "v2usr", "v2code", "v2tag", "v4frame", "v4other", "notep"],
 "實線 = 資料流（線上文字 = 傳什麼）\n雙箭頭 = 讀寫／來回都有；黃橢圓 = 使用者；載入／執行順序與判斷見流程頁",
 ["engine", "launcher", "cli", "version", "registry", "materialize", "initmerge", "baselinemod", "launchergen", "logmod", "logfile", "configtoml", "traceid", "indexdigest", "tmp", "mount"])
