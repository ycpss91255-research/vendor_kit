], marks={(0, 0), (1, 6), (2, 6), (3, 6), (4, 6), (5, 0), (6, 0), (7, 0), (8, 0), (10, 0)}) + 14
RD_T = ("<b>version.toml 怎麼被讀</b>\n・啟動器（sh）：以正規行 regex 於 version.local.toml（覆寫優先）→ version.toml 取 vendor_kit；命中數 ≠ 1 → 1；不解析 TOML（resolve 的 vk-resolve 才是它的輸入）；快路徑用 grep 比 gen/*.stamp\n"
 "・引擎 version 模組：TOML 讀寫（schema 轉換）+ version.local.toml 覆寫；flock；apply 最後才寫 version.toml\n"
 "・Renovate preset：regex manager（**/.vendor_kit/version.toml；key regex 與正規行契約共用）+ docker datasource，同時擷取 currentValue（tag）與 currentDigest；PR 只改一行；major 分開 PR\n"
 "・deploy：交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR（工具契約一句；vendor_kit 不檢查）；version.toml 公開格式可供來源紀錄")
SUM_T = ("<b>規則摘要</b>\n・version.toml 是唯一來源：sync 拿它對印記，不一致就 materialize（只拉鎖定版）；apply 拿鎖後先重驗 resolve 給的輸入指紋，不同 → 1 印 6-12\n"
 "・自動化（sync）只碰 cache/<repo>/、gen/tools.just、gen/<repo>.stamp：不碰使用者的檔、不寫薄殼、不寫 gen/.stamp；薄殼 ≠ 引擎 ref → 1 印 6-1（install／upgrade vendor_kit 不被擋）\n"
 "・baseline 是上次合併的歷史狀態，不由 version.toml 推導（待合併時 version 已 B、baseline 仍 A）\n"
 "・進 git 的只有：根 justfile 那行、根 .dockerignore 四行、.vendor_kit/（不含 cache/、gen/、version.local.toml、.tmp.*）、初始檔；人只改：justfile、初始檔、version.toml（手動升版）\n"
 "・舊薄殼（--protocol P 太舊）跑新 major 引擎的一般動詞 → 3 零寫入（6-36）；救援路徑永遠可用")
rh_ = max(hvt(RD_T, 750, True), hvt(SUM_T, 750, True))
tmp += vt("p2c_reno", "p2C", RULE, RD_T, 20, y, 750, rh_, tagged=True)
tmp += vt("p2c_rule", "p2C", RULE, SUM_T, 790, y, 750, rh_, tagged=True)
y += rh_ + 20
p2c.append(v("p2C", "1", SW(NEUTRAL), "5. 動詞 × 檔案（一列一動詞、一欄一檔；細節見 p1b 與流程頁）", 40, Y, 1560, y))
p2c += tmp
Y += y + 20
