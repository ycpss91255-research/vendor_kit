p4.append(e("d_ver", "m_cli", "m_ver", "version.toml 內容\n指紋", (1, fy(mid("m_ver"))), (0, 0.5), both=True))
p4.append(e("d_mat", "m_cli", "m_mat", "/dist 路徑、<repo>", (1, fy(mid("m_mat"))), (0, 0.5)))
p4.append(e("d_bl", "m_bl", "m_cli", "metadata", (0, 0.5), (1, fy(mid("m_bl"))), both=True))
p4.append(e("d_im", "m_cli", "grp_im", "檔案清單\n逐檔決定", (1, fy(mid("im"))), (0, 0.5), both=True))
p4.append(e("d_lg", "m_cli", "m_lg", "引擎 ref、動詞清單", (1, fy(mid("m_lg"))), (0, 0.5)))
p4.append(e("d_mat_bl", "m_mat", "m_bl", "cache 路徑、印記", (0.5, 1), (0.5, 0), vert=True))
p4.append(e("d_im_bl", "grp_im", "m_bl", "檔案清單、逐檔決定", (0.5, 0), (0.5, 1), vert=True))
# ---- 專案目錄（平面分組框，標題靠右上：左上留給啟動器兩條線進 config.toml／log/）----
p4.append(v("p4P", "1", GRPB(GREEN), "專案根（掛載為 /repo）", PX, LY, PW, LH))
p4 += p4_files
def fmid(pid):
    for q, y, h in pf:
        if q == pid: return y + h / 2
def rel(pid_mod, yabs): return (1, round((yabs - R[pid_mod][0]) / R[pid_mod][1], 4))
p4.append(e("w_cfg", "f_cfg", "m_log", "config_read\n（TOML parser）", (0, 0.5), rel("m_log", fmid("f_cfg"))))
p4.append(e("w_log", "m_log", "f_log", "engine_* 事件\n（append 同一檔）", rel("m_log", fmid("f_log")), (0, 0.5)))
