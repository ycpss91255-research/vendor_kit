Y = footer(p3, "p3", Y, ["v3img", "v2code", "ruleb", "tblh", "grpbox", "v2tag", "notep"], "紫 = image（工具／引擎）\n淺灰底容器 = 契約③ 全部",
 ["dist", "dockerfiledist", "label", "dest", "append", "crlf", "symlink", "syncrecipe", "justdirs", "buildx", "indexdigest", "checkdist", "digestfile", "offline", "deploy", "ns", "semver"])
