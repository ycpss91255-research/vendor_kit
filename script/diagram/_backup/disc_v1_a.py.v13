# ---- 引擎模組（先算高度）----
EX, EW = 600, 560
MX, MW = 290, 250
MOD = refill(L12, RED) + "align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;"
mods = [
 ("m_reg", "<b>registry</b>：查 GHCR", ["查 tag（SemVer 最大正式版）", "查 index digest", "token／token file", "逾時"], True),
 ("m_ver", "<b>version</b>：version.toml 讀寫", ["讀 toml（正規行）", "寫 toml", "schema 轉換", "flock", "指紋", "進度日誌", "label／keep"], True),
 ("m_mat", "<b>materialize</b>：/dist → cache/<repo>/", ["展開 /dist", "路徑驗證", "印記 gen/<repo>.stamp", "verify sha256"], True),
 ("m_bl", "<b>baseline</b>：baseline/<repo>/ + metadata", ["範本副本", "metadata", "五態 state", "declined_hash", "conflicts"], True),
 ("im", None, None, None),
 ("m_lg", "<b>launcher-gen</b>：薄殼、gen/、根 justfile 一行、根 .dockerignore 四行", ["薄殼五檔", "自描述首行", "log.sh（產生）", "tools.just（mod?）", "check.sh", ".stamp", "justfile 四行", ".dockerignore 四行"], True),
 ("m_log", "<b>log</b>：操作紀錄（輔助模組）", ["log_event()", "Python logging", "log-events.txt", "跳脫"], True),
]
IM = [("m_mg", 296, 116, "<b>merge</b>：逐檔合併", ["狀態機", "merge-file"]), ("m_init", 422, 116, "<b>init</b>：初始檔", ["建檔", "append", "新檔詢問"])]
def title_h(t, w): return max(30, hvt(t, w, True, pad=6))          # 模組標題列高（兩行時單元下移）
def mod_h(labels, w, title=""): return title_h(title, w) + units_h(labels, w - 12) + 8
PX, PW = 1290, 310
FX, FW = 15, 275
def grp_h(items, title="", cols=1): return grp_title_h(title, FW, True) + 6 + math.ceil(len(items) / cols) * 28 + 4
def filegrp2(prefix, parent, style, title, items, x, y, w, tagged=True, cols=2):
    """檔案分組多欄版（短檔名省高度；cols = 2 或 3）。"""
    th = grp_title_h(title, w, tagged); ih = 24; rows = math.ceil(len(items) / cols)
    h = th + 6 + rows * (ih + 4) + 4; iw = (w - 30 - 8 * (cols - 1)) / cols
    cells = vt(prefix, parent, style, title, x, y, w, h, tagged=tagged)
    for i, it in enumerate(items):
        cells.append(v(f"{prefix}_f{i}", prefix, style.replace("fontStyle=1;", ""), it, 10 + (i % cols) * (iw + 8), th + 6 + (i // cols) * (ih + 4), iw, ih))
    return cells, h
FILES = {
 "m_ver": [("f_ver", "file", F_GIT, "version.toml（進 git）", 36), ("f_vl", "file", F_NOGIT, "version.local.toml（dev 覆寫）", 36)],
 "m_mat": [("f_repo", "grp2", F_NOGIT_T, "cache/<repo>/（不進 git，不可改）", ["files/…", "init.toml", "just/<ns>.just"]), ("f_stamp", "file", F_NOGIT, "gen/<repo>.stamp（印記）", 32)],
 "m_bl": [("f_bl", "grp", F_GIT_T, "baseline/<repo>/（進 git）", ["範本副本（上次合併的）", "metadata .vendor_kit.toml"])],
 "im": [("f_user", "grp", F_USER_T, "初始檔（使用者的，進 git；永不刪、永不覆蓋）", ["Dockerfile 等（copy）", "根 .gitignore 幾行（append）"])],
 "m_lg": [("f_just", "file", F_USER, "根 justfile（使用者的，進 git）\nimport 一行；新檔另有 default 兩行", 46), ("f_di", "file", F_USER, "根 .dockerignore（使用者的）\n四行（問後 append）", 44),
          ("f_shell", "grp2", F_GIT_T, "自有薄殼（進 git；首行自描述）", ["entry.just", "vendor.just", "log.sh", ".gitignore", "ci/check.sh"]), ("f_gen", "grp2", F_NOGIT_T, "gen/（不進 git；tools.just = mod? 行、.stamp = 引擎 ref）", ["tools.just", ".stamp"])],
}
# log 模組的兩個檔：log/ 分組在上、config.toml 窄框在下（右側留給啟動器的線從底邊進 log/）
F_CFG_W = 150; F_CFG_T = "config.toml（進 git）"; F_LOG_T = "log/（不進 git；自帶 .gitignore）"; F_LOG_I = ["<verb>/<UTC ts>-<id8>.jsonl", ".gitignore（*／!.gitignore）"]
log_files_h = 40 + 8 + grp_h(F_LOG_I, F_LOG_T)
def files_h(lst): return sum((grp_h(it, t) if k == "grp" else grp_h(it, t, 2) if k == "grp2" else grp_h(it, t, 3) if k == "grp3" else it) for _, k, _, t, it in lst) + 8 * (len(lst) - 1)
R = {}; ey = 50; MGAP = 14
for pid, t, us, tg in mods:
    if pid == "im": mh = max(mod_h(u, w, t_) for _, _, w, t_, u in IM) + 20
    else: mh = mod_h(us, MW, t)
    fh = log_files_h if pid == "m_log" else files_h(FILES.get(pid, []))
    h = max(mh, fh); R[pid] = (ey, h); ey += h + MGAP
eng_end = ey
pf = []; p4_files = []; P = {}
y = R["m_log"][0]
cells, h = filegrp("f_log", "p4P", F_NOGIT_T, F_LOG_T, F_LOG_I, FX, y, FW, tagged=True); p4_files += cells; pf.append(("f_log", y, h)); P["f_log"] = y; y += h + 8
p4_files += vt("f_cfg", "p4P", F_GIT, F_CFG_T, FX, y, F_CFG_W, 40, tagged=True); pf.append(("f_cfg", y, 40)); P["f_cfg"] = y
for pid_mod, lst in FILES.items():
    y = R[pid_mod][0]
    for fid, kind, st, title, it in lst:
        if kind == "grp":
            cells, h = filegrp(fid, "p4P", st, title, it, FX, y, FW, tagged=True)
        elif kind in ("grp2", "grp3"):
            cells, h = filegrp2(fid, "p4P", st, title, it, FX, y, FW, tagged=True, cols=int(kind[-1]))
        else:
            h = it; cells = vt(fid, "p4P", st, title, FX, y, FW, h, tagged=True)
        p4_files += cells; pf.append((fid, y, h)); P[fid] = y; y += h + 8
proj_end = ey
# ---- 主機（just 鏈與目錄；啟動器另在右上）----
HXo, HW = 40, 480
C1X, C1W, C2X, C2W = 20, 210, 240, 215
H0 = "使用者\n打 just vendor_kit <動詞> …\n或 just <ns> …"
H1 = "根 justfile（使用者的，進 git）\nimport '.vendor_kit/entry.just'"
H2 = ".vendor_kit/entry.just（進 git）\nmod vendor_kit 'vendor.just'\nimport? 'gen/tools.just'"
H3 = ".vendor_kit/vendor.just\n（進 git）動詞 recipe 一行轉發\n+ 啟動器本體（POSIX sh，含 log.sh）"
G1 = ".vendor_kit/gen/\ntools.just（不進 git）一行一命名空間\nmod? <ns> '../cache/<repo>/\njust/<ns>.just'"
G2 = "工具命名空間 just <ns> …\n= cache/<repo>/just/<ns>.just\n裡的 recipe"
TMP = "暫存 .vendor_kit/\n.tmp.dist.<id>/（專案內）\n工具 /dist 展開副本 + vk-resolve\n（啟動器 mktemp、trap 清）"
hh = {"h0": hve(H0, C1W), "h1": hv(H1, C1W), "h2": max(hv(H2, C1W), hvt(G1, C2W, True)), "h3": max(hv(H3, C1W, pad=8), hvt(G2, C2W, True))}
hy = {}; y0 = 40
for k in ("h0", "h1", "h2", "h3"):
    hy[k] = y0; y0 += hh[k] + 30
VK_T = (".vendor_kit/             # 契約② p2，根目錄只多這個\n"
 "├─ version.toml         # 進 git：唯一來源\n"
 "├─ version.local.toml   # 不進 git：dev 覆寫\n"
 "├─ config.toml          # 進 git：[log] keep／days\n"
 "├─ .gitignore           # 進 git：我們自己的\n"
 "├─ entry.just           # 進 git：mod + import?\n"
 "├─ vendor.just          # 進 git：動詞 + 啟動器\n"
 "├─ log.sh               # 進 git：啟動器 log 函式\n"
 "├─ ci/check.sh          # 進 git：CI 六步（⓪–⑤）\n"
 "├─ baseline/            # 進 git：<repo>/ 範本 + metadata\n"
 "├─ gen/                 # 不進 git：tools.just、.stamp、\n"
 "│                       #   <repo>.stamp（印記）\n"
 "├─ log/<verb>/          # 不進 git：<ts>-<id8>.jsonl\n"
 "├─ .tmp.<verb>.<id>.toml  # 不進 git：進度日誌\n"
 "├─ .tmp.dist.<id>/      # 不進 git：啟動器暫存\n"
 "└─ cache/<repo>/        # 不進 git：工具檔展開")
vkw = math.ceil(code_w(VK_T)) + 16; vkh = code_h(VK_T)
vky = y0
host_end = vky + vkh + 20
LH = max(eng_end, host_end, proj_end)
GRPB = lambda fill: refill(L12, fill) + "align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=1;fontSize=14;"
p4.append(v("p4H", "1", GRPB(NEUTRAL), "主機（使用者電腦／CI runner）── just 鏈與目錄", HXo, LY, HW, LH))
p4.append(v("h0", "p4H", ELLIPSE(YELLOW) + "fontSize=12;", H0, C1X, hy["h0"], C1W, hh["h0"]))
p4 += vt("h1", "p4H", F_USER, H1, C1X, hy["h1"], C1W, hh["h1"], tagged=True)
p4.append(v("h2", "p4H", F_GIT, H2, C1X, hy["h2"], C1W, hh["h2"]))
p4 += vt("h3", "p4H", F_GIT, H3, C1X, hy["h3"], C1W, hh["h3"], tagged=True)
cells, _, _ = code("h_vk", "p4H", VK_T, C1X, vky, vkw); p4 += cells
tmph = hv(TMP, C2W, pad=8)
p4.append(v("tmp", "p4H", L12, TMP, C2X, hy["h0"], C2W, tmph))
p4 += vt("g1", "p4H", F_NOGIT, G1, C2X, hy["h2"], C2W, hh["h2"], tagged=True)
p4 += vt("g2", "p4H", L12, G2, C2X, hy["h3"], C2W, hh["h3"], tagged=True)
# ---- 引擎容器 ----
p4.append(v("p4E", "1", PURPLE_SW.replace("fontSize=18", "fontSize=16"), "引擎容器 vendor_kit:vN（8 模組 + 輔助 log；一格一個最小單元）", EX, LY, EW, LH))
for pid, t, us, tg in mods:
    if pid == "im": continue
    y, h = R[pid]
    p4 += vt(pid, "p4E", MOD, t, MX, y, MW, h, tagged=tg)
    p4 += units(pid, "p4E", MX + 6, y + title_h(t, MW), MW - 12, us)
fy_, fh_ = R["im"]
for pid, x, w, t, us in IM:
    h = mod_h(us, w, t)
    p4 += vt(pid, "p4E", MOD, t, x, fy_ + 10, w, h, tagged=True)
    p4 += units(pid, "p4E", x + 6, fy_ + 10 + title_h(t, w), w - 12, us)
p4.append(v("grp_im", "p4E", FRAME, "", 290, fy_, 250, fh_))
CLI_Y, CLI_H = 50, eng_end - MGAP - 50
