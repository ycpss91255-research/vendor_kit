p3b.append(e("s1_e", "s0b", "s1", "", (1, 0.5), (0, 0.5)))
p3b.append(v("s1", "p3L2", L12, S1, x, r1c - h1["s1"] / 2, W1["s1"], h1["s1"])); x += W1["s1"] + 24
d1x = x
p3b.append(v("d1", "p3L2", RHOMBUS + "fontSize=12;", D1_T, x, r1c - h1["d1"] / 2, W1["d1"], h1["d1"])); x += W1["d1"] + 24
p3b.append(e("d1_e", "s1", "d1", "", (1, 0.5), (0, 0.5)))
g1x = x; g1w = GP + W1["s2z"] + 16 + W1["s2a"] + 16 + W1["s2b"] + 16 + W1["s2c"] + GP + 12
g1y = r1c - GT - GP - ih1 / 2
p3b.append(v("g2", "p3L2", GRP_T, "② docker run 引擎 resolve <動詞>（只讀、不寫檔、無 TTY；診斷走 stderr）", g1x, g1y, g1w, g1h))
ux = GP
for pid, t in (("s2z", S2Z), ("s2a", S2A), ("s2b", S2B), ("s2c", S2C)):
    p3b.append(v(pid, "g2", L12, t, ux, GT + GP + (ih1 - h1[pid]) / 2, W1[pid], h1[pid])); ux += W1[pid] + 16
p3b.append(e("s2z_e", "d1", "s2z", "是", (1, 0.5), (0, 0.5)))
p3b.append(e("s2a_e", "s2z", "s2a", "", (1, 0.5), (0, 0.5)))
