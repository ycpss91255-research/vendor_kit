def rlabel(pid, label, y):
    p2.append(v(f"{pid}_l", "1", LBL, label, RX, y, RW, 28)); return y + 32
NOTE_T = restroke(LT12, "#999999", 1)
def rex(pid, label, text, note, y, tagged=True, rx=None, rw=None):
    """範例：左 = 逐字框（pre、依最寬行定寬）、右 = 說明框（框外）；兩框等高。rx／rw 可指定放在別欄。"""
    rx = RX if rx is None else rx; rw = RW if rw is None else rw
    p2.append(v(f"{pid}_l", "1", LBL, label, rx, y, rw, 28)); y += 32
    cells, cw_, ch_ = code(pid, "1", text, rx, y, None, None, tagged=tagged)
    cw_ = max(cw_, 300); nx = rx + cw_ + 12; nw = rx + rw - nx
    nh = hv(note, nw)
    h = max(ch_, nh)
    cells, _, _ = code(pid, "1", text, rx, y, cw_, h, tagged=tagged)
    p2.extend(cells); p2.append(vb(f"{pid}_n", "1", NOTE_T, note, nx, y, nw, h))
    return y + h + 14
