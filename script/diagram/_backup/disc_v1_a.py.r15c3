Y = footer(p1b, "p1b", Y, ["v1c", "v1a", "v1o", "ruleb", "tblh", "grpbox", "v2tag", "notep"], "一列 = 一個動詞；「做什麼」欄一格一件事\n「反向」= 收回它做的事的動詞",
 ["digestfile", "inspect", "state5", "resolveapply", "N", "engine_changed"])   # 第 0 頁已有的詞不列
pages_v1_a.append(("v1p1b", "契約 v2：動詞介面表", p1b))

# ================= P1c v1p1c：契約① 規則、選項表、不開的動詞 =================
p1c = head("p1c", "契約① 下游使用者介面（3／3）── 規則、選項表（Q25）、結束碼（Q23／Q27）、不開的動詞、訊息文字（§6）", 1200)
c, Y = nopend("p1c", 1260, 12, 340, "選項與結束碼以 interface_spec §1.1／§2 為準；訊息文字 §6 逐字（本頁只列 p1／p1b 引用到的）")
p1c.append(c); Y = max(Y + 16, 96)
# ---- 左上：兩層成對 + 規則框；右上：選項總表 ----
PAIR = [
 ("專案層（vendor_kit 自己）", "install", "#ffffff", "uninstall", "#ffffff", True, ""),
 ("工具層", "add", GREEN, "remove", "#ffffff", True, ""),
 ("本機開發", "dev", GREEN, "undev", "#ffffff", True, ""),
 ("只查 → 套用（apt 語意）", "update", "#ffffff", "upgrade", GREEN, False, "前一步"),
]
PR_H = 30; PR_G = 8
NO_T = ("<b>不開的動詞與理由</b>\ninit（→ install）／ensure（→ sync）／diff（= upgrade --dry-run）／accept（解完衝突重跑 upgrade）／rollback（git revert）／"
 "--repair（併進 install 冪等修復）／--purge（明確不提供：永不刪專案檔；開 issue）／--porcelain（不做；v2 候選，本版無待拍板）／--tag（版本一律 <repo>@<tag>）／"
 "fetch、verify、merge（引擎內部步驟，不對外）")
SEM1 = ("<b>recipe 規則</b>\n動詞 recipe 一律 verb *args 一行轉發（set positional-arguments 只在 vendor.just）、放 tracked 的 vendor.just；[group('常用')]／[group('進階')]；"
 "每次呼叫引擎附 --protocol P（在子命令之前）；entry.just 與 gen/tools.just 只含 mod／mod?／import?，零 set 零 recipe（被 import 檔的 set 會外溢到根檔）")
SEM2 = ("<b>執行位置（Q20）</b>\n專案根 = 含 .vendor_kit/ 的目錄（monorepo 子專案各自一套；不是 git toplevel）；vendor_kit 動詞只准在專案根執行："
 "recipe 檢查 invocation_directory() == justfile_directory()，否則 1 印 6-9「請到 <dir> 執行」；sync 豁免（工具 _sync 已 cd 回專案根）；須在某 git repo 內；禁止巢狀（上層或下層已有 → 1 印 6-35）；引擎不讀 .git、不碰 index、不做 git init")
SEM3 = ("<b>兩段編排的兩個獨立屬性（p3b 契約④）</b>\n需展開 image（docker create/cp）= add／upgrade／sync／undev；兩段（resolve → 主機 docker → apply，重驗指紋）= add／remove／upgrade／sync／undev／uninstall／prune；"
 "單段 = install／upgrade vendor_kit／update／dev／help。--dry-run = apply --dry-run（也要先拉 image 展開）")
DRY = ("<b>--dry-run（所有頁一致）</b>\n唯讀預覽（仍拉 image 展開到暫存，讀 /dist/<repo>）：印會建／會問哪些檔、6-6～6-8、metadata 遷移；本機 → 0；CI 模式且需改 進 git 的檔 → 1 印清單（version.toml 不動；與 -y 無關）；"
 "-y 也不覆蓋既有未納管檔、不硬加 append 行；EOF 不算同意")
LW = 740
lh = {k: hvt(t, LW, True) for k, t in (("no", NO_T), ("s1", SEM1), ("s2", SEM2), ("s3", SEM3), ("dry", DRY))}
OPT_COLS = [("選項", 170), ("短形", 50), ("型別", 90), ("適用", 200), ("說明", 240)]
OPT_ROWS = [
 ["--tool <repo>[@<tag>]", "-t", "string，可重複", "bootstrap.sh", "接入的工具與版本；@<tag> 省略 = 最新正式版"],
 ["--yes", "-y", "bool", "bootstrap.sh、install、uninstall、add、remove、upgrade、prune", "免詢問（不解除CI 模式）"],
 ["--path <dir>", "-p", "string", "dev <repo>", "本機工具目錄"],
 ["--image <tag>", "-i", "string", "dev vendor_kit", "本機引擎 image tag（只能 tag）"],
 ["--help", "-h", "bool", "全部", "由引擎印；bootstrap.sh 自印"],
 ["--dry-run", "—", "bool", "uninstall、add、remove、upgrade、prune", "唯讀預覽（仍拉 image 展開）"],
 ["--source <image>", "—", "string", "add", "image 路徑不符 <org>/<repo>-dist 慣例時"],
 ["--local <image tag 或 tar>", "—", "string", "bootstrap.sh、add", "離線：tar 先 docker load；值的判別已定（含 / 或 .tar 結尾 → 檔案，其餘 → tag；見名詞表）"],
 ["--exit-code", "—", "bool", "update", "有新版回 2"],
 ["--timeout <秒>", "—", "正整數", "bootstrap.sh、add、upgrade、sync、undev", "= VENDOR_KIT_PULL_TIMEOUT，由啟動器攔截、不轉發引擎；優先於環境變數"],
 ["--no-justfile", "—", "bool", "install", "跳過根 justfile 步驟只印指示"],
 ["--protocol P", "—", "整數", "內部", "薄殼→引擎全域旗標，不列 help"],
 ["--verify", "—", "bool", "sync", "每檔 sha256 全驗（= CI 模式時的行為）；無參數 sync 走快路徑"],
]
OPT_NOTE = "版本一律寫在位置參數：<repo>@<tag>、vendor_kit@<tag>；@<tag> 比現版舊 → warn 仍執行。短選項只有 -t、-y、-p、-i、-h。"
otmp = []; oend = tbl(otmp, "p1C_opt", "p1C", 790, 50 + 32, OPT_COLS, OPT_ROWS, marks={(0, 0), (7, 0), (9, 0), (12, 0)}, bold0=False)
onh = hvt(OPT_NOTE, 750, True)
right_end = oend + 10 + onh
pair_h = 24 + len(PAIR) * (PR_H + PR_G)
left_end = 50 + pair_h + 10 + lh["no"] + 14 + lh["s1"] + 14 + lh["s2"] + 14 + lh["s3"] + 14 + lh["dry"]
# ---- 結束碼總表（全寬）----
EX_COLS = [("碼", 50), ("定義", 700), ("動詞例外／特例", 770)]
EX_ROWS = [
 ["0", "成功（含 warn）；add 已接入完成、remove 未接、undev 未啟用、upgrade vendor_kit 無新版且薄殼相符皆 0 + 提示", "—"],
 ["1", "一般失敗、需人處理／重跑；工具層動詞回 1 時 version.toml 不動", "自身升級：已改 version.toml 第一行後回 1（明列例外）；upgrade vendor_kit 重產薄殼後回 1 要求 commit 並重跑（6-2）；sync 薄殼不符回 1（6-1）；印記不符、薄殼被改（6-28）——既定回 1 的情境維持 1，不因提示含 upgrade 而改 3"],
 ["2", "合併衝突（留 <<<<<<< vendor_kit:baseline 標記、印檔名、基準版仍推到新版）", "update --exit-code 有新版回 2；合併結果 TOML／just 解析失敗 → 2 留原檔、該檔基準版不推、記入 conflicts"],
 ["3", "現有薄殼／檔案／引擎的組合需先升級或退回才能繼續，且零寫入；「舊」一律以介面版／檔案版比，不以 SemVer；網路／認證／不存在 → 1，不得偽裝成 3；最低介面版檢查在任何上網之前",
  "(a) 薄殼 P < 引擎 floor_P → 6-18；(b) 引擎讀到 schema > 支援上限 → 6-19；(c) upgrade vendor_kit@<舊版> 目標引擎介面版／檔案版低於現有檔 → 6-10；(d) dev vendor_kit -i 的引擎介面版／檔案版低於薄殼首行者要重產 進 git 的薄殼 → 拒絕；(e) 舊薄殼跑新 major 一般動詞 → 6-36 提示先 upgrade vendor_kit"],
]
MULTI = ("<b>多工具彙總（Q27）</b>：不帶 repo 的動詞做得完的做完（先完整預檢，任一預檢失敗才整體不動），最後回最需要處理的碼：失敗 1 > 衝突 2 > 有新版 2 > 0；update 同時遇 1 與 2 → 1；訊息全列；舊薄殼對未知碼原樣傳出、不吞")
top_h = max(left_end, right_end) + 16
etmp = []; eend = tbl(etmp, "p1C_ex", "p1C", 20, top_h + 32, EX_COLS, EX_ROWS, marks={(3, 1)})
mh = hvt(MULTI, 1520, True)
# ---- 訊息文字（左右兩表）----
MSG = [
 ("6-1", "sync：gen/.stamp 第一行 ≠ 引擎 ref", "vendor_kit 已更新 <vX> → <vY>，請執行：just vendor_kit upgrade vendor_kit（結束 1）"),
 ("6-2", "upgrade vendor_kit 重產薄殼後", "已升級引擎 <vX> → <vY> 並重產薄殼，請 commit .vendor_kit/ 並再跑原指令（結束 1）"),
 ("6-2b", "第一行已改但未重產／第二次又變", "引擎版本已鎖定為 <vY>，但薄殼尚未重產；請排除上述錯誤後執行：just vendor_kit upgrade vendor_kit（結束 1）"),
 ("6-3", "update／upgrade／add 無 registry 憑證", "無法列舉 <repo> 的版本：需要 registry 讀取權限。可設定 VENDOR_KIT_REGISTRY_TOKEN（或 VENDOR_KIT_REGISTRY_TOKEN_FILE），或直接指定版本：just vendor_kit upgrade <repo>@<tag>（拉取使用主機 docker 認證）"),
 ("6-4", "需詢問但無 tty／EOF 且無 -y", "需要確認但沒有終端可互動。請加 -y，或在終端執行。（結束 1）"),
 ("6-5", "CI 下基準版落後；Renovate PR 需合併", "請在本機執行 just vendor_kit upgrade <repo> -y 後 commit 並 push（結束 1）"),
 ("6-6／6-7／6-8", "dry-run／check.sh 提醒（不紅燈）", "有 <N> 個範本你拒絕過／<X> 沒納管，與範本差 <N> 行／<Y> 你拒絕過，<vZ> 有新版"),
 ("6-9", "不在專案根執行", "請到 <dir> 執行（結束 1）"),
 ("6-10", "upgrade vendor_kit@<舊版> 無法無損讀", "目標引擎 <vY>（介面版 <P>、檔案版 <M>）無法無損讀取現有檔（檔案版 <N>）。未修改任何檔。要退回舊版請 git revert 相關 commit。（結束 3）"),
 ("6-11", "add 初始檔已存在（copy）", "<X> 已存在，未納管；範本在 .vendor_kit/cache/<repo>/files/ 可自行比對"),
 ("6-12", "apply 重驗指紋不同", "專案狀態在執行期間變動，未寫入任何檔。請重跑：just vendor_kit <verb> …（結束 1）"),
 ("6-13", "sync metadata 無完成標記", "<repo> 未完成接入，請執行：just vendor_kit add <repo>（結束 1）"),
 ("6-14", "upgrade 補完待合併後另有新版", "已補齊 <repo> 至 <vB>；另有新版 <vX>，再跑一次 just vendor_kit upgrade <repo> 可升"),
 ("6-15", "update 末行", "套用：just vendor_kit upgrade"),
 ("6-16", "install 非 git repo", "目前目錄不在 Git repository 內。請先自行執行 git init，再重新執行 bootstrap.sh。（結束 1）"),
 ("6-17", "install <repo> 誤用", "install 不接受工具名稱。接入工具請執行：just vendor_kit add <repo>（結束 1）"),
 ("6-18", "薄殼／版本低於最低介面版", "目前薄殼或引擎低於支援下限 <最低介面版>。請以 bootstrap.sh 重建。（結束 3、零寫入）"),
 ("6-19", "引擎讀到檔案版高於支援上限", "無法讀取 <file>：檔案版 <N> 高於本引擎支援的 <M>；寫入者為 vendor_kit <written_by>。請使用支援此檔案版的引擎，或使用 version.toml 指定的引擎。（結束 3）"),
 ("6-20", "問句：根 justfile", "要在 justfile 加這一行嗎：import '.vendor_kit/entry.just'／要從 justfile 刪這一行嗎：import '.vendor_kit/entry.just'"),
 ("6-21", "問句：append", "要在 <X> 加這幾行嗎（接列出行）／要刪我們加在 <X> 的這幾行嗎（接列出行）"),
 ("6-22", "問句：upgrade 逐檔", "<X> 換成新版？／你和新版都改了 <X>，要三方合併嗎？／要建 <X> 嗎／<X> 是二進位檔，要換成新版嗎？"),
 ("6-23", "bootstrap just 太舊", "需要 just ≥ 1.33.0，目前為 <version>。請使用 GitHub release 版。+ 固定兩行 下載：<平台對應 URL>、安裝：<不覆蓋既有檔的安裝指令>"),
 ("6-24", "docker pull 失敗", "原文 + 三分類（網路／認證／不存在；另「主機錯誤」：daemon 不可用、磁碟滿）；認證類：<ref> 不存在或無權限（GHCR 未登入一律 denied），私有請先 docker login <host>；僅 add／bootstrap 追加 離線可用：--local <tar>"),
 ("6-26", "flock 逾時", "專案目錄被鎖定（PID <pid>，自 <time>）；60 秒內未釋放。確認無其他 vendor_kit 在跑後重試，或設 VENDOR_KIT_NO_LOCK=1。（結束 1）"),
 ("6-28", "薄殼被改（install／upgrade vendor_kit）", "偵測到薄殼被修改：<files>。未重產任何薄殼。請先檢視下列差異；確認並手動還原（git checkout -- .vendor_kit/<file>）後，再執行 just vendor_kit upgrade vendor_kit。（結束 1）"),
 ("6-29", "新增初始檔 dest 在 CI 路徑", "注意：新版初始檔將建立或修改 CI 設定 <X>。請確認下列內容後再決定是否套用。"),
 ("6-30", "啟動器驗 vk-resolve 失敗", "引擎輸出不完整或不相容（<原因>），未執行任何動作。（結束 1）"),
 ("6-31", "pull 逾時", "拉取 <ref> 超過 <秒> 秒未完成，已中止。可用 --timeout <秒> 或 VENDOR_KIT_PULL_TIMEOUT 調整。（結束 1）"),
 ("6-32", "問句：prune", "要刪除以上 vendor_kit 資源嗎？"),
 ("6-33", "唯讀動詞偵測未完成交易", "偵測到未完成的 <verb>（<id>）。請先重跑：just vendor_kit <verb> <targets>（sync／update 結束 1；help 不受影響；prune 只列出不刪）"),
 ("6-34", "問句：根 .dockerignore", "要在 .dockerignore 加這四行嗎：.vendor_kit/cache/ .vendor_kit/gen/ .vendor_kit/.tmp.* .vendor_kit/log/"),
 ("6-35", "install 巢狀", "<dir> 已有 .vendor_kit/，不允許巢狀接入。請到該目錄執行，或先 uninstall。（結束 1）"),
 ("6-36", "舊薄殼跑新 major 一般動詞", "薄殼介面版 <P_shell> 低於引擎 <vY> 的一般動詞需求。請先執行：just vendor_kit upgrade vendor_kit（結束 3、零寫入）"),
]
MSG_COLS = [("#", 50), ("時機", 170), ("文字（逐字；<…> 占位符）", 530)]
half = (len(MSG) + 1) // 2
mtmpL = []; mtmpR = []
my0 = eend + 14 + mh + 14 + 32
mendL = tbl(mtmpL, "p1C_mL", "p1C", 20, my0, MSG_COLS, [list(r) for r in MSG[:half]], bold0=True)
mendR = tbl(mtmpR, "p1C_mR", "p1C", 790, my0, MSG_COLS, [list(r) for r in MSG[half:]], bold0=True)
ch = max(mendL, mendR) + 20
p1c.append(v("p1C", "1", SW(NEUTRAL), "3. 規則、選項總表（Q25）、結束碼總表（Q23／Q27）、不開的動詞、訊息文字（interface_spec §6 逐字）", 40, Y, 1560, ch))
# 左上
p1c.append(v("p1C_pair_t", "p1C", TEXT(12) + "align=left;fontStyle=1;", "兩層成對（反向）", 20, 50, 200, 24))
py = 50 + 24
for i, (desc, a, fa, b, fb, both, lb) in enumerate(PAIR):
    p1c.append(v(f"p1C_pd{i}", "p1C", TEXT(12) + "align=left;", desc, 20, py, 200, PR_H))
    p1c.append(v(f"p1C_pa{i}", "p1C", refill(L12, fa), a, 225, py, 110, PR_H))
    p1c.append(v(f"p1C_pb{i}", "p1C", refill(L12, fb), b, 410, py, 110, PR_H))
    p1c.append(e(f"p1C_pe{i}", f"p1C_pa{i}", f"p1C_pb{i}", lb, (1, 0.5), (0, 0.5), both=both))
    py += PR_H + PR_G
y = 50 + pair_h + 10
y = rbox(p1c, "p1C_no", "p1C", RULE, NO_T, 20, y, LW, tagged=True)
y = rbox(p1c, "p1C_s1", "p1C", RULE, SEM1, 20, y, LW, tagged=True)
y = rbox(p1c, "p1C_s2", "p1C", RULE, SEM2, 20, y, LW, tagged=True)
y = rbox(p1c, "p1C_s3", "p1C", RULE, SEM3, 20, y, LW, tagged=True)
y = rbox(p1c, "p1C_dry", "p1C", RULE, DRY, 20, y, LW, tagged=True)
# 右上
p1c.append(v("p1C_opt_l", "p1C", LBL, "選項總表（Q25；短選項只給常用）", 790, 50, 700, 28))
