# ================= P2 v1p2：契約② 目錄樹與檔案範例 =================
p2 = head("p2", "契約② 專案裡的檔（1／3）── 目錄樹與檔案範例（interface_spec §4；誰寫它、誰可以改、進不進 git）", 1200)
c, Y = nopend("p2", 1260, 12, 340, "檔名 version.toml 已定（§4.1：它是「該裝哪版」的宣告，不是 lock 產物）；右欄範例框逐字（等寬、保留縮排），說明一律放框外")
p2.append(c); Y = max(Y + 16, 96)
# ---- 左：目錄樹 ----
TW = {0: 200, 1: 560, 2: 530, 3: 500}
TN = {}
def tnode(pid, level, text, style, y, tagged=False):
    x = 40 + 30 * level; w = TW[level]
    h = hvt(text, w - 12, tagged, pad=6)
    p2.extend(vt(pid, "1", style, text, x, y, w, h, tagged=tagged))
    TN[pid] = (x, y, w, h)
    return y + h + 6
def tedge(eid, par, ch):
    px, py, pw, ph = TN[par]; cx, cy, cw, chh = TN[ch]
    tx = px + 14
