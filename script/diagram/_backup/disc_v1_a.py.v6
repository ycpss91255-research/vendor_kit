# ---- ④ 啟動器 ↔ 引擎（兩列鏈；每格一件事）----
S1 = "① grep version.toml 第一行\n→ 引擎 ref（version.local.toml 覆寫優先）；附 --protocol P"
D1_T = "gen/.stamp\n= 引擎 ref？\n（啟動器 grep；install／upgrade vendor_kit 跳過）"
S2A = "讀 version.toml／local\n（frozen：CI=1）"
S2B = "查 registry 最新 tag／digest\n（frozen 不查；-t 不查）"
S2C = "stdout 回清單 + 輸入指紋\n（第一行 vk-resolve/1，一行一項）"
S3A = "docker pull\n（已有則略；逾時 → 1）"
S3B = "docker create <img> /x\n（帶 vendor_kit label）"
S3C = "docker cp c:/dist/.\n→ <tmp>/<repo>/"
S3D = "docker rm\n（trap 也清）"
S4 = "④ docker run 引擎 apply <動詞>\n（-v <tmp>:/dist:ro；拿鎖、重驗、建日誌後才寫；見 apply 通則）"
S5 = "結束狀態\n0／1／2／3 回到 just"
ERR = "否 → 退出 1（不重寫薄殼）\n印「引擎 vX → vY 與薄殼不符，請 just vendor_kit upgrade vendor_kit」"
DRY = "<b>-n／--dry-run（所有頁一致）</b>：② ③ 照跑（要拉的 image 一樣拉、展開到暫存），④ 改跑 apply --dry-run 唯讀預覽會建／會問哪些檔（讀 /dist/<repo>）。本機 → 0；CI=1 且需改 tracked 檔 → 1 印清單（version.toml 不動；與 -y 無關）"
SUB = ("<b>引擎子命令</b>：install | uninstall | add | remove | update | upgrade | dev | undev | sync | prune | help；啟動器編排用：resolve／apply；內部步驟 materialize | verify | merge（不對外）；每次呼叫附 --protocol P\n"
       "結束狀態 0 成功／1 失敗或需要人動作（工具層動詞不動 version.toml；自身升級例外：已改第一行、重產薄殼後「請 commit 並再跑原指令」也回 1）／2 衝突（git merge-file 衝突數 → 2）或 update --exit-code 有新版／3 協定不合、版本太舊；stdout 給啟動器讀，診斷走 stderr")
LOCK = ("<b>apply 通則（v2.3 §6、v2.5 §3）</b>：拿 flock（鎖在引擎 version 模組，啟動器不鎖；等 60 秒逾時就失敗；VENDOR_KIT_NO_LOCK=1 跳過）→ 重驗指紋（version.toml、metadata、要動的使用者檔 hash、鎖定 digest；不同 → 1「請重跑」）→ dry-run 分支（唯讀）→ 建進度日誌（第一個寫入前）→ 其後所有寫入"
        "（清除衝突狀態、append、baseline、metadata、cache、tools.just、version.toml 最後）→ 最後一步刪日誌（uninstall 在根 justfile 那行之後）；失敗明列已完成／未完成，下次任何動詞先恢復")
LSH = ("<b>啟動器 = POSIX sh</b>：只用 docker pull／create／cp／run／rm + grep／sed；不裝 python、不解析 TOML（resolve 的 stdout 就是它的輸入，不 eval）；gen/.stamp == 引擎 ref 的比對也是 grep（install／upgrade vendor_kit 跳過此關）；"
       "主機只需 docker ≥ 19.03（多架構 index）+ just ≥ 1.33 + sh；docker run 加 -u uid:gid（rootless docker 偵測到就不加）、只有互動才 -it（CI／-y 不加 -t）；"
       "引擎覆寫 vendor_kit=<tag> 時 docker run --pull never；工具 path 覆寫改掛 -v <dir>/dist:/dist/<repo>:ro 並驗 dist/init.toml 存在；trap 清容器與暫存；路徑含空白一律引號")
ENS = ("<b>vendor.just 每個動詞 recipe</b>：先檢查在專案根（invocation_directory() == justfile_directory()，否則 1 印路徑）→ 跑 sync 前置（同樣走 ②③④；無變更時只跑一次檢查的快路徑，不起第二個容器；CI=1 自動 frozen），再 verb *args 一行轉發給啟動器。"
       "會動 image 的動詞 = add／upgrade／sync／undev（undev 要重新 materialize 鎖定版）走 ②③④；install／remove／uninstall／update／dev／prune 沒有東西要拉，不經 ③。私有 registry 查最新 tag：引擎需 VENDOR_KIT_REGISTRY_TOKEN，或改用 -t 指定版本（主機 docker pull 走主機認證）")
COMPAT = ("<b>相容承諾（Q16／Q19）</b>：薄殼每次呼叫附 --protocol P（第一版就有），引擎依 P 回應。永久：任何舊薄殼可呼叫新引擎的救援路徑（install／upgrade vendor_kit／sync 不符提示；單段 docker run，不依賴 resolve/apply 與 gen）；舊資料永遠可讀可遷（讀任一舊 schema → 直接寫當前 schema）。"
          "非永久：舊薄殼跑新 major 一般動詞只保證乾淨回 3 提示先 upgrade vendor_kit。floor = 固定 release 常數（第一個正式版），只能經 ADR 提高。降版 upgrade vendor_kit -t 舊版：舊引擎能無損讀現有檔 → 成功；否則改檔前拒絕印「請 git revert」；dev vendor_kit -i 舊 image 禁止重產 tracked 薄殼")
ENVR = ("<b>執行環境（19 條）</b>：引擎 LC_ALL=C.UTF-8、TZ=UTC、時間戳 UTC ISO 8601；容器以 host uid:gid 跑、HOME 指容器內暫存；需詢問但無 tty／EOF → 1 印「加 -y 或在終端執行」；"
        "所有 docker 資源（容器／image／network／volume）帶 vendor_kit label，prune 依 label 刪 version.toml 未引用者；不建 network／volume；pull 逾時預設 + 可調（v1.0.0 必做）；rootless docker 與 Podman 進驗收；"
        "Docker Desktop／proxy／自簽 CA／引擎基底 EOL → issue v2；SELinux 不支援；離線 upgrade 不支援（local_bootstrap.sh 只涵蓋 install／add --local）；worktree 驗收加案例；submodule 派子代理實測")
