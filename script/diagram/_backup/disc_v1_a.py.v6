 "tblh":  (TBL_H, "灰底：表頭", 110, 40, 10),
 "grpbox":(GRP, "淺灰底：分組（無狀態意義）", 200, 40, 10),
 "v3err": (ELLIPSE(RED) + "fontSize=12;", "紅橢圓：失敗終止（exit 1）", 300, 40, 10),
 "v3act": (ELLIPSE(ORANGE) + "fontSize=12;", "橙橢圓：需要人動作（exit 1／3）", 330, 40, 10),
 "v3ok":  (ELLIPSE(GREEN) + "fontSize=12;", "綠橢圓：成功終點（exit 0）", 300, 40, 10),
 "v3step":(L12, "白：步驟／說明", 130, 40, 10),
 "v3img": (P12, "紫：image（引擎與工具）", 170, 40, 10),
 "v4eng": (P12, "紫：image（引擎與工具）", 170, 40, 10),
 "v4mod": (refill(L12, RED), "紅：引擎模組", 130, 40, 10),
 "v4unit":(UNIT, "白小框：最小單元", 140, 40, 10),
 "v4host":(HOST, "紅底紅粗框：啟動器（主機側薄殼）", 240, 40, 10),
 "v4hgrp":(GRP, "淺灰底：主機分組", 150, 40, 10),
 "v4pgrp":(refill(L12, GREEN), "綠底：專案目錄分組", 160, 40, 10),
 "v4frame":(FRAME + "fontSize=12;", "點線框：init／merge 共用箭頭", 200, 40, 10),
 "v4other":(L12, "白底黑框：主機上的目錄／命名空間（不是檔）", 300, 40, 10),
 "notep": (NOTE, "便條：說明（含「本頁無待拍板」）", 220, 40, 10),
})
def lgd(prefix, x, y, keys, note):
    c = legend(prefix, x, y, keys, note)
    if "v2tag" in keys:
        i = keys.index("v2tag"); cx = x + sum(LEGEND_ITEMS[k][2] + 20 for k in keys[:i])
        c.append(tag(f"{prefix}_lg{i}", "1", cx, y + 10, LEGEND_ITEMS["v2tag"][2]))
    return c
NUM_T = "契約編號：①介面 p1｜②專案裡的檔 p2｜③工具 repo、④啟動器↔引擎、⑤CI p3｜架構 p4｜流程 p5～"
# 各頁共用名詞（每頁都用到的新詞）
T_COMMON = [
 ("frozen（CI=1）", "CI=1 時的模式：不寫任何 tracked 檔（進 git 的檔）、不查最新版（不呼叫 registry 查 tag）；仍拉鎖定版 image、仍寫 cache/、gen/；需要寫 tracked 檔的情況一律 → 1 印清單，與 -y 無關（-y 只在本機免詢問）"),
 ("tracked 檔", "進 git 的檔（git 追蹤中）：version.toml、薄殼四檔、baseline/、初始檔、根 justfile；相對的是 cache/、gen/、version.local.toml（不進 git）"),
 ("CI／runner", "CI = GitHub／GitLab 上每次 push 自動跑的檢查（環境變數 CI=1 讓 sync 進 frozen）；runner = 跑 CI 的機器（amd64、arm64 原生 runner = 兩種晶片各一台真機）"),
 ("結束狀態 0／1／2／3", "0 成功；1 失敗或需要人動作（工具層動詞不動 version.toml；自身升級已改第一行後要求重跑也回 1）；2 = 完成但有衝突要你處理（upgrade），或 update --exit-code 有新版；3 = 協定不合／版本太舊（舊薄殼跑新 major 的一般動詞、降版讀不了現有檔）"),
 ("--protocol P", "薄殼每次呼叫引擎都附的協定版本（從第一版就有）；引擎依 P 回應；P 太舊 → 一般動詞乾淨回 3 提示先 upgrade vendor_kit，救援路徑（install／upgrade vendor_kit／sync 不符提示）永久可用"),
 ("薄殼自描述首行", "entry.just／vendor.just／.gitignore 第一行、ci/check.sh 第二行：# vendor_kit-shell/<P> engine=<vX> sha256=<其餘內容 LF 正規化 hash>；引擎重算 + 對 image 內模板二次比對，不符 → 1 列差異不動；gen/.stamp 只記引擎 ref"),
 ("image ID", "docker 本機給每個 image 內容的 sha256；tag 是人取的名字（可重 build 換內容）、digest 是 registry 端的內容指紋；docker load 進來的本機 image 沒有 digest，所以 dev vendor_kit -i 記 tag + image ID"),
 ("tar／docker load", "tar = 打包檔；docker save 出的引擎 image 離線包（#27），docker load 把它裝回本機 image（沒有 RepoDigests，只能用 tag）"),
 ("stdout／stderr", "程式的兩條輸出：stdout = 給啟動器讀的結果（resolve 的清單，第一行 vk-resolve/1，之後一行一項，啟動器逐行讀、不 eval）；stderr = 給人看的診斷訊息（警告、錯誤），不會被當輸入"),
 ("冪等", "同一個指令重跑結果一樣、不會重複做（install 再跑 = 修復薄殼；add 已接入 → 0 無變更；append 行重跑不重複）"),
 ("mod／import／import?", "just 的兩種載入：mod <ns> '檔' 把整個檔掛成一個命名空間（just <ns> …；tools.just 一行一個）；import '檔' 把內容直接併進來（根 justfile 那一行）；import? = 檔不在也不報錯"),
 ("metadata", "baseline/<repo>/.vendor_kit.toml：schema = N + 寫入者版本、來源 ref@digest、最後合併版本、完成標記、初始檔四種狀態（已納管／拒絕過 declined／本來就有沒納管／使用者刪了）、append 過的行、衝突中檔案、進度日誌（state=in-progress）"),
 ("專案根", "含 .vendor_kit/ 的目錄（monorepo 子專案各自一套）；vendor_kit 動詞只准在該層執行（recipe 檢查 invocation_directory() == justfile_directory()，否則 1 印路徑）；禁止巢狀（install 時上層已有 .vendor_kit/ → 1）；目錄須在某 git repo 內；引擎不讀 .git、不碰 index"),
 ("prune／label", "prune = 刪主機上帶 vendor_kit label 且 version.toml 未引用的 docker 資源（容器／image／network／volume）；label = docker 資源上的標籤，vendor_kit 建的資源一律帶它；vendor_kit 不建 network／volume（驗收差集為空）"),
]

