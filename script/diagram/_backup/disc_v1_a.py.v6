# ---- 0. 目的與角色 ----
GOAL_T = ("目的（一句話）：工具 repo 把 dist/ 打包成 GHCR image；下游專案靠 bootstrap.sh + just vendor_kit add／upgrade／dev 拿到工具、跟上新版、在本機開發工具本身；其餘自動。\n"
 "契約只對兩個黃橢圓承諾；我們（灰橢圓）不對自己承諾。")
TECH_T = ("<b>技術路線 [定]</b>：自寫 + 主機 docker（拉 image）+ 引擎內 git merge-file（行內合併）；<b>第一版不放 vendir／Copier</b>。"
 "依據：無單一工具全包四項（拉、鎖、初始檔、合併）；vendir 只省 docker 三行；Copier 要求範本是帶 tag 的 git repo")
ROLES = [("p1A_r1", YELLOW, "工具 repo 開發者（供應側）\n照契約③ 出貨 dist 與 image", 790, 240),
         ("p1A_r2", YELLOW, "使用者（下游專案）\n每天打 just 的人；用下表的動詞", 1050, 240),
         ("p1A_r3", GREY, "vendor_kit 開發者（我們）\n維護引擎與啟動器；不對自己承諾", 1310, 230)]
gh = max(hv(GOAL_T, 740), max(hve(t, w) for _, _, t, _, w in ROLES)); th = hv(TECH_T, 1520)
p1.append(v("p1A", "1", SW(NEUTRAL), "0. 目的與角色（契約只對兩個黃橢圓承諾）", 40, Y, 1560, 50 + gh + 12 + th + 20))
p1.append(vb("p1A_goal", "p1A", LT12, GOAL_T, 20, 50, 740, gh))
for pid, fill, t, x, w in ROLES:
    p1.append(v(pid, "p1A", ELLIPSE(fill) + "fontSize=12;", t, x, 50, w, gh))
p1 += vt("p1A_tech", "p1A", RULE, TECH_T, 20, 50 + gh + 12, 1520, th, tagged=True)
Y += 50 + gh + 12 + th + 20 + 20
# ---- 1. 不變量 + 2. 使用者介面 ----
INV_T = ("<b>1. 不變量（PRD 層）[定]：vendor_kit 對使用者的檔 ── 可以建（明說建了什麼）、要改先問（-y 免問）、永不刪、永不覆蓋。</b>\n"
 "・「永不覆蓋」= 不用工具版本取代使用者客製內容；never fail silently（結束狀態 0／1／2／3）；詢問一律有拒絕分支：拒絕 → 不寫、metadata 記 declined\n"
 "・自動化（sync）只碰不進 git 的東西（cache/<repo>/、gen/tools.just、gen/<repo>.stamp）：不碰使用者的檔，也不碰進 git 的薄殼（entry.just、vendor.just、ci/check.sh、.gitignore）；薄殼與 version.toml 第一行引擎不符 → 只回 1 提示 upgrade vendor_kit\n"
 "・薄殼重產只由 upgrade vendor_kit（含不帶 repo 的 upgrade）／install 修復做 ── 做之前先比對薄殼自描述首行的 hash（# vendor_kit-shell/<P> engine=<vX> sha256=…）+ 對 image 內模板二次比對：相符才重產，被改過 → 1 列差異不動\n"
 "・<b>CI=1（frozen）與 -y 無關</b>：任何需要寫 tracked 檔的情況一律 → 1 印清單；-y 只在本機免詢問\n"
 "・「會碰使用者東西」只有：根 justfile 一行、初始檔（含 strategy=append 經同意加的行）；使用者 .gitignore 除非工具以 strategy=append 宣告且你同意，否則不碰\n"
 "・落到初始檔（§5）：add 無 → 建、有 → 不納管；upgrade 逐檔判斷後問（換／三方合併／append 行替換：只對可辨識的上次插入行提，CRLF／LF 等價、其餘精確；零命中或多處 → 保留只 warn；新版新增檔 → 問「要建 X 嗎」，拒絕過就不再問）；新版刪檔 → 不刪只 warn；"
 "remove／uninstall 永不刪初始檔（印清單）；二進位／symlink 不合併：沒改才換、改過保留 + warn")
PAIR = [
 ("專案層（vendor_kit 自己）", "install", "#ffffff", "uninstall", "#ffffff", True, ""),
 ("工具層", "add", GREEN, "remove", "#ffffff", True, ""),
 ("本機開發", "dev", GREEN, "undev", "#ffffff", True, ""),
 ("只查 → 套用（apt 語意）", "update", "#ffffff", "upgrade", GREEN, False, "前一步"),
]
PR_H = 30; PR_G = 8
pair_h = 24 + len(PAIR) * (PR_H + PR_G)
inv_h = max(hvt(INV_T, 1000, True, pad=8), pair_h)
COLS = [("動詞", 150), ("參數", 220), ("反向", 110), ("做什麼（一格一件事；細節見流程頁 p5～）", 800), ("結束狀態", 190), ("組", 50)]
ROWS = [
 ["bootstrap.sh", "--tool <repo>（可重複）\n-t/--tag <tag>\n-y/--yes\n--local <image tag 或 tar>\n-h/--help", "（呼叫 uninstall）",
  ["薄層檢查：git repo（非 git repo → 1 提示 git init，不代做）→ just ≥ 1.33（不足印下載＋安裝指令）",
   "拉引擎：docker pull 內嵌的引擎 ref（--local：本機 image tag／tar 先 docker load）；專案已有 version.toml → 改用該行的引擎跑 install（Q18；拉不到即失敗，不用內嵌）",
   "呼叫引擎 install → 對每個 --tool 呼叫 add；再跑一次 = 呼叫 install（冪等修復）；不自刪；trap 清容器與暫存",
   "取得：README 連 releases/latest/download/bootstrap.sh；每版 releases/download/vN/bootstrap.sh；離線 local_bootstrap.sh 只涵蓋 install／add --local（#27；離線 upgrade 不支援）"],
  "0；1 不留半成品（只對第一次 install 成立；--local 的 version.local.toml 在 install 成功後才寫，失敗清除）", "一次性"],
 ["install", "-y\n--no-justfile", "uninstall",
  ["裝進這個 git repo（專案根 = 含 .vendor_kit/ 的目錄；上層已有 .vendor_kit/ → 1 禁止巢狀）：建 .vendor_kit/（version.toml 第一行引擎 ref、薄殼四檔、空 baseline/；不建 metadata）",
   "根 justfile：無 → 建；有 → 問「要加這一行嗎」（-y 直接加並印出）；已含 → 不再加；--no-justfile 只印指示",
   "第一次／修復判定用薄殼自描述首行（Q17，不用 gen/.stamp）：薄殼不存在 → 第一次；存在且 hash 相符 → 重產（冪等修復）；不符 → 1 列差異不動；install <repo> 誤用 → 提示 add"],
  "0／1", "進階"],
 ["uninstall", "-y\n-n/--dry-run", "install",
  ["resolve → apply 兩段：先預檢全部工具、算「hash 相符」的保護清單 → 拿鎖、重驗指紋 → 建進度日誌（.vendor_kit/.tmp.*）",
   "逐工具 remove（保護模式：未知或被改的檔保留；任一失敗 → 1 中止並列出已完成部分）",
   "不 rm -rf .vendor_kit/：只刪 hash 相符的自產檔（含 version.local.toml），未知或被改的保留並回報，目錄非空則保留；初始檔保留並印清單",
   "根 justfile 那行：問「要刪這一行嗎」，只刪與我們寫的完全相同的行 → 最後才刪進度日誌；-n 覆蓋所有刪改與詢問"],
  "0／1", "進階"],
 ["add <repo>", "-t/--tag（預設最新）\n-s/--source <image>\n--local <tar>\n-y\n-n/--dry-run", "remove",
  ["前置檢查：已接入且完成 → 0 無變更；-t 與鎖定不同 → 1 提示 upgrade；命名空間撞名（其他已接工具／根 justfile 既有 recipe、module／保留名 vendor_kit）→ 1；dest 撞名、越界、指向 .vendor_kit/ → 1",
   "兩段執行（p3 契約④）：resolve → 主機 docker 拉 image 展開到暫存 → apply：拿鎖、重驗指紋、建進度日誌；逐檔判斷讀 /dist/<repo>（暫存），不是 cache",
   "初始檔：無 → 建；有 → 不納管（印「已存在，範本在 cache」）；strategy=append：無 → 建、有 → 問「要加這幾行嗎」；拒絕 → 記 declined（重跑不重複）",
   "收尾：materialize 到 cache/<repo>/ + 印記 gen/<repo>.stamp → 建 baseline/<repo>/ + metadata（完成標記、初始檔狀態）→ 重生 gen/tools.just → 最後寫 version.toml 一行（tag@digest）→ 刪日誌"],
  "0／1（不動 version.toml）", "常用"],
 ["remove <repo>", "-y\n-n/--dry-run", "add",
  ["前置：有 dev 覆寫 → 1 提示先 undev；未接 = 0 + 提示；-n 只印（CI=1 且需改 tracked 檔 → 1）",
   "拿鎖、重驗、建日誌（.tmp.*）後刪：version.toml 該行、cache/<repo>/、baseline/<repo>/、gen/<repo>.stamp、gen/tools.just 該工具的 mod 行",
   "初始檔永不刪，印清單；append 過的行：問「要刪我們加的這幾行嗎」，唯一命中才刪（零命中／多處 → 保留 + warn）→ 最後刪日誌"],
  "0／1", "進階"],
 ["update [<repo>]", "--exit-code", "（upgrade 的前一步，不算反向）",
  ["只查 GHCR，不動任何檔；末行固定「套用：just vendor_kit upgrade」；拒絕未知參數",
   "私有 registry 查最新需 VENDOR_KIT_REGISTRY_TOKEN，否則改用 upgrade -t 指定版本（主機 docker pull 走主機認證）"],
  "0；1 查詢失敗；--exit-code 有新版 2", "進階"],
 ["upgrade [<repo>]\n（工具）", "-t/--tag（限單一 repo）\n-y\n-n/--dry-run", "git revert 整組 commit",
  ["前置：目標工具在 dev 覆寫中 → 1 提示先 undev；無 baseline → 1 提示 add；(0) 仍有 <<<<<<< vendor_kit:baseline 標籤 → 2 停",
   "(1) 有待合併（version.toml 已 B、baseline 仍 A）→ 只補到 B 然後停，印「另有新版，再跑一次」；(2) 沒有待合併才查最新（或 -t；frozen 不查；-t 比現版舊 → warn 仍執行）",
   "resolve → 主機 docker 拉目標版到暫存 → apply：拿鎖、重驗指紋、建日誌 → 逐檔判斷（§5，讀 /dist/<repo>）後問：換／三方合併／append 行替換／新版新增檔「要建 X 嗎」（Q14）；拒絕 → 記 declined，之後不問（新版又改才再問）",
   "推 baseline + metadata（有衝突仍推到新版）→ materialize → 重生 tools.just → 最後改 version.toml → 刪日誌；Renovate PR：在 PR 分支補完（固定在 PR 鎖定版）、CI 綠後才 merge（p7）"],
  "0；1（不動 version.toml）；2 衝突（留標記、印檔名；解完重跑直到乾淨）；3 協定不合（舊薄殼跑新 major）", "常用"],
 ["upgrade\n（不帶 repo：全部含自身）", "-y\n-n/--dry-run", "git revert 整組 commit",
  ["先完整預檢（含 dev 中的工具）再動任何東西；resolve 先判斷「引擎有新版？」：否 → 只升全部工具（同上列）",
   "是 → 舊引擎 apply（拿鎖、重驗、建日誌）只改 version.toml 第一行 → 回報「引擎已變」",
   "啟動器在同一次指令內：local 覆寫有 vendor_kit= → 用該 image（--pull never）；否則 docker pull 新引擎 → 用新引擎跑 upgrade vendor_kit（下一列）"],
  "1「已升級引擎 vX→vY 並重產薄殼，請 commit .vendor_kit/ 並再跑原指令」（已改第一行後回 1 是明列例外；需要人動作）", "常用"],
 ["upgrade vendor_kit", "-t/--tag\n-y", "git revert 整組 commit",
  ["啟動器讀第一行（local 覆寫優先、--pull never；不受 gen/.stamp 關卡擋）→ 該引擎比對薄殼自描述首行 hash + image 內模板 → 相符才重產薄殼四檔 + gen/.stamp（引擎 ref）；被改過 → 1 列差異不動",
   "-t 舊版（Q19 降版）：舊引擎能無損讀現有檔（schema）→ 成功；否則改檔前拒絕印「請 git revert」"],
  "1 請 commit 並再跑原指令；3 版本太舊（降版讀不了現有檔）", "常用"],
 ["dev <repo>", "-p/--path <dir>\n（自身）dev vendor_kit -i/--image <tag>", "undev",
  ["工具：必須已在 version.toml（否則 1）；驗 <dir>/dist/init.toml 存在 → 寫 local <repo> = \"path:<dir>\"；cache/<repo>/ 改唯讀 symlink → <dir>/dist；gen/<repo>.stamp 第一行記 path:<dir>",
   "之後每次 just：啟動器改掛 -v <dir>/dist:/dist/<repo>:ro；sync 跳過 pull／verify（仍查完成標記、落後）；CI=1 有任何覆寫 → 1",
   "自身 dev vendor_kit -i <本機 image tag>（只能 tag：docker load 後無 RepoDigests）→ local 記 tag + image ID；docker run --pull never；禁止重產 tracked 薄殼（Q19）"],
  "0／1", "常用"],
 ["undev <repo>", "—", "dev",
  ["工具：resolve → 主機 docker 拉鎖定版到暫存 → apply：拿鎖、重驗、建日誌 → 撤覆寫行（含 image ID 欄位）→ 拆 symlink、重新 materialize → 刪日誌；失敗 → 1 保留可恢復狀態；未啟用 = 0 + 提示",
   "自身 undev vendor_kit：撤 vendor_kit= 行 + image ID；下次 just 用 version.toml 的引擎；薄殼／gen 不符 → sync 回 1 提示 upgrade vendor_kit"],
  "0／1", "進階"],
 ["sync [<repo>]", "—（CI=1 自動 frozen）", "—",
  ["每次 just 自動前置（無變更走快路徑，不起第二個容器）；可寫範圍 = cache/<repo>/、gen/tools.just、gen/<repo>.stamp；gen/.stamp ≠ 第一行（薄殼不符）→ 不重寫，1「請 upgrade vendor_kit」（upgrade vendor_kit／install 不被擋）",
   "每工具：覆寫 path → 跳過 materialize／verify（仍查 metadata／baseline）；cache 缺 或 印記第一行 ≠ 鎖定 digest → materialize（只拉鎖定版）；否則 verify sha256 失敗 → 重裝 + warn；無完成標記 → 1；baseline 落後 → warn；tools.just 缺或需重生 → 重生",
   "frozen（CI=1）：只准寫上列三處；不查最新版；升為 1：薄殼不符、baseline 落後、未完成接入、任何 local 覆寫；與 -y 無關"],
  "0／1", "進階"],
 ["prune", "-n/--dry-run\n-y", "—",
  ["刪主機上帶 vendor_kit label 且 version.toml 未引用的 docker 資源（容器／image／network／volume）；不碰專案任何檔；vendor_kit 不建 network／volume（驗收：故意留的也會被清、差集為空）"],
  "0／1", "進階"],
 ["help／h", "—", "—", "命名空間層說明（just 做不到 just vendor_kit --help）；各動詞 --help 由引擎印", "0", "—"],
]
FILLS = [BLUE, "#ffffff", "#ffffff", GREEN, "#ffffff", "#ffffff", GREEN, GREEN, GREEN, GREEN, "#ffffff", "#ffffff", "#ffffff", "#ffffff"]
MARKS = {(r, 0) for r in range(13)}
tmp = []
T0 = 50 + inv_h + 16
tend = tbl(tmp, "p1B", "p1B", 20, T0, COLS, ROWS, FILLS, MARKS)
NO_T = ("<b>不開的動詞與理由</b>\n"
 "init（→ install）／ensure（→ sync）／diff（= upgrade --dry-run）／accept（解完衝突重跑 upgrade）／rollback（git revert）／"
 "--repair（= 再跑 install）／--purge（初始檔永不刪，要刪用 git rm）／materialize、verify、merge（引擎內部步驟，不對外）／--porcelain（未定案，v2 候選）\n"
 "<b>dry-run（-n）的定義</b>：動 image 的動詞（add／upgrade／sync／undev）照樣拉 image 展開到暫存，再由引擎 apply --dry-run 做唯讀預覽（resolve 只知道 tag／digest，不知道要問哪些檔）；"
 "install／remove／uninstall／update／dev 的 -n 只做唯讀預覽，不經 docker create／cp。結果所有頁一致：本機 → 0；CI=1 且需改 tracked 檔 → 1 印清單；dry-run 與 check.sh 都印「X 沒納管，與範本差 N 行」「Y 你拒絕過，vZ 有新版」（Q15）")
SEM_T = ("<b>動詞語意與 recipe 規則</b>\n"
 "・兩層成對（右上小圖）：專案層 install↔uninstall、工具層 add↔remove；update 只查／upgrade 套用（跟 apt）；dev↔undev；sync 自動前置；prune 沒有反向\n"
 "・動詞 recipe 一律 verb *args 一行轉發（set positional-arguments 只在 vendor.just）、放 tracked 的 vendor.just；[group('常用')]／[group('進階')]；每次呼叫引擎附 --protocol P\n"
 "・entry.just 與 gen/tools.just 只含 mod／import?，零 set 零 recipe（實測：被 import 檔的 set 會外溢到根檔）\n"
 "・只准在專案根執行（recipe 檢查 invocation_directory() == justfile_directory()，否則 1 印路徑）；monorepo 子專案各自一套 .vendor_kit/\n"
 "・需詢問但無 tty／EOF → 1 印「加 -y 或在終端執行」；路徑含空白一律引號；引擎 LC_ALL=C.UTF-8、TZ=UTC、時間戳 UTC ISO 8601\n"
 "・會動 image 的動詞（add／upgrade／sync／undev）兩段執行：引擎 resolve → 主機 docker → 引擎 apply（見 p3 契約④）；install／remove／uninstall／update／dev 不經 docker create／cp")
nh = max(hvt(NO_T, 760, True), hvt(SEM_T, 760, True))
bh = tend + 16 + nh + 20
p1.append(v("p1B", "1", SW(NEUTRAL), "1. 不變量 ＋ 2. 契約① 使用者介面：常用 3 + 進階 7 + 一次性 1 + help（綠底 常用、白底 進階、藍底 一次性）", 40, Y, 1560, bh))
p1 += vt("p1B_inv", "p1B", INV, INV_T, 20, 50, 1000, inv_h, tagged=True)
PX0 = 1040
p1.append(v("p1B_pair_l", "p1B", TEXT(12) + "align=left;fontStyle=1;", "兩層成對（反向）", PX0, 50, 200, 24))
py = 50 + 24
for i, (desc, a, fa, b, fb, both, lb) in enumerate(PAIR):
    p1.append(v(f"p1B_pd{i}", "p1B", TEXT(12) + "align=left;", desc, PX0, py, 200, PR_H))
    p1.append(v(f"p1B_pa{i}", "p1B", refill(L12, fa), a, PX0 + 205, py, 110, PR_H))
    p1.append(v(f"p1B_pb{i}", "p1B", refill(L12, fb), b, PX0 + 390, py, 110, PR_H))
    p1.append(e(f"p1B_pe{i}", f"p1B_pa{i}", f"p1B_pb{i}", lb, (1, 0.5), (0, 0.5), both=both))
    py += PR_H + PR_G
p1 += tmp
p1 += vt("p1B_no", "p1B", RULE, NO_T, 20, tend + 16, 760, nh, tagged=True)
p1 += vt("p1B_sem", "p1B", RULE, SEM_T, 780, tend + 16, 760, nh, tagged=True)
Y += bh + 20
p1 += lgd("p1", 40, Y, ["v1role", "v1us", "v1o", "v1c", "v1a"], "一列 = 一個動詞；「做什麼」欄一格一件事\n「反向」= 收回它做的事的動詞")
p1 += lgd("p1b", 40, Y + 60, ["v2tag", "notep", "invb", "ruleb", "tblh", "grpbox"], "橢圓／方框顏色只在本頁有效\n流程細節一律在流程頁")
p1 += terms("p1", 40, Y + 160, [
 ("<repo>", "工具 repo 名；.vendor_kit/cache/<repo>/ = 專案裡展開的工具檔；ghcr.io/<org>/<repo>-dist = 它的 image"),
 ("PRD", "Product Requirements Doc：doc/PRD.md，北極星文件（不變量／設計原則／衝突優先序）；「PRD 層」= 這條不變量寫在那裡，每個決議都對照它"),
 ("組（常用／進階／一次性）", "常用 = 每天會打的（add／upgrade／dev）；進階 = 偶爾才用；一次性 = 只在第一次接入跑的 bootstrap.sh（release 附的腳本，不是 just 動詞）"),
 ("反向", "把該動詞做的事收回的動詞（install↔uninstall、add↔remove、dev↔undev）；upgrade 沒有動詞反向，靠 git revert（把整組升級 commit 反做一次的 git 指令）"),
 ("apt 語意", "跟 Debian 的 apt 一樣分兩步：update 只查有沒有新版、不動檔；upgrade 才真的套用"),
 ("rm -rf", "整個目錄連內容一起刪的 shell 指令；uninstall 明說「不 rm -rf .vendor_kit/」= 只刪確認是我們產的檔"),
 ("set positional-arguments", "justfile 的全域設定：讓 recipe 用 $1 $2 … 收參數，verb *args 一行轉發靠它；被 import 檔的 set 會外溢，所以只放 mod 進來的 vendor.just"),
 ("引擎 ref", "version.toml 第一行的 vendor_kit image@digest（version.local.toml 可覆寫成本機 tag + image ID）；啟動器用它 docker run 引擎，也記進 gen/.stamp"),
 ("GHCR", "GitHub Container Registry：GitHub 提供的 image 倉庫（ghcr.io）；工具 image 與引擎 image 都放這裡"),
 ("image", "docker 用的「打包好的檔案層」；工具 image 只是裝 dist/ 的純資料包，引擎 image 才是會跑的程式"),
 ("just", "指令執行器（像 make）：專案根的 justfile 列出可打的指令（recipe）；主機需 just ≥ 1.33"),
 ("recipe", "justfile 裡的一條指令定義（名字 + 要跑的命令）；「一行轉發」= recipe 只有一行，把參數原樣丟給啟動器"),
 ("命名空間", "just <ns> <recipe> 前面那個 <ns>；每個工具的 just/<ns>.just 一檔一個命名空間；與其他工具、根 justfile 既有 recipe／module、保留名 vendor_kit 撞名 → add 拒絕（撞名整個 just 會掛）"),
 ("sync", "每次 just 的自動前置：比印記、比 gen/.stamp；只寫 cache/<repo>/、gen/tools.just、gen/<repo>.stamp，不碰薄殼、不寫 gen/.stamp；引擎 ref ≠ gen/.stamp 就退出 1 提示 upgrade vendor_kit（install／upgrade vendor_kit 不被擋）"),
 ("materialize", "引擎內部步驟（不對外）：把主機拉好的 /dist 展開到 cache/<repo>/、寫印記 gen/<repo>.stamp、verify sha256；在 apply 決定套用之後才做"),
 ("flock", "Linux 檔案鎖：引擎 apply 一開始對專案目錄上鎖，避免兩個 just 同時寫；等 60 秒逾時 → 失敗；VENDOR_KIT_NO_LOCK=1 跳過"),
 ("resolve／apply", "動詞的兩段：resolve 算出要拉哪些 image、輸出輸入指紋（不寫檔）→ 主機 docker 拉到暫存 → apply 拿鎖、重驗指紋、建進度日誌、寫檔、最後刪日誌；細節 p3 契約④"),
 ("N（目標版範本）", "逐檔判斷與 dry-run 讀的「新版」= 啟動器展開到暫存、掛進引擎的 /dist/<repo>（唯讀），不是 cache；cache/<repo>/ 在 apply 決定套用後才 materialize"),
 ("dry-run（-n）", "只預覽不寫：動 image 的動詞照樣拉 image 展開到暫存，引擎 apply --dry-run 唯讀列出會建／會問哪些檔；本機 → 0；CI=1 且需改 tracked 檔 → 1 印清單"),
 ("version.toml", ".vendor_kit/version.toml：專案「該裝哪版」的唯一來源；第一行引擎 ref（唯一符合 ^vendor_kit\\s*= 的行），[tools] 每工具一行 tag@digest；version.local.toml = dev 覆寫（不進 git）"),
 ("strategy=append", "init.toml 每個 [[file]] 的 strategy 欄位（copy | append，預設 copy）；append（.gitignore 類）：檔不存在 → 建；存在 → 問後把幾行加進去，實際插入的行記在 metadata；upgrade／remove 只對可辨識的上次插入行提修改（CRLF／LF 等價、其餘精確）"),
 ("CRLF／LF", "兩種換行符號（Windows 用 CRLF、Linux 用 LF）；比對 append 行時視為等價，其餘字元要精確相同"),
 ("tag@digest", "version.toml 裡每個工具記 image 的 tag 與 sha256 digest（多架構 index digest）；digest 才是真正鎖定的內容"),
 ("sha256", "內容的指紋（雜湊）：內容變一個字指紋就不同；digest、印記、薄殼比對都靠它"),
 ("baseline", ".vendor_kit/baseline/<repo>/ = 上次合併的範本副本（歷史狀態，不由 version.toml 推導）；三方合併的共同祖先；同目錄 .vendor_kit.toml = metadata"),
 ("初始檔四種狀態（Q15）", "metadata 對每個 init.toml 的 dest 記：已納管／拒絕過（declined）／本來就有沒納管／使用者刪了；不動檔不紅燈；dry-run 與 check.sh 印提醒；新版有更新對拒絕過的檔再問一次"),
 ("三方合併", "拿 baseline、你現在的檔、新版範本三份用 git merge-file --diff3 合；衝突留 <<<<<<< vendor_kit:baseline 標記並回 2；baseline 仍推到新版"),
 ("印記 gen/<repo>.stamp", "每工具一個：第一行 = 裝的是哪個 index digest（或 path:<dir>／image:）、之後每檔 sha256；sync 用它判斷要不要重新 materialize；gen/.stamp 只記引擎 ref（薄殼 hash 在薄殼自己的首行）"),
 ("VENDOR_KIT_\nREGISTRY_TOKEN", "環境變數：私有 registry 查最新 tag 時給引擎用的登入權杖（容器內沒有主機的 docker 登入）；不給就改用 -t 指定版本（主機 docker pull 走主機認證）"),
 ("Renovate", "GitHub 機器人（下游自選）：GHCR 有新版就開 PR 改 version.toml 一行；人在 PR 分支跑 upgrade 補完合併、CI 綠後才 merge；preset 建議 major 分開 PR"),
 ("PR／commit／push／rebase", "git 用語：commit = 一次存檔；push = 推到 GitHub；PR = 請求合併某分支的頁面；rebase = 把分支重新接到最新主線（Renovate PR 勿勾）"),
 ("RepoDigests", "docker 記錄「這個 image 從哪個 registry 以哪個 digest 拉來」的欄位；docker load 進來的 image 沒有它，所以本機引擎只能用 tag"),
 ("symlink", "指向另一個路徑的捷徑檔；dev 時 cache/<repo>/ 就是指向 <dir>/dist 的唯讀 symlink；工具 dist/files/ 裡第一版禁止（v2.2 E）"),
 ("release", "GitHub 上一個版本的發佈頁（附 bootstrap.sh、local_bootstrap.sh 與引擎 image 的 tar）"),
 ("tty／trap", "tty = 互動終端（能問問題）；沒有 tty（管線、CI）又需詢問 → 1；trap = shell 的收尾勾子，啟動器用它在中斷時清容器與暫存"),
 ("pull 逾時", "docker pull 卡住時的上限（預設值 + 可調參數，v1.0.0 必做）；逾時 → 1，不留半成品"),
] + T_COMMON)
pages_v1_a.append(("v1p1", "契約 v2：目的、角色、介面", p1))

# ================= P2 v1p2：契約② 專案裡的檔與 version.toml =================
p2 = [v("title", "1", TITLE, "契約② 專案裡的檔與 version.toml（v2.5 定案）── 誰寫它、誰可以改、進不進 git", 40, 20, 800, 34),
      v("p2_num", "1", TEXT(12) + "align=left;", NUM_T, 40, 56, 800, 26)]
c, Y = pend("p2", 860, 12, 740,
 "(1) 檔名 version.toml vs lock.toml → 建議：version.toml；它是「該裝哪版」的宣告（人與 Renovate 都會改），不是 lock 產物；"
 "第一行固定引擎 ref 讓啟動器（POSIX sh）只靠 grep 讀、Renovate regex 也最單純；v2.4 §7／§11 已以 version.toml 稱呼其公開格式")
p2.append(c); Y = max(Y + 16, 96)
# ---- 左：目錄樹 ----
TW = {0: 200, 1: 520, 2: 490, 3: 460}
TN = {}   # id → (x, y, w, h)
def tnode(pid, level, text, style, y, tagged=False):
    x = 40 + 30 * level; w = TW[level]
    h = hvt(text, w - 12, tagged, pad=6)
    p2.extend(vt(pid, "1", style, text, x, y, w, h, tagged=tagged))
    TN[pid] = (x, y, w, h)
    return y + h + 10
def tedge(eid, par, ch):
    """樹線：從父框底部（左邊 14px 處）往下，再從左側進子框中線。"""
    px, py, pw, ph = TN[par]; cx, cy, cw, chh = TN[ch]
    tx = px + 14
    p2.append(ew(eid, par, ch, "", (round(14 / pw, 4), 1), (0, 0.5), [(tx, cy + chh / 2)]))
ty = Y + 34
p2.append(v("p2_lbl", "1", TEXT(13) + "align=left;fontStyle=1;", "3. 目錄樹（專案根 = 含 .vendor_kit/ 的目錄；每格：用途；寫：誰產生｜改：誰可改）", 40, Y, 580, 28))
ty = tnode("t_root", 0, "<b>專案/</b>（使用者的；專案根）", F_USER, ty)
ty = tnode("t_just", 1, "<b>justfile</b> ── 使用者的 just 入口；install 只加一行 import '.vendor_kit/entry.just'（無 → 建；有 → 問／-y；已含 → 不再加）\n寫：install｜改：使用者隨意；uninstall 問後只刪與我們寫的完全相同的那行；add 只讀它查撞名", F_USER, ty, True)
ty = tnode("t_vk", 1, "<b>.vendor_kit/</b> ── 根目錄只多這一個；薄殼 + 狀態 + 快取都在裡面；上層目錄不得再有一個（禁止巢狀）\n寫：install、upgrade vendor_kit 重產薄殼（先比對薄殼自描述首行；sync 不寫薄殼）｜改：人不改；uninstall 只刪 hash 相符的自產檔", F_GIT, ty, True)
ty = tnode("t_ver", 2, "<b>version.toml</b> ── 進 git：唯一來源。第一行 vendor_kit = \"ghcr.io/…/vendor_kit:vN@sha256:…\"（唯一符合 ^vendor_kit\\s*= 的行；禁 BOM／重複鍵）；[tools] 一行一工具 tag@digest；schema = N\n寫：install／add／upgrade／remove（apply 最後才寫）｜改：使用者可手改、Renovate PR 改；sync 只讀", F_GIT, ty, True)
ty = tnode("t_vl", 2, "<b>version.local.toml</b> ── 不進 git（我們的 .gitignore 擋）：工具覆寫 path:<dir>；引擎覆寫本機 image tag + image ID\n寫：dev／undev（含 image ID 欄位）；bootstrap --local 在 install 成功後才寫｜改：不建議手改；uninstall 只在 hash 相符（自產、未被改）時刪，否則保留並回報；CI=1 有任何覆寫 → sync 回 1", F_NOGIT, ty, True)
ty = tnode("t_gi", 2, "<b>.gitignore</b> ── 進 git，我們自己的：cache/ gen/ version.local.toml .tmp.*（使用者的 .gitignore 除非工具 strategy=append 且你同意，否則不碰）；第一行自描述\n寫：install／upgrade vendor_kit 重產｜改：人不改", F_GIT, ty, True)
ty = tnode("t_entry", 2, "<b>entry.just</b> ── 進 git：mod vendor_kit 'vendor.just' + import? 'gen/tools.just'（零 set 零 recipe）；第一行自描述\n寫：引擎 launcher-gen（install／upgrade vendor_kit）｜改：人不改", F_GIT, ty, True)
ty = tnode("t_vj", 2, "<b>vendor.just</b> ── 進 git：動詞 recipe 一行轉發 + sync 前置（set positional-arguments 只放這；每次呼叫附 --protocol P；檢查只在專案根執行）；第一行自描述\n寫：引擎 launcher-gen（install／upgrade vendor_kit）｜改：人不改", F_GIT, ty, True)
ty = tnode("t_ci", 2, "<b>ci/check.sh</b> ── 進 git：下游 CI 呼叫的契約檢查（五步，見契約⑤；隨 upgrade vendor_kit 更新）；第二行自描述（第一行 shebang）\n寫：引擎 launcher-gen｜改：人不改", F_GIT, ty, True)
ty = tnode("t_bl", 2, "<b>baseline/<repo>/</b> ── 進 git：上次合併的範本副本（三方合併的共同祖先；歷史狀態，不由 version.toml 推導）\n寫：install 建空 baseline/；add 建 <repo>/、upgrade 推進（有衝突仍推到新版）｜改：人不改（改了合併就錯）", F_GIT, ty, True)
ty = tnode("t_meta", 2, "<b>baseline/<repo>/.vendor_kit.toml</b> ── 進 git：metadata（欄位見右；schema = N）；兼作空目錄佔位\n寫：add／upgrade（install 不建）｜改：人不改", F_GIT, ty, True)
ty = tnode("t_gen", 2, "<b>gen/</b> ── 不進 git：引擎產生的三種檔（下列三格），各自由不同動詞寫\n寫：引擎｜改：人不改（會被覆蓋）", F_NOGIT, ty, True)
ty = tnode("t_tools", 3, "<b>tools.just</b> ── mod <ns> '../cache/<repo>/just/<ns>.just'，一行一命名空間（一工具可多行；零 set 零 recipe）\n寫：引擎 launcher-gen（sync／add／remove／upgrade 重生；最後寫、與 cache 同一 apply 內原子替換）｜改：人不改", F_NOGIT, ty, True)
ty = tnode("t_gstamp", 3, "<b>.stamp</b> ── 只記產生薄殼的引擎 ref（一行）；≠ version.toml 第一行 → sync 退出 1 提示 upgrade vendor_kit（不重寫）\n寫：只由 install／upgrade vendor_kit 寫（sync 不寫）｜改：人不改", F_NOGIT, ty, True)
ty = tnode("t_rstamp", 3, "<b><repo>.stamp</b> ── 每工具一個印記：第一行 index digest（或 path:<dir>／image:），之後每檔 sha256；sync 用它決定要不要 materialize\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_repo", 2, "<b>cache/<repo>/</b> ── 不進 git、使用者不可改；只放 materialize 從暫存 /dist 展開的內容（dev 時是唯讀 symlink → <dir>/dist；印記不在這裡）\n寫：引擎 materialize（apply 決定套用之後）｜改：不可改（verify 失敗 → 重裝並 warn）", F_NOGIT, ty, True)
ty = tnode("t_files", 3, "<b>files/ …</b> ── 工具檔案（dist/files/ 全部；不含 symlink，展開時驗）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty)
ty = tnode("t_init", 3, "<b>init.toml</b> ── 初始檔清單（[[file]] src／dest／strategy = \"copy\"|\"append\"，預設 copy）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_rjust", 3, "<b>just/<ns>.just</b> ── 工具的 just 模組，每檔一個頂層命名空間（<repo>.just 必有）\n寫：引擎 materialize｜改：不可改", F_NOGIT, ty, True)
ty = tnode("t_tmp", 2, "<b>.tmp.*</b> ── 不進 git：remove／uninstall 的進度日誌（add／upgrade 的在 metadata state=in-progress）\n寫：apply 第一個寫入前建、最後一步刪｜改：人不改；失敗留著，下次任何動詞先恢復", F_NOGIT, ty, True)
ty = tnode("t_user", 1, "<b>初始檔</b>（例 Dockerfile、setup.toml…；路徑由 init.toml 的 dest 決定）── 使用者的；進 git；狀態記在 metadata（已納管／拒絕過／沒納管／使用者刪了）\n寫：add 建（已存在不納管；strategy=append 問後加行）、upgrade 逐檔問後換／三方合併／建新檔（拒絕 → declined）｜改：使用者隨意；remove／uninstall 永不刪，印清單", F_USER, ty, True)
for eid, par, ch in [("te1", "t_root", "t_just"), ("te2", "t_root", "t_vk"),
                     ("te3", "t_vk", "t_ver"), ("te4", "t_vk", "t_vl"), ("te5", "t_vk", "t_gi"), ("te6", "t_vk", "t_entry"), ("te7", "t_vk", "t_vj"),
                     ("te8", "t_vk", "t_ci"), ("te9", "t_vk", "t_bl"), ("te10", "t_vk", "t_meta"), ("te11", "t_vk", "t_gen"),
                     ("te12", "t_gen", "t_tools"), ("te13", "t_gen", "t_gstamp"), ("te15", "t_gen", "t_rstamp"),
                     ("te14", "t_vk", "t_repo"), ("te16", "t_repo", "t_files"), ("te17", "t_repo", "t_init"), ("te18", "t_repo", "t_rjust"),
                     ("te20", "t_vk", "t_tmp"), ("te19", "t_root", "t_user")]:
    tedge(eid, par, ch)
tree_end = ty
# ---- 右欄 ----
RX, RW = 620, 980
ry = Y
def rlabel(pid, label, y):
    p2.append(v(f"{pid}_l", "1", TEXT(13) + "align=left;fontStyle=1;", label, RX, y, RW, 28)); return y + 32
def rbox(pid, style, text, y, tagged=False, pad=6):
    h = hvt(text, RW, tagged, pad=pad)
    p2.extend(vt(pid, "1", style, text, RX, y, RW, h, tagged=tagged)); return y + h + 14
ry = rlabel("p2_tc", "「會碰使用者東西」只有兩列（不變量：可以建、要改先問、永不刪、永不覆蓋；拒絕 → 不寫、metadata 記 declined）", ry)
ry = tbl(p2, "p2_tc", "1", RX, ry, [("東西", 200), ("怎麼碰", 780)], [
 ["根 justfile 一行", "install：無 → 建；有 → 問「要加這一行嗎」（-y 直接加並印出）；已含 → 不再加｜uninstall：問「要刪這一行嗎」，只刪與我們寫的完全相同的行｜add：只讀它做撞名檢查（工具命名空間 vs 根 justfile 既有 recipe／module、保留名 vendor_kit；撞 → 1 拒絕，不改）"],
 ["初始檔（init.toml 的 dest）", "add：無 → 建（印出建了什麼）；有 → 不納管、不覆蓋；strategy=append 問後加行｜upgrade：逐檔判斷後問（§5）；新版新增檔問「要建 X 嗎」（Q14）；拒絕過的不再問，新版又改才再問｜remove／uninstall：永不刪，印清單；append 行經詢問可刪（唯一命中）"],
], marks={(0, 0), (1, 0)})
ry = rbox("p2_not", RULE, "<b>不碰</b>：使用者的 .gitignore（除非工具以 strategy=append 宣告且你同意）、.git/info/exclude（dev 也不寫）、.git 本身（引擎不讀 .git、不碰 index）；我們要忽略的路徑全放 .vendor_kit/.gitignore", ry, True)
ry = rlabel("p2_ver", ".vendor_kit/version.toml（進 git；檔名待拍板 (1)，格式已定；每個 TOML 都有 schema = N + 寫入者版本，同 schema 只加不改）", ry)
ry = rbox("p2_ver", CODE, "vendor_kit = \"ghcr.io/<org>/vendor_kit:vN@sha256:…\"      # 第一行固定：引擎 ref；啟動器 grep 讀（唯一符合 ^vendor_kit\\s*= 的行）\n"
 "schema = 1                                            # 格式版本（新讀舊：記憶體轉換，只在本來要寫時寫回）\n"
 "[tools]\n<repo> = \"ghcr.io/<org>/<repo>-dist:<tag>@sha256:…\"       # 每工具一行 tag@digest（digest = 多架構 index digest）", ry, True)
ry = rlabel("p2_vl", ".vendor_kit/version.local.toml（不進 git；dev 寫、undev 刪；sync 讀到工具覆寫就跳過 pull／verify；CI=1 有任何覆寫 → 1）", ry)
ry = rbox("p2_vl", CODE, "<repo> = \"path:<dir>\"                 # dev <repo> -p <dir>：cache/<repo>/ 變 symlink → <dir>/dist；啟動器掛 -v <dir>/dist:/dist/<repo>:ro\n"
 "vendor_kit = \"<tag>\"                  # dev vendor_kit -i <tag>：本機引擎 image，只能 tag（docker load 後無 RepoDigests）\n"
 "vendor_kit_image_id = \"sha256:…\"      # 解析後的 image ID：同 tag 重 build 才會被發現；docker run --pull never；undev 連這行一起撤", ry, True)
ry = rlabel("p2_sh", "薄殼自描述首行（Q17；entry.just／vendor.just／.gitignore 第一行、ci/check.sh 第二行）── install／upgrade vendor_kit 重產前的比對依據", ry)
ry = rbox("p2_sh", CODE, "# vendor_kit-shell/1 engine=v3 sha256=<其餘內容 LF 正規化後的 hash>\n"
 "# ↑ <P> = 協定版本、engine = 產生它的引擎版本；引擎重算 hash + 對 image 內模板二次比對，不符 → 1 列差異不動（薄殼被人改過）", ry, True)
ry = rlabel("p2_st", ".vendor_kit/gen/<repo>.stamp 每工具的印記（materialize 寫；verify 逐檔比 sha256；不放在 cache/<repo>/ 裡）", ry)
ry = rbox("p2_st", CODE, "sha256:…                                      # 第一行：多架構 index digest；dev 時為 path:<dir> 或 image:<tag>\n"
 "<sha256>  files/…                              # 之後每檔一行 sha256\n<sha256>  init.toml\n<sha256>  just/<ns>.just", ry, True)
ry = rlabel("p2_gs", ".vendor_kit/gen/.stamp（只由 install／upgrade vendor_kit 寫；sync 只比對不寫）── 只有一行", ry)
ry = rbox("p2_gs", CODE, "ghcr.io/<org>/vendor_kit:vN@sha256:…          # 產生薄殼的引擎 ref（引擎覆寫時為 <tag>）；薄殼 hash 不在這裡，在薄殼自己的首行", ry, True)
ry = rlabel("p2_mt", "baseline/<repo>/.vendor_kit.toml metadata（add／upgrade 寫；schema = N + 寫入者版本）", ry)
ry = tbl(p2, "p2_mt", "1", RX, ry, [("欄位", 180), ("內容", 380), ("誰讀它、做什麼", 420)], [
 ["schema／寫入者版本", "schema = N 與寫這份檔的引擎版本", "任何引擎：讀任一舊 schema → 記憶體轉換；只在本來要寫該檔的明確動作才寫回當前 schema"],
 ["來源 ref@digest", "這份 baseline 來自哪個工具 image（tag@index digest）", "追溯；upgrade 判斷 baseline 是哪一版"],
 ["最後合併版本", "最後一次逐檔合併時的工具版本", "sync：≠ version.toml → 本機 warn 提示 upgrade、CI 下 1；upgrade：≠ version.toml → 先補「待合併」到該版然後停"],
 ["完成標記", "add 走完 materialize → 初始檔 → baseline 才寫", "sync：缺 → 1「請 just vendor_kit add <repo>」；add：已接入且完成 → 0 無變更"],
 ["初始檔狀態（Q15）", "每個 dest 一筆：已納管／拒絕過（declined）／本來就有沒納管／使用者刪了", "upgrade：已納管才逐檔判斷；拒絕過 → 不問（新版又改才再問）；dry-run 與 check.sh 印「X 沒納管，與範本差 N 行」「Y 你拒絕過，vZ 有新版」（dest 在 CI 路徑時醒目）；不動檔不紅燈"],
 ["declined", "拒絕過的東西：新檔、append 行、換新版、合併（各記版本）", "任何詢問的拒絕分支都寫這裡：不寫檔、之後不重問"],
 ["append 過的行", "每個 strategy=append 檔：我們實際插入的那幾行原文（各工具分開記）", "upgrade：只對可辨識的上次插入行問後替換（CRLF／LF 等價、其餘精確；零命中或多處 → 保留只 warn）；remove：問後只刪唯一命中的"],
 ["衝突中檔案", "upgrade 回 2 時留 <<<<<<< vendor_kit:baseline 標記的檔名清單", "upgrade：仍含我們的標籤 → 2 停（檔案失蹤不算已解）；解完重跑才清空（拿鎖後）；sync／check.sh 提示"],
 ["進度日誌", "state=in-progress：apply 逐檔原子替換時列已完成／未完成（add／upgrade）", "第一個寫入前建立、最後一步刪除；任何動詞開始前：有未完成 → 先恢復再繼續；失敗時明列"],
 ["（檔案本身）", "兼作 baseline/<repo>/ 空目錄佔位（git 不追蹤空目錄）", "—"],
], marks={(0, 0), (4, 0), (5, 0), (6, 0), (7, 0), (8, 0)})
ry += 14
ry = rbox("p2_rule", RULE, "<b>規則摘要</b>\n・version.toml 是唯一來源：sync 每次 just 拿它對印記，不一致就 materialize（只拉鎖定版）；apply 拿鎖後先重驗 resolve 給的輸入指紋，不同 → 1「請重跑」\n"
 "・自動化（sync）只碰不進 git 的東西（cache/<repo>/、gen/tools.just、gen/<repo>.stamp）：不碰使用者的檔、不寫薄殼、不寫 gen/.stamp；薄殼 ≠ version.toml 第一行引擎 → 1 提示 upgrade vendor_kit（install／upgrade vendor_kit 不被擋）；薄殼重產只由 upgrade vendor_kit／install 做，先比對薄殼自描述首行的 hash（被改過 → 1 列差異不動）\n"
 "・baseline 是上次合併的歷史狀態，不由 version.toml 推導（待合併時 version 已 B、baseline 仍 A）\n"
 "・進 git 的只有：justfile 那行、.vendor_kit/（不含 cache/、gen/、version.local.toml、.tmp.*）、初始檔；人只改：justfile、初始檔、version.toml（手動升版）\n"
 "・舊薄殼（--protocol P 太舊）跑新 major 引擎的一般動詞 → 3，不動任何檔；救援路徑（install／upgrade vendor_kit／sync 不符提示）永遠可用", ry, True)
ry = rlabel("p2_mx", "動詞 × 檔案（寫 = 產生／覆蓋；刪 = 移除；— = 不碰；依 §2／§5／v2.2～v2.5）── 表 A：進 git 的宣告與薄殼", ry)
MXA = [("動詞", 120), ("version.toml", 215), ("version.local.toml", 215), ("根 justfile", 215), ("薄殼（tracked 四檔）", 215)]
ry = tbl(p2, "p2_mx", "1", RX, ry, MXA, [
 ["install", "寫第一行（引擎 ref）", "—（bootstrap --local 成功後才寫）", "無 → 建；有 → 問加一行；已含 → 不再加", "首行 hash 相符才重產；不符 → 1 列差異"],
 ["uninstall", "先預檢再刪（自產）", "hash 相符才刪；否則保留並回報", "問後只刪相同的行（最後一步；之後才刪日誌）", "只刪 hash 相符的自產檔；未知或被改的保留並回報"],
 ["add", "最後加一行", "—", "—（只讀：撞名檢查）", "—"],
 ["remove", "刪一行", "—", "—", "—"],
 ["upgrade（工具）", "最後改一行", "—", "—", "—"],
 ["upgrade vendor_kit", "自身升級：第一行（舊引擎改）", "—（覆寫時用該 image --pull never）", "—", "首行 hash 相符才重產 + 寫 gen/.stamp；降版讀不了 → 3 不動"],
 ["dev", "—", "加行（工具 path:／引擎 tag + image ID）", "—", "—（dev vendor_kit -i 舊 image 禁止重產）"],
 ["undev", "—", "刪行（含 image ID 欄位；建日誌後）", "—", "—"],
 ["sync", "—（只讀）", "—（只讀；CI=1 有覆寫 → 1）", "—", "不寫（不符 → 1 提示 upgrade vendor_kit）"],
 ["update", "—", "—", "—", "—"],
 ["prune", "—（只讀：哪些 image 仍被引用）", "—", "—", "—"],
 ["任何動詞（協定太舊）", "—", "—", "—", "— → 3，不動任何檔（例外：install／upgrade vendor_kit／sync 提示）"],
], marks={(0, 0), (1, 0), (5, 0), (6, 0), (7, 0), (10, 0), (11, 0)})
ry += 14
ry = rlabel("p2_my", "表 B：baseline／gen 三檔（各一欄）／cache／初始檔", ry)
MXB = [("動詞", 120), ("baseline/ + metadata", 160), ("gen/tools.just", 125), ("gen/.stamp", 115), ("gen/<repo>.stamp", 140), ("cache/<repo>/", 150), ("初始檔", 170)]
ry = tbl(p2, "p2_my", "1", RX, ry, MXB, [
 ["install", "建空 baseline/（不建 metadata）", "重生", "寫（引擎 ref）", "—", "—", "—"],
 ["uninstall", "先預檢（hash 相符清單）→ 逐工具 remove；未知或被改的保留", "刪（自產）", "刪（自產）", "刪（自產）", "刪（未知檔保留並回報）", "永不刪；append 行經詢問可刪"],
 ["add", "建 + metadata（完成標記、初始檔狀態、append 行）", "重生", "—", "materialize 寫", "materialize", "無 → 建；有 → 不納管；append 問後加；拒絕 → declined"],
 ["remove", "刪", "刪該工具的 mod 行", "—", "刪", "刪", "永不刪；append 行問後刪（唯一命中）"],
 ["upgrade（工具）", "推進（衝突仍推）+ 進度日誌 + 狀態", "重生", "—", "materialize 寫", "materialize", "逐檔問：換／三方合併／append 行替換／建新檔"],
 ["upgrade vendor_kit", "—", "重生", "寫（引擎 ref）", "—", "—", "—"],
 ["dev", "—", "—", "—", "寫 path:／image:", "改成唯讀 symlink", "—"],
 ["undev", "—", "—", "—", "重寫（materialize）", "重新 materialize（經 docker）", "—"],
 ["sync", "—（只讀完成標記、落後）", "缺或需重生 → 重生", "不寫（只比對）", "materialize 時寫", "materialize／重裝（只拉鎖定版）", "—"],
 ["update", "—", "—", "—", "—", "—", "—"],
 ["prune", "—", "—", "—", "—", "—", "—（只動 docker 資源）"],
], marks={(0, 0), (1, 6), (2, 6), (3, 6), (4, 6), (5, 0), (6, 0), (7, 0), (8, 0), (10, 0)})
ry += 14
ry = rbox("p2_reno", RULE, "<b>version.toml 怎麼被讀</b>\n・啟動器（sh）：grep 第一行 → 引擎 ref（version.local.toml 覆寫優先）；不解析 toml（resolve 的 stdout 才是它的輸入）\n"
 "・引擎 version 模組：toml 讀寫（schema 轉換）+ version.local.toml 覆寫；flock；apply 最後才寫 version.toml\n"
 "・Renovate：regex manager + docker datasource，抓每行的 currentValue（tag）+ currentDigest，PR 只改那一行\n"
 "・deploy：交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR（工具契約一句；vendor_kit 不檢查）；version.toml 公開格式可供來源紀錄", ry, True)
Y = max(tree_end, ry) + 10
p2 += lgd("p2", 40, Y, ["v2git", "v2no", "v2usr", "v2code"], "樹線 = 目錄包含（上 → 下）\n每格右上角綠標籤 = v2 改")
p2 += lgd("p2b", 40, Y + 60, ["v2tag", "pendn", "ruleb", "tblh"], "本頁沒有分組框\n細節與流程見流程頁")
p2 += terms("p2", 40, Y + 160, [
 ("唯一來源", "version.toml：專案「該裝哪版」只看它；印記、gen/、薄殼由它推導；baseline 是上次合併的歷史狀態，不由它推導"),
 ("version.local.toml", "同目錄的 dev 覆寫（不進 git）：<repo> = \"path:<dir>\" 或 vendor_kit = \"<本機 image tag>\" + image ID；啟動器與引擎讀到就用它"),
 ("schema", "每個 vendor_kit 寫的 TOML 裡的格式版本號（schema = N）+ 寫入者版本；同 schema 只加不改；新引擎讀舊檔在記憶體轉換，只在本來要寫時寫回；舊資料永遠可讀可遷"),
 ("印記 gen/<repo>.stamp", "materialize 寫在 gen/ 的每工具一檔：第一行 = 裝的是哪個 index digest（或 path:<dir>／image:），其餘每檔 sha256；verify 逐檔比；cache/<repo>/ 只放展開內容"),
 ("index digest", "多架構 image 的 manifest list 的 sha256（amd64、arm64 共用一個）；version.toml 與印記都記它，不記單平台 digest"),
 ("gen/.stamp", "只記「gen/ 與薄殼是哪個引擎產生的」（引擎 ref 一行）；≠ version.toml 第一行 → sync 退出 1 提示 upgrade vendor_kit；薄殼 hash 改記在薄殼自描述首行"),
 ("薄殼", ".vendor_kit/ 進 git 的最小啟動器：entry.just、vendor.just、.gitignore、ci/check.sh；只轉發、不做事；每檔首行自描述"),
 ("launcher-gen", "引擎模組（p4）：產薄殼四檔、gen/tools.just、gen/.stamp、根 justfile 那一行；薄殼只由 install／upgrade vendor_kit 呼叫它重產"),
 ("gen/", "引擎產生的檔，不進 git：tools.just（sync／add／remove／upgrade 重生）、.stamp（只由 install／upgrade vendor_kit 寫）、<repo>.stamp（materialize 寫）；.stamp 缺或不符 → sync 提示 upgrade vendor_kit"),
 ("cache/<repo>/", "工具 image 的 /dist 展開副本，收在 .vendor_kit/ 裡；不進 git、不可改；dev 時是唯讀 symlink"),
 ("materialize", "引擎內部步驟：把暫存 /dist 展開到 cache/<repo>/ → 寫印記 → verify；add／upgrade／undev／sync 都會呼叫；在 apply 決定套用之後才做"),
 ("N（目標版範本）", "逐檔判斷與 dry-run 讀的新版 = 暫存目錄掛進引擎的 /dist/<repo>（唯讀），不是 cache"),
 ("sync", "每次 just 的自動前置：只寫 cache/<repo>/、gen/tools.just、gen/<repo>.stamp，不寫薄殼與 gen/.stamp（不符 → 1 提示 upgrade vendor_kit）；CI=1 frozen；範圍預設全部工具；無變更時走快路徑"),
 ("strategy=append", "init.toml 每個 [[file]] 的 strategy 欄位（copy | append，預設 copy）；append：檔不存在 → 建；存在 → add 問後把幾行加進使用者的檔（實際插入的行記在 metadata，重跑不重複）；upgrade／remove 只動可辨識的上次插入行"),
 ("CRLF／LF", "兩種換行符號（Windows 用 CRLF、Linux 用 LF）；比對 append 行時視為等價，其餘字元要精確相同"),
 ("初始檔", "工具 init.toml 列出、add 時建到專案的檔（例 Dockerfile）；歸使用者，進 git；已存在就不納管；upgrade 逐檔問；四種狀態記在 metadata（Q15）"),
 ("declined", "metadata 記的「你拒絕過」：新檔、append 行、換新版、合併都可拒；拒絕 → 不寫、之後不重問（新版又改才再問）；dry-run／check.sh 印提醒"),
 ("tag@digest", "image 的版本標籤 + index digest；tag 給人看、digest 鎖內容"),
 ("sha256", "內容的指紋（雜湊）；digest、印記、薄殼首行 hash 都是 sha256"),
 ("RepoDigests", "docker 記錄 image 從哪個 registry 以哪個 digest 拉來的欄位；docker load 的 image 沒有，所以本機引擎只能用 tag"),
 ("symlink", "指向另一個路徑的捷徑檔；dev 時 cache/<repo>/ 指向 <dir>/dist；dist/files/ 裡不准有"),
 ("just／recipe", "just = 指令執行器（像 make）：專案根的 justfile 列出可打的指令；recipe = 其中一條指令定義（名字 + 要跑的命令）；「一行轉發」= recipe 只有一行，把參數原樣丟給啟動器"),
 ("set", "justfile 裡的全域設定行（例 set positional-arguments）；被 import 的檔的 set 會外溢到根檔，所以只放在 mod 進來的 vendor.just"),
 ("resolve／apply", "動 image 的動詞（add／upgrade／sync／undev）的兩段：resolve 只讀、把要拉的 image 與輸入指紋用 stdout 回給啟動器 → 主機 docker 拉 → apply 拿 flock、重驗指紋、建進度日誌才寫檔；version.toml 最後寫、最後刪日誌"),
 ("Renovate／PR", "Renovate = GitHub 機器人（下游自選）：GHCR 有新版就開 PR 改 version.toml 一行；PR = 請求合併某分支的頁面；人在 PR 分支補完合併、CI 綠後 merge"),
 ("regex manager／docker datasource", "Renovate 的兩個設定：regex manager 用正規表示式在 version.toml 找每行的 tag 與 digest；docker datasource 去 registry 查有沒有新 tag"),
 ("currentValue／currentDigest", "Renovate regex 抓到的兩個值：currentValue = 現在的 tag、currentDigest = 現在的 sha256；PR 就是把它們換成新的"),
 ("flock", "Linux 檔案鎖：引擎 apply 對專案目錄上鎖，避免兩個 just 同時寫；等 60 秒逾時 → 失敗"),
 ("輸入指紋", "resolve 輸出的「它看到的 version.toml、metadata、要動的使用者檔 hash + 鎖定 digest」；apply 拿鎖後重驗，不同 → 1 請重跑"),
 ("GHCR／image", "GHCR = GitHub 的 image 倉庫；image = docker 打包檔（工具 image 只是資料包、引擎 image 是會跑的程式）"),
 ("deploy", "把專案交付物部署到執行環境；工具契約一句：交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR（vendor_kit 不檢查）"),
] + T_COMMON)
pages_v1_a.append(("v1p2", "契約 v2：專案裡的檔與 version.toml", p2))

# ================= P3 v1p3：契約③ 工具 repo、④ 啟動器↔引擎、⑤ CI =================
p3 = [v("title", "1", TITLE, "契約③ 工具 repo 要交的、契約④ 啟動器 ↔ 引擎、契約⑤ CI ── v2.5 定案", 40, 20, 860, 34),
      v("p3_num", "1", TEXT(12) + "align=left;", NUM_T, 40, 56, 860, 26)]
c, Y = nopend("p3", 920, 12, 680,
 "(5) append 行比對已定（v2.3 §1）：CRLF／LF 等價、其餘精確；零命中或多處 → 保留只 warn。dist/files/ 的 symlink 已定（v2.2 E）：第一版禁止。"
 "dist 文字檔一律 LF、check.sh --dist 擋 CRLF 已定於 issue #29。v2.4 的 --protocol、結束狀態 3、Q16／Q19 相容承諾、19 條執行環境、驗收矩陣都已併入本頁")
p3.append(c); Y = max(Y + 16, 96)
# ---- ③ 工具 repo 要交的 ----
DIST_T = ("<repo>/                  # 工具 repo\n"
 "├─ dist/\n"
 "│  ├─ files/…            # 全部出貨（原樣展開）\n"
 "│  ├─ init.toml          # 初始檔清單 [[file]] src／dest／strategy\n"
 "│  └─ just/<ns>.just     # 每檔一個命名空間\n"
 "└─ Dockerfile.dist       # FROM scratch + COPY dist/ /dist/")
DW = 420; RXd = 460; R1W = (1540 - RXd - 3 * 16) // 4; R2W = (1540 - RXd - 3 * 16) // 4
D_ROW1 = [
 ("d4_1", LT12, "<b>dist/files/</b>\n全部出貨；materialize 原樣展開到 .vendor_kit/cache/<repo>/files/；symlink 第一版禁止（v2.2 E；check.sh --dist 擋、引擎展開時也驗）；文字檔一律 LF [#29]", True),
 ("d4_2", LT12, "<b>dist/init.toml</b>\n[[file]] src／dest [strategy=\"copy\"|\"append\"]（預設 copy），dest 相對專案根；禁止用 copy 指向根 .gitignore／.dockerignore／.editorconfig → 要用 append；初始檔內容只引用穩定入口 just <ns> …，不得寫死 cache 內部路徑（Q14）", True),
 ("d4_3", LT12, "<b>dist/just/<ns>.just</b>\n每檔一個頂層命名空間，數量工具自決，<repo>.just 必須存在；撞名 → add 拒絕（其他已接工具、根 justfile 既有 recipe／module、保留名 vendor_kit）；recipe 用 cd \"{{justfile_directory()}}\" 回專案根", True),
 ("d4_4", LT12, "<b>Dockerfile.dist</b>\nFROM scratch + COPY dist/ /dist/；沒有程式、不 FROM vendor_kit；dist 可執行性是工具 repo 責任（Q21：vendor_kit 只搬移）", True),
]
D_ROW2 = [
 ("d4_5", PT12, "<b>image ghcr.io/<org>/<repo>-dist:<tag></b>\n多架構 amd64 + arm64（同一次 buildx、COPY-only；CI 驗兩平台內容一致）；version.toml 與印記記 index digest（#26）；公開／私有自決（Q7）；已釋出 image 永不刪", True),
 ("d4_6", PT12, "<b>引擎 image ghcr.io/<org>/vendor_kit:vN</b>\n公開；多架構 amd64 + arm64；也出 docker save tar 離線包（#27，bootstrap --local 吃）；Release 資產永不刪", True),
 ("d4_7", LT12, "<b>工具 repo 的 CI</b>\n跑 vendor_kit 出貨的 check.sh --dist：dist 佈局、init.toml 合法（strategy 只能 copy|append）、dest 規則、無 symlink、無 CRLF [#29]、image 可展開、兩平台內容一致", True),
 ("d4_8", LT12, "<b>deploy（一句話契約）</b>\n交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR；vendor_kit 不檢查；version.toml 公開格式可供來源紀錄", True),
]
DEST_T = ("<b>dest 規則（引擎在任何寫入前驗，不只供應端 lint）</b>：dest 正規化後不得越出 repo、不得指向 .vendor_kit/；"
 "兩工具同 dest：copy/copy、copy/append → add 拒絕；append/append → 允許，各工具的行分開記錄，重疊或歸屬不明 → 拒絕；add 與 upgrade 都檢查")
dh = hv(DIST_T, DW, pad=6)
r1h = max(hvt(t, R1W, tg) for _, _, t, tg in D_ROW1); r2h = max(hvt(t, R2W, tg) for _, _, t, tg in D_ROW2)
desth = hvt(DEST_T, 1520, True)
l4h = 50 + max(dh, r1h + 16 + r2h) + 16 + desth + 20
p3.append(v("p3L4", "1", SW(NEUTRAL), "契約③ 工具 repo 要交的（供應側；改了要升 major 並公告）", 40, Y, 1560, l4h))
p3.append(v("p3_dist", "p3L4", CODE, DIST_T, 20, 50, DW, dh))
x = RXd
for pid, st, t, tg in D_ROW1:
    p3.extend(vt(pid, "p3L4", st, t, x, 50, R1W, r1h, tagged=tg)); x += R1W + 16
x = RXd
for pid, st, t, tg in D_ROW2:
