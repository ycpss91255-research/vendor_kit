p3 += lgd("p3b", 40, Y + 70, ["v2code", "v2tag", "notep", "ruleb", "tblh"], "淺灰底容器 = ②③ 的分組（標題 = 該段做的事）")
p3 += terms("p3", 40, Y + 170, [
 ("dist/", "工具 repo 出貨的目錄：files/（展開到 cache/<repo>/ 的全部）、init.toml（初始檔清單）、just/<ns>.just（工具自己的 recipe）"),
 ("Dockerfile.dist", "只有 FROM scratch + COPY dist/ /dist/ 的 Dockerfile；產出「純資料 image」，沒有程式、不會被執行"),
 ("GHCR／image", "GHCR = GitHub 的 image 倉庫（ghcr.io）；image = docker 打包檔：工具 image 是純資料包、引擎 image 是會跑的程式"),
 ("buildx", "docker 的多架構建置工具：同一次 build 同時產 amd64 + arm64 兩份，合成一個多架構 index"),
 ("多架構 index／index digest", "同一 tag 下 amd64 + arm64 兩份 manifest 的清單；docker 不帶 --platform 就挑原生；version.toml 與印記記清單的 digest"),
 ("docker create／cp", "不執行容器，只建一個容器殼再把 /dist 複製出來；純資料 image 沒有程式所以不能 docker run"),
 ("daemon", "主機上常駐的 docker 服務；拉 image、挑原生架構都是它做"),
 ("引擎 ref", "version.toml 第一行的 vendor_kit image@digest（version.local.toml 可覆寫成本機 tag + image ID）；啟動器用它 docker run 引擎，也寫進 gen/.stamp"),
 ("gen/.stamp", "只記產生薄殼的引擎 ref（一行）；只由 install／upgrade vendor_kit 寫；啟動器用 grep 比它 == 引擎 ref（這兩個動詞跳過）；薄殼 hash 在薄殼自描述首行"),
 ("resolve／apply", "同一個引擎 image 的兩個編排用子命令：resolve 只讀、算清單與輸入指紋（stdout 協定 vk-resolve/1）；apply 拿鎖、重驗指紋、建進度日誌、寫檔、最後刪日誌"),
 ("輸入指紋", "resolve 看到的 version.toml、metadata、要動的使用者檔 hash + 鎖定 digest；apply 拿鎖後重驗，不同就 1 請重跑"),
 ("materialize", "引擎內部步驟：把暫存 /dist 展開到 cache/<repo>/、寫印記、verify；不是對外動詞；在 apply 決定套用之後才做"),
 ("N（目標版範本）", "逐檔判斷與 dry-run 讀的新版 = 啟動器展開到暫存、掛進引擎的 /dist/<repo>（唯讀），不是 cache"),
 ("strategy=\"append\"", "init.toml 每個 [[file]] 的 strategy 欄位（copy | append，預設 copy）：append = 檔不存在 → 建；存在 → 問後把幾行加進使用者已有的檔（根 .gitignore 類必須用它）；比對 CRLF／LF 等價、其餘精確"),
 ("CRLF／LF [#29]", "兩種換行符號（Windows 用 CRLF、Linux 用 LF）；append 行比對時視為等價；issue #29 定：dist 文字檔一律 LF，check.sh --dist 擋含 CRLF 的來源檔"),
 ("symlink", "指向另一個路徑的捷徑檔；dist/files/ 裡第一版禁止（check.sh --dist 擋、引擎展開時也驗）；dev 時 cache/<repo>/ 才是我們自己做的 symlink"),
 ("baseline", "baseline/<repo>/ = 上次合併的範本副本（三方合併的共同祖先）；同目錄 .vendor_kit.toml = metadata；apply 重驗指紋時一起比"),
 ("just／recipe", "just = 指令執行器（像 make），主機需 ≥ 1.33；recipe = justfile 裡一條指令定義；vendor.just 每個動詞一條 recipe 一行轉發給啟動器"),
 ("命名空間撞名", "工具 dist/just/<ns>.just 的 <ns> 與（a）其他已接工具（b）根 justfile 既有 recipe／module（c）保留名 vendor_kit 相同 → add 拒絕（撞名整個 just 會掛）"),
 ("dest", "init.toml 每個 [[file]] 要建到專案的目標路徑（相對專案根）；正規化後不得越出 repo、不得指向 .vendor_kit/"),
 ("just 的兩個目錄函式", "justfile_directory()、invocation_directory()：前者 = 該 justfile 所在目錄（工具 recipe 用 cd \"{{justfile_directory()}}\" 回專案根）；後者 = 你打指令時所在目錄（vendor_kit recipe 用兩者相等檢查「只准在專案根執行」）"),
 ("flock", "Linux 的檔案鎖；引擎 apply 對專案目錄上鎖，避免兩個 just 同時安裝互相踩"),
 ("uid/gid", "主機上你的使用者／群組編號；docker run -u 帶進容器，寫出的檔才不會變成 root 的"),
 ("rootless／Podman", "rootless = 不用 root 跑的 docker 模式（容器內已是你自己，不加 -u）；Podman = 相容 docker 指令的另一套容器工具（GitHub runner 內建）；兩者都進驗收"),
 ("dry-run（-n）", "只預覽不寫：動 image 的動詞照樣拉 image 展開到暫存，引擎 apply --dry-run 唯讀列清單；本機 → 0；CI=1 且需改 tracked 檔 → 1 印清單"),
 ("check.sh 五步", "vendor_kit 出貨、進 git 的腳本：sync frozen → verify → upgrade --dry-run → 工具測試 → 專案測試；工具 repo 用 --dist 檢查出貨"),
 ("check.sh --dist", "同一支腳本的供應端模式：在工具 repo 的 CI 驗 dist 佈局、init.toml、dest 規則、無 symlink、無 CRLF、image 可展開、兩平台一致"),
 ("lint／unit／測試矩陣", "lint = 靜態檢查（擋語法、擋比 just 1.33 新的功能）；unit = 單元測試；矩陣 = 同一套測試在多個 just 版本各跑一次"),
 ("ADR", "Architecture Decision Record：一份記錄「為什麼這樣決定」的短文件（docs/adr/）；破壞性變更、提高 floor 都要記一筆"),
 ("release／release-test", "release = 發佈版本（push image、附 bootstrap.sh 與 tar；已釋出 image／Release 資產永不刪）；release-test = 對剛發佈的 image 再測一次"),
 ("fixture repo", "驗收用的乾淨小 git repo：用剛 build 的引擎 image 從 bootstrap 到 upgrade 跑一遍完整流程；fixture 永不刪"),
 ("floor", "相容承諾的下限：固定的 release 常數（第一個正式版）；floor 以來每個已釋出的 bootstrap.sh + image 都拿來驅動候選版驗收；只能經 ADR 提高"),
 ("Renovate／PR／rebase", "Renovate = 下游自選的機器人，只改 version.toml 一行；PR = 請求合併的頁面；rebase = 把分支重接到最新主線（勿勾，會丟掉人補的合併）"),
 ("VENDOR_KIT_\nREGISTRY_TOKEN", "環境變數：私有 registry 查最新 tag 時給引擎用的登入權杖（引擎在容器內沒有主機的 docker 登入）；不給就改用 -t 指定版本（主機 docker pull 走主機認證）"),
 ("sha256", "內容的指紋（雜湊）；digest、印記、輸入指紋都是它"),
 ("tty／trap", "tty = 互動終端（能問問題）；沒有 tty（管線、CI）又需詢問 → 1；trap = shell 的收尾勾子，啟動器用它在中斷時清容器與暫存"),
 ("pull 逾時", "docker pull 卡住時的上限（預設值 + 可調參數，v1.0.0 必做）；逾時 → 1，不留半成品"),
 ("LC_ALL／TZ", "引擎容器內固定 LC_ALL=C.UTF-8（字元排序、編碼一致）、TZ=UTC（時間戳 UTC ISO 8601）；輸出不隨主機語系變"),
 ("worktree／submodule", "git worktree = 同一 repo 另開一個工作目錄；submodule = repo 裡嵌另一個 repo；前者進驗收、後者派子代理實測"),
] + T_COMMON)
pages_v1_a.append(("v1p3", "契約 v2：工具 repo、啟動器↔引擎、CI", p3))

# ================= P4 v1p4：架構圖 v2 ── 主機、引擎模組、registry =================
p4 = [v("title", "1", TITLE, "架構圖 v2 ── 主機、引擎 8 模組、registry（只畫模組、最小單元、模組間傳的資料）", 40, 20, 820, 34),
      v("p4_num", "1", TEXT(12) + "align=left;", NUM_T, 40, 56, 820, 26)]
NP_T = ("<b>本頁無待拍板</b>：§9 五項都不在本頁（(1) 見契約② p2；(4)(5) 已定，見 p1、p3）\n"
        "本頁只畫模組、最小單元、模組間傳的資料（箭頭只標傳什麼，不標動作；雙箭頭 = 讀寫都有）；載入順序／操作順序／sync 判斷／退出流程一律見流程頁（p5～）。啟動器不算引擎模組（主機側薄殼）")
p4.append(vb("p4_np", "1", NOTE, NP_T, 880, 12, 720, hv(NP_T, 720, pad=10)))
GY = max(12 + hv(NP_T, 720, pad=10) + 16, 96)
# ---- GHCR ----
GE_T = "<b>引擎 image ghcr.io/<org>/vendor_kit:vN（公開）</b>\n多架構 amd64 + arm64；一個專案用 version.toml 第一行那一版；引擎覆寫 vendor_kit=<tag>（version.local.toml）時改用本機 image，不 pull（--pull never）；也出 docker save tar（#27）；已釋出永不刪"
GD_T = "<b>工具 image ghcr.io/<org>/<repo>-dist:<tag></b>\n多架構 amd64 + arm64（同一次 buildx、COPY-only）；純資料 FROM scratch 只有 /dist；version.toml 與印記記 index digest"
GN_T = "<b>registry 模組只查 tag／index digest</b>（update／add／upgrade 用；私有 registry 需 VENDOR_KIT_REGISTRY_TOKEN 或改用 -t）\nsync 不查最新版；只拉鎖定版。拉取條件 = cache 缺／鎖定 digest 變／verify 失敗；pull 有逾時"
ghh = max(hvt(GE_T, 440, True), hvt(GD_T, 620, True), hvt(GN_T, 420, True)); GH = 50 + ghh + 20
p4.append(v("p4G", "1", SW(PURPLE).replace("strokeColor=#000000", "strokeColor=#9673a6"), "GHCR（ghcr.io）── 兩種 image 都多架構；拉取都由主機上的啟動器執行，引擎容器內不呼叫 docker", 40, GY, 1560, GH))
