fnh = hv(FN_T, 240, pad=8)
def grp_h(items): return 24 + 6 + len(items) * 34 + 4
FILES = {   # 模組列 → [(id, kind, style, title, items|h)]
 "m_ver": [("f_ver", "file", F_GIT, "version.toml（進 git）", 36), ("f_vl", "file", F_NOGIT, "version.local.toml（dev 覆寫）", 36)],
 "m_mat": [("f_repo", "grp", F_NOGIT_T, "cache/<repo>/（不進 git，不可改）", ["files/…", "init.toml", "just/<ns>.just"]), ("f_stamp", "file", F_NOGIT, "gen/<repo>.stamp（印記）", 32)],
 "m_bl": [("f_bl", "grp", F_GIT_T, "baseline/<repo>/（進 git）", ["範本副本（上次合併的）", "metadata .vendor_kit.toml"])],
 "im": [("f_user", "grp", F_USER_T, "初始檔（使用者的，進 git；永不刪、永不覆蓋）", ["Dockerfile 等（copy）", "根 .gitignore 幾行（append）"])],
 "m_lg": [("f_just", "file", F_USER, "根 justfile（使用者的，進 git）\n只問後加一行 import", 40), ("f_shell", "grp", F_GIT_T, "自有薄殼（進 git；首行自描述）", ["entry.just", "vendor.just", ".gitignore", "ci/check.sh"]), ("f_gen", "grp", F_NOGIT_T, "gen/（不進 git）", ["tools.just", ".stamp（只記引擎 ref）"])],
}
def files_h(lst): return sum((grp_h(it) if k == "grp" else it) for _, k, _, _, it in lst) + 8 * (len(lst) - 1)
R = {}; ey = 50 + fnh + 20
for pid, t, us, tg in mods:
    if pid == "im": mh = max(mod_h(u, w) for _, _, w, _, u in IM) + 20
    else: mh = mod_h(us, MW)
