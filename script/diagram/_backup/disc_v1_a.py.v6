H1 = "根 justfile（使用者的，進 git）\nimport '.vendor_kit/entry.just'"
H2 = ".vendor_kit/entry.just（進 git）\nmod vendor_kit 'vendor.just'\nimport? 'gen/tools.just'（零 set）"
H3 = ".vendor_kit/vendor.just（進 git）\n動詞 recipe：專案根檢查 + sync 前置 +\nverb *args 一行轉發（附 --protocol P）"
H4 = "<b>啟動器 sh</b>（主機側薄殼，非引擎模組；POSIX sh，只用 docker + grep／sed）"
H4U = ["grep 第一行", "docker pull", "docker create", "docker cp", "docker rm", "docker run", "--protocol P", "trap 清理", "pull 逾時", "label"]
G1 = ".vendor_kit/gen/tools.just（不進 git）\nmod <ns> '../cache/<repo>/\njust/<ns>.just'\n一行一命名空間（零 set 零 recipe）"
G2 = "工具命名空間 just <repo> …\n跑 cache/<repo>/just/<ns>.just 的 recipe\n（cd \"{{justfile_directory()}}\" 回專案根）"
TMP = "暫存目錄 <tmp>（主機）\n工具 image 的 /dist 展開副本\n主機需 docker ≥ 19.03、sh、just ≥ 1.33"
hh = {"h0": hve(H0, C1W), "h1": hv(H1, C1W), "h2": max(hv(H2, C1W), hvt(G1, C2W, True)), "h3": max(hv(H3, C1W, pad=8), hvt(G2, C2W, True)),
      "h4": hvt(H4, C1W, True, pad=8) + units_h(H4U, C1W - 12) + 6}
hy = {}; y0 = 50
for k in ("h0", "h1", "h2", "h3", "h4"):
    hy[k] = y0; y0 += hh[k] + 30
VK_T = (".vendor_kit/            # 契約② p2，根目錄只多這個\n"
 "├─ version.toml        # 進 git：唯一來源\n"
 "├─ version.local.toml  # 不進 git：dev 覆寫\n"
 "├─ .gitignore          # 進 git：我們自己的\n"
 "├─ entry.just          # 進 git：mod + import?\n"
 "├─ vendor.just         # 進 git：動詞 + sync\n"
 "├─ ci/check.sh         # 進 git：CI 五步\n"
 "├─ baseline/<repo>/    # 進 git：範本 + metadata\n"
 "├─ gen/                # 不進 git：tools.just、.stamp、\n"
 "│                      #   <repo>.stamp（印記）\n"
 "├─ .tmp.*              # 不進 git：remove／uninstall 日誌\n"
 "└─ cache/<repo>/       # 不進 git：工具檔展開")
