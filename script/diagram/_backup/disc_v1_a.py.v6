p4 += vt("h4", "p4H", HOST + "align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;", H4, C1X, hy["h4"], C1W, hh["h4"], tagged=True)
p4 += units("h4", "p4H", C1X + 6, hy["h4"] + hvt(H4, C1W, True, pad=8) - 2, C1W - 12, H4U)
