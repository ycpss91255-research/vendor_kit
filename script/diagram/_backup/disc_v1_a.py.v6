    h = max(mh, fh); R[pid] = (ey, h); ey += h + 26
eng_end = ey
pf = []; p4_files = []; P = {}
for pid_mod, lst in FILES.items():
    y = R[pid_mod][0]
    for fid, kind, st, title, it in lst:
        if kind == "grp":
