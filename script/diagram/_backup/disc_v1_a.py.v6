LY = GY + GH + 50
# ---- 引擎模組（先算高度）----
EX, EW = 650, 620
MX, MW = 300, 300
MOD = refill(L12, RED) + "align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;"
mods = [
 ("m_reg", "<b>registry</b>：查 GHCR", ["查 tag", "查 index digest", "token", "逾時"], True),
 ("m_ver", "<b>version</b>：version.toml／local 讀寫", ["讀 toml", "寫 toml", "schema 轉換", "flock", "指紋", "進度日誌", "label"], True),
 ("m_mat", "<b>materialize</b>：/dist → cache/<repo>/", ["展開 /dist", "路徑驗證", "印記", "verify sha256"], True),
 ("m_bl", "<b>baseline</b>：baseline/<repo>/ + metadata", ["範本副本", "metadata", "初始檔狀態", "declined"], True),
 ("im", None, None, None),
 ("m_lg", "<b>launcher-gen</b>：薄殼、gen/、根 justfile 一行", ["薄殼四檔", "自描述首行", "tools.just", "check.sh", ".stamp"], True),
]
IM = [("m_mg", 306, 136, "<b>merge</b>：逐檔合併", ["狀態機", "merge-file"]), ("m_init", 458, 136, "<b>init</b>：初始檔", ["建檔", "append", "新檔詢問"])]
def mod_h(labels, w): return 30 + units_h(labels, w - 12) + 8
# 檔案框（專案目錄欄）每列的高度先算好，模組列高 = max(模組, 檔案)，兩邊同一列頂對齊
