def fy(yrel): return round((yrel - CLI_Y) / CLI_H, 4)
mid = lambda k: R[k][0] + R[k][1] / 2
p4.append(e("d_reg", "m_reg", "m_cli", "tag, index digest", (0, 0.5), (1, fy(mid("m_reg"))), both=True))
p4.append(e("d_ver", "m_cli", "m_ver", "version.toml 內容\n指紋", (1, fy(mid("m_ver"))), (0, 0.5), both=True))
p4.append(e("d_mat", "m_cli", "m_mat", "/dist 路徑、<repo>", (1, fy(mid("m_mat"))), (0, 0.5)))
p4.append(e("d_bl", "m_bl", "m_cli", "metadata", (0, 0.5), (1, fy(mid("m_bl"))), both=True))
p4.append(e("d_im", "m_cli", "grp_im", "要處理的檔清單\n逐檔決定", (1, fy(mid("im"))), (0, 0.5), both=True))
p4.append(e("d_lg", "m_cli", "m_lg", "引擎 ref、動詞清單", (1, fy(mid("m_lg"))), (0, 0.5)))
p4.append(e("d_mat_bl", "m_mat", "m_bl", "cache 路徑、印記", (0.5, 1), (0.5, 0), vert=True))
p4.append(e("d_im_bl", "grp_im", "m_bl", "檔案清單、逐檔決定", (0.5, 0), (0.5, 1), vert=True))
# ---- 專案目錄 ----
p4.append(v("p4P", "1", SW(GREEN), "專案目錄（掛載為 /repo）", PX, LY, PW, LH))
p4.append(v("f_note", "p4P", NOTE, FN_T, 15, 50, 240, fnh))
p4 += p4_files
def fmid(pid):
    for q, y, h in pf:
        if q == pid: return y + h / 2
def rel(pid_mod, yabs): return (1, round((yabs - R[pid_mod][0]) / R[pid_mod][1], 4))
p4.append(e("w_ver", "m_ver", "f_ver", "version.toml 內容", rel("m_ver", fmid("f_ver")), (0, 0.5), both=True))
p4.append(e("w_vl", "m_ver", "f_vl", "覆寫行（path:／\ntag + image ID）", rel("m_ver", fmid("f_vl")), (0, 0.5), both=True))
p4.append(e("w_repo", "m_mat", "f_repo", "展開的工具檔（整批替換）", rel("m_mat", fmid("f_repo")), (0, 0.5)))
p4.append(e("w_stamp", "m_mat", "f_stamp", "index digest + 每檔 sha256", rel("m_mat", fmid("f_stamp")), (0, 0.5), both=True))
p4.append(e("w_bl", "m_bl", "f_bl", "範本副本、metadata", rel("m_bl", fmid("f_bl")), (0, 0.5), both=True))
gy_ = R["im"][0] + R["im"][1] / 2
p4.append(e("w_user", "grp_im", "f_user", "檔案內容（現況 → 判斷；\n建／append／合併結果 → 寫）", (1, 0.5), (0, round((gy_ - P["f_user"]) / next(h for q, y, h in pf if q == "f_user"), 4)), both=True))
p4.append(e("w_just", "m_lg", "f_just", "import 那一行", rel("m_lg", fmid("f_just")), (0, 0.5), both=True))
p4.append(e("w_shell", "m_lg", "f_shell", "薄殼四檔（首行 hash → 比對；\n模板 → 重產）", rel("m_lg", fmid("f_shell")), (0, 0.5), both=True))
p4.append(e("w_gen", "m_lg", "f_gen", "tools.just、.stamp 內容", rel("m_lg", fmid("f_gen")), (0, 0.5)))
# ---- 跨區的線 ----
h4c = hy["h4"] + hh["h4"] / 2
p4.append(e("run_cli", "h4", "m_cli", "動詞、參數、--protocol P →\n← 結束狀態、stdout 清單", (1, 0.5), (0, fy(h4c)), pos=-0.5, both=True))
p4.append(e("mount_dist", "tmp", "p4E", "/dist/<repo>\n（唯讀）", (1, 0.5), (0, round((50 + tmph / 2) / LH, 4)), pos=-0.5))
p4.append(e("pull_eng", "g_eng", "p4H", "引擎 image\n（覆寫時改用本機 image）", (0.5, 1), (round((40 + 20 + 220 - HXo) / HW, 4), 0), vert=True))
gx = 590
p4.append(e("pull_dist", "g_dist", "p4H", "工具 image 的 /dist 層\n→ <tmp>", (round((gx - (40 + 480)) / 620, 4), 1), (round((gx - HXo) / HW, 4), 0), vert=True))
qx = EX + MX + MW / 2
p4.append(e("q_reg", "p4E", "g_dist", "tag、index digest", (round((qx - EX) / EW, 4), 0), (round((qx - (40 + 480)) / 620, 4), 1), vert=True, both=True))
Y = LY + LH + 30
p4 += lgd("p4", 40, Y, ["v4eng", "v4mod", "v4unit", "v4host", "v4hgrp", "v4pgrp", "ruleb"], "實線 = 資料流（線上文字 = 傳什麼）\n雙箭頭 = 讀寫／來回都有\n載入／執行順序與判斷見流程頁")
p4 += lgd("p4b", 40, Y + 60, ["v2git", "v2no", "v2usr", "v2code", "v2tag", "v4frame", "v4other", "notep"], "黃橢圓 = 使用者（外部）\n檔案框：標題容器內一格一檔")
p4 += terms("p4", 40, Y + 160, [
 ("引擎", "vendor_kit 的程式本體：只以 image 存在（公開、多架構）、只在容器內跑；8 個模組見紫色容器；一個專案用 version.toml 第一行那一版（version.local.toml 可覆寫成本機 image）"),
 ("啟動器", ".vendor_kit/ 裡的 POSIX sh 薄殼，在主機跑：grep version.toml、docker pull／create／cp 抓工具檔、docker run 起引擎 resolve／apply；不算引擎模組；最小單元見紅粗框"),
 ("模組／最小單元", "模組 = 引擎裡一塊獨立責任的程式（紅框）；最小單元 = 模組裡可以單獨測的最小功能（白小框，一格一個）"),
 ("cli", "引擎的入口模組：解析子命令與參數（含 --protocol P）、負責所有詢問（-y 免問；無 tty → 1）、決定結束狀態 0／1／2／3，並呼叫其他模組"),
 ("version", "讀寫 version.toml／version.local.toml（schema 轉換）；apply 拿 flock；產生／重驗輸入指紋；寫 metadata 進度日誌；算 docker 資源 label（prune 用）"),
 ("registry", "查 GHCR 的 tag 與 index digest（update／add／upgrade 用；私有 registry 用 VENDOR_KIT_REGISTRY_TOKEN；查詢有逾時）；sync 不查最新版，只拉鎖定版（cache 缺／鎖定 digest 變／verify 失敗才拉）"),
 ("VENDOR_KIT_\nREGISTRY_TOKEN", "環境變數：私有 registry 查最新 tag 時給引擎用的登入權杖（容器內沒有主機的 docker 登入）；不給就改用 -t 指定版本"),
 ("materialize", "把主機掛進來的 /dist/<repo> 展開到 cache/<repo>/（先驗路徑：不越出、無 symlink）、寫印記 gen/<repo>.stamp（index digest + 每檔 sha256）、verify sha256"),
 ("印記 gen/<repo>.stamp", "每工具一個小檔：第一行 = 裝的是哪個 index digest（或 path:／image:）、之後每檔 sha256；不放在 cache/<repo>/ 裡（dev 時那是唯讀 symlink）"),
 ("symlink", "指向另一個路徑的捷徑檔；dev 時 cache/<repo>/ 是指向 <dir>/dist 的唯讀 symlink；工具 dist/files/ 裡第一版禁止，materialize 展開時驗"),
 ("init／merge", "init 建初始檔、append 幾行或問「要建新檔 X 嗎」；merge 在 upgrade 時對每個檔跑狀態機（沒改→換、都改→三方合併）+ git merge-file；兩者都把檔案清單與逐檔決定交給 baseline"),
 ("baseline", "維護 baseline/<repo>/ 範本副本與 .vendor_kit.toml metadata（完成標記、初始檔四種狀態、declined、append 行、衝突中檔案、進度日誌）"),
 ("launcher-gen", "產生 .vendor_kit/ 自有薄殼四檔（含自描述首行）、gen/tools.just、gen/.stamp、根 justfile 那一行；薄殼與 gen/.stamp 只由 install／upgrade vendor_kit 呼叫重產，重產前比對薄殼首行 hash + image 內模板（被改過 → 1 列差異不動）；根 justfile 只問後加一行；tools.just 由 sync／add／remove／upgrade 重生"),
 ("flock", "Linux 檔案鎖：version 模組在 apply 開始時對專案目錄上鎖，避免兩個 just 同時寫"),
 ("sha256／index digest", "sha256 = 內容指紋；index digest = 多架構 image（amd64 + arm64 manifest list）的 sha256；印記與 version.toml 記它"),
 ("buildx", "docker 的多架構建置工具：同一次 build 產 amd64 + arm64，合成一個多架構 index"),
 ("GHCR／image", "GHCR = GitHub 的 image 倉庫；image = docker 打包檔：工具 image 是純資料包（FROM scratch 只 COPY），引擎 image 是會跑的程式；本頁紫色 = 兩種 image 都算"),
 ("recipe", "justfile 裡一條指令（名字 + 要跑的命令）；vendor.just 每個動詞一條、一行轉發給啟動器"),
 ("命名空間", "just <ns> <recipe> 前面的 <ns>；每個工具的 just/<ns>.just 一檔一個，gen/tools.just 一行掛一個；與根 justfile 既有 recipe 撞名 → add 拒絕"),
 ("暫存目錄 <tmp>", "啟動器把工具 image 的 /dist 抓到主機的暫存資料夾，再唯讀掛進引擎當 /dist/<repo>（逐檔判斷讀這裡，不是 cache）；dev 時改掛 <dir>/dist；trap 清掉"),
 ("掛載", "docker run -v：把主機目錄接進容器；/repo = 專案目錄（可寫），/dist = 工具檔（唯讀）"),
 ("resolve／apply", "同一個引擎 image 的兩個編排用子命令：resolve 只讀、算清單與指紋；apply 拿鎖、重驗指紋、建進度日誌、寫檔；流程見 p3 契約④"),
 ("<repo>", "工具 repo 名；.vendor_kit/cache/<repo>/ = 專案裡展開的工具檔"),
 ("schema", "每個 vendor_kit 寫的 TOML 的格式版本（schema = N + 寫入者版本）；version 模組讀任一舊 schema 在記憶體轉換，只在本來要寫時寫回"),
] + T_COMMON)
pages_v1_a.append(("v1p4", "架構圖 v2：主機、引擎模組、registry", p4))
