{
  "_說明": "PR「一個邏輯目的」的範圍表（#140）。本機 hook（.claude/hooks/pr_rules_guard.py）與之後的 CI 共用這一份，規則只寫在這裡。rules 由上往下比，第一條 pattern（Python re，對 repo 相對路徑做 search）符合的就是這個檔的範圍；scope 裡的 {名稱} 換成 pattern 的同名群組。attach 標示附屬檔：same＝只在同一個範圍已經有主檔時才算附屬（例如測試），沒有就自己算一個範圍；any＝附在這個 PR 的任何主檔上（例如 README 段、docs.yml 步驟、AGENTS 一句），整個 PR 只有附屬檔時才自己算一個範圍。groups 把同一個邏輯目的、分散在兩處的範圍併成一個（例如 hook 跟它呼叫的 script 類別）。表上沒列到的檔一律算違規，要先補表。",
  "rules": [
    {"pattern": "^\\.claude/hooks/test/test_(?P<name>[A-Za-z0-9_]+)\\.py$", "scope": "hook:{name}", "attach": "same"},
    {"pattern": "^\\.claude/hooks/test_guard\\.py$", "scope": "hook:guard", "attach": "same"},
    {"pattern": "^\\.claude/hooks/(?P<name>[A-Za-z0-9_]+)\\.py$", "scope": "hook:{name}"},
    {"pattern": "^\\.claude/settings\\.json$", "scope": "claude:settings"},
    {"pattern": "^\\.claude/workflows/README\\.md$", "scope": "workflow:README", "attach": "any"},
    {"pattern": "^\\.claude/workflows/(?P<name>[^/]+)\\.js$", "scope": "workflow:{name}"},
    {"pattern": "^\\.claude/skills$", "scope": "skill:link"},
    {"pattern": "^\\.agents/skills/(?P<name>[^/]+)/", "scope": "skill:{name}"},
    {"pattern": "^\\.codex/", "scope": "codex:config"},
    {"pattern": "^\\.github/workflows/docs\\.yml$", "scope": "ci:docs", "attach": "any"},
    {"pattern": "^\\.github/workflows/(?P<name>[^/]+)\\.ya?ml$", "scope": "ci:{name}"},
    {"pattern": "^\\.gitignore$", "scope": "repo:gitignore"},
    {"pattern": "^(AGENTS|CLAUDE)\\.md$", "scope": "agents", "attach": "any"},
    {"pattern": "^CONTEXT\\.md$", "scope": "context"},
    {"pattern": "^script/README\\.md$", "scope": "script", "attach": "any"},
    {"pattern": "^script/github/scope\\.json$", "scope": "script:github", "attach": "any"},
    {"pattern": "^script/(?P<cat>[^/]+)/test/", "scope": "script:{cat}", "attach": "same"},
    {"pattern": "^script/(?P<cat>[^/]+)/README\\.md$", "scope": "script:{cat}", "attach": "any"},
    {"pattern": "^script/(?P<cat>[^/]+)/", "scope": "script:{cat}"},
    {"pattern": "^doc/agents/(?P<name>[^/]+)\\.md$", "scope": "agents-doc:{name}"},
    {"pattern": "^doc/adr/(README|TEMPLATE)\\.md$", "scope": "adr:meta"},
    {"pattern": "^doc/adr/(?P<num>[0-9]{4})-[^/]+\\.md$", "scope": "adr:{num}"},
    {"pattern": "^doc/contract/(?P<page>[^/.]+)", "scope": "contract:{page}"},
    {"pattern": "^doc/decisions/review/(?P<page>[^/.]+)", "scope": "contract:{page}"},
    {"pattern": "^doc/decisions/README\\.md$", "scope": "decisions:README", "attach": "any"},
    {"pattern": "^doc/decisions/research/", "scope": "decisions:research"},
    {"pattern": "^doc/decisions/(?P<name>[^/]+)\\.md$", "scope": "decisions:{name}"},
    {"pattern": "^doc/diagram/(?P<name>[^/]+)\\.drawio$", "scope": "diagram:{name}"}
  ],
  "groups": [
    {"name": "hook:pr_rules_guard", "scopes": ["hook:pr_rules_guard", "script:github"], "_why": "hook 呼叫 script/github/check_pr_rules.py 與這份範圍表"},
    {"name": "hook:monitor_guard", "scopes": ["hook:monitor_guard", "script:github"], "_why": "hook 擋下 Monitor 時指向 script/github/watch_github.sh（#175）"},
    {"name": "claude:settings", "scopes": ["claude:settings", "hook:settings_hooks"], "_why": "test_settings_hooks 檢查的就是 settings.json 註冊的 hook"}
  ]
}
