<mxfile host="app.diagrams.net"><diagram id="c-components" name="元件與呼叫邊界"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="元件與呼叫邊界：誰在哪一側、誰呼叫誰、之間傳什麼（名詞見 GLOSSARY.md）" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="lh" value="主機（啟動器側）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="600" height="450" as="geometry" /></mxCell><mxCell id="h_just" value="just vendor_kit &amp;lt;recipe&amp;gt;&lt;br&gt;（根 justfile 的 import）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="50" width="160" height="60" as="geometry" /></mxCell><mxCell id="h_fwd" value="vendor.just／entry.just&lt;br&gt;一行轉發，不解讀參數" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="160" width="160" height="60" as="geometry" /></mxCell><mxCell id="h_ci" value="ci/check.sh&lt;br&gt;（CI 檢查腳本，設 CI=1）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="260" width="160" height="60" as="geometry" /></mxCell><mxCell id="h_boot" value="bootstrap.sh&lt;br&gt;（首次導入用的啟動器）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="360" width="160" height="60" as="geometry" /></mxCell><mxCell id="h_launch" value="啟動器（薄殼內 POSIX sh＋log.sh）&lt;br&gt;偵測環境・字串比對・驗計畫文法・照計畫呼叫 docker・清自己的容器與暫存" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="220" y="150" width="180" height="100" as="geometry" /></mxCell><mxCell id="h_note" value="不解讀 repo 內容的意義；不確定就起引擎" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="lh"><mxGeometry x="220" y="290" width="180" height="50" as="geometry" /></mxCell><mxCell id="h_docker" value="主機 docker daemon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="lh"><mxGeometry x="420" y="170" width="160" height="60" as="geometry" /></mxCell><mxCell id="le" value="引擎容器" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="50" width="260" height="450" as="geometry" /></mxCell><mxCell id="e_engine" value="引擎&lt;br&gt;解讀 repo 內容的規則只在這一份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="le"><mxGeometry x="50" y="60" width="160" height="60" as="geometry" /></mxCell><mxCell id="e_env" value="image 內寫死 LC_ALL=C.UTF-8、TZ=UTC" style="text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="le"><mxGeometry x="50" y="150" width="160" height="40" as="geometry" /></mxCell><mxCell id="e_tool" value="取件來的工具內容&lt;br&gt;（唯讀掛載）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="le"><mxGeometry x="50" y="230" width="160" height="60" as="geometry" /></mxCell><mxCell id="e_reg" value="log-events.txt 真本&lt;br&gt;薄殼模板" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="le"><mxGeometry x="50" y="340" width="160" height="60" as="geometry" /></mxCell><mxCell id="lr" value="registry／Release" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="50" width="220" height="450" as="geometry" /></mxCell><mxCell id="r_eng" value="引擎 image&lt;br&gt;LABEL：介面版區間、schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="lr"><mxGeometry x="30" y="60" width="160" height="60" as="geometry" /></mxCell><mxCell id="r_tool" value="工具 image&lt;br&gt;FROM scratch＋LABEL＋COPY dist/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="lr"><mxGeometry x="30" y="230" width="160" height="60" as="geometry" /></mxCell><mxCell id="r_rel" value="Release 資產&lt;br&gt;image tar＋.digest＋SHA256SUMS" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lr"><mxGeometry x="30" y="340" width="160" height="60" as="geometry" /></mxCell><mxCell id="lf" value="安裝目錄內的檔（擁有權見 02 第 1 條，這裡只標進不進 git）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="1160" height="260" as="geometry" /></mxCell><mxCell id="f_hg" value="進 git" style="text;html=1;align=left;fontStyle=1;" vertex="1" parent="lf"><mxGeometry x="20" y="40" width="160" height="20" as="geometry" /></mxCell><mxCell id="f_ver" value="version.toml&lt;br&gt;（版本鎖定行）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf"><mxGeometry x="20" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_shell" value="薄殼五檔&lt;br&gt;（帶自描述標頭）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf"><mxGeometry x="200" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_base" value="基準版＋metadata" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf"><mxGeometry x="380" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_cfg" value=".vendor_kit/config.toml" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf"><mxGeometry x="20" y="170" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_repo" value="repo 檔：根 justfile・根 .dockerignore・初始檔" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf"><mxGeometry x="200" y="170" width="340" height="60" as="geometry" /></mxCell><mxCell id="f_hn" value="不進 git（.vendor_kit/.gitignore 涵蓋）" style="text;html=1;align=left;fontStyle=1;" vertex="1" parent="lf"><mxGeometry x="600" y="40" width="340" height="20" as="geometry" /></mxCell><mxCell id="f_local" value="version.local.toml&lt;br&gt;（本機覆寫）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lf"><mxGeometry x="600" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_cache" value="cache/&amp;lt;repo&amp;gt;/&lt;br&gt;（工具內容＋印記）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lf"><mxGeometry x="780" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_gen" value="gen/&lt;br&gt;tools.just・.stamp" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lf"><mxGeometry x="960" y="70" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_log" value="log/&lt;br&gt;（執行紀錄 JSONL）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lf"><mxGeometry x="600" y="170" width="160" height="60" as="geometry" /></mxCell><mxCell id="f_tmp" value=".tmp.*&lt;br&gt;（進度檔、暫存）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lf"><mxGeometry x="780" y="170" width="160" height="60" as="geometry" /></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h_just" target="h_fwd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="*args" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h_fwd" target="h_launch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="CI=1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="h_ci" target="h_launch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="228" y="340" /><mxPoint x="228" y="280" /></Array></mxGeometry></mxCell><mxCell id="a4" value="尚無鎖定行：用內嵌引擎版呼叫 install" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="h_boot" target="h_docker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="440" /></Array></mxGeometry></mxCell><mxCell id="a5" value="照計畫呼叫" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="h_launch" target="h_docker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="拉 tag@digest" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="h_docker" target="r_eng"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="185" /><mxPoint x="1070" y="185" /></Array></mxGeometry></mxCell><mxCell id="a7" value="create＋cp（不 run）" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.75;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="h_docker" target="r_tool"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="365" /><mxPoint x="1070" y="365" /></Array></mxGeometry></mxCell><mxCell id="a8" value="起容器 --protocol P" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_docker" target="e_engine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="232" /><mxPoint x="650" y="140" /></Array></mxGeometry></mxCell><mxCell id="a9" value="唯讀掛進" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_docker" target="e_tool"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="256" /><mxPoint x="680" y="310" /></Array></mxGeometry></mxCell><mxCell id="a10" value="vk-resolve/&amp;lt;P&amp;gt; 執行計畫" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="e_engine" target="h_launch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="90" /><mxPoint x="330" y="90" /></Array></mxGeometry></mxCell><mxCell id="a11" value="grep 引擎行，命中須恰為 1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.9;entryX=1;entryY=0.5;" edge="1" parent="1" source="h_launch" target="f_ver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="212" y="290" /><mxPoint x="212" y="630" /></Array></mxGeometry></mxCell><mxCell id="a12" value="寫執行紀錄" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="h_launch" target="f_log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="290" /><mxPoint x="430" y="495" /><mxPoint x="590" y="495" /><mxPoint x="590" y="730" /></Array></mxGeometry></mxCell><mxCell id="a13" value="依 recipe 的寫入邊界寫檔" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0.8;entryY=0;" edge="1" parent="1" source="e_engine" target="lf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="140" /><mxPoint x="900" y="510" /><mxPoint x="948" y="510" /></Array></mxGeometry></mxCell><mxCell id="a14" value="離線 add --local 讀 .digest" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.375;entryY=1;" edge="1" parent="1" source="r_rel" target="h_docker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="480" /><mxPoint x="500" y="480" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="c-fetch" name="取件資料流"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="取件資料流：工具內容從 registry 到 cache/ 的路徑，三層指紋各擋在哪裡" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="lr" value="registry" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="200" height="730" as="geometry" /></mxCell><mxCell id="lh" value="主機（啟動器呼叫 docker）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="50" width="340" height="730" as="geometry" /></mxCell><mxCell id="le" value="引擎容器" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="340" height="730" as="geometry" /></mxCell><mxCell id="lc" value="安裝目錄（不進 git）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="50" width="220" height="730" as="geometry" /></mxCell><mxCell id="r1" value="工具 image&lt;br&gt;名稱:tag@sha256:digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" ve