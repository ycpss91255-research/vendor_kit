"la"><mxGeometry x="260" y="120" width="220" height="70" as="geometry" /></mxCell><mxCell id="dg" value="在某個 git repo 內？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="230" width="190" height="75" as="geometry" /></mxCell><mxCell id="xg" value="失敗：不替使用者建 repo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="la"><mxGeometry x="260" y="237" width="220" height="60" as="geometry" /></mxCell><mxCell id="dn" value="上層或下層已有安裝目錄？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="340" width="190" height="75" as="geometry" /></mxCell><mxCell id="xn" value="1：拒絕巢狀" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="la"><mxGeometry x="260" y="347" width="220" height="60" as="geometry" /></mxCell><mxCell id="dk" value="已有版本鎖定行？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="450" width="190" height="75" as="geometry" /></mxCell><mxCell id="ul" value="用鎖定行指定的引擎&lt;br&gt;（拿不到就失敗，不改用內嵌版）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="260" y="455" width="220" height="65" as="geometry" /></mxCell><mxCell id="ue" value="用啟動器內嵌的引擎版" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="580" width="190" height="60" as="geometry" /></mxCell><mxCell id="si" value="呼叫 install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="la"><mxGeometry x="290" y="580" width="160" height="60" as="geometry" /></mxCell><mxCell id="fs" value=".vendor_kit/ 薄殼五檔&lt;br&gt;（自描述標頭）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="60" width="200" height="60" as="geometry" /></mxCell><mxCell id="fv" value="version.toml 的引擎行" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="160" width="200" height="60" as="geometry" /></mxCell><mxCell id="dj" value="根 justfile 存在？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="260" width="200" height="80" as="geometry" /></mxCell><mxCell id="jc" value="詢問後 append 一行 import" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="300" y="270" width="190" height="60" as="geometry" /></mxCell><mxCell id="jn" value="建根 justfile：import＋default" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="380" width="200" height="60" as="geometry" /></mxCell><mxCell id="di" value="根 .dockerignore 加那四行（同一個 append 規則），紀錄進 baseline/.vendor_kit.toml" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="490" width="240" height="70" as="geometry" /></mxCell><mxCell id="ok" value="0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="lb"><mxGeometry x="330" y="495" width="120" height="60" as="geometry" /></mxCell><mxCell id="nn" value="問不到（非互動又沒 -y、CI 模式）的處置見 02 第 1 條；uninstall 的反向收回見「收回插入行」頁" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="lb"><mxGeometry x="40" y="620" width="460" height="70" as="geometry" /></mxCell><mxCell id="k1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="st" target="dh"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k2" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dh" target="xh"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dh" target="dg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k4" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dg" target="xg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dg" target="dn"><mxGe