get="x2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b9" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="c1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="640" /><mxPoint x="960" y="640" /><mxPoint x="960" y="575" /></Array></mxGeometry></mxCell><mxCell id="b10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="c2" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c-launch" name="啟動時序"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="啟動時序：一次 just vendor_kit &amp;lt;recipe&amp;gt; 從啟動器到引擎，每個關卡停在哪裡" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="lh" value="啟動器（主機）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="700" height="740" as="geometry" /></mxCell><mxCell id="le" value="引擎容器" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="440" height="740" as="geometry" /></mxCell><mxCell id="a1" value="偵測主機環境&lt;br&gt;docker／just 版本、是否 podman" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="40" width="160" height="60" as="geometry" /></mxCell><mxCell id="a2" value="符合下限？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="130" width="160" height="70" as="geometry" /></mxCell><mxCell id="a3" value="在安裝目錄執行？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="230" width="160" height="70" as="geometry" /></mxCell><mxCell id="a4" value="執行紀錄建得出？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="330" width="160" height="70" as="geometry" /></mxCell><mxCell id="a5" value="grep 引擎行&lt;br&gt;命中恰為 1？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="430" width="160" height="70" as="geometry" /></mxCell><mxCell id="a6" value="有本機覆寫就改用&lt;br&gt;本機 image" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="20" y="530" width="160" height="60" as="geometry" /></mxCell><mxCell id="a7" value="引擎 image LABEL&lt;br&gt;介面版區間含 P？&lt;br&gt;（不起容器、不上網）" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="10" y="620" width="180" height="100" as="geometry" /></mxCell><mxCell id="f2" value="1：印下載／安裝指令，零寫入" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="220" y="140" width="150" height="50" as="geometry" /></mxCell><mxCell id="f3" value="1：印該切到哪個安裝目錄" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="220" y="240" width="150" height="50" as="geometry" /></mxCell><mxCell id="f4" value="1：不動任何檔" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="220" y="340" width="150" height="50" as="geometry" /></mxCell><mxCell id="f5" value="停下：不是 VK 寫出的形狀，不猜版本" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="220" y="440" width="150" height="50" as="geometry" /></mxCell><mxCell id="b1" value="這個 recipe 屬救援路徑？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="410" y="40" width="170" height="80" as="geometry" /></mxCell><mxCell id="g1" value="3＋6-36&lt;br&gt;零寫入" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="lh"><mxGeometry x="600" y="50" width="90" height="60" as="geometry" /></mxCell><mxCell id="b2" value="引擎 image&lt;br&gt;拿得到？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="410" y="150" width="170" height="80" as="geometry" /></mxCell><mxCell id="g2" value="1：不改用內嵌版" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="600" y="160" width="90" height="60" as="geometry" /></mxCell><mxCell id="b3" value="起引擎容器 --protocol P&lt;br&gt;（路徑一律加引號）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="415" y="260" width="160" height="60" as="geometry" /></mxCell><mxCell id="b4" value="執行計畫文法正確？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="410" y="460" width="170" height="80" as="geometry" /></mxCell><mxCell id="g4" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lh"><mxGeometry x="600" y="570" width="90" height="60" as="geometry" /></mxCell><mxCell id="b5" value="照計畫呼叫 docker&lt;br&gt;清自己的容器與暫存" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lh"><mxGeometry x="415" y="570" width="160" height="60" as="geometry" /></mxCell><mxCell id="b6" value="回結束碼&lt;br&gt;（定義見 02 第 4 條）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="lh"><mxGeometry x="425" y="660" width="140" height="60" as="geometry" /></mxCell><mxCell id="e1" value="寫引擎開始事件&lt;br&gt;讀 repo 內容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="le"><mxGeometry x="40" y="260" width="160" height="60" as="geometry" /></mxCell><mxCell id="e2" value="檔案版高於本引擎？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="le"><mxGeometry x="40" y="350" width="160" height="80" as="geometry" /></mxCell><mxCell id="h2" value="3＋6-19&lt;br&gt;零寫入" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="le"><mxGeometry x="240" y="360" width="120" height="60" as="geometry" /></mxCell><mxCell id="e3" value="套 recipe 規則（見各流程頁）&lt;br&gt;回 vk-resolve/&amp;lt;P&amp;gt; 計畫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="le"><mxGeometry x="40" y="470" width="160" height="60" as="geometry" /></mxCell><mxCell id="en" value="計畫裡的自由文字八進位跳脫；啟動器不替它補引號" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="le"><mxGeometry x="240" y="470" width="160" height="60" as="geometry" /></mxCell><mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c2" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c4" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a3" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c6" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a4" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c7" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c8" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a5" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c9" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a7" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="720" /><mxPoint x="405" y="130" /></Array></mxGeometry></mxCell><mxCell id="c12" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="a7" target="b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="782" /><mxPoint x="417" y="782" /><mxPoint x="417" y="240" /></Array></mxGeometry></mxCell><mxCell id="c13" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b1" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b2" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c16" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b3" target="e1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="e1" target="e2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="e2" target="h2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c20" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="e2" target="e3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="e3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b4" target="g4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="665" y="550" /></Array></mxGeometry></mxCell><mxCell id="c23" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c-writing" name="可寫 recipe 的寫入時序"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="可寫 recipe 的寫入時序：每一步寫哪個檔、在這一步回 1 會留下什麼" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="r1" value="引擎步驟" style="swimlane;horizontal=0;startSize=40;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1160" height="230" as="geometry" /></mxCell><mxCell id="r2" value="這步寫的檔" style="swimlane;horizontal=0;startSize=40;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1160" height="170" as="geometry" /></mxCell><mxCell id="r3" value="在這步回 1 時留下的狀態" style="swimlane;horizontal=0;startSize=40;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1160" height="300" as="geometry" /></mxCell><mxCell id="s0" value="前置檢查&lt;br&gt;（不寫檔、不拉 image、不起容器）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="50" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="s1" value="1. 建執行紀錄" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="235" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="s2" value="2. 建進度檔&lt;br&gt;（--dry-run 不建，只預覽）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="420" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="s3" value="3. 不帶工具名時&lt;br&gt;對全部工具完整預檢" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="605" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="s4" value="4. 寫入" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="790" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="s5" value="5. 最後才改版本鎖定行&lt;br&gt;（remove 則最後才刪）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="r1"><mxGeometry x="975" y="30" width="145" height="80" as="geometry" /></mxCell><mxCell id="n2" value="開始前發現未完成的進度檔：可寫 recipe 先恢復再繼續；唯讀 recipe 只偵測" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="r1"><mxGeometry x="420" y="130" width="145" height="85" as="geometry" /></mxCell><mxCell id="n3" value="CI 模式下需要改進 git 的檔 → 1 並印清單，與 -y 無關" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="r1"><mxGeometry x="605" y="130" width="145" height="85" as="geometry" /></mxCell><mxCell id="n5" value="明列例外：升引擎先改鎖定行，見「升引擎兩段式」頁" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="r1"><mxGeometry x="975" y="130" width="145" height="85" as="geometry" /></mxCell><mxCell id="w0" value="不寫任何檔" style="text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="r2"><mxGeometry x="50" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="w1" value="log/&lt;br&gt;（執行紀錄）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="r2"><mxGeometry x="235" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="w2" value=".tmp.&amp;lt;recipe&amp;gt;.&amp;lt;id&amp;gt;.toml&lt;br&gt;metadata 的 [progress]" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="r2"><mxGeometry x="420" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="w3" value="不寫內容檔" style="text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="r2"><mxGeometry x="605" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="w4" value="repo 檔、基準版、metadata、薄殼；cache/＋gen/tools.just 同一個 apply 原子替換" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="r2"><mxGeometry x="790" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="w5" value="version.toml&lt;br&gt;（進 git）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="r2"><mxGeometry x="975" y="40" width="145" height="90" as="geometry" /></mxCell><mxCell id="x0" value="1：什麼都沒寫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="r3"><mxGeometry x="50" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="x1" value="建不出執行紀錄：1，不動任何檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="r3"><mxGeometry x="235" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="x2" value="1：只有執行紀錄＋進度檔，內容檔未動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="r3"><mxGeometry x="420" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="x3" value="任一項不過：1，整體不動，列出每一個不過的原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="r3"><mxGeometry x="605" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="x4" value="1：做完的留著，進度檔記著沒做完的；鎖定行不動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="r3"><mxGeometry x="790" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="ok" value="完成：0，或 2（有合併衝突待解）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="r3"><mxGeometry x="975" y="40" width="145" height="100" as="geometry" /></mxCell><mxCell id="nx" value="後續檢查（sync、CI 檢查腳本、下一個可寫 recipe）看到進度檔就知道沒完成，並印出下一步" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="r3"><mxGeometry x="420" y="180" width="515" height="70" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="全過" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c-merge" name="初始檔升版分支"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="初始檔升版分支：upgrade 對單一個初始檔的逐檔判斷（輸入：基準版、目前 repo 檔、新版初始檔）" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="la" value="引擎判斷" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="600" height="740" as="geometry" /></mxCell><mxCell id="lb" value="寫入與結果" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="540" height="740" as="geometry" /></mxCell><mxCell id="d0" value="新版還提供這個檔？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="40" width="170" height="80" as="geometry" /></mxCell><mxCell id="d1" value="已納管？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxG