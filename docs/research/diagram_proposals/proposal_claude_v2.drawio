height="740" as="geometry" /></mxCell><mxCell id="l2" value="引擎判斷" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="320" y="50" width="480" height="740" as="geometry" /></mxCell><mxCell id="l3" value="結果" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="360" height="740" as="geometry" /></mxCell><mxCell id="r1" value="工具 metadata 的 [[file]].lines&lt;br&gt;（append 型初始檔）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="20" y="60" width="240" height="70" as="geometry" /></mxCell><mxCell id="r2" value="baseline/.vendor_kit.toml&lt;br&gt;（根 .dockerignore 那四行，uninstall）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="20" y="170" width="240" height="70" as="geometry" /></mxCell><mxCell id="r3" value="根 justfile 那行 import&lt;br&gt;（uninstall）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="20" y="280" width="240" height="70" as="geometry" /></mxCell><mxCell id="st" value="remove &amp;lt;repo&amp;gt;／uninstall" style="ellipse;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="l2"><mxGeometry x="40" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="dr" value="紀錄在、且還原得出誰寫了哪些行？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="40" y="130" width="170" height="90" as="geometry" /></mxCell><mxCell id="cn" value="拿一行原文在整份檔數命中&lt;br&gt;（CRLF 與 LF 等價）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="l2"><mxGeometry x="40" y="260" width="170" height="60" as="geometry" /></mxCell><mxCell id="dh" value="命中幾處？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="40" y="360" width="170" height="90" as="geometry" /></mxCell><mxCell id="del" value="刪這一行" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="280" y="375" width="160" height="60" as="geometry" /></mxCell><mxCell id="wn" value="不刪；warn 檔名與找到幾處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="l2"><mxGeometry x="280" y="480" width="160" height="60" as="geometry" /></mxCell><mxCell id="nx" value="還有下一行／下一個檔？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="40" y="580" width="170" height="90" as="geometry" /></mxCell><mxCell id="xr" value="1：停下並報告，不拿推測當紀錄，什麼都不動" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="l3"><mxGeometry x="40" y="135" width="220" height="80" as="geometry" /></mxCell><mxCell id="nt" value="一行對不上不會讓整批放棄：找得到的照樣收回" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="l3"><mxGeometry x="40" y="430" width="220" height="70" as="geometry" /></mxCell><mxCell id="kp" value="檔本身永不刪（含整份建出的初始檔）：印清單" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l3"><mxGeometry x="40" y="560" width="220" height="60" as="geometry" /></mxCell><mxCell id="lk" value="最後才刪版本鎖定行（remove）" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="l3"><mxGeometry x="40" y="660" width="180" height="60" as="geometry" /></mxCell><mxCell id="ok" value="0（含 warn）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="l3"><mxGeometry x="250" y="665" width="100" height="50" as="geometry" /></mxCell><mxCell id="m1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="st" target="dr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m2" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dr" target="xr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dr" target="cn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r1" target="cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="145" /><mxPoint x="310" y="340" /></Array></mxGeometry></mxCell><mxCell id="m5" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r2" target="cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="255" /><mxPoint x="310" y="340" /></Array></mxGeometry></mxCell><mxCell id="m6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r3" target="cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="365" /><mxPoint x="310" y="340" /></Array></mxGeometry></mxCell><mxCell id="m7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cn" target="dh"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m8" value="恰好 1 處" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dh" target="del"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m9" value="0 處或 2 處以上" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="dh" target="wn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="560" /></Array></mxGeometry></mxCell><mxCell id="m10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="del" target="nx"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="405" /><mxPoint x="780" y="675" /></Array></mxGeometry></mxCell><mxCell id="m11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="wn" target="nx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m12" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nx" target="cn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="675" /><mxPoint x="340" y="340" /></Array></mxGeometry></mxCell><mxCell id="m13" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="nx" target="kp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="782" /><mxPoint x="1176" y="782" /><mxPoint x="1176" y="640" /></Array></mxGeometry></mxCell><mxCell id="m14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="kp" target="lk"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m15" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="lk" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c-engine-upgrade" name="升引擎兩段式"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="升引擎兩段式：第一段換引擎就停，第二段由新引擎做事（ADR-0007 §5）" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="l1" value="第 1 次 upgrade vendor_kit（舊引擎）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="560" height="740" as="geometry" /></mxCell><mxCell id="l2" value="第 2 次 upgrade vendor_kit（新引擎）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="580" height="740" as="geometry" /></mxCell><mxCell id="s1" value="upgrade vendor_kit[@&amp;lt;tag&amp;gt;]" style="ellipse;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="l1"><mxGeometry x="40" y="40" width="190" height="50" as="geometry" /></mxCell><mxCell id="dd" value="是降版？&lt;br&gt;（以介面版與檔案版比）" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="40" y="120" width="190" height="80" as="geometry" /></mxCell><mxCell id="dl" value="目標引擎能無損讀現有檔？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="40" y="240" width="190" height="90" as="geometry" /></mxCell><mxCell id="x3" value="3＋6-10&lt;br&gt;改檔前拒絕、零寫入" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="l1"><mxGeometry x="270" y="250" width="170" height="70" as="geometry" /></mxCell><mxCell id="sp" value="建進度檔，記目標版本" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="40" y="370" width="190" height="60" as="geometry" /></mxCell><mxCell id="sl" value="改 version.toml 的引擎行&lt;br&gt;（明列例外：鎖定行先改）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="40" y="470" width="190" height="60" as="geometry" /></mxCell><mxCell id="sx" value="新引擎換上就停下&lt;br&gt;（剩下的不由舊規則做）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l1"><mxGeometry x="40" y="570" width="190" height="60" as="geometry" /></mxCell><mxCell id="x1" value="1：要求重跑 upgrade vendor_kit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="l1"><mxGeometry x="270" y="570" width="190" height="60" as="geometry" /></mxCell><mxCell id="s2" value="重跑 upgrade vendor_kit&lt;br&gt;啟動器照新的引擎行起新引擎" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="40" y="40" width="220" height="60" as="geometry" /></mxCell><mxCell id="sd" value="讀到未完成的進度檔，照目標版本續作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="l2"><mxGeometry x="40" y="140" width="220" height="60" as="geometry" /></mxCell><mxCell id="ss" value="重產薄殼（新的自描述標頭）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="l2"><mxGeometry x="40" y="240" width="220" height="60" as="geometry" /></mxCell><mxCell id="sr" value="其餘步驟照新引擎的規則&lt;br&gt;（檔案版直接遷移、不鏈式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="l2"><mxGeometry x="40" y="340" width="220" height="70" as="geometry" /></mxCell><mxCell id="df" value="中途失敗？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="l2"><mxGeometry x="50" y="450" width="200" height="80" as="geometry" /></mxCell><mxCell id="xf" value="1：鎖定行已是新版，進度檔還記著目標版本；重跑續作" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="l2"><mxGeometry x="300" y="445" width="240" height="90" as="geometry" /></mxCell><mxCell id="ok" value="0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="l2"><mxGeometry x="90" y="570" width="120" height="50" as="geometry" /></mxCell><mxCell id="dv" value="相關限制：dev vendor_kit -i 指到比薄殼舊的引擎時可以跑，但不准用它重產進 git 的薄殼" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="l2"><mxGeometry x="40" y="650" width="500" height="60" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s1" target="dd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dd" target="dl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dd" target="sp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="210" /><mxPoint x="490" y="450" /></Array></mxGeometry></mxCell><mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dl" target="x3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="dl" target="sp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sp" target="sl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sl" target="sx"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sx" target="x1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="使用者重跑" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="x1" target="s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="650" /><mxPoint x="590" y="120" /></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="s2" target="sd"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sd" target="ss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ss" target="sr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="sr" target="df"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="df" target="xf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="df" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="c-sync" name="sync 判定"><mxGraphModel><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="sync 判定：每次 just 自動跑的前置遇到什麼狀態、回什麼、寫什麼" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1160" height="30" as="geometry" /></mxCell><mxCell id="la" value="判定（快路徑在啟動器，其餘在引擎）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="600" height="740" as="geometry" /></mxCell><mxCell id="lb" value="後續與寫入（只寫 .vendor_kit/.gitignore 涵蓋的路徑）" style="swimlane;startSize=30;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="50" width="540" height="740" as="geometry" /></mxCell><mxCell id="st" value="just 的前置 sync（或手打 sync）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="la"><mxGeometry x="20" y="40" width="190" height="50" as="geometry" /></mxCell><mxCell id="d1" value="快路徑：gen/.stamp 與鎖定行字串相等？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="110" width="190" height="75" as="geometry" /></mxCell><mxCell id="d2" value="CI 模式且有本機覆寫？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="215" width="190" height="75" as="geometry" /></mxCell><mxCell id="d3" value="薄殼標頭重算、與模板都相符？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="320" width="190" height="75" as="geometry" /></mxCell><mxCell id="d4" value="未完成導入？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="425" width="190" height="75" as="geometry" /></mxCell><mxCell id="d5" value="基準版落後鎖定行？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="530" width="190" height="75" as="geometry" /></mxCell><mxCell id="d6" value="cache/ 逐檔指紋驗得過？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="la"><mxGeometry x="20" y="635" width="190" height="75" as="geometry" /></mxCell><mxCell id="o1" value="0：不起引擎" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="la"><mxGeometry x="260" y="117" width="170" height="60" as="geometry" /></mxCell><mxCell id="o2" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="la"><mxGeometry x="260" y="222" width="170" height="60" as="geometry" /></mxCell><mxCell id="o3" value="1：列差異，提示 upgrade vendor_kit；不重產薄殼" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="la"><mxGeometry x="260" y="320" width="220" height="75" as="geometry" /></mxCell><mxCell id="o4" value="1＋6-13：提示 add（不分本機或 CI）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="la"><mxGeometry x="260" y="425" width="220" height="75" as="geometry" /></mxCell><mxCell id="nt" value="判定之間的先後不在契約內，左欄的順序只為排版；快路徑不確定就起引擎" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="lb"><mxGeometry x="40" y="40" width="460" height="60" as="geometry" /></mxCell><mxCell id="np" value="發現未完成的進度檔：sync 是唯讀 recipe，只偵測並印下一步，不自動恢復" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF4C3;" vertex="1" parent="lb"><mxGeometry x="40" y="120" width="460" height="60" as="geometry" /></mxCell><mxCell id="cw" value="warn 提示 upgrade，繼續" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="lb"><mxGeometry x="40" y="420" width="170" height="60" as="geometry" /></mxCell><mxCell id="ci" value="CI 模式？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lb"><mxGeometry x="40" y="530" width="170" height="75" as="geometry" /></mxCell><mxCell id="ci1" value="1＋6-5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lb"><mxGeometry x="260" y="537" width="150" height="60" as="geometry" /></mxCell><mxCell id="rc" value="重裝 cache/ 並 warn；0" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="lb"><mxGeometry x="260" y="640" width="170" height="60" as="geometry" /></mxCell><mxCell id="ok" value="0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="la"><mxGeometry x="260" y="645" width="150" height="55" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="st" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" pa