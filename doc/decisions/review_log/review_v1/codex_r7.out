><mxCell id="p4_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="910" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lg4" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="710" y="910" width="88" height="40" as="geometry"/></mxCell><mxCell id="p4_lg5" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="818" y="910" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="968" y="900" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="200" height="20" as="geometry"/></mxCell><mxCell id="p4_tk0" value="暫存目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv0" value="先把整個 dist/ 寫到 .&amp;lt;name&amp;gt;.tmp/，最後一步才改名成 .&amp;lt;name&amp;gt;/；中途失敗舊目錄不受影響" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk1" value="src → dest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv1" value="init.toml 每一項：src 指 image 的 dist/ 裡哪個檔，dest 指要放到專案的哪裡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1040" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk2" value="原子替換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv2" value="先在暫存目錄準備好全部新檔，最後用一次改名換掉舊目錄；任何時刻看到的都是完整的舊版或完整的新版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1070" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk3" value="印記 / 指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv3" value="印記 = .&amp;lt;name&amp;gt;/.stamp（版本 + 每檔指紋）；指紋 = 由檔案內容算出的識別碼，內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk4" value="vendor_kit / image / dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv4" value="安裝工具本身／打包好可執行的檔案包／工具要出貨的檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1130" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk5" value="init.toml / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv5" value="init 要建立哪些檔的清單／專案裡的 justfile（使用者打 just 時執行的指令清單）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1160" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk6" value="容器 / &amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv6" value="容器 = image 執行起來的實例；&amp;lt;name&amp;gt; = .version 裡的工具名，安裝目錄就叫 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1190" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="6. 原型對照"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="原型對照：proto/ 三個資料夾 ↔ 框架裡的三種角色" style="text;html=1;fontSize=18;fontStyle=1;align=left;vertic