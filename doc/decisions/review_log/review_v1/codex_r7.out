mxCell><mxCell id="p1b_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1b_lg1" value="綠：使用框架的 repo" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="730" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1b_lg2" value="黃：外部（使用者、外部系統）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="730" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1b_lg3" value="紫：image / container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="720" y="740" width="180" height="40" as="geometry"/></mxCell><mxCell id="p1b_lg4" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="730" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1b_lg5" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1140" y="740" width="120" height="40" as="geometry"/></mxCell><mxCell id="p1b_lg6" value="灰：主機上既有的軟體" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1280" y="740" width="170" height="40" as="geometry"/></mxCell><mxCell id="p1b_lgt" value="實線 = 傳輸內容&lt;br&gt;虛線箭頭 = 基底 image → 以它為底的 image" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1470" y="730" width="300" height="60" as="geometry"/></mxCell><mxCell id="p1b_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1b_tk0" value="工具 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv0" value="任何想透過 vendor_kit 出貨的工具的原始碼 repo；必須有 dist/、init.toml、Dockerfile.dist、CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="840" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk1" value="專案 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv1" value="使用工具的專案；必須有 .version、justfile；可同時用多個工具" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="870" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk2" value="vendor_kit repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv2" value="我們要開發的：安裝工具的原始碼，打包成 vendor_kit image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="900" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk3" value="image / 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv3" value="image = 打包好的程式與檔案；容器 = image 執行起來的實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="930" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv4" value="GitHub 提供的 image 倉庫；每個工具一個 &amp;lt;name&amp;gt;-dist image，以 vendor_kit image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="960" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk5" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv5" value="專案裡的 TOML 檔，一個工具一行 name = &quot;image:tag@sha256:…&quot;；name 決定安裝目錄 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk6" value="CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv6" value="放在 GitHub 上的自動化流程：打 tag 時建置 image 並上傳 GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1020" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk7" value="建置 / 上傳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv7" value="建置 = 照 Dockerfile 做出 image（docker build）；上傳 = 把 image 放到 GHCR（docker push）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1050" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk8" value="upgrade（升級）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv8" value="改 .version 換新版本。兩條路：機器人提出合併請求（PR，人 merge 後下次 just 才換新）；或 just upgrade（改完立即 install → diff）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1080" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk9" value="PR / merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv9" value="GitHub 上的合併請求／接受它，修改才進 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk10" value="just / justfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv10" value="just 是主機上的指令跑器；justfile 是專案裡給它讀的指令清單，也就是啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1140" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk11" value="印記檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv11" value=".&amp;lt;name&amp;gt;/.stamp：安裝時寫下「版本 + 每檔指紋」，之後用來檢查有沒有被手改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk12" value="tag / digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv12" value="image 的版本名稱（v0.43.0）／內容指紋（sha256:…）；.version 兩者都記，工具只認 digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk13" value="Dockerfile / Dockerfile.dist / FROM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv13" value="Dockerfile = 打包 image 的食譜；Dockerfile.dist = 工具 repo 出貨用的食譜；FROM = 食譜第一行，指定以哪個 image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk14" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv14" value="git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk15" value="compose 指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv15" value="docker compose：依設定檔啟動專案容器的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#99999