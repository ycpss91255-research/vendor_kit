pace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv5" value="image 的內容指紋（sha256:…）；同一個 digest 永遠是同一份內容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="980" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk6" value=".version / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv6" value="專案裡記工具版本的檔／專案裡的 justfile，打 just 時它負責安裝與執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk7" value="install / diff / init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv7" value="安裝子命令／升級後比對子命令／init 要建立哪些檔的清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1040" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk8" value="工具 repo / GHCR / image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv8" valu