 as="geometry"></mxGeometry></mxCell><mxCell id="ce5" value="印出差異" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bC" source="c_c2" target="c_u3"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="258"/><mxPoint x="300" y="258"/></Array></mxGeometry></mxCell><mxCell id="p2n" value="紫框 = 子命令：install（第一次、版本改變時）、init（只有第一次）、verify（已安裝且版本一致時）、diff（升級後由使用者呼叫）。&lt;br&gt;沒有 Renovate 時用 just upgrade 手動：改 .version → 立即 install → diff（細節待議）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="1620" height="50" as="geometry"/></mxCell><mxCell id="p2_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="220" height="60" as="geometry"/></mxCell><mxCell id="p2_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1220" width="110" height="60" as="geometry"/></mxCell><mxCell id="p2_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1230" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1230" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1230" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="1230" width="88" height="40" as="geometry"/></mxCell><mxCell id="p2_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="1230" width="170" height="40" as="geometry"/></mxCell><mxCell id="p2_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="1230" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）&lt;br&gt;虛線 = 之後才會發生" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="1220" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1306" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2_tk0" value="啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv0" value="專案裡的 justfile：使用者打 just 指令時，它讀 .version、起安裝容器、再執行工具的腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1330" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk1" value="印記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv1" value=".&amp;lt;name&amp;gt;/.stamp：install 寫下的「版本 + 每檔指紋」；日常每次 just 都拿它比對" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1360" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk2" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv2" value="GitHub 上的機器人：GHCR 有新版就自動開 PR 改 .version；沒有它時用 just upgrade 手動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1390" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk3" value="docker compose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv3" value="工具腳本最後真正拿來建置／啟動／進入／停止專案容器的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1420" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk4" value="build / run / exec / stop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv4" value="四個日常指令：建置 image／啟動容器／進入容器／停止容器；都先經過同樣的檢查再執行 .&amp;lt;name&amp;gt;/ 內的腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1450" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk5" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv5" value="專案裡的版本清單（TOML）：一個工具一行，記工具名與 image 版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1480" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk6" value="PR / merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv6" value="GitHub 上的合併請求／接受它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1510" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk7" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1540" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv7" value="GitHub 的 image 倉庫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1540" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk8" value="dist / image / 模板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1570" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv8" value="dist = 工具要出貨的檔案；image = 打包好可執行的檔案包；模板 = dist 裡給初始檔用的樣板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1570" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk9" value="just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1600" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv9" value="主機上的指令跑器；使用者打 just &amp;lt;指令&amp;gt;，它照 justfile 執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1600" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk10" value="init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv10" value="工具提供的清單：init 時要複製到專案的初始檔有哪些、放哪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1630" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk11" value="entrypoint / hooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1660" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv11" value="初始檔的例子：容器啟動腳本／各指令前後可掛的自訂腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1660" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk12" value="&amp;lt;name&amp;gt; / 指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1690" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv12" value="&amp;lt;name&amp;gt; = .version 裡的工具名，安裝目錄就叫 .&amp;lt;name&amp;gt;/；指紋 = 由檔案內容算出的識別碼，內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1690" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk13" value="vendor_kit / Dockerfile / TOML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1720" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv13" value="安裝工具本身（在容器內跑）／打包 image 的食譜、也是專案自己的 image 食譜／設定檔格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1720" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_t