alue="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="410" y="730" width="88" height="40" as="geometry"/></mxCell><mxCell id="p3_lg3" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="518" y="730" width="130" height="40" as="geometry"/></mxCell><mxCell id="p3_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="668" y="720" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3_tk0" value="模板 / dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv0" value="dist = 工具要出貨的檔案，整批放進 .&amp;lt;name&amp;gt;/；模板 = dist 裡給初始檔用的樣板，diff 拿新版模板跟你的檔案比" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="830" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk1" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv1" value="git 的一次版本紀錄"