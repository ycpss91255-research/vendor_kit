ow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_unit" target="s_unit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_inst" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_inst" target="s_inst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_init" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_init" target="s_init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_ver" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_ver" target="s_ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_diff" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_diff" target="s_diff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gates" value="強制閘門（不靠提醒；違反就 CI 紅，依層分組）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="460" height="1010" as="geometry"/></mxCell><mxCell id="gl" value="lint 層 = 不執行程式的檢查（lint stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="50" width="420" height="220" as="geometry"/></mxCell><mxCell id="g_ruff" value="ruff&lt;br&gt;程式碼寫法檢查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="40" width="400" height="50" as="geometry"/></mxCell><mxCell id="g2" value="import-linter 分層契約&lt;br&gt;只能由上層 import 下層（命令介面 → 讀取／存取 → 純函式）；只有 repo_fs、dist_reader 能碰檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="100" width="400" height="50" as="geometry"/></mxCell><mxCell id="g3" value="鏡射檢查&lt;br&gt;每個 src 模組必有 test_&amp;lt;模組&amp;gt;.py，缺一個就失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="160" width="400" height="50" as="geometry"/></mxCell><mxCell id="gu" value="unit 層 = 一次測一個模組（unit-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="280" width="420" height="100" as="geometry"/></mxCell><mxCell id="g4" value="unit conftest&lt;br&gt;測試中一碰檔案、網路、Docker 就直接失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gu"><mxGeometry x="10" y="40" width="400" height="50" as="geometry"/></mxCell><mxCell id="gi" value="integration 層 = 一個子命令走到底（四個 *-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="390" width="420" height="220" as="geometry"/></mxCell><mxCell id="g5" value="integration conftest&lt;br&gt;只給臨時目錄；禁 Docker、網路；只能走 cli.main()（程式的正門）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="40" width="400" height="50" as="geometry"/></mxCell><mxCell id="g6" value="一個子命令一個 stage&lt;br&gt;各自只 COPY 自己的測試檔；哪個 stage 紅 = 第 5 頁哪條泳道壞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="100" width="400" height="50" as="geometry"/></mxCell><mxCell id="g7" value="時間預算&lt;br&gt;verify 200 個檔必須 &amp;lt; 0.5 秒（已安裝且版本一致時，每次 just 都會跑它）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="160" width="400" height="50" as="geometry"/></mxCell><mxCell id="gs" value="system = 整個 image；acceptance = 真的打 just（CI 主機）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="620" width="420" height="100" as="geometry"/></mxCell><mxCell id="g8" value="黑箱檢查（lint stage）＋ conftest&lt;br&gt;測試檔不准 import vendor_kit；只准 docker run／just 與檔案系統" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gs"><mxGeometry x="10" y="40" width="400" height="50" as="geometry"/></mxCell><mxCell id="gr" value="release = 出貨（release / smoke stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="730" width="420" height="160" as="geometry"/></mxCell><mxCell id="g1" value="BuildKit stage 依賴&lt;br&gt;release 只 FROM runtime → 測試碼、pytest 進不了產品 image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="40" width="400" height="50" as="geometry"/></mxCell><mxCell id="g9" value="release 必過 smoke&lt;br&gt;release image 真的 install + verify 一次，失敗就不上傳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="100" width="400" height="50" as="geometry"/></mxCell><mxCell id="g_map" value="對應：unit ↔ 第 1 頁模組；integration ↔ 第 5 頁泳道；acceptance ↔ 第 3 頁泳道。&lt;br&gt;層級名稱依 ISTQB：unit / integration / system / acceptance；smoke 是測試類型，不是層級" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="gates"><mxGeometry x="20" y="900" width="420" height="50" as="geometry"/></mxCell><mxCell id="p8_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg1" value="紫：image（每個 stage 都是一個 image）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1130" width="270" height="40" as="geometry"/></mxCell><mxCell id="p8_lg2" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="1120" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg3" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="770" y="1130" width="120" height="40" as="geometry"/></mxCell><mxCell id="p8_lgt" value="實線 = 依賴／複製方向" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="910" y="1120" width="300" height="60" as="geometry"/></mxCell><mxCell id="p8_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1206" width="200" height="20" as="geometry"/></mxCell><mxCell id="p8_tk0" value="stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv0" value="Dockerfile 裡的一個階段（FROM … AS 名稱）；docker build --target &amp;lt;名稱&amp;gt; 只做到那一階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk1" value="FROM / COPY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv1" value="Dockerfile 的兩個指令：FROM = 以哪個 stage／image 為底；COPY = 把 repo 裡的檔案放進 stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk2" value="BuildKit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv2" value="Docker 的建置引擎：只會建最終目標依賴到的 stage，沒被依賴的測試 stage 不會執行、也不會進 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk3" value="bake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv3" value="docker buildx bake：用一個檔定義多個 stage 目標與群組，CI 一次平行跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk4" value="runtime / release / smoke" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv4" value="runtime = 能執行 vendor_kit 的最小 image；release = 最終出貨的 image；smoke = 出貨前最小的一次實跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk5" value="toml-bridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv5" value="vendor_kit image 的基底 image（另一個 repo 提供，內含 Python 與 TOML 工具）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk6" value="pytest / conftest.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv6" value="Python 的測試框架／每個測試目錄的共用設定；這裡用它對該層測試強制限制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk7" value="ruff / import-linter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv7" value="Python 寫法檢查／檢查模組之間誰可以 import 誰（契約寫在設定檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk8" value="import / 純函式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv8" value="import = 一個模組引用另一個模組；純函式 = 只算結果、不碰檔案與網路的函式（template、diff、stamp、report）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk9" value="VERSION vs .version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv9" value="VERSION = fixtures 裡假 dist 的版本字串（image 內 /dist/VERSION，install 寫進印記）；.version = 專案 repo 記工具版本的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk10" value="鏡射" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv10" value="test/ 的檔名跟 src/ 一一對應：src 有 cli.py，test 就必須有 test_cli.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk11" value="黑箱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv11" value="只從外面用、不看裡面：system / acceptance 測試不准 import vendor_kit，只能像使用者一樣 docker run 或打 just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1560" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk12" value="install / verify / just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv12" value="install = 把 dist 裝進 .&amp;lt;name&amp;gt;/ 並寫印記；verify = 檢查 .&amp;lt;name&amp;gt;/ 沒被手改；just = 使用者在主機打的指令跑器（第 3 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk13" value="fixture / 假專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv13" value="測試用的假資料：假的 dist/、init.toml，以及一個只有 .version 與 justfile 的假專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1620" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk14" value="cli.main()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv14" value="vendor_kit 程式的正門（命令介面的進入點）；integration 測試只准從這裡進" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1650" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk15" value="docker run / CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv15" value="把 image 跑成容器的指令／GitHub 上的自動化流程（每次推送都跑 bake validate）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1680" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk16" value="ADR / ISTQB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1710" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv16" value="設計決策紀錄（doc/adr/ 裡一個決策一個檔）／國際軟體測試標準，本頁的層級名稱來自它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1710" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk17" value="泳道" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv17" value="流程圖裡的一條直欄，代表一個子命令或情境的完整流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1740" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
