<mxfile host="Electron" version="24.0.0" type="device">
<diagram id="v1p0" name="01 名詞與縮寫"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="3598" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="名詞與縮寫" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p0_intro" value="本頁是所有審閱頁的共同字典：之後每一頁只用這裡定義的詞。本頁只定義、不決議。審閱方式：逐條看名稱與定義是否貼切，不貼切的寫一句理由。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_s1" value="兩方與承諾關係" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t1_h0" value="名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="150" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h1" value="是誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="170" y="144" width="870" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h2" value="跟 VK 的互動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="144" width="300" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h3" value="地位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1340" y="144" width="260" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_r0c0" value="&lt;b&gt;使用者&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="174" width="150" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r0c1" value="會跑 VK 動詞的人，兩個場合：①在下游 repo 裡維護 dist/、把工具打成下游 image、用 dev／undev 在本機開發工具；②在專案裡跑 bootstrap.sh 接入、add／upgrade／remove、回答詢問或給 -y、commit 薄殼與版本鎖定行、升版有衝突就手動編輯再重跑、把 ci/check.sh 接進 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="174" width="870" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r0c2" value="直接跑 just vendor_kit …" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1040" y="174" width="300" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r0c3" value="被承諾方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1340" y="174" width="260" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c0" value="&lt;b&gt;VK&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="150" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c1" value="我們，vendor_kit 開發者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="220" width="870" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c2" value="維護引擎 image 與薄殼（含啟動器），履行對使用者的承諾；內部實作不屬契約、可變更" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1040" y="220" width="300" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c3" value="承諾方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1340" y="220" width="260" height="46" as="geometry"/></mxCell><mxCell id="p0_t1n" value="只打 just &amp;lt;ns&amp;gt; … 的人不是『方』：VK 在他背後只做工具 recipe 前的自動 sync；sync 失敗的訊息要寫清楚該找誰、做什麼，但那是對使用者的承諾內容，不是另一個角色。圖文一律寫全名，不縮寫。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t2l" value="兩種 repo 要分清楚：" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="322" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t2_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="364" width="150" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="170" y="364" width="200" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="370" y="364" width="1230" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_r0c0" value="&lt;b&gt;專案&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="394" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t2_r0c1" value="project" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="394" width="200" height="28" as="geometry"/></mxCell><mxCell id="p0_t2_r0c2" value="使用者的 git repo（或 monorepo 裡的一個子專案）：接入 VK 後含 .vendor_kit/；VK 的動詞都在專案裡跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="370" y="394" width="1230" height="28" as="geometry"/></mxCell><mxCell id="p0_t2_r1c0" value="&lt;b&gt;下游 repo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="422" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t2_r1c1" value="downstream repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="422" width="200" height="28" as="geometry"/></mxCell><mxCell id="p0_t2_r1c2" value="提供工具的 git repo；把 dist/ 用三行 Dockerfile 打成純資料的下游 image 推到 registry（公開或私有，由使用者自決；私有需憑證）。&amp;lt;repo&amp;gt; 是它的名字" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="370" y="422" width="1230" height="28" as="geometry"/></mxCell><mxCell id="p0_s2" value="VK 組件（component）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="464" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_c0" value="VK 由三個組件組成；組件是對外可見的最大單位，模組是組件內部的程式單元，&lt;b&gt;組件 &amp;gt; 模組&lt;/b&gt;。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="496" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_c1" value="&lt;b&gt;引擎&lt;/b&gt;：VK 的主程式，是容器 image；所有判斷與寫檔都在裡面做，只透過掛入的 /repo 看專案根。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="538" width="516" height="68" as="geometry"/></mxCell><mxCell id="p0_c2" value="&lt;b&gt;薄殼&lt;/b&gt;：.vendor_kit/ 內進 git、由引擎產生、人不改的五個檔（entry.just、vendor.just、log.sh、.gitignore、ci/check.sh）；五檔用同一套自描述標頭（通常在首行，ci/check.sh 在第二行）與 hash 契約。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="552" y="538" width="516" height="68" as="geometry"/></mxCell><mxCell id="p0_c3" value="&lt;b&gt;啟動器&lt;/b&gt;：薄殼內的 POSIX sh 片段，負責拉 image、展開工具內容、起引擎容器；bootstrap.sh 是第一次接入時的啟動器。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1084" y="538" width="516" height="68" as="geometry"/></mxCell><mxCell id="p0_s2b" value="VK 模組（module）——引擎內的 8 個程式單元" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="616" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="648" width="150" height="30" as="geometry"/></mxCell><mxCell id="p0_t3_h1" value="英文代號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="170" y="648" width="150" height="30" as="geometry"/></mxCell><mxCell id="p0_t3_h2" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="648" width="1280" height="30" as="geometry"/></mxCell><mxCell id="p0_t3_r0c0" value="版本解析" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="678" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r0c1" value="resolve" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="678" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r0c2" value="讀版本鎖定行、查 registry 最新版、算出這次要拉哪些 image、寫哪些檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="678" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r1c0" value="取件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r1c1" value="fetch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="706" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r1c2" value="把展開的工具內容寫進 cache/、逐檔驗指紋、寫印記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="706" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r2c0" value="初始檔合併" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="734" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r2c1" value="initfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="734" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r2c2" value="依工具宣告建初始檔、存基準版、升版時做三方合併" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="734" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r3c0" value="薄殼產生" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="762" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r3c1" value="shell" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="762" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r3c2" value="產生或重產薄殼五檔與自描述標頭，並比對薄殼是否被改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="762" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r4c0" value="進度與寫入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r4c1" value="progress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="790" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r4c2" value="建、恢復、刪進度檔；鎖；原子替換，讓可寫動詞中斷後能接續" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="790" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r5c0" value="設定與格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="818" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r5c1" value="schema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="818" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r5c2" value="讀寫 VK 檔的 TOML：檔案版檢查、未知欄位保留、config.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="818" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r6c0" value="紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="846" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r6c1" value="log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="846" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r6c2" value="每次執行寫一份執行紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="846" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r7c0" value="清理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="874" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r7c1" value="prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="874" width="150" height="28" as="geometry"/></mxCell><mxCell id="p0_t3_r7c2" value="找出版本鎖定行與本機覆寫都未引用的舊 image、殘留容器與暫存並刪除" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="320" y="874" width="1280" height="28" as="geometry"/></mxCell><mxCell id="p0_s3" value="常用詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="916" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="948" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t4_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="948" width="170" height="30" as="geometry"/></mxCell><mxCell id="p0_t4_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="380" y="948" width="1220" height="30" as="geometry"/></mxCell><mxCell id="p0_t4_r0c0" value="&lt;b&gt;專案檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="978" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r0c1" value="project file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="978" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r0c2" value="根 justfile、根 .dockerignore、建立後歸使用者的初始檔，以及專案裡其他原有的檔。VK 對它們只守專案檔四原則" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="978" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r1c0" value="&lt;b&gt;VK 檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1006" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r1c1" value="VK file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1006" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r1c2" value="VK 自己建、自己管的檔，全在 .vendor_kit/ 內：version.toml、version.local.toml、config.toml、薄殼、基準版與 metadata、cache/、gen/、進度檔、執行紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1006" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r2c0" value="&lt;b&gt;進 git 的檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1034" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r2c1" value="tracked file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1034" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r2c2" value="會被 commit 的檔；在 VK 檔中是 version.toml、config.toml、薄殼、基準版與 metadata；專案檔一律視為進 git 的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1034" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r3c0" value="&lt;b&gt;版本鎖定行&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1062" width="190" height="82" as="geometry"/></mxCell><mxCell id="p0_t4_r3c1" value="lock line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1062" width="170" height="82" as="geometry"/></mxCell><mxCell id="p0_t4_r3c2" value=".vendor_kit/version.toml 內每個工具（與引擎）各一行；進 git；只有這行決定裝哪一版。&lt;b&gt;唯一正規形&lt;/b&gt;：引擎行在檔案頂層 vendor_kit = &quot;&amp;lt;image&amp;gt;:&amp;lt;tag&amp;gt;@sha256:&amp;lt;digest&amp;gt;&quot;；工具行在 [tools] 表下 &amp;lt;repo&amp;gt; = &quot;&amp;lt;image&amp;gt;:&amp;lt;tag&amp;gt;@sha256:&amp;lt;digest&amp;gt;&quot;（&amp;lt;repo&amp;gt; 是未加引號的 TOML 鍵，名稱規則見佔位符）。每行：行首無空白、鍵後一個空白、=、一個空白、雙引號字串、無尾端註解、LF 結尾；引擎寫出一律此形。禁 BOM、禁重複鍵、禁 TOML 表旁路寫法（例如 [tools.&amp;lt;repo&amp;gt;]、[vendor_kit]）；引擎讀到非正規形 → 1 列出差異、不動。頂層另有 schema、written_by 兩個欄位，與 [tools] 下的工具行不同層、不會撞名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1062" width="1220" height="82" as="geometry"/></mxCell><mxCell id="p0_t4_r4c0" value="&lt;b&gt;正式版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1144" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r4c1" value="release version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1144" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r4c2" value="registry 上的正式 tag（排除預發行如 -rc、-beta）；沒指定 @&amp;lt;tag&amp;gt; 時「最新版」一律指最新正式版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1144" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r5c0" value="&lt;b&gt;初始檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1172" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r5c1" value="init file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1172" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r5c2" value="工具在 dist/init.toml 宣告、add 時建進專案的檔，分兩型：&lt;b&gt;copy 型&lt;/b&gt;（strategy = copy，預設；整檔複製成專案裡的新檔）、&lt;b&gt;append 型&lt;/b&gt;（strategy = append；把幾行插進專案既有檔，不整檔複製）；建立後歸使用者、進 git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1172" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r6c0" value="&lt;b&gt;基準版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1218" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r6c1" value="baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1218" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r6c2" value=".vendor_kit/baseline/&amp;lt;repo&amp;gt;/ 內上次套用的初始檔原版副本；進 git；升版時三方合併的共同祖先（另兩份是使用者的現況與新版初始檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1218" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r7c0" value="&lt;b&gt;三方合併&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1246" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r7c1" value="three-way merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1246" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r7c2" value="升版時對每個納管初始檔拿基準版（共同祖先）、使用者現況、新版三份做的合併；兩邊都改的地方合不起來就在檔內留衝突標記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1246" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r8c0" value="&lt;b&gt;metadata&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1274" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r8c1" value="metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1274" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r8c2" value="基準版旁的 .vendor_kit.toml：記每個初始檔的來源、狀態（納管／拒絕過…）、進行中的進度；進 git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1274" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r9c0" value="&lt;b&gt;可寫動詞&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1302" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r9c1" value="writing verb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1302" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r9c2" value="會建進度檔的動詞：install、uninstall、add、remove、upgrade（含升引擎）、dev、undev、prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1302" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r10c0" value="&lt;b&gt;唯讀動詞&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1330" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r10c1" value="read-only verb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1330" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r10c2" value="不建進度檔的動詞：update、sync、help；都不寫進 git 的檔、也不恢復進度檔。sync 仍會寫 cache/、gen/（不進 git）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1330" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r11c0" value="&lt;b&gt;進度檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1358" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r11c1" value="progress file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1358" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r11c2" value="可寫動詞的交易紀錄；成功即刪；中斷後下次可寫動詞先恢復再繼續（prune 例外：遇活躍進度檔只列出提示、不恢復、不阻擋）。兩種落點：.vendor_kit/.tmp.&amp;lt;verb&amp;gt;.&amp;lt;id&amp;gt;.toml（install、uninstall、remove、undev、prune、dev、升引擎用）與 metadata 內的 [progress]（add、upgrade &amp;lt;repo&amp;gt; 用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1358" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r12c0" value="&lt;b&gt;執行紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1404" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r12c1" value="run log" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1404" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r12c2" value=".vendor_kit/log/&amp;lt;verb&amp;gt;/&amp;lt;時間戳&amp;gt;-&amp;lt;id&amp;gt;.jsonl；每個動詞及每次 bootstrap.sh 執行各一檔（bootstrap.sh 自己那段寫在 log/bootstrap/）；不進 git；事後追溯用。順序：不寫檔、不拉 image、不起容器的前置檢查（是否 git repo、just 版本）可在建紀錄之前；任何寫入、拉取、起引擎之前必已有紀錄；紀錄建不了就不做任何事" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1404" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r13c0" value="&lt;b&gt;CI 模式&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1450" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r13c1" value="CI mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1450" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r13c2" value="環境變數 CI 為真（非空且不是 0／false）時的模式：不寫任何進 git 的檔、不查最新版（update 除外：它的用途就是查）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1450" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r14c0" value="&lt;b&gt;需人處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1478" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r14c1" value="needs human" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1478" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r14c2" value="動詞停下並印出下一步指令的結束：結束碼 1 或 3 且附指令，衝突 2 亦同；圖上橙色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1478" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r15c0" value="&lt;b&gt;失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1506" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r15c1" value="failure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1506" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r15c2" value="拉不到、寫不進、驗證不過這類無法繼續的結束；印原因；結束碼 1；圖上紅色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1506" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r16c0" value="&lt;b&gt;專案檔四原則&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1534" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r16c1" value="four rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1534" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r16c2" value="① 可以建，但要明說建了什麼；② 要改先問，-y 免問；③ 永不刪；④ 永不覆蓋（不用工具版本取代客製內容）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1534" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r17c0" value="&lt;b&gt;預檢&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1562" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r17c1" value="precheck" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1562" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r17c2" value="動詞在寫任何檔之前做的全部檢查（撞名、憑證、dev 中、要問什麼）；多工具動詞先對全部工具預檢完，任一不過就整體不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1562" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r18c0" value="&lt;b&gt;resolve／apply（兩段式）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1590" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r18c1" value="two-phase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r18c2" value="兩段式動詞（add、remove、upgrade、sync、undev、uninstall、prune）分兩段、最多起兩個引擎容器：先在唯讀的 resolve 容器算計畫與指紋，啟動器再拉 image（需要新版內容的動詞才拉），最後在 apply 容器重驗指紋後寫入（sync 算出沒事做時到 resolve 為止）；單段動詞（install、升引擎、update、dev、help）只有一個容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1590" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r19c0" value="&lt;b&gt;介面版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1636" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r19c1" value="protocol version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1636" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r19c2" value="薄殼與引擎之間的整數版號 P；薄殼每次呼叫附上；與 release 版號無關" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1636" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r20c0" value="&lt;b&gt;檔案版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1664" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r20c1" value="schema version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1664" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r20c2" value="VK 寫的每個 TOML 內的 schema = N；決定引擎能不能讀這個檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1664" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r21c0" value="&lt;b&gt;最低介面版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1692" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r21c1" value="floor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1692" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r21c2" value="引擎仍支援的最低介面版；固定常數；只能經 ADR 提高" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1692" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r22c0" value="&lt;b&gt;結束碼&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1720" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r22c1" value="exit code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1720" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r22c2" value="0 成功（含 warn）；1 需人處理或失敗（哪一種由訊息語意決定，不由碼決定）；2 合併衝突（留標記、基準版仍推到新版；合併結果是 TOML／just 而解析不過的檔 → 也是 2，但留原檔、該檔基準版不推）；3 介面版／檔案版不合，先升級或退回，零寫入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1720" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r23c0" value="&lt;b&gt;本機覆寫&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1766" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r23c1" value="local override" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1766" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r23c2" value="version.local.toml 內由 dev（或 bootstrap.sh --local）寫的項目，每個工具或引擎各一項：工具那項 = 一行 path:&amp;lt;dir&amp;gt;，把工具指到本機目錄；引擎那項 = tag ＋ image ID 兩欄，把引擎指到本機 image（image ID 供後續驗證：啟動器每次起引擎前比對本機 image 的 ID）；不進 git；有就優先於版本鎖定行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1766" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r24c0" value="&lt;b&gt;symlink&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1812" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r24c1" value="symlink" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1812" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r24c2" value="符號連結：一個指向別處目錄或檔案的捷徑；dev 用它讓 cache/&amp;lt;repo&amp;gt;/ 指向本機目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1812" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r25c0" value="&lt;b&gt;hash&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1840" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r25c1" value="hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1840" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r25c2" value="檔案內容的 sha256 指紋；同內容必同 hash。用在薄殼自描述標頭、印記、指紋重驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1840" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r26c0" value="&lt;b&gt;image ID&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1868" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r26c1" value="image ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1868" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r26c2" value="docker 本機 image 的內容 ID（sha256:&amp;lt;hex64&amp;gt;）；只在本機有意義，與 registry 的 digest 不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1868" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r27c0" value="&lt;b&gt;tty&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1896" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r27c1" value="tty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1896" width="170" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r27c2" value="互動終端；有 tty 才能問問題。沒 tty（CI、管線）又沒 -y 時，需詢問的動詞以 1 結束" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1896" width="1220" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r28c0" value="&lt;b&gt;佔位符&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1924" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r28c1" value="placeholder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1924" width="170" height="46" as="geometry"/></mxCell><mxCell id="p0_t4_r28c2" value="&amp;lt;repo&amp;gt; 下游 repo 名，規則 [a-z0-9_][a-z0-9_-]*（小寫、不含句點，才能當 [tools] 下未加引號的 TOML 鍵；OCI repo 名本就小寫），vendor_kit 保留給引擎、不得作工具名；&amp;lt;ns&amp;gt; 工具的 just 命名空間；&amp;lt;image&amp;gt; image 名（含 registry 與路徑）；&amp;lt;tag&amp;gt; image 版本名；&amp;lt;digest&amp;gt; image 內容指紋的 64 位十六進位 &amp;lt;hex64&amp;gt;，寫法 sha256:&amp;lt;digest&amp;gt;；&amp;lt;dir&amp;gt; 目錄；&amp;lt;id&amp;gt; 一次執行的交易 id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="380" y="1924" width="1220" height="46" as="geometry"/></mxCell><mxCell id="p0_s4" value="其他既有詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1984" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="2016" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t5_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="2016" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t5_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="2016" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p0_t5_r0c0" value="&lt;b&gt;下游 image&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2046" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r0c1" value="downstream image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2046" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r0c2" value="FROM scratch 只放檔案的 image，沒有程式、不會被執行；多架構 amd64 + arm64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2046" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r1c0" value="&lt;b&gt;dist/&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2074" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r1c1" value="dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2074" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r1c2" value="下游 repo 的出貨目錄：files/（全部展開到 cache/）、init.toml、just/&amp;lt;ns&amp;gt;.just；其他內容不出貨" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2074" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r2c0" value="&lt;b&gt;工具 recipe&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2102" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r2c1" value="tool recipe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2102" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r2c2" value="工具的 dist/just/&amp;lt;ns&amp;gt;.just 提供、使用者以 just &amp;lt;ns&amp;gt; … 執行的 just 指令；相對於 VK 自己的動詞 just vendor_kit …。每次執行前自動觸發一次 sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2102" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r3c0" value="&lt;b&gt;專案根&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2130" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r3c1" value="project root" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2130" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r3c2" value="專案內含 .vendor_kit/ 的目錄；不是 git toplevel；monorepo 子專案各自一套" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2130" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r4c0" value="&lt;b&gt;cache/、gen/&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2158" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r4c1" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2158" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r4c2" value=".vendor_kit/ 內不進 git 的兩個目錄：cache/&amp;lt;repo&amp;gt;/ 放工具內容的本機副本，gen/ 放引擎產生、供 just 載入的檔；其中 gen/tools.just 是引擎產生、把各工具的 &amp;lt;ns&amp;gt;.just 接進 just 的入口檔（每個 &amp;lt;ns&amp;gt;.just 一行；由薄殼 entry.just 載入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2158" width="1200" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r5c0" value="&lt;b&gt;印記&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2204" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r5c1" value="stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2204" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r5c2" value="gen/&amp;lt;repo&amp;gt;.stamp：第一行 = 裝的是哪個 digest（dev 時是 path:&amp;lt;dir&amp;gt;），之後每檔一行指紋；只是已裝版本的快取鍵，不是信任來源" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2204" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r6c0" value="&lt;b&gt;納管&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2232" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r6c1" value="managed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2232" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r6c2" value="初始檔經使用者同意建立後，VK 在 metadata 記下它的來源與狀態；拒絕建立也記（拒絕過）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2232" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r7c0" value="&lt;b&gt;自描述標頭&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2260" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r7c1" value="self-describing header" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2260" width="190" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r7c2" value="薄殼每檔的 # vendor_kit-shell/&amp;lt;介面版&amp;gt; engine=&amp;lt;引擎版&amp;gt; sha256=&amp;lt;其餘內容的 hash&amp;gt;；通常在首行，檔案有 shebang 時（ci/check.sh）在第二行；引擎重算比對，不符就不動（規格原文稱「自描述首行」）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2260" width="1200" height="46" as="geometry"/></mxCell><mxCell id="p0_t5_r8c0" value="&lt;b&gt;救援路徑&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2306" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r8c1" value="rescue path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2306" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t5_r8c2" value="不依賴 gen/ 的單段引擎呼叫；任何 ≥ 最低介面版的薄殼永久可用。兩種情境：第一次接入由 bootstrap.sh 啟動 install；既有薄殼修復用 install 再跑、升引擎、sync 的不符提示、help" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2306" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_s5" value="語法記法" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="2348" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_n0" value="動詞表與後頁的指令寫法一律照這張表。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2380" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t6_h0" value="記法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="2422" width="260" height="30" as="geometry"/></mxCell><mxCell id="p0_t6_h1" value="意思" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="280" y="2422" width="1320" height="30" as="geometry"/></mxCell><mxCell id="p0_t6_r0c0" value="&amp;lt;x&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2452" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r0c1" value="必填佔位符" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2452" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r1c0" value="[x]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2480" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r1c1" value="可省略" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2480" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r2c0" value="[@&amp;lt;tag&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2508" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r2c1" value="可省略的版本後綴，緊接 repo 名（&amp;lt;repo&amp;gt;@&amp;lt;tag&amp;gt;）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2508" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r3c0" value="-x &amp;lt;值&amp;gt;／--long &amp;lt;值&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2536" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r3c1" value="短／長選項等價；只有常用的才有短的" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2536" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r4c0" value="-y" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2564" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r4c1" value="不帶值的開關" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2564" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r5c0" value="a／b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2592" width="260" height="28" as="geometry"/></mxCell><mxCell id="p0_t6_r5c1" value="二選一" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="280" y="2592" width="1320" height="28" as="geometry"/></mxCell><mxCell id="p0_o0" value="動詞表用到的選項（短形只有 -t、-y、-p、-i、-h）：" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2634" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_o1" value="-t &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]／--tool &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]：bootstrap.sh 要接入的工具與版本，可重複；省略 @&amp;lt;tag&amp;gt; = 最新正式版。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2676" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o2" value="-p &amp;lt;dir&amp;gt;／--path &amp;lt;dir&amp;gt;：把工具指到本機目錄（dev &amp;lt;repo&amp;gt;）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2704" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o3" value="-i &amp;lt;tag&amp;gt;／--image &amp;lt;tag&amp;gt;：把引擎指到本機 image（dev vendor_kit；只能 tag）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2732" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o4" value="-y／--yes：省略詢問，視同回答「是」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2760" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o5" value="--exit-code：update 有新版時以結束碼 2 回報，而不是只印出來。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2788" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o6" value="--dry-run：只預覽會問什麼、會改什麼，不寫任何進 git 的檔、不建進度檔；需要新版內容的動詞（add、upgrade）仍會拉 image 展開，uninstall、remove、prune 不拉。只有這五個動詞接受。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2816" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o7" value="--source &amp;lt;image&amp;gt;：add 時下游 image 名不照 &amp;lt;repo&amp;gt;-dist 慣例時指定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2844" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o8" value="--local &amp;lt;tar&amp;gt;：add 離線：只收存在的 .tar 離線包。bootstrap.sh 的 --local &amp;lt;image tag／tar&amp;gt; 另可收本機 image tag，值依序判別：以 .tar 結尾 → 檔案路徑（必須存在，否則 1）；否則值含 / 且存在同名檔 → 1 要求消歧；否則 → image tag。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2872" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o9" value="--verify：sync 逐檔驗指紋（CI 模式下本來就逐檔驗，不必加）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2900" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o10" value="--no-justfile：install 跳過根 justfile 那一步，只印手動加那一行的指示。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2928" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o11" value="--help（-h）：印該動詞的用法；所有動詞都接受，不列在各動詞語法裡。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2956" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_o12" value="--timeout &amp;lt;秒&amp;gt;：單次拉 image 的上限秒數；會拉 image 的動詞（add、upgrade、sync、undev、bootstrap.sh）都接受。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2984" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_s6" value="動詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="3022" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_v0" value="寫法：小寫原文，前面省略 just vendor_kit。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3054" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t7_h0" value="動詞" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="3096" width="330" height="30" as="geometry"/></mxCell><mxCell id="p0_t7_h1" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="350" y="3096" width="1250" height="30" as="geometry"/></mxCell><mxCell id="p0_t7_r0c0" value="install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3126" width="330" height="46" as="geometry"/></mxCell><mxCell id="p0_t7_r0c1" value="第一次接入：建 .vendor_kit/、薄殼、version.toml、config.toml、空 baseline/；根 justfile 無 → 建四行（import、空行、default:、@just --list），有 → 問後加 import 一行；根 .dockerignore 無 → 建四行，有 → 問後加四行；再跑 = 冪等修復；不做 git init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3126" width="1250" height="46" as="geometry"/></mxCell><mxCell id="p0_t7_r1c0" value="uninstall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3172" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r1c1" value="移除 VK 自產的檔、根 justfile 那一行與根 .dockerignore 那四行（都經詢問、只刪仍與原文相同的行，改過的跳過並 warn）；保留：執行紀錄、初始檔（只印清單）、被使用者改過的 config.toml 與薄殼、非空目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3172" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r2c0" value="add &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3200" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r2c1" value="接入一個工具：展開到 cache/、建初始檔與基準版、最後寫版本鎖定行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3200" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r3c0" value="remove &amp;lt;repo&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3228" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r3c1" value="移除該工具的版本鎖定行、cache/、基準版；初始檔不刪只印清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3228" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r4c0" value="update [&amp;lt;repo&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3256" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r4c1" value="只查有沒有新版，只寫執行紀錄；--exit-code 有新版回 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3256" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r5c0" value="upgrade [&amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3284" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r5c1" value="升到最新（或指定）版：換 cache/、初始檔三方合併、基準版推到新版、改版本鎖定行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3284" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r6c0" value="dev &amp;lt;repo&amp;gt; -p &amp;lt;dir&amp;gt;／dev vendor_kit -i &amp;lt;tag&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3312" width="330" height="46" as="geometry"/></mxCell><mxCell id="p0_t7_r6c1" value="把工具指到本機目錄：寫本機覆寫、cache/&amp;lt;repo&amp;gt;/ 改成指向 &amp;lt;dir&amp;gt;/dist 的 symlink、印記記 path:&amp;lt;dir&amp;gt;；或把引擎指到本機 image：寫本機覆寫（tag 與 image ID）。工具須已在版本鎖定行；也建進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3312" width="1250" height="46" as="geometry"/></mxCell><mxCell id="p0_t7_r7c0" value="undev &amp;lt;repo&amp;gt;／undev vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3358" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r7c1" value="撤銷 dev，回到版本鎖定行的版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3358" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r8c0" value="sync [&amp;lt;repo&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3386" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r8c1" value="依版本鎖定行重建 cache/ 與 gen/；不改任何進 git 的檔；工具 recipe 執行前自動觸發" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3386" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r9c0" value="prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3414" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r9c1" value="刪版本鎖定行與本機覆寫都未引用的舊 image、殘留容器／network／volume 與暫存；遇活躍進度檔只列出提示、不恢復、不阻擋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3414" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r10c0" value="help" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3442" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t7_r10c1" value="印命名空間層說明；不觸網、只寫執行紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="3442" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_v1" value="&lt;b&gt;升引擎&lt;/b&gt; = upgrade vendor_kit[@&amp;lt;tag&amp;gt;]：改引擎那一行的版本鎖定行、用新引擎重產薄殼，然後回 1 要求再跑一次剛才的指令。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3484" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_v2" value="記法與顏色見主圖第 0 頁「圖例與記法」；審閱規則見 AGENTS.md。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3526" width="1580" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
