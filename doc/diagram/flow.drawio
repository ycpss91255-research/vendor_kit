          <mxGeometry x="975" y="40" width="145" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x0" value="1：什麼都沒寫" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=21;spacingRight=21;spacingTop=15;spacingBottom=15;" vertex="1" parent="r3">
          <mxGeometry x="50" y="40" width="145" height="100" as="geometry" />
