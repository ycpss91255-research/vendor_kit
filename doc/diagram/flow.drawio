  <diagram id="flow-writing" name="可寫 recipe 的寫入時序">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="可寫 recipe 的寫入時序：每一步寫哪個檔、在這一步回 1 會留下什麼" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
