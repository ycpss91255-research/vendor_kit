        <mxCell id="ok" value="完成：0，或 2（有合併衝突待解）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=21;spacingRight=21;spacingTop=15;spacingBottom=15;" vertex="1" parent="r3">
          <mxGeometry x="975" y="40" width="145" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nx" value="後續檢查（sync、CI 檢查腳本、下一個可寫 recipe）看到進度檔就知道沒完成，並印出下一步" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="r3">
