        <mxCell id="x2" value="1：只有執行紀錄＋進度檔，內容檔未動" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=21;spacingRight=21;spacingTop=15;spacingBottom=15;" vertex="1" parent="r3">
          <mxGeometry x="420" y="40" width="145" height="100" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="任一項不過：1，整體不動，列出每一個不過的原因" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=21;spacingRight=21;spacingTop=15;spacingBottom=15;" vertex="1" parent="r3">
