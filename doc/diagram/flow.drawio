        <mxCell id="x1" value="建不出執行紀錄：1，不動任何檔" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=21;spacingRight=21;spacingTop=15;spacingBottom=15;" vertex="1" parent="r3">
          <mxGeometry x="235" y="40" width="145" height="100" as="geometry" />
