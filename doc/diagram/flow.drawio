        </mxCell>
        <mxCell id="r1" value="引擎步驟" style="swimlane;html=1;rounded=1;startSize=40;fontStyle=1;fontSize=16;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="1160" height="230" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="這步寫的檔" style="swimlane;html=1;rounded=1;startSize=40;fontStyle=1;fontSize=16;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="350" width="1160" height="170" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="在這步回 1 時留下的狀態" style="swimlane;html=1;rounded=1;startSize=40;fontStyle=1;fontSize=16;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="540" width="1160" height="300" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="前置檢查&lt;br&gt;（不寫檔、不拉 image、不起容器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="50" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. 建執行紀錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="235" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. 建進度檔&lt;br&gt;（--dry-run 不建，只預覽）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="420" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. 不帶工具名時&lt;br&gt;對全部工具完整預檢" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="605" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. 寫入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="790" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. 最後才改版本鎖定行&lt;br&gt;（remove 則最後才刪）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="r1">
          <mxGeometry x="975" y="30" width="145" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="開始前發現未完成的進度檔：可寫 recipe 先恢復再繼續；唯讀 recipe 只偵測" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="r1">
          <mxGeometry x="420" y="130" width="145" height="85" as="geometry" />
