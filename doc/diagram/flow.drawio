  <diagram id="flow-merge" name="初始檔升版分支">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="初始檔升版分支：upgrade 對單一個初始檔的逐檔判斷（輸入：基準版、目前 repo 檔、新版初始檔）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1160" height="34" as="geometry" />
        </mxCell>
        <mxCell id="la" value="引擎判斷" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
