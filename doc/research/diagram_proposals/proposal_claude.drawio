<mxfile host="local">
<diagram id="c-a1" name="A1 兩方與 11 個 recipe"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A1 兩方與 11 個 recipe" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1180" height="28" as="geometry"/></mxCell><mxCell id="question" value="誰對誰承諾？使用者手上有哪幾個指令？哪些會寫進 git 的檔？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1180" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 1、2、3、8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="L1" value="兩方與承諾" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="460" height="710" as="geometry"/></mxCell><mxCell id="user" value="使用者：用 VK 管理工具的人（被承諾的一方）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L1"><mxGeometry x="20" y="46" width="420" height="60" as="geometry"/></mxCell><mxCell id="cons" value="導入：把別人做好的工具帶進自己的 repo，交給 VK 管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L1"><mxGeometry x="20" y="156" width="180" height="70" as="geometry"/></mxCell><mxCell id="ship" value="出貨：把自己做的工具打包出去，給別的 repo 導入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L1"><mxGeometry x="260" y="156" width="180" height="70" as="geometry"/></mxCell><mxCell id="pc" value="對導入：不刪、不覆蓋 repo 檔；同一行版本鎖定行在任何機器裝到同一份內容；升得了、退得回；失敗必印原因與下一步；主機只需 Git、Docker、just" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="L1"><mxGeometry x="20" y="300" width="180" height="200" as="geometry"/></mxCell><mxCell id="ps" value="對出貨：照出貨格式準備就搬得到；只搬檔，不執行也不驗證能不能跑；導入端拿到的每個檔與 image 內位元組相同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="L1"><mxGeometry x="260" y="300" width="180" height="200" as="geometry"/></mxCell><mxCell id="vk" value="VK：引擎與薄殼的維護者（提出承諾的一方）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L1"><mxGeometry x="20" y="600" width="420" height="60" as="geometry"/></mxCell><mxCell id="L2" value="11 個 VK recipe：just vendor_kit &amp;lt;recipe&amp;gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="660" height="710" as="geometry"/></mxCell><mxCell id="h_pair" value="做得了就反得回（成對）" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="L2"><mxGeometry x="20" y="36" width="400" height="24" as="geometry"/></mxCell><mxCell id="install" value="install：把 VK 裝進一個目錄，使它成為安裝目錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="20" y="66" width="180" height="60" as="geometry"/></mxCell><mxCell id="uninstall" value="uninstall：把 VK 從安裝目錄移除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="240" y="66" width="180" height="60" as="geometry"/></mxCell><mxCell id="add" value="add（常用）：把一個工具納入安裝目錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="20" y="166" width="180" height="60" as="geometry"/></mxCell><mxCell id="remove" value="remove：解除那個工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="240" y="166" width="180" height="60" as="geometry"/></mxCell><mxCell id="dev" value="dev（常用）：引擎或工具改用本機開發來源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="20" y="266" width="180" height="60" as="geometry"/></mxCell><mxCell id="undev" value="undev：回到鎖定版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="240" y="266" width="180" height="60" as="geometry"/></mxCell><mxCell id="h_q" value="查與套用分開" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="L2"><mxGeometry x="20" y="346" width="400" height="24" as="geometry"/></mxCell><mxCell id="update" value="update：只查有沒有新版，不改任何檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="20" y="376" width="180" height="60" as="geometry"/></mxCell><mxCell id="upgrade" value="upgrade（常用）：把鎖定版本換成新版或指定版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="240" y="376" width="180" height="60" as="geometry"/></mxCell><mxCell id="h_solo" value="不成對的三個必須無害：不改進 git 的檔" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="L2"><mxGeometry x="20" y="456" width="620" height="24" as="geometry"/></mxCell><mxCell id="sync" value="sync：本機工具內容與版本鎖定行一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="20" y="486" width="180" height="60" as="geometry"/></mxCell><mxCell id="prune" value="prune：清掉不再使用的本機資源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="240" y="486" width="180" height="60" as="geometry"/></mxCell><mxCell id="help" value="help：印出使用說明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="460" y="486" width="180" height="60" as="geometry"/></mxCell><mxCell id="boot" value="bootstrap.sh：首次導入的啟動器；下載引擎後呼叫 install，再跑 = 修復" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L2"><mxGeometry x="460" y="66" width="180" height="90" as="geometry"/></mxCell><mxCell id="cls" value="可寫 recipe（動進 git 的檔或進度檔）：install、uninstall、add、remove、upgrade、dev、undev、prune&lt;br&gt;唯讀 recipe：sync、update、help" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L2"><mxGeometry x="20" y="586" width="620" height="90" as="geometry"/></mxCell><mxCell id="L3" value="會寫進 git 的檔" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="1220" y="70" width="220" height="710" as="geometry"/></mxCell><mxCell id="f_ver" value="version.toml：全部版本鎖定行" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="46" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_shell" value="薄殼五檔" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="136" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_base" value="baseline/：基準版與 metadata" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="226" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_cfg" value="config.toml：VK 的設定檔（使用者可改）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="316" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_init" value="初始檔（repo 檔）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="406" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_just" value="根 justfile：一行 import（repo 檔）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="496" width="180" height="60" as="geometry"/></mxCell><mxCell id="f_dock" value="根 .dockerignore：四行（repo 檔）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L3"><mxGeometry x="20" y="586" width="180" height="60" as="geometry"/></mxCell><mxCell id="e1" value="情境" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="user" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="情境" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="user" target="ship"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="承諾" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="vk" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="承諾" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="vk" target="ps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="保護" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="pc" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="保護" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="ps" target="ship"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="反向" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="install" target="uninstall"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="反向" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="add" target="remove"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="反向" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="dev" target="undev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="查到後套用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="update" target="upgrade"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="呼叫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="boot" target="install"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="產生" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="install" target="f_shell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="建或問後 append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="add" target="f_init"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="最後才改" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="upgrade" target="f_ver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="加一行（先問）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="install" target="f_just"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="c-a2" name="A2 模組邊界與資料流"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A2 模組邊界與資料流" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1300" height="28" as="geometry"/></mxCell><mxCell id="question" value="主機載入鏈、啟動器、引擎模組、registry 各管什麼？之間傳什麼？（箭頭只標資料，不是執行順序）" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1300" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 5、6、7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1340" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="H" value="主機：just 載入鏈" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="460" height="400" as="geometry"/></mxCell><mxCell id="u" value="使用者打 just vendor_kit &amp;lt;recipe&amp;gt; 或 just &amp;lt;ns&amp;gt; …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="20" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell id="rj" value="根 justfile（repo 檔）：import entry.just" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="20" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="ej" value="entry.just：mod vendor_kit、import? gen/tools.just" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="20" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="vj" value="vendor.just：每個 recipe 一行轉發 + 啟動器本體" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="260" y="240" width="180" height="60" as="geometry"/></mxCell><mxCell id="tj" value="gen/tools.just：每個 &amp;lt;ns&amp;gt; 一行" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="20" y="320" width="200" height="60" as="geometry"/></mxCell><mxCell id="tr" value="工具 recipe：前置 _sync 回叫 just vendor_kit sync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="H"><mxGeometry x="260" y="320" width="180" height="60" as="geometry"/></mxCell><mxCell id="L" value="啟動器（主機 POSIX sh；只做不需知道規則的事）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="460" height="440" as="geometry"/></mxCell><mxCell id="l1" value="以字串相等 grep 版本鎖定行（本機覆寫優先）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="20" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell id="l2" value="寫執行紀錄（啟動器事件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="240" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell id="l3" value="讀引擎 image LABEL：介面版區間" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="20" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="l4" value="驗 vk-resolve/P 文法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="240" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="l5" value="照計畫呼叫 docker：inspect／pull／create／cp／rm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="20" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="l6" value="起引擎容器，附 --protocol P" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="240" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="l7" value="清掉自己建的容器與暫存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="L"><mxGeometry x="20" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="l8" value="不確定就起引擎；拿到版本鎖定行後不得改用內嵌引擎" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="L"><mxGeometry x="240" y="340" width="200" height="70" as="geometry"/></mxCell><mxCell id="R" value="registry" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="420" height="170" as="geometry"/></mxCell><mxCell id="ie" value="引擎 image vendor_kit:vN（多架構；LABEL 介面版、檔案版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="R"><mxGeometry x="20" y="46" width="180" height="90" as="geometry"/></mxCell><mxCell id="it" value="工具 image &amp;lt;repo&amp;gt;-dist（純資料，不執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="R"><mxGeometry x="220" y="46" width="180" height="90" as="geometry"/></mxCell><mxCell id="E" value="引擎容器（規則只在這一份）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;ho