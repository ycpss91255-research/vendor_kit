<diagram id="c-a5" name="A5 結束碼 × 版本組合"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A5 結束碼 × 版本組合" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1180" height="28" as="geometry"/></mxCell><mxCell id="question" value="從外面看得到哪幾個結束碼？版本組合不合時怎麼判、什麼時候零寫入？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1180" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 4、10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="X" value="結束碼（對外契約）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="420" height="730" as="geometry"/></mxCell><mxCell id="c0" value="0 成功（含 warn）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="X"><mxGeometry x="20" y="46" width="180" height="60" as="geometry"/></mxCell><mxCell id="c1" value="1 失敗或需人處理" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="X"><mxGeometry x="220" y="46" width="180" height="60" as="geometry"/></mxCell><mxCell id="c2" value="2 完成但要人接手：合併衝突、update --exit-code 有新版" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="X"><mxGeometry x="20" y="146" width="180" height="80" as="geometry"/></mxCell><mxCell id="c3" value="3 版本組合不合：先升級或退回" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="X"><mxGeometry x="220" y="146" width="180" height="80" as="geometry"/></mxCell><m