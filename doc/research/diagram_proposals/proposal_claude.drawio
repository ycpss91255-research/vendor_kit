<diagram id="c-a3" name="A3 安裝目錄裡的檔"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A3 安裝目錄裡的檔" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1160" height="28" as="geometry"/></mxCell><mxCell id="question" value=".vendor_kit/ 有哪些檔？哪三處會碰 repo 檔？誰寫、誰能改？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1160" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 1、2、3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="C1" value="進 git · VK 擁有（VK 重寫不算覆蓋）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="340" height="730" as="geometry"/></mxCell><mxCell id="ver" value="version.toml：全部版本鎖定行｜寫：install、add、upgrade、remove｜改：可手改來升退版" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C1"><mxGeometry x="20" y="46" width="300" height="80" as="geometry"/></mxCell><mxCell id="shell" value="薄殼五檔：entry.just、vendor.just、log.sh、.gitignore、ci/check.sh｜寫：install、upgrade vendor_kit｜改：不可改，被改就停下" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C1"><mxGeometry x="20" y="166" width="300" height="100" as="geometry"/></mxCell><mxCell id="base" value="baseline/&amp;lt;repo&amp;gt;/：基準版（上次套用的初始檔原版）｜寫：add、upgrade" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C1"><mxGeometry x="20" y="306" width="300" height="80" as="geometry"/></mxCell><mxCell id="meta" value="metadata：初始檔來源、納管狀態、append 行原文｜寫：add、upgrade、remove" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C1"><mxGeometry x="20" y="426" width="300" height="80" as="geometry"/></mxCell><mxCell id="dock_rec" value="baseline/.vendor_kit.toml：根 .dockerignore 四行的紀錄｜寫：install" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C1"><mxGeometry x="20" y="546" width="300" height="80" as="geometry"/></mxCell><mxCell id="C2" value="進 git · 使用者可改" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="280" height="730" as="geometry"/></mxCell><mxCell id="cfg" value="config.toml：VK 的設定檔｜寫：install 建；upgrade vendor_kit 基準版合併（先問）｜改：使用者" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C2"><mxGeometry x="20" y="46" width="240" height="100" as="geometry"/></mxCell><mxCell id="cfg_note" value="比照初始檔：換新版或合併前一樣要先問" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="C2"><mxGeometry x="20" y="186" width="240" height="60" as="geometry"/></mxCell><mxCell id="C3" value="不進 git · 本機（.vendor_kit/.gitignore 涵蓋）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="680" y="70" width="340" height="730" as="geometry"/></mxCell><mxCell id="cache" value="cache/&amp;lt;repo&amp;gt;/：已展開的工具內容｜寫：取件｜改：不可改，驗不過就重裝" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="46" width="300" height="70" as="geometry"/></mxCell><mxCell id="stamp" value="gen/&amp;lt;repo&amp;gt;.stamp：印記（digest + 逐檔指紋）｜寫：取件" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="146" width="300" height="70" as="geometry"/></mxCell><mxCell id="gen" value="gen/tools.just、gen/.stamp：供 just 載入｜寫：引擎" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="246" width="300" height="70" as="geometry"/></mxCell><mxCell id="local" value="version.local.toml：本機覆寫｜寫：dev、undev" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="346" width="300" height="70" as="geometry"/></mxCell><mxCell id="tmp" value=".tmp.*：進度檔與啟動器暫存｜寫：可寫 recipe、啟動器" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="446" width="300" height="70" as="geometry"/></mxCell><mxCell id="log" value="log/：執行紀錄｜寫：啟動器與引擎｜不可關閉" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C3"><mxGeometry x="20" y="546" width="300" height="70" as="geometry"/></mxCell><mxCell id="auto" value="自動化（每次 just 前置的 sync）只寫這一欄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="C3"><mxGeometry x="20" y="646" width="300" height="60" as="geometry"/></mxCell><mxCell id="C4" value="repo 檔：VK 只碰這三處" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="380" height="730" as="geometry"/></mxCell><mxCell id="rj" value="根 justfile：install 加一行 import（無檔則建、有檔則問）｜uninstall 只收回那一行" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C4"><mxGeometry x="20" y="46" width="340" height="80" as="geometry"/></mxCell><mxCell id="rd" value="根 .dockerignore：install 加四行（無檔則建、有檔則問）｜uninstall 只收回原文相同的行" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C4"><mxGeometry x="20" y="166" width="340" height="80" as="geometry"/></mxCell><mxCell id="ini" value="初始檔（init.toml 的 dest）：add 無則建、已存在不納管只 warn、append 問後加｜upgrade 逐檔問、基準版合併｜永不刪" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="C4"><mxGeometry x="20" y="286" width="340" height="110" as="geometry"/></mxCell><mxCell id="never" value="可以建、要改先問、永不刪、永不覆蓋；移除只收回紀錄原文恰好一處命中的行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;fontStyle=1;align=left;spacingLeft=6;" vertex="1" parent="C4"><mxGeometry x="20" y="446" width="340" height="70" as="geometry"/></mxCell><mxCell id="ignored" value="不碰：使用者的 .gitignore（除非工具宣告 append 且你同意）、.git 本身" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="C4"><mxGeometry x="20" y="556" width="340" height="70" as="geometry"/></mxCell><mxCell id="e1" value="共同祖先" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="base" target="ini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="來源與納管狀態" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="meta" target="ini"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="插入行原文" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="dock_rec" target="rd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="逐檔指紋" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="stamp" target="cache"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="c-a4" name="A4 出貨側"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="A4 出貨側" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="28" as="geometry"/></mxCell><mxCell id="question" value="工具怎麼從 dist/ 變成 image？VK 自己怎麼從 build 變成 Release 資產？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1200" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 2、7、9、10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="S" value="使用者 repo（出貨）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="440" height="710" as="geometry"/></mxCell><mxCell id="dfiles" value="dist/files/：全部出貨內容（無 symlink、文字檔 LF）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="20" y="46" width="180" height="70" as="geometry"/></mxCell><mxCell id="dinit" value="dist/init.toml：初始檔清單（copy／append）" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="240" y="46" width="180" height="70" as="geometry"/></mxCell><mxCell id="djust" value="dist/just/&amp;lt;ns&amp;gt;.just：每檔一個命名空間，含 _sync" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="20" y="156" width="180" height="70" as="geometry"/></mxCell><mxCell id="dfile" value="Dockerfile.dist：FROM scratch + LABEL + COPY dist/" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="240" y="156" width="180" height="70" as="geometry"/></mxCell><mxCell id="s1" value="CI：check.sh --dist 驗佈局與 init.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="130" y="276" width="180" height="60" as="geometry"/></mxCell><mxCell id="s2" value="佈局合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="S"><mxGeometry x="130" y="376" width="180" height="80" as="geometry"/></mxCell><mxCell id="s2n" value="1：不得推出" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="S"><mxGeometry x="20" y="506" width="160" height="60" as="geometry"/></mxCell><mxCell id="s3" value="buildx 一次出 amd64 + arm64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#ffffff);fontSize=11;" vertex="1" parent="S"><mxGeometry x="240" y="496" width="180" height="60" as="geometry"/></mxCell><mxCell id="s4" value="兩平台位元組一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="S"><mxGeometry x="240" y="596" width="180" height="80" as="geometry"/></mxCell><mxCell id="s4n" value="1：不得推出" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="S"><mxGeometry x="20" y="606" width="160" height="60" as="geometry"/></mxCell><mxCell id="R" value="registry" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="500" y="70" width="300" height="710" as="geometry"/></mxCell><mxCell id="it" value="工具 image &amp;lt;repo&amp;gt;-dist:&amp;lt;tag&amp;gt;@digest（純資料，只搬不跑）" style="rounded=1;wh