<diagram id="c-f8" name="F8 反向與清理"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="F8 反向與清理" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1560" height="28" as="geometry"/></mxCell><mxCell id="question" value="remove／uninstall 收回什麼、留下什麼？prune 清哪些本機資源？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1560" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 1、4、8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="R" value="remove &amp;lt;repo&amp;gt;（兩段骨架見 F1）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1800" height="370" as="geometry"/></mxCell><mxCell id="U" value="uninstall" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="1800" height="370" as="geometry"/></mxCell><mxCell id="P" value="prune：獨立分支，只清本機資源，不碰 repo 檔、不碰進 git 的檔" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="1800" height="370" as="geometry"/></mxCell><mxCell id="r0" value="just vendor_kit remove &amp;lt;repo&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="R"><mxGeometry x="20" y="46" width="160" height="60" as="geometry"/></mxCell><mxCell id="r1" value="已導入？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="R"><mxGeometry x="220" y="36" width="160" height="80" as="geometry"/></mxCell><mxCell id="rx1" value="0：未導入，只提示" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="R"><mxGeometry x="220" y="166" width="160" height="60" as="geometry"/></mxCell><mxCell id="r2" value="本機覆寫中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="R"><mxGeometry x="420" y="36" width="160" height="80" as="geometry"/></mxCell><mxCell id="rx2" value="1：請先 undev" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="R"><mxGeometry x="420" y="166" width="160" height="60" as="geometry"/></mxCell><mxCell id="r3" value="CI 模式且需改進 git 的檔？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="R"><mxGeometry x="620" y="36" width="160" height="80" as="geometry"/></mxCell><mxCell id="rx3" value="1：印清單" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="R"><mxGeometry x="620" y="166" width="160" height="60" as="geometry"/></mxCell><mxCell id="r4" value="--dry-run？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="R"><mxGeometry x="820" y="36" width="160" height="80" as="geometry"/></mxCell><mxCell id="rx4" value="0：只印會刪、會問什麼" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="R"><mxGeometry x="820" y="166" width="160" height="60" as="geometry"/></mxCell><mxCell id="r5" value="建進度檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="R"><mxGeometry x="1020" y="46" width="160" height="60" as="geometry"/></mxCell><mxCell id="r6" value="紀錄的 append 行：同意刪？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" ve