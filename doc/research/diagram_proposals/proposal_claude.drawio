<diagram id="c-f4" name="F4 upgrade 工具"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="F4 upgrade 工具" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1360" height="28" as="geometry"/></mxCell><mxCell id="question" value="升一個工具：目標版怎麼定？初始檔怎麼逐檔合併？怎麼退回舊版？" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="36" width="1360" height="24" as="geometry"/></mxCell><mxCell id="inv" value="服務不變量 1、4、8、10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="10" width="220" height="44" as="geometry"/></mxCell><mxCell id="R" value="resolve：決定目標版（不寫檔）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1600" height="250" as="geometry"/></mxCell><mxCell id="P" value="apply：逐檔狀態機（拿鎖、重驗、建進度檔見 F1）" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1600" height="370" as="geometry"/></mxCell><mxCell id="W" value="apply：收尾" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1400" height="250" as="geometry"/></mxCell><mxCell id="B" value="退版" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f5f5f5;fontSize=12;fontStyle=1;horizontal=1;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1000" height="250" as="geometry"/></mxCell><mxCell id="s" value="just vendor_kit upgrade &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11