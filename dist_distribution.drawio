;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="170" height="30" as="geometry"/></mxCell><mxCell id="p7_tv4" value="GitHub 的 image 倉庫／打包好可執行的檔案包／打 tag 時自動 build 並 push 的流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="870" width="900" height="30" as="geometry"/></mxCell><mxCell id="p7_tk5" value=".version / justfile / init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="170" height="30" as="geometry"/></mxCell><mxCell id="p7_tv5" value="專案記工具版本的檔／專案的指令入口（啟動器）／工具給的初始檔清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="900" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>