metry"/></mxCell><mxCell id="g_vk" value="vendor_kit:v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="40" y="70" width="220" height="50" as="geometry"/></mxCell><mxCell id="g_tool" value="tool-dist:v0.1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="40" y="370" width="220" height="50" as="geometry"/></mxCell><mxCell id="g_n" value="原型只 build 到本機；正式版由 CI 在打 tag 時 push 到 GHCR" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="ghcr"><mxGeometry x="10" y="450" width="280" height="40" as="geometry"/></mxCell><mxCell id="r_proj" value="專案 repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="100" width="340" height="490" as="geometry"/></mxCell><mxCell id="r_proj_t" value="= proto/project/" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="r_proj"><mxGeometry x="10" y="40" width="320" height="18" as="geometry"/></mxCell><mxCell id="f_ver" value=".version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="20" y="70" width="140" height="40" as="geometry"/></mxCell><mxCell id="f_just" value="justfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="180" y="70" width="140" height="40" as="geometry"/></mxCell><mxCell id="f_user" value="Dockerfile、設定檔（setup.toml）…&lt;br&gt;（init 建立後歸使用者）" sty