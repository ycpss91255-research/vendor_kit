"><mxGeometry x="20" y="80" width="130" height="60" as="geometry"/></mxCell><mxCell id="tb_r0c1" value="第一次、或改了 Dockerfile 之後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="80" width="200" height="60" as="geometry"/></mxCell><mxCell id="tb_r0c2" value="建置專案自己的 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="80" width="330" height="60" as="geometry"/></mxCell><mxCell id="tb_r0c3" value=".&amp;lt;name&amp;gt;/ 的 build 腳本 → docker compose build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="80" width="300" height="60" as="geometry"/></mxCell><mxCell id="tb_r0c4" value="本機 image（不在 repo 裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="80" width="260" height="60" as="geometry"/></mxCell><mxCell id="tb_r1c0" value="just &amp;lt;模組&amp;gt; run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="140" width="130" height="60" as="geometry"/></mxCell><mxCell id="tb_r1c1" value="要開始工作時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="140" width="200" height="60" as="geometry"/></mxCell><mxCell id="tb_r1c2" value="啟動專案容器（在背景常駐）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="140" width="330" height="60" as="geometry"/></mxCell><mxCell id="tb_r1c3" value=".&amp;lt;name&amp;gt;/ 的 run 腳本 → docker compose up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="140" width="300" height="60" as="geometry"/></mxCell><mxCell id="tb_r1c4" value="容器（不在 repo 裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="140" width="260" height="60" as="geometry"/></mxCell><mxCell id="tb_r2c0" value="just &amp;lt;模組&amp;gt; exec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="200" width="130" height="60" as="geometry"/></mxCell><mxCell id="tb_r2c1" value="容器跑著的時候" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="200" width="200" height="60" as="geometry"/></mxCell><mxCell id="tb_r2c2" value="進到容器裡下指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="200" width="330" height="60" as="geometry"/></mxCell><mxCell id="tb_r2c3" value=".&amp;lt;name&amp;gt;/ 的 exec 腳本 → docker compose exec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="200" width="300" height="60" as="geometry"/></mxCell><mxCell id="tb_r2c4" value="無" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="200" width="260" height="60" as="geometry"/></mxCell><mxCell id="tb_r3c0" value="just &amp;lt;模組&amp;gt; stop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="260" width="130" height="60" as="geometry"/></mxCell><mxCell id="tb_r3c1" value="收工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="260" width="200" height="60" as="geometry"/></mxCell><mxCell id="tb_r3c2" value="停掉並移除容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="260" width="330" height="60" as="geometry"/></mxCell><mxCell id="tb_r3c3" value=".&amp;lt;name&amp;gt;/ 的 stop 腳本 → docker compose down" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="260" width="300" height="60" as="geometry"/></mxCell><mxCell id="tb_r3c4" value="容器（移除）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="260" width="260" height="60" as="geometry"/></mxCell><mxCell id="tb_r4c0" value="（自動）&lt;br&gt;just vendor_kit ensure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="320" width="130" height="60" as="geometry"/></mxCell><mxCell id="tb_r4c1" value="每個工具指令執行前" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="320" width="200" height="60" as="geometry"/></mxCell><mxCell id="tb_r4c2" value="工具的 recipe 開頭先呼叫 just vendor_kit ensure：先對專案目錄上鎖 → 印記第一行 ≠ 有效版本（.version.local 優先於 .version）→ install；相同 → verify（.&amp;lt;name&amp;gt;/ 跟 image 內的 dist 逐檔比）；失敗就中止；本機路徑 → 只印警告" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="320" width="330" height="60" as="geometry"/></mxCell><mxCell id="tb_r4c3" value="vendor_kit 容器：install 或 verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="320" width="300" height="60" as="geometry"/></mxCell><mxCell id="tb_r4c4" value=".&amp;lt;name&amp;gt;/（可能重裝）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="320" width="260" height="60" as="geometry"/></mxCell><mxCell id="gB_n" value="為什麼是這四個：它們是「一個容器的一生」— 做出來（build）→ 開起來（run）→ 進去用（exec）→ 關掉（stop），一個階段一個指令。這四個是工具定義的，vendor_kit 只負責把工具裝好；換一個工具，這一區的指令就換一套。&lt;br&gt;每個工具指令前後都可以掛你自己的腳本：script/hooks/pre/&amp;lt;指令&amp;gt;.sh、post/&amp;lt;指令&amp;gt;.sh（init 建立的空殼）。verify 不開放單獨打：它是每個指令前的守門。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="gB"><mxGeometry x="20" y="390" width="1220" height="66" as="geometry"/></mxCell><mxCell id="gA" value="不常用（第一次／升級／開發工具本身）：vendor_kit 提供的指令，每個用這套框架的專案都一樣" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1