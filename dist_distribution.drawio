1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="1070" width="120" height="40" as="geometry"/></mxCell><mxCell id="p1_lgt" value="實線 = 傳輸內容（線上文字 = 傳什麼）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="1060" width="300" height="60" as="geometry"/></mxCell><mxCell id="p1_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1146" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1_tk0" value="vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv0" value="通用安裝工具；只以 container 形態執行（開發、使用皆是），主機不需安裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk1" value="image / container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv1" value="image = 打包好的程式與檔案；container = image 執行起來的實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk2" value="&amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv2" value="工具名，由專案的 .version 指定；安裝目錄就叫 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk3" value="install / init / verify / diff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv3" value="四個子命令：安裝 dist 到 .&amp;lt;name&amp;gt;/／第一次建立使用者檔／檢查 .&amp;lt;name&amp;gt;/ 沒被改／升級後比對模板差異" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk4" value="結束狀態" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv4" value="程式結束時回報成功或失敗，啟動器據此決定要不要繼續執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk5" value="模組" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv5" value="vendor_kit 內部的功能分塊；同一個 container 裡，不是各自的 container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk6" value="dist/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv6" value="工具 repo 裡要出貨的那批檔案，全部寫進專案的 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk7" value="init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv7" value="工具 repo 提供的清單：init 時要複製到專案的初始檔有哪些、放哪（dist/ 本身每次 upgrade 都整包覆蓋）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk8" value="印記檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv8" value=".&amp;lt;name&amp;gt;/.stamp：版本 + 每個檔案的指紋；verify 用它判斷有沒有被手改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk9" value="指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv9" value="由檔案內容算出的一串碼（sha256）；內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk10" value="模板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv10" value="工具 dist/ 裡給初始檔用的樣板（例如 Dockerfile 範本）；渲染 = 帶入變數（專案名等）產生實際檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1b" name="2. 框架定義"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1810" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="框架定義：兩種 repo 各自必須有什麼，以及工具怎麼送到專案" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="tool" value="工具 repo（每個要出貨的工具一個）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="320" height="260" as="geometry"/></mxCell><mxCell id="t_t" value="工具名 = &amp;lt;name&amp;gt;；下面四樣是接上 vendor_kit 的必要條件" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="tool"><mxGeometry x="10" y="40" width="300" height="30" as="geometry"/></mxCell><mxCell id="t_dist" value="dist/&lt;br&gt;（要出貨的全部）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="20" y="80" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_init" value="init.toml&lt;br&gt;（初始檔清單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="165" y="80" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_df" value="Dockerfile.dist&lt;br&gt;（FROM vendor_kit）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="20" y="145" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_ci" value="CI：打 tag →&lt;br&gt;build + push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="165" y="145" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_n" value="其他內容（doc、test、CI 腳本…）不在 dist/ 裡，不會出貨" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="tool"><mxGeometry x="10" y="205" width="300" height="40" as="geometry"/></mxCell><mxCell id="vk" value="vendor_kit repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillC