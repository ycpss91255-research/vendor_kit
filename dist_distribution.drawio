d" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bB"><mxGeometry x="60" y="70" width="180" height="50" as="geometry"/></mxCell><mxCell id="b_l1" value="讀 .version&lt;br&gt;（一行一個工具，逐行做）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="bB"><mxGeometry x="380" y="75" width="140" height="40" as="geometry"/></mxCell><mxCell id="b_note" value=".version 一行 = 一個工具，key = 工具名：&lt;br&gt;&amp;lt;name&amp;gt; = &quot;…-dist:vX@sha256:…&quot; → .&amp;lt;name&amp;gt;/&lt;br&gt;&amp;lt;name2&amp;gt; = &quot;…&quot; → .&amp;lt;name2&amp;gt;/&lt;br&gt;每一行各跑一次右邊的流程；&lt;br&gt;.&amp;lt;name&amp;gt;/.stamp 第一行記的是裝了哪個 image" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bB"><mxGeometry x="40" y="135" width="290" height="100" as="geometry"/></mxCell><mxCell id="b_l2" value=".&amp;lt;name&amp;gt;/.stamp 第一行&lt;br&gt;= .version 那一行？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="bB"><mxGeometry x="550" y="55" width="180" height="80" as="geometry"/></mxCell><mxCell id="b_c0" value="install&lt;br&gt;換成 .version 指定的版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="bB"><mxGeometry x="800" y="65" width="340" height="60" as="geometry"/></mxCell><mxCell id="b_l1n" value="（image 不在本機時，Docker 會先下載）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="bB"><mxGeometry x="340" y="118" width="220" height="24" as="geometry"/></mxCell><mxCell id="b_p0" value=".&amp;lt;name&amp;gt;/（換新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,