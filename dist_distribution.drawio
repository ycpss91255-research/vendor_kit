;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_u4" target="c_c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_u3" target="c_u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce7" value="寫入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_c3" target="c_p3"><mxGeometry x="-0.7" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce5" value="印出差異" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bC" source="c_c2" target="c_u3"><mxGeometry x="0.4" relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="258"/><mxPoint x="300" y="258"/></Array></mxGeometry></mxCell><mxCell id="p2n" value="紫框 = 子命令：install（第一次、版本改變時）、init（只有第一次）、verify（已安裝且版本一致時）、diff／accept（升級後由使用者呼叫）。&lt;br&gt;沒有 Renovate 時用 just vendor_kit upgrade 手動：改 .version → 立即 install → diff（細節待議）。&lt;br&gt;同一專案兩個 just 同時跑：容器先對專案目錄上鎖，後到的等前一個裝完再檢查（第 5 頁）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1240" width="1620" height="60" as="geometry"/></mxCell><mxCell id="p2_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="220" height="60" as="geometry"/></mxCell><mxCell id="p2_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1320" width="110" height="60" as="geometry"/></mxCell><mxCell id="p2_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1330" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1330" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1330" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="1330" width="88" height="40" as="geometry"/></mxCell><mxCell id="p2_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="1330" width="170" height="40" as="geometry"/></mxCell><mxCell id="p2_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="1330" width="130" height="40" as="geometry"/></mxCell><mxCell id="p2_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）&lt;br&gt;虛線 = 之後才會發生" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="1320" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1406" width="200" height="20" as="geometry"/></mxCell><mxCell id="p2_tk0" value="啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv0" value="專案裡的 .vendor_kit/（vendor_kit 寫出的標準 just 指令；justfile 只是引用它）：使用者打 just 時，它讀版本檔、起安裝容器、再執行工具的腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1430" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk1" value="上鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv1" value="容器先對專案目錄上鎖：兩個 just 同時跑時，後到的等前一個裝完再檢查，避免同時改同一個 .&amp;lt;name&amp;gt;/（第 5 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1460" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk2" value="印記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv2" value=".&amp;lt;name&amp;gt;/.stamp：install 寫下的「第一行 = 裝的 image，之後每行 = 一個檔的指紋」；啟動器只拿第一行判斷要不要重裝，內容以 image 內的 dist 為準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1490" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk3" value="基準 / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv3" value=".vendor_kit/baseline/&amp;lt;name&amp;gt;/ = 上次確認過的模板副本；diff 靠它分出工具改了什麼、你改了什麼；just vendor_kit accept &amp;lt;name&amp;gt; 把新版模板存成基準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1520" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk4" value=".version.local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1550" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv4" value="跟 .version 同格式、不進 git 的覆蓋檔；開發工具本身時用（第 4 頁），平常沒有這個檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1550" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk5" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv5" value="GitHub 上的機器人：GHCR 有新版就自動開 PR 改 .version；沒有它時用 just vendor_kit upgrade 手動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1580" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk6" value="docker compose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv6" value="工具腳本最後真正拿來建置／啟動／進入／停止專案容器的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1610" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk7" value="build / run / exec / stop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv7" value="四個日常指令：建置 image／啟動容器／進入容器／停止容器；都先經過同樣的檢查再執行 .&amp;lt;name&amp;gt;/ 內的腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1640" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk8" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv8" value="專案裡的版本清單（TOML）：一個工具一行 &amp;lt;name&amp;gt; = &quot;image&quot;；&amp;lt;name&amp;gt; 決定安裝目錄 .&amp;lt;name&amp;gt;/ 和要比對哪個印記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1670" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk9" value="install / init / verify / diff / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv9" value="子命令：安裝 dist 到 .&amp;lt;name&amp;gt;/ 並寫印記／第一次建立初始檔／拿 .&amp;lt;name&amp;gt;/ 跟 image 內的 dist 比／升級後三方比對／存新基準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1700" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk10" value="sha256 / 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv10" value="image 的內容指紋（跟在 @ 後面，鎖定內容）／容器 = image 執行起來的實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1730" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk11" value="PR / merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv11" value="GitHub 上的合併請求／接受它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1760" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk12" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv12" value="GitHub 的 image 倉庫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1790" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk13" value="dist / image / 模板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1820" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv13" value="dist = 工具要出貨的檔案；image = 打包好可執行的檔案包；模板 = dist 裡給初始檔用的樣板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1820" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk14" value="just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1850" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv14" value="主機上的指令跑器；使用者打 just &amp;lt;指令&amp;gt;，它照 justfile 執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1850" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk15" value="init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1880" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv15" value="工具提供的清單：init 時要複製到專案的初始檔有哪些、放哪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1880" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk16" value="entrypoint / hooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1910" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv16" value="初始檔的例子：容器啟動腳本／各指令前後可掛的自訂腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1910" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk17" value="&amp;lt;name&amp;gt; / 指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1940" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv17" value="&amp;lt;name&amp;gt; = .version 裡的工具名，安裝目錄就叫 .&amp;lt;name&amp;gt;/；指紋 = 由檔案內容算出的識別碼，內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1940" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk18" value="vendor_kit / Dockerfile / TOML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1970" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv18" value="安裝工具本身（在容器內跑）／打包 image 的食譜、也是專案自己的 image 食譜／設定檔格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1970" width="900" height="30" as="geometry"/></mxCell><mxCell id="p2_tk19" value="just vendor_kit upgrade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2000" width="170" height="30" as="geometry"/></mxCell><mxCell id="p2_tv19" value="手動升級指令：改 .version → 立即 install → diff（細節待議）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="2000" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. 流程：版本生命週期"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="1510" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程：版本生命週期" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="30" as="geometry"/></mxCell><mxCell id="up" value="升級（摘要；四條路徑見第 11 頁）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;"