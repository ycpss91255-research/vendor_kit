實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="930" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv4" value="GitHub 提供的 image 倉庫；每個工具一個 &amp;lt;name&amp;gt;-dist image，以 vendor_kit image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="960" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk5" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv5" value="專案裡的 TOML 檔，一個工具一行 name = &quot;image:tag@sha256:…&quot;；name 決定安裝目錄 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk6" value="CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv6" value="放在 GitHub 上的自動化流程：打 tag 時 build image 並上傳 GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1020" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk7" value="just / justfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv7" value="just 是主機上的指令跑器；justfile 是專案裡給它讀的指令清單，也就是啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1050" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk8" value="印記檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv8" value=".&amp;lt;name&amp;gt;/.stamp：安裝時寫下「版本 + 每檔指紋」，之後用來檢查有沒有被手改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1080" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk9" value="tag / digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv9" value="image 的版本名稱（v0.43.0）／內容指紋（sha256:…，鎖多架構 index）；.version 兩者都記，工具只認 digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk10" value="Dockerfile / Dockerfile.dist / FROM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv10" value="Dockerfile = 打包 image 的食譜；Dockerfile.dist = 工具 repo 出貨用的食譜；FROM = 食譜第一行，指定以哪個 image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1140" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk11" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv11" value="git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk12" value="compose 指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv12" value="docker compose：依設定檔啟動專案容器的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk13" value="TOML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv13" value="一種設定檔格式（key = &quot;value&quot;）；.version、init.toml 都用它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. 流程：使用者指令"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程：使用者下的每個指令 → 啟動器叫哪個子命令 → 專案裡發生什麼" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="h_40" value="使用者" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="24" as="geometry"/></mxCell><mxCell id="h_380" value="啟動器（justfile，在主機）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="h_800" value="安裝容器（vendor_kit）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="h_1240" value="專案目錄（安裝目錄 .&amp;lt;name&amp;gt;/）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="380" height="24" as="geometry"/></mxCell><mxCell id="bA" value="第一次接上工具：just init" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1620" height=