"/></mxCell><mxCell id="m_diff" value="diff.py&lt;br&gt;差異比對" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=11;strokeWidth=1;" vertex="1" parent="d_src"><mxGeometry x="104" y="91" width="86" height="40" as="geometry"/></mxCell><mxCell id="m_report" value="report.py&lt;br&gt;回報" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=11;strokeWidth=1;" vertex="1" parent="d_src"><mxGeometry x="196" y="91" width="86" height="40" as="geometry"/></mxCell><mxCell id="d_test" value="test/（先分測試工具、再分層級）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="repo"><mxGeometry x="20" y="200" width="380" height="703" as="geometry"/></mxCell><mxCell id="t_env" value="env/check.sh&lt;br&gt;環境檢查：Python、tomllib、進入點、toml-bridge 都能跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="d_test"><mxGeometry x="12" y="45" width="356" height="44" as="geometry"/></mxCell><mxCell id="t_fix" value="fixtures/&lt;br&gt;假的 dist/、init.toml、VERSION、假專案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d_test"><mxGeometry x="12" y="110" width="356" height="44" as="geometry"/></mxCell><mxCell id="t_lint" value="lint/{ruff, import-linter}/ + mirror_check.py + blackbox_check.py&lt;br&gt;寫法檢查、import 分層契約、鏡射檢查、黑箱檢查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="d_test"><mxGeometry x="12" y="207" width="356" height="44" as="geometry"/></mxCell><mxCell id="t_unit" value="pytest/unit/&lt;br&gt;test_&amp;lt;模組&amp;gt;.py ×7（一個模組一個檔）" style="rounded=1;whiteSp