alue="整個 image 測試：docker run 每個子命令（CI 主機跑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="680" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n16" value="pytest/acceptance/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="72" y="722" width="348" height="38" as="geometry"/></mxCell><mxCell id="vk_d16" value="驗收測試：在假專案裡真的打 just（CI 主機跑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="722" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n17" value="fixtures/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="72" y="764" width="348" height="38" as="geometry"/></mxCell><mxCell id="vk_d17" value="測試用假資料：假 dist/、init.toml、VERSION、假專案（project/）、假工具 image 食譜（tool_image/）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="764" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n18" value="doc/adr/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="46" y="806" width="374" height="38" as="geometry"/></mxCell><mxCell id="vk_d18" value="設計決策紀錄：一個決策一個 Markdown 檔（例：測試分層與閘門）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="806" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n19" value="Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="46" y="848" width="374" height="38" as="geometry"/></mxCell><mxCell id="vk_d19" value="打包食譜：runtime → env-test → test-base → 各測試 stage；runtime → release（第 8 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="848" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n20" value="docker-bake.hcl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="46" y="890" width="374" height="38" as="geometry"/></mxCell><mxCell id="vk_d20" value="一次跑多個 stage 的清單：group validate（測試）、group release（出貨）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="890" width="560" height="38" as="geometry"/></mxCell><mxCell id="vk_n21" value=".github/workflows/ci.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_vk"><mxGeometry x="46" y="932" width="374" height="38" as="geometry"/></mxCell><mxCell id="vk_d21" value="CI：推送就跑 bake validate → system/acceptance → bake release" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="430" y="932" width="560" height="38" as="geometry"/></mxCell><mxCell id="r_tool" value="工具 repo（每個工具一個）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="760" height="322" as="geometry"/></mxCell><mxCell id="tl_n0" value="&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="20" y="50" width="300" height="38" as="geometry"/></mxCell><mxCell id="tl_d0" value="任何要透過 vendor_kit 出貨的工具的原始碼 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="50" width="420" height="38" as="geometry"/></mxCell><mxCell id="tl_n1" value="dist/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="46" y="92" width="274" height="38" as="geometry"/></mxCell><mxCell id="tl_d1" value="要出貨的全部（腳本、Dockerfile 範本、模板、hooks 空殼），整包裝進專案的工具目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="92" width="420" height="38" as="geometry"/></mxCell><mxCell id="tl_n2" value="init.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="46" y="134" width="274" height="38" as="geometry"/></mxCell><mxCell id="tl_d2" value="清單：dist/ 裡哪些檔在 init 時要再複製到專案哪裡（TOML）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="134" width="420" height="38" as="geometry"/></mxCell><mxCell id="tl_n3" value="Dockerfile.dist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="46" y="176" width="274" height="38" as="geometry"/></mxCell><mxCell id="tl_d3" value="出貨食譜：FROM vendor_kit，疊上 dist/ 與 init.toml → &amp;lt;name&amp;gt;-dist image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="176" width="420" height="38" as="geometry"/></mxCell><mxCell id="tl_n4" value=".github/workflows/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="46" y="218" width="274" height="38" as="geometry"/></mxCell><mxCell id="tl_d4" value="CI：打 tag 時建置 &amp;lt;name&amp;gt;-dist image 並上傳 GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="218" width="420" height="38" as="geometry"/></mxCell><mxCell id="tl_n5" value="doc/  test/  …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_tool"><mxGeometry x="46" y="260" width="274" height="38" as="geometry"/></mxCell><mxCell id="tl_d5" value="工具自己的文件、測試等；不在 dist/ 裡，不會出貨" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_tool"><mxGeometry x="330" y="260" width="420" height="38" as="geometry"/></mxCell><mxCell id="r_proj" value="專案 repo（使用工具的）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="422" width="760" height="490" as="geometry"/></mxCell><mxCell id="pj_n0" value="&amp;lt;專案&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="20" y="50" width="300" height="38" as="geometry"/></mxCell><mxCell id="pj_d0" value="使用工具的專案；使用者天天工作的地方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="50" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n1" value=".version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="92" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d1" value="進 git｜工具版本清單：一行一個工具 &amp;lt;name&amp;gt; = &quot;image&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="92" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n2" value="justfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="134" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d2" value="進 git｜使用者的指令清單：第一行 mod? vendor_kit &#x27;.vendor_kit/vendor.just&#x27;，其餘自己加（第 9 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="134" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n3" value=".vendor_kit/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="176" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d3" value="進 git｜啟動器本體：vendor.just、tools.just、.stamp（vendor_kit 寫出，人不改，升級只換這三個）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="176" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n4" value="baseline/&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="72" y="218" width="248" height="38" as="geometry"/></mxCell><mxCell id="pj_d4" value="進 git｜三方比對的基準：init／accept 存的模板副本＋記下是哪個 image；人不改（納入檢查）；升級不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="218" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n5" value=".version.local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="260" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d5" value="不進 git｜本機開發用的覆蓋檔：&amp;lt;name&amp;gt; = &quot;path:../tool&quot;，有它那行就優先（第 4 頁）；平常沒有這個檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="260" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n6" value="Dockerfile  setup.toml  …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="302" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d6" value="進 git｜使用者檔案：init 從模板建立，之後歸使用者維護" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="302" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n7" value="script/hooks/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="344" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d7" value="進 git｜使用者的掛勾腳本：每個工具指令前後自動執行（init 建立的空殼）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="344" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n8" value=".&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="386" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d8" value="不進 git｜工具的 dist/ 整包 + .stamp 印記；每次升級整批換新，不可手改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="386" width="420" height="38" as="geometry"/></mxCell><mxCell id="pj_n9" value=".&amp;lt;name2&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="r_proj"><mxGeometry x="46" y="428" width="274" height="38" as="geometry"/></mxCell><mxCell id="pj_d9" value="不進 git｜另一個工具的，同上" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="r_proj"><mxGeometry x="330" y="428" width="420" height="38" as="geometry"/></mxCell><mxCell id="p10_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="200" height="60" as="geometry"/></mxCell><mxCell id="p10_lg1" value="綠：使用框架的 repo" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1104" width="200" height="60" as="geometry"/></mxCell><mxCell id="p10_lg2" value="實線框：資料夾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="480" y="1114" width="120" height="40" as="geometry"/></mxCell><mxCell id="p10_lg3" value="虛線框：檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="1114" width="120" height="40" as="geometry"/></mxCell><mxCell id="p10_lgt" value="右欄 = 用途／放什麼類型的東西" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="760" y="1104" width="300" height="60" as="geometry"/></mxCell><mxCell id="p10_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="200" height="20" as="geometry"/></mxCell><mxCell id="p10_tk0" value="repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1214" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv0" value="一個 git 管理的專案資料夾；這頁的三種：我們開發的、工具的、使用工具的專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1214" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk1" value="進 git／不進 git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1244" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv1" value="進 git = 這個檔會被版本管理、跟著 repo 走；不進 git = 不由 git 保存、只在這台機器，隨時可刪掉重裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1244" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk2" value="image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1274" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv2" value="打包好可執行的檔案包；vendor_kit repo 只有 src/ 會進最終出貨的 image，測試只進測試用的 stage 或在 CI 主機跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1274" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk3" value="TOML / tomllib / VERSION / pytest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1304" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv3" value="設定檔格式（.version、init.toml）／Python 讀 TOML 的內建程式庫／image 內給人看的識別字串（印記第一行改由啟動器用 --self 傳入的 .version 字串，issue #23）／Python 測試框架" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1304" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk4" value="ruff / import-linter / 鏡射 / 黑箱 / 記下是哪個 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1334" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv4" value="Python 寫法檢查／檢查模組之間誰能引用誰／每個模組必有對應測試檔／system、acceptance 測試不准引用 vendor_kit 程式／基準旁邊記的來源 image 與每檔指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1334" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk5" value="tag / GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1364" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv5" value="tag = 給 repo 打的版本記號（v1.2.0），CI 看到就出貨／GHCR = GitHub 的 image 倉庫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1364" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk6" value="hooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1394" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv6" value="掛勾腳本：每個工具指令前（pre）後（post）自動執行的使用者腳本，init 建立空殼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1394" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk7" value="原子替換 / 純函式 / 引用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1424" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv7" value="整批一次換掉，不會出現半新半舊／只算結果、不碰檔案與網路的程式／一個程式 import（引用）另一個程式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1424" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk8" value="測試層級名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1454" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv8" value="smoke = 環境能跑；lint = 不執行的檢查；unit = 單一模組；integration = 一個子命令走到底；system = 整個 image；acceptance = 真的打 just（第 8 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1454" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk9" value="conftest.py / fixtures" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1484" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv9" value="pytest 每個目錄的共用設定（這裡用來強制限制）／測試用的假資料" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1484" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk10" value="ADR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1514" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv10" value="設計決策紀錄（Architecture Decision Record）：為什麼這樣決定，一個檔一個決策" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1514" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk11" value="Dockerfile / stage / bake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1544" width="170" height="30" as="geometry"/></mxCell><mxCell id="p10_tv11" value="打包 image 的食譜／食譜裡的一個階段／一次建多個階段的清單工具" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1544" width="900" height="30" as="geometry"/></mxCell><mxCell id="p10_tk12" value="CI" style="rounded=0;whiteSpace=wrap;html=