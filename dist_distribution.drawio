trokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="40" y="50" width="230" height="50" as="geometry"/></mxCell><mxCell id="s_env" value="env-test（環境檢查，smoke）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="40" y="247" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_tb" value="test-base = env-test + pytest + fixtures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="40" y="312" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_grp" value="六個測試 stage（都 FROM test-base）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="20" y="372" width="440" height="364" as="geometry"/></mxCell><mxCell id="s_lint" value="lint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="37" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_unit" value="unit-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="92" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_inst" value="install-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="147" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_init" value="init-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="202" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_ver" value="verify-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="257" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_diff" value="diff-test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="s_grp"><mxGeometry x="20" y="312" width="230" height="40" as="geometry"/></mxCell><mxCell id="s_rel" value="release&lt;br&gt;= runtime（最終產物）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="40" y="760" width="230" height="50" as="geometry"/></mxCell><mxCell id="s_rtest" value="release-test&lt;br&gt;FROM release；真的 install + verify 一次" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="stages"><mxGeometry x="40" y="850" width="230" height="60" as="geometry"/></mxCell><mxCell id="s_host" value="system / acceptance 不在 Dockerfile 裡：&lt;br&gt;它們要 docker run，所以在 CI 主機上跑" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="stages"><mxGeometry x="20" y="925" width="440" height="40" as="geometry"/></mxCell><mxCell id="s_bake" value="docker-bake.hcl：group validate = [env-test, lint, unit-test, install-test,&lt;br&gt;init-test, verify-test, diff-test（accept-test 待補）]；group release = [release, release-test]" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="stages"><mxGeometry x="20" y="965" width="440" height="40" as="geometry"/></mxCell><mxCell id="s1" value="FROM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s_rt" target="s_env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s1b" value="FROM（環境不對 → 到此為止）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s_env" target="s_tb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s2" value="FROM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3068;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s_tb" target="s_grp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s8" value="FROM
（不經任何 test stage）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="stages" source="s_rt" target="s_rel"><mxGeometry x="0.785" relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="75"/><mxPoint x="475" y="785"/></Array></mxGeometry></mxCell><mxCell id="s9" value="FROM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s_rel" target="s_rtest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_env" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_env" target="s_env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_tb" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_fix" target="s_tb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_lint" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_lint" target="s_lint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_unit" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_unit" target="s_unit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_inst" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_inst" target="s_inst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_init" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_init" target="s_init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_ver" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_ver" target="s_ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_diff" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_diff" target="s_diff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gates" value="強制閘門（不靠提醒；違反就 CI 紅，依層分組）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="460" height="1130" as="geometry"/></mxCell><mxCell id="ge" value="smoke = 先確認環境能跑，再談測試（env-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="50" width="420" height="104" as="geometry"/></mxCell><mxCell id="g0" value="環境檢查先於一切&lt;br&gt;test-base FROM env-test：Python、tomllib、進入點、toml-bridge 任一不對，六個測試 stage 都不會跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="ge"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gl" value="lint 層 = 不執行程式的檢查（lint stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="164" width="420" height="232" as="geometry"/></mxCell><mxCell id="g_ruff" value="ruff&lt;br&gt;程式碼寫法檢查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g2" value="import-linter 分層契約&lt;br&gt;只能由上層 import 下層（命令介面 → 讀取／存取 → 純函式）；只有 repo_fs、dist_reader 能碰檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g3" value="鏡射檢查&lt;br&gt;每個 src 模組必有 test_&amp;lt;模組&amp;gt;.py，缺一個就失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="168" width="400" height="56" as="geometry"/></mxCell><mxCell id="gu" value="unit 層 = 一次測一個模組（unit-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="406" width="420" height="104" as="geometry"/></mxCell><mxCell id="g4" value="unit conftest&lt;br&gt;測試中一碰檔案、網路、Docker 就直接失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gu"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gi" value="integration 層 = 一個子命令走到底（一個子命令一個 stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="520" width="420" height="232" as="geometry"/></mxCell><mxCell id="g5" value="integration conftest&lt;br&gt;只給臨時目錄；禁 Docker、網路；只能走 cli.main()（程式的正門）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g6" value="一個子命令一個 stage&lt;br&gt;各自只 COPY 自己的測試檔；哪個 stage 紅 = 第 5 頁哪條泳道壞（accept-test 待補）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g7" value="時間預算&lt;br&gt;verify 200 個檔必須 &amp;lt; 0.5 秒（量容器內的函式，不含起容器；每次 just 都會跑它）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="168" width="400" height="56" as="geometry"/></mxCell><mxCell id="gs" value="system = 整個 image；acceptance = 真的打 just（CI 主機）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="762" width="420" height="104" as="geometry"/></mxCell><mxCell id="g8" value="黑箱檢查（lint stage）＋ conftest&lt;br&gt;測試檔不准 import vendor_kit；只准 docker run／just 與檔案系統" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gs"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gr" value="release = 出貨（release / release-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="876" width="420" height="168" as="geometry"/></mxCell><mxCell id="g1" value="BuildKit stage 依賴&lt;br&gt;release 只 FROM runtime → 測試碼、pytest 進不了產品 image；release 同時 build amd64 + arm64（multi-arch）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g9" value="release 必過 release-test&lt;br&gt;release image 真的 install + verify 一次，失敗就不上傳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g_map" value="對應：unit ↔ 第 1 頁模組；integration ↔ 第 5 頁泳道；acceptance ↔ 第 3 頁泳道。&lt;br&gt;層級名稱依 ISTQB：unit / integration / system / acceptance；smoke 是測試類型（先於其他測試），不是層級" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="gates"><mxGeometry x="20" y="1054" width="420" height="50" as="geometry"/></mxCell><mxCell id="p8_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg1" value="紫：image（每個 stage 都是一個 image）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1250" width="270" height="40" as="geometry"/></mxCell><mxCell id="p8_lg2" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="1240" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg3" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="770" y="1250" width="120" height="40" as="geometry"/></mxCell><mxCell id="p8_lgt" value="實線 = 依賴／複製方向" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="910" y="1240" width="300" height="60" as="geometry"/></mxCell><mxCell id="p8_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1326" width="200" height="20" as="geometry"/></mxCell><mxCell id="p8_tk0" value="stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv0" value="Dockerfile 裡的一個階段（FROM … AS 名稱）；docker build --target &amp;lt;名稱&amp;gt; 只做到那一階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk1" value="FROM / COPY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv1" value="Dockerfile 的兩個指令：FROM = 以哪個 stage／image 為底；COPY = 把 repo 裡的檔案放進 stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk2" value="BuildKit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv2" value="Docker 的建置引擎：只會建最終目標依賴到的 stage，沒被依賴的測試 stage 不會執行、也不會進 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk3" value="bake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv3" value="docker buildx bake：用一個檔定義多個 stage 目標與群組，CI 一次平行跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk4" value="smoke / env-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv4" value="smoke = 正式測試前先確認東西能開機的最小檢查；env-test 就是它：確認 runtime image 的環境（Python、tomllib、進入點、toml-bridge）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk5" value="runtime / release / release-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv5" value="runtime = 能執行 vendor_kit 的最小 image；release = 最終出貨的 image；release-test = 出貨前拿 release 真的裝一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk6" value="toml-bridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv6" value="vendor_kit image 的基底 image（另一個 repo 提供，內含 Python 與 TOML 工具）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk7" value="pytest / conftest.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv7" value="Python 的測試框架／每個測試目錄的共用設定；這裡用它對該層測試強制限制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1560" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk8" value="ruff / import-linter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv8" value="Python 寫法檢查／檢查模組之間誰可以 import 誰（契約寫在設定檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk9" value="import / 純函式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv9" value="import = 一個模組引用另一個模組；純函式 = 只算結果、不碰檔案與網路的函式（template、diff、stamp、report）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1620" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk10" value="VERSION vs .version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv10" value="VERSION = image 內 /dist/VERSION：出貨時寫入、給人看的識別字串（印記第一行改由啟動器 --self 傳入的 .version 字串，issue #23）；.version = 專案 repo 記工具版本的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1650" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk11" value="amd64 / arm64 / multi-arch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv11" value="兩種處理器架構（一般電腦／Jetson 等 ARM 板子）；multi-arch = 同一個 image 名稱同時提供兩種版本，Docker 依主機自動選" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1680" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk12" value="TOML / tomllib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1710" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv12" value="TOML = 設定檔格式（.version、init.toml 都用它）；tomllib = Python 3.11 起內建的讀 TOML 程式庫，環境檢查要確認它在" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1710" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk13" value="鏡射" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv13" value="test/ 的檔名跟 src/ 一一對應：src 有 cli.py，test 就必須有 test_cli.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1740" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk14" value="黑箱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv14" value="只從外面用、不看裡面：system / acceptance 測試不准 import vendor_kit，只能像使用者一樣 docker run 或打 just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1770" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk15" value="install / init / verify / diff / accept / just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1800" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv15" value="子命令：把 dist 裝進 .&amp;lt;name&amp;gt;/ 並寫印記／建立初始檔＋存基準／拿 .&amp;lt;name&amp;gt;/ 跟 image 內的 dist 比／三方比對新版模板／存新基準（accept 的測試 stage 待補）；just = 使用者在主機打的指令跑器（第 3、9 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1800" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk16" value="fixture / 假專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1830" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv16" value="測試用的假資料：假的 dist/（工具要出貨的檔案）、init.toml（init 要複製哪些初始檔的清單），以及一個假專案（acceptance 測試先用 bootstrap.sh 產生 .vendor_kit/、justfile、.version）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1830" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk17" value="image / 容器 / Docker / Dockerfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1860" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv17" value="打包好的環境／image 開起來的實例／跑它們的軟體／怎麼做 image 的食譜（每個 stage 是食譜的一段）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1860" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk18" value="cli.main()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1890" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv18" value="vendor_kit 程式的正門（命令介面的進入點）；integration 測試只准從這裡進" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1890" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk19" value="docker run / CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1920" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv19" value="把 image 跑成容器的指令／GitHub 上的自動化流程（每次推送都跑 bake validate）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1920" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk20" value="ADR / ISTQB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1950" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv20" value="設計決策紀錄（doc/adr/ 裡一個決策一個檔）／國際軟體測試標準，本頁的層級名稱來自它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1950" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk21" value="泳道" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv21" value="流程圖裡的一條直欄，代表一個子命令或情境的完整流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1980" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9. 使用者介面：just 指令表"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2000" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="使用者介面：指令表（bootstrap.sh 只在第一次；之後全是 just 指令，每個 just 指令前都先自動檢查／安裝）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="p9_pend" value="⚠ 待你回覆：dev／undev 要改成選項式（例如 just vendor_kit upgrade --local &amp;lt;name&amp;gt;）而不是給路徑嗎？本機路徑從哪來？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1260" height="4