（不經任何 test stage）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="stages" source="s_rt" target="s_rel"><mxGeometry x="0.785" relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="75"/><mxPoint x="475" y="785"/></Array></mxGeometry></mxCell><mxCell id="s9" value="FROM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s_rel" target="s_rtest"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_env" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_env" target="s_env"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_tb" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_fix" target="s_tb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_lint" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_lint" target="s_lint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_unit" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_unit" target="s_unit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_inst" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_inst" target="s_inst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_init" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_init" target="s_init"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_ver" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_ver" target="s_ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_s_diff" value="COPY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_diff" target="s_diff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gates" value="強制閘門（不靠提醒；違反就 CI 紅，依層分組）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="460" height="1130" as="geometry"/></mxCell><mxCell id="ge" value="smoke = 先確認環境能跑，再談測試（env-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="50" width="420" height="104" as="geometry"/></mxCell><mxCell id="g0" value="環境檢查先於一切&lt;br&gt;test-base FROM env-test：Python、tomllib、進入點、toml-bridge 任一不對，六個測試 stage 都不會跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="ge"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gl" value="lint 層 = 不執行程式的檢查（lint stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="164" width="420" height="232" as="geometry"/></mxCell><mxCell id="g_ruff" value="ruff&lt;br&gt;程式碼寫法檢查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g2" value="import-linter 分層契約&lt;br&gt;只能由上層 import 下層（命令介面 → 讀取／存取 → 純函式）；只有 repo_fs、dist_reader 能碰檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g3" value="鏡射檢查&lt;br&gt;每個 src 模組必有 test_&amp;lt;模組&amp;gt;.py，缺一個就失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gl"><mxGeometry x="10" y="168" width="400" height="56" as="geometry"/></mxCell><mxCell id="gu" value="unit 層 = 一次測一個模組（unit-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="406" width="420" height="104" as="geometry"/></mxCell><mxCell id="g4" value="unit conftest&lt;br&gt;測試中一碰檔案、網路、Docker 就直接失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gu"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gi" value="integration 層 = 一個子命令走到底（四個 *-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="520" width="420" height="232" as="geometry"/></mxCell><mxCell id="g5" value="integration conftest&lt;br&gt;只給臨時目錄；禁 Docker、網路；只能走 cli.main()（程式的正門）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g6" value="一個子命令一個 stage&lt;br&gt;各自只 COPY 自己的測試檔；哪個 stage 紅 = 第 5 頁哪條泳道壞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g7" value="時間預算&lt;br&gt;verify 200 個檔必須 &amp;lt; 0.5 秒（已安裝且版本一致時，每次 just 都會跑它）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gi"><mxGeometry x="10" y="168" width="400" height="56" as="geometry"/></mxCell><mxCell id="gs" value="system = 整個 image；acceptance = 真的打 just（CI 主機）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="762" width="420" height="104" as="geometry"/></mxCell><mxCell id="g8" value="黑箱檢查（lint stage）＋ conftest&lt;br&gt;測試檔不准 import vendor_kit；只准 docker run／just 與檔案系統" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gs"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="gr" value="release = 出貨（release / release-test stage）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=14;container=1;collapsible=0;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="gates"><mxGeometry x="20" y="876" width="420" height="168" as="geometry"/></mxCell><mxCell id="g1" value="BuildKit stage 依賴&lt;br&gt;release 只 FROM runtime → 測試碼、pytest 進不了產品 image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="40" width="400" height="56" as="geometry"/></mxCell><mxCell id="g9" value="release 必過 release-test&lt;br&gt;release image 真的 install + verify 一次，失敗就不上傳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="gr"><mxGeometry x="10" y="104" width="400" height="56" as="geometry"/></mxCell><mxCell id="g_map" value="對應：unit ↔ 第 1 頁模組；integration ↔ 第 5 頁泳道；acceptance ↔ 第 3 頁泳道。&lt;br&gt;層級名稱依 ISTQB：unit / integration / system / acceptance；smoke 是測試類型（先於其他測試），不是層級" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="gates"><mxGeometry x="20" y="1054" width="420" height="50" as="geometry"/></mxCell><mxCell id="p8_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg1" value="紫：image（每個 stage 都是一個 image）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1250" width="270" height="40" as="geometry"/></mxCell><mxCell id="p8_lg2" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="550" y="1240" width="200" height="60" as="geometry"/></mxCell><mxCell id="p8_lg3" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="770" y="1250" width="120" height="40" as="geometry"/></mxCell><mxCell id="p8_lgt" value="實線 = 依賴／複製方向" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="910" y="1240" width="300" height="60" as="geometry"/></mxCell><mxCell id="p8_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1326" width="200" height="20" as="geometry"/></mxCell><mxCell id="p8_tk0" value="stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv0" value="Dockerfile 裡的一個階段（FROM … AS 名稱）；docker build --target &amp;lt;名稱&amp;gt; 只做到那一階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk1" value="FROM / COPY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv1" value="Dockerfile 的兩個指令：FROM = 以哪個 stage／image 為底；COPY = 把 repo 裡的檔案放進 stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk2" value="BuildKit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv2" value="Docker 的建置引擎：只會建最終目標依賴到的 stage，沒被依賴的測試 stage 不會執行、也不會進 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk3" value="bake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv3" value="docker buildx bake：用一個檔定義多個 stage 目標與群組，CI 一次平行跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk4" value="smoke / env-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv4" value="smoke = 正式測試前先確認東西能開機的最小檢查；env-test 就是它：確認 runtime image 的環境（Python、tomllib、進入點、toml-bridge）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk5" value="runtime / release / release-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv5" value="runtime = 能執行 vendor_kit 的最小 image；release = 最終出貨的 image；release-test = 出貨前拿 release 真的裝一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk6" value="toml-bridge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv6" value="vendor_kit image 的基底 image（另一個 repo 提供，內含 Python 與 TOML 工具）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk7" value="pytest / conftest.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv7" value="Python 的測試框架／每個測試目錄的共用設定；這裡用它對該層測試強制限制" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1560" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk8" value="ruff / import-linter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv8" value="Python 寫法檢查／檢查模組之間誰可以 import 誰（契約寫在設定檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk9" value="import / 純函式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv9" value="import = 一個模組引用另一個模組；純函式 = 只算結果、不碰檔案與網路的函式（template、diff、stamp、report）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1620" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk10" value="VERSION vs .version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv10" value="VERSION = image 內 /dist/VERSION：出貨時寫入的 image 識別字串，install 抄到印記第一行，就是拿來跟 .version 比的值（fixtures 裡是假的）；.version = 專案 repo 記工具版本的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1650" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk11" value="TOML / tomllib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv11" value="TOML = 設定檔格式（.version、init.toml 都用它）；tomllib = Python 3.11 起內建的讀 TOML 程式庫，環境檢查要確認它在" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1680" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk12" value="鏡射" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1710" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv12" value="test/ 的檔名跟 src/ 一一對應：src 有 cli.py，test 就必須有 test_cli.py" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1710" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk13" value="黑箱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1740" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv13" value="只從外面用、不看裡面：system / acceptance 測試不准 import vendor_kit，只能像使用者一樣 docker run 或打 just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1740" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk14" value="install / verify / just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv14" value="install = 把 dist 裝進 .&amp;lt;name&amp;gt;/ 並寫印記；verify = 檢查 .&amp;lt;name&amp;gt;/ 沒被手改；just = 使用者在主機打的指令跑器（第 3、9 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1770" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk15" value="fixture / 假專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1800" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv15" value="測試用的假資料：假的 dist/（工具要出貨的檔案）、init.toml（init 要複製哪些初始檔的清單），以及一個只有 .version 與 justfile 的假專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1800" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk16" value="image / 容器 / Docker / Dockerfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1830" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv16" value="打包好的環境／image 開起來的實例／跑它們的軟體／怎麼做 image 的食譜（每個 stage 是食譜的一段）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1830" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk17" value="cli.main()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1860" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv17" value="vendor_kit 程式的正門（命令介面的進入點）；integration 測試只准從這裡進" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1860" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk18" value="docker run / CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1890" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv18" value="把 image 跑成容器的指令／GitHub 上的自動化流程（每次推送都跑 bake validate）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1890" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk19" value="ADR / ISTQB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1920" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv19" value="設計決策紀錄（doc/adr/ 裡一個決策一個檔）／國際軟體測試標準，本頁的層級名稱來自它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1920" width="900" height="30" as="geometry"/></mxCell><mxCell id="p8_tk20" value="泳道" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1950" width="170" height="30" as="geometry"/></mxCell><mxCell id="p8_tv20" value="流程圖裡的一條直欄，代表一個子命令或情境的完整流程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1950" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="9. 使用者介面：just 指令表"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1570" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="使用者介面：指令表（bootstrap.sh 只在第一次；之後全是 just 指令，每個 just 指令前都先自動檢查／安裝）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="gA" value="vendor_kit 提供的指令（每個用這套框架的專案都一樣）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1260" height="368" as="geometry"/></mxCell><mxCell id="ta_h0" value="指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="20" y="50" width="130" height="30" as="geometry"/></mxCell><mxCell id="ta_h1" value="什麼時候打" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="50" width="200" height="30" as="geometry"/></mxCell><mxCell id="ta_h2" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="50" width="330" height="30" as="geometry"/></mxCell><mxCell id="ta_h3" value="背後跑什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="50" width="300" height="30" as="geometry"/></mxCell><mxCell id="ta_h4" value="動到專案裡的什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="50" width="260" height="30" as="geometry"/></mxCell><mxCell id="ta_r0c0" value="bootstrap.sh&lt;br&gt;（release 附）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gA"><mxGeometry x="20" y="80" width="130" height="48" as="geometry"/></mxCell><mxCell id="ta_r0c1" value="第一次把 vendor_kit 接進專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="80" width="200" height="48" as="geometry"/></mxCell><mxCell id="ta_r0c2" value="展開 .vendor_kit/、justfile、.version；問要不要接工具並跑 init；然後刪掉自己（第 10 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="80" width="330" height="48" as="geometry"/></mxCell><mxCell id="ta_r0c3" value="docker run … vendor_kit bootstrap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="80" width="300" height="48" as="geometry"/></mxCell><mxCell id="ta_r0c4" value=".vendor_kit/、justfile、.version（新建）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="80" width="260" height="48" as="geometry"/></mxCell><mxCell id="ta_r1c0" value="just init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gA"><mxGeometry x="20" y="128" width="130" height="48" as="geometry"/></mxCell><mxCell id="ta_r1c1" value="第一次把工具接進專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="128" width="200" height="48" as="geometry"/></mxCell><mxCell id="ta_r1c2" value="安裝 .&amp;lt;name&amp;gt;/，再照 init.toml 建立初始檔（Dockerfile、設定檔、hooks…）；已存在的不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="128" width="330" height="48" as="geometry"/></mxCell><mxCell id="ta_r1c3" value="vendor_kit 容器：install → init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="128" width="300" height="48" as="geometry"/></mxCell><mxCell id="ta_r1c4" value=".&amp;lt;name&amp;gt;/（新建）、初始檔（新建）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="128" width="260" height="48" as="geometry"/></mxCell><mxCell id="ta_r2c0" value="just diff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gA"><mxGeometry x="20" y="176" width="130" height="48" as="geometry"/></mxCell><mxCell id="ta_r2c1" value="升級之後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="176" width="200" height="48" as="geometry"/></mxCell><mxCell id="ta_r2c2" value="顯示新版模板 vs 你的初始檔差在哪；不改任何檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="176" width="330" height="48" as="geometry"/></mxCell><mxCell id="ta_r2c3" value="vendor_kit 容器：diff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="176" width="300" height="48" as="geometry"/></mxCell><mxCell id="ta_r2c4" value="不動（只印到畫面）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="176" width="260" height="48" as="geometry"/></mxCell><mxCell id="ta_r3c0" value="just upgrade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gA"><mxGeometry x="20" y="224" width="130" height="48" as="geometry"/></mxCell><mxCell id="ta_r3c1" value="沒有 Renovate 機器人時，想手動升級" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="224" width="200" height="48" as="geometry"/></mxCell><mxCell id="ta_r3c2" value="把 .version 改成最新版 → 重新安裝 → 顯示差異（細節待議）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="224" width="330" height="48" as="geometry"/></mxCell><mxCell id="ta_r3c3" value="查 GHCR → 改 .version → install → diff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="224" width="300" height="48" as="geometry"/></mxCell><mxCell id="ta_r3c4" value=".version、.&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="224" width="260" height="48" as="geometry"/></mxCell><mxCell id="ta_r4c0" value="（自動）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gA"><mxGeometry x="20" y="272" width="130" height="48" as="geometry"/></mxCell><mxCell id="ta_r4c1" value="每個 just 指令執行前" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="150" y="272" width="200" height="48" as="geometry"/></mxCell><mxCell id="ta_r4c2" value="第 3 頁的檢查：.&amp;lt;name&amp;gt;/.stamp 第一行 ≠ .version → install；相同 → verify；verify 失敗就中止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="350" y="272" width="330" height="48" as="geometry"/></mxCell><mxCell id="ta_r4c3" value="vendor_kit 容器：install 或 verify" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="680" y="272" width="300" height="48" as="geometry"/></mxCell><mxCell id="ta_r4c4" value=".&amp;lt;name&amp;gt;/（可能重裝）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gA"><mxGeometry x="980" y="272" width="260" height="48" as="geometry"/></mxCell><mxCell id="gA_n" value="verify 不開放給使用者單獨打：它是每個指令前的守門（檢查 .&amp;lt;name&amp;gt;/ 有沒有被手改，被改就中止），不是一個要記的指令。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="gA"><mxGeometry x="20" y="326" width="1220" height="20" as="geometry"/></mxCell><mxCell id="gB" value="工具 &amp;lt;name&amp;gt; 提供的指令（由工具的 dist/ 決定，每個工具可以不同；下面以「容器工作流」工具為例）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1260" height="360" as="geometry"/></mxCell><mxCell id="tb_h0" value="指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="20" y="50" width="130" height="30" as="geometry"/></mxCell><mxCell id="tb_h1" value="什麼時候打" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="50" width="200" height="30" as="geometry"/></mxCell><mxCell id="tb_h2" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="50" width="330" height="30" as="geometry"/></mxCell><mxCell id="tb_h3" value="背後跑什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="50" width="300" height="30" as="geometry"/></mxCell><mxCell id="tb_h4" value="動到專案裡的什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="50" width="260" height="30" as="geometry"/></mxCell><mxCell id="tb_r0c0" value="just build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="80" width="130" height="48" as="geometry"/></mxCell><mxCell id="tb_r0c1" value="第一次、或改了 Dockerfile 之後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="80" width="200" height="48" as="geometry"/></mxCell><mxCell id="tb_r0c2" value="建置專案自己的 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="80" width="330" height="48" as="geometry"/></mxCell><mxCell id="tb_r0c3" value=".&amp;lt;name&amp;gt;/ 的 build 腳本 → docker compose build" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="80" width="300" height="48" as="geometry"/></mxCell><mxCell id="tb_r0c4" value="本機 image（不在 repo 裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="80" width="260" height="48" as="geometry"/></mxCell><mxCell id="tb_r1c0" value="just run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="128" width="130" height="48" as="geometry"/></mxCell><mxCell id="tb_r1c1" value="要開始工作時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="128" width="200" height="48" as="geometry"/></mxCell><mxCell id="tb_r1c2" value="啟動專案容器（在背景常駐）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="128" width="330" height="48" as="geometry"/></mxCell><mxCell id="tb_r1c3" value=".&amp;lt;name&amp;gt;/ 的 run 腳本 → docker compose up" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="128" width="300" height="48" as="geometry"/></mxCell><mxCell id="tb_r1c4" value="容器（不在 repo 裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="128" width="260" height="48" as="geometry"/></mxCell><mxCell id="tb_r2c0" value="just exec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="176" width="130" height="48" as="geometry"/></mxCell><mxCell id="tb_r2c1" value="容器跑著的時候" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="176" width="200" height="48" as="geometry"/></mxCell><mxCell id="tb_r2c2" value="進到容器裡下指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="176" width="330" height="48" as="geometry"/></mxCell><mxCell id="tb_r2c3" value=".&amp;lt;name&amp;gt;/ 的 exec 腳本 → docker compose exec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="176" width="300" height="48" as="geometry"/></mxCell><mxCell id="tb_r2c4" value="無" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="176" width="260" height="48" as="geometry"/></mxCell><mxCell id="tb_r3c0" value="just stop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;fontFamily=Courier New;" vertex="1" parent="gB"><mxGeometry x="20" y="224" width="130" height="48" as="geometry"/></mxCell><mxCell id="tb_r3c1" value="收工" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="150" y="224" width="200" height="48" as="geometry"/></mxCell><mxCell id="tb_r3c2" value="停掉並移除容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="350" y="224" width="330" height="48" as="geometry"/></mxCell><mxCell id="tb_r3c3" value=".&amp;lt;name&amp;gt;/ 的 stop 腳本 → docker compose down" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="680" y="224" width="300" height="48" as="geometry"/></mxCell><mxCell id="tb_r3c4" value="容器（移除）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="gB"><mxGeometry x="980" y="224" width="260" height="48" as="geometry"/></mxCell><mxCell id="gB_n" value="為什麼是這四個：它們是「一個容器的一生」— 做出來（build）→ 開起來（run）→ 進去用（exec）→ 關掉（stop），一個階段一個指令。&lt;br&gt;這四個是工具定義的，vendor_kit 只負責把工具裝好；換一個工具，這一區的指令就換一套。&lt;br&gt;每個工具指令前後都可以掛你自己的腳本：script/hooks/pre/&amp;lt;指令&amp;gt;.sh、post/&amp;lt;指令&amp;gt;.sh（init 建立的空殼）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="gB"><mxGeometry x="20" y="282" width="1220" height="66" as="geometry"/></mxCell><mxCell id="gC" value="任何一個 just 指令的完整路徑" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1260" height="205" as="geometry"/></mxCell><mxCell id="c0" value="使用者打 just X" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="gC"><mxGeometry x="20" y="95" width="160" height="50" as="geometry"/></mxCell><mxCell id="c1" value="自動檢查／安裝&lt;br&gt;（第 3 頁「日常」）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="gC"><mxGeometry x="220" y="95" width="180" height="50" as="geometry"/></mxCell><mxCell id="c2" value="X 是誰的？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="gC"><mxGeometry x="440" y="80" width="160" height="80" as="geometry"/></mxCell><mxCell id="c3" value="起 vendor_kit 容器跑子命令&lt;br&gt;（init / diff；upgrade 是它們的組合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="gC"><mxGeometry x="660" y="55" width="260" height="50" as="geometry"/></mxCell><mxCell id="c4" value="執行 .&amp;lt;name&amp;gt;/ 裡的腳本&lt;br&gt;（build / run / exec / stop…）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="gC"><mxGeometry x="660" y="135" width="260" height="50" as="geometry"/></mxCell><mxCell id="c5" value="畫面顯示結果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="gC"><mxGeometry x="980" y="70" width="160" height="100" as="geometry"/></mxCell><mxCell id="ce0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce1" value="通過" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce2" value="vendor_kit 的" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;jettySize=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce3" value="工具的" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;jettySize=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ce5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="200" height="60" as="geometry"/></mxCell><mxCell id="p9_lg1" value="綠：使用框架的 repo" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1090" width="200" height="60" as="geometry"/></mxCell><mxCell id="p9_lg2" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1090" width="200" height="60" as="geometry"/></mxCell><mxCell id="p9_lg3" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="700" y="1100" width="120" height="40" as="geometry"/></mxCell><mxCell id="p9_lg4" value="紫：image / container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="1100" width="180" height="40" as="geometry"/></mxCell><mxCell id="p9_lg5" value="綠橢圓：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1040" y="1100" width="160" height="40" as="geometry"/></mxCell><mxCell id="p9_lg6" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1220" y="1090" width="110" height="60" as="geometry"/></mxCell><mxCell id="p9_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1350" y="1100" width="130" height="40" as="geometry"/></mxCell><mxCell id="p9_lgt" value="表格：一列一個指令&lt;br&gt;流程：實線 = 執行順序" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1500" y="1090" width="300" height="60" as="geometry"/></mxCell><mxCell id="p9_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1176" width="200" height="20" as="geometry"/></mxCell><mxCell id="p9_tk0" value="子命令 / dist/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv0" value="子命令 = vendor_kit 容器裡的動作：install 把 dist 裝進 .&amp;lt;name&amp;gt;/ 並寫印記、init 建初始檔、verify 檢查 .&amp;lt;name&amp;gt;/ 有沒有被手改、diff 比模板；bootstrap 只在第一次寫出啟動器（第 10 頁）；dist/ = 工具要出貨的檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk1" value="bootstrap / release" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv1" value="bootstrap = 第一次把 vendor_kit 接進專案的腳本，不是 just 指令、也不會先自動檢查（那時啟動器還不存在）；release = vendor_kit 打 tag 發佈的版本，image 上傳 GHCR、bootstrap.sh 附在 GitHub release 頁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk2" value="just / justfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv2" value="just = 主機上的指令跑器；justfile = 專案裡給它讀的指令清單，第一行 import .vendor_kit/ 的標準指令（啟動器）。使用者只需要記這一頁的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk3" value="&amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv3" value="工具名（= .version 裡的 key）；工具裝在 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk4" value="init.toml / 初始檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv4" value="工具給的清單：第一次要複製到專案的檔案（Dockerfile、設定檔、hooks…）；建立後歸使用者，升級不會動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk5" value="印記 / .version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv5" value=".&amp;lt;name&amp;gt;/.stamp：記錄裝了哪個 image + 每檔指紋／專案記工具版本的檔；兩者不同就重裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk6" value="Renovate / GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv6" value="GitHub 上的機器人：有新版就自動開 PR 改 .version／GitHub 的 image 倉庫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk7" value="docker compose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv7" value="Docker 內建的多容器管理指令：build 建置、up 啟動、exec 進入、down 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk8" value="image / 容器 / Dockerfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv8" value="image = 打包好的環境（做一次）；容器 = image 開起來的實例（可開可關）；Dockerfile = 怎麼做 image 的食譜。build 做 image，run 開容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk9" value="hooks" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv9" value="掛勾腳本：每個工具指令前（pre）後（post）自動執行的你的腳本，預設是空殼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p9_tk10" value="容器工作流" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p9_tv10" value="用容器當開發環境的工作方式：建置 image → 啟動容器 → 進去工作 → 停掉；「工具 &amp;lt;name&amp;gt; 提供的指令」表的四個指令就是它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="10. 流程：bootstrap"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程：bootstrap ── 第一次把 vendor_kit 接進專案（release 附的腳本，跑完自己刪掉）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="bh_40" value="使用者" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="260" height="24" as="geometry"/></mxCell><mxCell id="bh_340" value="bootstrap.sh（在主機執行）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="380" height="24" as="geometry"/></mxCell><mxCell id="bh_760" value="vendor_kit 容器" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="bh_1160" value="專案目錄" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="bs" value="bootstrap：一次做完，之後都靠 just" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1520" height="640" as="geometry"/></mxCell><mxCell id="u0" value="下載 release 附的&lt;br&gt;bootstrap.sh，在專案目錄執行" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bs"><mxGeometry x="30" y="60" width="240" height="60" as="geometry"/></mxCell><mxCell id="u1" value="完成：專案裡只剩&lt;br&gt;.vendor_kit/、justfile、.version&lt;br&gt;（＋ .&amp;lt;name&amp;gt;/、初始檔）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bs"><mxGeometry x="30" y="535" width="240" height="70" as="geometry"/></mxCell><mxCell id="s1" value="主機有 docker、&lt;br&gt;git、just？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bs"><mxGeometry x="400" y="50" width="200" height="80" as="geometry"/></mxCell><mxCell id="s_err" value="中止：列出缺的軟體" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bs"><mxGeometry x="400" y="160" width="200" height="50" as="geometry"/></mxCell><mxCell id="s2" value="docker run … vendor_kit:vN bootstrap&lt;br&gt;（以使用者身分，掛載專案目錄）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="bs"><mxGeometry x="340" y="260" width="320" height="50" as="geometry"/></mxCell><mxCell id="s3" value="要現在接一個&lt;br&gt;工具嗎？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bs"><mxGeometry x="400" y="350" width="200" height="80" as="geometry"/></mxCell><mxCell id="s4" value="把 &amp;lt;name&amp;gt; = &quot;image&quot; 寫進 .version&lt;br&gt;再執行 just init（第 3 頁「第一次」）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="bs"><mxGeometry x="340" y="460" width="320" height="50" as="geometry"/></mxCell><mxCell id="s5" value="刪掉 bootstrap.sh 自己" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="bs"><mxGeometry x="380" y="550" width="240" height="40" as="geometry"/></mxCell><mxCell id="c1" value="bootstrap 子命令&lt;br&gt;寫出啟動器與版本檔（不碰其他檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="bs"><mxGeometry x="760" y="215" width="340" height="140" as="geometry"/></mxCell><mxCell id="f1" value=".vendor_kit/&lt;br&gt;啟動器本體：install / init / diff / upgrade 等標準指令&lt;br&gt;＋ 它自己的印記 .vendor_kit/.stamp（記 vendor_kit 版本）；進 git，人不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bs"><mxGeometry x="1160" y="215" width="340" height="64" as="geometry"/></mxCell><mxCell id="f2" value="justfile（一行 import .vendor_kit/…；&lt;br&gt;之後是使用者自己的指令，進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bs"><mxGeometry x="1160" y="283" width="340" height="44" as="geometry"/></mxCell><mxCell id="f3" value=".version（先只有 vendor_kit = &quot;…&quot; 一行，進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bs"><mxGeometry x="1160" y="331" width="340" height="36" as="geometry"/></mxCell><mxCell id="f4" value=".&amp;lt;name&amp;gt;/（不進 git）＋ 初始檔（進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bs"><mxGeometry x="1160" y="465" width="340" height="40" as="geometry"/></mxCell><mxCell id="be1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be2" value="缺" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=right;verticalAlign=middle;spacingRight=6;spacingBottom=0;" edge="1" parent="1" source="s1" target="s_err"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be3" value="齊全" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="bs" source="s1" target="s2"><mxGeometry x="-0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="90"/><mxPoint x="690" y="230"/><mxPoint x="500" y="230"/></Array></mxGeometry></mxCell><mxCell id="be4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be5" value="寫出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.2286;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be6" value="寫出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.6429;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be7" value="寫出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.9571;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be9" value="要" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be10" value="先不要" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;align=right;verticalAlign=middle;spacingRight=6;spacingBottom=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="bs" source="s3" target="s5"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="390"/><mxPoint x="310" y="570"/></Array></mxGeometry></mxCell><mxCell id="be11" value="install + init 寫出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="be13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="bs" source="s5" target="u1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="620"/><mxPoint x="150" y="620"/></Array></mxGeometry></mxCell><mxCell id="bn" value="之後：vendor_kit 出新版 → .version 的 vendor_kit 那行改掉（Renovate 或 just upgrade）→ .vendor_kit/ 整個換新，跟 .&amp;lt;name&amp;gt;/ 一樣；使用者的 justfile 永遠不會被動到。&lt;br&gt;bootstrap.sh 的內容其實只有：檢查三個軟體 → 那一行 docker run → 問問題 → 自刪；主機不需要 Python。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1520" height="50" as="geometry"/></mxCell><mxCell id="p11_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="220" height="60" as="geometry"/></mxCell><mxCell id="p11_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="830" width="110" height="60" as="geometry"/></mxCell><mxCell id="p11_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="840" width="130" height="40" as="geometry"/></mxCell><mxCell id="p11_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="840" width="130" height="40" as="geometry"/></mxCell><mxCell id="p11_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="840" width="200" height="40" as="geometry"/></mxCell><mxCell id="p11_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="840" width="88" height="40" as="geometry"/></mxCell><mxCell id="p11_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="840" width="170" height="40" as="geometry"/></mxCell><mxCell id="p11_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="840" width="130" height="40" as="geometry"/></mxCell><mxCell id="p11_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="830" width="300" height="60" as="geometry"/></mxCell><mxCell id="p11_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="916" width="200" height="20" as="geometry"/></mxCell><mxCell id="p11_tk0" value="bootstrap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv0" value="第一次把工具接進專案的動作；這裡 = release 附的一個腳本，跑完自己刪掉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="940" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk1" value="啟動器 / .vendor_kit/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv1" value="just 要用的標準指令集，由 vendor_kit 寫出並擁有；使用者不改，升級整個換新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="970" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk2" value="印記（.vendor_kit/.stamp）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv2" value="跟 .&amp;lt;name&amp;gt;/.stamp 同一種東西，但這份記的是 vendor_kit 自己的版本 + vendor.just 指紋；啟動器拿它跟 .version 的 vendor_kit 那行比" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1000" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk3" value="docker / git / just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv3" value="主機要先裝的三個軟體：跑容器的／管理 repo 的／跑 justfile 指令的；bootstrap 只檢查有沒有，不幫你裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1030" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk4" value="容器 / image / 掛載" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv4" value="image = 打包好的環境；容器 = image 開起來的實例；掛載 = 把專案目錄接進容器，容器寫的檔就直接出現在專案裡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1060" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk5" value="GHCR / Renovate / tag / TOML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv5" value="GitHub 的 image 倉庫／自動開 PR 改 .version 的機器人／給 repo 打的版本記號／設定檔格式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1090" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk6" value="justfile / import" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv6" value="專案根目錄給 just 讀的指令清單；第一行 import 把 .vendor_kit/ 的標準指令接進來，其餘是使用者自己的" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1120" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk7" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv7" value="工具版本清單（TOML）；bootstrap 後先只有 vendor_kit 一行，接工具時再加一行 &amp;lt;name&amp;gt; = &quot;image&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1150" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk8" value="release" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv8" value="vendor_kit 打 tag 發佈的一個版本：含 image（上傳 GHCR）與 bootstrap.sh（附在 GitHub release 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1180" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk9" value="just init / install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv9" value="just init = 第 3 頁「第一次」流程：先 install（把工具的 dist 裝進 .&amp;lt;name&amp;gt;/），再 init（建立初始檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1210" width="900" height="30" as="geometry"/></mxCell><mxCell id="p11_tk10" value="以使用者身分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="170" height="30" as="geometry"/></mxCell><mxCell id="p11_tv10" value="docker run -u UID:GID：容器寫出的檔案擁有者是你，不是 root" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1240" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>