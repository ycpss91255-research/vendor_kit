Bottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="diff" source="d_two" target="d4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="470"/></Array></mxGeometry></mxCell><mxCell id="accept" value="accept（看完 diff 後：新版模板存成基準）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2060" y="60" width="420" height="600" as="geometry"/></mxCell><mxCell id="a0" value="開始 accept" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="accept"><mxGeometry x="130" y="50" width="160" height="50" as="geometry"/></mxCell><mxCell id="a1" value="對專案目錄上鎖（排他；&lt;br&gt;逾時規則同 install）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="accept"><mxGeometry x="110" y="130" width="200" height="40" as="geometry"/></mxCell><mxCell id="a2" value="取 image 內的新版模板&lt;br&gt;（init.toml 列的檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="accept"><mxGeometry x="110" y="200" width="200" height="50" as="geometry"/></mxCell><mxCell id="a3" value="寫進 .vendor_kit/baseline/&amp;lt;name&amp;gt;/&lt;br&gt;＋ 記下是哪個 image、每檔指紋" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="accept"><mxGeometry x="100" y="280" width="220" height="60" as="geometry"/></mxCell><mxCell id="a4" value="釋放鎖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="accept"><mxGeometry x="110" y="370" width="200" height="40" as="geometry"/></mxCell><mxCell id="a5" value="結束（基準 = 這版）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="accept"><mxGeometry x="110" y="440" width="200" height="50" as="geometry"/></mxCell><mxCell id="an" value="語意：「這版我全看過了」。寫的是新版模板，不是你的檔；&lt;br&gt;diff 結尾只提示、不會問你。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="accept"><mxGeometry x="20" y="520" width="380" height="50" as="geometry"/></mxCell><mxCell id="ae0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4n" value="已定案：verify 比 image 內的 dist 而不是印記（issue #23）；diff 三方（#22）；install／verify／accept 對專案目錄上鎖（#24）。本機開發模式見第 4 頁（#21）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1150" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p4_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1210" width="110" height="60" as="geometry"/></mxCell><mxCell id="p4_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1220" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1220" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lg4" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="710" y="1220" width="88" height="40" as="geometry"/></mxCell><mxCell id="p4_lg5" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="818" y="1220" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="968" y="1210" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1296" width="200" height="20" as="geometry"/></mxCell><mxCell id="p4_tk0" value="暫存目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv0" value="先把整個 dist/ 寫到 .&amp;lt;name&amp;gt;.tmp.&amp;lt;亂數&amp;gt;/，最後一步才改名成 .&amp;lt;name&amp;gt;/；中途失敗舊目錄不受影響" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk1" value="鎖（排他／共享）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv1" value="對專案目錄上鎖（flock）：排他 = 同時只有一個（install、accept）；共享 = 可多個一起但要等排他的放開（verify）。程序結束或被殺，系統自動解鎖，不會留殘鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk2" value="兩棵樹比對" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv2" value="把 image 內的 /dist 跟 .&amp;lt;name&amp;gt;/ 逐檔比：檔案集合（缺、多）、內容指紋 sha256、執行位（單向：該可執行的仍可執行，Windows 掛載才不誤報）、型別（symlink 第一版禁止）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk3" value="印記 / --self" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv3" value="印記 = .&amp;lt;name&amp;gt;/.stamp，第一行 = 啟動器用 --self 傳進來的 .version 字串，之後每檔指紋（追溯用）；verify 只用第一行判斷要不要重裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk4" value="基準 / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv4" value="基準 = .vendor_kit/baseline/&amp;lt;name&amp;gt;/：上次確認過的模板副本＋metadata；accept = 把新版模板寫成基準的子命令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk5" value="三方 / 二方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv5" value="三方 = 基準、新版模板、你的檔三份一起比，能分出誰改了什麼；二方 = 只比新版模板跟你的檔（沒基準時的退路）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk6" value="可執行 / 檔案種類 / 記下是哪個 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv6" value="可執行 = 檔案有「可以直接執行」的標記（腳本要有）／種類 = 一般檔、資料夾、連結（symlink，第一版不准）／基準旁邊記的來源 image 與每檔指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk7" value="環境變數" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv7" value="跑指令前設定的名稱=值，用來改預設行為：例如鎖的等待秒數、強制不鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk8" value="結束狀態" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv8" value="程式結束時回報的數字；diff 用 0 沒差異／1 工具有改／2 可能重疊，給 CI 判斷" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1560" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk9" value="src → dest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv9" value="init.toml 每一項：src 指 image 的 dist/ 裡哪個檔，dest 指要放到專案的哪裡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk10" value="vendor_kit / image / dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1620" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv10" value="安裝工具本身／打包好可執行的檔案包／工具要出貨的檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1620" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk11" value="init.toml / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv11" value="init 要建立哪些檔的清單／專案裡的 .vendor_kit/ 標準指令（使用者打 just 時執行）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1650" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk12" value="容器 / &amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1680" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv12" value="容器 = image 執行起來的實例；&amp;lt;name&amp;gt; = .version 裡的工具名，安裝目錄就叫 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1680" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="6. 原型對照"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="原型對照：proto/ 三個資料夾 ↔ 框架裡的三種角色" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="row_t" value="原始碼（進 git，人維護）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="row_g" value="產物（不進 git；原型在本機建置，正式版由 CI 建置＋上傳）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="420" height="20" as="geometry"/></mxCell><mxCell id="row_d" value="使用端（前三樣進 git）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="r_vk" value="vendor_kit repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="200" as="geometry"/></mxCell><mxCell id="r_vk_t" value="= proto/vendor_kit/" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="r_vk"><mxGeometry x="10" y="40" width="280" height="18" as="geometry"/></mxCell><mxCell id="f_vk" value="vendor_kit&lt;br&gt;（安裝工具程式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="20" y="70" width="120" height="50" as="geometry"/></mxCell><mxCell id="f_vkdf" value="Dockerfile&lt;br&gt;（打包食譜）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="160" y="70" width="120" height="50" as="geometry"/></mxCell><mxCell id="r_vk_n" value="vendor_kit 是產品本體；Dockerfile 只說明怎麼把它裝進 image" style="text;html=1;whiteSpace=wrap;align=center;vertica