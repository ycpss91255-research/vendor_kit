0" height="30" as="geometry"/></mxCell><mxCell id="p4_tv0" value="先把整個 dist/ 寫到 .&amp;lt;name&amp;gt;.tmp/，最後一步才改名成 .&amp;lt;name&amp;gt;/；中途失敗舊目錄不受影響" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk1" value="src → dest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv1" value="init.toml 每一項：src 指 image 的 dist/ 裡哪個檔，dest 指要放到專案的哪裡" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1040" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk2" value="原子替換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv2" value="先在暫存目錄準備好全部新檔，最後用一次改名換掉舊目錄；任何時刻看到的都是完整的舊版或完整的新版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1070" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk3" value="印記 / 指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv3" value="印記 = .&amp;lt;name&amp;gt;/.stamp（版本 + 每檔指紋）；指紋 = 由檔案內容算出的識別碼，內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#