#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="1140" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1_lg2" value="綠：使用框架的 repo" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="1140" width="200" height="60" as="geometry"/></mxCell><mxCell id="p1_lg3" value="黃：外部（使用者、外部系統）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="1140" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1_lg4" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="940" y="1150" width="120" height="40" as="geometry"/></mxCell><mxCell id="p1_lgt" value="實線 = 傳輸內容（線上文字 = 傳什麼）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="1140" width="300" height="60" as="geometry"/></mxCell><mxCell id="p1_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1226" width="200" height="20" as="geometry"/></mxCell><mxCell id="p1_tk0" value="vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv0" value="通用安裝工具；只以 container 形態執行（開發、使用皆是），主機不需安裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1250" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk1" value="image / container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv1" value="image = 打包好的程式與檔案；container = image 執行起來的實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1280" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk2" value="&amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv2" value="工具名，由專案的 .version 指定；安裝目錄就叫 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1310" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk3" value="install / init / verify / diff / accept / bootstrap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv3" value="子命令：安裝 dist 到 .&amp;lt;name&amp;gt;/／第一次建立使用者檔／檢查 .&amp;lt;name&amp;gt;/ 沒被改／升級後三方比對／把新版模板存成基準／第一次寫出啟動器（第 10 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1340" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk4" value="結束狀態" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv4" value="程式結束時回報的數字：0 成功、非 0 失敗；diff 另有 0 沒差異／1 工具有改／2 可能重疊；啟動器據此決定要不要繼續" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1370" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk5" value="兩棵樹比對" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv5" value="verify 的做法：把 image 內的 dist 跟專案的 .&amp;lt;name&amp;gt;/ 逐檔比：少了檔、多了檔（只豁免 .stamp）、內容不同、該可執行的變成不可執行、檔案種類不同（例如變成連結）都算失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1400" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk6" value="三方分類" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv6" value="diff 對每個初始檔看三份：基準（上次確認過的模板）、新版模板、你的檔 → 分成沒人改／只有工具改／只有你改／兩邊都改／你已套上相同內容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1430" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk7" value="基準（baseline）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv7" value=".vendor_kit/baseline/&amp;lt;name&amp;gt;/：你上次確認過的那版模板副本；diff 用它分出「工具改了什麼」「你改了什麼」；init／accept 寫、人不改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1460" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk8" value="鎖（專案目錄）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1490" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv8" value="同一專案同時只有一個 install 在跑：對專案目錄上鎖（flock），後到的等前一個裝完；verify 拿共享鎖；程序被殺系統自動解鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1490" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk9" value="模組" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv9" value="vendor_kit 內部的功能分塊；同一個 container 裡，不是各自的 container" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1520" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk10" value="dist/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1550" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv10" value="工具 repo 裡要出貨的那批檔案，全部寫進專案的 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1550" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk11" value="init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv11" value="工具 repo 提供的清單：init 時要複製到專案的初始檔有哪些、放哪（dist/ 本身每次 upgrade 都整包覆蓋）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1580" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk12" value="印記檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv12" value=".&amp;lt;name&amp;gt;/.stamp：第一行 = 裝的 image（啟動器傳進來的 .version 字串），之後每檔指紋（給人追溯用）；verify 只用第一行判斷要不要重裝，內容以 image 為準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1610" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk13" value="指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv13" value="由檔案內容算出的一串碼（sha256）；內容一改就不同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1640" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk14" value="模板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv14" value="工具 dist/ 裡給初始檔用的樣板（例如 Dockerfile 範本）；目前只複製；渲染 = 帶入變數（專案名等）產生實際檔案，待定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1670" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk15" value="repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv15" value="一個 git 管理的專案資料夾；工具 repo = 工具的原始碼，專案 repo = 使用工具的專案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1700" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk16" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv16" value="專案 repo 裡的版本清單（TOML）：一個工具一行，記工具名與 image 版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1730" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk17" value="啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv17" value="專案 repo 裡的 .vendor_kit/：vendor_kit 寫出的標準 just 指令，使用者打 just 時由它起容器；justfile 只是引用入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1760" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk18" value="Dockerfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv18" value="打包 image 的食譜；專案自己的 Dockerfile 是由模板建立的使用者檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1790" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk19" value="upgrade（升級）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1820" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv19" value="改 .version 換新版本。兩條路：機器人開 PR（人 merge 後，下次 just 才換新）；或 just vendor_kit upgrade（改完立即 install → diff）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1820" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1_tk20" value="TOML / just / PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1850" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tv20" value="設定檔格式（key = &quot;value&quot;）／主機上的指令跑器，使用者打 just &amp;lt;指令&amp;gt;／GitHub 上的合併請求，merge = 接受修改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1850" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1b" name="2. 框架定義"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1660" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="框架定義：兩種 repo 各自必須有什麼，以及工具怎麼送到專案" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="tool" value="工具 repo（每個要出貨的工具一個）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="320" height="260" as="geometry"/></mxCell><mxCell id="t_t" value="工具名 = &amp;lt;name&amp;gt;；下面四樣是接上 vendor_kit 的必要條件" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="tool"><mxGeometry x="10" y="40" width="300" height="30" as="geometry"/></mxCell><mxCell id="t_dist" value="dist/&lt;br&gt;（要出貨的全部）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="20" y="80" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_init" value="init.toml&lt;br&gt;（初始檔清單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="165" y="80" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_df" value="Dockerfile.dist&lt;br&gt;（FROM vendor_kit）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="20" y="145" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_ci" value="CI：打 tag →&lt;br&gt;建置＋上傳 image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="tool"><mxGeometry x="165" y="145" width="135" height="50" as="geometry"/></mxCell><mxCell id="t_n" value="其他內容（doc、test、CI 腳本…）不在 dist/ 裡，不會出貨" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="tool"><mxGeometry x="10" y="205" width="300" height="40" as="geometry"/></mxCell><mxCell id="vk" value="vendor_kit repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="320" height="130" as="geometry"/></mxCell><mxCell id="vk_prog" value="vendor_kit 程式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="20" y="50" width="135" height="40" as="geometry"/></mxCell><mxCell id="vk_df" value="Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="165" y="50" width="135" height="40" as="geometry"/></mxCell><mxCell id="tool2" value="另一個工具 repo（&amp;lt;name2&amp;gt;，同型）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="320" height="60" as="geometry"/></mxCell><mxCell id="ghcr" value="GHCR（image 倉庫）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="260" height="710" as="geometry"/></mxCell><mxCell id="g_t" value="tag 不覆蓋；被引用的版本不刪&lt;br&gt;multi-arch（amd64 + arm64）；附註來源 commit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="ghcr"><mxGeometry x="10" y="40" width="240" height="40" as="geometry"/></mxCell><mxCell id="g_tool" value="&amp;lt;name&amp;gt;-dist:vX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="30" y="360" width="200" height="40" as="geometry"/></mxCell><mxCell id="g_vk" value="vendor_kit:vN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="30" y="540" width="200" height="40" as="geometry"/></mxCell><mxCell id="g_tool2" value="&amp;lt;name2&amp;gt;-dist:vY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="30" y="650" width="200" height="40" as="geometry"/></mxCell><mxCell id="proj" value="專案 repo（使用工具的專案）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="770" height="710" as="geometry"/></mxCell><mxCell id="p_t" value="必要條件：.version、justfile、.vendor_kit/（啟動器本體，第 10 頁 bootstrap 寫出；justfile 只用 mod? 掛它）；每個工具各自裝到 .&amp;lt;name&amp;gt;/" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="proj"><mxGeometry x="10" y="40" width="750" height="30" as="geometry"/></mxCell><mxCell id="pa" value="啟動器與版本檔" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="proj"><mxGeometry x="20" y="80" width="340" height="245" as="geometry"/></mxCell><mxCell id="pa_t" value="都進 git，只有 .version.local 不進；.version 一行 = 一個工具 = 一個 .&amp;lt;name&amp;gt;/；.version.local 有同名那行就優先（本機開發用，第 4 頁）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="pa"><mxGeometry x="12" y="40" width="316" height="30" as="geometry"/></mxCell><mxCell id="p_ver" value=".version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pa"><mxGeometry x="12" y="74" width="90" height="40" as="geometry"/></mxCell><mxCell id="p_vl" value=".version.local&lt;br&gt;（可選，不進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=11;strokeWidth=1;dashed=1;" vertex="1" parent="pa"><mxGeometry x="112" y="74" width="120" height="40" as="geometry"/></mxCell><mxCell id="p_just" value="justfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pa"><mxGeometry x="250" y="74" width="78" height="40" as="geometry"/></mxCell><mxCell id="p_vk" value=".vendor_kit/（啟動器本體）&lt;br&gt;vendor.just、tools.just、.stamp、baseline/&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="pa"><mxGeometry x="12" y="142" width="316" height="50" as="geometry"/></mxCell><mxCell id="pa_t2" value="根 justfile 只有一行 mod? vendor_kit &#x27;.vendor_kit/vendor.just&#x27; → 指令都是 just vendor_kit &amp;lt;動作&amp;gt;；工具的 tool.just 也用自己的命名空間（mod? &amp;lt;模組&amp;gt; → just &amp;lt;模組&amp;gt; build）；工具 recipe 開頭先呼叫 just vendor_kit ensure 做自動檢查" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="pa"><mxGeometry x="12" y="198" width="316" height="36" as="geometry"/></mxCell><mxCell id="p_eng" value="安裝容器（&amp;lt;name&amp;gt;-dist:vX）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="proj"><mxGeometry x="20" y="350" width="300" height="60" as="geometry"/></mxCell><mxCell id="p_eng_t" value="以使用者身分執行，跑完即刪；先對專案目錄上鎖" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="proj"><mxGeometry x="20" y="412" width="300" height="20" as="geometry"/></mxCell><mxCell id="pb" value="使用者檔案（進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="proj"><mxGeometry x="300" y="440" width="220" height="125" as="geometry"/></mxCell><mxCell id="p_u1" value="Dockerfile&lt;br&gt;（專案自己的）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pb"><mxGeometry x="12" y="45" width="100" height="50" as="geometry"/></mxCell><mxCell id="p_u2" value="設定檔…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pb"><mxGeometry x="122" y="45" width="86" height="50" as="geometry"/></mxCell><mxCell id="pb_t" value="init 建立；之後由使用者維護" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="pb"><mxGeometry x="12" y="98" width="200" height="18" as="geometry"/></mxCell><mxCell id="pc" value=".&amp;lt;name&amp;gt;/（不進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="proj"><mxGeometry x="540" y="440" width="220" height="125" as="geometry"/></mxCell><mxCell id="p_c1" value="dist 全部" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pc"><mxGeometry x="12" y="45" width="90" height="40" as="geometry"/></mxCell><mxCell id="p_c2" value="印記檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="pc"><mxGeometry x="118" y="45" width="90" height="40" as="geometry"/></mxCell><mxCell id="pc_t" value="每次 upgrade 整批覆蓋；verify 拿它跟 image 比&lt;br&gt;印記檔 = 裝的 image + 每檔指紋" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="pc"><mxGeometry x="6" y="88" width="210" height="32" as="geometry"/></mxCell><mxCell id="pc2" value=".&amp;lt;name2&amp;gt;/（另一個工具）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=14;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="proj"><mxGeometry x="540" y="645" width="220" height="50" as="geometry"/></mxCell><mxCell id="host" value="使用者的電腦" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#FFF4C3;swimlaneFi