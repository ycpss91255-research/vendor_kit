xCell id="g_t" value="規則：舊版本永遠保留、版本名稱不重複使用" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="ghcr"><mxGeometry x="10" y="40" width="280" height="30" as="geometry"/></mxCell><mxCell id="g_vk" value="安裝工具 image&lt;br&gt;vendor_kit:vN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="20" y="258" width="220" height="60" as="geometry"/></mxCell><mxCell id="g_base" value="base-dist:vX image&lt;br&gt;內容：安裝工具 + dist + 模板 + 檔案清單&lt;br&gt;附註：來自 base 的哪個 commit、版本號" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="20" y="636" width="220" height="80" as="geometry"/></mxCell><mxCell id="g_other" value="其他工具的 dist image&lt;br&gt;agent_harness-dist:vY …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ghcr"><mxGeometry x="20" y="815" width="220" height="40" as="geometry"/></mxCell><mxCell id="ds" value="使用 base 的專案（downstream repo）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="800" height="460" as="geometry"/></mxCell><mxCell id="sa" value="啟動器（進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="20" y="70" width="250" height="250" as="geometry"/></mxCell><mxCell id="c_ref" value=".base-ref&lt;br&gt;（一行文字：要用哪個版本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sa"><mxGeometry x="15" y="60" width="105" height="50" as="geometry"/></mxCell><mxCell id="c_just" value="justfile&lt;br&gt;（使用者只需要記這個入口）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sa"><mxGeometry x="130" y="60" width="105" height="50" as="geometry"/></mxCell><mxCell id="sa_t" value="justfile 幾乎不用改；&lt;br&gt;.base-ref 由使用者手動改，或由機器人自動開升級 PR" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="sa"><mxGeometry x="10" y="125" width="115" height="100" as="geometry"/></mxCell><mxCell id="sb" value="使用者檔案（進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="290" y="70" width="230" height="250" as="geometry"/></mxCell><mxCell id="c_dockerfile" value="Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sb"><mxGeometry x="15" y="50" width="95" height="40" as="geometry"/></mxCell><mxCell id="c_entry" value="entrypoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sb"><mxGeometry x="120" y="50" width="95" height="40" as="geometry"/></mxCell><mxCell id="c_main" value="main.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sb"><mxGeometry x="15" y="100" width="95" height="40" as="geometry"/></mxCell><mxCell id="c_conf" value=".setup.conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sb"><mxGeometry x="120" y="100" width="95" height="40" as="geometry"/></mxCell><mxCell id="c_hooks" value="hooks（需要才建立）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sb"><mxGeometry x="15" y="150" width="200" height="40" as="geometry"/></mxCell><mxCell id="sb_t" value="第一次安裝時建立，之後屬於使用者，工具不會再覆蓋" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="sb"><mxGeometry x="10" y="195" width="210" height="50" as="geometry"/></mxCell><mxCell id="sc" value="工具安裝區（不進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="540" y="70" width="240" height="250" as="geometry"/></mxCell><mxCell id="c_wrapper" value=".base/wrapper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="15" y="50" width="100" height="40" as="geometry"/></mxCell><mxCell id="c_lib" value=".base/lib" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="125" y="50" width="100" height="40" as="geometry"/></mxCell><mxCell id="c_runtime" value=".base/runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="15" y="100" width="100" height="40" as="geometry"/></mxCell><mxCell id="c_stamp" value="印記檔&lt;br&gt;（版本 + 指紋）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="125" y="100" width="100" height="40" as="geometry"/></mxCell><mxCell id="c_compose" value="compose.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="15" y="150" width="100" height="40" as="geometry"/></mxCell><mxCell id="c_env" value=".env.generated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="sc"><mxGeometry x="125" y="150" width="100" height="40" as="geometry"/></mxCell><mxCell id="sc_t" value="每次安裝整批覆蓋；手動改了會被 verify 擋下" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="sc"><mxGeometry x="10" y="195" width="220" height="50" as="geometry"/></mxCell><mxCell id="ds_engine" value="安裝工具的容器（執行 base-dist:vX）&lt;br&gt;以使用者本人身分執行、只能碰這個專案、跑完就刪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="20" y="370" width="250" height="70" as="geometry"/></mxCell><mxCell id="host" value="使用者的電腦" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1640" y="80" width="200" height="460" as="geometry"/></mxCell><mxCell id="h_t" value="只需要裝這三個軟體" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="host"><mxGeometry x="10" y="40" width="180" height="30" as="geometry"/></mxCell><mxCell id="h_docker" value="Docker daemon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="host"><mxGeometry x="20" y="80" width="160" height="40" as="geometry"/></mxCell><mxCell id="h_just" value="just" style="rounded=1;whiteSpace=wrap;html=1;