;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv4" value="安裝工具本身／打包好可執行的檔案包／工具要出貨的檔案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1130" width="900" height="30" as="geometry"/></mxCell><mxCell id="p4_tk5" value="init.toml / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="170" height="30" as="geometry"/></mxCell><mxCell id="p4_tv5" value="init 要建立哪些檔的清單／專案裡的 justfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1160" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="6. 原型對照"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="970" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="原型對照：proto/ 三個資料夾 ↔ 框架裡的三種角色（原型的範例工具名是 tool，正式版對應 &amp;lt;name&amp;gt;）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="30" as="geometry"/></mxCell><mxCell id="row_t" value="原始碼（進 git，人維護）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="row_g" value="產物（不進 git，CI 產生）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="row_d" value="使用端（前三樣進 git）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="r_vk" value="vendor_kit repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="200" as="geometry"/></mxCell><mxCell id="r_vk_t" value="= proto/vendor_kit/" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="r_vk"><mxGeometry x="10" y="40" width="280" height="18" as="geometry"/></mxCell><mxCell id="f_vk" value="vendor_kit&lt;br&gt;（安裝工具程式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="20" y="70" width="120" height="50" as="geometry"/></mxCell><mxCell id="f_vkdf" value="Dockerfile&lt;br&gt;（打包食譜）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="r_vk"><mxGeometry x="160" y="70" width="120" height="50" as="geometry"/></mxCell><mxCell id="r_vk_n" value="vendor_kit 是產品本體；Dockerfile 只說明怎麼把它裝進 image" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="r_vk"><mxGeometry x="10" y="135" width="280" height="50" as="geometry"/></mxCell><mxCell id="r_tool" value="工具 repo" style="swimlane;html=1;rounded=1;startSize=3