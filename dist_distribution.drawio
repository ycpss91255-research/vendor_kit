ark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="dev"><mxGeometry x="20" y="50" width="380" height="80" as="geometry"/></mxCell><mxCell id="p3_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="220" height="60" as="geometry"/></mxCell><mxCell id="p3_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="720" width="110" height="60" as="geometry"/></mxCell><mxCell id="p3_lg2" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="410" y="730" width="88" height="40" as="geometry"/></mxCell><mxCell id="p3_lg3" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="518" y="730" width="130" height="40" as="geometry"/></mxCell><mxCell id="p3_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="668" y="720" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3_tk0" value="模板 / dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv0" value="dist = 工具要出貨的檔案，整批放進 .&amp;lt;name&amp;gt;/；模板 = dist 裡給初始檔用的樣板，diff 拿新版模板跟你的檔案比" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="830" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk1" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv1" value="git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="860" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk2" value="PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv2" value="GitHub 上的合併請求；merge 就是接受這次修改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="890" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk3" value="git bisect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv3" value="git 的二分搜尋：在 .version 的修改紀錄中找出哪次升級引入問題" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="920" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk4" value="image 附註" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv4" value="image 上的標籤（label）：記錄它來自工具 repo 的哪個 commit、什麼版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="950" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk5" value="digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv5" value="image 的內容指紋（sha256:…）；同一個 digest 永遠是同一份內容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="980" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk6" value=".version / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv6" value="專案裡記工具版本的檔／專案裡的 justfile，打 just 時它負責安裝與執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk7" value="install / diff / init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6