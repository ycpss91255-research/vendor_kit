<mxfile host="app.diagrams.net"><diagram id="p1" name="1. 架構圖"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="架構圖：base 工具怎麼送到各專案（模組 → 最小單元；線上的文字 = 傳輸的內容）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/></mxCell><mxCell id="vk" value="vendor_kit（安裝工具）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="320" height="320" as="geometry"/></mxCell><mxCell id="vk_t" value="負責把 base 的工具檔案寫進各專案；本身也打包成 image，其他工具的 image 都以它為基底" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="vk"><mxGeometry x="10" y="40" width="300" height="36" as="geometry"/></mxCell><mxCell id="vk_land" value="子命令 land（安裝）&lt;br&gt;依清單把工具檔案寫進專案的 .base/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="20" y="78" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_init" value="子命令 init（初始化）&lt;br&gt;第一次安裝時建立使用者要改的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="165" y="78" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_verify" value="子命令 verify（檢查）&lt;br&gt;確認 .base/ 沒有被人手動改過" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="20" y="132" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_diff" value="子命令 diff（比對）&lt;br&gt;升級時列出使用者檔案建議怎麼改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="165" y="132" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_manifest" value="檔案清單（manifest）格式&lt;br&gt;定義每個檔案屬於哪一類" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="20" y="186" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_stamp" value="印記檔格式&lt;br&gt;記錄安裝的版本 + 每個檔案的指紋" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="165" y="186" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_docker" value="Dockerfile&lt;br&gt;（把安裝工具打包成 image）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="20" y="240" width="135" height="46" as="geometry"/></mxCell><mxCell id="vk_ci" value="自動發佈流程（CI）&lt;br&gt;打包 image → 上傳到倉庫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="vk"><mxGeometry x="165" y="240" width="135" height="46" as="geometry"/></mxCell><mxCell id="base" value="base（現有工具，本體不變）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="320" height="360" as="geometry"/></mxCell><mxCell id="base_t" value="現有內容都不動；只新增右下三個白色的部分" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="base"><mxGeometry x="10" y="40" width="300" height="36" as="geometry"/></mxCell><mxCell id="b_wrapper" value="dist/wrapper&lt;br&gt;（build、run、exec、stop 這些指令）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="20" y="78" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_lib" value="dist/lib&lt;br&gt;（共用函式庫）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="165" y="78" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_runtime" value="dist/runtime&lt;br&gt;（在容器裡面跑的腳本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="20" y="132" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_tpl_df" value="模板：Dockerfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="165" y="132" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_tpl_ep" value="模板：entrypoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="20" y="186" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_tpl_conf" value="模板：.setup.conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="base"><mxGeometry x="165" y="186" width="135" height="46" as="geometry"/></mxCell><mxCell id="b_tpl_main" value="模板：main.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;s