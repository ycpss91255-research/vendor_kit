okeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv0" value="任何想透過 vendor_kit 出貨的工具的原始碼 repo；必須有 dist/、init.toml、Dockerfile.dist、CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="930" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk1" value="專案 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv1" value="使用工具的專案；必須有 .version、justfile、.vendor_kit/；可同時用多個工具" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="960" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk2" value="vendor_kit repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv2" value="我們要開發的：安裝工具的原始碼，打包成 vendor_kit image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk3" value="image / 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv3" value="image = 打包好的程式與檔案；容器 = image 執行起來的實例，跑完可刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1020" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv4" value="GitHub 提供的 image 倉庫；每個工具一個 &amp;lt;name&amp;gt;-dist image，以 vendor_kit image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1050" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk5" value=".version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv5" value="專案裡的 TOML 檔，一個工具一行 name = &quot;image:tag@sha256:…&quot;；name 決定安裝目錄 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1080" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk6" value=".version.local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv6" value="跟 .version 同格式的覆蓋檔，不進 git；開發工具本身時用它把某個工具指到本機路徑（第 4 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk7" value="baseline（基準）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv7" value=".vendor_kit/baseline/&amp;lt;name&amp;gt;/：上次確認過的模板副本，just vendor_kit diff 用它分出工具改了什麼、你改了什麼；vendor_kit 寫，人不改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1140" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk8" value="CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv8" value="放在 GitHub 上的自動化流程：打 tag 時建置 image 並上傳 GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk9" value="建置 / 上傳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv9" value="建置 = 照 Dockerfile 做出 image（docker build）；上傳 = 把 image 放到 GHCR（docker push）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk10" value="upgrade（升級）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv10" value="改 .version 換新版本。兩條路：機器人提出合併請求（PR，人 merge 後下次 just 才換新）；或 just vendor_kit upgrade（改完立即 install → diff）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk11" value="PR / merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv11" value="GitHub 上的合併請求／接受它，修改才進 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk12" value="上鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv12" value="安裝容器先對專案目錄上鎖：避免兩個 just 同時改同一個 .&amp;lt;name&amp;gt;/，後到的等前一個裝完（第 5 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk13" value="init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv13" value="工具 repo 給的清單：dist/ 裡哪個檔（src）在 init 時要複製到專案的哪裡（dest）；之後那些檔歸使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk14" value="just / justfile / .vendor_kit/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv14" value="just = 主機的指令跑器；.vendor_kit/ = 啟動器本體（vendor_kit 寫出，人不改；升級只換 vendor.just／tools.just／.stamp，baseline/ 不動）；justfile = 專案自己的指令清單，第一行 import .vendor_kit/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk15" value="印記檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv15" value=".&amp;lt;name&amp;gt;/.stamp：安裝時寫下「裝的 image + 每檔指紋」；啟動器只看第一行決定要不要重裝，內容以 image 內的 dist 為準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk16" value="tag / digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv16" value="image 的版本名稱（v0.43.0）／內容指紋（sha256:…）；.version 兩者都記，工具只認 digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk17" value="multi-arch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv17" value="同一個 image 名稱同時提供 amd64 與 arm64 兩種處理器版本，Docker 依主機自動選；支援平台 = Linux（含 WSL2）amd64／arm64" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk18" value="Dockerfile / Dockerfile.dist / FROM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv18" value="Dockerfile = 打包 image 的食譜；Dockerfile.dist = 工具 repo 出貨用的食譜；FROM = 食譜第一行，指定以哪個 image 為底" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk19" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv19" value="git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk20" value="compose 指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1530" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv20" value="docker compose：依設定檔啟動專案容器的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1530" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk21" value="TOML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv21" value="一種設定檔格式（key = &quot;value&quot;）；.version、init.toml 都用它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1560" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1b_tk22" value="install / init / verify / diff / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1b_tv22" value="安裝容器的子命令：把 dist 裝進 .&amp;lt;name&amp;gt;/ 並寫印記檔／第一次建立初始檔／拿 .&amp;lt;name&amp;gt;/ 跟 image 內的 dist 比／升級後三方比對／把新版模板存成基準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1590" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. 流程：使用者指令"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="2070" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程：使用者下的每個指令 → 啟動器叫哪個子命令 → 專案裡發生什麼" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="h_40" value="使用者" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="300" height="24" as="geometry"/></mxCell><mxCell id="h_380" value="啟動器（.vendor_kit/，在主機）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="h_800" value="安裝容器（vendor_kit）" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="360" height="24" as="geometry"/></mxCell><mxCell id="h_1240" value="專案目錄" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="380" height="24" as="geometry"/></mxCell><mxCell id="bA" value="第一次接上工具：just vendor_kit init" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1620" height="280" as="geometry"/></mxCell><mxCell id="a_u" value="just vendor_kit init" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bA"><mxGeometry x="60" y="70" width="180" height="50" as="geometry"/></mxCell><mxCell id="a_l1" value="讀版本檔（.version.local 優先，&lt;br&gt;否則 .version）一行一個工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=11;strokeWidth=1;" vertex="1" parent="bA"><mxGeometry x="375" y="67" width="150" height="56" as="geometry"/></mxCell><mxCell id="a_l2" value=".&amp;lt;name&amp;gt;/ 不存在&lt;br&gt;→ 要安裝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="bA"><mxGeometry x="560" y="70" width="160" height="50" as="geometry"/></mxCell><mxCell id="a_c1" value="install&lt;br&gt;dist/ 全部 → .&amp;lt;name&amp;gt;/&lt;br&gt;並寫印記（.&amp;lt;name&amp;gt;/.stamp：裝的 image + 每檔指紋）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;strokeWidth=2;" vertex="1" parent="bA"><mxGeometry x="800" y="60" width="340" height="70" as="geometry"/></mxCell><mxCell id="a_p1" value=".&amp;lt;name&amp;gt;/（新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bA"><mxGeometry x="1240" y="75" width="200" height="40" as="geometry"/></mxCell><mxCell id="a_c2" value="init&lt;br&gt;照 init.toml 複製初始檔（已存在：warn、不覆蓋）&lt;br&gt;並把這版模板存成基準" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;strokeWidth=2;" vertex="1" parent="bA"><mxGeometry x="800" y="165" width="340" height="60" as="geometry"/></mxCell><mxCell id="a_p2" value="Dockerfile / entrypoint / hooks…&lt;br&gt;（新；之後由你維護）&lt;br&gt;＋ .vendor_kit/baseline/&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="bA"><mxGeometry x="1240" y="165" width="200" height="60" as="geometry"/></mxCell><mxCell id="ae1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_u" target="a_l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_l1" target="a_l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_l2" target="a_c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae4" value="寫入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_c1" target="a_p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_c1" target="a_c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ae6" value="建立" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a_c2" target="a_p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="bB" value="日常：just &amp;lt;模組&amp;gt; build（建置）；run（啟動）／exec（進入）／stop（停止）流程相同" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1620" height="390" as="geometry"/></mxCell><mxCell id="b_u" value="just &amp;lt;模組&amp;gt; build" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="bB"><mxGeometry x="60" y="70" width="180" height="50" as="geometry"/></mxCell><mxCell id="b_l1" value="讀版本檔（.version.local 優先，&lt;br&gt;否則 .version）一行一個工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=11;strokeWidth=1;" vertex="1" parent="bB"><mxGeometry x="355" y="67" width="150" height="56" as="geometry"/></mxCell><mxCell id="b_note" value=".version 一行 = 一個工具：&lt;br&gt;&amp;lt;name&amp;gt; = &quot;…-dist:vX@sha256:…&quot;&lt;br&gt;等號左邊 = 工具名 → 目錄 .&amp;lt;name&amp;gt;/&lt;br&gt;等號右邊 = image → 跟 .&amp;lt;name&amp;gt;/.stamp 第一行比&lt;br&gt;每一行各跑一次右邊的流程；「否則」= 不同、尚未安裝、印記讀不到&lt;br&gt;例外：右邊是 path:（.version.local）→ 走第 4 頁本機開發模式；&lt;br&gt;vendor_kit 那行 → 換 .vendor_kit/ 程式檔（第 11 頁 C）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bB"><mxGeometry x="40" y="130" width="290" height="124" as="geometry"/></mxCell><mxCell id="b_l2" value=".&amp;lt;name&amp;gt;/.stamp 第一行&lt;br&gt;= .version 那行的 image？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="bB"><mxGeometry x="530" y="55" width="220" height="80" as="geometry"/></mxCell><mxCell id="b_c0" value="install&lt;br&gt;換成 .version 指定的版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="bB"><mxGeometry x="800" y="65" width="340" height="60" as="geometry"/></mxCell><mxCell id="b_l1n" value="（image 不在本機時，Docker 會先下載）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="bB"><mxGeometry x="340" y="126" width="220" height="24" as="geometry"/></mxCell><mxCell id="b_p0" value=".&amp;lt;name&amp;gt;/（換新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="bB"><mxGeometry x="1240" y="75" width="200" height="40" as="geometry"/></mxCell><mxCell id="b_c1" value="verify&lt;br&gt;.&amp;lt;name&amp;gt;/ 跟 image 內的 dist 逐檔比（缺、多、改都算）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;strokeWidth=2;" vertex="1" parent="bB"><mxGeometry x="800" y="170" width="340" height="60" as="geometry"/></mxCell><mxCell id="b_l3" value="執行 .&amp;lt;name&amp;gt;/ 內的 build（建置）腳本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=