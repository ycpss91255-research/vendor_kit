" value="commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="686" width="200" height="44" as="geometry"/></mxCell><mxCell id="t11d" value="git 的一次版本紀錄" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="686" width="900" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. 原型對照"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="原型對照：proto/ 三個資料夾 ↔ 真實 repo ↔ GHCR" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="row_t" value="原始碼（進 git，人維護）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="row_g" value="產物（不進 git，CI 產生）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="row_d" value="使用端（進 git 的只有前三個）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1000" y="70" width="300" height="20" as="geometry"/></mxCell><mxCell id="r_vk" value="vendor_kit repo" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;con