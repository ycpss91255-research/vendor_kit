eometry"/></mxCell><mxCell id="t6d" value="安裝時寫下的紀錄：版本 + 每個工具檔的指紋（不含使用者檔案）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="406" width="900" height="44" as="geometry"/></mxCell><mxCell id="t7k" value=".version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="200" height="44" as="geometry"/></mxCell><mxCell id="t7d" value="專案裡的版本清單：一個工具一行，記 image 的 digest（附 tag 供人看）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="462" width="900" height="44" as="geometry"/></mxCell><mxCell id="t8k" value="justfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="518" width="200" height="44" as="geometry"/></mxCell><mxCell id="t8d" value="使用者的唯一入口；打 just 指令就會執行" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="518" width="900" height="44" as="geometry"/></mxCell><mxCell id="t9k" value="自動發佈（CI）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="200" height="44" as="geometry"/></mxCell><mxCell id="t9d" value="放在 GitHub 上的自動化流程：打包 image 並上傳" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="260" y="574" width="900" height="44" as="geometry"/></mxCell><mxCell id="t10k" value="commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#