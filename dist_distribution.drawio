none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cn" value="待決（issue #14）：新啟動器會呼叫「工具 image 內建」的舊 vendor_kit，兩者版本會不一樣——參數、印記格式、init.toml 格式跨版本要相容到什麼程度？誰檢查？不相容時是拒絕、還是要求工具重新出 image？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="uC"><mxGeometry x="60" y="130" width="800" height="70" as="geometry"/></mxCell><mxCell id="uD" value="D. 回退（升上去發現壞了）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="1160" width="1560" height="220" as="geometry"/></mxCell><mxCell id="d0" value="git revert 那個升級 commit&lt;br&gt;（.version 那行改回舊版）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="uD"><mxGeometry x="60" y="55" width="220" height="60" as="geometry"/></mxCell><mxCell id="d1" value="下次 just：印記 ≠ .version&lt;br&gt;→ install 舊版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="uD"><mxGeometry x="600" y="60" width="280" height="50" as="geometry"/></mxCell><mxCell id="d2" value=".&amp;lt;name&amp;gt;/（舊版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="uD"><mxGeometry x="1280" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="de1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="de2" value="寫入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dn" value="待決：如果已經 just vendor_kit accept 過（baseline 變新版）才回退，git revert 同一個 commit 會把 baseline 一起退回，沒問題；但若 accept 是另一個 commit，就要一起 revert，否則 diff 會反向。要不要讓 accept 強制跟 .version 同一個 commit？&lt;br&gt;使用者自己改過的初始檔不會自動回復（工具不碰使用者檔）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="uD"><mxGeometry x="60" y="125" width="1480" height="70" as="geometry"/></mxCell><mxCell id="p12_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="220" height="60" as="geometry"/></mxCell><mxCell id="p12_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1410" width="110" height="60" as="geometry"/></mxCell><mxCell id="p12_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1420" width="130" height="40" as="geometry"/></mxCell><mxCell id="p12_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1420" width="130" height="40" as="geometry"/></mxCell><mxCell id="p12_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1420" width="200" height="40" as="geometry"/></mxCell><mxCell id="p12_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="1420" width="88" height="40" as="geometry"/></mxCell><mxCell id="p12_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="1420" width="170" height="40" as="geometry"/></mxCell><mxCell id="p12_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="1420" width="130" height="40" as="geometry"/></mxCell><mxCell id="p12_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="1410" width="300" height="60" as="geometry"/></mxCell><mxCell id="p12_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1496" width="200" height="20" as="geometry"/></mxCell><mxCell id="p12_tk0" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv0" value="GitHub 上的機器人：發現 GHCR 有新版就自動開 PR 改 .version；沒有它時用 just vendor_kit upgrade 手動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1520" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk1" value="CI / 煙霧測試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1550" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv1" value="CI = GitHub 上的自動檢查，PR 一開就跑；煙霧測試 = 最小的一次實跑（例如 just &amp;lt;模組&amp;gt; build 能過）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1550" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk2" value="GHCR / image / 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv2" value="GitHub 的 image 倉庫／打包好的程式與檔案／image 執行起來的實例；vendor_kit 與工具都以 image 出貨" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1580" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk3" value=".version / &amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1610" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv3" value="專案裡的工具版本清單（一行一個工具）／工具名，安裝目錄叫 .&amp;lt;name&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1610" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk4" value="just / just vendor_kit upgrade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1640" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv4" value="主機上的指令跑器，使用者打 just &amp;lt;指令&amp;gt;／手動升級的指令（B 路徑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1640" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk5" value="install / verify / diff / commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1670" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv5" value="裝進 .&amp;lt;name&amp;gt;/／檢查 .&amp;lt;name&amp;gt;/ 沒被改／三方比對／git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1670" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk6" value="vendor_kit / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv6" value="通用安裝工具（容器內跑）／專案裡的 .vendor_kit/：just 用的標準指令，vendor_kit 寫出、人不改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1700" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk7" value="justfile / vendor.just / tools.just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1730" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv7" value="使用者自己的指令清單（第一行 mod? vendor_kit）／vendor_kit 的標準指令檔（just vendor_kit …）／依 .version 產生的工具指令清單；C 只換後兩者與 .stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1730" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk8" value="TOML / regex manager / init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv8" value="設定檔格式／Renovate 用「找字串」的方式改自訂檔案的設定／工具的初始檔清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1760" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk9" value="tag / digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv9" value="image 的版本名稱／內容指紋；.version 兩者都記，一起換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1790" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk10" value="PR / merge / revert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1820" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv10" value="GitHub 上的合併請求／接受它／用 git 把某次修改整個倒回去" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1820" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk11" value="印記第一行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1850" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv11" value=".&amp;lt;name&amp;gt;/.stamp 第一行 = 裝的是哪個 image；跟 .version 那行不同就重裝（第 3 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1850" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk12" value="baseline / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1880" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv12" value="上次確認過的範本副本／告訴工具「這版我看完了」（第 5 頁、issue #22）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1880" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk13" value="bootstrap（在 C 裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1910" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv13" value="同第 10 頁的子命令，這裡只重寫 .vendor_kit/ 的程式檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1910" width="900" height="30" as="geometry"/></mxCell><mxCell id="p12_tk14" value="issue #14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1940" width="170" height="30" as="geometry"/></mxCell><mxCell id="p12_tv14" value="相容性承諾這一題的 GitHub 討論串" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1940" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p13" name="12. 對外契約與 CI 隔離"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="對外契約 ── vendor_kit 對外承諾的每一個介面，以及 CI 怎麼隔離（GitHub / GitLab 都只呼叫我們的腳本）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="p13_pend" value="⚠ 待你回覆：GitLab 拉 GHCR 私有 image 的 token 放哪？要不要推兩個 registry？契約檢查腳本用 sh 還是 just？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="10" width="440" height="64" as="geometry"/></mxCell><mxCell id="ct" value="對外契約（五個介面）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1370" height="440" as="geometry"/></mxCell><mxCell id="ct_h0" value="契約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="20" y="50" width="190" height="30" as="geometry"/></mxCell><mxCell id="ct_h1" value="誰對誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="50" width="220" height="30" as="geometry"/></mxCell><mxCell id="ct_h2" value="內容（承諾不會隨便改的部分）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="50" width="620" height="30" as="geometry"/></mxCell><mxCell id="ct_h3" value="誰用它來測" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="50" width="300" height="30" as="geometry"/></mxCell><mxCell id="ct_r0c0" value="① 使用者介面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;" vertex="1" parent="ct"><mxGeometry x="20" y="80" width="190" height="52" as="geometry"/></mxCell><mxCell id="ct_r0c1" value="使用者 → 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="80" width="220" height="52" as="geometry"/></mxCell><mxCell id="ct_r0c2" value="just 指令名與行為：init / diff / accept / upgrade / dev / undev（第 9 頁）；bootstrap.sh 的用法；結束狀態（0 成功／非 0 失敗；diff 為 0 無差異／1 工具有改／2 可能重疊）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="80" width="620" height="52" as="geometry"/></mxCell><mxCell id="ct_r0c3" value="acceptance 測試（第 8 頁）；下游的 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="80" width="300" height="52" as="geometry"/></mxCell><mxCell id="ct_r1c0" value="② 啟動器 ↔ 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;" vertex="1" parent="ct"><mxGeometry x="20" y="132" width="190" height="52" as="geometry"/></mxCell><mxCell id="ct_r1c1" value=".vendor_kit/vendor.just → vendor_kit 容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="132" width="220" height="52" as="geometry"/></mxCell><mxCell id="ct_r1c2" value="docker run 的參數：-u UID:GID、-v 專案:/repo；argv：--name --self --repo --dist + 子命令 install / init / verify / diff / accept / bootstrap / upgrade；結束狀態 0/1/2；image 內 /dist 的佈局（files/、init.toml、VERSION）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="132" width="620" height="52" as="geometry"/></mxCell><mxCell id="ct_r1c3" value="system 測試（docker run 每個子命令）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="132" width="300" height="52" as="geometry"/></mxCell><mxCell id="ct_r2c0" value="③ 專案裡的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;" vertex="1" parent="ct"><mxGeometry x="20" y="184" width="190" height="52" as="geometry"/></mxCell><mxCell id="ct_r2c1" value="vendor_kit → 專案 repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="184" width="220" height="52" as="geometry"/></mxCell><mxCell id="ct_r2c2" value=".version 格式（TOML，[tools] 一行一工具 &amp;lt;name&amp;gt; = &quot;image:tag@sha256&quot;，含 vendor_kit 行）；.version.local；.vendor_kit/ 佈局（vendor.just、tools.just、.stamp、baseline/&amp;lt;name&amp;gt;/）；.&amp;lt;name&amp;gt;/.stamp 格式（第一行 image，之後 sha256 路徑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="184" width="620" height="52" as="geometry"/></mxCell><mxCell id="ct_r2c3" value="integration 測試（bootstrap / install 寫出的檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="184" width="300" height="52" as="geometry"/></mxCell><mxCell id="ct_r3c0" value="④ 工具 repo 要交的" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;" vertex="1" parent="ct"><mxGeometry x="20" y="236" width="190" height="52" as="geometry"/></mxCell><mxCell id="ct_r3c1" value="工具 repo → vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="236" width="220" height="52" as="geometry"/></mxCell><mxCell id="ct_r3c2" value="dist/（全部出貨、與架構無關、不含 symlink）；init.toml 格式（[[file]] src/dest）；dist/just/tool.just（工具自己的指令）；Dockerfile.dist（FROM vendor_kit + COPY）；image 命名 &amp;lt;name&amp;gt;-dist:tag，multi-arch（amd64 + arm64）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="236" width="620" height="52" as="geometry"/></mxCell><mxCell id="ct_r3c3" value="env-test / release-test（用 fixtures 假工具）；工具 repo 的 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="236" width="300" height="52" as="geometry"/></mxCell><mxCell id="ct_r4c0" value="⑤ 給下游的 CI 腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;fontStyle=1;" vertex="1" parent="ct"><mxGeometry x="20" y="288" width="190" height="52" as="geometry"/></mxCell><mxCell id="ct_r4c1" value="vendor_kit → 專案／工具 repo 的 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="210" y="288" width="220" height="52" as="geometry"/></mxCell><mxCell id="ct_r4c2" value="一組平台無關的測試腳本（下方），內容 = 上面四條契約的檢查；GitHub / GitLab 的 CI 檔只負責呼叫它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="430" y="288" width="620" height="52" as="geometry"/></mxCell><mxCell id="ct_r4c3" value="下游 CI（GitHub Actions 或 GitLab CI 皆可）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="ct"><mxGeometry x="1050" y="288" width="300" height="52" as="geometry"/></mxCell><mxCell id="ct_n" value="待決（issue #14）：契約版本號寫在哪（.vendor_kit/.stamp？image label？），哪些改動算破壞相容（要升大版）、誰檢查啟動器與容器內 vendor_kit 版本不合。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="ct"><mxGeometry x="20" y="350" width="1330" height="44" as="geometry"/></mxCell><mxCell id="ci" value="CI 隔離：CI 平台檔只呼叫我們的腳本，換平台不用改測試" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1370" height="300" as="geometry"/></mxCell><mxCell id="ci_gh" value="GitHub Actions&lt;br&gt;.github/workflows/*.yaml（薄：只呼叫）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="ci"><mxGeometry x="20" y="50" width="320" height="50" as="geometry"/></mxCell><mxCell id="ci_gl" value="GitLab CI&lt;br&gt;.gitlab-ci.yml（薄：只呼叫）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="ci"><mxGeometry x="20" y="120" width="320" height="50" as="geometry"/></mxCell><mxCell id="ci_sc" value="vendor_kit 出貨的測試腳本（平台無關）&lt;br&gt;test/ci/check.sh：bootstrap 檢查 → install → verify → diff 結束狀態&lt;br&gt;（只需要 docker + git + just）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="ci"><mxGeometry x="420" y="50" width="420" height="120" as="geometry"/></mxCell><mxCell id="ci_bake" value="docker buildx bake validate / release&lt;br&gt;（vendor_kit 自己的測試，第 8 頁）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="ci"><mxGeometry x="920" y="50" width="380" height="50" as="geometry"/></mxCell><mxCell id="ci_reg" value="image 倉庫：GHCR 或 GitLab Container Registry&lt;br&gt;（.version 記完整位址，docker login 就能拉；Renovate 兩邊都支援）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="ci"><mxGeometry x="920" y="120" width="380" height="60" as="geometry"/></mxCell><mxCell id="cie1" value="呼叫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2083;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_gh" target="ci_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cie2" value="呼叫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7917;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_gl" target="ci_sc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cie3" value="vendor_kit&lt;br&gt;repo 內" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.2083;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_sc" target="ci_bake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cie4" value="拉 image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.8333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_sc" target="ci_reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ci_n" value="待決：GitLab 拉 GHCR 私有 image 要放 token（GitLab CI 變數）；要不要同時推到兩個 registry？測試腳本用 sh 還是 just recipe（just 在 CI runner 也要裝）？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="ci"><mxGeometry x="20" y="200" width="1300" height="44" as="geometry"/></mxCell><mxCell id="p13_lg0" value="紅：我們要開發的模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="200" height="60" as="geometry"/></mxCell><mxCell id="p13_lg1" value="黃：外部（使用者、外部系統）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="870" width="220" height="60" as="geometry"/></mxCell><mxCell id="p13_lg2" value="紫：image / container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="880" width="180" height="40" as="geometry"/></mxCell><mxCell id="p13_lg3" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="870" width="200" height="60" as="geometry"/></mxCell><mxCell id="p13_lg4" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="920" y="880" width="120" height="40" as="geometry"/></mxCell><mxCell id="p13_lgt" value="實線 = 呼叫／依賴方向" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1060" y="870" width="300" height="60" as="geometry"/></mxCell><mxCell id="p13_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="200" height="20" as="geometry"/></mxCell><mxCell id="p13_tk0" value="對外契約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv0" value="我們承諾「這樣用一定可以、不會隨便改」的介面清單；改了就要升版並公告" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="980" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk1" value="啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv1" value=".vendor_kit/ 裡 vendor_kit 寫出的 just 指令（第 2、10 頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk2" value="argv / 子命令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv2" value="傳給容器內程式的參數／install、init 這些動作名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1040" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk3" value="GitHub Actions / GitLab CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv3" value="兩家平台各自的自動化流程；設定檔格式不同，所以我們的測試不寫在裡面，寫在自己的腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1070" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk4" value="GHCR / GitLab Container Registry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv4" value="GitHub 與 GitLab 各自的 image 倉庫；都是標準 Docker registry，位址不同而已" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1100" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk5" value="multi-arch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv5" value="同一個 image 名稱同時有 amd64 與 arm64 版本；.version 鎖的 digest 是這組的索引" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1130" width="900" height="30" as="geometry"/></mxCell><mxCell id="p13_tk6" value="issue #14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="170" height="30" as="geometry"/></mxCell><mxCell id="p13_tv6" value="相容性承諾這一題的 GitHub 討論串" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1160" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>