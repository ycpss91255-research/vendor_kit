er + Git + just）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="740" height="560" as="geometry"/></mxCell><mxCell id="col1" value="進 git" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="20" y="50" width="220" height="290" as="geometry"/></mxCell><mxCell id="c_ref" value=".base-ref（base 版本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="col1"><mxGeometry x="20" y="50" width="180" height="40" as="geometry"/></mxCell><mxCell id="c_just" value="justfile（launcher）&lt;br&gt;極薄、很少變動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="col1"><mxGeometry x="20" y="110" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1_t" value="版本由使用者或 Renovate 修改；launcher 帶契約版本號" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="col1"><mxGeometry x="10" y="180" width="200" height="60" as="geometry"/></mxCell><mxCell id="col2" value="進 git・使用者檔案" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="ds"><mxGeometry x="260" y="50" width="220" height="290" as="geometry"/></mxCell><mxCell id="c2_t" value="seed-once：init 建立一次，之後屬於使用者" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="col2"><mx