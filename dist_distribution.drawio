"/></mxCell><mxCell id="e_from_base" value="以安裝工具 image 為基底" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="g_vk" target="g_base"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_from_other" value="以安裝工具 image 為基底" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="g_vk" target="g_other"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_pull" value="下載 image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_base" target="ds_engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_ref" value="要用的版本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_ref" target="c_just"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_run" value="啟動容器的參數：版本、使用者身分、專案路徑" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.73;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_just" target="ds_engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_verb" value="使用者下的指令（build / run …）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_just" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_conf" value="使用者的設定（要跑哪個階段、掛哪些資料夾、開哪些 port）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.48;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_conf" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_land" value="寫入：工具檔案 + 印記檔 ／ 讀回：印記檔（用來檢查）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;startArrow=block;startFill=1;" edge="1" parent="1" source="ds_engine" target="sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_seed" value="首次安裝才建立的使用者檔案" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ds_engine" target="sb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_compose" value="啟動專案容器的指令 + 產生的 compose.yaml" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=10;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sc" target="h_docker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_note" value="名詞說明&lt;br&gt;・image：打包好的程式與檔案，下載後可直接執行；容器 = image 執行起來的那個實例&lt;br&gt;・dist：base 要送給各專案用的那批工具檔案&lt;br&gt;・檔案清單（manifest）：列出每個檔案、以及它屬於「工具擁有／第一次建立／可選」哪一類&lt;br&gt;・指紋（hash）：由檔案內容算出的一串碼，內容一改就不同，用來偵測檔案有沒有被動過&lt;br&gt;・印記檔：安裝時寫下的紀錄（版本 + 每個檔案的指紋），用來判斷要不要重裝、有沒有被手改&lt;br&gt;・CI：放在 GitHub 上的自動化流程；commit：git 的一次版本紀錄" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="1040" height="130" as="geometry"/></mxCell><mxCell id="p1_lg0" value="紅：新建模組" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1_lg1" value="綠：現有模組（本體不變）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="1000" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1_lg2" value="黃：外部系統（不由我們維護）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="1000" width="220" height="60" as="geometry"/></mxCell><mxCell id="p1_lg3" value="白：新建單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="760" y="1010" width="120" height="40" as="geometry"/></mxCell><mxCell id="p1_lg4" value="灰：現有單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCCCCC;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="890" y="1010" width="120" height="40" as="geometry"/></mxCell><mxCell id="p1_lg5" value="紫：image / container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1020" y="1010" width="160" height="40" as="geometry"/></mxCell><mxCell id="p1_lg6" value="實線 = 傳輸內容（線上文字說明傳什麼）&lt;br&gt;虛線 = 建立在它之上，或只在特定情況發生" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1000" width="260" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. 流程：啟動器"><mxGraphModel dx="1400" dy="900" grid="