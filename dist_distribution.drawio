410" y="890" width="88" height="40" as="geometry"/></mxCell><mxCell id="p3_lg3" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="518" y="890" width="130" height="40" as="geometry"/></mxCell><mxCell id="p3_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="668" y="880" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="966" width="200" height="20" as="geometry"/></mxCell><mxCell id="p3_tk0" value="模板 / dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv0" value="dist = 工具要出貨的檔案，整批放進 .&amp;lt;name&amp;gt;/；模板 = dist 裡給初始檔用的樣板，diff 拿新版模板跟你的檔案比" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk1" value="掛進來 / 完整性檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv1" value="掛進來 = 把本機的 dist 資料夾直接接進容器當作 image 內的 dist（改了馬上生效）／完整性檢查 = verify 比對 .&amp;lt;name&amp;gt;/ 有沒有被改，本機模式下跳過只印警告" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1020" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk2" value="三方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv2" value="diff 比的三份：基準（上次確認過的模板）、新版模板、你的檔；才能分出工具改了什麼、你改了什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1050" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk3" value="印記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv3" value=".&amp;lt;name&amp;gt;/.stamp：第一行 = 裝的是哪個 image；本機開發時寫 dev:&amp;lt;路徑&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1080" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk4" value="Renovate / just vendor_kit upgrade / vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv4" value="自動開 PR 改 .version 的機器人／手動升級指令／通用安裝工具（容器內跑），第 11 頁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk5" value="commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv5" value="git 的一次版本紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1140" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk6" value="PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv6" value="GitHub 上的合併請求；merge 就是接受這次修改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk7" value="git bisect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv7" value="git 的二分搜尋：在 .version 的修改紀錄中找出哪次升級引入問題" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk8" value="image 附註" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv8" value="image 上的標籤（label）：記錄它來自工具 repo 的哪個 commit、什麼版本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk9" value="digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv9" value="image 的內容指紋（sha256:…）；同一個 digest 永遠是同一份內容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk10" value=".version / 啟動器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv10" value="專案裡記工具版本的檔／專案裡的 .vendor_kit/（vendor_kit 寫出的標準 just 指令），打 just 時它負責安裝與執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk11" value="install / diff / init.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv11" value="安裝子命令／升級後比對子命令／init 要建立哪些檔的清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk12" value="工具 repo / GHCR / image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv12" value="工具的原始碼 repo／GitHub 的 image 倉庫／打包好可執行的檔案包" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk13" value="&amp;lt;name&amp;gt; / just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv13" value="&amp;lt;name&amp;gt; = .version 裡的工具名，安裝目錄就叫 .&amp;lt;name&amp;gt;/；just = 主機上的指令跑器，使用者打 just &amp;lt;指令&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1380" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk14" value=".version.local / dev:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv14" value="跟 .version 同格式、不進 git 的覆蓋檔，有它那行就優先；印記第一行的 dev: 前綴 = 這個 .&amp;lt;name&amp;gt;/ 來自本機路徑，不是正式 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1410" width="900" height="30" as="geometry"/></mxCell><mxCell id="p3_tk15" value="基準 / accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="p3_tv15" value="基準 = .vendor_kit/baseline/&amp;lt;name&amp;gt;/ 裡上次確認過的模板副本；just vendor_kit accept &amp;lt;name&amp;gt; = 看完差異後把新版模板存成基準" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5. 流程：vendor_kit 內部"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1750" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程：vendor_kit 內部——五個子命令（install 是核心）；全部在容器內執行；bootstrap 見第 10 頁" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p4_pend" value="⚠ 待你回覆：1. 主機腳本執行到一半時 .&amp;lt;name&amp;gt;/ 被另一個 just 換掉：第一版不防、寫進限制？&lt;br&gt;2. install 進行中 .version 被改（另一邊 git checkout）：照原本讀到的版本裝完？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="10" width="800" height="64" as="geometry"/></mxCell><mxCell id="install" value="install（核心：把 dist/ 放進 .&amp;lt;name&amp;gt;/）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="460" height="1060" as="geometry"/></mxCell><mxCell id="l0" value="開始 install" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="install"><mxGeometry x="250" y="50" width="160" height="50" as="geometry"/></mxCell><mxCell id="l1" value="對專案目錄上鎖（排他）&lt;br&gt;拿不到：等最多 60 秒（可調；設 0 = 立即失敗）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="install"><mxGeometry x="205" y="130" width="250" height="50" as="geometry"/></mxCell><mxCell id="l1q" value="拿到鎖？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="install"><mxGeometry x="240" y="210" width="180" height="80" as="geometry"/></mxCell><mxCell id="l_err" value="逾時或鎖不支援：中止，&lt;br&gt;不動任何檔（可用環境變數&lt;br&gt;強制不鎖，風險自負）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="install"><mxGeometry x="15" y="325" width="190" height="70" as="geometry"/></mxCell><mxCell id="l2" value="重讀版本檔與印記第一行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="install"><mxGeometry x="230" y="330" width="200" height="40" as="geometry"/></mxCell><mxCell id="l3" value="印記已是&lt;br&gt;目標版本？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="install"><mxGeometry x="240" y="400" width="180" height="80" as="geometry"/></mxCell><mxCell id="l_skip" value="跳過複製（別人剛裝好）&lt;br&gt;仍做一次 verify 比對" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="install"><mxGeometry x="15" y="520" width="190" height="50" as="geometry"/></mxCell><mxCell id="l4" value="清掉殘留的 .&amp;lt;name&amp;gt;.tmp.*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=