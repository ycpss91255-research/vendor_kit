ize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1232" width="140" height="64" as="geometry"/></mxCell><mxCell id="p15c_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1240" width="150" height="44" as="geometry"/></mxCell><mxCell id="p15c_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1234" width="210" height="56" as="geometry"/></mxCell><mxCell id="p15c_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1234" width="200" height="56" as="geometry"/></mxCell><mxCell id="p15c_lg5" value="白：CI job 做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1242" width="100" height="40" as="geometry"/></mxCell><mxCell id="p15c_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1242" width="170" height="40" as="geometry"/></mxCell><mxCell id="p15c_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1232" width="260" height="60" as="geometry"/></mxCell><mxCell id="p15c_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="250" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1300" width="120" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1300" width="170" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_img" value="紫：image（引擎與下游）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="1300" width="170" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1300" width="170" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="1300" width="200" height="36" as="geometry"/></mxCell><mxCell id="p15c_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1196" y="1290" width="30" height="20" as="geometry"/></mxCell><mxCell id="p15c_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="200" height="28" as="geometry"/></mxCell><mxCell id="p15c_tk0" value="候選 tag／正式 tag" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1384" width="150" height="55" as="geometry"/></mxCell><mxCell id="p15c_tv0" value="候選 image 先以候選 tag（vN-rc.&amp;lt;n&amp;gt; 或 candidate-&amp;lt;sha&amp;gt;）推上 GHCR；index inspect 與資產都對候選 tag 做；全過才 docker buildx imagetools create 打正式 GHCR image tag vN（不重 build、index digest 不變）；Git tag vN 是 repo 上的另一個物件，圖上分開標" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1384" width="610" height="55" as="geometry"/></mxCell><mxCell id="p15c_tk1" value="多架構 image／index digest（#26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1439" width="150" height="71" as="geometry"/></mxCell><mxCell id="p15c_tv1" value="兩個 runner（amd64、arm64 原生）各自單平台 build + release-test，綠了才 push-by-digest，由單一 job 以 docker buildx imagetools create 合成 index（不是同一次 buildx --platform 多平台；兩 runner 各自 push 同 tag 會互相覆蓋）；index 的 sha256 = version.toml 鎖定用的 digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1439" width="610" height="71" as="geometry"/></mxCell><mxCell id="p15c_tk2" value="bootstrap.sh（release 資產）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1510" width="150" height="71" as="geometry"/></mxCell><mxCell id="p15c_tv2" value="release 附的 POSIX sh 薄層，內嵌所屬引擎的完整 ref（ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:vN@sha256:&amp;lt;index digest&amp;gt;）；檔名固定：releases/download/vN/bootstrap.sh，README 連 releases/latest/download/bootstrap.sh；離線契約入口 = bootstrap.sh --local &amp;lt;tar&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1510" width="610" height="71" as="geometry"/></mxCell><mxCell id="p15c_tk3" value="tar／.digest／SHA256SUMS（#27、Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1384" width="150" height="71" as="geometry"/></mxCell><mxCell id="p15c_tv3" value="各平台 docker save 的 tar 旁附同名 .digest 旁檔（一行 sha256:&amp;lt;hex64&amp;gt; = 正式 index digest）；SHA256SUMS 涵蓋 bootstrap.sh、各平台 tar 與 .digest、離線包、lnav format 檔（不含自身）；離線包 vendor_kit-vN-local.tar.gz 含 bootstrap.sh、各平台 tar + .digest，另附 local_bootstrap.sh 便利包裝（非契約，v2.7-1）；Release 另附 lnav format 檔（§4.10）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1384" width="610" height="71" as="geometry"/></mxCell><mxCell id="p15c_tk4" value="LABEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1455" width="150" height="40" as="geometry"/></mxCell><mxCell id="p15c_tv4" value="引擎 image build 時帶 io.github.&amp;lt;org&amp;gt;.vendor_kit=1、….protocol=&amp;lt;floor_P&amp;gt;-&amp;lt;current_P&amp;gt;、….schema=&amp;lt;N&amp;gt;（啟動器不起容器即可判最低介面版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1455" width="610" height="40" as="geometry"/></mxCell><mxCell id="p15c_tk5" value="SemVer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1495" width="150" height="55" as="geometry"/></mxCell><mxCell id="p15c_tv5" value="版本號 major.minor.patch；update 取 tags/list 中 SemVer 最大的正式版（預發行如 -rc 排除）；major = 提高最低介面版或需要下游使用者手動步驟；minor = 新功能（含介面版 +1、新增欄位）；patch = 修正；Renovate preset 建議 major 分開 PR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1495" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;ve14g：短箭頭標籤擁擠。&lt;br&gt;v11n：便條貼邊。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1566" width="520" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p16" name="62 流程 v2：離線包（1）bootstrap.sh --local"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="2349" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：離線包（1）── bootstrap.sh --local → 判別值 → load → image ID → 介面版（#27、Q26）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q26、v2.6-1、v2.7-1／-2、v2.8-4／-5、v2.13 P4、v2.15-2／-14／-17、v2.16-4、interface_spec §1.2、§4.8、§7.4-16／17）：契約入口 = bootstrap.sh --local &amp;lt;引擎 tar&amp;gt;，只涉及引擎（local_bootstrap.sh 非契約）；先驗 git／just 再建執行紀錄；--local 依序判別（.tar 結尾 → 檔案；否則含 / 且有同名檔 → 6-37；否則 tag）；最低介面版檢查在起容器之前（斷網也回 3）；tar 附同名 .digest；install 第一個寫入前建 .tmp.install；version.toml 寫正式 ref@digest；離線 upgrade 不支援。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="116" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者（離線機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="230" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="bootstrap.sh（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="136" width="400" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="docker daemon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="136" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="bootstrap.sh（tag 形分支）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="136" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="136" width="280" height="28" as="geometry"/></mxCell><mxCe