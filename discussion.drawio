strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA"><mxGeometry x="290" y="252" width="220" height="48" as="geometry"/></mxCell><mxCell id="n0l_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="486" y="242" width="30" height="20" as="geometry"/></mxCell><mxCell id="n0x" value="1 + 6-38：執行紀錄建不了／寫不進（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=12;spacingBottom=12;" vertex="1" parent="eA"><mxGeometry x="990" y="236" width="200" height="80" as="geometry"/></mxCell><mxCell id="n0x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="1166" y="226" width="30" height="20" as="geometry"/></mxCell><mxCell id="npq" value="偵測到既有進度檔（.tmp.*.toml／metadata [progress]）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=36;spacingBottom=36;" vertex="1" parent="eA"><mxGeometry x="280" y="336" width="240" height="143" as="geometry"/></mxCell><mxCell id="npq_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="496" y="326" width="30" height="20" as="geometry"/></mxCell><mxCell id="npx" value="1 + 6-33：偵測到未完成的 sync（&amp;lt;id&amp;gt;）。請先重跑：just vendor_kit sync &amp;lt;targets&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=18;spacingBottom=18;" vertex="1" parent="eA"><mxGeometry x="20" y="346" width="220" height="124" as="geometry"/></mxCell><mxCell id="npx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="216" y="336" width="30" height="20" as="geometry"/></mxCell><mxCell id="n1x" value="1：版本鎖定行命中 ≠ 1（缺或重複）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="eA"><mxGeometry x="20" y="525" width="220" height="58" as="geometry"/></mxCell><mxCell id="n1x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="216" y="515" width="30" height="20" as="geometry"/></mxCell><mxCell id="n1" value="否：grep version.toml 的 vendor_kit 版本鎖定行取引擎 ref（命中須恰 1；version.local.toml 本機覆寫優先）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA"><mxGeometry x="300" y="514" width="240" height="79" as="geometry"/></mxCell><mxCell id="n1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="516" y="504" width="30" height="20" as="geometry"/></mxCell><mxCell id="n2" value="讀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="eA"><mxGeometry x="1220" y="499" width="360" height="110" as="geometry"/></mxCell><mxCell id="n2_0" value=".vendor_kit/version.toml（進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="n2"><mxGeometry x="8" y="26" width="344" height="26" as="geometry"/></mxCell><mxCell id="n2_1" value=".vendor_kit/version.local.toml（不進 git，dev 用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="n2"><mxGeometry x="8" y="58" width="344" height="42" as="geometry"/></mxCell><mxCell id="n3n" value="1 + 6-1：vendor_kit 已更新 vX → vY，請執行 just vendor_kit upgrade vendor_kit" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=15;spacingBottom=15;" vertex="1" parent="eA"><mxGeometry x="20" y="665" width="220" height="102" as="geometry"/></mxCell><mxCell id="n3n_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="216" y="655" width="30" height="20" as="geometry"/></mxCell><mxCell id="n3" value="gen/.stamp 的引擎 ref ＝ 版本鎖定行？（缺 gen/.stamp → 改以薄殼自描述首行 engine= 比對）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=70;spacingRight=70;spacingTop=44;spacingBottom=44;" vertex="1" parent="eA"><mxGeometry x="260" y="629" width="280" height="174" as="geometry"/></mxCell><mxCell id="n3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="516" y="619" width="30" height="20" as="geometry"/></mxCell><mxCell id="n6" value="統一提示（Q10 (2)、v2.3 §2）：啟動器發現 gen/.stamp ≠ 引擎 ref → 退出 1 印 6-1「vendor_kit 已更新 vX → vY，請執行：just vendor_kit upgrade vendor_kit」；不自動重寫、不自動續跑；install／升引擎不受此關" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="eA"><mxGeometry x="1220" y="676" width="360" height="79" as="geometry"/></mxCell><mxCell id="n6_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="1556" y="666" width="30" height="20" as="geometry"/></mxCell><mxCell id="nq" value="快路徑：grep 全相符且非 CI 模式？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=28;spacingBottom=28;" vertex="1" parent="eA"><mxGeometry x="280" y="823" width="240" height="112" as="geometry"/></mxCell><mxCell id="nq_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="496" y="813" width="30" height="20" as="geometry"/></mxCell><mxCell id="nqr" value="快路徑（Q22、§3.6）：啟動器只 grep：[tools] 每行 digest == gen/&amp;lt;repo&amp;gt;.stamp 第一行（或 path:&amp;lt;dir&amp;gt;）；每個 cache/&amp;lt;repo&amp;gt;/ 存在（目錄或 symlink；印記在而 cache 被刪 → 不走快路徑）；gen/tools.just 存在；非 CI 模式；sync 無參數。全相符 → 寫執行紀錄後 0；否則起引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="eA"><mxGeometry x="1220" y="824" width="360" height="110" as="geometry"/></mxCell><mxCell id="nqr_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="1556" y="814" width="30" height="20" as="geometry"/></mxCell><mxCell id="nq0" value="0：不起容器，接著跑原本的 recipe（快路徑）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="eA"><mxGeometry x="20" y="958" width="220" height="58" as="geometry"/></mxCell><mxCell id="nq0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="216" y="948" width="30" height="20" as="geometry"/></mxCell><mxCell id="nqf" value="是：執行紀錄寫 sync_fast_path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA"><mxGeometry x="260" y="962" width="117" height="48" as="geometry"/></mxCell><mxCell id="nqf_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA"><mxGeometry x="353" y="952" width="3