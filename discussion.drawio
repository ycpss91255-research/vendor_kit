ffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1489" width="88" height="40" as="geometry"/></mxCell><mxCell id="p5_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1489" width="170" height="40" as="geometry"/></mxCell><mxCell id="p5_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1479" width="300" height="60" as="geometry"/></mxCell><mxCell id="p5_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1547" width="220" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1547" width="120" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1547" width="170" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="1547" width="130" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="1547" width="160" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="1547" width="100" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1547" width="130" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1210" y="1547" width="180" height="36" as="geometry"/></mxCell><mxCell id="p5_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1366" y="1537" width="30" height="20" as="geometry"/></mxCell><mxCell id="p5_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1587" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p5_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1633" width="200" height="28" as="geometry"/></mxCell><mxCell id="p5_tk0" value="bootstrap.sh 檔名與內嵌 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1667" width="150" height="71" as="geometry"/></mxCell><mxCell id="p5_tv0" value="release 附的 POSIX sh，內嵌所屬引擎的完整 ref（ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:vN@sha256:&amp;lt;index digest&amp;gt;）；檔名固定：releases/download/vN/bootstrap.sh，README 連 releases/latest/download/bootstrap.sh；離線契約入口 = bootstrap.sh --local &amp;lt;tar&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1667" width="610" height="71" as="geometry"/></mxCell><mxCell id="p5_tk1" value="release／tar／.digest／docker load" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1738" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5_tv1" value="release = GitHub 上發布的一版（附 bootstrap.sh）；tar = 離線包（docker save 存的 image 檔），每個 tar 附同名 .digest 旁檔 = 正式 index digest（Q26；旁檔缺 → 1）；docker load = 把 tar 讀進本機 docker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1738" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5_tk2" value="--local &amp;lt;image tag 或 tar&amp;gt;（B1，依序互斥）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1793" width="150" height="86" as="geometry"/></mxCell><mxCell id="p5_tv2" value="以 .tar 結尾 → 檔案路徑（必須存在，否則 1）；否則值含 / 且存在同名檔 → 1 + 6-37 消歧；否則 → image tag（含 / 但無同名檔的完整 ref 也是 tag 形）。tar 形：docker load 後由同名 .digest 旁檔取 index digest；tag 形：不讀 .digest、只 docker image inspect 本機 image ID；version.toml 仍寫正式 ref@digest（tag 形 = 專案已有那行或內嵌引擎 ref）；version.local.toml 在 install 成功後才寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1793" width="610" height="86" as="geometry"/></mxCell><mxCell id="p5_tk3" value="6-37" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1667" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5_tv3" value="「--local 的值 &amp;lt;v&amp;gt; 既是存在的檔案也可解讀為 image tag。要指定檔案請用以 .tar 結尾的路徑；要指定 image 請先移走或改名同名檔 &amp;lt;v&amp;gt;。」（結束 1、零寫入；需人處理）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1667" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5_tk4" value="GHCR／引擎 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1707" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5_tv4" value="GHCR = GitHub 的容器倉庫；引擎 ref = version.toml 的 vendor_kit 版本鎖定行指到的引擎 image（ghcr.io/…/vendor_kit:vN@sha256:…）；已有 version.toml → 用該行、拉不到即失敗、不退回內嵌" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1707" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5_tk5" value="6-16／6-23／6-28／6-35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1762" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5_tv5" value="前置檢查訊息：6-16 不在 git repo 內（請先 git init）；6-23 just 版本不足（印安裝指令）；6-28 薄殼被改過，列差異不動；6-35 禁止巢狀（上層或下層已有 .vendor_kit/）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1762" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• a8t：兩條出邊 ae8tx（→ 1 + 6-37）、ae8tn（→ 續頁 A）缺是／否標籤，目標格文字也不以是／否開頭，看不出哪條是哪個分支&lt;br&gt;• a3：bootstrap.sh 前半缺主機側巢狀檢查（上層或下層已有 .vendor_kit/ → 1 + 6-35）；install（1）頁 i2r 說巢狀只能由啟動器在主機側查，但整條 bootstrap 流程沒有任何一格做這項檢查（缺分支）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1818" width="520" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p5x" name="16 流程 v2：bootstrap.sh（1″）引擎 image → LABEL 最低介面版"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1311" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：bootstrap.sh（1″）引擎 image：inspect → 無才 pull → LABEL 最低介面版（§2）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="460" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="64" width="260" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="bAx" value="5a′ bootstrap.sh 引擎 image 段（承「bootstrap.sh（1）」頁）：A --local → inspect 取 image ID（不 pull）；B → inspect → 無才 pull → LABEL 最低介面版檢查（任何寫入之前；否 → 3 零寫入）→ 續「bootstrap.sh（1′）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="763" as="geometry"/></mxCell><mxCell id="bAx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="a8a" value="來自「bootstrap.sh（1）」頁 A：--local（image 在本機）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=12;spacingBottom=12;" vertex="1" parent="bAx"><mxGeometry x="260" y="47" width="220" height="80" as="geometry"/></mxCell><mxCell id="a8b" value="來自「bootstrap.sh（1）」頁 B：非 --local（引擎 ref = 版本鎖定行或內嵌）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=15;spacingBottom=15;" vertex="1" parent="bAx"><mxGeometry x="500" y="36" width="220" height="102" as="geometry"/></mxCell><mxCell id="a8ix" value="1：本機無此 image（tag 形 --local 不得 pull）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=12;spacingBottom=12;" vertex="1" parent="bAx"><mxGeometry x="20" y="158" width="220" height="80" as="geometry"/></mxCell><mxCell id="a8ix_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="216" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="a8i" value="docker image inspect 取 image ID（tar 形 = load 進來的 image；tag 形 = 值即本機 tag）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bAx"><mxGeometry x="300" y="158" width="200" height="79" as="geometry"/></mxCell><mxCell id="a8i_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="476" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="a6i" value="docker image inspect &amp;lt;引擎 ref&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bAx"><mxGeometry x="510" y="174" width="170" height="48" as="geometry"/></mxCell><mxCell id="a6i_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="656" y="164" width="30" height="20" as="geometry"/></mxCell><mxCell id="a6q" value="本機有？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=42;spacingRight=42;spacingTop=12;spacingBottom=12;" vertex="1" parent="bAx"><mxGeometry x="510" y="258" width="170" height="50" as="geometry"/></mxCell><mxCell id="a6q_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="656" y="248" width="30" height="20" as="geometry"/></mxCell><mxCell id="a6p" value="無：docker pull &amp;lt;引擎 ref&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bAx"><mxGeometry x="510" y="332" width="170" height="48" as="geometry"/></mxCell><mxCell id="a6p_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="656" y="322" width="30" height="20" as="geometry"/></mxCell><mxCell id="a7" value="ghcr.io/…/vendor_kit:vN&lt;br&gt;（引擎 image；多架構 amd64+arm64）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bAx"><mxGeometry x="1019" y="328" width="182" height="57" as="geometry"/></mxCell><mxCell id="a6px" value="1 + 6-24／6-31：pull 失敗／逾時（不退回內嵌）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=26;spacingRight=26;spacingTop=12;spacingBottom=12;" vertex="1" parent="bAx"><mxGeometry x="1020" y="405" width="180" height="80" as="geometry"/></mxCell><mxCell id="a6px_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="1176" y="395" width="30" height="20" as="geometry"/></mxCell><mxCell id="a6r" value="引擎 image 已在本機（尚未寫任何檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bAx"><mxGeometry x="510" y="421" width="170" height="48" as="geometry"/></mxCell><mxCell id="a6r_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bAx"><mxGeometry x="656" y="411" width="30" height="20" as="geometry"/></mxCell><mxCell id="a8px" value="3 + 6-18：目前薄殼或引擎低於最低介面版 &amp;lt;最低介面版&amp;gt;。請以 bootstrap.sh 重建。（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=18;spacingBottom=18;" vertex="1" parent="bAx"><mxGeometry x="20" y="530" width="220" height="124" as="geometry"/></mxCell><mxCell id="a8px_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0