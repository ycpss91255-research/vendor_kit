Loop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o7c" target="o7cx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe10z" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="o7c" target="o7z"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="o5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="634"/><mxPoint x="275" y="669"/><mxPoint x="440" y="669"/></Array></mxGeometry></mxCell><mxCell id="p16_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1827" width="200" height="60" as="geometry"/></mxCell><mxCell id="p16_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1827" width="140" height="64" as="geometry"/></mxCell><mxCell id="p16_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1835" width="150" height="44" as="geometry"/></mxCell><mxCell id="p16_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1829" width="210" height="56" as="geometry"/></mxCell><mxCell id="p16_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1829" width="200" height="56" as="geometry"/></mxCell><mxCell id="p16_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1837" width="100" height="40" as="geometry"/></mxCell><mxCell id="p16_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1837" width="170" height="40" as="geometry"/></mxCell><mxCell id="p16_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1827" width="260" height="60" as="geometry"/></mxCell><mxCell id="p16_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1895" width="250" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1895" width="120" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1895" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="1895" width="150" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_img" value="紫：image（引擎與下游）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="810" y="1895" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="1895" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1190" y="1895" width="200" height="36" as="geometry"/></mxCell><mxCell id="p16_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1366" y="1885" width="30" height="20" as="geometry"/></mxCell><mxCell id="p16_lgx_conv1" value="圖例約定①：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（每個結束碼都寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1939" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16_lgx_conv2" value="圖例約定②：每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start（失敗 → 1 + 6-38、不做任何動作）、結束寫 engine_exit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1965" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1997" width="200" height="28" as="geometry"/></mxCell><mxCell id="p16_tk0" value="bootstrap.sh --local（契約入口）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2031" width="150" height="86" as="geometry"/></mxCell><mxCell id="p16_tv0" value="離線接入的契約入口 = bootstrap.sh --local &amp;lt;引擎 tar&amp;gt;（interface_spec §1.2）：只涉及引擎（docker load → install）；-t &amp;lt;repo&amp;gt; 走 registry、需網路，離線機不帶；前置檢查（git repo、just ≥ 1.33.0）不分值型別一律先做、在建執行紀錄之前；值的判別依序互斥（B1，v3.5）：以 .tar 結尾 → 檔案（必須存在）→ load + 讀 .digest；否則含 / 且存在同名檔 → 1 + 6-37；否則 → image tag（只 inspect image ID；含 / 但無同名檔的完整 ref 也是 tag 形）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2031" width="610" height="86" as="geometry"/></mxCell><mxCell id="p16_tk1" value="離線包（#27、Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2117" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16_tv1" value="Release 資產 vendor_kit-vN-local.tar.gz：bootstrap.sh、各平台 docker save 的引擎 tar + 同名 .digest 旁檔，另附 local_bootstrap.sh 便利包裝；只含引擎、不含任何工具 tar；在有網路的機器下載後帶到離線機；只涵蓋 install／add --local，離線 upgrade 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2117" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16_tk2" value=".digest 旁檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2172" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16_tv2" value="&amp;lt;name&amp;gt;.tar 旁的 &amp;lt;name&amp;gt;.tar.digest：一行 sha256:&amp;lt;hex64&amp;gt; = 該 image 的正式多架構 index digest（同名旁檔須同在，缺 → 1 + 6-24 主機錯誤分類）；--local 用它寫 version.toml 正式 ref@digest（不寫本機 tag），metadata 記 local_image_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2172" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16_tk3" value="image ID 記錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2031" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16_tv3" value="docker load 後的 image 只有 tag、沒有 RepoDigests；docker image inspect --format &#x27;{{.Id}}&#x27; 取 image ID：引擎的本機覆寫記 version.local.toml vendor_kit_image_id、工具記 metadata local_image_id（image ID ↔ index digest 對照，供離線驗證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2031" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16_tk4" value="local_bootstrap.sh（便利包裝，非契約）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2086" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16_tv4" value="離線包內附的可選腳本：docker version --format &#x27;{{.Server.Arch}}&#x27; 偵測 daemon 架構 → 挑該平台引擎 tar → exec ./bootstrap.sh --local &amp;lt;tar&amp;gt; &quot;$@&quot;；不是契約入口、不另定介面（v2.7-1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2086" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16_tk5" value="6-N 訊息編號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2141" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16_tv5" value="interface_spec §6 的逐字訊息清單編號（每句含可直接複製的指令）：6-3 無 registry 憑證、6-4 無 tty、6-12 指紋不同、6-15 update 末行、6-16 非 git repo、6-23 just 太舊、6-26 flock 逾時、6-27 未恢復、6-30 vk-resolve 不合、6-31 pull 逾時、6-32 prune 問句、6-33 未完成交易、6-37 --local 值歧義、6-38 log 寫不進…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2141" width="610" height="71" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;oe3tj：標籤壓線。&lt;br&gt;o2s：建執行紀錄無失敗出口。&lt;br&gt;o1：同格同時驗 SHA256SUMS 與解包。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2228" width="520" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p16i" name="63 流程 v2：離線包（1′）docker run install"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：離線包（1′）── docker run 本機 image install → version.local.toml（#27、Q26、§4.8）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q26、v2.6-1、v2.7-1／-2、v2.8-4／-5、v2.13 P4、v2.15-2／-14／-17、v2.16-4、interface_spec §1.2、§4.8、§7.4-16／17）：契約入口 = bootstrap.sh --local &amp;lt;引擎 tar&amp;gt;，只涉及引擎（local_bootstrap.sh 非契約）；先驗 git／just 再建執行紀錄；--local 依序判別（.tar 結尾 → 檔案；否則含 / 且有同名檔 → 6-37；否則 tag）；最低介面版檢查在起容器之前（斷網也回 3）；tar 附同名 .digest；install 第一個寫入前建 .tmp.install；version.toml 寫正式 ref@digest；離線 upgrade 不支援。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="116" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者（離線機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="230" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="bootstrap.sh（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="136" width="400" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="docker daemon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="136" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="136" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="136" width="280" height="28" as="geometry"/></mxCell><mxCell id="bO1i" value="離線接入（1′）：docker run 本機 image install（不 pull）→ 建進度檔 → 寫入（見 install 頁）→ 任一寫入失敗？是 → 引擎依進度檔清半成品 → 1；否 → 刪進度檔 → 寫 version.local.toml（本機 tag + image ID）→ 續（2）逐工具 add --local" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1590" height="920" as="geometry"/></mxCell><mxCell id="bO1i_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1i"><mxGeometry x="1546" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="o8z" value="來自「離線包（1）」頁：tar 已 load 並讀到正式 index digest（或 tag 形已核本機 image）；image ID 已取得、LABEL 介面版已過" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=58;spacingRight=58;spacingTop=15;spacingBottom=15;" vertex="1" parent="bO1i"><mxGeometry x="270" y="36" width="400" height="102" as="geometry"/></mxCell><mxCell id="o8" value="docker run 本機 image install（本機有 → 不 pull）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="270" y="153" width="400" height="40" as="geometry"/></mxCell><mxCell id="o8j" value="install：建進度檔 .tmp.install.&amp;lt;id&amp;gt;.toml（第一個寫入前；= 不留半成品的清除清單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="950" y="152" width="320" height="42" as="geometry"/></mxCell><mxCell id="o8jf" value="＋.vendor_kit/.tmp.install.&amp;lt;id&amp;gt;.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="1290" y="153" width="280" height="40" as="geometry"/></mxCell><mxCell id="o8e" value="續「install（1′）」頁與「install（2）」頁的寫入段（與線上接入相同；version.toml 第一行最後寫）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=47;spacingRight=47;spacingTop=15;spacingBottom=15;" vertex="1" parent="bO1i"><mxGeometry x="950" y="299" width="320" height="102" as="geometry"/></mxCell><mxCell id="o8f" value="install 寫（log/ 由啟動器先建）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="bO1i"><mxGeometry x="1290" y="208" width="280" height="284" as="geometry"/></mxCell><mxCell id="o8f_0" value="version.toml 第一行 = 正式 ref@digest（tar 形：.digest 旁檔；tag 形：既有 version.toml 值，第一次接入用 bootstrap.sh 內嵌引擎 ref）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="o8f"><mxGeometry x="8" y="26" width="252" height="88" as="geometry"/></mxCell><mxCell id="o8f_1" value="薄殼五檔、gen/.stamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="o8f"><mxGeometry x="8" y="120" width="252" height="26" as="geometry"/></mxCell><mxCell id="o8f_2" value="baseline/.gitkeep（VK 自產進 git 空檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="o8f"><mxGeometry x="8" y="152" width="252" height="42" as="geometry"/></mxCell><mxCell id="o8f_3" value="config.toml ＋ 基準版副本 ＋ metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="o8f"><mxGeometry x="8" y="200" width="252" height="42" as="geometry"/></mxCell><mxCell id="o8f_4" value="justfile 一行、.dockerignore 四行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="o8f"><mxGeometry x="8" y="248" width="252" height="26" as="geometry"/></mxCell><mxCell id="o8e2" value="來自「install（2）」頁：寫入段結束（成功或任一步失敗）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=47;spacingRight=47;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1i"><mxGeometry x="950" y="506" width="320" height="58" as="geometry"/></mxCell><mxCell id="o8x" value="是 → 1：引擎依進度檔清半成品、不留半成品（log/ 保留）；引擎異常結束時由 bootstrap.sh 補清" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=18;spacingBottom=18;" vertex="1" parent="bO1i"><mxGeometry x="20" y="578" width="230" height="124" as="geometry"/></mxCell><mxCell id="o8x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1i"><mxGeometry x="226" y="568" width="30" height="20" as="geometry"/></mxCell><mxCell id="o8q" value="任一寫入失敗？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=55;spacingRight=55;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1i"><mxGeometry x="950" y="615" width="220" height="50" as="geometry"/></mxCell><mxCell id="o8q_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1i"><mxGeometry x="1146" y="605" width="30" height="20" as="geometry"/></mxCell><mxCell id="o8k" value="否：刪進度檔 .tmp.install.&amp;lt;id&amp;gt;.toml（最後一步）= install 完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="950" y="716" width="320" height="48" as="geometry"/></mxCell><mxCell id="o8k_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1i"><mxGeometry x="1246" y="706" width="30" height="20" as="geometry"/></mxCell><mxCell id="o8kf" value="－.vendor_kit/.tmp.install.&amp;lt;id&amp;gt;.toml（刪）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="1290" y="719" width="280" height="42" as="geometry"/></mxCell><mxCell id="o9" value="install 成功後寫 version.local.toml：vendor_kit = &quot;vendor_kit:vN&quot; + vendor_kit_image_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="270" y="778" width="400" height="42" as="geometry"/></mxCell><mxCell id="o9f" value="version.local.toml（不進 git）：本機 tag + image ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1i"><mxGeometry x="1290" y="778" width="280" height="42" as="geometry"/></mxCell><mxCell id="o9z" value="續「離線包（2）」頁：另備工具 tar，逐一 add &amp;lt;repo&amp;gt; --local；之後斷網 sync 見「離線包（3）」頁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=58;spacingRight=58;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1i"><mxGeometry x="270" y="834" width="400" height="80" as="geometry"/></mxCell><mxCell id="oe10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8z" target="o8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8" target="o8j"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe11f" value="建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8j" target="o8jf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe11e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8j" target="o8e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe12" value="寫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8e" target="o8f"><mxGeometry relative="1" as="geometry"></mxGeometry