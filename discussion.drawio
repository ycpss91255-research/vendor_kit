;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1947" width="140" height="64" as="geometry"/></mxCell><mxCell id="p6r_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1955" width="140" height="44" as="geometry"/></mxCell><mxCell id="p6r_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1949" width="190" height="56" as="geometry"/></mxCell><mxCell id="p6r_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1949" width="210" height="56" as="geometry"/></mxCell><mxCell id="p6r_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1957" width="88" height="40" as="geometry"/></mxCell><mxCell id="p6r_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1957" width="170" height="40" as="geometry"/></mxCell><mxCell id="p6r_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1947" width="300" height="60" as="geometry"/></mxCell><mxCell id="p6r_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="2015" width="220" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2015" width="120" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="2015" width="170" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="2015" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_inv" value="紅粗框：不變量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="2015" width="120" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="2015" width="160" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="2015" width="100" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="2015" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1350" y="2015" width="180" height="36" as="geometry"/></mxCell><mxCell id="p6r_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1506" y="2005" width="30" height="20" as="geometry"/></mxCell><mxCell id="p6r_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2055" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p6r_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2101" width="200" height="28" as="geometry"/></mxCell><mxCell id="p6r_tk0" value="待辦清單／apply|no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2135" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6r_tv0" value="resolve sync 在引擎內算待辦（要拉哪些 image、要重裝什麼、要不要重生 tools.just）；stdout 只傳 extract 清單、指紋、apply|yes／no；無待辦 → apply|no，啟動器驗完文法直接 0、不起第二個容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2135" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6r_tk1" value="gen/ 三種檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2190" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6r_tv1" value="gen/tools.just：每個 &amp;lt;ns&amp;gt;.just 一行 mod?，sync／add／remove／upgrade 重生；gen/.stamp：只記引擎 ref，只由 install／升引擎寫；gen/&amp;lt;repo&amp;gt;.stamp：每工具印記（第一行 index digest 或 path:，之後每檔 sha256）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2190" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6r_tk2" value="verify／sha256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2245" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6r_tv2" value="verify 把 cache/&amp;lt;repo&amp;gt;/ 每個檔的 sha256 跟印記比；不符 → 重裝一次 + warn，再驗仍不符 → 1 失敗（不無限重裝）；只在 sync --verify、CI 模式、或版本變動那次做；cache 缺或印記變了就直接重裝，apply 後再驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2245" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6r_tk3" value="完成標記／基準版落後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2300" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6r_tv3" value="metadata 無完成標記 = add 沒做完 → 1 + 6-13「&amp;lt;repo&amp;gt; 未完成接入，請執行：just vendor_kit add &amp;lt;repo&amp;gt;」；最後合併版本 ≠ version.toml = 有人只改了 version.toml → 提示 upgrade（CI 模式 → 1 + 6-5）；metadata 失蹤或不可解析 → 1 失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2300" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6r_tk4" value="覆寫兩種（v2.1 B／v2.2 B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2135" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6r_tv4" value="引擎本機覆寫 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋image ID → 啟動器 inspect 驗 ID 後用該本機 image；工具本機覆寫 &amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot; → cache 是 symlink，跳過取件／verify，仍查 metadata／基準版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2135" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6r_tk5" value="6-5／6-13（CI 模式升為失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2190" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6r_tv5" value="6-5 基準版落後（最後合併版本 ≠ version.toml；CI 模式 → 1，本機 warn 繼續）；6-13 metadata 無完成標記 = add 沒做完 → 1「請先 add &amp;lt;repo&amp;gt;」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2190" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6r_tk6" value="6-30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=