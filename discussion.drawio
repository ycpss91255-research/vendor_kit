e="1" as="geometry"><Array as="points"><mxPoint x="1644" y="795"/><mxPoint x="1644" y="134"/><mxPoint x="142.6" y="134"/></Array></mxGeometry></mxCell><mxCell id="p4_lg0" value="紫：image（引擎與工具）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1935" width="170" height="40" as="geometry"/></mxCell><mxCell id="p4_lg1" value="紅：引擎模組" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="1935" width="130" height="40" as="geometry"/></mxCell><mxCell id="p4_lg2" value="白小框：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontSize=10;align=center;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="380" y="1935" width="140" height="40" as="geometry"/></mxCell><mxCell id="p4_lg3" value="紅底紅粗框：啟動器（主機側薄殼）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="1935" width="240" height="40" as="geometry"/></mxCell><mxCell id="p4_lg4" value="淺灰底：主機分組" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1935" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4_lg5" value="藍底藍框：引擎容器（容器內跑）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="1935" width="230" height="40" as="geometry"/></mxCell><mxCell id="p4_lgt" value="實線 = 資料流（線上文字 = 傳什麼）&lt;br&gt;雙箭頭 = 讀寫都有；黃橢圓 = 下游使用者" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1220" y="1925" width="300" height="60" as="geometry"/></mxCell><mxCell id="p4_lg6" value="綠底：專案目錄分組" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2001" width="160" height="40" as="geometry"/></mxCell><mxCell id="p4_lg7" value="綠框：進 git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="2001" width="120" height="40" as="geometry"/></mxCell><mxCell id="p4_lg8" value="灰虛線：不進 git（可重建）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;dashed=1;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="360" y="2001" width="200" height="40" as="geometry"/></mxCell><mxCell id="p4_lg9" value="黃底綠框：專案檔（進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="580" y="2001" width="230" height="40" as="geometry"/></mxCell><mxCell id="p4_lg10" value="等寬字：檔案內容範例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="2001" width="170" height="40" as="geometry"/></mxCell><mxCell id="p4_lg11" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="2001" width="200" height="40" as="geometry"/></mxCell><mxCell id="p4_lg11_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1188" y="2003" width="30" height="20" as="geometry"/></mxCell><mxCell id="p4_lg12" value="白底黑框：主機上的目錄／命名空間（不是檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2067" width="300" height="40" as="geometry"/></mxCell><mxCell id="p4_lg13" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="2067" width="220" height="40" as="geometry"/></mxCell><mxCell id="p4_lg14" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="600" y="2067" width="170" height="40" as="geometry"/></mxCell><mxCell id="p4_th" value="本頁名詞（只列本頁用到的）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2123" width="300" height="28" as="geometry"/></mxCell><mxCell id="p4_tk0" value="模組／最小單元" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2157" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4_tv0" value="模組 = 引擎裡一塊獨立責任的程式（紅框；8 個模組的責任見第 0 頁）；最小單元 = 模組裡可以單獨測的最小功能（白小框，一格一個）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2157" width="610" height="40" as="geometry"/></mxCell><mxCell id="p4_tk1" value="config.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2197" width="150" height="55" as="geometry"/></mxCell><mxCell id="p4_tv1" value=".vendor_kit/config.toml（進 git；install 建、upgrade 三方合併）：schema = 1、[log] keep = 50、days = 30；缺檔或缺鍵 = 預設，非正整數 → 預設 + 警告；引擎用 TOML parser（toml-bridge stage）讀，啟動器只 grep 固定寫法的 ^keep *= *[0-9]+ *$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2197" width="610" height="55" as="geometry"/></mxCell><mxCell id="p4_tk2" value="trace_id／TRACEPARENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2252" width="150" height="55" as="geometry"/></mxCell><mxCell id="p4_tv2" value="啟動器每次執行產一個 32 hex id（/proc/sys/kernel/random/uuid 去 -，缺則 od /dev/urandom），同值 = 進度檔交易 id；以 -e TRACEPARENT 與 -e VENDOR_KIT_LOG_FILE 傳給引擎，引擎 append 同一個 log 檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2252" width="610" height="55" as="geometry"/></mxCell><mxCell id="p4_tk3" value="多架構 index／index digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2307" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4_tv3" value="同一 tag 下 amd64 + arm64 兩份 manifest 的清單；docker 不帶 --platform 就挑原生；version.toml 與印記記清單的 digest（不記單平台 digest）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2307" width="610" height="40" as="geometry"/></mxCell><mxCell id="p4_tk4" value="暫存目錄 &amp;lt;tmp&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2157" width="150" height="55" as="geometry"/></mxCell><mxCell id="p4_tv4" value="啟動器把下游 image 的 /dist 抓到專案內 .vendor_kit/.tmp.dist.&amp;lt;id&amp;gt;/&amp;lt;repo&amp;gt;/，再把 .tmp.dist.&amp;lt;id&amp;gt;/ 唯讀掛進引擎當 /dist（逐檔判斷讀 /dist/&amp;lt;repo&amp;gt;，不是 cache）；本機覆寫時改掛 &amp;lt;dir&amp;gt;/dist → /dist/&amp;lt;repo&amp;gt;；trap 清掉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2157" width="610" height="55" as="geometry"/></mxCell><mxCell id="p4_tk5" value="掛載（-v）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2212" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4_tv5" value="docker run -v：把主機目錄接進容器；/repo = 專案根（可寫，-w /repo）；/dist = 暫存工具檔（唯讀）；/dist/&amp;lt;repo&amp;gt; = 本機覆寫的 &amp;lt;dir&amp;gt;/dist（唯讀）；/run/vk-token = TOKEN_FILE（唯讀）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2212" width="610" height="40" as="geometry"/></mxCell><mxCell id="p4_tk6" value="log_event()／log-events.txt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2252" width="150" height="55" as="geometry"/></mxCell><mxCell id="p4_tv6" value="log_event() = 引擎內寫執行紀錄的唯一入口（事件名 + k=v；其他模組都呼叫它，圖上不逐條畫線）；log-events.txt = 事件名註冊表，真本在引擎 image，log.sh 內嵌啟動器那份白名單；未註冊 → FATAL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2252" width="610" height="55" as="geometry"/></mxCell><mxCell id="p4_tk7" value="flock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2307" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4_tv7" value="Linux 檔案鎖：引擎 apply 一開始對專案目錄上鎖，避免兩個 just 同時寫；等 60 秒逾時 → 1 印 6-26；VENDOR_KIT_NO_LOCK=1 跳過（啟動器轉發）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2307" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;f_cfg：config.toml 只有讀箭頭 w_cfg（→ schema），沒有任何寫箭頭；但 install 建它、upgrade vendor_kit 三方合併它（§4.9）；baseline/vendor_kit/config.toml 與 baseline/.vendor_kit.toml 也沒出現為寫入目標（f_bl 只有 baseline/&amp;lt;repo&amp;gt;/）。&lt;br&gt;m_res_u0_0：「讀版本鎖定行、算 keep」一格兩事（讀鎖定行 vs 算 prune 的 keep 清單），且 keep 清單已另有 m_prune_u0_0。&lt;br&gt;run_cli／mount_dist／ret_cli：run_cli 標籤「動詞、參數、介面版旗標」與 mount_dist 標籤「本機覆寫 &amp;lt;dir&amp;gt;/dist → /dist/&amp;lt;repo&amp;gt;」互相壓字並壓到主機框 p4H 標題；ret_cli「結束碼、vk-resolve」貼在啟動器紅框下緣，縮圖讀不出各屬哪條線。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="90" y="1612" width="408" height="237" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p5" name="15 流程 v2：bootstrap.sh（1）檢查 → 引擎 ref → --local 判別"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1970" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：bootstrap.sh（1）檢查 → 執行紀錄 → 引擎 ref → --local 判別（§1.1 B1、§2）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="460" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="64" width="260" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="bA" value="5a bootstrap.sh 前半：檢查 git／just → 執行紀錄 → 引擎 ref（Q18）→ --local 依序判別：.tar 結尾？／含 / 且存在同名檔？（6-37）→ tar 形 docker load、讀 .digest；image 段見「bootstrap.sh（1″）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1355" as="geometry"/></mxCell><mxCell id="bA_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="a0" value="執行 bootstrap.sh -t &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]…" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="bA"><mxGeometry x="20" y="36" width="220" height="58" as="geometry"/></mxCell><mxCell id="a2" value="1 + 6-16：請先 git init（執行紀錄未建）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="bA"><mxGeometry x="20" y="126" width="220" height="58" as="geometry"/></mxCell><mxCell id="a1" value="是 git repo？（主機側）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=20;spacingBottom=20;" vertex="1" parent="bA"><mxGeometry x="370" y="114" width="240" height="81" as="geometry"/></mxCell><mxCell id="a4" value="1 + 6-23：印 just 安裝指令（執行紀錄未建）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="bA"><mxGeometry x="20" y="215" width="220" height="58" as="geometry"/></mxCell><mxCell id="a3" value="just ≥ 1.33.0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;st