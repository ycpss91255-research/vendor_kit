ell><mxCell id="p7bc_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1787" width="170" height="40" as="geometry"/></mxCell><mxCell id="p7bc_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1777" width="300" height="60" as="geometry"/></mxCell><mxCell id="p7bc_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1845" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1845" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1845" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1845" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1845" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1845" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1845" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bc_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1835" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bc_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1885" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1931" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bc_tk0" value="docker image inspect（引擎）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1965" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bc_tv0" value="啟動器每次先 docker image inspect：本機有就不 pull（本機覆寫時 .Id 必須 == version.local.toml 記的 image ID，否則 1）；不用 --pull never；引擎 image LABEL 帶介面版／檔案版，供降版判定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1965" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bc_tk1" value="多工具彙總（upgrade）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2020" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tv1" value="不帶 repo 的 upgrade 先對全部工具完整預檢（撞名、憑證、需詢問項目、dev 中）；任一不過整體不動；做得完的做完，最後回最需要處理的碼：1 &amp;gt; 2 &amp;gt; 0，訊息全列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2020" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tk2" value="resolve 非 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2060" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tv2" value="resolve 容器結束碼非 0（1／2／3）→ 啟動器不讀 stdout、不跑任何 docker／apply，原碼傳出；stdout 文法不合 → 1 + 6-30（§3.3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2060" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tk3" value="6-27（恢復失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1965" width="150" height="28" as="geometry"/></mxCell><mxCell id="p7bc_tv3" value="可寫動詞開始前偵測到既有進度檔 → 先恢復再繼續；恢復失敗 → 1「未恢復：&amp;lt;檔名&amp;gt;」逐檔列出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1965" width="610" height="28" as="geometry"/></mxCell><mxCell id="p7bc_tk4" value="6-30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1993" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tv4" value="啟動器驗 vk-resolve/1 文法不合 →「引擎輸出不完整或不相容（&amp;lt;原因&amp;gt;），未執行任何動作。」（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1993" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bc_tk5" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2033" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bc_tv5" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2033" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• se6vr：本機 image ID 相符時直接跳過 pull 的新路徑待重新配置&lt;br&gt;• spr／spq：偵測進度檔（spq）與先恢復（spr）畫在 s1「docker run 舊引擎 resolve upgrade」之前、且在啟動器泳道做恢復，違反 v2.17-1（恢復由引擎做、在 docker run 之後）&lt;br&gt;• se3：「是」標籤壓在 s2so 藍格第一個字上，兩個「是」疊在一起&lt;br&gt;• se6lo：「否」標籤畫在 s2lo 菱形內部、壓到菱形文字「(vendor_kit=)？」&lt;br&gt;• se2n：「否」標籤貼在 s2q 菱形下邊線上，且線從底頂點偏左出、多一個小折" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2104" width="520" height="143" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bca" name="38 流程 v2：upgrade ── E. 升引擎 (a′) apply 改第一行 → 接手"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1817" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── E. 升引擎 (a′) 舊引擎 apply 改第一行 → 啟動器 grep 第一行 → 接手新引擎（§3.4）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="64" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="64" width="200" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uEa" value="E(a′)（承「E. 升引擎 (a)(b)」頁：新引擎 image 已在本機）：舊引擎 apply：flock（逾時 6-26）→ 重驗指紋 → argv → 建 .tmp.upgrade 進度檔 → 只改第一行 → 啟動器比對正式 version.toml 第一行前後 → 用新引擎跑 upgrade vendor_kit（「E(c)（1）」頁）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1171" as="geometry"/></mxCell><mxCell id="uEa_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2e0" value="來自「E. 升引擎 (a)(b)」頁：新引擎 image 已在本機（已寫 launcher_start；apply 前已 grep 第一行）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=41;spacingRight=41;spacingTop=15;spacingBottom=15;" vertex="1" parent="uEa"><mxGeometry x="280" y="36" width="280" height="102" as="geometry"/></mxCell><mxCell id="s2r0" value="docker run 舊引擎 apply upgrade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uEa"><mxGeometry x="280" y="189" width="280" height="40" as="geometry"/></mxCell><mxCell id="s2r0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="536" y="179" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2b" value="apply（舊引擎）：flock 專案目錄（60 秒）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uEa"><mxGeometry x="600" y="189" width="300" height="40" as="geometry"/></mxCell><mxCell id="s2b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="876" y="179" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2bx" value="1 + 6-26：專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）；60 秒內未釋放" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=26;spacingRight=26;spacingTop=15;spacingBottom=15;" vertex="1" parent="uEa"><mxGeometry x="1010" y="158" width="180" height="102" as="geometry"/></mxCell><mxCell id="s2bx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="1166" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2cx" value="1 + 6-12：指紋不同「請重跑」" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="uEa"><mxGeometry x="20" y="280" width="220" height="58" as="geometry"/></mxCell><mxCell id="s2cx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="216" y="270" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c" value="重驗指紋：相同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=65;spacingRight=65;spacingTop=12;spacingBottom=12;" vertex="1" parent="uEa"><mxGeometry x="600" y="284" width="260" height="50" as="geometry"/></mxCell><mxCell id="s2c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="836" y="274" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c2x" value="1：原 argv 與計畫不一致，請重跑" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="uEa"><mxGeometry x="20" y="370" width="220" height="58" as="geometry"/></mxCell><mxCell id="s2c2x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="216" y="360" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2c2" value="原 argv 與計畫一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=65;spacingRight=65;spacingTop=20;spacingBottom=20;" vertex="1" parent="uEa"><mxGeometry x="600" y="358" width="260" height="81" as="geometry"/></mxCell><mxCell id="s2c2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="836" y="348" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2d" value="是 → 建進度檔 .tmp.upgrade.&amp;lt;id&amp;gt;.toml（記舊引擎 ref、目標引擎 ref、計畫 image ID；改第一行之前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uEa"><mxGeometry x="610" y="466" width="360" height="48" as="geometry"/></mxCell><mxCell id="s2d_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="946" y="456" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2df" value="＋.vendor_kit/.tmp.upgrade.&amp;lt;id&amp;gt;.toml（進度檔，不進 git；新引擎重產薄殼完成後才刪）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uEa"><mxGeometry x="1260" y="459" width="280" height="63" as="geometry"/></mxCell><mxCell id="s2df_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uEa"><mxGeometry x="1516" y="449" width="30" height="20" as="geometry"/></mxCell><mxCell id="s2e" value="只改 version.toml 的 vendor_kit 版本鎖定行 → 新引擎 ref（其餘工具等重跑原指令；進度檔留給新引擎）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uEa"><mxGeometry x="610" y="542" width="360" height="48" as="geometry"/></mxCell><mxCell id="s2e_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle