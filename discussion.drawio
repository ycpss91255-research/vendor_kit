7" value="印記 .stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1a_tv7" value=".&amp;lt;repo&amp;gt;/.stamp：第一行 = 裝的是哪個 image（判斷要不要重裝），其餘給人追溯" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1440" width="900" height="30" as="geometry"/></mxCell><mxCell id="d1a_tk8" value="&amp;lt;repo&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1a_tv8" value="工具 repo 名（例：base）；.&amp;lt;repo&amp;gt;/ = 專案裡裝好的工具檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1470" width="900" height="30" as="geometry"/></mxCell><mxCell id="d1a_tk9" value="--self" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1a_tv9" value="啟動器傳給引擎的字串 = .version 裡那一行的 image，寫進印記第一行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1500" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2a" name="討論 #11 圖解"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="980" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="#11 圖解：just diff 為什麼要「三方」── 用一個 Dockerfile 的例子" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/></mxCell><mxCell id="x_t" value="三份東西" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;strokeColor=none;fillColor=none;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="24" as="geometry"/></mxCell><mxCell id="x1" value="範本 v1（你當初 init 拿到的）&lt;br&gt;FROM ubuntu:22.04&lt;br&gt;RUN apt install curl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="x2" value="你的 Dockerfile（你改過：加了 git）&lt;br&gt;FROM ubuntu:22.04&lt;br&gt;RUN apt install curl git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="300" height="80" as="geometry"/></mxCell><mxCell id="x3" value="範本 v2（工具升級後，在 image 裡：改成 24.04）&lt;br&gt;FROM ubuntu:24.04&lt;br&gt;RUN apt install curl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="340" height="80" as="geometry"/></mxCell><mxCell id="g_two" value="現在的做法：二方 ── 只拿「範本 v2」跟「你的檔」比" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="700" height="200" as="geometry"/></mxCell><mxCell id="t1" value="diff 你的檔 → 範本 v2&lt;br&gt;- FROM ubuntu:22.04&lt;br&gt;+ FROM ubuntu:24.04&lt;br&gt;- RUN apt install curl git&lt;br&gt;+ RUN apt install curl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="g_two"><mxGeometry x="20" y="50" width="320" height="110" as="geometry"/></mxCell><mxCell id="t2" value="兩種改動混在一起：&lt;br&gt;22.04→24.04 是工具改的（你該跟進）&lt;br&gt;git 被拿掉 是因為你自己加的（不該動）&lt;br&gt;看 diff 的人分不出來" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="g_two"><mxGeometry x="360" y="50" width="320" height="110" as="geometry"/></mxCell><mxCell id="g_three" value="三方 ── 多留一份「範本 v1」當基準，就能拆開" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="760" height="200" as="geometry"/></mxCell><mxCell id="u1" value="範本 v1 → 範本 v2 = 工具改了什麼&lt;br&gt;- FROM ubuntu:22.04&lt;br&gt;+ FROM ubuntu:24.04" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="g_three"><mxGeometry x="20" y="50" width="350" height="70" as="geometry"/></mxCell><mxCell id="u2" value="範本 v1 → 你的檔 = 你改了什麼&lt;br&gt;- RUN apt install curl&lt;br&gt;+ RUN apt install curl git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;" vertex="1" parent="g_three"><mxGeometry x="390" y="50" width="350" height="70" as="geometry"/></mxCell><mxCell id="u3" value="兩邊改的不是同一行 → 沒有衝突：你只要把 FROM 改成 24.04 就跟進完成。&lt;br&gt;若兩邊改到同一行 → 標「兩邊都改」，由你決定。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="g_three"><mxGeometry x="20" y="130" width="720" height="50" as="geometry"/></mxCell><mxCell id="g_life" value="「範本 v1」（基準）放哪、怎麼更新" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1500" height="230" as="geometry"/></mxCell><mxCell id="l0" value="just init" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="g_life"><mxGeometry x="30" y="60" width="140" height="50" as="geometry"/></mxCell><mxCell id="l1" value="初始檔（Dockerfile…）&lt;br&gt;歸你，之後隨你改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="g_life"><mxGeometry x="210" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="l2" value=".vendor_kit/base/&amp;lt;name&amp;gt;/&lt;br&gt;= 範本 v1 的副本（進 git，人不改）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="g_life"><mxGeometry x="470" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="l3" value="升級後 just diff" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="g_life"><mxGeometry x="30" y="150" width="140" height="50" as="geometry"/></mxCell><mxCell id="l4" value="三方比對：base vs image 裡的新範本 vs 你的檔&lt;br&gt;只印出來，不改任何檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="g_life"><mxGeometry x="210" y="150" width="340" height="50" as="geometry"/></mxCell><mxCell id="l5" value="你看完、跟進完&lt;br&gt;just accept &amp;lt;name&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="g_life"><mxGeometry x="800" y="150" width="200" height="50" as="geometry"/></mxCell><mxCell id="l6" value=".vendor_kit/base/&amp;lt;name&amp;gt;/&lt;br&gt;換成範本 v2（下次升級的基準）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="g_life"><mxGeometry x="1060" y="150" width="300" height="50" as="geometry"/></mxCell><mxCell id="l7" value="為什麼不放 .&amp;lt;name&amp;gt;/：升級時整批換掉、換台電腦 clone 也沒有 → 需要它的時候剛好不在。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="g_life"><mxGeometry x="790" y="60" width="570" height="50" as="geometry"/></mxCell><mxCell id="le0" value="建立" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l0" target="l1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le1" value="同時存一份副本" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="le4" value="寫入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2a_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="220" height="60" as="geometry"/></mxCell><mxCell id="d2a_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="710" width="110" height="60" as="geometry"/></mxCell><mxCell id="d2a_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="720" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2a_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="720" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2a_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="720" width="200" height="40" as="geometry"/></mxCell><mxCell id="d2a_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="720" width="88" height="40" as="geometry"/></mxCell><mxCell id="d2a_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="720" width="170" height="40" as="geometry"/></mxCell><mxCell id="d2a_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="720" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2a_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="710" width="300" height="60" as="geometry"/></mxCell><mxCell id="d2a_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="200" height="28" as="geometry"/></mxCell><mxCell id="d2a_tk0" value="範本 / 初始檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2a_tv0" value="範本 = 工具 dist 裡給你的樣板；初始檔 = init 從範本複製到專案、之後歸你的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="820" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2a_tk1" value="基準（base）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2a_tv1" value="你上一次確認過的那版範本副本；三方比對的第三份" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="850" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2a_tk2" value="diff 的 - / +" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2a_tv2" value="- 是這邊有、那邊沒有的行；+ 相反" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="880" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2a_tk3" value="just accept" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2a_tv3" value="告訴工具「這版我看完了」，把基準換成新版範本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="910" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d0b" name="just 與 vendor_kit 怎麼接"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1818" pageHeight="1390" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="just 與 vendor_kit 怎麼接：你打的指令怎麼一層一層傳到引擎、再回到專案檔案（&amp;lt;repo&amp;gt; = 工具 repo 名，例：base）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry"/></mxCell><mxCell id="M" value="五層：一個 just 指令會經過哪些檔（左→右 = 呼叫方向；誰擁有、進不進 git 寫在框內）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1620" height="330" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;① 使用者&lt;/b&gt;&lt;br&gt;打 just &amp;lt;指令&amp;gt;&lt;br&gt;（主機終端機）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="M"><mxGeometry x="30" y="70" width="170" height="120" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;② 根 justfile&lt;/b&gt;&lt;br&gt;使用者的；進 git&lt;br&gt;只有一行：&lt;br&gt;import &#x27;.vendor_kit/entry.just&#x27;&lt;br&gt;想加自己的指令加在下面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" vertex="1" parent="M"><mxGeometry x="240" y="70" width="260" height="120" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;③ .vendor_kit/（薄殼）&lt;/b&gt;&lt;br&gt;vendor_kit 的；進 git，人不改&lt;br&gt;entry.just：接兩邊（mod + import?）&lt;br&gt;vendor.just：只有 ensure&lt;br&gt;　＋ 一行 docker run 叫引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" vertex="1" parent="M"><mxGeometry x="540" y="70" width="280" height="120" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;④ .vendor_kit/gen/&lt;/b&gt;&lt;br&gt;引擎每次 ensure 產生；不進 git&lt;br&gt;vendor_kit.just：init / diff /&lt;br&gt;　accept / upgrade / dev 這些 recipe&lt;br&gt;tools.just：把每個工具的&lt;br&gt;　.&amp;lt;repo&amp;gt;/just/docker.just 掛進來" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" vertex="1" parent="M"><mxGeometry x="860" y="70" width="300" height="120" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;⑤ 引擎容器 vendor_kit:vN&lt;/b&gt;&lt;br&gt;docker run，掛 專案:/repo、暫存:/dist&lt;br&gt;真正做事：install / verify / init /&lt;br&gt;　diff / accept …&lt;br&gt;寫回專案：.&amp;lt;repo&amp;gt;/、初始檔、baseline/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="M"><mxGeometry x="1200" y="70" width="300" height="120" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;工具檔 .&amp;lt;repo&amp;gt;/&lt;/b&gt;（不進 git，由引擎裝）&lt;br&gt;裡