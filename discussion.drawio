" y="175" width="240" height="50" as="geometry"/></mxCell><mxCell id="b7_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b8" value="印三段差異&lt;br&gt;（不改任何檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="B"><mxGeometry x="810" y="175" width="150" height="50" as="geometry"/></mxCell><mxCell id="b8_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b9" value="畫面：diff 結果" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;fontSize=12;" vertex="1" parent="B"><mxGeometry x="980" y="175" width="150" height="50" as="geometry"/></mxCell><mxCell id="b9_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="z_n" value="主圖第 5 頁畫的是第 5 層「引擎容器裡面」每個子命令（install / verify / init / diff / accept …）的細節；這頁是它的前情：指令怎麼從 just 一路傳到那裡、結果又寫回專案哪裡。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1500" height="44" as="geometry"/></mxCell><mxCell id="d0b_lg0" value="淺灰：分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1074" width="200" height="60" as="geometry"/></mxCell><mxCell id="d0b_lg1" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="1084" width="130" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg2" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1084" width="130" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg3" value="紫：引擎（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="1084" width="190" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg4" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="770" y="1084" width="88" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg5" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="878" y="1084" width="170" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg6" value="綠虛線框：工具檔（不進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1068" y="1084" width="240" height="40" as="geometry"/></mxCell><mxCell id="d0b_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1328" y="1084" width="130" height="40" as="geometry"/></mxCell><mxCell id="d0b_lgt" value="實線 = 呼叫／執行順序（指向檔案 = 寫入）&lt;br&gt;虛線箭頭 = 引擎反過來產生 gen/" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1478" y="1074" width="300" height="60" as="geometry"/></mxCell><mxCell id="d0b_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1136" width="200" height="28" as="geometry"/></mxCell><mxCell id="d0b_tk0" value="薄殼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv0" value=".vendor_kit/ 裡進 git 的兩個小檔（entry.just、vendor.just）：只負責把 just 接到引擎，本身沒有邏輯；引擎升級時整個換新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="1200" height="30" as="geometry"/></mxCell><mxCell id="d0b_tk1" value="gen/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv1" value=".vendor_kit/gen/：引擎每次 ensure 依 .version 產生的 recipe 與工具清單；不進 git，壞了刪掉再跑 just vendor_kit ensure 就回來" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="1200" height="30" as="geometry"/></mxCell><mxCell id="d0b_tk2" value="模組（mod）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv2" value="just 的 mod：把另一個 justfile 掛成自己的命名空間，指令變成 just &amp;lt;命名空間&amp;gt; &amp;lt;recipe&amp;gt;（例：just vendor_kit diff、just docker build）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="1200" height="30" as="geometry"/></mxCell><mxCell id="d0b_tk3" value="import" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv3" value="just 的 import：把另一個檔的 recipe 直接併進來（同一層、不加前綴）；import? / mod? 的問號 = 檔不在就略過、不報錯" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="1200" height="30" as="geometry"/></mxCell><mxCell id="d0b_tk4" value="ensure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv4" value="引擎的自動檢查：引擎版本對了嗎 → gen/ 要不要重產生 → 每個工具裝了沒、有沒有被改；工具的每個指令都先跑它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="1200" height="30" as="geometry"/></mxCell><mxCell id="d0b_tk5" value="引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="d0b_tv5" value="vendor_kit:vN 這個 image：所有真正的工作（install / verify / init / diff / accept …）都在它的容器裡跑；主機只需要 docker + git + just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="1200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d1" name="討論 #6：本地開發模式"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="1092" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="討論 #6：本地開發模式 ── 改工具本身時，怎麼在專案裡立刻試，不用每改一行就 build + push image" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="d1_pre" value="前例（agy，14 個工具）：本地路徑一律放在「不進 git 的覆蓋檔」或 CLI 旗標，不改正式版本檔 —— Go 的 go.work（提案明寫「不應 check in」）、docker compose 的 compose.override.yaml、mise.local.toml、Cargo 的 .cargo/config.toml [patch]、Terraform 的 dev_overrides（放 CLI 設定檔，不放 .tf）。&lt;br&gt;本地路徑的東西一律不做 checksum（go.sum、Cargo.lock、pnpm lockfile 都不記），改成每次執行印醒目警告（Terraform：「Provider development overrides are in effect」）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="70" as="geometry"/></mxCell><mxCell id="d1_a" value="&amp;lt;b&amp;gt;A：.version 直接寫 path:../tool&amp;lt;/b&amp;gt;&lt;br&gt;優：只有一個檔。&lt;br&gt;缺：git diff 被污染、容易誤 commit、CI 要另外擋；前例一致反對（Go 因此才做 go.work）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="150" as="geometry"/></mxCell><mxCell id="d1_b" value="&amp;lt;b&amp;gt;B：.version.local 覆蓋（gitignore）&amp;lt;/b&amp;gt;&lt;br&gt;優：git 乾淨、零誤 commit；跟 go.work / compose.override 同一型。&lt;br&gt;缺：多一個檔要知道它存在。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="360" height="150" as="geometry"/></mxCell><mxCell id="d1_c" value="&amp;lt;b&amp;gt;C：只用環境變數／指令旗標&amp;lt;/b&amp;gt;&lt;br&gt;優：完全暫時，關掉 shell 就沒了。&lt;br&gt;缺：每個 shell 都要設，CI 與同事看不到你在用本地版。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="360" height="150" as="geometry"/></mxCell><mxCell id="d1_d" value="&amp;lt;b&amp;gt;D（agy 建議）：B + C&amp;lt;/b&amp;gt;&lt;br&gt;優先序：環境變數 &amp;gt; .version.local &amp;gt; .version。&lt;br&gt;平常用 B；臨時單次用 C。&lt;br&gt;再給兩個指令：just dev &amp;lt;name&amp;gt; &amp;lt;path&amp;gt;、just undev &amp;lt;name&amp;gt;。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1180" y="150" width="360" height="150" as="geometry"/></mxCell><mxCell id="d1_flow" value="方案 D 的流程" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="1500" height="330" as="geometry"/></mxCell><mxCell id="f0" value="just dev &amp;lt;name&amp;gt; ../tool" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d1_flow"><mxGeometry x="30" y="60" width="200" height="50" as="geometry"/></mxCell><mxCell id="f1" value="寫 .version.local：&lt;br&gt;&amp;lt;name&amp;gt; = &quot;path:../tool&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d1_flow"><mxGeometry x="270" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="f2" value="啟動器讀版本：環境變數 &amp;gt;&lt;br&gt;.version.local &amp;gt; .version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d1_flow"><mxGeometry x="530" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="f3" value="docker run vendor_kit:vN&lt;br&gt;-v ../tool/dist:/dist:ro --dev install" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="d1_flow"><mxGeometry x="790" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="f4" value=".&amp;lt;name&amp;gt;/（印記第一行 = dev:../tool）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="d1_flow"><mxGeometry x="1090" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="f5" value="之後每次 just：印記是 dev: →&lt;br&gt;不比指紋、印醒目警告、重新同步 dist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d1_flow"><mxGeometry x="510" y="160" width="260" height="50" as="geometry"/></mxCell><mxCell id="f6" value="just undev &amp;lt;name&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d1_flow"><mxGeometry x="30" y="250" width="200" height="50" as="geometry"/></mxCell><mxCell id="f7" value="刪 .version.local 那行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d1_flow"><mxGeometry x="270" y="250" width="220" height="50" as="geometry"/></mxCell><mxCell id="f8" value="下次 just 回到 .version 的正式 image，&lt;br&gt;重裝 .&amp;lt;name&amp;gt;/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d1_flow"><mxGeometry x="530" y="250" width="260" height="50" as="geometry"/></mxCell><mxCell id="f9" value=".version.local 由 bootstrap 寫進 .gitignore；&lt;br&gt;檔案不存在 = 沒有人在用本地版（平常狀態）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="d1_flow"><mxGeometry x="1090" y="160" width="260" height="50" as="geometry"/></mxCell><mxCell id="fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f0" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe3" value="寫出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f2" target="f5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f6" target="f7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fe6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f7" target="f8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_q" value="決議（2026-09-17）：採 B（.version.local），不用環境變數 —— 出問題時要能從檔案追到原因。&lt;br&gt;仍待答：&lt;br&gt;1. 採 D？（或只要 B）&lt;br&gt;2. dev 模式下 .&amp;lt;name&amp;gt;/ 每次 just 重新同步（複製）dist，還是不裝、直接指到 ../tool/dist？（複製：跟正式版行為一致、慢一點；直接指：改了立刻生效，但印記／腳本路徑要特別處理）&lt;br&gt;3. 印記第一行用 dev:&amp;lt;路徑&amp;gt; 標記，verify 看到就跳過並警告 —— 可以接受「開發模式下沒有完整性檢查」嗎？（前例全部都這樣做）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1500" height="90" as="geometry"/></mxCell><mxCell id="d1_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="220" height="60" as="geometry"/></mxCell><mxCell id="d1_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="810" width="110" height="60" as="geometry"/></mxCell><mxCell id="d1_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="820" width="130" height="40" as="geometry"/></mxCell><mxCell id="d1_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="820" width="130" height="40" as="geometry"/></mxCell><mxCell id="d1_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="820" width="200" height="40" as="geometry"/></mxCell><mxCell id="d1_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="820" width="88" height="40" as="geometry"/></mxCell><mxCell id="d1_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="820" width="170" height="40" as="geometry"/></mxCell><mxCell id="d1_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="820" width="130" height="40" as="geometry"/></mxCell><mxCell id="d1_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="810" width="300" height="60" as="geometry"/></mxCell><mxCell id="d1_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="200" height="28" as="geometry"/></mxCell><mxCell id="d1_tk0" value="本地開發模式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1_tv0" value="開發工具本身的人，把專案指到自己電腦上的工具原始碼（而不是 GHCR 上的 image）來試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="920" width="900" height="30" as="geometry"/></mxCell><mxCell id="d1_tk1" value=".version.local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1_tv1" value="跟 .version 同格式的覆蓋檔，不進 git；有它就優先用它的那一行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="950" width="900" height="30" as="geometry"/></mxCell><mxCell id="d1_tk2" value="dev: 前綴" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="170" height="30" as="geometry"/></mxCell><mxCell id="d1_tv2" value="印記第一行寫 dev:&amp;lt;路徑&amp;gt; 代表這個 .&amp;lt;name&amp;gt;/ 來自本地路徑，不是正式 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="980" width="900" height="30" as="geometry"/></mxCell><mxCell id="d1_tk3" value="go.work / compose.override" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="170" height="42" as="geometry"/></mxCell><mxCell id="d1_tv3" value="Go 與 docker compose 各自的「本地覆蓋檔」前例，都明訂不進 git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1010" width="900" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="討論 #11：diff 三方比對"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="1282" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="討論 #11：just diff 要不要三方比對 ── 分清楚「工具改了什麼」和「你改了什麼」" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="d2_pre" value="前例（子代理查證；經 Claude + codex 雙軌分析更正）：Copier、Cruft 存「舊版模板的 git commit + 當時的變數」，升級時重新產生舊版做合併（Copier 預設產 .rej，加 --conflict inline 才留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; 標記；Cruft 一律 .rej）；Debian 的 ucf 把舊版整份存起來、diff3 後先給你看再寫；dpkg 只存舊版 hash，但這樣已能把每個檔分成四類（沒人改／只有你改／只有工具改／兩邊都改）；Rails、Yeoman 什麼都不存，逐檔問你要不要覆蓋。&lt;br&gt;實作更正：「兩份二方 diff 取重疊 = 衝突」是錯的（你已手動套上同樣改動會被誤判；hunk 含上下文；插入是零長度）。真正的三方要自己寫 diff3（difflib 之上約 100–150 行，要有測試）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="90" as="geometry"/></mxCell><mxCell id="d2_a" value="&amp;lt;b&amp;gt;A：維持二方（現況）&amp;lt;/b&amp;gt;&lt;br&gt;新版模板 vs 你的檔，一份 diff。&lt;br&gt;優：零成本。&lt;br&gt;缺：工具改的和你改的混在一起，升級後看不出哪些是該跟進的。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="480" height="150" as="geometry"/></mxCell><mxCell id="d2_b" value="&amp;lt;b&amp;gt;B（雙軌分析一致建議）：三方，只顯示不寫回&amp;lt;/b&amp;gt;&lt;br&gt;第一版：每個檔分成五類（沒人改／只有工具改／只有你改／兩邊都改／你已套上相同內容）＋ 印「舊→新（工具改了）」「舊→你的（你改了）」兩份 diff，行級只標「可能重疊」；處理新增／移除的模板檔。&lt;br&gt;第二版：自寫 diff3，行級精確判定。&lt;br&gt;優：符合「工具不改使用者檔」。缺：要保留舊版模板副本，多一個 accept 指令。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="480" height="150" as="geometry"/></mxCell><mxCell id="d2_c" value="&amp;lt;b&amp;gt;C：三方 + 自動合併寫回&amp;lt;/b&amp;gt;&lt;br&gt;Copier / Cruft 做法：沒衝突的自動套用，有衝突留標記。&lt;br&gt;優：最省事。&lt;br&gt;缺：直接違反「不自動改使用者檔」；容器內沒有 3-way 工具，要另外帶 merge3 或 git。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="500" height="150" as="geometry"/></mxCell><mxCell id="d2_where" value="B 需要的「舊版模板副本」放哪？" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1500" height="200" as="geometry"/></mxCell><mxCell id="d2_w1" value="&amp;lt;b&amp;gt;(i) 放 .&amp;lt;name&amp;gt;/ 裡&amp;lt;/b&amp;gt;&lt;br&gt;升級時 .&amp;lt;name&amp;gt;/ 整批覆蓋 → 副本跟著消失；而且 .&amp;lt;name&amp;gt;/ 不進 git，換台機器 clone 下來根本沒有舊版。否決。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="460" height="120" as="geometry"/></mxCell><mxCell id="d2_w2" value="&amp;lt;b&amp;gt;(ii) 進 git：.vendor_kit/base/&amp;lt;name&amp;gt;/（雙軌一致）&amp;lt;/b&amp;gt;&lt;br&gt;存「渲染後的初始檔副本」＋ metadata（image、每檔 sha256）。fresh clone、CI、離線都有；跟 dist 版型演進脫鉤。&lt;br&gt;init 從第一版就寫基準（否則之後所有專案都沒基準）。&lt;br&gt;前提：#20 的「.vendor_kit/ 升級整個換新」要改成「只換程式檔，base/ 不動」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="50" width="480" height="120" as="geometry"/></mxCell><mxCell id="d2_w3" value="&amp;lt;b&amp;gt;(iii) 用舊 image digest 重取&amp;lt;/b&amp;gt;&lt;br&gt;容器內沒有 docker，得由啟動器在主機 docker cp 舊 image 的 /dist 再掛進來 → 啟動器變厚；#14 引入變數後還要存變數。&lt;br&gt;雙軌一致：不當自動備援，缺基準就退回二方並明說；日後頂多當明確執行的復原功能。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1000" y="50" width="480" height="120" as="geometry"/></mxCell><mxCell id="d2_flow" value="方案 B 的 just diff 流程" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1500" height="260" as="geometry"/></mxCell><mxCell id="g0" value="just diff" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d2_flow"><mxGeometry x="30" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="g1" value="有舊版副本&lt;br&gt;（base）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d2_flow"><mxGeometry x="230" y="45" width="180" height="80" as="geometry"/></mxCell><mxCell id="g2" value="三方：base→新版 = 工具改了&lt;br&gt;base→你的檔 = 你改了；重疊 = 兩邊都改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d2_flow"><mxGeometry x="460" y="60" width="320" height="50" as="geometry"/></mxCell><mxCell id="g3" value="二方（現況），並提示「沒有基準」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d2_flow"><mxGeometry x="460" y="160" width="320" height="50" as="geometry"/></mxCell><mxCell id="g4" value="印出三段（不改任何檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d2_flow"><mxGeometry x="830" y="60" width="220" height="50" as="geometry"/></mxCell><mxCell id="g5" value="使用者：看完了，&lt;br&gt;更新基準？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d2_flow"><mxGeometry x="1100" y="45" width="180" height="80" as="geometry"/></mxCell><mxCell id="g6" value=".vendor_kit/base/&amp;lt;name&amp;gt;/ 換成新版模板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="d2_flow"><mxGeometry x="1320" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="g7" value="結束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d2_flow"><mxGeometry x="1140" y="165" width="100" height="40" as="geometry"/></mxCell><mxCell id="ge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge1" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge2" value="沒有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="g1" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="g5" target="g7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g3" target="g7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_q" value="雙軌一致的部分（不用再問）：採 B；副本放 (ii) 進 git；更新基準用獨立指令 just accept &amp;lt;name&amp;gt;（docker run --rm 沒有 TTY，diff 結尾問不到；且推進基準本身是決策）；accept 的語意 = 「這版我全看過了」，寫入的是新版模板不是你的檔；缺基準退回二方並明說。&lt;br&gt;要你決定：&lt;br&gt;1. .vendor_kit/base/ 要不要納入 verify 印記？（納入 = 不能手改基準；不納入 = 可手改但不受保護）建議納入。&lt;br&gt;2. 舊專案 init 時「已存在、跳過」的檔，要不要也寫基準（= 當時那版模板）？建議要，否則那些檔永遠只有二方。&lt;br&gt;3. just diff 要不要有結束狀態語意（0 無差異／1 工具有改／2 可能重疊）給 CI 用？建議要。&lt;br&gt;4. 兩個工具 init 到同一個檔（.gitignore、hooks）怎麼辦？建議 init 直接禁止撞路徑，報錯。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1500" height="110" as="geometry"/></mxCell><mxCell id="d2_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="220" height="60" as="geometry"/></mxCell><mxCell id="d2_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1000" width="110" height="60" as="geometry"/></mxCell><mxCell id="d2_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1010" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1010" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1010" width="200" height="40" as="geometry"/></mxCell><mxCell id="d2_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="1010" width="88" height="40" as="geometry"/></mxCell><mxCell id="d2_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1038" y="1010" width="170" height="40" as="geometry"/></mxCell><mxCell id="d2_lg7" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1228" y="1010" width="130" height="40" as="geometry"/></mxCell><mxCell id="d2_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1378" y="1000" width="300" height="60" as="geometry"/></mxCell><mxCell id="d2_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="200" height="28" as="geometry"/></mxCell><mxCell id="d2_tk0" value="二方 / 三方比對" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2_tv0" value="二方 = 兩份檔直接比；三方 = 多一份「共同的舊版」當基準，才能分出誰改了什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1110" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2_tk1" value="基準（base）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2_tv1" value="上一次你確認過的那版模板副本；三方比對的第三份" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1140" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2_tk2" value="difflib" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="170" height="30" as="geometry"/></mxCell><mxCell id="d2_tv2" value="Python 內建的比對工具，只會二方；三方靠兩次二方取重疊" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1170" width="900" height="30" as="geometry"/></mxCell><mxCell id="d2_tk3" value="Copier / Cruft / ucf / dpkg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="42" as="geometry"/></mxCell><mxCell id="d2_tv3" value="模板升級工具（前兩者）與 Debian 設定檔升級機制（後兩者）的前例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="42" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d3" name="討論 #13：並行安裝 lock"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="討論 #13：兩個 just 同時安裝 ── 要不要 lock、怎麼做" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="d3_sc" value="情境：什麼叫「兩個同時安裝」" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="210" as="geometry"/></mxCell><mxCell id="sc_t" value="你剛 merge 了升級 PR（.version 變了）。接著這三種情況任一種都會讓兩個 vendor_kit 容器「同時」對同一個 .&amp;lt;name&amp;gt;/ 做 install：&lt;br&gt;① 你開兩個終端機，一個打 just build、另一個打 just run；② CI 在跑 just，你也在同一台機器打 just；③ IDE 的工作（save 時自動 just）跟你手打撞在一起。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="d3_sc"><mxGeometry x="12" y="40" width="1470" height="50" as="geometry"/></mxCell><mxCell id="sc_a" value="容器 A：install&lt;br&gt;寫暫存目錄 → 刪舊 .&amp;lt;name&amp;gt;/ → 改名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="d3_sc"><mxGeometry x="20" y="105" width="300" height="50" as="geometry"/></mxCell><mxCell id="sc_b" value="容器 B：install（晚半秒）&lt;br&gt;寫暫存目錄 → 刪舊 .&amp;lt;name&amp;gt;/ → 改名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="d3_sc"><mxGeometry x="20" y="160" width="300" height="44" as="geometry"/></mxCell><mxCell id="sc_r" value="結果：A 剛改名完，B 又刪掉再改名；或 B 改名時目標已存在而失敗；&lt;br&gt;最慘是 just build 讀腳本的那一瞬間 .&amp;lt;name&amp;gt;/ 根本不存在" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d3_sc"><mxGeometry x="360" y="100" width="560" height="100" as="geometry"/></mxCell><mxCell id="sc_n" value="鎖的意思：B 看到 A 在裝，就等 A 裝完；輪到 B 時發現已經是新版，直接跳過。&lt;br&gt;沒有鎖 = 兩個人同時搬同一個櫃子。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="d3_sc"><mxGeometry x="950" y="100" width="530" height="100" as="geometry"/></mxCell><mxCell id="sce" value="交錯" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="sc_a" target="sc_r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sce2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="sc_b" target="sc_r"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_pre" value="前例（agy，10 個工具）：apt/dpkg、Cargo、Nix、Bazel、uv、Go 都用 flock/fcntl 檔案鎖（核心自動釋放、沒有殘鎖問題）；Git 用 O_EXCL 建 index.lock（立即失敗，殺掉後要手動刪）；npm/pnpm 的 store 用 mkdir 目錄鎖 + mtime 判殘鎖（常出「stale lock」問題）；Terraform 用 lock 紀錄，永不過期要 force-unlock。&lt;br&gt;前例沒有人拿「暫存目錄存在」當鎖（rsync、apt、Nix、Go、Maven 都是另外持鎖）。&lt;br&gt;重要發現：我們現在的「先 rmtree 舊目錄再 rename 暫存目錄」不是原子替換 —— 中間有一瞬間 .&amp;lt;name&amp;gt;/ 不存在；兩個 install 交錯時第二個 rename 會失敗（目標非空）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1500" height="90" as="geometry"/></mxCell><mxCell id="d3_a" value="&amp;lt;b&amp;gt;A：不鎖，靠暫存目錄 + rename&amp;lt;/b&amp;gt;&lt;br&gt;每個 install 用自己的暫存目錄名（加 pid、亂數）。&lt;br&gt;優：沒有殘鎖問題。&lt;br&gt;缺：替換那一瞬間的競態還在；N 個 shell 就重裝 N 次；崩潰留下的暫存目錄要另外清。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="480" height="160" as="geometry"/></mxCell><mxCell id="d3_b" value="&amp;lt;b&amp;gt;B：mkdir .&amp;lt;name&amp;gt;.lock/ 當鎖&amp;lt;/b&amp;gt;&lt;br&gt;有目錄 = 有人在裝 → 等 N 秒再失敗。&lt;br&gt;優：所有檔案系統（含 NFS、macOS Docker Desktop、WSL）都可靠、實作最簡單。&lt;br&gt;缺：容器被殺（Ctrl-C、OOM）會留殘鎖；用 mtime／PID 判殘鎖在容器裡都不可靠（PID 空間不同、時鐘偏差）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="400" width="480" height="160" as="geometry"/></mxCell><mxCell id="d3_c" value="&amp;lt;b&amp;gt;C（雙軌一致）：flock，但鎖的是專案目錄本身&amp;lt;/b&amp;gt;&lt;br&gt;flock /repo 目錄（不建鎖檔：鎖檔放 .vendor_kit/ 或 .&amp;lt;name&amp;gt;/ 會被整批替換而失效；放根目錄要改使用者的 .gitignore）。一個專案一把鎖：install 排他、verify 共享。&lt;br&gt;優：核心自動釋放，零殘鎖；已在本機實測兩個容器 + 主機三方互斥成立；Python 標準庫就有。&lt;br&gt;缺：macOS Docker Desktop（已知未修 bug）、WSL /mnt/c、NFS 上不保證互斥 → 明寫只保證原生 Linux。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="400" width="500" height="160" as="geometry"/></mxCell><mxCell id="d3_flow" value="方案 C 的 install（第 5 頁 install 泳道會改成這樣）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1500" height="300" as="geometry"/></mxCell><mxCell id="h0" value="開始 install" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d3_flow"><mxGeometry x="30" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="h1" value="flock 專案目錄（排他）&lt;br&gt;拿不到：1 秒後印訊息，等最多 60 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d3_flow"><mxGeometry x="230" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="h2" value="拿到鎖後重讀 .version&lt;br&gt;與印記：已是目標版本？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d3_flow"><mxGeometry x="530" y="45" width="200" height="80" as="geometry"/></mxCell><mxCell id="h3" value="清殘留 .&amp;lt;name&amp;gt;.tmp.* → 寫暫存目錄（亂數名）&lt;br&gt;→ 寫印記 → 刪舊 → 改名（全程在鎖內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d3_flow"><mxGeometry x="780" y="60" width="320" height="50" as="geometry"/></mxCell><mxCell id="h4" value="釋放鎖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d3_flow"><mxGeometry x="1140" y="60" width="120" height="50" as="geometry"/></mxCell><mxCell id="h5" value="成功結束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d3_flow"><mxGeometry x="1300" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="h6" value="跳過複製，仍跑一次 verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d3_flow"><mxGeometry x="530" y="170" width="200" height="50" as="geometry"/></mxCell><mxCell id="h7" value="逾時：中止、不動任何檔&lt;br&gt;「另一個 vendor_kit 仍持有鎖，docker ps 查」" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d3_flow"><mxGeometry x="230" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="h8" value="verify 拿同一把鎖（共享）。鎖只保護容器內的 install/verify；主機端腳本在執行中仍可能撞到「刪舊→改名」的空窗（見待決 2）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="d3_flow"><mxGeometry x="780" y="160" width="460" height="50" as="geometry"/></mxCell><mxCell id="he0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h0" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he1" value="拿到" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he2" value="逾時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="h1" target="h7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h2" target="h3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="h2" target="h6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h3" target="h4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4" target="h5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="he7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="d3_flow" source="h6" target="h4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="195"/></Array></mxGeometry></mxCell><mxCell id="d3_q" value="雙軌一致（不用再問）：採 C、鎖專案目錄本身；逾時預設 60 秒（環境變數可改，0 = 立即失敗給 CI）；鎖不支援（NFS 等）→ 直接失敗，不自動退回 B，給 VENDOR_KIT_NO_LOCK=1 逃生口；暫存目錄用亂數名並順手清殘留；docker run 加 --init 讓中止訊號能傳給程式；symlink 切換不做；測試閘門要有「兩個容器同時裝」的案例。&lt;br&gt;對 agy 的更正：Nix 用的是 flock 不是 fcntl；macOS Docker Desktop 上「同一 VM 內容器互鎖仍可」沒依據（實際上也壞）；多個引用連結對錯題。&lt;br&gt;要你決定：&lt;br&gt;1. 支援平台：只保證原生 Linux，macOS Docker Desktop／WSL 印警告不保證？（建議是）&lt;br&gt;2. 主機端腳本執行到一半時 .&amp;lt;name&amp;gt;/ 被另一個 just 換掉，要防到哪層？(a) 接受、寫進限制（建議第一版）；(b) 目錄任何瞬間都完整 → 用 Linux 的 RENAME_EXCHANGE 原子交換；(c) 同一次執行全程同版本 → 要改成版本目錄，大工程。&lt;br&gt;3. 執行中 .version 被改（另一邊在 git checkout）：照原本讀到的版本裝完，還是取消？（建議裝完，下次 just 再對齊）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1500" height="130" as="geometry"/></mxCell><mxCell id="d3_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="220" height="60" as="geometry"/></mxCell><mxCell id="d3_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="1090" width="110" height="60" as="geometry"/></mxCell><mxCell id="d3_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="1100" width="130" height="40" as="geometry"/></mxCell><mxCell id="d3_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="1100" width="130" height="40" as="geometry"/></mxCell><mxCell id="d3_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="1100" width="200" height="40" as="geometry"/></mxCell><mxCell id="d3_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="1100" width="88" height="40" as="geometry"/></mxCell><mxCell id="d3_lg6" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1038" y="1100" width="130" height="40" as="geometry"/></mxCell><mxCell id="d3_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1188" y="1090" width="300" height="60" as="geometry"/></mxCell><mxCell id="d3_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1166" width="200" height="28" as="geometry"/></mxCell><mxCell id="d3_tk0" value="flock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv0" value="Linux 的檔案鎖：程序結束或被殺，核心自動解鎖，不會留殘鎖" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1200" width="900" height="30" as="geometry"/></mxCell><mxCell id="d3_tk1" value="殘鎖（stale lock）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv1" value="拿鎖的程序死了但鎖檔還在，後面的人永遠等不到；mkdir 鎖的典型問題" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1230" width="900" height="30" as="geometry"/></mxCell><mxCell id="d3_tk2" value="原子替換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv2" value="外面的人看到的不是完整舊版就是完整新版，沒有中間狀態；目前的 rmtree + rename 做不到，要靠鎖蓋住" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1260" width="900" height="30" as="geometry"/></mxCell><mxCell id="d3_tk3" value="virtiofs / 9p" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv3" value="macOS Docker Desktop 與 WSL 把主機目錄掛進容器用的檔案系統，檔案鎖在上面不可靠" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1290" width="900" height="30" as="geometry"/></mxCell><mxCell id="d3_tk4" value="RENAME_EXCHANGE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv4" value="Linux 的系統呼叫：把兩個目錄一口氣互換，外面的人看不到中間狀態；NFS 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1320" width="900" height="30" as="geometry"/></mxCell><mxCell id="d3_tk5" value="--init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1350" width="170" height="30" as="geometry"/></mxCell><mxCell id="d3_tv5" value="docker run 的選項：讓容器裡有個小程式負責轉送「停止」訊號，Python 才來得及清暫存目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d4" name="討論 #12：verify 比什麼"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="討論 #12：verify 的基準與範圍 ── 每次 just 都要跑，比什麼、比多細" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell><mxCell id="d4_pre" value="前例（agy；經雙軌分析更正）：agy 的表有三列寫反（Terraform 其實每次 plan/apply 都對 provider 目錄重算 hash 跟進 git 的鎖檔比 —— 這才是最像我們的前例；Go 的 verify 基準也是本地可寫的檔；pip 只重寫 RECORD 不驗）。可信的部分：Nix 比整棵樹（含執行位、symlink）且 store 唯讀；dpkg/rpm 比本地清單。&lt;br&gt;關鍵事實（雙方都查了原型）：verify 本來就在「該工具自己的 image」容器裡跑，而那個 image 裡就有 /dist —— 所以「從 image 重取要多起容器、要上網」是錯的：不用多起容器、不碰網路，只是多讀一份檔（實測 200 檔雙邊 hash 42 ms，docker run 本身就 250 ms）。&lt;br&gt;另一個關鍵：A、B 的印記跟被驗的檔在同一目錄、同一個使用者可寫 —— 改檔案順便改印記就過關，只能防「不小心」，防不了「故意」。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="110" as="geometry"/></mxCell><mxCell id="d4_a" value="&amp;lt;b&amp;gt;A：只比印記裡的內容 hash（現況）&amp;lt;/b&amp;gt;&lt;br&gt;優：已實作、夠快。&lt;br&gt;缺：抓不到多餘檔、執行位、symlink（原型 rglob 會跟隨 symlink，可讀到樹外）；基準是可寫的印記，只防不小心。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="480" height="150" as="geometry"/></mxCell><mxCell id="d4_b" value="&amp;lt;b&amp;gt;B：印記 + 檔案集合 + 權限位 + stat 快取（原草稿傾向，雙軌否決）&amp;lt;/b&amp;gt;&lt;br&gt;缺：基準仍是可寫的印記；stat 快取只省約 10 ms 卻帶來 mtime 粒度、同長度改寫漏抓、跨平台 mode 誤報、兩條驗證路徑要測；「快」在閘門裡量不出來。&lt;br&gt;可取的部分（檢查範圍要比 A 寬）併入 C。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="480" height="150" as="geometry"/></mxCell><mxCell id="d4_c" value="&amp;lt;b&amp;gt;C（雙軌一致建議）：基準 = 鎖定 image 裡的 /dist&amp;lt;/b&amp;gt;&lt;br&gt;在本來就會起的工具容器內，對 /dist/files 與掛進來的 .&amp;lt;name&amp;gt;/ 做「兩棵樹 diff」：檔案集合（缺、多都失敗，只豁免 .stamp）＋內容 sha256＋執行位（只比該 +x 有沒有 +x）＋型別（lstat 不跟隨 symlink）；不比 mtime、owner。&lt;br&gt;同一個函式給 install / verify / release-test 用。&lt;br&gt;印記降級為「裝的是哪版」的快取鍵 + 給人追溯，不簽章。&lt;br&gt;優：基準不可寫、由 .version 的 digest 鎖定（notes §6 原意）；故意改也抓得到；程式更少。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1040" y="170" width="500" height="150" as="geometry"/></mxCell><mxCell id="d4_flow" value="方案 C 的 verify（第 5 頁 verify 泳道會改成這樣）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1500" height="250" as="geometry"/></mxCell><mxCell id="k0" value="開始 verify" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d4_flow"><mxGeometry x="30" y="60" width="160" height="50" as="geometry"/></mxCell><mxCell id="k1" value="印記第一行 = 啟動器傳進來的 .version 字串？&lt;br&gt;（不是 → 走 install）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d4_flow"><mxGeometry x="230" y="60" width="300" height="50" as="geometry"/></mxCell><mxCell id="k2" value="/dist 與 .&amp;lt;name&amp;gt;/&lt;br&gt;檔案集合相同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d4_flow"><mxGeometry x="570" y="45" width="200" height="80" as="geometry"/></mxCell><mxCell id="k3" value="逐檔比：sha256、執行位、&lt;br&gt;型別（symlink 不跟隨）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="d4_flow"><mxGeometry x="810" y="60" width="260" height="50" as="geometry"/></mxCell><mxCell id="k4" value="全部相符？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d4_flow"><mxGeometry x="1110" y="45" width="180" height="80" as="geometry"/></mxCell><mxCell id="k5" value="通過" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d4_flow"><mxGeometry x="1330" y="60" width="140" height="50" as="geometry"/></mxCell><mxCell id="k6" value="失敗：列出缺／多／被改的檔，&lt;br&gt;中止並提示刪掉重裝（不自動重裝）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="d4_flow"><mxGeometry x="520" y="160" width="300" height="50" as="geometry"/></mxCell><mxCell id="ke0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k0" target="k1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke2" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="k4" target="k5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="k2" target="k6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ke6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="d4_flow" source="k4" target="k6"><mxGeometry x="-0.6" relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="185"/></Array></mxGeometry></mxCell><mxCell id="d4_q" value="雙軌一致（不用再問）：採 C；多餘檔中止（理由：.&amp;lt;name&amp;gt;/ 是整批替換的目錄，下次升級會無聲刪掉它；警告不可強制）；印記不簽章；第一版不做 stat 快取（dist 上百 MB 再說）；verify 失敗中止、不自動重裝；.vendor_kit/ 是例外（沒有 /dist，基準 = image 內程式重新產生 vendor.just 再比）。&lt;br&gt;要你決定：&lt;br&gt;1. 有沒有任何工具會在執行期往 .&amp;lt;name&amp;gt;/ 寫東西（log、快取、產生的 compose）？有的話「多餘檔 = 失敗」要先把它們搬出去。（base 現況？）&lt;br&gt;2. dist 裡有沒有 symlink？沒有就第一版直接禁止 symlink，最省事。&lt;br&gt;3. 主機只支援 Linux 嗎？（macOS Docker Desktop／Windows 掛載的權限位會誤報）&lt;br&gt;4. 時間預算 0.5 秒是算「容器內 verify」還是「整個 just」？後者兩個工具就超過（每次 docker run 約 250 ms，跟 hash 無關）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1500" height="120" as="geometry"/></mxCell><mxCell id="d4_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="220" height="60" as="geometry"/></mxCell><mxCell id="d4_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="280" y="800" width="110" height="60" as="geometry"/></mxCell><mxCell id="d4_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="410" y="810" width="130" height="40" as="geometry"/></mxCell><mxCell id="d4_lg3" value="紅：錯誤終止" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="810" width="130" height="40" as="geometry"/></mxCell><mxCell id="d4_lg4" value="紫：子命令（在容器內執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="710" y="810" width="200" height="40" as="geometry"/></mxCell><mxCell id="d4_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="930" y="810" width="88" height="40" as="geometry"/></mxCell><mxCell id="d4_lg6" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1038" y="810" width="130" height="40" as="geometry"/></mxCell><mxCell id="d4_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1188" y="800" width="300" height="60" as="geometry"/></mxCell><mxCell id="d4_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="200" height="28" as="geometry"/></mxCell><mxCell id="d4_tk0" value="mode / 權限位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="170" height="30" as="geometry"/></mxCell><mxCell id="d4_tv0" value="檔案的讀寫執行權限（例如可執行）；改了它不會動到內容 hash，所以要另外比" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="910" width="900" height="30" as="geometry"/></mxCell><mxCell id="d4_tk1" value="stat / size / mtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="170" height="30" as="geometry"/></mxCell><mxCell id="d4_tv1" value="不打開檔案就能拿到的資訊：大小、最後修改時間；先比這些能省掉大部分 hash 計算" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="940" width="900" height="30" as="geometry"/></mxCell><mxCell id="d4_tk2" value="檔案集合" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="170" height="30" as="geometry"/></mxCell><mxCell id="d4_tv2" value="印記列的檔名清單 vs 目錄裡實際有的檔名：少的 = 缺檔，多的 = 多餘檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="970" width="900" height="30" as="geometry"/></mxCell><mxCell id="d4_tk3" value="cosign / minisign" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="170" height="30" as="geometry"/></mxCell><mxCell id="d4_tv3" value="幫檔案簽名的工具，能證明印記是工具寫的不是別人偽造的；本題先不採用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1000" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>