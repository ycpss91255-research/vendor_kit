Space=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1324" width="220" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1324" width="120" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1324" width="170" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1324" width="160" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1324" width="100" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1324" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1324" width="180" height="36" as="geometry"/></mxCell><mxCell id="p6cw_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1314" width="30" height="20" as="geometry"/></mxCell><mxCell id="p6cw_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1364" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p6cw_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="200" height="28" as="geometry"/></mxCell><mxCell id="p6cw_tk0" value="待辦清單／apply|no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1444" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tv0" value="resolve sync 在引擎內算待辦（要拉哪些 image、要重裝什麼、要不要重生 tools.just）；stdout 只傳 extract 清單、指紋、apply|yes／no；無待辦 → apply|no，啟動器驗完文法直接 0、不起第二個容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1444" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tk1" value="gen/ 三種檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1499" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tv1" value="gen/tools.just：每個 &amp;lt;ns&amp;gt;.just 一行 mod?，sync／add／remove／upgrade 重生；gen/.stamp：只記引擎 ref，只由 install／升引擎寫；gen/&amp;lt;repo&amp;gt;.stamp：每工具印記（第一行 index digest 或 path:，之後每檔 sha256）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1499" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tk2" value="verify／sha256" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1444" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tv2" value="verify 把 cache/&amp;lt;repo&amp;gt;/ 每個檔的 sha256 跟印記比；不符 → 重裝一次 + warn，再驗仍不符 → 1 失敗（不無限重裝）；只在 sync --verify、CI 模式、或版本變動那次做；cache 缺或印記變了就直接重裝，apply 後再驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1444" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tk3" value="覆寫兩種（v2.1 B／v2.2 B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1499" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6cw_tv3" value="引擎本機覆寫 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋image ID → 啟動器 inspect 驗 ID 後用該本機 image；工具本機覆寫 &amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot; → cache 是 symlink，跳過取件／verify，仍查 metadata／基準版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1499" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• me4vn：「否：跳過逐檔驗」標籤壓在 mq 菱形左上邊線上，字被邊線劃過" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1570" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7" name="30 流程 v2：upgrade ── A. Renovate 路徑"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1821" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── A. Renovate 路徑（§2／§7、v2.2 D、v2.3 §7、v2.5 §1／§7、v2.16-15）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="Renovate（GitHub 上）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="64" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr5" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1320" y="64" width="280" height="28" as="geometry"/></mxCell><mxCell id="uA" value="A. Renovate 路徑（下游自選，vendor_kit 不出 bot）：機器人只改 version.toml 一行；PR 的 CI 以新版跑完整流程（⓪～⑤，第一個失敗即停、原碼傳出）；基準版落後 → PR 紅（需人補合併）；補合併在 PR 分支上完成、CI 綠後才 merge" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1318" as="geometry"/></mxCell><mxCell id="uA_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uA"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="a0" value="Renovate 定期查 GHCR" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=8;spacingBottom=8;" vertex="1" parent="uA"><mxGeometry x="270" y="36" width="160" height="58" as="geometry"/></mxCell><mxCell id="a1" value="&amp;lt;repo&amp;gt;-dist&lt;br&gt;出新 tag@digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uA"><mxGeometry x="1100" y="44" width="180" height="42" as="geometry"/></mxCell><mxCell id="a2" value="開 PR（獨立分支）：只改 version.toml 該工具的版本鎖定行（tag@digest）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uA"><mxGeometry x="270" y="114" width="160" height="73" as="geometry"/></mxCell><mxCell id="a3" value="version.toml（PR 分支）&lt;br&gt;&amp;lt;repo&amp;gt; 版本鎖定行 = 新 tag@digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uA"><mxGeometry x="1300" y="130" width="280" height="42" as="geometry"/></mxCell><mxCell id="a4a" value="PR 的 CI 呼叫 .vendor_kit/ci/check.sh（以新版跑完整流程；每個動詞各自一份執行紀錄）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uA"><mxGeometry x="470" y="207" width="220" height="73" as="geometry"/></mxCell><mxCell id="a4r" value="只看一行 diff 不足以證明升級可用（該行仍可能不合法或指向不存在的 ref）&lt;br&gt;→ PR 的 CI 必須以新版跑完整流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="uA"><mxGeometry x="720" y="215" width="360" height="57" as="geometry"/></mxCell><mxCell id="a4b0" value="check.sh ⓪：git ls-files 拒絕被納管的 version.local.toml（納管 → 1 停）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uA"><mxGeometry x="470" y="300" width="220" height="63" as="geometry"/></mxCell><mxCell id="a4b0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uA"><mxGeometry x="666" y="290" width="30" height="20" as="geometry"/></mxCell><mxCell i