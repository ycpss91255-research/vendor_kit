000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1722" width="140" height="64" as="geometry"/></mxCell><mxCell id="p16ccc_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1730" width="150" height="44" as="geometry"/></mxCell><mxCell id="p16ccc_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1724" width="210" height="56" as="geometry"/></mxCell><mxCell id="p16ccc_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1724" width="200" height="56" as="geometry"/></mxCell><mxCell id="p16ccc_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1732" width="100" height="40" as="geometry"/></mxCell><mxCell id="p16ccc_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1732" width="170" height="40" as="geometry"/></mxCell><mxCell id="p16ccc_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1722" width="260" height="60" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="250" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1790" width="120" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1790" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_sub" value="藍：引擎做（容器內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="1790" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1790" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="1790" width="200" height="36" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1196" y="1780" width="30" height="20" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_conv1" value="圖例約定①：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（每個結束碼都寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1834" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16ccc_lgx_conv2" value="圖例約定②：每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start（失敗 → 1 + 6-38、不做任何動作）、結束寫 engine_exit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1860" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16ccc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1892" width="200" height="28" as="geometry"/></mxCell><mxCell id="p16ccc_tk0" value="離線可用（Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1926" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tv0" value="啟動器一律先 docker image inspect：本機有 → 不 pull（不用 --pull never）；斷網 + 本機已有 image → sync／build 必須成功；斷網 + 無 image → docker pull 失敗 → 1 + 6-24／6-31 在 --timeout 內結束、不 hang；離線 upgrade 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1926" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tk1" value="sync 快路徑（Q22）／--verify（F5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1981" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16ccc_tv1" value="sync（無參數）啟動器只用 grep 比對 gen/.stamp 第一行 == version.toml 引擎 ref、gen/&amp;lt;repo&amp;gt;.stamp 第一行 == 鎖定 digest、每個 cache/&amp;lt;repo&amp;gt;/ 存在（目錄或 symlink）、tools.just 存在、無 .tmp.*、非 CI 模式 → 全相符不起容器 0；有差才起引擎；sync --verify 或 CI 模式或版本變動那次 → 先驗既有 cache（每檔 sha256），不符才重裝一次，再驗仍不符 → 失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1981" width="610" height="71" as="geometry"/></mxCell><mxCell id="p16ccc_tk2" value="image ID 記錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2052" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tv2" value="docker load 後的 image 只有 tag、沒有 RepoDigests；docker image inspect --format &#x27;{{.Id}}&#x27; 取 image ID：引擎的本機覆寫記 version.local.toml vendor_kit_image_id、工具記 metadata local_image_id（image ID ↔ index digest 對照，供離線驗證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2052" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tk3" value="指紋／flock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1926" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tv3" value="指紋 = resolve 讀過的檔（version.toml、local、metadata、要動的專案檔、stamp 第一行、.tmp.* 清單、鎖定 digest、argv）的 sha256；apply 拿鎖後重算，不同 → 1 + 6-12「請重跑」；flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1926" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16ccc_tk4" value="gen/&amp;lt;repo&amp;gt;.stamp／gen/tools.just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1981" width="150" height="40" as="geometry"/></mxCell><mxCell id="p16ccc_tv4" value="gen/&amp;lt;repo&amp;gt;.stamp = 印記（第一行 index digest，之後每檔 sha256）；gen/tools.just = 每工具一行 mod?（最後寫、與 cache 同一 apply 內原子替換）；都由引擎 apply（fetch 模組）寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1981" width="610" height="40" as="geometry"/></mxCell><mxCell id="p16ccc_tk5" value="6-N 訊息編號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2021" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16ccc_tv5" value="interface_spec §6 的逐字訊息清單編號（每句含可直接複製的指令）：6-3 無 registry 憑證、6-4 無 tty、6-12 指紋不同、6-15 update 末行、6-16 非 git repo、6-23 just 太舊、6-26 flock 逾時、6-27 未恢復、6-30 vk-resolve 不合、6-31 pull 逾時、6-32 prune 問句、6-33 未完成交易、6-37 --local 值歧義、6-38 log 寫不進…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2021" width="610" height="71" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;wf5n／wf7：否分支仍共用右側幹線。&lt;br&gt;w4r／w4r2／w4r3：失敗線待排版（右側 x=1600 幹線被 wf5n 占用，縫隙段會交叉）。&lt;br&gt;fb_w4r0／fb_w4r0s／fb_w4r0b：到失敗匯流格的線無標籤，w4r0 等格同時有無標籤的正常順序線與失敗線，看不出哪條是失敗。&lt;br&gt;w4vq：把「版本變動那次」併入「先驗既有 cache、相符就 0 不重裝」分支，舊 cache 若仍符合舊印記會回 0 而不裝新版；規格 §1.2 sync 與 sync（2′）頁 m3→m3vd 是印記≠鎖定即先取件重寫、之後才逐檔驗；三頁名詞「sync 快路徑／--verify」說明文同此錯。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2108" width="520" height="174" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dc" name="對外契約（PRD，待拍板）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1969" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="對外契約（PRD）── vendor_kit 要做什麼、使用者只需要 bootstrap.sh + 2 個指令、其他一律自動" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="dc_pend" value="⚠ 待你回覆（與先前決議不同的地方）：&lt;br&gt;(a) init／add 都不要：接新工具 = .version 加一行（手動或再跑 bootstrap.sh），ensure 第一次自動 init？ (b) verify 失敗改成自動重裝（推翻 #12「中止不重裝」）？&lt;br&gt;(c) vendor_kit 自身升級自動 re-exec，不停下來要你重跑？ (d) diff／accept 併進 upgrade（三方合併＋衝突標記，baseline 自動更新）？&lt;br&gt;(e) undev 併成 dev &amp;lt;repo&amp;gt; 不帶 -p？ (f) upgrade 要不要 --to &amp;lt;tag&amp;gt; 選項（指定版本）？" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="12" width="620" height="112" as="geometry"/></mxCell><mxCell id="dcA" value="A. 目的與角色" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1560" height="150" as="geometry"/></mxCell><mxCell id="dcA_goal" value="目的（一句話）：工具 repo（例：base）把自己的 dist 打包成 GHCR image；下游專案只要三個指令就能拿到工具檔、跟上新版、在本機開發工具本身。&lt;br&gt;契約只對右邊前兩個角色承諾：他們照契約用一定可以，改了介面就要升版並公告。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;align=left;spacingLeft=8;strokeWidth=1;" vertex="1" parent="dcA"><mxGeometry x="20" y="50" width="700" height="84" as="geometry"/></mxCell><mxCell id="dcA_r1" value="工具 repo 開發者（供應側）&lt;br&gt;照 §E 規格出貨 dist 與 image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcA"><mxGeometry x="760" y="50" width="250" height="84" as="geometry"/></mxCell><mxCell id="dcA_r2" value="使用者（下游專案）&lt;br&gt;每天打 just 的人；只需要 §B 三個指令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcA"><mxGeometry x="1030" y="50" width="250" height="84" as="geometry"/></mxCell><mxCell id="dcA_r3" value="vendor_kit 開發者（我們）&lt;br&gt;維護引擎與啟動器；契約不對自己承諾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcA"><mxGeometry x="1300" y="50" width="240" height="84" as="geometry"/></mxCell><mxCell id="dcB" value="B. 使用者介面：bootstrap.sh + 2 個指令（其他全部隱藏，見 C）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1560" height="247" as="geometry"/></mxCell><mxCell id="dcB_h0" value="介面" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="20" y="50" width="250" height="30" as="geometry"/></mxCell><mxCell id="dcB_h1" value="什麼時候用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="270" y="50" width="200" height="30" as="geometry"/></mxCell><mxCell id="dcB_h2" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="470" y="50" width="840" height="30" as="geometry"/></mxCell><mxCell id="dcB_h3" value="結束狀態" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="1310" y="50" width="230" height="30" as="geometry"/></mxCell><mxCell id="dcB_r0c0" value="bootstrap.sh&lt;br&gt;（release 附的腳本，只跑一次）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="20" y="80" width="250" height="44" as="geometry"/></mxCell><mxCell id="dcB_r0c1" value="專案第一次接 vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="270" y="80" width="200" height="44" as="geometry"/></mxCell><mxCell id="dcB_r0c2" value="問你「要接哪個工具、哪個版本」→ 寫 .version、根 justfile 一行 import、.vendor_kit/ 薄殼（進 git）→ 直接跑 install + init → 腳本自刪。之後想再接第二個工具：再跑一次 bootstrap.sh（它會問你並加一行到 .version），或直接手動加一行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="470" y="80" width="840" height="44" as="geometry"/></mxCell><mxCell id="dcB_r0c3" value="0 成功&lt;br&gt;1 失敗（什麼都沒寫）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="1310" y="80" width="230" height="44" as="geometry"/></mxCell><mxCell id="dcB_r1c0" value="just vendor_kit upgrade [&amp;lt;repo&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="20" y="124" width="250" height="59" as="geometry"/></mxCell><mxCell id="dcB_r1c1" value="想跟上新版（沒 Renovate、或想馬上升）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="270" y="124" width="200" height="59" as="geometry"/></mxCell><mxCell id="dcB_r1c2" value="查 GHCR 最新 → 改 .version → install → 三方合併初始檔（§D）→ 印摘要。不給 &amp;lt;repo&amp;gt; = 全部工具；含 vendor_kit 自己" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="470" y="124" width="840" height="59" as="geometry"/></mxCell><mxCell id="dcB_r1c3" value="0 完成&lt;br&gt;1 失敗（.version 不動）&lt;br&gt;2 有衝突要你改" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="1310" y="124" width="230" height="59" as="geometry"/></mxCell><mxCell id="dcB_r2c0" value="just vendor_kit dev &amp;lt;repo&amp;gt; -p/--path &amp;lt;dir&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="20" y="183" width="250" height="44" as="geometry"/></mxCell><mxCell id="dcB_r2c1" value="開發工具本身，想在專案裡直接試" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="270" y="183" width="200" height="44" as="geometry"/></mxCell><mxCell id="dcB_r2c2" value=".&amp;lt;repo&amp;gt;/ 改指向本機目錄（寫 .version.local，不進 git）；再打一次 dev &amp;lt;repo&amp;gt; 不帶 -p = 解除（不另開 undev）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="470" y="183" width="840" height="44" as="geometry"/></mxCell><mxCell id="dcB_r2c3" value="0 成功&lt;br&gt;1 失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcB"><mxGeometry x="1310" y="183" width="230" height="44" as="geometry"/></mxCell><mxCell id="dcC" value="C. 其他全部由 ensure 自動做（每次打 just 都跑）── 紅框 = 與先前決議不同" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="567" width="1560" height="312" as="geometry"/></mxCell><mxCell id="dcC_h0" value="狀況" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="50" width="360" height="30" as="geometry"/></mxCell><mxCell id="dcC_h1" value="以前的做法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="50" width="480" height="30" as="geometry"/></mxCell><mxCell id="dcC_h2" value="改成自動（每次打 just，ensure 先跑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="860" y="50" width="680" height="30" as="geometry"/></mxCell><mxCell id="dcC_r0c0" value=".version 有工具但 .vendor_kit/baseline/&amp;lt;repo&amp;gt;/ 不存在（第一次接這個工具）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="80" width="360" height="44" as="geometry"/></mxCell><mxCell id="dcC_r0c1" value="要打 just vendor_kit init &amp;lt;repo&amp;gt;（或 add）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="80" width="480" height="44" as="geometry"/></mxCell><mxCell id="dcC_r0c2" value="ensure 判定第一次 → install + init（已存在的檔 warn 不覆蓋）；之後只走 upgrade 三方合併" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" vertex="1" parent="dcC"><mxGeometry x="860" y="80" width="680" height="44" as="geometry"/></mxCell><mxCell id="dcC_r1c0" value="clone 後 .&amp;lt;repo&amp;gt;/ 不存在" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="124" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r1c1" value="ensure → install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="124" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r1c2" value="同：install 後才跑你要的指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="860" y="124" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcC_r2c0" value=".version 被 pull／revert 改了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="152" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r2c1" value="印記第一行 ≠ .version → install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="152" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r2c2" value="同；回退 = git revert 那個 commit，沒有指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="860" y="152" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcC_r3c0" value=".&amp;lt;repo&amp;gt;/ 被手改（verify 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="180" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r3c1" value="#12 決議：中止、不自動重裝" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="180" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r3c2" value="改成自動重裝：.&amp;lt;repo&amp;gt;/ 不進 git、使用者本來就不該改，重裝沒有損失；只印一行 warn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" vertex="1" parent="dcC"><mxGeometry x="860" y="180" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcC_r4c0" value=".version 的 vendor_kit 那行變了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="208" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r4c1" value="upgrade C 案：先換自己、停下來要你重跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="208" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r4c2" value="改成自動：啟動器換完 .vendor_kit/gen/ 後直接 exec 新版跑同一個指令，使用者無感" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" vertex="1" parent="dcC"><mxGeometry x="860" y="208" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcC_r5c0" value="Renovate 開 PR 升版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="236" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r5c1" value="走 upgrade 那條線" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="236" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r5c2" value="不變：merge 後每個人下次打 just 就自動 install，零指令" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="860" y="236" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcC_r6c0" value="docker 沒裝／沒網路／鎖逾時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="20" y="264" width="360" height="28" as="geometry"/></mxCell><mxCell id="dcC_r6c1" value="報錯" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="380" y="264" width="480" height="28" as="geometry"/></mxCell><mxCell id="dcC_r6c2" value="報錯（這種真的無法自動）：訊息要寫清楚缺什麼、怎麼補" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="dcC"><mxGeometry x="860" y="264" width="680" height="28" as="geometry"/></mxCell><mxCell id="dcD" value="D. 唯一無法自動化的地方：upgrade 後初始檔衝突（跟 git merge 一樣處理）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="899" width="1560" height="300" as="geometry"/></mxCell><mxCell id="dcD_in1" value="baseline&lt;br&gt;.vendor_kit/baseline/&amp;lt;repo&amp;gt;/（上一版範本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="dcD"><mxGeometry x="20" y="60" width="320" height="56" as="geometry"/></mxCell><mxCell id="dcD_in2" value="你現在的檔&lt;br&gt;（專案裡的初始檔，可能改過）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="dcD"><mxGeometry x="20" y="130" width="320" height="56" as="geometry"/></mxCell><mxCell id="dcD_in3" value="新版範本&lt;br&gt;（新版工具 image 的 init 檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="dcD"><mxGeometry x="20" y="200" width="320" height="56" as="geometry"/></mxCell><mxCell id="dcD_m" value="upgrade 逐檔三方合併&lt;br&gt;（git merge-file）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;" vertex="1" parent="dcD"><mxGeometry x="400" y="60" width="200" height="190" as="geometry"/></mxCell><mxCell id="dcD_o1" value="你沒改過 → 直接換成新版" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcD"><mxGeometry x="700" y="60" width="300" height="56" as="geometry"/></mxCell><mxCell id="dcD_o2" value="只有你改、工具沒改 → 不動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcD"><mxGeometry x="700" y="130" width="300" height="56" as="geometry"/></mxCell><mxCell id="dcD_o3" value="兩邊都改 → 檔案裡留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; 衝突標記&lt;br&gt;upgrade 回 2 並列出檔名，你在編輯器解掉即可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=12;strokeWidth=1;" vertex="1" parent="dcD"><mxGeometry x="700" y="200" width="300" height="56" as="geometry"/></mxCell><mxCell id="dcD_note" value="所以不需要 diff／accept 兩個指令：&lt;br&gt;・baseline 由 upgrade 自動推到新版（合併完就是新基準），不需 accept&lt;br&gt;・diff 變成 upgrade --dry-run（只印會動哪些檔，不寫）&lt;br&gt;・解完衝突不用再打任何指令；下次 just 只會 ensure、不會再合併&lt;br&gt;・二進位檔無法合併：保留你的，印 warn" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="dcD"><mxGeometry x="1020" y="60" width="520" height="190" as="geometry"/></mxCell><mxCell id="dcD_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1474;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_in1" target="dcD_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcD_f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.1474;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_m" target="dcD_o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcD_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5158;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_in2" target="dcD_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcD_f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5158;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_m" target="dcD_o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcD_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8842;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_in3" target="dcD_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcD_f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.8842;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcD_m" target="dcD_o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dcE" value="E. 對工具 repo 的介面（供應側，不變）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1219" width="760" height="250" as="geometry"/></mxCell><mxCell id="dcE_1" value="dist/：files/（要裝進 .&amp;lt;repo&amp;gt;/ 的全部檔）、init.toml（[[file]] src／dest 初始檔清單）、just/&amp;lt;repo&amp;gt;.just（工具自己的指令）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcE"><mxGeometry x="20" y="50" width="720" height="44" as="geometry"/></mxCell><mxCell id="dcE_2" value="Dockerfile.dist：FROM scratch，只 COPY dist/ 到 /dist；不 FROM vendor_kit、沒有程式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcE"><mxGeometry x="20" y="104" width="720" height="40" as="geometry"/></mxCell><mxCell id="dcE_3" value="image 命名 &amp;lt;repo&amp;gt;-dist:&amp;lt;tag&amp;gt;，多架構 amd64 + arm64（同一個 tag）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcE"><mxGeometry x="20" y="154" width="720" height="40" as="geometry"/></mxCell><mxCell id="dcE_4" value="工具自己的指令（just &amp;lt;repo&amp;gt; …、just docker …）由工具的 just 模組提供；vendor_kit 不定義、不出現在 §B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="dcE"><mxGeometry x="20" y="204" width="720" height="40" as="geometry"/></mxCell><mxCell id="dcF" value="F. 專案裡的檔（誰進 git）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="840" y="1219" width="760" height="250" as="geometry"/></mxCell><mxCell id="dcF_g" value="進 git&lt;br&gt;・.version（引擎一行 + 每個工具一行）&lt;br&gt;・根 justfile 的一行 import &#x27;.vendor_kit/entry.just&#x27;&lt;br&gt;・.vendor_kit/entry.just、vendor.just（薄殼）&lt;br&gt;・.vendor_kit/ci/check.sh&lt;br&gt;・.vendor_kit/baseline/&amp;lt;repo&amp;gt;/（三方合併的基準）&lt;br&gt;・初始檔（init 複製出來、你的）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="dcF"><mxGeometry x="20" y="50" width="350" height="180" as="geometry"/></mxCell><mxCell id="dcF_n" value="不進 git（引擎隨時能重建）&lt;br&gt;・.vendor_kit/gen/（ensure 每次重產的其餘指令）&lt;br&gt;・.&amp;lt;repo&amp;gt;/（工具檔全部 + .stamp 印記）&lt;br&gt;・.version.local（dev 模式的本機覆蓋）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="dcF"><mxGeometry x="390" y="50" width="350" height="180" as="geometry"/></mxCell><mxCell id="dc_lg0" value="黃：外部（使用者、外部系統）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=14;container=0;collapsible=0;fillColor=#FFF4C3;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1489" width="220" height="60" as="geometry"/></mxCell><mxCell id="dc_lg1" value="紫：image / container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="1499" width="200" height="40" as="geometry"/></mxCell><mxCell id="dc_lg2" value="白：最小單元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="500" y="1499" width="120" height="40" as="geometry"/></mxCell><mxCell id="dc_lg3" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="1499" width="170" height="40" as="geometry"/></mxCell><mxCell id="dc_lg4" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="1499" width="130" height="40" as="geometry"/></mxCell><mxCell id="dc_lgt" value="實線 = 資料流向&lt;br&gt;紅框 = 與先前決議不同的地方" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="980" y="1489" width="300" height="60" as="geometry"/></mxCell><mxCell id="dc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1565" width="200" height="28" as="geometry"/></mxCell><mxCell id="dc_tk0" value="對外契約" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1599" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv0" value="我們承諾「這樣用一定可以、不會隨便改」的介面清單；改了就要升版並公告" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1599" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk1" value="bootstrap.sh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1629" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv1" value="release 附的一次性腳本：詢問後寫出 .version／justfile／.vendor_kit/ 並跑 install + init，然後自刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1629" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk2" value="ensure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1659" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv2" value="每次打 just 都先跑的自動檢查：.&amp;lt;repo&amp;gt;/ 缺、舊、被改都自動修好，vendor_kit 自己版本變了也自動換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1659" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk3" value="三方合併／baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1689" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv3" value="拿「上一版範本（baseline）、你現在的檔、新版範本」三份比對，能自動合的就合；baseline 存在 .vendor_kit/baseline/&amp;lt;repo&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1689" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk4" value="衝突標記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1719" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv4" value="跟 git 一樣的 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; ======= &amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 記號，寫在檔案裡讓你自己選要留哪邊" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1719" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk5" value=".version.local" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1749" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv5" value="dev 模式寫的本機覆蓋檔（不進 git）：某個工具改用本機目錄而不是 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1749" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk6" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1779" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv6" value="GitHub Container Registry；工具 image 放的地方，.version 記完整位址與 digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1779" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk7" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1809" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv7" value="GitHub 上的機器人：發現 GHCR 有新版就自動開 PR 改 .version；自動升級那條線靠它" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1809" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk8" value="第一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1839" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv8" value="baseline/&amp;lt;repo&amp;gt;/ 不存在 = 這個工具還沒初始化過；ensure 看到就自動 install + init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1839" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk9" value="結束狀態 0／1／2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1869" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv9" value="指令結束時的數字：0 成功、1 失敗（沒有寫任何東西）、2 完成但有衝突要你處理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1869" width="900" height="30" as="geometry"/></mxCell><mxCell id="dc_tk10" value="&amp;lt;repo&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1899" width="170" height="30" as="geometry"/></mxCell><mxCell id="dc_tv10" value="工具 repo 名（例：base）；.&amp;lt;repo&amp;gt;/ = 專案裡裝好的工具檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1899" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d0" name="使用方式（乙版）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1718" pageHeight="1134" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="使用方式（乙版）：三個時刻各一條線（&amp;lt;repo&amp;gt; = 工具 repo 名，例：base）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="34" as="geometry"/></mxCell><mxCell id="L1" value="① 第一次接上（使用者，只做一次）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1620" height="340" as="geometry"/></mxCell><mxCell id="a0" value="跑 bootstrap.sh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="L1"><mxGeometry x="30" y="55.0" width="150" height="70" as="geometry"/></mxCell><mxCell id="a1" value="生成四個檔：&lt;br&gt;.version、justfile、&lt;br&gt;.vendor_kit/、renovate.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;dashed=1;" vertex="1" parent="L1"><mxGeometry x="204" y="55.0" width="280" height="70" as="geometry"/></mxCell><mxCell id="a1_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="bootstrap.sh 結尾印：&lt;br&gt;「下一步：在 .version 加工具，&lt;br&gt;然後 just vendor_kit init」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="L1"><mxGeometry x="508" y="55.0" width="250" height="70" as="geometry"/></mxCell><mxCell id="a2_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="在 .version 加一行：&lt;br&gt;要用的工具 + 版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;" vertex="1" parent="L1"><mxGeometry x="782" y="55.0" width="170" height="70" as="geometry"/></mxCell><mxCell id="a3_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="just vendor_kit init" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;" vertex="1" parent="L1"><mxGeometry x="976" y="55.0" width="170" height="70" as="geometry"/></mxCell><mxCell id="a4_e" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0