verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="1266" y="280" width="30" height="20" as="geometry"/></mxCell><mxCell id="b1" value="docker run &amp;lt;引擎&amp;gt; resolve upgrade &amp;lt;repo&amp;gt;&lt;br&gt;（啟動器不鎖）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB"><mxGeometry x="460" y="421" width="240" height="63" as="geometry"/></mxCell><mxCell id="b1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="676" y="411" width="30" height="20" as="geometry"/></mxCell><mxCell id="b1e" value="resolve（不寫任何檔）：讀 version.toml、version.local.toml、metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB"><mxGeometry x="720" y="428" width="360" height="48" as="geometry"/></mxCell><mxCell id="b1e_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="1056" y="418" width="30" height="20" as="geometry"/></mxCell><mxCell id="b1x" value="1：請先 undev &amp;lt;repo&amp;gt;（本機覆寫中）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="uB"><mxGeometry x="20" y="516" width="220" height="58" as="geometry"/></mxCell><mxCell id="b1x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="216" y="506" width="30" height="20" as="geometry"/></mxCell><mxCell id="b1q" value="&amp;lt;repo&amp;gt; 在本機覆寫（dev）中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=70;spacingRight=70;spacingTop=20;spacingBottom=20;" vertex="1" parent="uB"><mxGeometry x="720" y="504" width="280" height="81" as="geometry"/></mxCell><mxCell id="b1q_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="976" y="494" width="30" height="20" as="geometry"/></mxCell><mxCell id="b2c" value="2：先解完衝突再重跑" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=6;spacingBottom=6;" vertex="1" parent="uB"><mxGeometry x="20" y="641" width="220" height="40" as="geometry"/></mxCell><mxCell id="b2c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="216" y="631" width="30" height="20" as="geometry"/></mxCell><mxCell id="b2" value="否 → (0) conflicts 中的檔仍含我們的標籤，或檔案失蹤？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=90;spacingRight=90;spacingTop=28;spacingBottom=28;" vertex="1" parent="uB"><mxGeometry x="720" y="605" width="360" height="112" as="geometry"/></mxCell><mxCell id="b2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="1056" y="595" width="30" height="20" as="geometry"/></mxCell><mxCell id="b2n" value="標籤 = 我們自己產的 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; vendor_kit:baseline 等；檔案失蹤不算已解；resolve 只偵測，「清除已解的衝突狀態」在 apply 內、建進度檔之後（v2.5 §3）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="uB"><mxGeometry x="1300" y="624" width="280" height="73" as="geometry"/></mxCell><mxCell id="b5" value="1：無基準版，請先 add &amp;lt;repo&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="uB"><mxGeometry x="20" y="748" width="220" height="58" as="geometry"/></mxCell><mxCell id="b4" value="否 → 有 baseline/&amp;lt;repo&amp;gt;/？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=85;spacingRight=85;spacingTop=20;spacingBottom=20;" vertex="1" parent="uB"><mxGeometry x="730" y="737" width="340" height="81" as="geometry"/></mxCell><mxCell id="b6" value="(1) 有待合併？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=38;spacingRight=38;spacingTop=20;spacingBottom=20;" vertex="1" parent="uB"><mxGeometry x="720" y="838" width="150" height="81" as="geometry"/></mxCell><mxCell id="b6_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="846" y="828" width="30" height="20" as="geometry"/></mxCell><mxCell id="b6y" value="是：目標版 = B（version.toml 那版），補到就停，不查最新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB"><mxGeometry x="900" y="939" width="160" height="63" as="geometry"/></mxCell><mxCell id="b6y_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="1036" y="929" width="30" height="20" as="geometry"/></mxCell><mxCell id="b7a" value="否 → 指定 @&amp;lt;tag&amp;gt;？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=38;spacingRight=38;spacingTop=20;spacingBottom=20;" vertex="1" parent="uB"><mxGeometry x="720" y="1022" width="150" height="81" as="geometry"/></mxCell><mxCell id="b7a_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="846" y="1012" width="30" height="20" as="geometry"/></mxCell><mxCell id="b7t" value="是：目標版 = @&amp;lt;tag&amp;gt;（比現版舊 → warn 仍執行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB"><mxGeometry x="900" y="1031" width="160" height="63" as="geometry"/></mxCell><mxCell id="b7t_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB"><mxGeometry x="1036" y="1021" width="30" height="20" as="geometry"/></mxCell><mxCell id="b7b" value="否 → CI 模式？" style="rhombus;whiteSpace=wr