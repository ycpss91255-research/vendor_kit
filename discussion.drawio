"1"><mxGeometry x="280" y="2084" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="2084" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="2084" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="2084" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="2084" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="2084" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1210" y="2084" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1366" y="2074" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7cc_lgx_tty" value="橙小標：問句無 tty／EOF 且無 -y → 1 + 6-4（Ctrl-C 中止、不記拒絕）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1410" y="2084" width="300" height="36" as="geometry"/></mxCell><mxCell id="p7cc_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2124" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7cc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2170" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7cc_tk0" value="B／D／N、逐檔判斷後詢問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2204" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7cc_tv0" value="B = 基準版（上次合併的範本）、D = 現況（專案檔）、N = 目標版範本（暫存 /dist/&amp;lt;repo&amp;gt;，不是 cache）；依 metadata state 分流的狀態機（見「逐檔判斷」頁）決定不動／warn／問 6-22；-y 免問；拒絕 → 不動、記 declined_hash，新檔被拒才 state=declined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2204" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7cc_tk1" value="git merge-file --diff3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2259" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7cc_tv1" value="git 的三方合併指令；衝突時在檔內留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; vendor_kit:baseline ||||||| ======= &amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 標記（我們自己的標籤，重入時靠它偵測）；回傳衝突數 → 結束碼 2（需人處理，橙）；多工具（Q27）兩者皆回 2 時訊息全部列出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2259" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7cc_tk2" value="6-6／6-7／6-8（dry-run 提醒）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2314" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tv2" value="6-6「有 N 個範本你拒絕過」；6-7「&amp;lt;X&amp;gt; 沒納管」；6-8「&amp;lt;Y&amp;gt; 你拒絕過，&amp;lt;vZ&amp;gt; 有新版」；--dry-run／check.sh 印，不問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2314" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tk3" value="6-22（upgrade 逐檔問句）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2204" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tv3" value="「&amp;lt;X&amp;gt; 換成新版？」／「你和新版都改了 &amp;lt;X&amp;gt;，要三方合併嗎？」／「要建 &amp;lt;X&amp;gt; 嗎」／「&amp;lt;X&amp;gt; 是二進位檔，要換成新版嗎？」；config.toml 三方合併也用它；-y 免問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2204" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tk4" value="6-4（無 tty）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2244" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tv4" value="需詢問但無 tty／EOF 且無 -y → 1：「需要確認但沒有終端可互動。請加 -y，或在終端執行。」；Ctrl-C 中止整個 apply 回 1、不套用、不記拒絕（declined 只記明確回答「否」）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2244" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tk5" value="解析失敗（§4.3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2284" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cc_tv5" value="合併結果是 TOML／just 等可解析格式卻解析失敗 → 只該檔留原檔、記 conflicts、其基準版不推；其他通過的檔照常原子替換；結束碼 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2284" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• be20qn：「否」標籤畫在 b13a 方框內左上角，像是 b13a 的文字" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2340" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7cccc" name="34 流程 v2：upgrade ── B. 手動路徑（2′）收尾寫入"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1668" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── B. 手動路徑（2′）收尾寫入（§5、v2.2 D、v2.5 §3／§4、v2.6 Q27）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="Renovate（GitHub 上）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="64" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr5" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1320" y="64" width="280" height="28" as="geometry"/></mxCell><mxCell id="uB3" value="B（2′）apply 寫入段後半（承「B（2）」頁：通過解析的檔已替換；解析失敗的檔留原檔、已記 conflicts）：推基準版（解析失敗的檔不推）→ metadata → tools.just（原子替換）→ 待合併？否 → 寫 version.toml → 刪進度檔 → 0／2" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1052" as="geometry"/></mxCell><mxCell id="uB3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="b15z" value="來自「B（2）」頁：通過解析的檔已原子替換；解析失敗的檔留原檔、已記 conflicts（已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=53;spacingRight=53;spacingTop=12;spacingBottom=12;" vertex="1" parent="uB3"><mxGeometry x="720" y="36" width="360" height="80" as="geometry"/></mxCell><mxCell id="b15a" value="推 baseline/&amp;lt;repo&amp;gt;/ 到目標版：逐檔，通過的檔推到 N（有衝突標記也推）；解析失敗的檔跳過不推（該檔基準版留上一版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="720" y="136" width="360" height="63" as="geometry"/></mxCell><mxCell id="b15a_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1056" y="126" width="30" height="20" as="geometry"/></mxCell><mxCell id="b15f" value="baseline/&amp;lt;repo&amp;gt;/（目標版範本副本，進 git；解析失敗的檔留上一版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="1300" y="146" width="280" height="42" as="geometry"/></mxCell><mxCell id="b15b" value="寫 metadata：source = 目標版（= 最後合併版本；解析失敗的檔另在 conflicts，其基準版留舊版）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="720" y="219" width="360" height="48" as="geometry"/></mxCell><mxCell id="b15b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1056" y="209" width="30" height="20" as="geometry"/></mxCell><mxCell id="b15bf" value="baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml（source；進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="1300" y="222" width="280" height="42" as="geometry"/></mxCell><mxCell id="b15c" value="寫 metadata：conflicts（有衝突標記或解析失敗的 dest 清單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="720" y="287" width="360" height="48" as="geometry"/></mxCell><mxCell id="b15c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1056" y="277" width="30" height="20" as="geometry"/></mxCell><mxCell id="b15cf" value=".vendor_kit.toml（conflicts）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="1300" y="291" width="280" height="40" as="geometry"/></mxCell><mxCell id="b15d" value="寫 metadata：每個 dest 的 state／declined_hash／lines —— 已納管檔拒絕 → state 不變只記 declined_hash；新檔被拒 → state=declined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="720" y="355" width="360" height="63" as="geometry"/></mxCell><mxCell id="b15d_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1056" y="345" width="30" height="20" as="geometry"/></mxCell><mxCell id="b15df" value=".vendor_kit.toml（[[file]] 各 dest 的 state／declined_hash／lines）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="1300" y="366" width="280" height="42" as="geometry"/></mxCell><mxCell id="b15g" value="重生 gen/tools.just（新版的 just/&amp;lt;ns&amp;gt;.just 可能增減；原子替換，與本次 cache 同一 apply 內，I17）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uB3"><mxGeometry x="720" y="438" width="360" height="48" as="geometry"/></mxCell><mxCell id="b15g_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uB3"><mxGeometry x="1056" y="428" width="30" height="20" as="geometry"/>