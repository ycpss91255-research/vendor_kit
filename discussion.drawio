parent="1"><mxGeometry x="40" y="1699" width="200" height="60" as="geometry"/></mxCell><mxCell id="p11_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1699" width="140" height="64" as="geometry"/></mxCell><mxCell id="p11_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1707" width="150" height="44" as="geometry"/></mxCell><mxCell id="p11_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1701" width="210" height="56" as="geometry"/></mxCell><mxCell id="p11_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1701" width="200" height="56" as="geometry"/></mxCell><mxCell id="p11_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1709" width="100" height="40" as="geometry"/></mxCell><mxCell id="p11_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1709" width="170" height="40" as="geometry"/></mxCell><mxCell id="p11_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1699" width="260" height="60" as="geometry"/></mxCell><mxCell id="p11_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1767" width="120" height="36" as="geometry"/></mxCell><mxCell id="p11_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="1767" width="200" height="36" as="geometry"/></mxCell><mxCell id="p11_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="356" y="1757" width="30" height="20" as="geometry"/></mxCell><mxCell id="p11_lgx_state" value="粗框白格：狀態（state 值）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="1767" width="200" height="36" as="geometry"/></mxCell><mxCell id="p11_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1817" width="200" height="28" as="geometry"/></mxCell><mxCell id="p11_tk0" value="metadata [[file]].state（Q15、16 條）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1851" width="150" height="55" as="geometry"/></mxCell><mxCell id="p11_tv0" value="baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml 對每個初始檔一筆：state 單一列舉 managed／appended／declined／unmanaged／deleted；declined_hash（選填）= 最近一次被拒絕的那版新版初始檔 N 的 sha256；lines（只在 appended）= 實際插入的行原文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1851" width="610" height="55" as="geometry"/></mxCell><mxCell id="p11_tk1" value="declined 語意（v2.7-3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1906" width="150" height="55" as="geometry"/></mxCell><mxCell id="p11_tv1" value="state=declined 只用於「初始檔要建的新檔被拒、從未建立」；已納管（managed／appended）的檔拒絕本次更新 → state 不變、只記 declined_hash（畫成自環）；add 時 append 檔已存在且拒絕 → unmanaged（本來就有、沒納管）；二進位拒絕同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1906" width="610" height="55" as="geometry"/></mxCell><mxCell id="p11_tk2" value="B／D／N" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1961" width="150" height="55" as="geometry"/></mxCell><mxCell id="p11_tv2" value="B = 基準版（上次合併時的初始檔原版副本，進 git）；D = 現況（專案裡你的那份檔）；N = 新版初始檔 = 啟動器把目標版 image 展開到暫存、掛進引擎的 /dist/&amp;lt;repo&amp;gt;（不是 cache；v2.5 §2）；「D==B」= 你沒改過" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1961" width="610" height="55" as="geometry"/></mxCell><mxCell id="p11_tk3" value="upgrade 逐檔判斷（managed）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2016" width="150" height="71" as="geometry"/></mxCell><mxCell id="p11_tv3" value="D 缺 → deleted；N 缺（新版刪了該檔）→ 不刪專案檔、只 warn；D==N 或 B==N → 不動；D==B → 問「X 換成新版？」；三者皆異 → 問後 git merge-file --diff3（衝突 → 2）；不論結果基準版推到 N（合併後 TOML／just 解析失敗的檔不推）；二進位／symlink 未改 → 問後換、改過保留 + warn；拒絕 → 記 declined_hash、state 維持 managed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2016" width="610" height="71" as="geometry"/></mxCell><mxCell id="p11_tk4" value="declined 再問規則（Q14／Q15）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1851" width="150" height="55" as="geometry"/></mxCell><mxCell id="p11_tv4" value="新版 N 的 hash ≠ declined_hash → 再問一次「要建 X 嗎」（同意 → 建 → managed；拒絕 → 仍 declined、更新 declined_hash）；相同 → 不問，只印 6-6／6-8；EOF／Ctrl-C 不算拒絕、不記 declined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1851" width="610" height="55" as="geometry"/></mxCell><mxCell id="p11_tk5" value="append 行（Q6／Q12／Q13）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1906" width="150" height="55" as="geometry"/></mxCell><mxCell id="p11_tv5" value="strategy=append 的檔已存在 → 問「要在 X 加這幾行嗎」；同意 → 插入並記 lines；upgrade 用原文比對（CRLF／LF 等價）找上次插入的行：唯一命中 → 問後替換、零命中 → 不動只印新內容、多處 → 保留並 warn；remove／uninstall 問後只刪原文相同的行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1906" width="610" height="55" as="geometry"/></mxCell><mxCell id="p11_tk6" value="dry-run／check.sh 印什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1961" width="150" height="40" as="geometry"/></mxCell><mxCell id="p11_tv6" value="upgrade --dry-run 與 ci/check.sh ③ 印 6-6「有 N 個範本你拒絕過」、6-7「X 沒納管，與範本差 N 行」、6-8「Y 你拒絕過，vZ 有新版」；不動檔、不紅燈（CI 需改 進 git 的檔才 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1961" width="610" height="40" as="geometry"/></mxCell><mxCell id="p11_tk7" value="6-11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2001" width="150" height="40" as="geometry"/></mxCell><mxCell id="p11_tv7" value="add 遇 copy 檔已存在：「&amp;lt;X&amp;gt; 已存在，未納管；範本在 .vendor_kit/cache/&amp;lt;repo&amp;gt;/files/ 可自行比對」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2001" width="610" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p12" name="57 狀態機 v2：交易與進度檔"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="2395" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="狀態機 v2：交易與進度檔（interface_spec §0、§3.2 apply、§4.3 [progress]、§4.6）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（v2.5-3、v2.6-9、v2.7-7、v2.13 P5、v2.15-5／-10、interface_spec §0、§4.3、§4.6）：apply 順序 = flock → 重驗指紋 → dry-run 分支 → 建進度檔（第一個寫入前）→ 寫入 → 最後刪進度檔；單段可寫動詞（install／dev／升引擎）不畫成 resolve→apply；中斷 → 1 明列已完成／未完成；下次可寫動詞先恢復（三型）、唯讀動詞只提示 6-33；prune 特例只列出；dev 也建 .tmp.dev.&amp;lt;id&amp;gt;.toml。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="100" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="引擎容器（apply 段）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="480" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="規則／說明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="120" width="390" height="28" as="geometry"/></mxCell><mxCell id="bT1" value="交易生命週期：兩段動詞的 apply 段（拿鎖 → 重驗指紋 → dry-run 分支）→ 建進度檔 → 逐步寫入（每步 ① 寫暫存 ② 原子替換 ③ 進度檔 done）→ 刪進度檔；單段可寫動詞從「建進度檔」進入；中斷 → 1、進度檔留著" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="164" width="1590" height="1007" as="geometry"/></mxCell><mxCell id="bT1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bT1"><mxGeometry x="1546" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="t0" value="來自兩段動詞頁：resolve → 啟動器 docker 之後，apply &amp;lt;verb&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=35;spacingRight=35;spacingTop=12;spacingBottom=12;" vertex="1" parent="bT1"><mxGeometry x="20" y="36" width="240" height="80" as="geometry"/></mxCell><mxCell id="t1" value="拿 flock 專案目錄（60 秒；VENDOR_KIT_NO_LOCK=1 跳過）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="56" width="480" height="40" as="geometry"/></mxCell><mxCell id="t1i" value="不變量：回 3 一律零寫入（無任何例外）；工具層回 1 時 version.toml 不動；進度檔在第一個寫入前建、最後一步刪；never fail silently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bT1"><mxGeometry x="1180" y="48" width="390" height="57" as="geometry"/></mxCell><mxCell id="t1x" value="逾時 → 1 + 6-26：確認無其他 vendor_kit 在跑後重試（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=44;spacingRight=44;spacingTop=12;spacingBottom=12;" vertex="1" parent="bT1"><mxGeometry x="820" y="36" width="300" height="80" as="geometry"/></mxCell><mxCell id="t1x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bT1"><mxGeometry x="1096" y="26" width="30" height="20" as="geometry"/></mxCell><mxCell id="t2x" value="指紋不同 → 1 + 6-12：請重跑（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=8;spacingBottom=8;" vertex="1" parent="bT1"><mxGeometry x="20" y="126" width="240" height="58" as="geometry"/></mxCell><mxCell id="t2x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bT1"><mxGeometry x="236" y="116" width="30" height="20" as="geometry"/></mxCell><mxCell id="t2" value="重驗指紋（與 /dist/vk-resolve 的 fingerprint 比）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="135" width="480" height="40" as="geometry"/></mxCell><mxCell id="t3y" value="是 → 0：唯讀預覽；不建進度檔（CI 例外見右）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=8;spacingBottom=8;" vertex="1" parent="bT1"><mxGeometry x="20" y="194" width="240" height="58" as="geometry"/></mxCell><mxCell id="t3" value="--dry-run？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=50;spacingRight=50;spacingTop=12;spacingBottom=12;" vertex="1" parent="bT1"><mxGeometry x="280" y="198" width="200" height="50" as="geometry"/></mxCell><mxCell id="t3n" value="已定：--dry-run = 唯讀預覽（本機一律 0）；CI 模式且需改進 git 的檔時回 1 印清單（契約⑤ check.sh ③）；不建進度檔、不寫任何檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bT1"><mxGeometry x="1180" y="194" width="390" height="57" as="geometry"/></mxCell><mxCell id="t0b" value="來自 install／dev／升引擎頁（單段可寫動詞）：第一個寫入前" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=35;spacingRight=35;spacingTop=12;spacingBottom=12;" vertex="1" parent="bT1"><mxGeometry x="20" y="332" width="240" height="80" as="geometry"/></mxCell><mxCell id="t4" value="否：建進度檔（第一個寫入前）：state=in-progress、verb、id、started、targets、done[]／pending[]、consents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="352" width="480" height="42" as="geometry"/></mxCell><mxCell id="t4f" value="進度檔位置（依動詞）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="bT1"><mxGeometry x="780" y="262" width="380" height="221" as="geometry"/></mxCell><mxCell id="t4f_0" value="add／upgrade &amp;lt;repo&amp;gt;：metadata [progress]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="t4f"><mxGeometry x="8" y="26" width="352" height="26" as="geometry"/></mxCell><mxCell id="t4f_1" value="remove／uninstall／undev／prune／dev：.tmp.&amp;lt;verb&amp;gt;.&amp;lt;id&amp;gt;.toml（dev 另記本機覆寫行、symlink 目標、印記第一行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="t4f"><mxGeometry x="8" y="58" width="352" height="57" as="geometry"/></mxCell><mxCell id="t4f_2" value="install：.tmp.install.&amp;lt;id&amp;gt;.toml（第一次 = 清除清單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="t4f"><mxGeometry x="8" y="121" width="352" height="42" as="geometry"/></mxCell><mxCell id="t4f_3" value="升引擎：.tmp.upgrade.&amp;lt;id&amp;gt;.toml（改第一行前建、新引擎刪）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="t4f"><mxGeometry x="8" y="169" width="352" height="42" as="geometry"/></mxCell><mxCell id="t4n" value="已定（v2.13 P5、v2.15-5／-10）：單段可寫動詞 install／dev／升引擎沒有 resolve→apply、不重驗指紋，直接從本格開始；第一次 install 的進度檔同時是「不留半成品」的清除清單（log/ 保留）；remove／uninstall 會刪 metadata、undev／prune／dev 沒有工具 metadata → 放 .vendor_kit/.tmp.*（自有 .gitignore 擋）；&amp;lt;id&amp;gt; = 本次 trace_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bT1"><mxGeometry x="1180" y="320" width="390" height="104" as="geometry"/></mxCell><mxCell id="t5" value="逐步寫入 ①：寫暫存檔（合併也在暫存完成；詢問取得的同意先記進 consents）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="502" width="480" height="40" as="geometry"/></mxCell><mxCell id="t5af" value="暫存檔（目標檔旁；未換上前目標檔不動）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="780" y="502" width="380" height="40" as="geometry"/></mxCell><mxCell id="t5n" value="每一步都是 ①②③ 三個可獨立失敗的動作；規格只硬性要求：gen/tools.just 最後寫、與 cache 同一 apply 內原子替換；version.toml 最後寫；其餘順序各動詞頁自訂" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bT1"><mxGeometry x="1180" y="493" width="390" height="57" as="geometry"/></mxCell><mxCell id="t5b" value="逐步寫入 ②：原子替換（rename 暫存檔 → 目標檔；一檔一次換上）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="560" width="480" height="40" as="geometry"/></mxCell><mxCell id="t5bf" value="目標檔（換上；中斷只會留下「已換上」「未換上」兩種）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="780" y="560" width="380" height="40" as="geometry"/></mxCell><mxCell id="t5c" value="逐步寫入 ③：更新進度檔 done += 步驟（pending 移出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="280" y="610" width="480" height="40" as="geometry"/></mxCell><mxCell id="t5f" value="進度檔 done[]／pending[] 每步更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bT1"><mxGeometry x="780" y="610" width="380" height="40" as="geometry"/></mxCell><mxCell id="t6" value="這一步中斷？（寫入失敗／Ctrl-C／斷電）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=85;spacingRight=85;spacingTop=20;spacingBottom=20;" vertex="1" parent="bT1"><mxGeometry x="280" y="660" width="340" height="81" as="geometry"/></mxCell><mxCell id="t6q" value="是：第一次 install？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=50;spacingRight=50;spacingTop=20;spacingBottom=20;" vertex="1" parent="bT1"><mxGeometry x="780" y="660" width="200" height="81" as="geometry"/></mxCell><mxCell id="t6q_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=cen