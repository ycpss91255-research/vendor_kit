style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2008" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r3c0" value="&lt;b&gt;基準版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2036" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r3c1" value="baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2036" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r3c2" value="上次套用的初始檔原版副本，作為與目前 repo 檔、新版初始檔合併時的共同祖先。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2036" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r4c0" value="&lt;b&gt;基準版合併&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2064" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r4c1" value="baseline merge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2064" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r4c2" value="以基準版、目前 repo 檔與新版初始檔為三份輸入所做的合併（git 的 three-way merge）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2064" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r5c0" value="&lt;b&gt;合併衝突&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2092" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r5c1" value="merge conflict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2092" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r5c2" value="基準版合併無法自動決定合併內容的結果。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2092" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_s4e" value="互動、結果與版本號" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="2134" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="2166" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3e_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="2166" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3e_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="2166" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p0_t3e_r0c0" value="&lt;b&gt;CI 模式&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2196" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r0c1" value="CI mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2196" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r0c2" value="VK 在 CI 環境中執行時採用的模式。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2196" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r1c0" value="&lt;b&gt;詢問&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2224" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r1c1" value="prompt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2224" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r1c2" value="VK 在修改 repo 檔前，向使用者取得同意的互動。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2224" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r2c0" value="&lt;b&gt;-y&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2252" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r2c1" value="yes option" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2252" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r2c2" value="讓使用者預先回答詢問的選項。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2252" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r3c0" value="&lt;b&gt;可寫動詞&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2280" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r3c1" value="writing verb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2280" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r3c2" value="會動進 git 的檔或進度檔的動詞。&lt;br&gt;• 包含 install、uninstall、add、remove、upgrade、dev、undev、prune。&lt;br&gt;• prune 雖清理本機資源，執行時仍會建立進度檔，因此屬於可寫動詞。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2280" width="1200" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r4c0" value="&lt;b&gt;唯讀動詞&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2344" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r4c1" value="read-only verb" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2344" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r4c2" value="不動進 git 的檔、也不動進度檔的動詞。&lt;br&gt;• 包含 update、sync、help。&lt;br&gt;• 仍可寫 cache/、gen/。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2344" width="1200" height="64" as="geometry"/></mxCell><mxCell id="p0_t3e_r5c0" value="&lt;b&gt;需人處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2408" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r5c1" value="needs human" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2408" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r5c2" value="VK 停下並要求使用者採取下一步的結果。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2408" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r6c0" value="&lt;b&gt;失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2436" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r6c1" value="failure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2436" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r6c2" value="VK 因無法繼續而結束的結果。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2436" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r7c0" value="&lt;b&gt;警告&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2464" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r7c1" value="warning" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2464" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r7c2" value="指出非阻斷問題、不使該次執行成為失敗或需人處理的訊息。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2464" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r8c0" value="&lt;b&gt;介面版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2492" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r8c1" value="interface version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2492" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r8c2" value="薄殼與引擎之間公開介面的整數版號。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2492" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r9c0" value="&lt;b&gt;檔案版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2520" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r9c1" value="schema version" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2520" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r9c2" value="VK 寫入檔案時標示其資料格式的整數版號。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2520" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r10c0" value="&lt;b&gt;最低介面版&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2548" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r10c1" value="floor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2548" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r10c2" value="引擎仍支援的最低介面版。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2548" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r11c0" value="&lt;b&gt;結束碼&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2576" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r11c1" value="exit code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="2576" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3e_r11c2" value="VK 程序向呼叫端回報結果的整數。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="2576" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_s5" value="動詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="2618" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_h0" value="動詞" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="2650" width="330" height="30" as="geometry"/></mxCell><mxCell id="p0_t4_h1" value="做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="350" y="2650" width="1250" height="30" as="geometry"/></mxCell><mxCell id="p0_t4_r0c0" value="install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2680" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r0c1" value="將 VK 接入 repo，或修復既有接入。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2680" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r1c0" value="uninstall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2708" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r1c1" value="從 repo 移除 VK 的接入。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2708" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r2c0" value="add" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2736" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r2c1" value="將一個工具接入 repo。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2736" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r3c0" value="remove" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2764" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r3c1" value="從 repo 解除一個工具的接入。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2764" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r4c0" value="update" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2792" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r4c1" value="查詢已接入的引擎或工具是否有可用新版。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2792" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r5c0" value="upgrade" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2820" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r5c1" value="將已接入的引擎或工具改為另一個版本。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2820" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r6c0" value="dev" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2848" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r6c1" value="暫時讓已接入的引擎或工具使用本機開發來源。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2848" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r7c0" value="undev" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2876" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r7c1" value="取消本機開發來源，恢復使用鎖定版本。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2876" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r8c0" value="sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2904" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r8c1" value="使 repo 本機的工具內容與版本鎖定行或本機覆寫一致。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2904" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r9c0" value="prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2932" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r9c1" value="清理由 VK 產生、但已不再被目前 repo 使用的本機資源。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2932" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r10c0" value="help" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="2960" width="330" height="28" as="geometry"/></mxCell><mxCell id="p0_t4_r10c1" value="顯示 VK 指令的使用說明。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="350" y="2960" width="1250" height="28" as="geometry"/></mxCell><mxCell id="p0_v1" value="&lt;b&gt;升引擎&lt;/b&gt;：執行 upgrade vendor_kit 更換引擎版本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="3002" width="1580" height="32" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p1" name="02 不變量與角色（1）目的／名詞／角色"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1152" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="不變量與角色（1）目的／名詞／角色" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p1_intro" value="本頁是契約的第一頁：只用第 0 頁「名詞與縮寫」與本頁名詞表定義的詞，不引用後面的頁。只摘錄、不新增決議；每條的出處列在文末「出處對照」。審閱方式：逐條打勾／打叉，叉的寫一句理由。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p1_s0" value="一句話目的" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_goal" value="下游 repo 把要交付的檔案打成一個純資料的下游 image 推到 registry（公開或私有，由下游開發者自決；私有需憑證）；下游使用者在專案裡跑一支接入腳本後，用 just vendor_kit &amp;lt;動詞&amp;gt; 取得工具、把版本鎖成一行、初始檔以三方合併升版。VK 只負責搬移，不承諾搬來的內容可執行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="1580" height="50" as="geometry"/></mxCell><mxCell id="p1_s1" value="本頁名詞（第 0 頁沒有的頁內特有詞）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="204" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_h0" value="名詞" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="236" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1_tm_h1" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="236" width="1410" height="30" as="geometry"/></mxCell><mxCell id="p1_tm_r0c0" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="266" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r0c1" value="GitHub 的容器 registry；引擎放的地方，也是下游 image 的預設落點（下游 image 公開或私有由下游開發者自決）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="266" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r1c0" value="config.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="294" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r1c1" value=".vendor_kit/config.toml，VK 的設定檔，進 git；升引擎時比照初始檔三方合併。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="294" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r2c0" value="衝突標記" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="322" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r2c1" value="三方合併合不起來時留在檔內的 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;／&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 標記；升版逐檔的結果：沒改 → 換新版；只有下游使用者改 → 不動；兩邊都改 → 三方合併，合不起來就留衝突標記、結束碼 2。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="322" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r3c0" value="交付物" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r3c1" value="工具 recipe（just &amp;lt;ns&amp;gt; …）產生、要交給別人用的東西（例如 deploy 包）。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="350" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r4c0" value="契約檢查腳本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="378" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r4c1" value=".vendor_kit/ci/check.sh，薄殼之一，兩種用法分開：不帶參數 = 下游 CI 的唯一入口（在專案裡跑同步、驗證、試跑升版、工具與專案測試）；--dist = 下游開發者在下游 repo 裡驗 dist/ 佈局與兩平台一致。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="378" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r5c0" value="下游 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="406" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r5c1" value="專案自己的 CI 平台；不是「方」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="406" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r6c0" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="434" width="170" height="28" as="geometry"/></mxCell><mxCell id="p1_tm_r6c1" value="下游使用者自選的版本更新機器人；不是「方」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="190" y="434" width="1410" height="28" as="geometry"/></mxCell><mxCell id="p1_s2" value="三方角色與承諾關係" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="476" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r0c0" value="名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="508" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r0c1" value="&lt;b&gt;下游開發者&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="508" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r1c0" value="是誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="536" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r1c1" value="開發下游 repo 的人" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="536" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r2c0" value="負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="564" width="130" height="46" as="geometry"/></mxCell><mxCell id="p1_tr0_r2c1" value="維護 dist/ 與三行 Dockerfile；在下游 repo 的 CI 用契約檢查腳本 --dist 驗 dist/ 佈局與兩平台一致；自己在乾淨機器驗交付物可執行；把下游 image 推到 registry（公開或私有自決；私有時下游使用者要備憑證）；用 dev／undev 在本機開發工具" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="564" width="1450" height="46" as="geometry"/></mxCell><mxCell id="p1_tr0_r3c0" value="不負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r3c1" value="不碰專案的檔；交付物不得依賴 .vendor_kit/；交付物的可執行性不由 VK 代驗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="610" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r4c0" value="地位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="638" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr0_r4c1" value="被承諾方：只要照 dist/ 契約出貨，VK 保證搬得到、鎖得住、升得了" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="638" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r0c0" value="名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r0c1" value="&lt;b&gt;下游使用者&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="680" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r1c0" value="是誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="708" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r1c1" value="在專案裡接入、升級、使用工具的人，含只打 just &amp;lt;ns&amp;gt; … 的人" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="708" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r2c0" value="負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="736" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r2c1" value="跑 bootstrap.sh 接入；回答詢問或給 -y；commit 薄殼與版本鎖定行；升版時 -y 只是同意做三方合併，合併後仍有衝突就要手動編輯、再重跑 upgrade &amp;lt;repo&amp;gt; 直到乾淨；把契約檢查腳本接進下游 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="736" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r3c0" value="不負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="764" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r3c1" value="不需裝引擎的語言環境；不手寫 gen/、cache/；不改薄殼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="764" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r4c0" value="地位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="792" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr1_r4c1" value="被承諾方：VK 保證不刪、不覆蓋專案檔，失敗必印原因" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="792" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r0c0" value="名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="834" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r0c1" value="&lt;b&gt;VK&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="834" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r1c0" value="是誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="862" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r1c1" value="我們，vendor_kit 開發者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="862" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r2c0" value="負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="890" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r2c1" value="維護引擎與薄殼（含啟動器），履行對兩方的承諾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="890" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r3c0" value="不負責" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="918" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r3c1" value="不替工具驗可執行；不 commit、不開 PR；引擎不讀 .git、不碰 index、不 git init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="918" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r4c0" value="地位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="946" width="130" height="28" as="geometry"/></mxCell><mxCell id="p1_tr2_r4c1" value="承諾方：內部怎麼實作不屬於本契約，可自由變更" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="150" y="946" width="1450" height="28" as="geometry"/></mxCell><mxCell id="p1_trn" value="同一人可兼下游開發者與下游使用者兩種身分。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="988" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p1_s3" value="兩個自動化角色（不是「方」）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1030" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_auto0" value="下游 CI：專案自己的 CI 平台（GitHub、GitLab 都一樣）只呼叫契約檢查腳本；腳本自己把 CI 設為 1 進 CI 模式，依序做同步、驗證、試跑升版、跑工具與專案測試，回第一個失敗步驟的碼。它不寫任何進 git 的檔、不查最新版。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1062" width="782" height="50" as="geometry"/></mxCell><mxCell id="p1_auto1" value="Renovate：下游使用者自選的版本更新機器人，用 VK 提供的設定；它開的 PR 只改版本鎖定行，大版本升版分開 PR。初始檔的合併不由它做——下游使用者本機補完再 push。VK 本身沒有機器人。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="818" y="1062" width="782" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p1i" name="03 不變量與角色（2）不變量／例外／待拍板"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1568" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="不變量與角色（2）不變量／例外／待拍板" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p1_s4" value="不變量" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_i1" value="&lt;b&gt;I1 專案檔四原則&lt;/b&gt;：可以建（明說建了什麼）、要改先問（-y 免問）、永不刪、永不覆蓋（不用工具版本取代客製內容）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="102" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i2" value="&lt;b&gt;I2 自動化只碰不進 git 的東西&lt;/b&gt;：sync（含工具 recipe 執行前自動觸發的那次）只寫 cache/、gen/（與執行紀錄）；發現薄殼與引擎不符只以 1 結束並提示跑 upgrade vendor_kit，不重寫。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="142" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i3" value="&lt;b&gt;I3 never fail silently&lt;/b&gt;：失敗一定印原因；需人處理另附可直接複製的下一步指令；warn 也明列條目；印到 tty 的訊息同句進執行紀錄。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="182" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i4" value="&lt;b&gt;I4 結束碼語意&lt;/b&gt;：0 成功（含 warn）；1 需人處理或失敗；2 合併衝突（留標記、基準版仍推到新版；例外：合併結果是 TOML／just 而解析不過的檔 → 也是 2，但留原檔、該檔基準版不推；update 加 --exit-code 時，有新版亦 2）；3 介面版／檔案版不合，須先升級或退回。「回 1 時版本鎖定行不動」適用 add、upgrade &amp;lt;repo&amp;gt;、remove、uninstall（寫入前檢查；鎖定行最後才寫／最後才刪）；remove／uninstall 回 1 時留下的狀態 = 該工具仍鎖定、cache/ 等其餘檔可能部分已刪，進度檔保留、下次可寫動詞先恢復（uninstall 已做完的工具已整個移除、未處理的原樣）；升引擎是唯一例外（引擎那一行已改後才回 1 要求重跑）。多工具動詞的失敗策略依各動詞：upgrade 逐工具做得完的做完；uninstall apply 期間任一工具失敗就中止並列出已完成與未處理的工具；最後都回最需處理的碼（1 &amp;gt; 2 &amp;gt; 0）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="222" width="1580" height="70" as="geometry"/></mxCell><mxCell id="p1_i5" value="&lt;b&gt;I5 回 3 零寫入&lt;/b&gt;：除執行紀錄在啟動時已寫下的開頭記錄外完全不寫——不寫專案檔、不寫 cache/、gen/、進度檔；新舊一律比介面版／檔案版，不比版本字串；最低介面版檢查先於任何上網；網路／認證／不存在回 1，不得偽裝成 3。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="298" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i6" value="&lt;b&gt;I6 需人處理／失敗語意&lt;/b&gt;：需人處理的結束（1 或 3 且印指令；衝突 2 亦同）為橙；紅只給失敗（拉不到、寫入失敗、驗證失敗）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="338" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i7" value="&lt;b&gt;I7 CI 真值規則&lt;/b&gt;：環境變數 CI 非空且不為 0／false（大小寫不敏感）→ CI 模式；契約檢查腳本自己把 CI 設為 1；本機手設 = 唯讀驗證，允許。-y 與 CI 模式為獨立開關：CI 內可帶 -y 省略詢問，但 -y 不等於 CI 模式、CI 模式也不隱含 -y。CI 模式下升為失敗的警告明列：薄殼不符、基準版落後、未完成接入、任何本機覆寫、需改進 git 的檔；「沒納管／拒絕過」提醒不紅燈；仍拉鎖定版 image、仍寫 cache/、gen/。唯一例外：update 在 CI 模式仍查最新版（它是唯讀動詞，查詢就是它的用途）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="378" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i8" value="&lt;b&gt;I8 -y 只省略詢問&lt;/b&gt;：不授權覆蓋既有未納管檔、不硬加 append 行、不解除 CI 模式（CI 模式下需改進 git 的檔一律以 1 結束並印清單，與 -y 無關）。需詢問但無法互動（無 tty／EOF）又沒給 -y → 以 1 結束並印出原因（加 -y 或在終端執行）；EOF／Ctrl-C = 中止不套用、不記為拒絕過。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="436" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i9" value="&lt;b&gt;I9 交付物執行期不依賴 .vendor_kit/&lt;/b&gt;：工具 recipe 產生的交付物不得依賴 .vendor_kit/、version.toml、registry，需要的檔打包時複製進去；初始檔只能引用穩定入口 just &amp;lt;ns&amp;gt; …，不得寫死 cache/ 內部路徑。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="494" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i10" value="&lt;b&gt;I10 專案根與巢狀&lt;/b&gt;：專案根 = 專案內含 .vendor_kit/ 的目錄（monorepo 子專案各自一套）；須在某 git repo 內；禁巢狀（install 時上層或下層已有 .vendor_kit/ → 1）；動詞只准在專案根執行，sync 亦無例外，否則以 1 結束並印出該到哪個目錄執行（工具 recipe 自動觸發的那次 sync 自己先切到專案根，不受影響）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="534" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i11" value="&lt;b&gt;I11 進度檔&lt;/b&gt;：所有可寫動詞（含 dev、第一次 install、升引擎）在第一個寫入前必建進度檔，不設例外；可寫動詞開始前遇未完成交易先恢復再繼續（prune 例外：遇活躍進度檔只列出提示、不恢復、不阻擋——它不碰進 git 的檔）；唯讀動詞只偵測不恢復（sync／update 印出未完成交易與恢復指令後以 1 結束，help 印出後仍 0）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i12" value="&lt;b&gt;I12 執行紀錄&lt;/b&gt;：每個動詞每次執行（含 help、沒起容器的 sync、只預覽不寫的執行）及每次 bootstrap.sh 執行（寫在 log/bootstrap/）必寫一檔。順序：不寫檔、不拉 image、不起容器的前置檢查（是否 git repo、just 版本）可以在建紀錄之前；任何寫入、拉取、起引擎之前必已有紀錄（不是 git 目錄時也無處可寫）；建目錄＋建檔＋寫開頭記錄失敗 → 1、印出無法寫入的原因、零寫入；引擎啟動記錄寫不進亦同；沒有關掉它的選項。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i13" value="&lt;b&gt;I13 薄殼人不改&lt;/b&gt;：自描述標頭 hash 不符 → 1 列差異不動；重產只由明確動作（install／upgrade vendor_kit）做。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="708" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i14" value="&lt;b&gt;I14 兩層相容承諾&lt;/b&gt;：救援路徑對任何 ≥ 最低介面版的薄殼永久可用；新版引擎讀歷史 VK 資料永遠可讀、可遷（讀到舊檔案版直接寫成當前檔案版）；舊薄殼呼叫介面版不合的新引擎跑一般動詞，只保證乾淨回 3；最低介面版只能經 ADR 提高。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i15" value="&lt;b&gt;I15 檔案版與未知欄位&lt;/b&gt;：VK 寫的每個 TOML 都有檔案版；讀時忽略未知欄位、重寫仍存在的 TOML 時保留未知欄位（不能保留就拒絕寫；uninstall／remove 合法刪掉整個檔或整個工具項目時不適用）；檔案版高於本引擎支援 → 3 零寫入；讀任一舊檔案版直接寫成當前檔案版，不鏈式遷移。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="788" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_i16" value="&lt;b&gt;I16 多工具動詞先完整預檢&lt;/b&gt;：會寫檔且一次處理多個工具的動詞（不帶 &amp;lt;repo&amp;gt; 的 upgrade、uninstall）先對全部工具預檢完才動任何東西；任一預檢不過 → 整體不動、以 1 結束並列出原因。預檢過了才開始寫，寫的過程中失敗適用 I4（失敗策略依各動詞、進度檔保留）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="846" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i17" value="&lt;b&gt;I17 gen/tools.just 與 cache/ 同次原子替換&lt;/b&gt;：tools.just 在同一次寫入裡最後寫，並與 cache/ 一起原子替換，任何時刻都不會出現「工具入口指向不存在或半套的 cache」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="886" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_i18" value="&lt;b&gt;I18 版本鎖定行唯一正規形&lt;/b&gt;：形式照第 0 頁「版本鎖定行」：引擎行在頂層 vendor_kit = &quot;&amp;lt;image&amp;gt;:&amp;lt;tag&amp;gt;@sha256:&amp;lt;digest&amp;gt;&quot;、工具行在 [tools] 表下 &amp;lt;repo&amp;gt; = &quot;&amp;lt;image&amp;gt;:&amp;lt;tag&amp;gt;@sha256:&amp;lt;digest&amp;gt;&quot;——行首無空白、鍵後一個空白、=、一個空白、雙引號字串、無尾端註解、LF 結尾；引擎寫出一律此形。&amp;lt;repo&amp;gt; 照第 0 頁名稱規則（小寫、不含句點，能作未加引號的 TOML 鍵），與頂層 schema／written_by／vendor_kit 不同層、不撞名。禁 BOM、禁重複鍵、禁 TOML 表旁路寫法（例如 [tools.&amp;lt;repo&amp;gt;]、[vendor_kit]）；引擎讀到非正規形 → 1 列出差異、不動。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=14;strokeWidth=3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="926" width="1580" height="70" as="geometry"/></mxCell><mxCell id="p1_s5" value="例外清單（不變量的明文例外）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1008" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p1_x1" value="根 justfile：無 → 建四行（import &#x27;.vendor_kit/entry.just&#x27;、空行、default:、\t@just --list）；有 → 問後加 import 一行；uninstall 只刪完全相同的行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x2" value="根 .dockerignore（I1「永不刪」的明文例外）：install 無則建、有則問後 append 四行（.vendor_kit/cache/、.vendor_kit/gen/、.vendor_kit/.tmp.*、.vendor_kit/log/）；只有 uninstall、經詢問、且該行原文仍與 VK 當初寫的相同時，才逐行刪；被改過或缺失的行跳過並 warn。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1580" height="52" as="geometry"/></mxCell><mxCell id="p1_x3" value="初始檔換版／三方合併：已納管初始檔經同意（或 -y）換新版或三方合併；衝突留標記回 2、基準版推到新版（合併結果是 TOML／just 而解析不過的檔例外：留原檔、該檔基準版不推，也回 2）；config.toml 對 upgrade vendor_kit 比照。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1138" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x4" value="append 型初始檔：問後加入並記錄實際插入的行；升版只對可辨識的上次插入行提修改；零命中或多處 → 保留只 warn，-y 不硬加。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1178" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x5" value="新版刪除的初始檔：只 warn 不刪。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1218" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x6" value="log/：VK 檔，不受專案檔四原則；bootstrap.sh／第一次 install 失敗清半成品時 log/ 保留；uninstall 一律保留 log/（.vendor_kit/ 只剩 log/）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1258" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x7" value="進度檔與 .tmp.*：同上不受專案檔四原則；成功即刪；prune 遇活躍者只列出提示、不刪、不恢復、不阻擋（I11 的明文例外）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1298" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_x8" value="零寫入的執行紀錄例外：見 I5。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1338" width="1580" height="34" as="geometry"/></mxCell><mxCell id="p1_pend" value="&lt;b&gt;本頁待拍板&lt;/b&gt;&lt;br&gt;無；四點已定（2026-09-20）：&lt;br&gt;1. 禁巢狀：install 時上層或下層已有 .vendor_kit/ 都以 1 結束（I10）。&lt;br&gt;2. 執行位置：動詞只准在專案根執行，sync 亦無例外；自動觸發的那次 sync 自己先切到專案根（I10）。&lt;br&gt;3. -y 與 CI 模式是兩個獨立開關：CI 模式下需改進 git 的檔一律以 1 結束並印清單，與 -y 無關；-y 只省略詢問（I7／I8）。&lt;br&gt;4. 顏色語意：橙 = 需人處理、紅 = 失敗（I6）。&lt;br&gt;其餘三條原列矛盾（零寫入的執行紀錄例外、根 .dockerignore 四行、舊薄殼跑介面版不合的新引擎回 3）維持規格所載。規格仍待定的三項（啟動器讀設定檔的方式、外部 repo 反向採用紀錄腳本、紀錄事件名清單待審）不在本頁範圍。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1384" width="1580" height="144" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p1b" name="04 契約 v2：動詞介面表"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2293" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約① 下游使用者介面（2／3）── 動詞介面表（interface_spec §1.2；just vendor_kit &amp;lt;verb&amp;gt; [args]）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p1b_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p1b_pend" value="&lt;b&gt;本頁無待拍板&lt;/b&gt;&lt;br&gt;選項總表（Q25）、結束碼、不開的動詞在 p1c；每個動詞的流程在流程頁 p5～" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="65" as="geometry"/></mxCell><mxCell id="p1B" value="2. 契約① 下游使用者介面：常用 3 + 進階 8 + 一次性 1 + help（綠底常用、白底進階、藍底一次性；一列一動詞、「做什麼」欄一格一件事；6-N = §6 訊息編號）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1560" height="1806" as="geometry"/></mxCell><mxCell id="p1B_h0" value="動詞＋語法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="20" y="50" width="220" height="30" as="geometry"/></mxCell><mxCell id="p1B_h1" value="反向" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="50" width="84" height="30" as="geometry"/></mxCell><mxCell id="p1B_h2" value="做什麼（一格一件事；細節見流程頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="50" width="980" height="30" as="geometry"/></mxCell><mxCell id="p1B_h3" value="結束碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="50" width="180" height="30" as="geometry"/></mxCell><mxCell id="p1B_h4" value="組" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="50" width="56" height="30" as="geometry"/></mxCell><mxCell id="p1B_r0c0" value="bootstrap.sh&lt;br&gt;sh bootstrap.sh [-t &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]]… [-y] [--local &amp;lt;image tag 或 tar&amp;gt;] [--timeout &amp;lt;秒&amp;gt;] [-h]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="80" width="220" height="182" as="geometry"/></mxCell><mxCell id="p1B_r0c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="82" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r0c1" value="uninstall（反向呼叫）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="80" width="84" height="182" as="geometry"/></mxCell><mxCell id="p1B_r0c2_0" value="前置：在 git repo 內（否 → 1 印 6-16）；just ≥ 1.33.0（不足 → 1 印 6-23）；最低介面版檢查；已有 version.toml → 用該行引擎（不用內嵌）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="80" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_1" value="docker image inspect 引擎 image：本機有 → 不 pull（離線可用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="106" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_2" value="本機無 → docker pull 引擎 ref（逾時 → 1 印 6-31）；--local &amp;lt;tar&amp;gt;：改 docker load，再讀 .digest 旁檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="132" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_3" value="呼叫引擎 install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="158" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_4" value="對每個 -t 呼叫 add &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]（轉發 -y；EOF 不算同意）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="184" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_5" value="--local：version.local.toml（vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot; + vendor_kit_image_id）在 install 成功後才寫、失敗清除；version.toml 仍寫正式 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="210" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c2_6" value="再跑一次 = 呼叫 install（冪等修復）；不自刪；離線包 = bootstrap.sh --local；取得：releases/latest/download/bootstrap.sh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="236" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r0c3" value="0；1 失敗不留半成品（只對第一次 install 成立）；3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="80" width="180" height="182" as="geometry"/></mxCell><mxCell id="p1B_r0c4" value="一次性" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="80" width="56" height="182" as="geometry"/></mxCell><mxCell id="p1B_r1c0" value="install&lt;br&gt;install [-y] [--no-justfile]&lt;br&gt;install &amp;lt;repo&amp;gt; 誤用 → 1 印 6-17" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="262" width="220" height="146" as="geometry"/></mxCell><mxCell id="p1B_r1c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="264" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r1c1" value="uninstall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="262" width="84" height="146" as="geometry"/></mxCell><mxCell id="p1B_r1c2_0" value="前置：在 git repo 內（否 → 1 印 6-16）；上層與下層皆無 .vendor_kit/（否 → 1 印 6-35）；不被 gen/.stamp 關卡擋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="262" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r1c2_1" value="第一次／修復判定用薄殼自描述首行：不存在 → 第一次；hash 相符 → 重產；不符 → 1 印 6-28 列差異不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="288" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r1c2_2" value="建 .vendor_kit/：version.toml（schema、written_by）、薄殼五檔、baseline/.gitkeep（不建 metadata）、gen/.stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="314" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r1c2_3" value="根 justfile：無 → 建逐字四行（import &#x27;.vendor_kit/entry.just&#x27;／空行／default:／\t@just --list）；有 → 問 6-20（-y 直接加）；已含 → 不再加；--no-justfile 只印指示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="340" width="980" height="42" as="geometry"/></mxCell><mxCell id="p1B_r1c2_4" value="根 .dockerignore：無 → 建四行（cache/、gen/、.tmp.*、log/）；有 → 問 6-34 後 append，記於 baseline/.vendor_kit.toml；印建立或修改了什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="382" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r1c3" value="0／1／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="262" width="180" height="146" as="geometry"/></mxCell><mxCell id="p1B_r1c4" value="進階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="262" width="56" height="146" as="geometry"/></mxCell><mxCell id="p1B_r2c0" value="uninstall&lt;br&gt;uninstall [-y] [--dry-run]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="408" width="220" height="156" as="geometry"/></mxCell><mxCell id="p1B_r2c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="410" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r2c1" value="install" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="408" width="84" height="156" as="geometry"/></mxCell><mxCell id="p1B_r2c2_0" value="前置：預檢全部工具（有本機覆寫 → 1 提示先 undev）；hash 相符的保護清單在任何 remove 之前生效" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="408" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c2_1" value="apply：拿鎖、重驗指紋 → 建進度檔 .tmp.uninstall.&amp;lt;id&amp;gt;.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="434" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c2_2" value="逐工具 remove（保護模式）：只刪自產（hash 相符）的檔；未知或被改的保留並回報；目錄非空則保留；不 rm -rf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="460" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c2_3" value="任一工具回 1 → 中止並列出已完成部分；初始檔一律保留並印清單" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="486" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c2_4" value="根 justfile 那行：問 6-20「要從 justfile 刪這一行嗎」只刪完全相同的行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="512" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c2_5" value="根 .dockerignore 四行與 append 行：問後只刪原文相同的 → 最後刪進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="538" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r2c3" value="0／1／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="408" width="180" height="156" as="geometry"/></mxCell><mxCell id="p1B_r2c4" value="進階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="408" width="56" height="156" as="geometry"/></mxCell><mxCell id="p1B_r3c0" value="add &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]&lt;br&gt;add &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;] [--source &amp;lt;image&amp;gt;] [--local &amp;lt;tar&amp;gt;] [-y] [--dry-run] [--timeout &amp;lt;秒&amp;gt;]&lt;br&gt;&amp;lt;repo&amp;gt;：[A-Za-z0-9_][A-Za-z0-9_.-]*、不得為 vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="564" width="220" height="182" as="geometry"/></mxCell><mxCell id="p1B_r3c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="566" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r3c1" value="remove" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="564" width="84" height="182" as="geometry"/></mxCell><mxCell id="p1B_r3c2_0" value="前置：已接入且完成 → 0 無變更；@&amp;lt;tag&amp;gt; 與鎖定不同 → 1 提示 upgrade；私有 image 無憑證又未指定 @&amp;lt;tag&amp;gt; → 1 印 6-3；dest 撞名／越界 → 拒絕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="564" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_1" value="前置：&amp;lt;ns&amp;gt; 與 (a) 其他已接工具 (b) 根 justfile 既有 recipe／module（just --dump）(c) 保留名 vendor_kit 撞名 → 1 拒絕" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="590" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_2" value="resolve → 主機 docker 展開到 .tmp.dist.&amp;lt;id&amp;gt;/&amp;lt;repo&amp;gt;/ → apply：拿鎖、重驗指紋、建進度檔（metadata [progress]）；逐檔讀 /dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="616" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_3" value="初始檔：無 → 建；有 → 不納管（unmanaged，印 6-11；-y 也不覆蓋）；strategy=&quot;append&quot; 且已存在 → 問 6-21（-y 免問，印出加了什麼）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="642" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_4" value="收尾①：fetch → cache/&amp;lt;repo&amp;gt;/ + gen/&amp;lt;repo&amp;gt;.stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="668" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_5" value="收尾②：baseline/&amp;lt;repo&amp;gt;/ + metadata（complete=true；--local &amp;lt;tar&amp;gt;：.digest 旁檔取正式 index digest、記 local_image_id）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="694" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c2_6" value="收尾③：gen/tools.just 重生 → version.toml 最後寫 → 刪進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="720" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r3c3" value="0；1（version.toml 一律未動：dest 不合法、CI 模式需改 tracked、指紋不同、失敗）；3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="564" width="180" height="182" as="geometry"/></mxCell><mxCell id="p1B_r3c4" value="常用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="564" width="56" height="182" as="geometry"/></mxCell><mxCell id="p1B_r4c0" value="remove &amp;lt;repo&amp;gt;&lt;br&gt;remove &amp;lt;repo&amp;gt; [-y] [--dry-run]&lt;br&gt;裸跑 → 用法 + 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="746" width="220" height="78" as="geometry"/></mxCell><mxCell id="p1B_r4c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="748" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r4c1" value="add" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="746" width="84" height="78" as="geometry"/></mxCell><mxCell id="p1B_r4c2_0" value="前置：有本機覆寫 → 1 提示先 undev；未接 = 0 + 提示；兩段（resolve → apply、重驗指紋）但不經 docker create/cp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="746" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r4c2_1" value="建進度檔 .tmp.remove.&amp;lt;id&amp;gt;.toml 後刪：version.toml 該行、cache/&amp;lt;repo&amp;gt;/、baseline/&amp;lt;repo&amp;gt;/、gen/&amp;lt;repo&amp;gt;.stamp、gen/tools.just 該工具所有 mod? 行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="772" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r4c2_2" value="初始檔永不刪，印清單；append 過的行 → 問 6-21「要刪我們加在 &amp;lt;X&amp;gt; 的這幾行嗎」只刪原文相同的（CRLF/LF 等價）→ 刪進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="798" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r4c3" value="0／1／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="746" width="180" height="78" as="geometry"/></mxCell><mxCell id="p1B_r4c4" value="進階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="746" width="56" height="78" as="geometry"/></mxCell><mxCell id="p1B_r5c0" value="update [&amp;lt;repo&amp;gt;]&lt;br&gt;update [&amp;lt;repo&amp;gt;] [--exit-code]&lt;br&gt;&amp;lt;repo&amp;gt; 可省 = 全部含 vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="824" width="220" height="88" as="geometry"/></mxCell><mxCell id="p1B_r5c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1B"><mxGeometry x="208" y="826" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1B_r5c1" value="（upgrade 的前一步）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="240" y="824" width="84" height="88" as="geometry"/></mxCell><mxCell id="p1B_r5c2_0" value="只查 registry（tags/list 取 SemVer 最大正式版，預發行排除），不動任何檔；不受CI 模式影響；單段、不經 docker create/cp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="824" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r5c2_1" value="無 registry 憑證時對需認證的工具回 1 印 6-3，其他工具照查再彙總；末行固定 6-15「套用：just vendor_kit upgrade」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="850" width="980" height="62" as="geometry"/></mxCell><mxCell id="p1B_r5c3" value="0 已列出；1 查詢失敗（任一工具 1 → 整體 1）；--exit-code 有新版 → 2；3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="824" width="180" height="88" as="geometry"/></mxCell><mxCell id="p1B_r5c4" value="進階" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="824" width="56" height="88" as="geometry"/></mxCell><mxCell id="p1B_r6c0" value="upgrade &amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]（工具）&lt;br&gt;upgrade [&amp;lt;repo&amp;gt;[@&amp;lt;tag&amp;gt;]] [-y] [--dry-run] [--timeout &amp;lt;秒&amp;gt;]&lt;br&gt;@&amp;lt;tag&amp;gt; 限單一 repo；比現版舊 → warn 仍執行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1B"><mxGeometry x="20" y="912" width="220" height