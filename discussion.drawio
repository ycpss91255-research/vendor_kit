etry></mxCell><mxCell id="me2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me2ax" value="逾時" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2a" target="m2ax"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me2b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2a" target="m2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me2x" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2b" target="m2x"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me2c" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2b" target="m2c"><mxGeometry x="-0.05" relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="1050"/><mxPoint x="730" y="1050"/></Array></mxGeometry></mxCell><mxCell id="me2cx" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2c" target="m2cx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.375;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="m2c" target="m2z"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="me0y" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=top;spacingTop=6;spacingBottom=0;" edge="1" parent="1" source="m0a" target="m0b"><mxGeometry x="-0.98" relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="466"/><mxPoint x="1230" y="626"/><mxPoint x="420" y="626"/></Array></mxGeometry></mxCell><mxCell id="me0ly" value="是：下一個 extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=top;spacingTop=6;spacingBottom=0;" edge="1" parent="1" source="m0lq" target="m0a"><mxGeometry x="-0.99" relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="776"/><mxPoint x="1250" y="385"/><mxPoint x="420" y="385"/></Array></mxGeometry></mxCell><mxCell id="p6c_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1218" width="200" height="60" as="geometry"/></mxCell><mxCell id="p6c_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1218" width="140" height="64" as="geometry"/></mxCell><mxCell id="p6c_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1226" width="140" height="44" as="geometry"/></mxCell><mxCell id="p6c_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1220" width="190" height="56" as="geometry"/></mxCell><mxCell id="p6c_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1220" width="210" height="56" as="geometry"/></mxCell><mxCell id="p6c_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1228" width="88" height="40" as="geometry"/></mxCell><mxCell id="p6c_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1228" width="170" height="40" as="geometry"/></mxCell><mxCell id="p6c_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1218" width="300" height="60" as="geometry"/></mxCell><mxCell id="p6c_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="220" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1286" width="120" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1286" width="170" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1286" width="160" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1286" width="100" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1286" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1286" width="180" height="36" as="geometry"/></mxCell><mxCell id="p6c_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1276" width="30" height="20" as="geometry"/></mxCell><mxCell id="p6c_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1326" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p6c_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1372" width="200" height="28" as="geometry"/></mxCell><mxCell id="p6c_tk0" value="待辦清單／apply|no" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1406" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6c_tv0" value="resolve sync 在引擎內算待辦（要拉哪些 image、要重裝什麼、要不要重生 tools.just）；stdout 只傳 extract 清單、指紋、apply|yes／no；無待辦 → apply|no，啟動器驗完文法直接 0、不起第二個容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1406" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6c_tk1" value="6-26（flock 逾時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1461" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6c_tv1" value="apply 拿專案目錄鎖 60 秒未釋放 → 1「專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）…重試，或設 VENDOR_KIT_NO_LOCK=1」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1461" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6c_tk2" value="extract" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1501" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6c_tv2" value="啟動器 docker create &amp;lt;image&amp;gt; /x → docker cp c:/dist/. &amp;lt;tmp&amp;gt;/&amp;lt;repo&amp;gt;/ → docker rm（三步合稱；任一步或暫存目錄失敗 → 1）；每個 extract 項各做一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1501" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6c_tk3" value="原 argv 與計畫一致" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1541" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6c_tv3" value="apply 讀 /dist/vk-resolve（啟動器把 resolve 的 stdout 整份存成 .tmp.dist.&amp;lt;id&amp;gt;/vk-resolve 掛入）：重算指紋 ≠ 計畫的 fingerprint → 1 + 6-12；本次 argv 與計畫不一致 → 1；apply 不重新選最新版（§3.2）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1541" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6c_tk4" value="6-12（指紋不同）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1406" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6c_tv4" value="apply 拿鎖後重驗指紋不同（中間有人改了）→ 1：「專案狀態在執行期間變動，未寫入任何檔。請重跑：just vendor_kit &amp;lt;verb&amp;gt; …」；原 argv 與計畫不一致也 → 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1406" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6c_tk5" value="resolve 非 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1446" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6c_tv5" value="resolve 容器結束碼非 0（1／2／3）→ 啟動器不讀 stdout、不跑任何 docker／apply，原碼傳出；stdout 文法不合 → 1 + 6-30（§3.3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1446" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6c_tk6" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1486" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6c_tv6" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1486" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6c_tk7" value="6-30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1541" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6c_tv7" value="啟動器驗 vk-resolve/1 文法不合 →「引擎輸出不完整或不相容（&amp;lt;原因&amp;gt;），未執行任何動作。」（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1541" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• m0m：「處理 mount 記錄：驗 &amp;lt;dir&amp;gt;/dist/init.toml；記 -v …」同格含檢查與記錄兩件事，且 spec §3.3 mount「缺 → 1」沒有失敗出口與終點" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1597" width="520" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p6cw" name="29 流程 v2：sync（2′）apply 寫入段"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1660" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：sync（2′）apply 寫入段：取件 → 印記 → 驗 → tools.just（§6、v2.15-17、v2.16-11）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="280" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="64" width="400" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1000" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="eB2" value="sync 第 2 段續（承「sync（2）」頁：已拿鎖、重驗、argv 一致）：逐待辦工具取件 → 印記 → 逐檔驗（--verify／CI／版本變動那次）→ 不符重裝一次再驗 → 還有工具？→ tools.just 在待辦？→ 最後原子重生 → 0" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1132" as="geometry"/></mxCell><mxCell id="eB2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eB2"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="m3e" value="來自「sync（2）」頁：apply 前置通過（已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=58;spacingRight=58;spacingTop=8;spacingBottom=8;" vertex="1" parent="eB2"><mxGeometry x="560" y="36" width="400" height="58" as="geometry"/></mxCell><mxCell id="m3" value="逐待辦工具：取件 /dist/&amp;lt;repo&amp;gt; 展開到暫存目錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="eB2"><mxGeometry x="560" y="114" width="400" height="40" as="geometry"/></mxCell><mxCell id="m3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop