"1" parent="1"><mxGeometry x="40" y="1060" width="220" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1060" width="120" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1060" width="170" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1060" width="160" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1060" width="100" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1060" width="130" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1060" width="180" height="36" as="geometry"/></mxCell><mxCell id="p8cx_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1050" width="30" height="20" as="geometry"/></mxCell><mxCell id="p8cx_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p8cx_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1146" width="200" height="28" as="geometry"/></mxCell><mxCell id="p8cx_tk0" value="覆寫兩種（v2.1 B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8cx_tv0" value="工具 path 覆寫 [tools].&amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot;：cache/&amp;lt;repo&amp;gt;/ 變 symlink，sync 跳過該工具取件／verify 但仍檢查 metadata、基準版；引擎 tag 覆寫 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋vendor_kit_image_id：啟動器改用該本機 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1180" width="610" height="55" as="geometry"/></mxCell><mxCell id="p8cx_tk1" value="dev 進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="150" height="40" as="geometry"/></mxCell><mxCell id="p8cx_tv1" value=".tmp.dev.&amp;lt;id&amp;gt;.toml：dev 是可寫動詞，第一個寫入前建，記要寫的覆寫行、symlink 目標、印記第一行；成功後刪；失敗 → 保留、下次可寫動詞先恢復（v2.15-5、新規則 (b)）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1235" width="610" height="40" as="geometry"/></mxCell><mxCell id="p8cx_tk2" value="6-33（未完成交易）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1180" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8cx_tv2" value="唯讀動詞偵測到 .tmp.&amp;lt;verb&amp;gt;.*.toml 或 metadata [progress] in-progress → 只印「偵測到未完成的 &amp;lt;verb&amp;gt;（&amp;lt;id&amp;gt;）。請先重跑：just vendor_kit &amp;lt;verb&amp;gt; &amp;lt;targets&amp;gt;」，不自動恢復、不寫檔；sync／update 結束 1，help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1180" width="610" height="55" as="geometry"/></mxCell><mxCell id="p8cx_tk3" value="undev 進度檔（&amp;lt;repo&amp;gt;）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1235" width="150" height="40" as="geometry"/></mxCell><mxCell id="p8cx_tv3" value=".tmp.undev.&amp;lt;id&amp;gt;.toml：第一個寫入前建，記要撤的覆寫行、symlink 目標、鎖定版 image ID（恢復時據此重新取件）；成功後刪；失敗保留、下次可寫動詞先恢復" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1235" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• ue11／fb_u6ced：「是：留著」迴線的水平段（y=524，x 525–640）與 u6ced 的失敗匯流線（y=524，x 996–1610）同高共線，縮圖像一條橫貫的線；另五條失敗線（y=584／704／772／832）都只在對應檔案框底邊下方 10px、貼著框底走" style="shape=note;whiteSpa