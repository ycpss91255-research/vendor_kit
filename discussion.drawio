ap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bU"><mxGeometry x="1290" y="807" width="280" height="88" as="geometry"/></mxCell><mxCell id="u7q" value="查詢成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=50;spacingRight=50;spacingTop=12;spacingBottom=12;" vertex="1" parent="bU"><mxGeometry x="668" y="923" width="200" height="50" as="geometry"/></mxCell><mxCell id="u7c" value="否：查詢失敗：分類原因（認證／網路／回應／解析）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bU"><mxGeometry x="620" y="989" width="200" height="48" as="geometry"/></mxCell><mxCell id="u7c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bU"><mxGeometry x="796" y="979" width="30" height="20" as="geometry"/></mxCell><mxCell id="u8a" value="是：取 SemVer 最大正式版（排除預發行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bU"><mxGeometry x="810" y="992" width="150" height="42" as="geometry"/></mxCell><mxCell id="u7f" value="該目標記 1（無憑證 → 6-3，不查；否則附分類）→ 繼續下一目標" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bU"><mxGeometry x="572" y="1053" width="220" height="48" as="geometry"/></mxCell><mxCell id="u7f_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="