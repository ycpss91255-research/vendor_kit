Geometry></mxCell><mxCell id="re10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.229;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="r5" target="r6"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="re11" value="刪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r6" target="r6f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="re12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="r6" target="r7"><mxGeometry x="-0.90" relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="1883"/></Array></mxGeometry></mxCell><mxCell id="p12_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1925" width="200" height="60" as="geometry"/></mxCell><mxCell id="p12_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1925" width="140" height="64" as="geometry"/></mxCell><mxCell id="p12_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1933" width="150" height="44" as="geometry"/></mxCell><mxCell id="p12_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1927" width="210" height="56" as="geometry"/></mxCell><mxCell id="p12_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1927" width="200" height="56" as="geometry"/></mxCell><mxCell id="p12_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1935" width="100" height="40" as="geometry"/></mxCell><mxCell id="p12_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1935" width="170" height="40" as="geometry"/></mxCell><mxCell id="p12_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1925" width="260" height="60" as="geometry"/></mxCell><mxCell id="p12_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1993" width="250" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1993" width="120" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1993" width="170" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="1993" width="150" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_inv" value="紅粗框：不變量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="810" y="1993" width="130" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_sub" value="藍：引擎做（容器內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="960" y="1993" width="170" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1150" y="1993" width="170" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1340" y="1993" width="200" height="36" as="geometry"/></mxCell><mxCell id="p12_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1516" y="1983" width="30" height="20" as="geometry"/></mxCell><mxCell id="p12_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2043" width="200" height="28" as="geometry"/></mxCell><mxCell id="p12_tk0" value="交易／apply" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2077" width="150" height="71" as="geometry"/></mxCell><mxCell id="p12_tv0" value="一次會寫檔的動詞執行 = 一筆交易：兩段動詞的 apply 拿 flock → 重驗指紋 → dry-run 分支 → 建進度檔（第一個寫入前）→ 逐步寫入 → 最後一步刪進度檔；單段可寫動詞（install／dev／升引擎）無 resolve／apply、無指紋重驗，從「建進度檔」開始；回 3 一律零寫入；工具層回 1 時 version.toml 不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2077" width="610" height="71" as="geometry"/></mxCell><mxCell id="p12_tk1" value="規格硬性順序" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2148" width="150" height="40" as="geometry"/></mxCell><mxCell id="p12_tv1" value="只有兩條：gen/tools.just 最後寫、且與 cache 同一 apply 內原子替換；version.toml（版本鎖定行）最後寫（工具層回 1 時不動）；其餘各動詞自訂" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2148" width="610" height="40" as="geometry"/></mxCell><mxCell id="p12_tk2" value="install／升引擎的進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2188" width="150" height="55" as="geometry"/></mxCell><mxCell id="p12_tv2" value="第一次 install 也建 .tmp.install.&amp;lt;id&amp;gt;.toml（v2.13 P5，無例外）：兼「不留半成品」的清除清單，失敗依它移除已寫的檔（log/ 保留）、成功後刪；修復型同；升引擎建 .tmp.upgrade.&amp;lt;id&amp;gt;.toml（另記舊引擎 ref、目標 ref、計畫 image ID）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2188" width="610" height="55" as="geometry"/></mxCell><mxCell id="p12_tk3" value="原子替換／暫存" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2243" width="150" height="40" as="geometry"/></mxCell><mxCell id="p12_tv3" value="每個寫入先寫到暫存（合併也在暫存完成），確認沒問題再逐檔一次換上（rename）；中斷只會留下「已換上」與「未換上」兩種檔，不留半寫的檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2243" width="610" height="40" as="geometry"/></mxCell><mxCell id="p12_tk4" value="恢復（三型）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2077" width="150" height="71" as="geometry"/></mxCell><mxCell id="p12_tv4" value="可寫動詞開始前偵測到未完成交易 → 先恢復再繼續本次（prune 例外：只列出、不恢復）：一般（add／remove／upgrade &amp;lt;repo&amp;gt;／undev／uninstall／dev）依進度檔 done 略過、pending 補做、consents 不再問；升引擎 = 重跑 upgrade vendor_kit；第一次 install = 依進度檔（清除清單）移除半成品、log/ 保留；失敗 → 1 印 6-27「未恢復：&amp;lt;檔名&amp;gt;」逐檔列出、進度檔留著" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2077" width="610" height="71" as="geometry"/></mxCell><mxCell id="p12_tk5" value="指紋／flock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2148" width="150" height="55" as="geometry"/></mxCell><mxCell id="p12_tv5" value="指紋 = resolve 讀過的檔（version.toml、local、metadata、要動的專案檔、stamp 第一行、.tmp.* 清單、鎖定 digest、argv）的 sha256；apply 拿鎖後重算，不同 → 1 + 6-12「請重跑」；flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2148" width="610" height="55" as="geometry"/></mxCell><mxCell id="p12_tk6" value="6-N 訊息編號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2203" width="150" height="71" as="geometry"/></mxCell><mxCell id="p12_tv6" value="interface_spec §6 的逐字訊息清單編號（每句含可直接複製的指令）：6-3 無 registry 憑證、6-4 無 tty、6-12 指紋不同、6-15 update 末行、6-16 非 git repo、6-23 just 太舊、6-26 flock 逾時、6-27 未恢復、6-30 vk-resolve 不合、6-31 pull 逾時、6-32 prune 問句、6-33 未完成交易、6-37 --local 值歧義、6-38 log 寫不進…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2203" width="610" height="71" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;te9a／re4n：出邊無標籤。&lt;br&gt;te5 等：單字標籤只留 20px 縫隙。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2290" width="520" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p13" name="58 相容性矩陣 v2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1235" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="相容性矩陣 v2：舊薄殼 × 新引擎、舊引擎 × 新檔 → 0／1／3（interface_spec §2、§8；Q16／Q19／Q23）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q16、Q19、Q23、v2.4-3／-6／-7、v2.6 16 條、v2.7-4、interface_spec §2、§4 通則、§8）：相容承諾兩層（永久：救援路徑 + 舊資料可讀可遷；非永久：舊薄殼跑新 major 一般動詞回 3）；最低介面版 = 固定 release 常數；新舊以介面版／檔案版比較不用版本字串；回 3 零寫入、無任何例外（救援路徑亦同）；written_by 純資訊欄、無 min_reader；同檔案版未知欄位讀忽略寫保留。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="12" width="520" height="92" as="geometry"/></mxCell><mxCell id="l13a" value="(a) 舊薄殼 P × 新引擎（接受 [floor_P, current_P]）：一般動詞／救援路徑各回什麼" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="900" height="24" as="geometry"/></mxCell><mxCell id="ta_h0" value="薄殼 P 的情況" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="330" height="30" as="geometry"/></mxCell><mxCell id="ta_h1" value="一般動詞（add／remove／upgrade &amp;lt;repo&amp;gt;／sync 寫入／undev／uninstall／prune／dev／update）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="370" y="150" width="640" height="30" as="geometry"/></mxCell><mxCell id="ta_h2" value="救援路徑（install／upgrade vendor_kit／sync 不符提示／help；單段）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="590" height="30" as="geometry"/></mxCell><mxCell id="ta_r0c0" value="P &amp;lt; floor_P（太舊）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="330" height="30" as="geometry"/></mxCell><mxCell id="ta_r0c1" value="3 + 6-18「請以 bootstrap.sh 重建」；零寫入；最低介面版檢查先於任何上網（斷網也回 3）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="640" height="30" as="geometry"/></mxCell><mxCell id="ta_r0c2" value="3 + 6-18（救援路徑也不接、同樣零寫入；唯一可用 synthetic fixture 驗收）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="590" height="30" as="geometry"/></mxCell><mxCell id="ta_r1c0" value="floor_P ≤ P &amp;lt; 引擎需求（舊薄殼 × 新 major）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="330" height="42" as="geometry"/></mxCell><mxCell id="ta_r1c1" value="3 + 6-36「薄殼介面版 &amp;lt;P_shell&amp;gt; 低於引擎 &amp;lt;vY&amp;gt; 的一般動詞需求，請先 upgrade vendor_kit」；零寫入" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="640" height="42" as="geometry"/></mxCell><mxCell id="ta_r1c2" value="0／1 正常（永久保證）：install／upgrade vendor_kit 重產薄殼 → 1 + 6-2「請 commit 並再跑原指令」；sync 不符 → 1 + 6-1；help → 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1010" y="210" width="590" height="42" as="geometry"/></mxCell><mxCell id="ta_r2c0" value="同 major（P 在引擎支援範圍內）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="252" width="330" height="42" as="geometry"/></mxCell><mxCell id="ta_r2c1" value="0／1／2 正常：引擎以呼叫方 P 輸出 vk-resolve/P 與結束碼語意；不輸出呼叫方不認識的 kind、不要求其未提供的 mount／環境變數" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="370" y="252" width="640" height="42" as="geometry"/></mxCell><mxCell id="ta_r2c2" value="0／1 正常；upgrade vendor_kit 無新版且薄殼相符 → 0 無變更" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1010" y="252" width="590" height="42" as="geometry"/></mxCell><mxCell id="ta_r3c0" value="P &amp;gt; current_P（新薄殼 × 舊引擎：降版／dev -i 舊 image）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="330" height="73" as="geometry"/></mxCell><mxCell id="ta_r3c1" value="3：P 不在引擎的 [floor_P, current_P]；零寫入" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="370" y="294" width="640" height="73" as="geometry"/></mxCell><mxCell id="ta_r3c2" value="降版 upgrade vendor_kit@&amp;lt;舊版&amp;gt;：目標引擎能無損讀現有檔（同介面版／檔案版）→ 重產薄殼 → 1 + 6-2「請 commit 並再跑原指令」（依 upgrade vendor_kit 的 0／1 規則；薄殼已相符才 0）；否則改檔前 3 + 6-10「請 git revert」（零寫入）；dev vendor_kit -i 舊 image 禁止重產 進 git 的薄殼 → 3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1010" y="294" width="590" height="73" as="geometry"/></mxCell><mxCell id="l13b" value="(b) 舊引擎 × 檔案 schema（每檔各自 schema = N；讀取門檻只看 schema）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="391" width="900" height="24" as="geometry"/></mxCell><mxCell id="tb_h0" value="檔 vs 引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="421" width="300" height="30" as="geometry"/></mxCell><mxCell id="tb_h1" value="讀" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="421" width="420" height="30" as="geometry"/></mxCell><mxCell id="tb_h2" value="寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="421" width="560" height="30" as="geometry"/></mxCell><mxCell id="tb_h3" value="結束碼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1320" y="421" width="280" height="30" as="geometry"/></mxCell><mxCell id="tb_r0c0" value="同檔案版、有未知欄位" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="451" width="300" height="30" as="geometry"/></mxCell><mxCell id="tb_r0c1" value="讀時忽略未知欄位" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="451" width="420" height="30" as="geometry"/></mxCell><mxCell id="tb_r0c2" value="寫時保留未知欄位（不能保留 → 拒絕寫）；只拒絕型別錯／重複宣告" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="451" width="560" height="30" as="geometry"/></mxCell><mxCell id="tb_r0c3" value="0（型別錯／重複宣告 → 1）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1320" y="451" width="280" height="30" as="geometry"/></mxCell><mxCell id="tb_r1c0" value="檔案版 &amp;lt; 引擎（舊檔）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="481" width="300" height="42" as="geometry"/></mxCell><mxCell id="tb_r1c1" value="可讀：記憶體轉換（讀任一舊檔案版 → 當前檔案版，不鏈式）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="481" width="420" height="42" as="geometry"/></mxCell><mxCell id="tb_r1c2" value="只在本來要寫該檔的明確動作才寫回當前檔案版；metadata 遷移由 upgrade vendor_kit 做、dry-run 明列；同一專案短暫混合檔案版合法" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="481" width="560" height="42" as="geometry"/></mxCell><mxCell id="tb_r1c3" value="0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1320" y="481" width="280" height="42" as="geometry"/></mxCell><mxCell id="tb_r2c0" value="檔案版 &amp;gt; 引擎支援上限（新檔）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="523" width="300" height="42" as="geometry"/></mxCell><mxCell id="tb_r2c1" value="拒絕讀：3 + 6-19「檔案版 &amp;lt;N&amp;gt; 高於本引擎支援的 &amp;lt;M&amp;gt;；寫入者為 vendor_kit &amp;lt;written_by&amp;gt;」" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="523" width="420" height="42" as="geometry"/></mxCell><mxCell id="tb_r2c2" value="任何寫入前退出（零寫入）；dev vendor_kit -i 舊 image 亦同" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="523" width="560" height="42" as="geometry"/></mxCell><mxCell id="tb_r2c3" value="3" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1320" y="523" width="280" height="42" as="geometry"/></mxCell><mxCell id="tb_r3c0" value="降版目標引擎（upgrade vendor_kit@&amp;lt;舊版&amp;gt;）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="300" height="42" as="geometry"/></mxCell><mxCell id="tb_r3c1" value="以目標 image LABEL 的介面版／檔案版判：能無損讀現有檔 → 讀" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="340" y="565" width="420" height="42" as="geometry"/></mxCell><mxCell id="tb_r3c2" value="無損 → 重產薄殼 → 1 + 6-2（依 upgrade vendor_kit 的 0／1 規則；薄殼已相符才 0）；否則改檔前拒絕 3 + 6-10「請 git revert」" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="565" width="560" height="42" as="geometry"/></mxCell><mxCell id="tb_r3c3" value="1（無損 → 重產薄殼）／3（否則）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="1320" y="565" width="280" height="42" as="geometry"/></mxCell><mxCell id="k13a" value="最低介面版常數（已定）：第一個正式版 v1.0.0、P=1、schema=1；寫在契約，只能經 ADR + major 提高；引擎 image LABEL ….protocol=&amp;lt;floor_P&amp;gt;-&amp;lt;current_P&amp;gt;、….schema=&amp;lt;N&amp;gt; 讓啟動器不起容器即可判最低介面版；低於最低介面版 → 3 + 6-18 零寫入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="631" width="500" height="73" as="geometry"/></mxCell><mxCell id="k13b" value="--protocol 協商（已定，Q16）：薄殼每次呼叫附 --protocol P（第一版起 P=1；全域旗標在子命令前）；引擎接受 [floor_P, current_P]，以呼叫方 P 輸出 vk-resolve/P 行別與結束碼語意；新增 verb／旗標／記錄種類／欄位／結束碼語意／印記第一行語意 → P+1；引擎宣稱的 P 真不支援 → 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="560" y="631" width="520" height="73" as="geometry"/></mxCell><mxCell id="k13c" value="Q16 兩層承諾（已定）：永久 —— 任何 ≥ 最低介面版的舊薄殼可叫新引擎的救援路徑（單段 docker run，不依賴 resolve/apply 與 gen/）並得正確提示；舊資料永遠可讀可遷。非永久 —— 舊薄殼跑新 major 一般動詞只保證乾淨回 3 + 6-36（零寫入）；同 major 內保留已承諾薄殼的一般呼叫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1100" y="631" width="490" height="73" as="geometry"/></mxCell><mxCell id="k13d" value="written_by：每個 vendor_kit 寫的 TOML 都有 written_by = &quot;&amp;lt;vX&amp;gt;&quot;（寫入引擎版本），純資訊欄、不作讀取門檻（無 min_reader）；6-19 印出它供人判斷該用哪個引擎" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="500" height="57" as="geometry"/></mxCell><mxCell id="k13e" value="新舊怎麼比：一律以介面版／檔案版比較，不用 SemVer 版本字串；網路／認證／不存在 → 1，不得偽裝成 3；既定回 1 的情境（印記不符、薄殼被改 6-28、升引擎完成要重跑 6-2）維持 1，不因訊息含 upgrade 而改 3；回 3 零寫入無任何例外（v2.7-4）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="720" width="520" height="57" as="geometry"/></mxCell><mxCell id="k13f" value="驗收（§7.4-1～8）：最低介面版以來每個已釋出 bootstrap.sh(r) + 引擎 image r 驅動候選 C（線性）；連升 r_i → r_j → C；最低介面版直接跳升；降版同介面版／檔案版成功（重產薄殼 → 1）、跨檔案版 3；&amp;lt; 最低介面版唯一 synthetic；舊引擎讀新檔 3 零寫入；舊 bootstrap.sh 再跑不降版；已釋出 image／資產／fixture 永不刪" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="720" width="490" height="88" as="geometry"/></mxCell><mxCell id="p13_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="838" width="200" height="60" as="geometry"/></mxCell><mxCell id="p13_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="838" width="140" height="64" as="geometry"/></mxCell><mxCell id="p13_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="846" width="150" height="44" as="geometry"/></mxCell><mxCell id="p13_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="840" width="210" height="56" as="geometry"/></mxCell><mxCell id="p13_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="840" width="200" height="56" as="geometry"/></mxCell><mxCell id="p13_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="848" width="100" height="40" as="geometry"/></mxCell><mxCell id="p13_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="848" width="170" height="40" as="geometry"/></mxCell><mxCell id="p13_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="838" width="260" height="60" as="geometry"/></mxCell><mxCell id="p13_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="906" width="120" height="36" as="geometry"/></mxCell><mxCell id="p13_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="906" width="150" height="36" as="geometry"/></mxCell><mxCell id="p13_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="906" width="170" height="36" as="geometry"/></mxCell><mxCell id="p13_lgx_c0" value="綠格：結束碼 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="540" y="906" width="110" height="36" as="geometry"/></mxCell><mxCell id="p13_lgx_cx" value="橙格：需人處理（1／2／3）" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="670" y="906" width="190" height="36" as="geometry"/></mxCell><mxCell id="p13_lgx_cell" value="白格：表格內容" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="880" y="906" width="110" height="36" as="geometry"/></mxCell><mxCell id="p13_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="956" width="200" height="28" as="geometry"/></mxCell><mxCell id="p13_tk0" value="薄殼 P／引擎 [floor_P, current_P]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv0" value="薄殼 = 進 git 的 .vendor_kit/ 五檔（entry.just、vendor.just、log.sh、.gitignore、ci/check.sh），自描述首行帶介面版 P；引擎 image 接受 [floor_P, current_P]（LABEL ….protocol=&amp;lt;floor_P&amp;gt;-&amp;lt;current_P&amp;gt;，啟動器不起容器即可判最低介面版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="990" width="610" height="55" as="geometry"/></mxCell><mxCell id="p13_tk1" value="--protocol P" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv1" value="薄殼每次呼叫引擎都附的介面版整數（第一版 P=1，全域旗標在子命令之前）；引擎接受 [floor_P, current_P] 並依呼叫方介面版 P 輸出 vk-resolve/P 行別與結束碼語意；太舊 → 一般動詞乾淨回 3 印 6-36，救援路徑永久可用；新增 verb／旗標／記錄種類／欄位／結束碼語意／印記第一行語意 → P+1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1045" width="610" height="55" as="geometry"/></mxCell><mxCell id="p13_tk2" value="一般動詞（非永久）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv2" value="add／remove／upgrade &amp;lt;repo&amp;gt;／sync 寫入／undev／uninstall／prune／dev／update：舊薄殼跑新 major 只保證乾淨回 3 + 6-36 提示先 upgrade vendor_kit（零寫入）；同 major 內保留所有已承諾薄殼的一般呼叫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1100" width="610" height="55" as="geometry"/></mxCell><mxCell id="p13_tk3" value="written_by" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1155" width="150" height="40" as="geometry"/></mxCell><mxCell id="p13_tv3" value="寫入引擎版本（string），純資訊欄、不作讀取門檻（無 min_reader）；6-19 訊息印出它供人判斷該用哪個引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1155" width="610" height="40" as="geometry"/></mxCell><mxCell id="p13_tk4" value="6-18／6-19／6-36／6-10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="990" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv4" value="6-18 薄殼／引擎低於最低介面版「請以 bootstrap.sh 重建」；6-19 schema N 高於本引擎支援的 M；6-36 薄殼介面版低於引擎一般動詞需求「請先 upgrade vendor_kit」；6-10 降版目標引擎無法無損讀「請 git revert」；四者皆 3、零寫入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="990" width="610" height="55" as="geometry"/></mxCell><mxCell id="p13_tk5" value="降版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1045" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv5" value="upgrade vendor_kit@&amp;lt;舊版&amp;gt;：目標引擎（以其 image LABEL 的介面版／檔案版判）能無損讀現有檔才做（做 = 重產薄殼 → 1 + 6-2），否則改檔前拒絕 3 + 6-10；dev vendor_kit -i &amp;lt;舊 image&amp;gt; 允許但禁止重產 進 git 的薄殼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1045" width="610" height="55" as="geometry"/></mxCell><mxCell id="p13_tk6" value="驗收（§7.4 相容性條）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1100" width="150" height="55" as="geometry"/></mxCell><mxCell id="p13_tv6" value="最低介面版以來每個已釋出 bootstrap.sh(r) + 引擎 image r 建 fixture 驅動候選（線性，非兩兩相乘）；連升 r_i → r_j → C；最低介面版直接跳升；降版；&amp;lt; 最低介面版用唯一 synthetic；舊引擎讀新檔 3 零寫入；已釋出 image／Release 資產／fixture 永不刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1100" width="610" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p14" name="59 結束碼決策表 v2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" page