=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;align=right;verticalAlign=middle;spacingRight=6;spacingBottom=0;" edge="1" parent="1" source="o10re" target="o10re3"><mxGeometry x="-0.65" relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="1006"/><mxPoint x="1300" y="1125"/><mxPoint x="1258" y="1125"/></Array></mxGeometry></mxCell><mxCell id="p16c_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1511" width="200" height="60" as="geometry"/></mxCell><mxCell id="p16c_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1511" width="140" height="64" as="geometry"/></mxCell><mxCell id="p16c_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1519" width="150" height="44" as="geometry"/></mxCell><mxCell id="p16c_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1513" width="210" height="56" as="geometry"/></mxCell><mxCell id="p16c_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1513" width="200" height="56" as="geometry"/></mxCell><mxCell id="p16c_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1521" width="100" height="40" as="geometry"/></mxCell><mxCell id="p16c_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1521" width="170" height="40" as="geometry"/></mxCell><mxCell id="p16c_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1511" width="260" height="60" as="geometry"/></mxCell><mxCell id="p16c_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1579" width="250" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1579" width="120" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1579" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="640" y="1579" width="150" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_sub" value="藍：引擎做（容器內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="810" y="1579" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_img" value="紫：image（引擎與下游）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1000" y="1579" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1190" y="1579" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1380" y="1579" width="200" height="36" as="geometry"/></mxCell><mxCell id="p16c_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1556" y="1569" width="30" height="20" as="geometry"/></mxCell><mxCell id="p16c_lgx_conv1" value="圖例約定①：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（每個結束碼都寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1623" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16c_lgx_conv2" value="圖例約定②：每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start（失敗 → 1 + 6-38、不做任何動作）、結束寫 engine_exit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1649" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16c_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1681" width="200" height="28" as="geometry"/></mxCell><mxCell id="p16c_tk0" value="add --local 只收 tar（v2.10-3）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1715" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16c_tv0" value="add --local &amp;lt;值&amp;gt; 只接受存在的 .tar 檔（新工具沒有既有 digest 可用；tag 形只對 bootstrap.sh --local 有意義）；不是存在的 .tar → 1 + 6-24 add --local 分句「add --local 只接受存在的 .tar 檔：&amp;lt;v&amp;gt;」；§1.1 選項表的 tag 形只適用 bootstrap.sh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1715" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16c_tk1" value="工具 tar（來源，v2.8-5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1770" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16c_tv1" value="離線接工具要另備工具 tar：由下游 repo 自己提供（docker save 的 &amp;lt;repo&amp;gt;-dist image + 同名 .tar.digest 旁檔，一行 sha256:&amp;lt;hex64&amp;gt; = 該工具的正式 index digest），不在 vendor_kit 離線包內；下游使用者在有網路的機器取得、帶到離線機，逐工具執行 just vendor_kit add &amp;lt;repo&amp;gt; --local &amp;lt;工具 tar&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1770" width="610" height="71" as="geometry"/></mxCell><mxCell id="p16c_tk2" value=".digest 旁檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1841" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16c_tv2" value="&amp;lt;name&amp;gt;.tar 旁的 &amp;lt;name&amp;gt;.tar.digest：一行 sha256:&amp;lt;hex64&amp;gt; = 該 image 的正式多架構 index digest（同名旁檔須同在，缺 → 1 + 6-24 主機錯誤分類）；--local 用它寫 version.toml 正式 ref@digest（不寫本機 tag），metadata 記 local_image_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1841" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16c_tk3" value="image ID 記錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1896" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16c_tv3" value="docker load 後的 image 只有 tag、沒有 RepoDigests；docker image inspect --format &#x27;{{.Id}}&#x27; 取 image ID：引擎的本機覆寫記 version.local.toml vendor_kit_image_id、工具記 metadata local_image_id（image ID ↔ index digest 對照，供離線驗證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1896" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16c_tk4" value="指紋／flock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1715" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16c_tv4" value="指紋 = resolve 讀過的檔（version.toml、local、metadata、要動的專案檔、stamp 第一行、.tmp.* 清單、鎖定 digest、argv）的 sha256；apply 拿鎖後重算，不同 → 1 + 6-12「請重跑」；flock = 專案目錄鎖（60 秒；VENDOR_KIT_NO_LOCK=1 可關），鎖在引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1715" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16c_tk5" value="gen/&amp;lt;repo&amp;gt;.stamp／gen/tools.just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1770" width="150" height="40" as="geometry"/></mxCell><mxCell id="p16c_tv5" value="gen/&amp;lt;repo&amp;gt;.stamp = 印記（第一行 index digest，之後每檔 sha256）；gen/tools.just = 每工具一行 mod?（最後寫、與 cache 同一 apply 內原子替換）；都由引擎 apply（fetch 模組）寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1770" width="610" height="40" as="geometry"/></mxCell><mxCell id="p16c_tk6" value="6-N 訊息編號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1810" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16c_tv6" value="interface_spec §6 的逐字訊息清單編號（每句含可直接複製的指令）：6-3 無 registry 憑證、6-4 無 tty、6-12 指紋不同、6-15 update 末行、6-16 非 git repo、6-23 just 太舊、6-26 flock 逾時、6-27 未恢復、6-30 vk-resolve 不合、6-31 pull 逾時、6-32 prune 問句、6-33 未完成交易、6-37 --local 值歧義、6-38 log 寫不進…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1810" width="610" height="71" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;o10s：無失敗出口。&lt;br&gt;oo1b：同格兩件事。&lt;br&gt;oe22d：標籤擁擠。&lt;br&gt;o10re／o10rey：菱形寫「resolve 已拿 flock：偵測到既有進度檔？」且 o10rey 在 resolve 容器內做恢復（寫檔）；規格 §3.1／§3.2 鎖在 apply 一開始拿、resolve 不寫任何檔；add（1）頁 cpq 是在 docker run resolve 之前先恢復，本頁順序與誰做都不同。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1897" width="520" height="143" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p16cb" name="65 流程 v2：離線包（2′）add --local：create／cp → apply"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：離線包（2′）── add --local：docker create／cp → apply add（Q26、§4.8、§7.4-16）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q26、v2.6-1、v2.7-1／-2、v2.8-4／-5、v2.13 P4、v2.15-2／-14／-17、v2.16-4、interface_spec §1.2、§4.8、§7.4-16／17）：契約入口 = bootstrap.sh --local &amp;lt;引擎 tar&amp;gt;，只涉及引擎（local_bootstrap.sh 非契約）；先驗 git／just 再建執行紀錄；--local 依序判別（.tar 結尾 → 檔案；否則含 / 且有同名檔 → 6-37；否則 tag）；最低介面版檢查在起容器之前（斷網也回 3）；tar 附同名 .digest；install 第一個寫入前建 .tmp.install；version.toml 寫正式 ref@digest；離線 upgrade 不支援。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="116" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者（離線機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="230" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="136" width="400" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="docker daemon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="136" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="136" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="136" width="280" height="28" as="geometry"/></mxCell><mxCell id="bO1c" value="離線接工具（2′）（承「離線包（2）」頁）：docker create／cp 本機 image 的 dist → apply add（flock → 重驗指紋 → --dry-run → [progress] → metadata → 續 add（2）其餘寫入 → version.toml 最後寫）→ 0" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1590" height="1040" as="geometry"/></mxCell><mxCell id="bO1c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1c"><mxGeometry x="1546" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="o10p0" value="來自「離線包（2）」頁：resolve 0 且 vk-resolve 文法合（extract 清單、指紋）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=58;spacingRight=58;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1c"><mxGeometry x="270" y="36" width="400" height="58" as="geometry"/></mxCell><mxCell id="o10p" value="docker create／cp 取本機 image 的 dist 到暫存 .tmp.dist.&amp;lt;id&amp;gt;/&amp;lt;repo&amp;gt;/（不 pull）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="270" y="108" width="400" height="42" as="geometry"/></mxCell><mxCell id="o10p2" value="docker run 引擎 apply add [--dry-run]（暫存唯讀掛進 /dist）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="270" y="164" width="400" height="42" as="geometry"/></mxCell><mxCell id="o10ex" value="逾時 → 1 + 6-26：確認無其他 vendor_kit 在跑後重試" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1c"><mxGeometry x="20" y="220" width="230" height="80" as="geometry"/></mxCell><mxCell id="o10e" value="apply add：拿 flock 專案目錄（60 秒）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="240" width="320" height="40" as="geometry"/></mxCell><mxCell id="o10ex2" value="≠ → 1 + 6-12：指紋不同，請重跑" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1c"><mxGeometry x="20" y="314" width="230" height="58" as="geometry"/></mxCell><mxCell id="o10ex2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1c"><mxGeometry x="226" y="304" width="30" height="20" as="geometry"/></mxCell><mxCell id="o10e2" value="重驗指紋（與 vk-resolve 的 fingerprint 比）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="323" width="320" height="40" as="geometry"/></mxCell><mxCell id="o10dy" value="是 → 0：唯讀預覽會建／會問哪些檔（不建進度檔）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1c"><mxGeometry x="20" y="386" width="230" height="58" as="geometry"/></mxCell><mxCell id="o10dq" value="--dry-run？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=50;spacingRight=50;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1c"><mxGeometry x="950" y="390" width="200" height="50" as="geometry"/></mxCell><mxCell id="o10pg" value="否：metadata 建 [progress]（第一個寫入前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="459" width="320" height="40" as="geometry"/></mxCell><mxCell id="o10pgf" value="＋baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml [progress]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="458" width="280" height="42" as="geometry"/></mxCell><mxCell id="o10e3" value="寫 metadata：source（正式 ref@digest）+ local_image_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="514" width="320" height="42" as="geometry"/></mxCell><mxCell id="o10f" value="metadata：source + local_image_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="515" width="280" height="40" as="geometry"/></mxCell><mxCell id="o10z" value="續「add（2）」頁：初始檔、基準版、cache/&amp;lt;repo&amp;gt;/、印記、gen/tools.just（與線上接入相同）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=47;spacingRight=47;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1c"><mxGeometry x="950" y="570" width="320" height="80" as="geometry"/></mxCell><mxCell id="o10z2" value="來自「add（2）」頁：其餘寫入完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=47;spacingRight=47;spacingTop=6;spacingBottom=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="664" width="320" height="40" as="geometry"/></mxCell><mxCell id="o10e4" value="寫 version.toml [tools] 行：正式 ref@digest（最後寫）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="718" width="320" height="42" as="geometry"/></mxCell><mxCell id="o10f2" value="version.toml [tools] 行（正式 ref@digest；與線上接入相同）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="718" width="280" height="42" as="geometry"/></mxCell><mxCell id="o10e5" value="刪 metadata [progress]（交易完成）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="950" y="774" width="320" height="40" as="geometry"/></mxCell><mxCell id="o10f3" value="metadata [progress]（刪）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="774" width="280" height="40" as="geometry"/></mxCell><mxCell id="o11" value="0：該工具接入完成（version.toml 同線上）；下一個工具再跑 add" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1c"><mxGeometry x="20" y="828" width="230" height="80" as="geometry"/></mxCell><mxCell id="o10fail" value="寫入失敗匯流：回 1，進度保留，下次先恢復" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="922" width="280" height="40" as="geometry"/></mxCell><mxCell id="o10failx" value="1：寫入失敗（進度保留，下次先恢復）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=41;spacingRight=41;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1c"><mxGeometry x="1290" y="976" width="280" height="58" as="geometry"/></mxCell><mxCell id="o10doneleft" value="1：已寫入完成；進度檔留待下次刪" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1c"><mxGeometry x="20" y="976" width="230" height="58" as="geometry"/></mxCell><mxCell id="oe26a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helv