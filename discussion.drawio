.just 到暫存（自描述首行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bIm"><mxGeometry x="560" y="482" width="300" height="40" as="geometry"/></mxCell><mxCell id="i4_2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bIm"><mxGeometry x="836" y="472" width="30" height="20" as="geometry"/></mxCell><mxCell id="i4_3" value="產 vendor.just 到暫存（自描述首行；source log.sh）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bIm"><mxGeometry x="560" y="542" width="300" height="48" as="geometry"/></mxCell><mxCell id="i4_3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bIm"><mxGeometry x="836" y="532" width="30" height="20" as="geometry"/></mxCell><mxCell id="i4_3b" value="產 log.sh 到暫存（自描述首行；POSIX；內嵌啟動器事件白名單）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bIm"><mxGeometry x="560" y="610" width="300" height="48" as="geometry"/></mxCell><mxCell id="i4_3b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bIm"><mxGeometry x="836" y="600" width="30" height="20" as="geometry"/></mxCell><mxCell id="i4_4" value="產 ci/check.sh 到暫存（自描述在第二行）" style="rounded=1;whiteSpace=wrap;html=1;f