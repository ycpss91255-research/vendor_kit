<mxfile host="app.diagrams.net"><diagram id="v1p0" name="01 名詞與縮寫"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="3074" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="名詞與縮寫" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="p0_intro" value="本頁是所有審閱頁的共同字典：之後每一頁只用這裡定義的詞。本頁只定義、不決議。審閱方式：逐條看名稱與定義是否貼切，不貼切的寫一句理由。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_s1" value="兩方與承諾關係" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t1_h0" value="名稱" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="144" width="150" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h1" value="是誰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="170" y="144" width="870" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h2" value="跟 VK 的互動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="144" width="300" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_h3" value="地位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1340" y="144" width="260" height="30" as="geometry"/></mxCell><mxCell id="p0_t1_r0c0" value="&lt;b&gt;使用者&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="174" width="150" height="64" as="geometry"/></mxCell><mxCell id="p0_t1_r0c1" value="會跑 VK 動詞的人，兩個場合：①在 repo 裡維護 dist/、把工具打成工具 image、用 dev、undev 在本機開發；②在 repo 裡跑 bootstrap.sh 接入、add、upgrade、remove、回答詢問或給 -y、commit 薄殼與版本鎖定行、升版有衝突就手動編輯再重跑、把 VK 提供的 CI 檢查腳本接進自己的 CI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="174" width="870" height="64" as="geometry"/></mxCell><mxCell id="p0_t1_r0c2" value="直接操作 VK 的明示入口：首次接入使用 bootstrap.sh，接入後使用 just vendor_kit …。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1040" y="174" width="300" height="64" as="geometry"/></mxCell><mxCell id="p0_t1_r0c3" value="被承諾方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1340" y="174" width="260" height="64" as="geometry"/></mxCell><mxCell id="p0_t1_r1c0" value="&lt;b&gt;VK&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="238" width="150" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c1" value="我們，vendor_kit 開發者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="170" y="238" width="870" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c2" value="維護引擎 image 與薄殼（含啟動器），履行對使用者的承諾；內部實作不屬契約、可變更" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1040" y="238" width="300" height="46" as="geometry"/></mxCell><mxCell id="p0_t1_r1c3" value="承諾方" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1340" y="238" width="260" height="46" as="geometry"/></mxCell><mxCell id="p0_t1n" value="只打 just &amp;lt;ns&amp;gt; … 的人不是『方』：VK 在他背後只做工具 recipe 前的自動 sync；sync 失敗的訊息要寫清楚該找誰、做什麼，但那是對使用者的承諾內容，不是另一個角色。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="298" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_s2" value="repo 與角色" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t2d" value="&lt;b&gt;repo&lt;/b&gt;：使用者的 git repo。一個 repo 可以有多個接入根，例如 monorepo 的各個子目錄。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t2r" value="一個 repo 對 VK 可以扮演兩個角色：&lt;b&gt;接入&lt;/b&gt;（把別人做好的工具裝進來用）與&lt;b&gt;出貨&lt;/b&gt;（把自己做的工具交出去給別人裝）。同一個 repo 可以只扮演一個，也可以兩個都扮演。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="414" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t2_h0" value="角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="456" width="140" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_h1" value="這個 repo 有什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="160" y="456" width="380" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_h2" value="使用者在裡面做什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="540" y="456" width="560" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_h3" value="VK 的承諾" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="456" width="500" height="30" as="geometry"/></mxCell><mxCell id="p0_t2_r0c0" value="&lt;b&gt;接入&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="486" width="140" height="100" as="geometry"/></mxCell><mxCell id="p0_t2_r0c1" value="• .vendor_kit/：VK 建的目錄，放薄殼、版本鎖定行與本機狀態&lt;br&gt;• 工具搬進來的內容（在 cache/）與初始檔（在 repo 檔裡）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="160" y="486" width="380" height="100" as="geometry"/></mxCell><mxCell id="p0_t2_r0c2" value="• 第一次用 bootstrap.sh 把 VK 裝進這個 repo&lt;br&gt;• 用 just vendor_kit add &amp;lt;repo&amp;gt; 把工具搬進來，版本鎖成一行&lt;br&gt;• 用 just vendor_kit upgrade &amp;lt;repo&amp;gt; 升版，初始檔做基準版合併&lt;br&gt;• 把薄殼與版本鎖定行 commit 進 git&lt;br&gt;• 用 just &amp;lt;ns&amp;gt; … 執行工具提供的 recipe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="540" y="486" width="560" height="100" as="geometry"/></mxCell><mxCell id="p0_t2_r0c3" value="• 不刪、不覆蓋 repo 檔&lt;br&gt;• 版本鎖得住：同一行鎖定行在任何機器都裝到同一份內容&lt;br&gt;• 升得了：升版只改工具內容與初始檔的合併結果&lt;br&gt;• 失敗必印原因與下一步" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1100" y="486" width="500" height="100" as="geometry"/></mxCell><mxCell id="p0_t2_r1c0" value="&lt;b&gt;出貨&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="586" width="140" height="64" as="geometry"/></mxCell><mxCell id="p0_t2_r1c1" value="• dist/：要交出去的內容（files/、init.toml、just/&amp;lt;ns&amp;gt;.just）&lt;br&gt;• 把 dist/ 打成工具 image 的 Dockerfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="160" y="586" width="380" height="64" as="geometry"/></mxCell><mxCell id="p0_t2_r1c2" value="• 維護 dist/ 的內容&lt;br&gt;• 把 dist/ 打成工具 image 推到 registry&lt;br&gt;• 用 dev、undev 在本機邊改邊測，不必每次推 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="540" y="586" width="560" height="64" as="geometry"/></mxCell><mxCell id="p0_t2_r1c3" value="• 照 dist/ 的格式出貨，VK 就搬得到&lt;br&gt;• VK 只搬檔，不執行、不驗證內容能不能跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1100" y="586" width="500" height="64" as="geometry"/></mxCell><mxCell id="p0_t2n1" value="&amp;lt;repo&amp;gt; 是出貨角色那個 repo 的名字，也是工具名；接入的人用這個名字指定要裝哪個工具。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="664" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_t2n2" value="例：ros_env 這個 repo 出貨一個工具；robot_a 這個 repo 接入它。ros_env 自己也可以接入別的工具，這時它同時扮演兩個角色。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="1580" height="32" as="geometry"/></mxCell><mxCell id="p0_s3" value="VK 組件（component）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="748" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_c1" value="&lt;b&gt;引擎&lt;/b&gt;：執行 VK 動詞的主程式，以容器 image 發布。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="516" height="50" as="geometry"/></mxCell><mxCell id="p0_c2" value="&lt;b&gt;薄殼&lt;/b&gt;：.vendor_kit/ 內由引擎產生、隨 repo 進 git、供使用者呼叫 VK 的一組檔。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="552" y="780" width="516" height="50" as="geometry"/></mxCell><mxCell id="p0_c3" value="&lt;b&gt;啟動器&lt;/b&gt;：從主機啟動引擎的入口；薄殼內的 POSIX sh 片段與首次接入用的 bootstrap.sh 都是啟動器。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1084" y="780" width="516" height="50" as="geometry"/></mxCell><mxCell id="p0_s4" value="常用詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_s4a" value="工具與 image" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="872" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="904" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3a_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="904" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3a_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="904" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p0_t3a_r0c0" value="&lt;b&gt;&amp;lt;repo&amp;gt;&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="934" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r0c1" value="repository name" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="934" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r0c2" value="出貨角色的 repo 名，也是該 repo 所出貨工具的名稱。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="934" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r1c0" value="&lt;b&gt;工具&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="962" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r1c1" value="tool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="962" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r1c2" value="repo 出貨、供另一個（或同一個）repo 接入的內容單位，名字是 &amp;lt;repo&amp;gt;。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="962" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r2c0" value="&lt;b&gt;&amp;lt;ns&amp;gt; 命名空間&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="990" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r2c1" value="namespace" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="990" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r2c2" value="工具在 just 中提供 recipe 的命名空間。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="990" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_t3a_r3c0" value="&lt;b&gt;工具 recipe&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="101