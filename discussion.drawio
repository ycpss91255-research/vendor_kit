2c_my_r8c1" value="—（只讀 complete、source 落後）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="150" y="1202" width="250" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r8c2" value="缺或需重生 → 重生" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="400" y="1202" width="190" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r8c3" value="fetch 時寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="590" y="1202" width="190" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r8c4" value="fetch／重裝（只拉鎖定版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="780" y="1202" width="230" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r8c5" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1010" y="1202" width="320" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r8c6" value="—（有未完成 → 1 印 6-33 不恢復）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1330" y="1202" width="210" height="42" as="geometry"/></mxCell><mxCell id="p2c_my_r9c0" value="update" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="20" y="1244" width="130" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c1" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="150" y="1244" width="250" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c2" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="400" y="1244" width="190" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c3" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="590" y="1244" width="190" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c4" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="780" y="1244" width="230" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c5" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1010" y="1244" width="320" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r9c6" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1330" y="1244" width="210" height="26" as="geometry"/></mxCell><mxCell id="p2c_my_r10c0" value="prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p2C"><mxGeometry x="20" y="1270" width="130" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2C"><mxGeometry x="118" y="1272" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2c_my_r10c1" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="150" y="1270" width="250" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c2" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="400" y="1270" width="190" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c3" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="590" y="1270" width="190" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c4" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="780" y="1270" width="230" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c5" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1010" y="1270" width="320" height="57" as="geometry"/></mxCell><mxCell id="p2c_my_r10c6" value=".tmp.prune.&amp;lt;id&amp;gt;.toml；刪失效 .tmp.dist.*、已完成殘留；活躍的不刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2C"><mxGeometry x="1330" y="1270" width="210" height="57" as="geometry"/></mxCell><mxCell id="p2c_reno" value="&lt;b&gt;version.toml 怎麼被讀&lt;/b&gt;&lt;br&gt;・啟動器（sh）：以版本鎖定行 regex 於 version.local.toml（覆寫優先）→ version.toml 取 vendor_kit；命中數 ≠ 1 → 1；不解析 TOML（resolve 的 vk-resolve 才是它的輸入）；快路徑用 grep 比 gen/*.stamp&lt;br&gt;・引擎 progress 模組：TOML 讀寫（檔案版轉換）+ version.local.toml 覆寫；flock；apply 最後才寫 version.toml&lt;br&gt;・Renovate preset：regex manager（**/.vendor_kit/version.toml；key regex 與版本鎖定行契約共用）+ docker datasource，同時擷取 currentValue（tag）與 currentDigest；PR 只改一行；major 分開 PR&lt;br&gt;・deploy：交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR（工具契約一句；vendor_kit 不檢查）；version.toml 公開格式可供來源紀錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p2C"><mxGeometry x="20" y="1341" width="750" height="155" as="geometry"/></mxCell><mxCell id="p2c_reno_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2C"><mxGeometry x="738" y="1343" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2c_rule" value="&lt;b&gt;規則摘要&lt;/b&gt;&lt;br&gt;・version.toml 是唯一來源：sync 拿它對印記，不一致就 fetch（只拉鎖定版）；apply 拿鎖後先重驗 resolve 給的輸入指紋，不同 → 1 印 6-12&lt;br&gt;・自動化（sync）只碰 cache/&amp;lt;repo&amp;gt;/、gen/tools.just、gen/&amp;lt;repo&amp;gt;.stamp：不碰專案檔、不寫薄殼、不寫 gen/.stamp；薄殼 ≠ 引擎 ref → 1 印 6-1（install／upgrade vendor_kit 不被擋）&lt;br&gt;・基準版是上次合併的歷史狀態，不由 version.toml 推導（待合併時 version 已 B、基準版仍 A）&lt;br&gt;・進 git 的只有：根 justfile 那行、根 .dockerignore 四行、.vendor_kit/（不含 cache/、gen/、version.local.toml、.tmp.*）、初始檔；人只改：justfile、初始檔、version.toml（手動升版）&lt;br&gt;・舊薄殼（--protocol P 太舊）跑新 major 引擎的一般動詞 → 3 零寫入（6-36）；救援路徑永遠可用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p2C"><mxGeometry x="790" y="1341" width="750" height="155" as="geometry"/></mxCell><mxCell id="p2c_rule_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2C"><mxGeometry x="1508" y="1343" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2c_lg0" value="淺橘底：規則／摘要（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1642" width="190" height="40" as="geometry"/></mxCell><mxCell id="p2c_lg1" value="灰底：表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="250" y="1642" width="110" height="40" as="geometry"/></mxCell><mxCell id="p2c_lg2" value="淺灰底：分組（無狀態意義）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="1642" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2c_lg3" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1642" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2c_lg3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="768" y="1644" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2c_lg4" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1642" width="220" height="40" as="geometry"/></mxCell><mxCell id="p2c_lgt" value="表格：一列一動詞、一欄一檔&lt;br&gt;目錄樹與範例 p2、schema p2b" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1060" y="1632" width="300" height="60" as="geometry"/></mxCell><mxCell id="p2c_th" value="本頁名詞（只列本頁用到的）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1698" width="300" height="28" as="geometry"/></mxCell><mxCell id="p2c_tk0" value="輸入指紋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1732" width="150" height="40" as="geometry"/></mxCell><mxCell id="p2c_tv0" value="resolve 把它讀過的 version.toml、metadata、要動的專案檔的 hash＋鎖定 digest 一起輸出；apply 拿到 flock 後重驗，不同（中間有人改了）→ 1「請重跑」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1732" width="610" height="40" as="geometry"/></mxCell><mxCell id="p2c_tk1" value="Renovate preset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1772" width="150" height="55" as="geometry"/></mxCell><mxCell id="p2c_tv1" value="放 vendor_kit repo 根目錄 default.json（自身設定用 renovate.json）；regex manager 匹配 **/.vendor_kit/version.toml + docker datasource，同時擷取 currentValue（tag）與 currentDigest；PR 只改一行；major 分開 PR；prBodyNotes = 6-25" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1772" width="610" height="55" as="geometry"/></mxCell><mxCell id="p2c_tk2" value="deploy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1827" width="150" height="40" as="geometry"/></mxCell><mxCell id="p2c_tv2" value="把專案交付物部署到執行環境；工具契約一句：交付物執行期不得依賴 .vendor_kit/、version.toml、GHCR（vendor_kit 不檢查）；version.toml 公開格式可供來源紀錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1827" width="610" height="40" as="geometry"/></mxCell><mxCell id="p2c_tk3" value="根 justfile 四行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1867" width="150" height="55" as="geometry"/></mxCell><mxCell id="p2c_tv3" value="install 新建根 justfile 時逐字：import &#x27;.vendor_kit/entry.just&#x27;／（空行）／default:／\t@just --list（default: @just --list 單行是 just 語法錯誤）；已有 justfile 只問後加 import 那一行；uninstall 只刪完全相同行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1867" width="610" height="55" as="geometry"/></mxCell><mxCell id="p2c_tk4" value="根 .dockerignore 四行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1732" width="150" height="71" as="geometry"/></mxCell><mxCell id="p2c_tv4" value="install 加進專案根 .dockerignore 的 .vendor_kit/cache/、.vendor_kit/gen/、.vendor_kit/.tmp.*、.vendor_kit/log/（無則建；有則問 6-34 後 append、-y 免問）；插入的行記於 baseline/.vendor_kit.toml；uninstall 問後只刪原文相同行；工具以專案根當 build context 時靠它排除 cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1732" width="610" height="71" as="geometry"/></mxCell><mxCell id="p2c_tk5" value="baseline/.gitkeep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1803" width="150" height="55" as="geometry"/></mxCell><mxCell id="p2c_tv5" value="VK 自產的進 git 空檔：git 不追蹤空目錄，所以 baseline/ 靠它進 git；install 建、uninstall 刪、hash 固定為空檔（§4.0；v2.15-14）；工具的 metadata 由 add 才建（baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml 兼作該工具目錄的佔位）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1803" width="610" height="55" as="geometry"/></mxCell><mxCell id="p2c_tk6" value="declined／declined_hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1858" width="150" height="55" as="geometry"/></mxCell><mxCell id="p2c_tv6" value="拒絕的記錄：新增檔被拒 → state=declined；已納管檔拒絕換版／合併 → state 不變只記 declined_hash（那版新版初始檔 N 的 sha256）；新版 N 的 hash ≠ declined_hash → 再問一次，相同 → 不問但印 6-6／6-8；EOF／Ctrl-C 不記 declined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1858" width="610" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p3" name="09 契約 v2：下游 repo 契約③"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1723" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約③ 下游 repo 要交的（供應側；interface_spec §4.7、§4.8、§3.6；改了要升 major 並公告）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p3_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p3_pend" value="&lt;b&gt;本頁無待拍板&lt;/b&gt;&lt;br&gt;dist/files/ 的 symlink 已定禁止；dist 文字檔一律 LF、check.sh --dist 擋 CRLF 已定於 issue #29；Dockerfile.dist 必含 LABEL（16 條必修）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="81" as="geometry"/></mxCell><mxCell id="p3L4" value="契約③ 下游 repo 要交的（dist 佈局、init.toml、_sync、Dockerfile.dist、image 與 label、離線包）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="109" width="1560" height="1183" as="geometry"/></mxCell><mxCell id="p3_dist" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;&amp;lt;repo&amp;gt;/                  # 下游 repo&lt;br&gt;├─ dist/&lt;br&gt;│  ├─ files/…            # 全部出貨（原樣展開）&lt;br&gt;│  ├─ init.toml          # 初始檔清單（下表）&lt;br&gt;│  └─ just/&amp;lt;ns&amp;gt;.just     # 一檔一命名空間（含 _sync）&lt;br&gt;└─ Dockerfile.dist       # 逐字三行（下框）&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="p3L4"><mxGeometry x="20" y="50" width="440" height="108" as="geometry"/></mxCell><mxCell id="p3_dock_l" value="Dockerfile.dist（逐字三行；純資料 image）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="p3L4"><mxGeometry x="20" y="170" width="440" height="28" as="geometry"/></mxCell><mxCell id="p3_dock" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;FROM scratch&lt;br&gt;LABEL io.github.&amp;lt;org&amp;gt;.vendor_kit=1&lt;br&gt;COPY dist/ /dist/&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="p3L4"><mxGeometry x="20" y="202" width="440" height="61" as="geometry"/></mxCell><mxCell id="d4_1" value="&lt;b&gt;dist/files/&lt;/b&gt;&lt;br&gt;全部出貨；fetch 原樣展開到 .vendor_kit/cache/&amp;lt;repo&amp;gt;/files/（引擎展開時也驗右欄 CI 的檔案規則）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="480" y="50" width="253" height="155" as="geometry"/></mxCell><mxCell id="d4_1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="701" y="52" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_2" value="&lt;b&gt;dist/init.toml&lt;/b&gt;&lt;br&gt;schema、description（單行）、[[file]] src／dest／strategy=&quot;copy&quot;|&quot;append&quot;（預設 copy），dest 相對專案根；用 copy 指向根 .gitignore／.dockerignore／.editorconfig → --dist 報錯（要用 append）；欄位表見下" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="749" y="50" width="253" height="155" as="geometry"/></mxCell><mxCell id="d4_2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="970" y="52" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_3" value="&lt;b&gt;dist/just/&amp;lt;ns&amp;gt;.just&lt;/b&gt;&lt;br&gt;每檔一個頂層命名空間，數量工具自決，&amp;lt;repo&amp;gt;.just 必須存在；每檔含私有 _sync（F1，見下）；撞名 → add 拒絕；recipe 用 cd {{quote(justfile_directory())}} 回專案根（禁止相對 working-directory）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="1018" y="50" width="253" height="155" as="geometry"/></mxCell><mxCell id="d4_3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1239" y="52" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_4" value="&lt;b&gt;Dockerfile.dist&lt;/b&gt;&lt;br&gt;逐字三行：FROM scratch／LABEL io.github.&amp;lt;org&amp;gt;.vendor_kit=1／COPY dist/ /dist/；純資料，不承諾可執行、vendor_kit 不檢查 binary（Q21：只搬移）；缺 LABEL → check.sh --dist 失敗（label 只能 build 時加，pull 無法追加）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="1287" y="50" width="253" height="155" as="geometry"/></mxCell><mxCell id="d4_4_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1508" y="52" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_5" value="&lt;b&gt;下游 image&lt;/b&gt;&lt;br&gt;ghcr.io/&amp;lt;org&amp;gt;/&amp;lt;repo&amp;gt;-dist:&amp;lt;tag&amp;gt;&lt;br&gt;多架構 amd64 + arm64（同一次 buildx、COPY-only；CI 驗兩平台位元組一致）；version.toml 與印記記 index digest（#26）；公開／私有自決（公開不可逆）；已釋出 image／index 子 digest 永不刪；LABEL …vendor_kit=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="480" y="221" width="253" height="217" as="geometry"/></mxCell><mxCell id="d4_5_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="701" y="223" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_6" value="&lt;b&gt;引擎 image&lt;/b&gt;&lt;br&gt;ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:vN&lt;br&gt;公開；多架構（只驗兩平台 LABEL 一致）；LABEL …vendor_kit=1、.protocol=&amp;lt;floor_P&amp;gt;-&amp;lt;current_P&amp;gt;、.schema=&amp;lt;N&amp;gt;（啟動器不起容器即可判最低介面版）；每平台 docker save tar + .digest 旁檔；Release 資產永不刪" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="749" y="221" width="253" height="217" as="geometry"/></mxCell><mxCell id="d4_6_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="970" y="223" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_7" value="&lt;b&gt;下游 repo 的 CI&lt;/b&gt;&lt;br&gt;跑 vendor_kit 出貨的 check.sh --dist：dist 佈局、init.toml 合法（schema、description 單行、strategy 只能 copy|append、src／dest 規則、copy 不得指向根 ignore 類檔）、files/ 禁 symlink／hardlink／特殊檔、文字檔一律 LF [#29]、just 1.33.0 解析每個 &amp;lt;ns&amp;gt;.just、_sync lint、Dockerfile.dist 含 LABEL、image 可展開、兩平台一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="1018" y="221" width="253" height="217" as="geometry"/></mxCell><mxCell id="d4_7_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1239" y="223" width="30" height="20" as="geometry"/></mxCell><mxCell id="d4_8" value="&lt;b&gt;deploy（一句話契約）&lt;/b&gt;&lt;br&gt;工具 recipe 產生的交付物在執行期不得依賴 .vendor_kit/、version.toml、GHCR（需要的檔打包時複製進去）；vendor_kit 不檢查；保證方式 = 下游 repo 自己在乾淨機器解包驗收；version.toml 公開格式可供來源紀錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="1287" y="221" width="253" height="217" as="geometry"/></mxCell><mxCell id="d4_8_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1508" y="223" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_dest" value="&lt;b&gt;dest 規則（引擎在任何寫入前驗，不只供應端 lint）&lt;/b&gt;：src 相對 dist/、正規化、不得越出 dist/；dest 相對專案根、正規化後不得越出 repo、不得指向 .vendor_kit/、父目錄不得經 symlink；兩工具同 dest：copy/copy、copy/append → add 拒絕；append/append → 允許，各工具的行分開記錄，重疊或歸屬不明 → 拒絕；add 與 upgrade 都在任何寫入前檢查（含新版新增 &amp;lt;ns&amp;gt;／dest 的全域撞名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="20" y="454" width="1520" height="46" as="geometry"/></mxCell><mxCell id="p3_dest_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1508" y="456" width="30" height="20" as="geometry"/></mxCe