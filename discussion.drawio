="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1329" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1329" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1329" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1329" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1329" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1329" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bcx_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1319" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bcx_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1369" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bcx_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1415" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bcx_tk0" value="6-2b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1449" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcx_tv0" value="第一行已改但新引擎拉取／重產失敗，或第二次第一行又變 → 1：「引擎版本已鎖定為 vY，但薄殼尚未重產；請排除上述錯誤後執行：just vendor_kit upgrade vendor_kit」（.tmp.upgrade 進度檔保留）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1449" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bcx_tk1" value="升引擎進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1489" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcx_tv1" value=".tmp.upgrade.&amp;lt;id&amp;gt;.toml：改第一行之前建，記舊引擎 ref、目標引擎 ref、計畫 image ID、done／pending；啟動器 grep 其目標 ref 決定拉哪個引擎；新引擎重產薄殼完成後刪；未完成 → 可寫動詞先恢復（= 重跑 upgrade vendor_kit）、sync／update 印 6-33 結束 1、help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1489" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcx_tk2" value="docker image inspect（引擎）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1544" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcx_tv2" value="啟動器每次先 docker image inspect：本機有就不 pull（本機覆寫時 .Id 必須 == version.local.toml 記的 image ID，否則 1）；不用 --pull never；引擎 image LABEL 帶介面版／檔案版，供降版判定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1544" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcx_tk3" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1449" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcx_tv3" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1449" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• s12j：「建進度檔（已有 → 沿用）」一格兩事（判斷＋動作）；E(c)(2) 頁同邏輯已拆成 s12jq 判斷＋s12jn 建檔，本頁把判斷藏在括號裡，恢復路徑（來自 E(c)(1) s12jr）看不出走哪條&lt;br&gt;• se12wh／fb_s12j：s12j 往下接啟動器 grep 框的線（y=317，x 440–702）與 s12j 的失敗匯流線（y=317，x 1006–1610）同高、左右各一段，縮圖像一條橫貫整頁的線，分不清成功／失敗&lt;br&gt;• se12hax：「逾時」標籤壓框：s12ha 右邊（x=990）到紅終點 s12hax 左邊（x=1020）只有 30px，標籤貼到橢圓邊線；比照 E(a′)／E(c)(1) 把紅終點右移到 x≥1030" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1520" width="520" height="174" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bccc" name="41 流程 v2：upgrade ── E(c) upgrade vendor_kit（2）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1715" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── E(c) upgrade vendor_kit（2）進度檔 → 改第一行 → 重產薄殼五檔（v2.15-7）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="64" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="64" width="200" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uE3" value="E(c)（2）（承「E(c)（1）」頁：目標 = 現 ref；或「E(c)（1′）」頁：目標引擎接手）：薄殼相符 → 0；否 → 進度檔（已有沿用）→ 第一行 ≠ 本引擎 → 改第一行 → 重產五檔（任一寫入失敗 → 匯流）；config.toml 見「E(c)（2″）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1090" as="geometry"/></mxCell><mxCell id="uE3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12z0" value="來自「E(c)（1）」頁（目標 = 現 ref）或「E(c)（1′）」頁（目標引擎已重新拿鎖並重驗薄殼）；已寫 launcher_start" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=53;spacingRight=53;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE3"><mxGeometry x="610" y="36" width="360" height="80" as="geometry"/></mxCell><mxCell id="s12z" value="0：無變更（薄殼相符，已是本引擎產物）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="uE3"><mxGeometry x="20" y="178" width="220" height="58" as="geometry"/></mxCell><mxCell id="s12z_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="216" y="168" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12e" value="薄殼相符且沒有殘留 .tmp.upgrade 進度檔？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=36;spacingBottom=36;" vertex="1" parent="uE3"><mxGeometry x="600" y="136" width="240" height="143" as="geometry"/></mxCell><mxCell id="s12e_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="816" y="126" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12n" value="「薄殼 == 上次產物」已在「E(c)（1）」頁拿鎖後、任何寫入前驗過；任一步失敗 → 進度檔保留（done／pending），下次 upgrade vendor_kit 依它續跑（已替換的薄殼檔不重做）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="uE3"><mxGeometry x="1220" y="176" width="360" height="63" as="geometry"/></mxCell><mxCell id="s12n_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="1556" y="166" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12jq" value="否 → 已有 .tmp.upgrade 進度檔（接手續跑）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=36;spacingBottom=36;" vertex="1" parent="uE3"><mxGeometry x="600" y="299" width="240" height="143" as="geometry"/></mxCell><mxCell id="s12jq_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="816" y="289" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12jn" value="否：建進度檔（第一個寫入前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE3"><mxGeometry x="840" y="478" width="140" height="48" as="geometry"/></mxCell><mxCell id="s12jn_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="956" y="468" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12jnf" value="＋.vendor_kit/.tmp.upgrade.&amp;lt;id&amp;gt;.toml（進度檔，不進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE3"><mxGeometry x="1220" y="478" width="360" height="48" as="geometry"/></mxCell><mxCell id="s12jnf_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE3"><mxGeometry x="1556" y="468" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12jy" value="是 → 第一行已是本引擎 ref？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=60;spacingRight=60;spacingTop=20;spacingBottom=20;" vertex="1" parent="uE3"><mxGeometry x="600" y="462" width="240" height="81" as="geometry"/></mxCell><mxCell id="s12jy_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00