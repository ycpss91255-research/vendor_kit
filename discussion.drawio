d="p7cq_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1176" width="200" height="60" as="geometry"/></mxCell><mxCell id="p7cq_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1176" width="140" height="64" as="geometry"/></mxCell><mxCell id="p7cq_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1184" width="140" height="44" as="geometry"/></mxCell><mxCell id="p7cq_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1178" width="190" height="56" as="geometry"/></mxCell><mxCell id="p7cq_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1178" width="210" height="56" as="geometry"/></mxCell><mxCell id="p7cq_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1186" width="88" height="40" as="geometry"/></mxCell><mxCell id="p7cq_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1186" width="170" height="40" as="geometry"/></mxCell><mxCell id="p7cq_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1176" width="300" height="60" as="geometry"/></mxCell><mxCell id="p7cq_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1244" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1244" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1244" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="1244" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="1244" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="1244" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1244" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1210" y="1244" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7cq_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1366" y="1234" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7cq_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1284" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7cq_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1330" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7cq_tk0" value="基準版落後／待合併（6-5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1364" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tv0" value="最後合併版本 ≠ version.toml：有人只改了 version.toml（如 Renovate）→ CI 1 + 6-5（PR 紅，需人處理）、本機 warn；upgrade 先只補到那版就停，印「另有新版，再跑一次可升」；補合併衝突也立刻 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1364" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tk1" value="gen／mod?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1419" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tv1" value="gen/tools.just（不進 git）每個 &amp;lt;ns&amp;gt;.just 一行 mod? = 把工具的 just 檔掛成一個命名空間（just &amp;lt;ns&amp;gt; …；帶問號 = 檔不在也不掛）；新版的 just/ 可能增減檔，所以 upgrade 重生它（與 cache 同一 apply 內原子替換）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1419" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tk2" value="git merge-file --diff3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1474" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tv2" value="git 的三方合併指令；衝突時在檔內留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; vendor_kit:baseline ||||||| ======= &amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 標記（我們自己的標籤，重入時靠它偵測）；回傳衝突數 → 結束碼 2（需人處理，橙）；多工具（Q27）兩者皆回 2 時訊息全部列出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1474" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7cq_tk3" value="6-6／6-7／6-8（dry-run 提醒）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1364" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cq_tv3" value="6-6「有 N 個範本你拒絕過」；6-7「&amp;lt;X&amp;gt; 沒納管」；6-8「&amp;lt;Y&amp;gt; 你拒絕過，&amp;lt;vZ&amp;gt; 有新版」；--dry-run／check.sh 印，不問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1364" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7cq_tk4" value="6-14（待合併補完後另有新版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1404" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cq_tv4" value="待合併補完後另有新版 → 印「已補齊 &amp;lt;repo&amp;gt; 至 vB；另有新版 vX，再跑一次可升」（結束 2，需人處理）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1404" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7cq_tk5" value="解析失敗（基準版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1444" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7cq_tv5" value="合併結果是 TOML／just 等可解析格式卻解析失敗 → 只該檔留原檔、記 conflicts、其基準版留上一版不推；結束碼 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1444" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• p7cq_tv4：名詞表寫 6-14「結束 2，需人處理」，spec §6 6-14 類別為「—（提醒，不改結束碼）」，同頁便條 b18r 也寫「僅是提醒、不改結束碼」，頁內自相矛盾&lt;br&gt;• fb_b16b／b16x：刪進度檔失敗流進 b16x「1：寫入失敗…進度檔保留」，但此時寫入已全部完成；add（2）c23x 依 v2.17-3 已補「若僅刪進度檔失敗，寫入已完成且進度檔留待下次刪」，本頁終點文字未同步" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1500" width="520" height="128" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7b" name="35 流程 v2：upgrade ── C. 逐檔判斷狀態機、衝突重入"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2371" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── C. 逐檔判斷狀態機、C′ 衝突重入（§4.3、v2.2 D、v2.15-18）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="160" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="64" width="760" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uC" value="C. 逐檔判斷狀態機（每個 init.toml [[file]]＋metadata 每個 dest；在「B（2）」頁 apply 內逐檔呼叫）：依 metadata state 分流 → 每檔恰一條路 → 「不動／warn」或「問 6-22」回「B（2）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1636" as="geometry"/></mxCell><mxCell id="uC_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uC"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="c_in" value="來自「B（2）」頁：逐檔迴圈的一個檔（B／D／N 三份已備）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=67;spacingRight=67;spacingTop=8;spacingBottom=8;" vertex="1" parent="uC"><mxGeometry x="680" y="36" width="460" height="58" as="geometry"/></mxCell><mxCell id="c_in0" value="B = baseline/&amp;lt;repo&amp;gt;/&amp;lt;檔&amp;gt;（上次合併的範本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uC"><mxGeometry x="1220" y="45" width="360" height="40" as="geometry"/></mxCell><mxCell id="c_in1" value="D = 專案裡的 &amp;lt;檔&amp;gt;（現況，下游使用者可能改過）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uC"><mxGeometry x="1220" y="134" width="360" height="40" as="geometry"/></mxCell><mxCell id="q1" value="metadata 無此 dest（新版新增）且 dest 已存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4