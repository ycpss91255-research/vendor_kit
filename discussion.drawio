ingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L5"><mxGeometry x="20" y="1174" width="200" height="26" as="geometry"/></mxCell><mxCell id="p3_acc_r8c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L5"><mxGeometry x="188" y="1176" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_acc_r8c1" value="33、34、35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L5"><mxGeometry x="220" y="1174" width="170" height="26" as="geometry"/></mxCell><mxCell id="p3_acc_r8c2" value="bootstrap.sh 逐 -t 中止；E(c) 分支；help 遇未完成交易" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L5"><mxGeometry x="390" y="1174" width="1150" height="26" as="geometry"/></mxCell><mxCell id="p3c_lg0" value="橙橢圓：需人處理" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=14;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="200" height="52" as="geometry"/></mxCell><mxCell id="p3c_lg1" value="綠橢圓：成功終點（exit 0）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=14;fontSize=12;spacingLeft=39;spacingRight=39;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="260" y="1340" width="270" height="52" as="geometry"/></mxCell><mxCell id="p3c_lg2" value="紅橢圓：失敗（1）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=14;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="550" y="1340" width="190" height="52" as="geometry"/></mxCell><mxCell id="p3c_lg3" value="白：步驟／說明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1346" width="130" height="40" as="geometry"/></mxCell><mxCell id="p3c_lg4" value="淺橘底：規則／摘要（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="910" y="1346" width="190" height="40" as="geometry"/></mxCell><mxCell id="p3c_lg5" value="灰底：表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1346" width="110" height="40" as="geometry"/></mxCell><mxCell id="p3c_lgt" value="實線 = 執行順序；線上文字 = 條件&lt;br&gt;分組索引：一列一組" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1250" y="1336" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3c_lg6" value="淺灰底：分組（無狀態意義）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1412" width="200" height="40" as="geometry"/></mxCell><mxCell id="p3c_lg7" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="1412" width="200" height="40" as="geometry"/></mxCell><mxCell id="p3c_lg7_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="428" y="1414" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3c_lg8" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1412" width="220" height="40" as="geometry"/></mxCell><mxCell id="p3c_lg9" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="720" y="1412" width="170" height="40" as="geometry"/></mxCell><mxCell id="p3c_th" value="本頁名詞（只列本頁用到的）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1468" width="300" height="28" as="geometry"/></mxCell><mxCell id="p3c_tk0" value="env-test／test-base" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1502" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3c_tv0" value="vendor_kit 自身 CI 的前兩個 stage：env-test = smoke（環境檢查先於一切：docker、just 版本、runner 能力）；test-base FROM env-test = 之後各測試 stage 的共同基底，環境不對就沒有任何測試會跑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1502" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3c_tk1" value="離線可用（Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1557" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3c_tv1" value="啟動器一律先 docker image inspect：本機有 → 不 pull（不用 --pull never）；斷網 + 本機已有 image → sync／build 必須成功；斷網 + 無 image → docker pull 失敗 → 1 + 6-24／6-31 在 --timeout 內結束、不 hang；離線 upgrade 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1557" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3c_tk2" value="CI／runner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1612" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3c_tv2" value="CI = GitHub／GitLab 上每次 push 自動跑的檢查（兩者都設環境變數 CI=true → 依真值規則進CI 模式）；runner = 跑 CI 的機器（amd64、arm64 原生 runner = 兩種晶片各一台真機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1612" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3c_tk3" value="Renovate／PR／rebase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1652" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3c_tv3" value="Renovate = 下游自選的機器人，只改 version.toml 一行；PR = 請求合併的頁面；rebase = 把分支重接到最新主線（勿勾，會丟掉人補的合併）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1652" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3c_tk4" value="release／release-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1692" width="150" height="71" as="geometry"/></mxCell><mxCell id="p3c_tv4" value="release-test = 對候選 image 在 amd64、arm64 原生 runner 跑 env-test + 完整主機流程，發生在驗收與正式 release 之前；release = 候選全過後打正式 GHCR image tag vN（imagetools create、不重 build、digest 不變）、Git tag vN、發 Release 附 bootstrap.sh 與 tar + .digest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1692" width="610" height="71" as="geometry"/></mxCell><mxCell id="p3c_tk5" value="fixture repo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1502" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3c_tv5" value="驗收用的乾淨小 git repo：用剛 build 的引擎 image 從 bootstrap 到 uninstall 跑一遍完整流程；禁止由候選樹複製、禁 stub 引擎；fixture 永不刪" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1502" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3c_tk6" value="rootless／Podman" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1542" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3c_tv6" value="rootless = 不用 root 跑的 docker 模式（容器內已是你自己，不加 -u）；Podman = 相容 docker 指令的另一套容器工具（GitHub runner 內建 4.9.3；--userns=keep-id）；兩者都進驗收" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1542" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3c_tk7" value="候選 tag／正式 tag" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1582" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3c_tv7" value="候選 image 先以候選 tag（vN-rc.&amp;lt;n&amp;gt; 或 candidate-&amp;lt;sha&amp;gt;）推上 GHCR；index inspect 與資產都對候選 tag 做；全過才 docker buildx imagetools create 打正式 GHCR image tag vN（不重 build、index digest 不變）；Git tag vN 是 repo 上的另一個物件，圖上分開標" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1582" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;k1g_e：sync「3」出線距橢圓底邊過近。&lt;br&gt;c_d3：122px 框內文字折成 5 行。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1718" width="520" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p3d" name="13 契約 v2：驗收矩陣詳表"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1376" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約⑤ 驗收矩陣詳表（interface_spec §7.4；35 條，一列一情境；分組索引與 CI 流程見 p3c）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p3d_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p3d_pend" value="&lt;b&gt;本頁無待拍板&lt;/b&gt;&lt;br&gt;本頁只有 §7.4 逐條矩陣；缺任一不得出貨（§8-12）；已釋出 image／Release 資產／fixture 永不刪" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="65" as="geometry"/></mxCell><mxCell id="p3L6" value="驗收矩陣（§7.4；左右兩表接續；每列一個情境）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1560" height="914" as="geometry"/></mxCell><mxCell id="p3d_acc_h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="20" y="50" width="40" height="30" as="geometry"/></mxCell><mxCell id="p3d_acc_h1" value="情境" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="60" y="50" width="150" height="30" as="geometry"/></mxCell><mxCell id="p3d_acc_h2" value="驗什麼" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="210" y="50" width="560" height="30" as="geometry"/></mxCell><mxCell id="p3d_acc_r0c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="20" y="80" width="40" height="57" as="geometry"/></mxCell><mxCell id="p3d_acc_r0c1" value="已釋出版驅動候選" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L6"><mxGeometry x="60" y="80" width="150" height="57" as="geometry"/></mxCell><mxCell id="p3d_acc_r0c1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L6"><mxGeometry x="178" y="82" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3d_acc_r0c2" value="最低介面版以來每個已釋出 bootstrap.sh(r) + 引擎 image r 建 fixture → 第一行改為候選 C → sync（1 印 6-1）→ upgrade vendor_kit（1 印 6-2）→ sync 0 → 工具 recipe → upgrade 全 → 再 upgrade vendor_kit 0；禁由候選樹複製 fixture、禁 stub 引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="210" y="80" width="560" height="57" as="geometry"/></mxCell><mxCell id="p3d_acc_r1c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L6"><mxGeometry x="20" y="137" width="40" height="42" as="geometry"/></mxCell><mxCell id="p3d_acc_r1c1" value="最低環境 × 世代" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L6"><mxGeometry x="60" y="137" width="150" height="42" as="geometry"/></mxCell><mxCell id="p3d_acc_r1c1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L6"><mxGeometry x="178" y="139" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3d_acc_r1c2" value="每個歷史版本在最低環境（docker 19.03、just 1.33.0