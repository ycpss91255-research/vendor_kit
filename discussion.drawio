parent="1"><mxGeometry x="1128" y="1813" width="170" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1803" width="300" height="60" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1871" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1871" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1871" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1871" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1871" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1871" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1871" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1861" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bcg_lgx_tty" value="橙小標：問句無 tty／EOF 且無 -y → 1 + 6-4（Ctrl-C 中止、不記拒絕）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1260" y="1871" width="300" height="36" as="geometry"/></mxCell><mxCell id="p7bcg_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1911" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1957" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bcg_tk0" value="升引擎進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1991" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tv0" value=".tmp.upgrade.&amp;lt;id&amp;gt;.toml：改第一行之前建，記舊引擎 ref、目標引擎 ref、計畫 image ID、done／pending；啟動器 grep 其目標 ref 決定拉哪個引擎；新引擎重產薄殼完成後刪；未完成 → 可寫動詞先恢復（= 重跑 upgrade vendor_kit）、sync／update 印 6-33 結束 1、help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1991" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tk1" value="config.toml（install／uninstall）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2046" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tv1" value=".vendor_kit/config.toml（進 git）：schema = 1、[log] keep = 50、days = 30；install 建（含註解）＋ 基準版副本 baseline/vendor_kit/config.toml；升引擎時三方合併；uninstall 只在 hash == 副本時刪；缺檔或缺鍵 = 預設" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2046" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tk2" value="6-22（upgrade 逐檔問句）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2101" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_tv2" value="「&amp;lt;X&amp;gt; 換成新版？」／「你和新版都改了 &amp;lt;X&amp;gt;，要三方合併嗎？」／「要建 &amp;lt;X&amp;gt; 嗎」／「&amp;lt;X&amp;gt; 是二進位檔，要換成新版嗎？」；config.toml 三方合併也用它；-y 免問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2101" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_tk3" value="6-4（無 tty）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1991" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_tv3" value="需詢問但無 tty／EOF 且無 -y → 1：「需要確認但沒有終端可互動。請加 -y，或在終端執行。」；Ctrl-C 中止整個 apply 回 1、不套用、不記拒絕（declined 只記明確回答「否」）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1991" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_tk4" value="git merge-file --diff3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2031" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tv4" value="git 的三方合併指令；衝突時在檔內留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; vendor_kit:baseline ||||||| ======= &amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt;&amp;gt; 標記（我們自己的標籤，重入時靠它偵測）；回傳衝突數 → 結束碼 2（需人處理，橙）；多工具（Q27）兩者皆回 2 時訊息全部列出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2031" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcg_tk5" value="解析失敗（config.toml）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2086" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcg_tv5" value="合併結果解析失敗（TOML 不合法）→ 留原檔、不推基準版副本、metadata 記 conflicts → 結束碼 2；有衝突標記 → 仍替換並推基準版（重入時靠標記偵測）→ 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2086" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• s13gcq／se17same：結果相同分支待重新配置&lt;br&gt;• s13gy：「三方合併到暫存」缺失敗出邊到 s13qx 匯流；spec §1.2 upgrade 明定 git merge-file 的 I/O／執行錯誤 → 1（非 2），本頁只畫解析失敗與衝突兩種&lt;br&gt;• se17adn：「否：不替換；記 declined」標籤落在 x≈327–458、y≈542，而該邊垂直段在 x=420，線從「記 de|clined」字中間穿過&lt;br&gt;• se17gpx：「是：留原檔、不推基準版（記 conflicts）」標籤（y≈416）壓在該邊的水平段（y=416，x 400–610）上，垂直段從標籤左端起筆&lt;br&gt;• se17pnn：B 段「否：不建（記 declined）」標籤（y≈1305）壓在該邊水平段（y=1305，x 400–610）上&lt;br&gt;• fb_s13gw／fb_s13gb／fb_s13gnb：三條失敗匯流線的水平段分別與 se17adn（y=728）、se17gpx（y=796）、se17pnn（y=1460）同高共線，各成一條橫貫左右的線，讀不出左段是「否／解析失敗」、右段是「失敗」" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2142" width="520" height="237" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bccd" name="43 流程 v2：upgrade ── E(c) upgrade vendor_kit（2′）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1342" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── E(c) upgrade vendor_kit（2′）收尾 → 啟動器驗第一行 → 終點（§3.4、v2.15-7）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="64" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="64" width="200" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uE4" value="E(c)（2′）（承「E(c)（2″）」頁）：gen/.stamp → tools.just → 刪進度檔（刪前已讀舊引擎 ref）→ config.toml 衝突 → 2；換引擎 → 1 + 6-2；同引擎修復 → 1 + 6-2（文案分開）；失敗 → 啟動器：第一行未變 → 1 印原因；已改 → 1 + 6-2b" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="840" as="geometry"/></mxCell><mxCell id="uE4_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE4"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s13z0" value="來自「E(c)（2″）」頁：薄殼五檔已重產、config.toml 已處理（已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=53;spacingRight=53;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE4"><mxGeometry x="610" y="36" width="360" height="80" as="geometry"/></mxCell><mxCell id="s13b" value="寫 gen/.stamp（只記本引擎 ref）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE4"><mxGeometry x="610" y="136" width="360" height="40" as="geometry"/></mxCell><mxCell id="s13b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE4"><mxGeometry x="946" y="126" width="30" height="20" as="geometry"/></mxCell><mxCell id="s13bf" value="gen/.stamp（不進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE4"><mxGeometry x="1220" y="136" width="360" height="40" as="geometry"/></mxCell><mxCell id="s13c" value="重生 gen/tools.just（用本引擎的規則；mod? 行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE4"><mxGeometry x="610" y="196" width="360" height="40" as="geometry"/></mxCell><mxCell id="s13c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE4"><mxGeometry x="946" y="186" width="30" height="20" as="geometry"/></mxCell><mxCell id="s13cf" value="gen/tools.just（不進 git；mod? 行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent=