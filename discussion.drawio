;" vertex="1" parent="1"><mxGeometry x="1020" y="897" width="88" height="40" as="geometry"/></mxCell><mxCell id="p5x_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="897" width="170" height="40" as="geometry"/></mxCell><mxCell id="p5x_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="887" width="300" height="60" as="geometry"/></mxCell><mxCell id="p5x_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="220" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="955" width="120" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="955" width="160" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="955" width="100" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="955" width="130" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="870" y="955" width="180" height="36" as="geometry"/></mxCell><mxCell id="p5x_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1026" y="945" width="30" height="20" as="geometry"/></mxCell><mxCell id="p5x_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="995" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p5x_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1041" width="200" height="28" as="geometry"/></mxCell><mxCell id="p5x_tk0" value="--local &amp;lt;image tag 或 tar&amp;gt;（B1，依序互斥）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="150" height="86" as="geometry"/></mxCell><mxCell id="p5x_tv0" value="以 .tar 結尾 → 檔案路徑（必須存在，否則 1）；否則值含 / 且存在同名檔 → 1 + 6-37 消歧；否則 → image tag（含 / 但無同名檔的完整 ref 也是 tag 形）。tar 形：docker load 後由同名 .digest 旁檔取 index digest；tag 形：不讀 .digest、只 docker image inspect 本機 image ID；version.toml 仍寫正式 ref@digest（tag 形 = 專案已有那行或內嵌引擎 ref）；version.local.toml 在 install 成功後才寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1075" width="610" height="86" as="geometry"/></mxCell><mxCell id="p5x_tk1" value="GHCR／引擎 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1161" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5x_tv1" value="GHCR = GitHub 的容器倉庫；引擎 ref = version.toml 的 vendor_kit 版本鎖定行指到的引擎 image（ghcr.io/…/vendor_kit:vN@sha256:…）；已有 version.toml → 用該行、拉不到即失敗、不退回內嵌" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1161" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5x_tk2" value="docker image inspect／pull（啟動器）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1216" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5x_tv2" value="每次 docker run 前先 docker image inspect &amp;lt;ref&amp;gt;：本機有 → 不 pull（離線可用）；無 → docker pull；tag 形 --local 本機無此 image = 失敗、不得 pull；LABEL 帶介面版／最低介面版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1216" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5x_tk3" value="6-18（最低介面版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1075" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5x_tv3" value="引擎 image LABEL 的最低介面版高於 bootstrap.sh 的介面版 → 3 + 6-18「目前薄殼或引擎低於最低介面版 &amp;lt;最低介面版&amp;gt;。請以 bootstrap.sh 重建。」（零寫入；本機有 image → inspect LABEL 即檢查，沒有 → pull 後立即檢查，仍在任何寫入之前）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1075" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5x_tk4" value="6-16／6-23／6-28／6-35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1130" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5x_tv4" value="前置檢查訊息：6-16 不在 git repo 內（請先 git init）；6-23 just 版本不足（印安裝指令）；6-28 薄殼被改過，列差異不動；6-35 禁止巢狀（上層或下層已有 .vendor_kit/）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1130" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5x_tk5" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1170" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5x_tv5" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1170" width="610" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p5i" name="17 流程 v2：bootstrap.sh（1′）docker run install"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1364" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：bootstrap.sh（1′）docker run install（§2／§3、v2.13 P4／P5、v2.16-5）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="460" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="64" width="260" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1040" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="bA1" value="5a′ bootstrap.sh 中段（承「bootstrap.sh（1″）」頁：引擎 image 已在本機）：docker run &amp;lt;引擎&amp;gt; install 子流程 → 回 0 → 續「bootstrap.sh（2）」頁；回 3 → 3 原碼傳出（零寫入）；回 1 → 清半成品 → 需人處理（橙）或失敗（紅）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="886" as="geometry"/></mxCell><mxCell id="bA1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9e0" value="來自「bootstrap.sh（1″）」頁：引擎 image 已在本機、LABEL 最低介面版檢查通過（已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=47;spacingRight=47;spacingTop=15;spacingBottom=15;" vertex="1" parent="bA1"><mxGeometry x="330" y="36" width="320" height="102" as="geometry"/></mxCell><mxCell id="a9" value="docker run &amp;lt;引擎&amp;gt; install（-y 轉發；本機 image 直接 run，不 pull）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bA1"><mxGeometry x="340" y="276" width="300" height="48" as="geometry"/></mxCell><mxCell id="a9_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="616" y="266" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9e" value="執行 install 子流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bA1"><mxGeometry x="750" y="280" width="240" height="40" as="geometry"/></mxCell><mxCell id="a9f" value="install 寫入集合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="bA1"><mxGeometry x="1220" y="158" width="360" height="284" as="geometry"/></mxCell><mxCell id="a9f_0" value="薄殼五檔（含 log.sh）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="8" y="26" width="169" height="42" as="geometry"/></mxCell><mxCell id="a9f_1" value="version.toml 版本鎖定行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="183" y="26" width="169" height="42" as="geometry"/></mxCell><mxCell id="a9f_2" value="gen/.stamp（引擎 ref）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="8" y="74" width="169" height="42" as="geometry"/></mxCell><mxCell id="a9f_3" value="baseline/.gitkeep（VK 自產）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="183" y="74" width="169" height="42" as="geometry"/></mxCell><mxCell id="a9f_4" value="config.toml（預設值）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="8" y="122" width="169" height="57" as="geometry"/></mxCell><mxCell id="a9f_5" value="baseline/ vendor_kit/ config.toml（基準版副本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="183" y="122" width="169" height="57" as="geometry"/></mxCell><mxCell id="a9f_6" value="baseline/ .vendor_kit.toml（metadata）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="8" y="185" width="169" height="57" as="geometry"/></mxCell><mxCell id="a9f_7" value="根 justfile import 行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="183" y="185" width="169" height="57" as="geometry"/></mxCell><mxCell id="a9f_8" value="根 .dockerignore 四行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="a9f"><mxGeometry x="8" y="248" width="169" height="26" as="geometry"/></mxCell><mxCell id="a9q" value="install 回 0？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=55;spacingRight=55;spacingTop=20;spacingBottom=20;" vertex="1" parent="bA1"><mxGeometry x="380" y="472" width="220" height="81" as="geometry"/></mxCell><mxCell id="a9z" value="是：續「bootstrap.sh（2）」頁：--local 記錄 → 對每個 -t 呼叫 add（一個失敗即中止）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=35;spacingRight=35;spacingTop=15;spacingBottom=15;" vertex="1" parent="bA1"><mxGeometry x="750" y="462" width="240" height="102" as="geometry"/></mxCell><mxCell id="a9x3" value="3：install 回 3 原碼傳出（6-18 最低介面版；零寫入、無半成品）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=12;spacingBottom=12;" vertex="1" parent="bA1"><mxGeometry x="20" y="584" width="220" height="80" as="geometry"/></mxCell><mxCell id="a9x3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="216" y="574" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9q3" value="否 → install 回 3？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=55;spacingRight=55;spacingTop=20;spacingBottom=20;" vertex="1" parent="bA1"><mxGeometry x="380" y="584" width="220" height="81" as="geometry"/></mxCell><mxCell id="a9q3_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="576" y="574" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9c" value="否（回 1）：依 .tmp.install 進度檔清半成品（引擎寫入失敗時已自清；引擎異常結束由 bootstrap.sh 補清；log/ 保留；印「已清除半成品，紀錄在 .vendor_kit/log/bootstrap/&amp;lt;檔&amp;gt;」）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bA1"><mxGeometry x="340" y="685" width="300" height="94" as="geometry"/></mxCell><mxCell id="a9c_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="616" y="675" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9h" value="需人處理（6-4／6-28／6-35 等，附指令）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=75;spacingRight=75;spacingTop=20;spacingBottom=20;" vertex="1" parent="bA1"><mxGeometry x="340" y="799" width="300" height="81" as="geometry"/></mxCell><mxCell id="a9h_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="616" y="789" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9hx" value="1：install 需人處理 → 依指令處理後再跑 bootstrap.sh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=12;spacingBottom=12;" vertex="1" parent="bA1"><mxGeometry x="20" y="800" width="220" height="80" as="geometry"/></mxCell><mxCell id="a9hx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="216" y="790" width="30" height="20" as="geometry"/></mxCell><mxCell id="a9x" value="1：install 失敗（寫入／驗證），已清半成品" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=26;spacingRight=26;spacingTop=12;spacingBottom=12;" vertex="1" parent="bA1"><mxGeometry x="1020" y="800" width="180" height="80" as="geometry"/></mxCell><mxCell id="a9x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bA1"><mxGeometry x="1176" y="790" width="30" height="20" as="geometry"/></mxCell><mxCell id="ae12e" value="" style="edgeStyle=orth