ry"/></mxCell><mxCell id="p0_t3b_r8c0" value="&lt;b&gt;進度檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1644" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3b_r8c1" value="progress file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1644" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3b_r8c2" value="記錄可寫動詞未完成狀態的 VK 檔。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="1644" width="1200" height="28" as="geometry"/></mxCell><mxCell id="p0_s4c" value="版本與來源" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1686" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t3c_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1718" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3c_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1718" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3c_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="1718" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p0_t3c_r0c0" value="&lt;b&gt;版本鎖定行&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1748" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3c_r0c1" value="lock version line" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1748" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3c_r0c2" value="version.toml 中的 TOML 項目。&lt;br&gt;• 內容：把引擎或工具名稱對應到確切 image 版本。&lt;br&gt;• 作用：決定引擎或工具使用的鎖定版本。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="1748" width="1200" height="64" as="geometry"/></mxCell><mxCell id="p0_t3c_r1c0" value="&lt;b&gt;本機覆寫&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1812" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3c_r1c1" value="local override" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1812" width="190" height="64" as="geometry"/></mxCell><mxCell id="p0_t3c_r1c2" value="讓引擎或工具暫時改用本機開發來源的 VK 項目。&lt;br&gt;• 內容：記錄本機開發來源。&lt;br&gt;• 作用：有本機覆寫時，優先於版本鎖定行。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="400" y="1812" width="1200" height="64" as="geometry"/></mxCell><mxCell id="p0_s4d" value="初始檔與合併" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1890" width="1580" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_h0" value="中文名" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="1922" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3d_h1" value="英文" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="210" y="1922" width="190" height="30" as="geometry"/></mxCell><mxCell id="p0_t3d_h2" value="定義" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="400" y="1922" width="1200" height="30" as="geometry"/></mxCell><mxCell id="p0_t3d_r0c0" value="&lt;b&gt;初始檔&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="20" y="1952" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r0c1" value="init file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="210" y="1952" width="190" height="28" as="geometry"/></mxCell><mxCell id="p0_t3d_r0c2" value="由工具提供、VK 接入 repo 後交由使用者維護的 repo 檔。"