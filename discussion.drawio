ddle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="650" y="1117" width="76" height="20" as="geometry"/></mxCell><mxCell id="p5cc_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1651" width="200" height="60" as="geometry"/></mxCell><mxCell id="p5cc_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1651" width="140" height="64" as="geometry"/></mxCell><mxCell id="p5cc_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1659" width="140" height="44" as="geometry"/></mxCell><mxCell id="p5cc_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1653" width="190" height="56" as="geometry"/></mxCell><mxCell id="p5cc_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1653" width="210" height="56" as="geometry"/></mxCell><mxCell id="p5cc_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1661" width="88" height="40" as="geometry"/></mxCell><mxCell id="p5cc_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1661" width="170" height="40" as="geometry"/></mxCell><mxCell id="p5cc_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1651" width="300" height="60" as="geometry"/></mxCell><mxCell id="p5cc_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1719" width="220" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1719" width="120" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1719" width="170" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1719" width="160" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1719" width="100" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1719" width="130" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1719" width="180" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1709" width="30" height="20" as="geometry"/></mxCell><mxCell id="p5cc_lgx_tty" value="橙小標：問句無 tty／EOF 且無 -y → 1 + 6-4（Ctrl-C 中止、不記拒絕）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1260" y="1719" width="300" height="36" as="geometry"/></mxCell><mxCell id="p5cc_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1759" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p5cc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1805" width="200" height="28" as="geometry"/></mxCell><mxCell id="p5cc_tk0" value="install 進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1839" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tv0" value=".tmp.install.&amp;lt;id&amp;gt;.toml：拿鎖、比對薄殼之後、第一個寫入（含暫存檔）之前建；第一次也建 = 「不留半成品」的清除清單；最後一步（install（2）頁）刪；未完成 → 下次可寫動詞先恢復" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1839" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tk1" value="just／recipe／import／default" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1879" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5cc_tv1" value="just = 跑指令的工具（像 make）；recipe = justfile 裡的一條指令；import = 根 justfile 載入 .vendor_kit/entry.just 的那一行；新建根 justfile 另有 default recipe（兩行；寫成一行是語法錯誤）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1879" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5cc_tk2" value="6-20／6-34（問後才加）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1934" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tv2" value="6-20「要加這一行嗎」（根 justfile import 行）；6-34「要加這幾行嗎」（根 .dockerignore，只列缺的行）；-y 免問；拒絕 → 不動、印手動加的指示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1934" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tk3" value="逐行辨識（v2.16-7）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1839" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tv3" value=".dockerignore 四行逐行看已在／缺：全在 → 跳過；缺 → 只問、只加缺的行，baseline/.vendor_kit.toml lines 只記實際新增的行（uninstall 只刪這些）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1839" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tk4" value="6-4（無 tty）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1879" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tv4" value="需詢問但無 tty／EOF 且無 -y → 1：「需要確認但沒有終端可互動。請加 -y，或在終端執行。」；Ctrl-C 中止整個 apply 回 1、不套用、不記拒絕（declined 只記明確回答「否」）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1879" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cc_tk5" value="config.toml（install／uninstall）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1919" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5cc_tv5" value=".vendor_kit/config.toml（進 git）：schema = 1、[log] keep = 50、days = 30；install 建（含註解）＋ 基準版副本 baseline/vendor_kit/config.toml；升引擎時三方合併；uninstall 只在 hash == 副本時刪；缺檔或缺鍵 = 預設" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1919" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• i7：「無：建 justfile（四行）」是寫入格，缺「失敗」出邊到共通匯流 ix（同頁 i11／igy／igm／idl 都有）&lt;br&gt;• ign：「無：建 .dockerignore（四行）」是寫入格，缺「失敗」出邊到共通匯流 ix&lt;br&gt;• ie20z：新建 .dockerignore（ign）後直接接 idl 刪進度檔，沒經 igm 把新增的行記到 baseline/.vendor_kit.toml；uninstall（2）只刪「紀錄相同的行」，沒紀錄就永遠刪不掉&lt;br&gt;• ix：紅終點只寫「明列已完成／未完成」，沒分「第一次安裝 → 依進度檔移除已寫的檔、不留半成品」（install（1″）i4wq、bootstrap（1′）a9c、spec §1.2 都有分）&lt;br&gt;• ie13／ie20z：兩條流程線都繞到 x=1610 走失敗匯流的同一條垂直線，並與 fb_i11（y=801）、fb_igm（y=1423）的水平段反向重疊，分不清流程／失敗與來源" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1990" width="520" height="221" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p5b" name="23 流程 v2：add（1）resolve → docker"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2399" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：add &amp;lt;repo&amp;gt;（1）執行紀錄 → --local → 引擎 resolve（§2／§5、v2.5 §2／§3／§5、v2.16）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" widt