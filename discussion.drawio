style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L4"><mxGeometry x="990" y="694" width="540" height="42" as="geometry"/></mxCell><mxCell id="p3_lbl_r1c0" value="引擎 image（build 時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="790" y="736" width="200" height="26" as="geometry"/></mxCell><mxCell id="p3_lbl_r1c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="958" y="738" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_lbl_r1c1" value="…=1、….protocol=&amp;lt;floor_P&amp;gt;-&amp;lt;current_P&amp;gt;、….schema=&amp;lt;N&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L4"><mxGeometry x="990" y="736" width="540" height="26" as="geometry"/></mxCell><mxCell id="p3_lbl_r2c0" value="下游 image（build 時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="790" y="762" width="200" height="26" as="geometry"/></mxCell><mxCell id="p3_lbl_r2c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="958" y="764" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_lbl_r2c1" value="…=1（Dockerfile.dist 必含）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L4"><mxGeometry x="990" y="762" width="540" height="26" as="geometry"/></mxCell><mxCell id="p3_lbl_r3c0" value="prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="790" y="788" width="200" height="42" as="geometry"/></mxCell><mxCell id="p3_lbl_r3c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="958" y="790" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_lbl_r3c1" value="依 label 掃四類資源；image 只刪帶 label 且本專案未引用者；vendor_kit 不建 network／volume（驗收差集為空，故意留的也要能刪）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p3L4"><mxGeometry x="990" y="788" width="540" height="42" as="geometry"/></mxCell><mxCell id="p3_syncr" value="&lt;b&gt;sync 自動前置：工具契約（F1 定案）&lt;/b&gt;：每個 dist/just/&amp;lt;ns&amp;gt;.just 必含上列私有 _sync（本體逐字、行首真 tab；justfile_directory() 在模組內 = 專案根；用 quote() 不直接插字串）；工具每個公開 recipe 相依它（例 build: _sync；例外集合：無）；vendor_kit 自身動詞不前置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="20" y="964" width="750" height="77" as="geometry"/></mxCell><mxCell id="p3_syncr_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="738" y="966" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_syncl" value="&lt;b&gt;sync 自動前置：lint 與限制&lt;/b&gt;：check.sh --dist 以 just --dump --dump-format json 檢查：_sync 存在、私有、本體逐字相符、每個公開 recipe 的 dependencies 含 _sync。限制（契約明寫）：just 在執行前已載入所有模組，同一次呼叫內看不到 sync 重建後的新 recipe；cache 缺檔時 mod? 讓 just vendor_kit sync 仍可進入；1.33.0 fixture 通過才算結案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="790" y="964" width="750" height="77" as="geometry"/></mxCell><mxCell id="p3_syncl_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1508" y="966" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_con" value="&lt;b&gt;工具契約（初始檔與 recipe）&lt;/b&gt;：初始檔只能引用穩定入口 just &amp;lt;ns&amp;gt; …、.vendor_kit/ci/check.sh、.vendor_kit/entry.just、.vendor_kit/version.toml；不得寫死 cache 內部路徑（Q14）；rename／格式變更不得以 copy/append 假裝完成；工具的 build 若以專案根當 context，依賴 install 加進根 .dockerignore 的排除，不得再以其他方式繞過 .vendor_kit/；dist 可執行性是下游 repo 責任（check.sh --dist + 自己的測試）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="20" y="1055" width="750" height="108" as="geometry"/></mxCell><mxCell id="p3_con_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="738" y="1057" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_off" value="&lt;b&gt;離線包（Release 資產；Q26）&lt;/b&gt;：每個平台 tar（docker save）旁附同名 .digest 旁檔：&amp;lt;name&amp;gt;.tar + &amp;lt;name&amp;gt;.tar.digest，內容一行 sha256:&amp;lt;hex64&amp;gt; = 該 image 的正式多架構 index digest；另附 local_bootstrap.sh 便利包裝（偵測架構、挑 tar、exec bootstrap.sh --local；非契約、不另定介面）；bootstrap.sh --local &amp;lt;tar&amp;gt;／add --local &amp;lt;tar&amp;gt;：docker load 後讀旁檔寫 version.toml（正式 ref@digest），metadata 記 local_image_id；旁檔缺 → 1。離線可用：啟動器先 docker image inspect，本機有就不 pull；斷網 + 已有 image → sync／build 必須成功；斷網 + 無 image → 1 印 6-31 不 hang；離線 upgrade 不支援" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p3L4"><mxGeometry x="790" y="1055" width="750" height="108" as="geometry"/></mxCell><mxCell id="p3_off_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p3L4"><mxGeometry x="1508" y="1057" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_lg0" value="紫：image（引擎與工具）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1322" width="170" height="40" as="geometry"/></mxCell><mxCell id="p3_lg1" value="等寬字：檔案內容範例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="230" y="1322" width="170" height="40" as="geometry"/></mxCell><mxCell id="p3_lg2" value="淺橘底：規則／摘要（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="1322" width="190" height="40" as="geometry"/></mxCell><mxCell id="p3_lg3" value="灰底：表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="630" y="1322" width="110" height="40" as="geometry"/></mxCell><mxCell id="p3_lg4" value="淺灰底：分組（無狀態意義）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1322" width="200" height="40" as="geometry"/></mxCell><mxCell id="p3_lg5" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="1322" width="200" height="40" as="geometry"/></mxCell><mxCell id="p3_lg5_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1148" y="1324" width="30" height="20" as="geometry"/></mxCell><mxCell id="p3_lgt" value="紫 = image（工具／引擎）&lt;br&gt;淺灰底容器 = 契約③ 全部" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1200" y="1312" width="300" height="60" as="geometry"/></mxCell><mxCell id="p3_lg6" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1388" width="220" height="40" as="geometry"/></mxCell><mxCell id="p3_th" value="本頁名詞（只列本頁用到的）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1444" width="300" height="28" as="geometry"/></mxCell><mxCell id="p3_tk0" value="strategy = &quot;append&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1478" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3_tv0" value="init.toml 每個 [[file]] 的 strategy 欄位（copy | append，預設 copy）；append（.gitignore 類）：檔不存在 → 建；存在 → 問後把幾行加進去，實際插入的行記在 metadata lines；upgrade／remove 只對可辨識的上次插入行提修改（CRLF／LF 等價、其餘精確）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1478" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3_tk1" value="CRLF／LF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1533" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3_tv1" value="兩種換行符號（Windows 用 CRLF、Linux 用 LF）；比對 append 行時視為等價，其餘字元要精確相同；dist 文字檔一律 LF [#29]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1533" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3_tk2" value="_sync recipe（F1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1573" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3_tv2" value="每個 dist/just/&amp;lt;ns&amp;gt;.just 必含的私有 recipe（逐字：[private] / _sync: / \tcd {{quote(justfile_directory())}} &amp;&amp; just vendor_kit sync）；工具每個公開 recipe 相依它（build: _sync）；vendor_kit 自身動詞不前置；check.sh --dist 以 just --dump 檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1573" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3_tk3" value="just 的兩個目錄函式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1628" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3_tv3" value="justfile_directory()（該 justfile 所在目錄；模組內 = 專案根，工具 recipe 用 cd {{quote(justfile_directory())}} 回專案根）與 invocation_directory()（你打指令時所在目錄）；vendor_kit recipe 用兩者相等檢查「只准在專案根執行」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1628" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3_tk4" value="check.sh --dist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1478" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3_tv4" value="同一支腳本的供應端模式：在下游 repo 的 CI 驗 dist 佈局、init.toml、dest 規則、無 symlink／CRLF、just 1.33.0 可解析、_sync lint、LABEL、image 可展開、兩平台一致" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1478" width="610" height="40" as="geometry"/></mxCell><mxCell id="p3_tk5" value=".digest 旁檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1518" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3_tv5" value="&amp;lt;name&amp;gt;.tar 旁的 &amp;lt;name&amp;gt;.tar.digest：一行 sha256:&amp;lt;hex64&amp;gt; = 該 image 的正式多架構 index digest（同名旁檔須同在，缺 → 1 + 6-24 主機錯誤分類）；--local 用它寫 version.toml 正式 ref@digest（不寫本機 tag），metadata 記 local_image_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1518" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3_tk6" value="離線可用（Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1573" width="150" height="55" as="geometry"/></mxCell><mxCell id="p3_tv6" value="啟動器一律先 docker image inspect：本機有 → 不 pull（不用 --pull never）；斷網 + 本機已有 image → sync／build 必須成功；斷網 + 無 image → docker pull 失敗 → 1 + 6-24／6-31 在 --timeout 內結束、不 hang；離線 upgrade 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1573" width="610" height="55" as="geometry"/></mxCell><mxCell id="p3_tk7" value="local_bootstrap.sh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1628" width="150" height="40" as="geometry"/></mxCell><mxCell id="p3_tv7" value="離線包內附的便利包裝（非契約、不另定介面）：偵測 daemon 架構 → 挑該平台引擎 tar → exec ./bootstrap.sh --local &amp;lt;tar&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1628" width="610" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p3b" name="10 契約 v2：啟動器 ↔ 引擎契約④"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2379" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約④ 啟動器 ↔ 引擎（interface_spec §3、§5；resolve → 主機 docker → apply；主機只需 docker + sh + just）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p3b_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p3b_pend" value="規則框逐條對應 interface_spec §3、§5；vk-resolve/1 必須先收完整份並驗文法，才能動 docker。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="65" as="geometry"/></mxCell><mxCell id="p3L2" value="契約④ 啟動器 ↔ 引擎（每格一件事；⓪ 執行紀錄 → ① 啟動器 grep → ② resolve → ③ 主機 docker → ④ apply；規則框 = §3、§5 逐條；白 = 啟動器、藍 = 引擎）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1560" height="1678.5" as="geometry"/></mxCell><mxCell id="s0a" value="⓪ 產 trace_id&lt;br&gt;（uuid；缺則&lt;br&gt;od urandom）" style="rounded=1;whiteSpace=wrap;