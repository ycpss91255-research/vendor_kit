ontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="770" y="755" width="770" height="30" as="geometry"/></mxCell><mxCell id="p1C_ex_r0c0" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="785" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r0c1" value="成功（含 warn）；add 已接入完成、remove 未接、undev 未啟用、upgrade vendor_kit 無新版且薄殼相符皆 0 + 提示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="785" width="700" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r0c2" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="770" y="785" width="770" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r1c0" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="827" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r1c1" value="一般失敗、需人處理／重跑；工具層動詞回 1 時 version.toml 不動" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="827" width="700" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r1c2" value="自身升級：已改 version.toml 第一行後回 1（明列例外）；upgrade vendor_kit 重產薄殼後回 1 要求 commit 並重跑（6-2）；sync 薄殼不符回 1（6-1）；印記不符、薄殼被改（6-28）——既定回 1 的情境維持 1，不因提示含 upgrade 而改 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="770" y="827" width="770" height="42" as="geometry"/></mxCell><mxCell id="p1C_ex_r2c0" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="869" width="50" height="26" as="geometry"/></mxCell><mxCell id="p1C_ex_r2c1" value="合併衝突（留 &amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt;&amp;lt; vendor_kit:baseline 標記、印檔名、基準版仍推到新版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="869" width="700" height="26" as="geometry"/></mxCell><mxCell id="p1C_ex_r2c2" value="update --exit-code 有新版回 2；合併結果 TOML／just 解析失敗 → 2 留原檔、該檔基準版不推、記入 conflicts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="770" y="869" width="770" height="26" as="geometry"/></mxCell><mxCell id="p1C_ex_r3c0" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="895" width="50" height="57" as="geometry"/></mxCell><mxCell id="p1C_ex_r3c1" value="現有薄殼／檔案／引擎的組合需先升級或退回才能繼續，且零寫入；「舊」一律以介面版／檔案版比，不以 SemVer；網路／認證／不存在 → 1，不得偽裝成 3；最低介面版檢查在任何上網之前" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p1C"><mxGeometry x="70" y="895" width="700" height="57" as="geometry"/></mxCell><mxCell id="p1C_ex_r3c1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1C"><mxGeometry x="738" y="897" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1C_ex_r3c2" value="(a) 薄殼 P &amp;lt; 引擎 floor_P → 6-18；(b) 引擎讀到 schema &amp;gt; 支援上限 → 6-19；(c) upgrade vendor_kit@&amp;lt;舊版&amp;gt; 目標引擎介面版／檔案版低於現有檔 → 6-10；(d) dev vendor_kit -i 的引擎介面版／檔案版低於薄殼首行者要重產 進 git 的薄殼 → 拒絕；(e) 舊薄殼跑新 major 一般動詞 → 6-36 提示先 upgrade vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="770" y="895" width="770" height="57" as="geometry"/></mxCell><mxCell id="p1C_multi" value="&lt;b&gt;多工具彙總（Q27）&lt;/b&gt;：不帶 repo 的動詞做得完的做完（先完整預檢，任一預檢失敗才整體不動），最後回最需要處理的碼：失敗 1 &amp;gt; 衝突 2 &amp;gt; 有新版 2 &amp;gt; 0；update 同時遇 1 與 2 → 1；訊息全列；舊薄殼對未知碼原樣傳出、不吞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p1C"><mxGeometry x="20" y="966" width="1520" height="30" as="geometry"/></mxCell><mxCell id="p1C_multi_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p1C"><mxGeometry x="1508" y="968" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1C_msg_l" value="訊息文字清單（§6 逐字；每句含可直接複製的指令）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1010" width="900" height="28" as="geometry"/></mxCell><mxCell id="p1C_mL_h0" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1042" width="50" height="30" as="geometry"/></mxCell><mxCell id="p1C_mL_h1" value="時機" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1042" width="170" height="30" as="geometry"/></mxCell><mxCell id="p1C_mL_h2" value="文字（逐字；&amp;lt;…&amp;gt; 占位符）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1042" width="530" height="30" as="geometry"/></mxCell><mxCell id="p1C_mL_r0c0" value="6-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1072" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r0c1" value="sync：gen/.stamp 第一行 ≠ 引擎 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1072" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r0c2" value="vendor_kit 已更新 &amp;lt;vX&amp;gt; → &amp;lt;vY&amp;gt;，請執行：just vendor_kit upgrade vendor_kit（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1072" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r1c0" value="6-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1114" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r1c1" value="upgrade vendor_kit 重產薄殼後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1114" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r1c2" value="已升級引擎 &amp;lt;vX&amp;gt; → &amp;lt;vY&amp;gt; 並重產薄殼，請 commit .vendor_kit/ 並再跑原指令（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1114" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r2c0" value="6-2b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1156" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r2c1" value="第一行已改但未重產／第二次又變" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1156" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r2c2" value="引擎版本已鎖定為 &amp;lt;vY&amp;gt;，但薄殼尚未重產；請排除上述錯誤後執行：just vendor_kit upgrade vendor_kit（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1156" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r3c0" value="6-3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1198" width="50" height="57" as="geometry"/></mxCell><mxCell id="p1C_mL_r3c1" value="update／upgrade／add 無 registry 憑證" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1198" width="170" height="57" as="geometry"/></mxCell><mxCell id="p1C_mL_r3c2" value="無法列舉 &amp;lt;repo&amp;gt; 的版本：需要 registry 讀取權限。可設定 VENDOR_KIT_REGISTRY_TOKEN（或 VENDOR_KIT_REGISTRY_TOKEN_FILE），或直接指定版本：just vendor_kit upgrade &amp;lt;repo&amp;gt;@&amp;lt;tag&amp;gt;（拉取使用主機 docker 認證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1198" width="530" height="57" as="geometry"/></mxCell><mxCell id="p1C_mL_r4c0" value="6-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="20" y="1255" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r4c1" value="需詢問但無 tty／EOF 且無 -y" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="70" y="1255" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mL_r4c2" value="需要確認但沒有終端可互動。請加 -y，或在終端執行。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="240" y="1255" width="530" height="42" as="geometry"/></mxCell><mx