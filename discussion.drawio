 edge="1" parent="1" source="o8q" target="o8k"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe12kf" value="刪" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8k" target="o8kf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe14" value="寫" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o9" target="o9f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o9" target="o9z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="oe13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o8k" target="o9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="951"/><mxPoint x="490" y="951"/></Array></mxGeometry></mxCell><mxCell id="p16i_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1116" width="200" height="60" as="geometry"/></mxCell><mxCell id="p16i_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1116" width="140" height="64" as="geometry"/></mxCell><mxCell id="p16i_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1124" width="150" height="44" as="geometry"/></mxCell><mxCell id="p16i_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1118" width="210" height="56" as="geometry"/></mxCell><mxCell id="p16i_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1118" width="200" height="56" as="geometry"/></mxCell><mxCell id="p16i_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1126" width="100" height="40" as="geometry"/></mxCell><mxCell id="p16i_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1126" width="170" height="40" as="geometry"/></mxCell><mxCell id="p16i_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1116" width="260" height="60" as="geometry"/></mxCell><mxCell id="p16i_lgx_entry" value="白虛線橢圓：跨頁入口／出口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=36;spacingRight=36;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1184" width="250" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1184" width="120" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="450" y="1184" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_sub" value="藍：引擎做（容器內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="1184" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="830" y="1184" width="170" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1020" y="1184" width="200" height="36" as="geometry"/></mxCell><mxCell id="p16i_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1196" y="1174" width="30" height="20" as="geometry"/></mxCell><mxCell id="p16i_lgx_conv1" value="圖例約定①：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（每個結束碼都寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1228" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16i_lgx_conv2" value="圖例約定②：每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start（失敗 → 1 + 6-38、不做任何動作）、結束寫 engine_exit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1254" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p16i_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1286" width="200" height="28" as="geometry"/></mxCell><mxCell id="p16i_tk0" value="離線包（#27、Q26）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16i_tv0" value="Release 資產 vendor_kit-vN-local.tar.gz：bootstrap.sh、各平台 docker save 的引擎 tar + 同名 .digest 旁檔，另附 local_bootstrap.sh 便利包裝；只含引擎、不含任何工具 tar；在有網路的機器下載後帶到離線機；只涵蓋 install／add --local，離線 upgrade 不支援" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1320" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16i_tk1" value=".digest 旁檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1375" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16i_tv1" value="&amp;lt;name&amp;gt;.tar 旁的 &amp;lt;name&amp;gt;.tar.digest：一行 sha256:&amp;lt;hex64&amp;gt; = 該 image 的正式多架構 index digest（同名旁檔須同在，缺 → 1 + 6-24 主機錯誤分類）；--local 用它寫 version.toml 正式 ref@digest（不寫本機 tag），metadata 記 local_image_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1375" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16i_tk2" value="image ID 記錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16i_tv2" value="docker load 後的 image 只有 tag、沒有 RepoDigests；docker image inspect --format &#x27;{{.Id}}&#x27; 取 image ID：引擎的本機覆寫記 version.local.toml vendor_kit_image_id、工具記 metadata local_image_id（image ID ↔ index digest 對照，供離線驗證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1430" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16i_tk3" value="baseline/.gitkeep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1485" width="150" height="55" as="geometry"/></mxCell><mxCell id="p16i_tv3" value="VK 自產的進 git 空檔：git 不追蹤空目錄，所以 baseline/ 靠它進 git；install 建、uninstall 刪、hash 固定為空檔（§4.0；v2.15-14）；工具的 metadata 由 add 才建（baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml 兼作該工具目錄的佔位）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1485" width="610" height="55" as="geometry"/></mxCell><mxCell id="p16i_tk4" value="install 進度檔（v2.13 P5）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1320" width="150" height="40" as="geometry"/></mxCell><mxCell id="p16i_tv4" value="第一次 install 也在第一個寫入前建 .tmp.install.&amp;lt;id&amp;gt;.toml：兼「不留半成品」的清除清單，失敗依它移除已寫的檔（log/ 保留）、成功後刪；修復型同" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1320" width="610" height="40" as="geometry"/></mxCell><mxCell id="p16i_tk5" value="6-N 訊息編號" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1360" width="150" height="71" as="geometry"/></mxCell><mxCell id="p16i_tv5" value="interface_spec §6 的逐字訊息清單編號（每句含可直接複製的指令）：6-3 無 registry 憑證、6-4 無 tty、6-12 指紋不同、6-15 update 末行、6-16 非 git repo、6-23 just 太舊、6-26 flock 逾時、6-27 未恢復、6-30 vk-resolve 不合、6-31 pull 逾時、6-32 prune 問句、6-33 未完成交易、6-37 --local 值歧義、6-38 log 寫不進…" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1360" width="610" height="71" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;o8j：前置的 .tmp.install 半成品清除流程未畫。&lt;br&gt;oe12kf／oe11f：短箭頭標籤擁擠。&lt;br&gt;o8k：刪進度檔無失敗出邊（lint write-fail-edge）。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1479" width="520" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p16c" name="64 流程 v2：離線包（2）add --local 逐工具"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="2080" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：離線包（2）── 另備工具 tar → add --local 逐工具（Q26、§4.8、§7.4-16）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q26、v2.6-1、v2.7-1／-2、v2.8-4／-5、v2.13 P4、v2.15-2／-14／-17、v2.16-4、interface_spec §1.2、§4.8、§7.4-16／17）：契約入口 = bootstrap.sh --local &amp;lt;引擎 tar&amp;gt;，只涉及引擎（local_bootstrap.sh 非契約）；先驗 git／just 再建執行紀錄；--local 依序判別（.tar 結尾 → 檔案；否則含 / 且有同名檔 → 6-37；否則 tag）；最低介面版檢查在起容器之前（斷網也回 3）；tar 附同名 .digest；install 第一個寫入前建 .tmp.install；version.toml 寫正式 ref@digest；離線 upgrade 不支援。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="116" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者（離線機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="230" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="136" width="400" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="docker daemon" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="710" y="136" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="970" y="136" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1310" y="136" width="280" height="28" as="geometry"/></mxCell><mxCell id="bO1b" value="離線接工具（v2.8-5、v2.10-3）：另備工具 tar → 每工具各跑一次 add &amp;lt;repo&amp;gt; --local &amp;lt;tar&amp;gt;：執行紀錄 → 驗 .tar → load → .digest → image ID → resolve（0 且文法合）→ 續（2′）create／cp → apply" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1590" height="1315" as="geometry"/></mxCell><mxCell id="bO1b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1b"><mxGeometry x="1546" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="oo0" value="來自「離線包（1）」頁：install 完成（引擎可離線跑）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=34;spacingRight=34;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1b"><mxGeometry x="20" y="36" width="230" height="80" as="geometry"/></mxCell><mxCell id="oo1" value="有網路的機器下載工具 tar + 同名 .tar.digest（下游 repo 提供；不在 vendor_kit 離線包內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="20" y="138" width="230" height="57" as="geometry"/></mxCell><mxCell id="oo1n" value="已定（v2.8-5）：離線包只含引擎；離線接工具 = 另備工具 tar（下游 repo 的 docker save + .digest），逐工具 add --local；離線 upgrade 不支援" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="bO1b"><mxGeometry x="1290" y="130" width="280" height="73" as="geometry"/></mxCell><mxCell id="oo1b" value="帶到離線機；之後每個工具各跑一次（一次一個）↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="20" y="217" width="230" height="42" as="geometry"/></mxCell><mxCell id="o10" value="just vendor_kit add &amp;lt;repo&amp;gt; --local &amp;lt;工具 tar&amp;gt; [--source &amp;lt;image&amp;gt;] [-y] [--dry-run] [--timeout &amp;lt;秒&amp;gt;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="20" y="273" width="230" height="73" as="geometry"/></mxCell><mxCell id="o10s" value="建執行紀錄 log/add/&amp;lt;ts&amp;gt;-&amp;lt;id8&amp;gt;.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="270" y="290" width="400" height="40" as="geometry"/></mxCell><mxCell id="o10s_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1b"><mxGeometry x="646" y="280" width="30" height="20" as="geometry"/></mxCell><mxCell id="o10sx" value="1 + 6-38：執行紀錄建不了／寫不進（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=8;spacingBottom=8;" vertex="1" parent="bO1b"><mxGeometry x="20" y="360" width="230" height="58" as="geometry"/></mxCell><mxCell id="o10sx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1b"><mxGeometry x="226" y="350" width="30" height="20" as="geometry"/></mxCell><mxCell id="o10s2" value="寫 launcher_start（完整原始 argv）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="270" y="369" width="400" height="40" as="geometry"/></mxCell><mxCell id="o10s2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bO1b"><mxGeometry x="646" y="359" width="30" height="20" as="geometry"/></mxCell><mxCell id="o10qx" value="否 → 1 + 6-24 分句：add --local 只接受存在的 .tar 檔：&amp;lt;v&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1b"><mxGeometry x="20" y="432" width="230" height="80" as="geometry"/></mxCell><mxCell id="o10q" value="值是存在的 .tar 檔？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=75;spacingRight=75;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1b"><mxGeometry x="270" y="447" width="300" height="50" as="geometry"/></mxCell><mxCell id="o10a" value="是：docker load &amp;lt; &amp;lt;工具 tar&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="270" y="526" width="400" height="40" as="geometry"/></mxCell><mxCell id="o10d" value="本機 image &amp;lt;repo&amp;gt;-dist:&amp;lt;tag&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="bO1b"><mxGeometry x="690" y="526" width="240" height="40" as="geometry"/></mxCell><mxCell id="o10bx" value="否 → 1 + 6-24（主機錯誤）：同名 .tar.digest 旁檔缺" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=34;spacingRight=34;spacingTop=12;spacingBottom=12;" vertex="1" parent="bO1b"><mxGeometry x="20" y="580" width="230" height="80" as="geometry"/></mxCell><mxCell id="o10bq" value="同名 .tar.digest 存在？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=75;spacingRight=75;spacingTop=20;spacingBottom=20;" vertex="1" parent="bO1b"><mxGeometry x="270" y="580" width="300" height="81" as="geometry"/></mxCell><mxCell id="o10bq_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spaci