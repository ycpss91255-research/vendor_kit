="1612"/><mxPoint x="1610" y="1612"/><mxPoint x="1610" y="1748"/><mxPoint x="1460" y="1748"/></Array></mxGeometry></mxCell><mxCell id="p7bd_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1872" width="200" height="60" as="geometry"/></mxCell><mxCell id="p7bd_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1872" width="140" height="64" as="geometry"/></mxCell><mxCell id="p7bd_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1880" width="140" height="44" as="geometry"/></mxCell><mxCell id="p7bd_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1874" width="190" height="56" as="geometry"/></mxCell><mxCell id="p7bd_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1874" width="210" height="56" as="geometry"/></mxCell><mxCell id="p7bd_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1882" width="88" height="40" as="geometry"/></mxCell><mxCell id="p7bd_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1882" width="170" height="40" as="geometry"/></mxCell><mxCell id="p7bd_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1872" width="300" height="60" as="geometry"/></mxCell><mxCell id="p7bd_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1940" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1940" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1940" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="1940" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="1940" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="1940" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="1940" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bd_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="1930" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bd_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1980" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bd_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2026" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bd_tk0" value="回退／git revert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2060" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tv0" value="git revert = 產生一個反向 commit 把那次升級（version.toml、初始檔、基準版同一 commit）整組退回；下次 just 的 sync 看印記 ≠ version.toml → 把 cache/&amp;lt;repo&amp;gt;/ 換回舊版、重生 tools.just" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2060" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tk1" value="6-26（flock 逾時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2115" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tv1" value="apply 拿專案目錄鎖 60 秒未釋放 → 1「專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）…重試，或設 VENDOR_KIT_NO_LOCK=1」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2115" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tk2" value="原 argv 與計畫一致" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2155" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tv2" value="apply 讀 /dist/vk-resolve（啟動器把 resolve 的 stdout 整份存成 .tmp.dist.&amp;lt;id&amp;gt;/vk-resolve 掛入）：重算指紋 ≠ 計畫的 fingerprint → 1 + 6-12；本次 argv 與計畫不一致 → 1；apply 不重新選最新版（§3.2）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2155" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tk3" value="6-12（指紋不同）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2210" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tv3" value="apply 拿鎖後重驗指紋不同（中間有人改了）→ 1：「專案狀態在執行期間變動，未寫入任何檔。請重跑：just vendor_kit &amp;lt;verb&amp;gt; …」；原 argv 與計畫不一致也 → 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2210" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tk4" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2060" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tv4" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2060" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bd_tk5" value="verify／sha256（版本變動那次）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2115" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tv5" value="apply 後逐檔 sha256 驗 cache/&amp;lt;repo&amp;gt;/ ＝ 印記；不符 → 重裝一次 + warn，再驗仍不符 → 1 失敗（見「sync（2′）」頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2115" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tk6" value="extract" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2155" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bd_tv6" value="啟動器 docker create &amp;lt;image&amp;gt; /x → docker cp c:/dist/. &amp;lt;tmp&amp;gt;/&amp;lt;repo&amp;gt;/ → docker rm（三步合稱；任一步或暫存目錄失敗 → 1）；每個 extract 項各做一次" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2155" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• d2wx：共通匯流終點寫「進度檔保留」，但本頁是 sync 的 apply，sync 不建進度檔（spec §2c 只偵測）；sync（2′）頁 m7x 寫的是「cache 可能部分更新，下次 sync 再取」&lt;br&gt;• fb_d2c2／fb_d2c3：失敗線與 d3、d3s 虛線框底邊重合，右側匯流直線與兩框右邊重合，看起來檔案框有實線邊、失敗線從檔案框出來" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2211" width="520" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bc" name="37 流程 v2：upgrade ── E. 升引擎 (a)(b)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2287" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── E. 升引擎 (a)(b)：預檢 → 三叉 → 覆寫判斷 → pull 新引擎" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="64" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="64" width="200" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uE" value="E. 升引擎：(a) upgrade 不帶 repo：執行紀錄 → 偵測進度檔 → resolve 完整預檢 → 引擎有新版 → 啟動器三叉 → 本機覆寫？（驗 ID）／inspect → 無才 pull 新引擎 → 續「E. 升引擎 (a′)」頁；(b) 別人 pull 後只回 1 提示（sync 頁）；(c) 見「E(c)（1）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1653" as="geometry"/></mxCell><mxCell id="uE_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s0" value="(a) upgrade 不帶 repo（含 vendor_kit 自身）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE"><mxGeometry x="20" y="36" width="220" height="80" as="geometry"/></mxCell><mxCell id="s0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="216" y="26" width="30" height="20" as="geometry"/></mxCell><mxCell id="s0l0" value="建執行紀錄 log/upgrade/&amp;lt;ts&amp;gt;-&amp;lt;id8&amp;gt;.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE"><mxGeometry x="280" y="52" width="280" height="48" as="geometry"/></mxCell><mxCell id="s0l0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="536" y="42" width="30" height="20" as="geometry"/></mxCell><mxCell id="s0l" value="寫 launcher_start（失敗 → 1 + 6-38，零寫入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE"><mxGeometry x="280" y="152" width="280" height="48" as="geometry"/></mxCell><mxCell id="s0l_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="536" y="142" width="30" height="20" as="geometry"/></mxCell><mxCell id="s0x" value="1 + 6-38：執行紀錄建不了／寫不進（零寫入）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE"><mxGeometry x="1000" y="136" width="200" height="80" as="geometry"/></mxCell><mxCell id="s0x_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="1176" y="126" width="30" height="20" as="geometry"/></mxCell><mxCell id="spq" value="偵測到既有進度檔（.tmp.*.toml／metadata [progress]）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=70;spacingRight=70;spacingTop=36;spacingBottom=36;" vertex="1" parent="uE"><mxGeometry x="280" y="236" width="280" height="143" as="geometry"/></mxCell><mxCell id="spq_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="536" y="226" width="30" height="20" as="geometry"/></mxCell><mxCell id="spr" value="是：先恢復（依進度檔 done／pending 續跑上次未完成的交易）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE"><mxGeometry x="600" y="284" width="300" height="48" as="geometry"/></mxCell><mxCell id="spr_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE"><mxGeometry x="876" y="274" width="30" height="20" as="geometry"/></mxCell><mxCell id="spx" value="1 + 6-27：恢復失敗（未恢復：&amp;lt;檔名&amp;gt;，逐檔列出）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE">