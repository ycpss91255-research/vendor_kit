fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1671" width="88" height="40" as="geometry"/></mxCell><mxCell id="p8_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1671" width="170" height="40" as="geometry"/></mxCell><mxCell id="p8_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1661" width="300" height="60" as="geometry"/></mxCell><mxCell id="p8_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1729" width="120" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="180" y="1729" width="170" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="1729" width="130" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1729" width="160" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="700" y="1729" width="100" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="1729" width="130" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="970" y="1729" width="180" height="36" as="geometry"/></mxCell><mxCell id="p8_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1126" y="1719" width="30" height="20" as="geometry"/></mxCell><mxCell id="p8_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1769" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p8_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1815" width="200" height="28" as="geometry"/></mxCell><mxCell id="p8_tk0" value="覆寫兩種（v2.1 B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1849" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8_tv0" value="工具 path 覆寫 [tools].&amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot;：cache/&amp;lt;repo&amp;gt;/ 變 symlink，sync 跳過該工具取件／verify 但仍檢查 metadata、基準版；引擎 tag 覆寫 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋vendor_kit_image_id：啟動器改用該本機 image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1849" width="610" height="55" as="geometry"/></mxCell><mxCell id="p8_tk1" value="dev 進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1904" width="150" height="40" as="geometry"/></mxCell><mxCell id="p8_tv1" value=".tmp.dev.&amp;lt;id&amp;gt;.toml：dev 是可寫動詞，第一個寫入前建，記要寫的覆寫行、symlink 目標、印記第一行；成功後刪；失敗 → 保留、下次可寫動詞先恢復（v2.15-5、新規則 (b)）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1904" width="610" height="40" as="geometry"/></mxCell><mxCell id="p8_tk2" value="docker image inspect／掛載 -v" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1944" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8_tv2" value="啟動器每次 docker run 前先 docker image inspect &amp;lt;ref 或 tag&amp;gt;：本機有 → 不 pull（覆寫時 .Id 必須 == version.local.toml 記的 image ID，否則 1）；-v &amp;lt;dir&amp;gt;/dist:/dist/&amp;lt;repo&amp;gt;:ro = 把本機目錄唯讀掛進容器；引擎 image LABEL 帶介面版／檔案版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1944" width="610" height="55" as="geometry"/></mxCell><mxCell id="p8_tk3" value="dist 合法（引擎完整驗證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1999" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8_tv3" value="init.toml 可解析、每個 [[file]] 有 src/dest、strategy ∈ copy／append、dest 不越出專案且不指向 .vendor_kit/、files/ 內無 symlink／hardlink／特殊檔；不合法 → 1 失敗（紅，v2.15-13）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1999" width="610" height="55" as="geometry"/></mxCell><mxCell id="p8_tk4" value="6-27（恢復失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1849" width="150" height="28" as="geometry"/></mxCell><mxCell id="p8_tv4" value="可寫動詞開始前偵測到既有進度檔 → 先恢復再繼續；恢復失敗 → 1「未恢復：&amp;lt;檔名&amp;gt;」逐檔列出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1849" width="610" height="28" as="geometry"/></mxCell><mxCell id="p8_tk5" value="6-26（flock 逾時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1877" width="150" height="40" as="geometry"/></mxCell><mxCell id="p8_tv5" value="apply 拿專案目錄鎖 60 秒未釋放 → 1「專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）…重試，或設 VENDOR_KIT_NO_LOCK=1」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1877" width="610" height="40" as="geometry"/></mxCell><mxCell id="p8_tk6" value="config.toml（install／uninstall）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1917" width="150" height="55" as="geometry"/></mxCell><mxCell id="p8_tv6" value=".vendor_kit/config.toml（進 git）：schema = 1、[log] keep = 50、days = 30；install 建（含註解）＋ 基準版副本 baseline/vendor_kit/config.toml；升引擎時三方合併；uninstall 只在 hash == 副本時刪；缺檔或缺鍵 = 預設" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1917" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• dpe_n：菱形 dpq 到 d1q 的邊只有 20px（y 465→485），「否」標籤落在 (420,475)，而恢復框回流線 dpe_r 的水平段正好在 y=475（x 420–730）從標籤上穿過" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="1993" width="520" height="81" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p8ccc" name="45 流程 v2：dev vendor_kit"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2121" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：dev vendor_kit -i（§2 dev 列；v2.1 B、v2.2 B、v2.6 §1、v2.15-5、v2.16-16）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" v