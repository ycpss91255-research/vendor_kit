Right=6;" vertex="1" parent="1"><mxGeometry x="870" y="1032" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bce_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1026" y="1022" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bce_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bce_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1118" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bce_tk0" value="6-2b" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1152" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bce_tv0" value="第一行已改但新引擎拉取／重產失敗，或第二次第一行又變 → 1：「引擎版本已鎖定為 vY，但薄殼尚未重產；請排除上述錯誤後執行：just vendor_kit upgrade vendor_kit」（.tmp.upgrade 進度檔保留）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1152" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bce_tk1" value="升引擎進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1192" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tv1" value=".tmp.upgrade.&amp;lt;id&amp;gt;.toml：改第一行之前建，記舊引擎 ref、目標引擎 ref、計畫 image ID、done／pending；啟動器 grep 其目標 ref 決定拉哪個引擎；新引擎重產薄殼完成後刪；未完成 → 可寫動詞先恢復（= 重跑 upgrade vendor_kit）、sync／update 印 6-33 結束 1、help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1192" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tk2" value="gen/.stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1247" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tv2" value="只記「gen/ 與薄殼是哪個引擎產生的」（引擎 ref 一行；本機覆寫時為 &amp;lt;tag&amp;gt;）；只由 install／upgrade vendor_kit 寫；≠ version.toml 版本鎖定行 → sync 退出 1 印 6-1；fresh clone 缺此檔時相容判定改用薄殼首行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1247" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tk3" value="gen/tools.just／mod?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1152" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tv3" value="不進 git；每個工具 just/&amp;lt;ns&amp;gt;.just 一行 mod? &amp;lt;ns&amp;gt; &#x27;../cache/&amp;lt;repo&amp;gt;/just/&amp;lt;ns&amp;gt;.just&#x27;（帶問號 = 檔不在也不掛）；add／remove／upgrade／sync 重生，最後寫、與 cache 同一 apply 內原子替換（I17）；裡面沒有 recipe" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1152" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bce_tk4" value="接手判定（§3.4）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1207" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bce_tv4" value="啟動器在 apply 前後各 grep 一次正式 version.toml 的 vendor_kit 版本鎖定行；引擎失敗時：未變 → 1 印原因；已改（含變成非計畫值）→ 1 + 6-2b（進度檔保留，重跑 upgrade vendor_kit 續跑）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1207" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bce_tk5" value="6-2（升引擎完成）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1247" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bce_tv5" value="「已升級引擎 vX → vY 並重產薄殼，請 commit .vendor_kit/ 並再跑原指令」（結束 1，需人處理）；同引擎修復重產另有文案（版本未變）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1247" width="610" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p8" name="44 流程 v2：dev &lt;repo&gt;"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2114" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：dev &amp;lt;repo&amp;gt;（§2 dev 列；v2.1 B、v2.2 B、v2.3 §3、v2.15-5、v2.16-1）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell