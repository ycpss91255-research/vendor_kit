to;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=right;verticalAlign=middle;spacingRight=6;spacingBottom=0;" edge="1" parent="1" source="n1i" target="n1v"><mxGeometry x="-0.70" relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="1171"/><mxPoint x="270" y="1274"/><mxPoint x="380" y="1274"/></Array></mxGeometry></mxCell><mxCell id="ne5x" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1p" target="n1px"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="1274"/><mxPoint x="1610" y="1274"/><mxPoint x="1610" y="1551"/><mxPoint x="1110" y="1551"/></Array></mxGeometry></mxCell><mxCell id="p6_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1675" width="200" height="60" as="geometry"/></mxCell><mxCell id="p6_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1675" width="140" height="64" as="geometry"/></mxCell><mxCell id="p6_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1683" width="140" height="44" as="geometry"/></mxCell><mxCell id="p6_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1677" width="190" height="56" as="geometry"/></mxCell><mxCell id="p6_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1677" width="210" height="56" as="geometry"/></mxCell><mxCell id="p6_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1685" width="88" height="40" as="geometry"/></mxCell><mxCell id="p6_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1685" width="170" height="40" as="geometry"/></mxCell><mxCell id="p6_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1675" width="300" height="60" as="geometry"/></mxCell><mxCell id="p6_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1743" width="220" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1743" width="120" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="1743" width="170" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="610" y="1743" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="1743" width="160" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="1743" width="100" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="1743" width="130" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1210" y="1743" width="180" height="36" as="geometry"/></mxCell><mxCell id="p6_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1366" y="1733" width="30" height="20" as="geometry"/></mxCell><mxCell id="p6_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1783" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p6_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1829" width="200" height="28" as="geometry"/></mxCell><mxCell id="p6_tk0" value="快路徑（Q22、§3.6）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1863" width="150" height="71" as="geometry"/></mxCell><mxCell id="p6_tv0" value="啟動器只用 grep 比對：gen/.stamp 第一行 == 引擎 ref；[tools] 每個 &amp;lt;repo&amp;gt; 的 digest == gen/&amp;lt;repo&amp;gt;.stamp 第一行（或 path:&amp;lt;dir&amp;gt;）；每個 cache/&amp;lt;repo&amp;gt;/ 存在（目錄或 symlink）；gen/tools.just 存在；非 CI 模式；sync 無參數。全相符 → 不起容器、0（執行紀錄寫 sync_fast_path）；否則起引擎 resolve sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1863" width="610" height="71" as="geometry"/></mxCell><mxCell id="p6_tk1" value="6-9（專案根）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1934" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv1" value="vendor_kit 動詞只准在專案根執行（recipe 檢查 invocation_directory() == justfile_directory()），否則 1 印 6-9「請到 &amp;lt;dir&amp;gt; 執行」；sync 也適用：工具 recipe 的 _sync 先 cd 到專案根再呼叫 sync；此檢查不寫檔，在建執行紀錄之前" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1934" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6_tk2" value="統一提示 6-1（Q10 (2)）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1989" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv2" value="啟動器發現引擎 ref ≠ gen/.stamp → 不重寫，退出 1 固定印「vendor_kit 已更新 vX → vY，請執行：just vendor_kit upgrade vendor_kit」（需人處理，橙）；install／升引擎跳過這關；fresh clone 缺 gen/.stamp 時改用薄殼自描述首行 engine= 做相容判定（不是視為相符）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1989" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6_tk3" value="引擎 ref／grep 命中" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2044" width="150" height="40" as="geometry"/></mxCell><mxCell id="p6_tv3" value="version.toml 的 vendor_kit 版本鎖定行指到的引擎 image 版本；啟動器 grep 命中須恰 1（缺或重複 → 1 失敗）；version.local.toml 的本機覆寫優先" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2044" width="610" height="40" as="geometry"/></mxCell><mxCell id="p6_tk4" value="gen/ 三種檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1863" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv4" value="gen/tools.just：每個 &amp;lt;ns&amp;gt;.just 一行 mod?，sync／add／remove／upgrade 重生；gen/.stamp：只記引擎 ref，只由 install／升引擎寫；gen/&amp;lt;repo&amp;gt;.stamp：每工具印記（第一行 index digest 或 path:，之後每檔 sha256）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1863" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6_tk5" value="docker image inspect（引擎 image）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1918" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv5" value="啟動器每次 docker run 前先 inspect：本機有 → 不 pull；引擎本機覆寫時 .Id 必須等於 version.local.toml 記的 image ID，否則 1（本機覆寫已失效）；無 → docker pull（失敗 → 1 + 6-24／逾時 6-31）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1918" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6_tk6" value="6-33（未完成交易）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1973" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv6" value="唯讀動詞偵測到 .tmp.&amp;lt;verb&amp;gt;.*.toml 或 metadata [progress] in-progress → 只印「偵測到未完成的 &amp;lt;verb&amp;gt;（&amp;lt;id&amp;gt;）。請先重跑：just vendor_kit &amp;lt;verb&amp;gt; &amp;lt;targets&amp;gt;」，不自動恢復、不寫檔；sync／update 結束 1，help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1973" width="610" height="55" as="geometry"/></mxCell><mxCell id="p6_tk7" value="覆寫兩種（v2.1 B／v2.2 B）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2028" width="150" height="55" as="geometry"/></mxCell><mxCell id="p6_tv7" value="引擎本機覆寫 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋image ID → 啟動器 inspect 驗 ID 後用該本機 image；工具本機覆寫 &amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot; → cache 是 symlink，跳過取件／verify，仍查 metadata／基準版" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2028" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• npq／npx：6-33 偵測畫在啟動器段、grep／docker run 之前；spec §1.2 sync 與 v2.17-1 明寫 6-33 偵測在引擎 resolve sync 內，啟動器只把「無 .tmp.*」當快路徑條件（啟動器不解析 TOML、讀不到 metadata [progress]）&lt;br&gt;• n1p：「否：inspect；本機無才 docker pull &amp;lt;引擎 ref&amp;gt;」一格兩事；同頁 n1v 與 install（1）頁都拆成菱形＋「無：docker pull」，應比照拆成判斷＋步驟" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2099" width="520" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p6cc" name="27 流程 v2：sync（1′）引擎 resolve"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2415" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：sync（1′）引擎 resolve sync（逐工具；§6、v2.2 A／B／E、v2.3 §3／§4、v2.15-17）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="280" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="580" y="64" width="640" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="eA2" value="sync 第 1 段續（承「sync（1）」頁）：引擎 resolve sync 不寫任何檔 → CI 模式 vs 本機覆寫 → 逐工具算待辦 → 彙整 → 指紋 → stdout（apply|yes／no）→ 啟動器驗文法 → 空 → 0；有待辦 → 第 2 段見「sync（2）」頁" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1883" as="geometry"/></mxCell><mxCell id="eA2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="n1e" value="來自「sync（1）」頁：引擎 image 已在本機、快路徑有差、無未完成交易（已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=41;spacingRight=41;spacingTop=15;spacingBottom=15;" vertex="1" parent="eA2"><mxGeometry x="260" y="36" width="280" height="102" as="geometry"/></mxCell><mxCell id="n1b" value="docker run &amp;lt;引擎&amp;gt; resolve sync（永不 -t）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA2"><mxGeometry x="260" y="158" width="280" height="48" as="geometry"/></mxCell><mxCell id="n1b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="516" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="n1be" value="resolve sync（不寫任何檔）：讀 version.toml、各 metadata、印記" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA2"><mxGeometry x="560" y="158" width="360" height="48" as="geometry"/></mxCell><mxCell id="n1be_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="896" y="148" width="30" height="20" as="geometry"/></mxCell><mxCell id="ncx" value="1：CI 模式拒絕本機覆寫（請先 undev）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=32;spacingRight=32;spacingTop=8;spacingBottom=8;" vertex="1" parent="eA2"><mxGeometry x="20" y="228" width="220" height="58" as="geometry"/></mxCell><mxCell id="ncx_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="216" y="218" width="30" height="20" as="geometry"/></mxCell><mxCell id="nc" value="CI 模式且有本機覆寫？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=90;spacingRight=90;spacingTop=12;spacingBottom=12;" vertex="1" parent="eA2"><mxGeometry x="560" y="232" width="360" height="50" as="geometry"/></mxCell><mxCell id="nc_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="896" y="222" width="30" height="20" as="geometry"/></mxCell><mxCell id="nf" value="CI 模式（v2.6 §2）= 只准寫 cache/、gen/；不查最新版；需寫任何進 git 的檔 → 1（-y 不解除）；升為失敗：薄殼不符、基準版落後、未完成接入、任何本機覆寫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="eA2"><mxGeometry x="1230" y="226" width="340" height="63" as="geometry"/></mxCell><mxCell id="nf_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="1546" y="216" width="30" height="20" as="geometry"/></mxCell><mxCell id="t0" value="否 → path 覆寫（dev 中）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=90;spacingRight=90;spacingTop=20;spacingBottom=20;" vertex="1" parent="eA2"><mxGeometry x="560" y="309" width="360" height="81" as="geometry"/></mxCell><mxCell id="t0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="896" y="299" width="30" height="20" as="geometry"/></mxCell><mxCell id="t0s" value="是：跳過取件／verify（仍查 metadata、基準版）↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA2"><mxGeometry x="1020" y="326" width="180" height="48" as="geometry"/></mxCell><mxCell id="t0s_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="1176" y="316" width="30" height="20" as="geometry"/></mxCell><mxCell id="t1" value="cache 缺或印記 ≠ 鎖定？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=90;spacingRight=90;spacingTop=12;spacingBottom=12;" vertex="1" parent="eA2"><mxGeometry x="560" y="424" width="360" height="50" as="geometry"/></mxCell><mxCell id="t1_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="896" y="414" width="30" height="20" as="geometry"/></mxCell><mxCell id="t1y" value="是：列待辦「取件鎖定版」＋「apply 後全檔驗證」（版本變動那次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="eA2"><mxGeometry x="1020" y="418" width="180" height="63" as="geometry"/></mxCell><mxCell id="t1y_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="1176" y="408" width="30" height="20" as="geometry"/></mxCell><mxCell id="t0r" value="覆寫兩種（v2.1 B）：引擎 vendor_kit = &quot;&amp;lt;tag&amp;gt;&quot;＋image ID → 啟動器 inspect 驗 ID 後用該本機 image；工具 &amp;lt;repo&amp;gt; = &quot;path:&amp;lt;dir&amp;gt;&quot; → cache/&amp;lt;repo&amp;gt;/ 是 symlink，跳過取件／verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="eA2"><mxGeometry x="1230" y="410" width="340" height="79" as="geometry"/></mxCell><mxCell id="t0r_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="1546" y="400" width="30" height="20" as="geometry"/></mxCell><mxCell id="t2q" value="否 → 逐檔驗？（--verify／CI 模式）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=90;spacingRight=90;spacingTop=20;spacingBottom=20;" vertex="1" parent="eA2"><mxGeometry x="560" y="509" width="360" height="81" as="geometry"/></mxCell><mxCell id="t2q_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="eA2"><mxGeometry x="896" y="499" width="30" height="20" as="geometry"/></mxCell><mxCell id="t2qn" value="否：不逐檔驗（快）↓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex