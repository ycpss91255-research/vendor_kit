etry x="324" y="980" width="980" height="42" as="geometry"/></mxCell><mxCell id="p1B_r6c2_3" value="基準版推到新版（有衝突仍推；解析失敗不推）+ metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="1022" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r6c2_4" value="fetch cache/、gen/&amp;lt;repo&amp;gt;.stamp；gen/tools.just 重生" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="1048" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r6c2_5" value="version.toml 最後寫 → 刪進度檔；--dry-run：只印會問哪些檔與 6-6～6-8、不寫" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="324" y="1074" width="980" height="26" as="geometry"/></mxCell><mxCell id="p1B_r6c3" value="0；1 工具層不動 version.toml；2 有衝突（留標記、印檔名、基準版仍推；解完重跑；merge-file I/O 錯誤 → 1）；3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1304" y="912" width="180" height="188" as="geometry"/></mxCell><mxCell id="p1B_r6c4" value="常用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1B"><mxGeometry x="1484" y="912" width="56" height="188" as="geometry"/></mxCell><mxCell id="p1B_r7c0" value="upgrade（不帶 repo：全部含自身）&lt;br&gt;upgrade [-y] [--dry-run] [--timeout &amp;lt;秒&amp;gt;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verti