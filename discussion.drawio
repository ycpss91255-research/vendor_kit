m=5;" vertex="1" parent="1"><mxGeometry x="40" y="2045" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="2045" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="420" y="2045" width="170" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="610" y="2045" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="2045" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="910" y="2045" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1060" y="2045" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7b_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1216" y="2035" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7b_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2085" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7b_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2131" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7b_tk0" value="B／D／N" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2165" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7b_tv0" value="B = 基準版（上次合併時的初始檔原版副本，進 git）；D = 現況（專案裡你的那份檔）；N = 新版初始檔 = 啟動器把目標版 image 展開到暫存、掛進引擎的 /dist/&amp;lt;repo&amp;gt;（不是 cache；v2.5 §2）；「D==B」= 你沒改過" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2165" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7b_tk1" value="逐檔判斷（狀態機）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2220" width="150" height="71" as="geometry"/></mxCell><mxCell id="p7b_tv1" value="upgrade apply 對 init.toml 每個 [[file]] 與 metadata 每個 dest，依 metadata state（managed／appended／declined／unmanaged／deleted／metadata 無此 dest = 新版新增）分流，每檔恰走一條路：結果 = 不動／warn（不問）或問 6-22；在 apply 內、拿到 flock、建進度檔後（「B（2）」頁）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2220" width="610" height="71" as="geometry"/></mxCell><mxCell id="p7b_tk2" value="二進位檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2291" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7b_tv2" value="不是文字的檔（symlink 同）；不做行內合併：D==B（未改）→ 問「X 是二進位檔，要換成新版嗎？」答應才換（v2.6 §8）；改過 → 保留 + warn，不進三方合併；dist/files/ 第一版禁止 symlink" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2291" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7b_tk3" value="declined／declined_hash／6-6／6-7／6-8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2165" width="150" height="71" as="geometry"/></mxCell><mxCell id="p7b_tv3" value="state=declined 只用於「範本要建的新檔被拒」；已納管檔拒絕本次更新 → state 不變、只記 declined_hash（被拒那版 N 的 sha256）；N 的 hash == declined_hash → 不再問（dry-run／check.sh 印 6-6「有 N 個範本你拒絕過」）；≠ → 再問；unmanaged → 不動（6-7「&amp;lt;X&amp;gt; 沒納管」提醒）；6-8「&amp;lt;Y&amp;gt; 你拒絕過，&amp;lt;vZ&amp;gt; 有新版」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2165" width="610" height="71" as="geometry"/></mxCell><mxCell id="p7b_tk4" value="6-11（已有同名檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2236" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7b_tv4" value="新版新增的 dest 已存在 → 不納管（state=unmanaged）、不問、印「&amp;lt;X&amp;gt; 已存在，未納管；範本在 .vendor_kit/cache/&amp;lt;repo&amp;gt;/files/ 可自行比對」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2236" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7b_tk5" value="6-22（upgrade 逐檔問句）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2276" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7b_tv5" value="「&amp;lt;X&amp;gt; 換成新版？」／「你和新版都改了 &amp;lt;X&amp;gt;，要三方合併嗎？」／「要建 &amp;lt;X&amp;gt; 嗎」／「&amp;lt;X&amp;gt; 是二進位檔，要換成新版嗎？」；config.toml 三方合併也用它；-y 免問" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2276" width="610" height="40" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;• ce_1y 等：左側九條短邊（菱形→藍格）的「是」標籤全都擠在藍格右上 v2 小標上，貼字（v2.17-9 不擠短線）&lt;br&gt;• ce_9n：q9 的「否」標籤被自己的折線劃過" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1240" y="1404" width="360" height="96" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bd" name="36 流程 v2：upgrade ── D. 回退"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="2363" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── D. 回退 = git revert 該升級 commit（§5、v2.5 §1／§9、v2.16-12）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="Renovate（GitHub 上）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="64" width="240" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1120" y="64" width="180" height="28" as="geometry"/></mxCell><mxCell id="hdr5" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1320" y="64" width="280" height="28" as="geometry"/></mxCell><mxCell id="uD" value="D. 回退 ＝ git revert 該升級 commit（version.toml + 初始檔 + 基準版同一 commit）；下次 just 的 sync（resolve → docker → apply 前置 → 取件舊版 → 印記 → 全檔驗證 → tools.just）把 cache/ 換回舊版；初始檔與基準版由 git revert 還原" 