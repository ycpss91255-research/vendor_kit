tDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=center;verticalAlign=top;spacingTop=6;spacingBottom=0;" edge="1" parent="1" source="s12d1" target="s12v"><mxGeometry x="-0.74" relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="1502"/><mxPoint x="1010" y="1716"/><mxPoint x="725" y="1716"/></Array></mxGeometry></mxCell><mxCell id="p7bcc_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1907" width="200" height="60" as="geometry"/></mxCell><mxCell id="p7bcc_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1907" width="140" height="64" as="geometry"/></mxCell><mxCell id="p7bcc_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=20;spacingRight=20;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1915" width="140" height="44" as="geometry"/></mxCell><mxCell id="p7bcc_lg3" value="紅：失敗終止（拉不到／寫壞）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=28;spacingRight=28;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="580" y="1909" width="190" height="56" as="geometry"/></mxCell><mxCell id="p7bcc_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="790" y="1909" width="210" height="56" as="geometry"/></mxCell><mxCell id="p7bcc_lg5" value="白：步驟" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1020" y="1917" width="88" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1128" y="1917" width="170" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1318" y="1907" width="300" height="60" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_entry" value="白虛線橢圓：跨頁出入口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=32;spacingRight=32;spacingTop=5;spacingBottom=5;" vertex="1" parent="1"><mxGeometry x="40" y="1975" width="220" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1975" width="120" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_sub" value="藍：引擎（容器內）做的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="1975" width="160" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_img" value="紫：image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="1975" width="100" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_hdr" value="灰底：泳道／表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="1975" width="130" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_v2" value="右上綠標 v2：與 v1 不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="870" y="1975" width="180" height="36" as="geometry"/></mxCell><mxCell id="p7bcc_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1026" y="1965" width="30" height="20" as="geometry"/></mxCell><mxCell id="p7bcc_lgi" value="圖例約定（v2.15-2、v2.16-3）：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（結束碼、耗時）；每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start、結束寫 engine_exit（同一執行紀錄；事件名 = spec §4.10 註冊表）。白 = 啟動器（主機）做的。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="2015" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2061" width="200" height="28" as="geometry"/></mxCell><mxCell id="p7bcc_tk0" value="升引擎進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2095" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tv0" value=".tmp.upgrade.&amp;lt;id&amp;gt;.toml：改第一行之前建，記舊引擎 ref、目標引擎 ref、計畫 image ID、done／pending；啟動器 grep 其目標 ref 決定拉哪個引擎；新引擎重產薄殼完成後刪；未完成 → 可寫動詞先恢復（= 重跑 upgrade vendor_kit）、sync／update 印 6-33 結束 1、help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2095" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tk1" value="上次產物／薄殼相符" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2150" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_tv1" value="「== 上次產物」= 自描述首行 hash 與內容相符（未被人改），被改過 → 1 + 6-28 列差異不動；「薄殼相符」= 首行 engine 已是本引擎且 gen/.stamp 相符 → 0 無變更" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2150" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_tk2" value="registry／引擎 ref" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2190" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tv2" value="GHCR = GitHub 的容器倉庫（registry）；引擎 image = ghcr.io/…/vendor_kit:vN；引擎 ref = version.toml 的 vendor_kit 版本鎖定行指到的那一個（tag@digest）；查 registry = 列 tags 取最新正式版（CI 模式或 @&amp;lt;tag&amp;gt; 不查）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2190" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tk3" value="--protocol／降版（Q19）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2245" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tv3" value="薄殼每次呼叫附 --protocol &amp;lt;介面版&amp;gt;；舊薄殼跑新 major 引擎 → 乾淨回 3 提示先 upgrade vendor_kit；upgrade vendor_kit@&amp;lt;舊版&amp;gt;：目標引擎（image LABEL 的介面版／檔案版）能無損讀現有檔才做，否則改檔前拒絕 3 印 6-10（零寫入）；救援路徑永久可用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2245" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tk4" value="6-26（flock 逾時）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2095" width="150" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_tv4" value="apply 拿專案目錄鎖 60 秒未釋放 → 1「專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）…重試，或設 VENDOR_KIT_NO_LOCK=1」" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2095" width="610" height="40" as="geometry"/></mxCell><mxCell id="p7bcc_tk5" value="6-24／6-31（pull 失敗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2135" width="150" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tv5" value="docker pull 失敗 → 1 + 6-24（原文 + 網路／認證／不存在／主機錯誤分類；bootstrap／add 另附「離線可用：--local &amp;lt;tar&amp;gt;」）；pull 逾時 → 1 + 6-31（--timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整）；docker create／cp／rm 或暫存目錄失敗同樣 → 1 停止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2135" width="610" height="55" as="geometry"/></mxCell><mxCell id="p7bcc_tk6" value="6-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2190" width="150" height="28" as="geometry"/></mxCell><mxCell id="p7bcc_tv6" value="薄殼被改過（自描述首行 hash 與內容不符）→ 1，列差異不動、零寫入；在恢復進度檔之前檢查" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2190" width="610" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p7bcx" name="40 流程 v2：upgrade ── E(c) upgrade vendor_kit（1′）"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1734" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="流程 v2：upgrade ── E(c) upgrade vendor_kit（1′）pull 目標引擎 → 接手（v2.15-7）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="hdr0" value="下游使用者" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="220" height="28" as="geometry"/></mxCell><mxCell id="hdr1" value="啟動器（主機 sh）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="64" width="320" height="28" as="geometry"/></mxCell><mxCell id="hdr2" value="引擎容器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="620" y="64" width="380" height="28" as="geometry"/></mxCell><mxCell id="hdr3" value="GHCR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1020" y="64" width="200" height="28" as="geometry"/></mxCell><mxCell id="hdr4" value="專案目錄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1240" y="64" width="360" height="28" as="geometry"/></mxCell><mxCell id="uE2b" value="E(c)（1′）目標 ≠ 現 ref（承「E(c)（1）」頁）：建進度檔（記目標 ref）→ 啟動器 grep 目標 ref → inspect／pull 目標引擎（失敗 → 第一行未改）→ 目標引擎跑 upgrade vendor_kit（「E(c)（2）」頁）" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="108" width="1600" height="1137" as="geometry"/></mxCell><mxCell id="uE2b_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="uE2b"><mxGeometry x="1556" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s12j0" value="來自「E(c)（1）」頁：目標引擎 ref ≠ 現 ref（已拿鎖；已寫 launcher_start）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=12;dashed=1;spacingLeft=53;spacingRight=53;spacingTop=12;spacingBottom=12;" vertex="1" parent="uE2b"><mxGeometry x="610" y="36" width="360" height="80" as="geometry"/></mxCell><mxCell id="s12j" value="建進度檔 .tmp.upgrade.&amp;lt;id&amp;gt;.toml（記舊引擎 ref、目標引擎 ref、計畫 image ID、pending；已有 → 沿用；之後引擎結束交回啟動器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="uE2b"><mxGeometry x="610" y="136" width="360" height="63" as="geometry"/></mxCell><mxCell id="s12j_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#