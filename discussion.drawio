;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.025;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_vk" target="t_log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="84" y="1649.5"/></Array></mxGeometry></mxCell><mxCell id="te25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.0264;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_log" target="t_logf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="114" y="1732.5"/></Array></mxGeometry></mxCell><mxCell id="p2_ver_l" value=".vendor_kit/version.toml（進 git；schema = 1）── 啟動器只靠 grep 讀版本鎖定行" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="109" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_ver" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;vendor_kit = &quot;ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:v1.0.0@sha256:&amp;lt;digest&amp;gt;&quot;&lt;br&gt;schema = 1&lt;br&gt;written_by = &quot;v1.0.0&quot;&lt;br&gt;&lt;br&gt;[tools]&lt;br&gt;&amp;lt;repo&amp;gt; = &quot;ghcr.io/&amp;lt;org&amp;gt;/&amp;lt;repo&amp;gt;-dist:v2.3.0@sha256:&amp;lt;digest&amp;gt;&quot;&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="141" width="497" height="108" as="geometry"/></mxCell><mxCell id="p2_ver_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1125" y="143" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_ver_n" value="契約：頂層 vendor_kit 行在 [tools] 之前、符合正規形（行首無空白、鍵後一空白、=、一空白、雙引號、&lt;b&gt;無尾端註解&lt;/b&gt;、LF；regex 命中 ≠ 1 就是 1）；install 把它寫在第 1 行只是慣例，不是契約&lt;br&gt;schema：格式版本，引擎讀、啟動器不讀；written_by：寫入引擎版本，純資訊&lt;br&gt;[tools]：每工具一行 tag@digest（多架構 index digest）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1169" y="141" width="431" height="108" as="geometry"/></mxCell><mxCell id="p2_vl_l" value=".vendor_kit/version.local.toml（不進 git；與 version.toml 同形）── dev 寫、undev 刪、bootstrap --local 寫" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="263" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_vl" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;vendor_kit = &quot;vendor_kit:dev&quot;&lt;br&gt;vendor_kit_image_id = &quot;sha256:&amp;lt;image id&amp;gt;&quot;&lt;br&gt;schema = 1&lt;br&gt;written_by = &quot;v1.0.0&quot;&lt;br&gt;&lt;br&gt;[tools]&lt;br&gt;&amp;lt;repo&amp;gt; = &quot;path:/home/me/&amp;lt;repo&amp;gt;&quot;&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="295" width="346" height="124" as="geometry"/></mxCell><mxCell id="p2_vl_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="974" y="297" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_vl_n" value="vendor_kit：dev vendor_kit -i &amp;lt;tag&amp;gt; 寫的本機引擎 image，只能 tag（docker load 後無 RepoDigests）；同樣是版本鎖定行、無尾端註解&lt;br&gt;vendor_kit_image_id：啟動器每次 docker image inspect 比對、不 pull；同 tag 重 build 才會被發現；undev 一併撤&lt;br&gt;[tools].&amp;lt;repo&amp;gt;：dev &amp;lt;repo&amp;gt; -p &amp;lt;dir&amp;gt; 寫 path:&amp;lt;dir&amp;gt;；cache/&amp;lt;repo&amp;gt;/ 變 symlink → &amp;lt;dir&amp;gt;/dist；啟動器掛 -v &amp;lt;dir&amp;gt;/dist:/dist/&amp;lt;repo&amp;gt;:ro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1018" y="295" width="582" height="124" as="geometry"/></mxCell><mxCell id="p2_jf_l" value="根 justfile（下游使用者的；install 新建時逐字四行；已有時只加第一行）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="433" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_jf" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;import &#x27;.vendor_kit/entry.just&#x27;&lt;br&gt;&lt;br&gt;default:&lt;br&gt;&#9;@just --list&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="465" width="300" height="77" as="geometry"/></mxCell><mxCell id="p2_jf_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="928" y="467" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_jf_n" value="第 4 行行首是&lt;b&gt;真 tab&lt;/b&gt;（recipe 本體必須縮排；default: @just --list 寫成單行是 just 語法錯誤，所以拆兩行）&lt;br&gt;已有 justfile → 問 6-20 只加第 1 行；uninstall 只刪完全相同的那行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="972" y="465" width="628" height="77" as="geometry"/></mxCell><mxCell id="p2_di_l" value="根 .dockerignore（下游使用者的；install append 四行；uninstall 問後只刪原文相同行）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="556" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_di" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;.vendor_kit/cache/&lt;br&gt;.vendor_kit/gen/&lt;br&gt;.vendor_kit/.tmp.*&lt;br&gt;.vendor_kit/log/&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="588" width="300" height="77" as="geometry"/></mxCell><mxCell id="p2_di_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="928" y="590" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_di_n" value="無 → 建；有 → 問 6-34 後 append（-y 免問）；插入的行記於 baseline/.vendor_kit.toml&lt;br&gt;工具以專案根當 build context 時靠它排除 cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="972" y="588" width="628" height="77" as="geometry"/></mxCell><mxCell id="p2_tj_l" value=".vendor_kit/gen/tools.just（不進 git；每個 &amp;lt;ns&amp;gt;.just 一行 mod?；零 set 零 recipe）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="679" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_tj" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;# &amp;lt;description&amp;gt;&lt;br&gt;mod? &amp;lt;ns&amp;gt; &#x27;../cache/&amp;lt;repo&amp;gt;/just/&amp;lt;ns&amp;gt;.just&#x27;&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="711" width="353" height="46" as="geometry"/></mxCell><mxCell id="p2_tj_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="981" y="713" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_tj_n" value="# &amp;lt;description&amp;gt;：來自 init.toml 頂層 description；缺則 &amp;lt;repo&amp;gt; &amp;lt;tag&amp;gt;&lt;br&gt;mod?：cache 缺檔時其他 recipe 與 just vendor_kit sync 仍可跑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1025" y="711" width="575" height="46" as="geometry"/></mxCell><mxCell id="p2_sh_l" value="薄殼自描述首行（entry.just／vendor.just／log.sh／.gitignore 第一行、ci/check.sh 第二行）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="771" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_sh" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;# vendor_kit-shell/1 engine=v1.0.0 sha256=&amp;lt;hash&amp;gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="803" width="396" height="61" as="geometry"/></mxCell><mxCell id="p2_sh_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1024" y="805" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_sh_n" value="&amp;lt;P&amp;gt; = 介面版（1）、engine = 產生它的引擎；&amp;lt;hash&amp;gt; = 其餘內容 CRLF→LF 正規化後的 sha256&lt;br&gt;引擎重算 hash + 對 image 內模板二次比對，不符 → 1 印 6-28 列差異不動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1068" y="803" width="532" height="61" as="geometry"/></mxCell><mxCell id="p2_st_l" value=".vendor_kit/gen/&amp;lt;repo&amp;gt;.stamp（每工具印記；fetch 寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="878" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_st" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;sha256:&amp;lt;hex64&amp;gt;&lt;br&gt;&amp;lt;sha256&amp;gt;  files/…&lt;br&gt;&amp;lt;sha256&amp;gt;  init.toml&lt;br&gt;&amp;lt;sha256&amp;gt;  just/&amp;lt;ns&amp;gt;.just&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="910" width="300" height="77" as="geometry"/></mxCell><mxCell id="p2_st_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="928" y="912" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_st_n" value="第 1 行：多架構 index digest（add --local 亦為正式 digest）；dev 時 path:&amp;lt;dir&amp;gt;；無 image:&amp;lt;tag&amp;gt; 形&lt;br&gt;之後每檔一行 &amp;lt;sha256&amp;gt;  &amp;lt;相對路徑&amp;gt;；verify 逐檔比；檔內沒有註解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="972" y="910" width="628" height="77" as="geometry"/></mxCell><mxCell id="p2_gs_l" value=".vendor_kit/gen/.stamp（只由 install／upgrade vendor_kit 寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="1001" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_gs" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:v1.0.0@sha256:&amp;lt;digest&amp;gt;&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="1033" width="389" height="46" as="geometry"/></mxCell><mxCell id="p2_gs_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1017" y="1035" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_gs_n" value="唯一一行：產生薄殼的引擎 ref（本機覆寫時為 &amp;lt;tag&amp;gt;）；≠ version.toml 版本鎖定行 → sync 退出 1 印 6-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1061" y="1033" width="539" height="46" as="geometry"/></mxCell><mxCell id="p2_tv_l" value=".vendor_kit/.tmp.&amp;lt;verb&amp;gt;.&amp;lt;id&amp;gt;.toml（進度檔；&amp;lt;verb&amp;gt; = 可寫動詞名（add／upgrade &amp;lt;repo&amp;gt; 除外）；&amp;lt;id&amp;gt; = trace_id）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="1093" width="940" height="28" as="geometry"/></mxCell><mxCell id="p2_tv" value="&lt;pre style=&quot;margin:0;font-family:inherit;font-size:inherit;line-height:inherit;tab-size:8;&quot;&gt;schema = 1&lt;br&gt;written_by = &quot;v1.0.0&quot;&lt;br&gt;verb = &quot;remove&quot;&lt;br&gt;id = &quot;&amp;lt;id&amp;gt;&quot;&lt;br&gt;targets = [&quot;&amp;lt;repo&amp;gt;&quot;]&lt;br&gt;started = &quot;&amp;lt;UTC ISO 8601&amp;gt;&quot;&lt;br&gt;done = [...]&lt;br&gt;pending = [...]&lt;br&gt;consents = [...]&lt;/pre&gt;" style="rounded=0;whiteSpace=pre;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="660" y="1125" width="300" height="155" as="geometry"/></mxCell><mxCell id="p2_tv_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="928" y="1127" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_tv_n" value="consents = 已取得的同意；done／pending = 已完成／未完成步驟&lt;br&gt;第一個寫入前建、成功結束時整個檔刪除；未完成 → 可寫動詞先恢復、唯讀動詞印 6-33" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="972" y="1125" width="628" height="155" as="geometry"/></mxCell><mxCell id="p2_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="1300" width="200" height="28" as="geometry"/></mxCell><mxCell id="p2_tk0" value="Renovate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1334" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv0" value="GitHub 機器人（下游自選）：GHCR 有新版就開 PR 改 version.toml 一行；人在 PR 分支跑 upgrade 補完合併、CI 綠後才 merge；preset 放 vendor_kit repo 根目錄 default.json，下游 extends: [&quot;github&amp;gt;ycpss91255-research/vendor_kit&quot;]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1334" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_tk1" value="config.toml" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1376" width="150" height="57" as="geometry"/></mxCell><mxCell id="p2_tv1" value=".vendor_kit/config.toml（進 git；install 建、upgrade 三方合併）：schema = 1、[log] keep = 50、days = 30；缺檔或缺鍵 = 預設，非正整數 → 預設 + 警告；引擎用 TOML parser（toml-bridge stage）讀，啟動器只 grep 固定寫法的 ^keep *= *[0-9]+ *$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1376" width="790" height="57" as="geometry"/></mxCell><mxCell id="p2_tk2" value="mod／mod?／import／import?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1433" width="150" height="57" as="geometry"/></mxCell><mxCell id="p2_tv2" value="just 的載入：mod &amp;lt;ns&amp;gt; &#x27;檔&#x27; 把整個檔掛成命名空間；mod? = 檔不在也不報錯（gen/tools.just 一律用它，cache 缺檔時 just vendor_kit sync 仍可進入）；import &#x27;檔&#x27; 把內容併進來（根 justfile 那一行）；import? = 檔不在也不報錯（entry.just 掛 gen/tools.just）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1433" width="790" height="57" as="geometry"/></mxCell><mxCell id="p2_tk3" value="trace_id／TRACEPARENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1490" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv3" value="啟動器每次執行產一個 32 hex id（/proc/sys/kernel/random/uuid 去 -，缺則 od /dev/urandom），同值 = 進度檔交易 id；以 -e TRACEPARENT 與 -e VENDOR_KIT_LOG_FILE 傳給引擎，引擎 append 同一個 log 檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1490" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_tk4" value="初始檔五態（state）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1532" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv4" value="metadata 對每個 dest 記單一 state：managed（已納管）／appended（append 已插入）／declined（新增檔被拒）／unmanaged（本來就有沒納管）／deleted（下游使用者刪了）；已納管檔拒絕換版只記 declined_hash；不動檔不紅燈" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1532" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_tk5" value="暫存 .tmp.dist.&amp;lt;id&amp;gt;/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1574" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv5" value="啟動器在專案內 mktemp -d 的暫存（.vendor_kit/.tmp.dist.XXXXXX）：放展開的工具 dist 與 vk-resolve；唯讀掛進引擎當 /dist；trap 刪；自有 .gitignore 的 .tmp.* 擋" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1574" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_tk6" value="baseline/.gitkeep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1616" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv6" value="VK 自產的進 git 空檔：git 不追蹤空目錄，所以 baseline/ 靠它進 git；install 建、uninstall 刪、hash 固定為空檔（§4.0；v2.15-14）；工具的 metadata 由 add 才建（baseline/&amp;lt;repo&amp;gt;/.vendor_kit.toml 兼作該工具目錄的佔位）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1616" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_tk7" value="gen/.stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="660" y="1658" width="150" height="42" as="geometry"/></mxCell><mxCell id="p2_tv7" value="只記「gen/ 與薄殼是哪個引擎產生的」（引擎 ref 一行；本機覆寫時為 &amp;lt;tag&amp;gt;）；只由 install／upgrade vendor_kit 寫；≠ version.toml 版本鎖定行 → sync 退出 1 印 6-1；fresh clone 缺此檔時相容判定改用薄殼首行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="810" y="1658" width="790" height="42" as="geometry"/></mxCell><mxCell id="p2_lg0" value="綠框：進 git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="2294" width="120" height="40" as="geometry"/></mxCell><mxCell id="p2_lg1" value="灰虛線：不進 git（可重建）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;dashed=1;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="180" y="2294" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2_lg2" value="黃底綠框：專案檔（進 git）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="400" y="2294" width="230" height="40" as="geometry"/></mxCell><mxCell id="p2_lg3" value="等寬字：檔案內容範例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontSize=12;fontFamily=Courier New;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="650" y="2294" width="170" height="40" as="geometry"/></mxCell><mxCell id="p2_lg4" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="2294" width="200" height="40" as="geometry"/></mxCell><mxCell id="p2_lg4_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1008" y="2296" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2_lg5" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="2294" width="220" height="40" as="geometry"/></mxCell><mxCell id="p2_lgt" value="樹線 = 目錄包含；範例框右邊 = 框外說明&lt;br&gt;綠標籤 = v2 改；schema 表 p2b、矩陣 p2c" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1300" y="2284" width="300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p2b" name="07 契約 v2：schema：version.toml／local／metadata／印記／薄殼首行"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1919" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約② 專案裡的檔（2／3）── schema：version.toml／version.local.toml／metadata／印記／薄殼首行（interface_spec §4）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p2b_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p2b_pend" value="&lt;b&gt;本頁無待拍板&lt;/b&gt;&lt;br&gt;欄位名、型別、必填以 interface_spec §4 為準；範例見 p2；動詞 × 檔案矩陣見 p2c" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="65" as="geometry"/></mxCell><mxCell id="p2B" value="4. 檔案 schema（欄位／型別／必填／說明；一列一欄位）" style="swimlane;html=1;rounded=1;startSize=38;fontStyle=1;fontSize=18;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1560" height="1388" as="geometry"/></mxCell><mxCell id="p2b_gen" value="&lt;b&gt;TOML 通則（所有 vendor_kit 寫的檔）&lt;/b&gt;&lt;br&gt;每檔案版 = N（integer）+ written_by = &quot;&amp;lt;vX&amp;gt;&quot;（string，純資訊，不作讀取門檻）；讀取門檻只看 schema；同檔案版只加不改；讀時忽略未知欄位、寫時保留（不能保留則拒絕寫）；只拒絕型別錯、重複宣告 → 1；檔案版高於本引擎支援 → 3 印 6-19 零寫入；讀任一舊檔案版 → 直接寫當前檔案版（不鏈式）；只在本來要寫該檔的明確動作寫回；引擎寫回固定格式並重讀驗證。第一版 schema = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="50" width="750" height="92" as="geometry"/></mxCell><mxCell id="p2b_gen_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="738" y="52" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_ver_l" value="4.1 .vendor_kit/version.toml" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="156" width="750" height="28" as="geometry"/></mxCell><mxCell id="p2b_ver_m" value="進 git：是；唯一來源。寫入者 install／add／upgrade／remove（apply 最後寫）；下游使用者、Renovate 可手改；sync 只讀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="p2B"><mxGeometry x="20" y="188" width="750" height="46" as="geometry"/></mxCell><mxCell id="p2b_canon" value="&lt;b&gt;version.toml 版本鎖定行契約&lt;/b&gt;&lt;br&gt;vendor_kit 行唯一正規形：整行 vendor_kit = &quot;&amp;lt;ref&amp;gt;&quot;（行首無空白、鍵後一個空白、=、一個空白、雙引號基本字串、無尾端註解、LF 結尾）；引擎寫出一律此形。讀取（啟動器、引擎、Renovate preset 共用）regex：^vendor_kit[[:space:]]*=[[:space:]]*&quot;\([^&quot;]*\)&quot;[[:space:]]*$（POSIX BRE，不用 \s）；命中數必須恰為 1（grep -c），0 或重複 → 1。第一行只是 install 寫出慣例、不是契約；頂層鍵必在 [tools] 之前。禁止：BOM、重複鍵、[vendor_kit] 表旁路等 regex 讀不到／讀錯的等價寫法。公開格式：工具可讀它寫來源紀錄" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="248" width="750" height="108" as="geometry"/></mxCell><mxCell id="p2b_canon_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="738" y="250" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_ver_h0" value="欄位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="370" width="190" height="30" as="geometry"/></mxCell><mxCell id="p2b_ver_h1" value="型別／必填" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="370" width="130" height="30" as="geometry"/></mxCell><mxCell id="p2b_ver_h2" value="說明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="370" width="430" height="30" as="geometry"/></mxCell><mxCell id="p2b_ver_r0c0" value="vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="400" width="190" height="42" as="geometry"/></mxCell><mxCell id="p2b_ver_r0c1" value="string／是" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="400" width="130" height="42" as="geometry"/></mxCell><mxCell id="p2b_ver_r0c2" value="引擎 ref ghcr.io/&amp;lt;org&amp;gt;/vendor_kit:vN@sha256:&amp;lt;digest&amp;gt;（多架構 index digest）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="400" width="430" height="42" as="geometry"/></mxCell><mxCell id="p2b_ver_r1c0" value="schema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="442" width="190" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r1c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="178" y="444" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_ver_r1c1" value="integer／是" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="442" width="130" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r1c2" value="啟動器不讀、只引擎讀" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="442" width="430" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r2c0" value="written_by" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="468" width="190" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r2c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="178" y="470" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_ver_r2c1" value="string／是" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="468" width="130" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r2c2" value="寫入引擎版本，純資訊" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="468" width="430" height="26" as="geometry"/></mxCell><mxCell id="p2b_ver_r3c0" value="[tools].&amp;lt;repo&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="494" width="190" height="57" as="geometry"/></mxCell><mxCell id="p2b_ver_r3c1" value="string／每工具" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="494" width="130" height="57" as="geometry"/></mxCell><mxCell id="p2b_ver_r3c2" value="ghcr.io/&amp;lt;org&amp;gt;/&amp;lt;repo&amp;gt;-dist:&amp;lt;tag&amp;gt;@sha256:&amp;lt;digest&amp;gt;（index digest；add --local 亦寫正式 index digest，來自 .digest 旁檔）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="494" width="430" height="57" as="geometry"/></mxCell><mxCell id="p2b_vl_l" value="4.2 .vendor_kit/version.local.toml" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="565" width="750" height="28" as="geometry"/></mxCell><mxCell id="p2b_vl_m" value="不進 git（自有 .gitignore 擋）；與 version.toml 同形（同一套讀寫器）；寫入者 dev／undev／bootstrap --local；uninstall 刪；最後一個覆寫撤掉後 undev 刪除整個檔；不交 Renovate；CI 模式下存在任何覆寫 → sync 回 1；啟動器先讀它再退回 version.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="597" width="750" height="61" as="geometry"/></mxCell><mxCell id="p2b_vl_m_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="738" y="599" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_vl_h0" value="欄位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="672" width="190" height="30" as="geometry"/></mxCell><mxCell id="p2b_vl_h1" value="型別／必填" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="672" width="130" height="30" as="geometry"/></mxCell><mxCell id="p2b_vl_h2" value="說明" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="672" width="430" height="30" as="geometry"/></mxCell><mxCell id="p2b_vl_r0c0" value="vendor_kit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="20" y="702" width="190" height="26" as="geometry"/></mxCell><mxCell id="p2b_vl_r0c1" value="string／否" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="702" width="130" height="26" as="geometry"/></mxCell><mxCell id="p2b_vl_r0c2" value="本機引擎 image tag（只能 tag，docker load 後無 RepoDigests）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="340" y="702" width="430" height="26" as="geometry"/></mxCell><mxCell id="p2b_vl_r1c0" value="vendor_kit_image_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;spacingRight=34;" vertex="1" parent="p2B"><mxGeometry x="20" y="728" width="190" height="57" as="geometry"/></mxCell><mxCell id="p2b_vl_r1c0_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="p2B"><mxGeometry x="178" y="730" width="30" height="20" as="geometry"/></mxCell><mxCell id="p2b_vl_r1c1" value="string／有 vendor_kit 時必填" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p2B"><mxGeometry x="210" y="728" width="130" height="57" as="geometry"/></mxCell><mxCell id="p2b_vl_r1c2" value="sha256:&amp;lt;hex64&amp;gt;，dev 時解析；啟動器每次 docker image inspect 比對，同 tag 重 build 才會被發現；undev vendor_kit 一併撤" style="rounded=0;whiteSpace