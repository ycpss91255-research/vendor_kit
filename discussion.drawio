BackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u12" target="u12y"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ue20" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="u12" target="u13"><mxGeometry x="-0.91" relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="1743"/></Array></mxGeometry></mxCell><mxCell id="p10_lg0" value="淺灰：情境分組（無狀態意義）" style="swimlane;html=1;rounded=1;startSize=34;fontStyle=1;fontSize=12;container=0;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1794" width="200" height="60" as="geometry"/></mxCell><mxCell id="p10_lg1" value="黃：判斷" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=35;spacingRight=35;spacingTop=16;spacingBottom=16;" vertex="1" parent="1"><mxGeometry x="260" y="1794" width="140" height="64" as="geometry"/></mxCell><mxCell id="p10_lg2" value="綠：起點／終點" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=22;spacingRight=22;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="420" y="1802" width="150" height="44" as="geometry"/></mxCell><mxCell id="p10_lg3" value="紅：失敗（拉不到／寫不進／驗證不過）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=31;spacingRight=31;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="590" y="1796" width="210" height="56" as="geometry"/></mxCell><mxCell id="p10_lg4" value="橙：需人處理（1／3 印指令；2 解衝突）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=29;spacingRight=29;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="820" y="1796" width="200" height="56" as="geometry"/></mxCell><mxCell id="p10_lg5" value="白：啟動器做" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1040" y="1804" width="100" height="40" as="geometry"/></mxCell><mxCell id="p10_lg6" value="虛線框：專案裡的檔案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="1804" width="170" height="40" as="geometry"/></mxCell><mxCell id="p10_lgt" value="實線 = 執行順序（指向檔案時 = 寫入／讀取）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1350" y="1794" width="260" height="60" as="geometry"/></mxCell><mxCell id="p10_lgx_note" value="便條：補充說明" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1862" width="120" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_pend" value="黃便條：待處理問題" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="180" y="1862" width="170" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_rule" value="橘框：規則（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="370" y="1862" width="150" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_sub" value="藍：引擎做（容器內）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="1862" width="170" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_hdr" value="灰底：泳道／表格表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;strokeWidth=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="730" y="1862" width="170" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_v2" value="右上綠標 v2：與 v1 不同處" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="920" y="1862" width="200" height="36" as="geometry"/></mxCell><mxCell id="p10_lgx_v2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1096" y="1852" width="30" height="20" as="geometry"/></mxCell><mxCell id="p10_lgx_conv1" value="圖例約定①：每個終點橢圓隱含 —— 啟動器結束前已寫 log_prune、launcher_exit（每個結束碼都寫）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1906" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p10_lgx_conv2" value="圖例約定②：每個「docker run 引擎」格隱含 —— 容器開始寫 engine_start（失敗 → 1 + 6-38、不做任何動作）、結束寫 engine_exit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1932" width="1560" height="24" as="geometry"/></mxCell><mxCell id="p10_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1964" width="200" height="28" as="geometry"/></mxCell><mxCell id="p10_tk0" value="update" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1998" width="150" height="55" as="geometry"/></mxCell><mxCell id="p10_tv0" value="只查 registry 有沒有新版、不動任何檔（唯讀，不受CI 模式限制）；單段 docker run（不經 docker create/cp）；[&amp;lt;repo&amp;gt;] 省略 = 全部工具 + vendor_kit 自身；--exit-code：有新版回 2（給 CI 用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1998" width="610" height="55" as="geometry"/></mxCell><mxCell id="p10_tk1" value="查最新" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2053" width="150" height="71" as="geometry"/></mxCell><mxCell id="p10_tv1" value="對 registry 走 Docker Registry 標準協定：需要時以 WWW-Authenticate 換 token → GET /v2/&amp;lt;name&amp;gt;/tags/list（分頁）→ 取 SemVer 最大正式版（排除預發行）；契約標「GHCR 已測試，其他 registry 依標準協定可用但未驗證」；查詢由引擎 resolve 模組在容器內做（藍格；token 以 -e 傳入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2053" width="610" height="71" as="geometry"/></mxCell><mxCell id="p10_tk2" value="registry 憑證（Q11）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2124" width="150" height="55" as="geometry"/></mxCell><mxCell id="p10_tv2" value="VENDOR_KIT_REGISTRY_TOKEN（+ _USER）或 VENDOR_KIT_REGISTRY_TOKEN_FILE（啟動器 -v &amp;lt;file&amp;gt;:/run/vk-token:ro 掛入；兩者同設 → 1）；只在 update 單段及 upgrade 的 resolve 以 -e 傳入引擎；不寫 log／檔、不傳給工具、dry-run 不印；不掛 ~/.docker/config.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2124" width="610" height="55" as="geometry"/></mxCell><mxCell id="p10_tk3" value="查詢失敗分類" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2179" width="150" height="40" as="geometry"/></mxCell><mxCell id="p10_tv3" value="每個目標各自判定：認證（錯 token／無權限）、網路（連不上、逾時）、回應（registry 回錯誤碼）、解析（SemVer／分頁解析失敗）；任一類都記該目標 1 並繼續查下一個目標，最後彙總" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2179" width="610" height="40" as="geometry"/></mxCell><mxCell id="p10_tk4" value="6-3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1998" width="150" height="55" as="geometry"/></mxCell><mxCell id="p10_tv4" value="無法列舉 &amp;lt;repo&amp;gt; 的版本：需要 registry 讀取權限。可設定 VENDOR_KIT_REGISTRY_TOKEN（或 VENDOR_KIT_REGISTRY_TOKEN_FILE），或直接指定版本：just vendor_kit upgrade &amp;lt;repo&amp;gt;@&amp;lt;tag&amp;gt;（拉取使用主機 docker 認證）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1998" width="610" height="55" as="geometry"/></mxCell><mxCell id="p10_tk5" value="多工具彙總（Q27）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2053" width="150" height="55" as="geometry"/></mxCell><mxCell id="p10_tv5" value="不帶 repo 的動詞做得完的做完（先完整預檢，任一預檢失敗才整體不動），最後回最需要處理的碼：失敗 1 &amp;gt; 衝突 2 &amp;gt; 有新版 2 &amp;gt; 0；update 同時遇 1 與 2 → 1；訊息全列（每個目標一行「現版 → 最新」）；不可同時宣稱「已是最新」；舊薄殼對未知碼原樣傳出、不吞" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2053" width="610" height="55" as="geometry"/></mxCell><mxCell id="p10_tk6" value="6-15（末行固定）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2108" width="150" height="28" as="geometry"/></mxCell><mxCell id="p10_tv6" value="update 最後一行永遠印「套用：just vendor_kit upgrade」，含未完成交易（6-33）那條出口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2108" width="610" height="28" as="geometry"/></mxCell><mxCell id="p10_tk7" value="6-33（未完成交易）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2136" width="150" height="55" as="geometry"/></mxCell><mxCell id="p10_tv7" value="唯讀動詞（sync／update／help）偵測到 .tmp.&amp;lt;verb&amp;gt;.*.toml 或 metadata [progress] state=in-progress → 只印「偵測到未完成的 &amp;lt;verb&amp;gt;（&amp;lt;id&amp;gt;）。請先重跑：just vendor_kit &amp;lt;verb&amp;gt; &amp;lt;targets&amp;gt;」，不自動恢復、不寫檔；sync／update 結束 1、help 仍 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2136" width="610" height="55" as="geometry"/></mxCell><mxCell id="pendq" value="待處理問題&lt;br&gt;ue11／ue12／ue13y：u7q 尖點處仍有共線。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1080" y="2207" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p11" name="56 狀態機 v2：初始檔五態"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="2127" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="狀態機 v2：初始檔五態 ── metadata [[file]].state 與轉移（interface_spec §4.3、Q14／Q15、v2.7-3）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="pend" value="已定（Q14、Q15、v2.6 16 條、v2.7-3、interface_spec §4.3）：metadata 對每個初始檔記單一 state（五值）+ declined_hash + lines；declined 只用於新檔被拒、從未建立；已納管檔拒絕換版／合併時 state 不變只記 declined_hash（自環）；add 時 append 檔已存在且拒絕 → unmanaged；新版 hash 不同才再問；unmanaged／declined 只在 dry-run／check.sh 提醒、不動檔不紅燈；下游使用者刪了已納管檔 → deleted、upgrade 維持刪除。" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;spacingRight=22;" vertex="1" parent="1"><mxGeometry x="1040" y="12" width="560" height="116" as="geometry"/></mxCell><mxCell id="bS" value="初始檔五態：每個初始檔一筆 state；箭頭 = 動詞：條件（自環 = 拒絕但狀態不變，只記 declined_hash）；每格一件事（狀態 → 轉入條件 → upgrade 時 → dry-run／check.sh 印什麼）；remove／uninstall 一律到終點" style="swimlane;html=1;rounded=1;startSize=30;fontStyle=1;fontSize=12;container=1;collapsible=1;recursiveResize=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1590" height="1503" as="geometry"/></mxCell><mxCell id="bS_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="bS"><mxGeometry x="1546" y="5" width="30" height="20" as="geometry"/></mxCell><mxCell id="s0" value="起點：初始檔宣告於下游 repo 的 dist/init.toml 的 [[file]]（src／dest／strategy）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=41;spacingRight=41;spacingTop=15;spacingBottom=15;" vertex="1" parent="bS"><mxGeometry x="645" y="36" width="280" height="102" as="geometry"/></mxCell><mxCell id="st_d" value="deleted&lt;br&gt;下游使用者刪了已納管檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="bS"><mxGeometry x="20" y="268" width="160" height="57" as="geometry"/></mxCell><mxCell id="st_m" value="managed&lt;br&gt;已納管（vendor_kit 建的 copy 檔）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="bS"><mxGeometry x="330" y="268" width="160" height="57" as="geometry"/></mxCell><mxCell id="st_c" value="declined&lt;br&gt;新檔被拒、從未建立" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="bS"><mxGeometry x="640" y="268" width="160" height="57" as="geometry"/></mxCell><mxCell id="st_a" value="appended&lt;br&gt;已插入行（strategy=append）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="bS"><mxGeometry x="950" y="268" width="160" height="57" as="geometry"/></mxCell><mxCell id="st_u" value="unmanaged&lt;br&gt;本來就有、沒納管" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=12;strokeWidth=1;spacingLeft=6;spacingRight=6;fontStyle=1;strokeWidth=2;" vertex="1" parent="bS"><mxGeometry x="1260" y="268" width="160" height="57" as="geometry"/></mxCell><mxCell id="in_d" value="轉入：upgrade 逐檔判斷發現 D 缺（下游使用者刪了已納管檔）→ state=deleted" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="120" y="494" width="190" height="57" as="geometry"/></mxCell><mxCell id="in_m" value="轉入：add 時 dest 不存在 → 建（copy；strategy=append 的檔不存在也是整檔建）；upgrade 新版新增檔且 dest 不存在、問「要建 X 嗎」同意 → 建；declined 再問後同意 → 建" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="430" y="462" width="190" height="120" as="geometry"/></mxCell><mxCell id="in_c" value="轉入：upgrade 新版新增檔、問「要建 X 嗎」後明確答否（EOF／Ctrl-C 不算）→ 從未建立、記 declined_hash" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="740" y="486" width="190" height="73" as="geometry"/></mxCell><mxCell id="in_a" value="轉入：add 時 strategy=append 且檔已存在、問「要在 X 加這幾行嗎」同意 → 插入並記 lines（原本就有的相同行不認領）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1050" y="478" width="190" height="88" as="geometry"/></mxCell><mxCell id="in_u" value="轉入：add 時 copy 檔已存在 → 不納管、不覆蓋（-y 也不覆蓋），印 6-11；add 時 append 檔已存在、問後拒絕 → 同樣 unmanaged（只記 declined_hash）；upgrade 新版新增檔但 dest 已存在 → 不納管、印 6-11（不問）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1360" y="455" width="190" height="135" as="geometry"/></mxCell><mxCell id="up_d" value="upgrade 時：維持刪除（不重建、不合併）；基準版仍推到 N" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="120" y="766" width="190" height="42" as="geometry"/></mxCell><mxCell id="up_m" value="upgrade 時（仍 managed）：D==N／B==N 不動；D==B 問後寫 N；皆異問後三方合併（衝突 → 2）；N 缺 → 不刪、只 warn；拒絕 → 只記 declined_hash（自環）；基準版推到 N（合併後解析失敗的檔不推）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="430" y="720" width="190" height="135" as="geometry"/></mxCell><mxCell id="up_c" value="upgrade 時：N 的 hash ≠ declined_hash → 再問；相同 → 不問（仍 declined）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="740" y="759" width="190" height="57" as="geometry"/></mxCell><mxCell id="up_a" value="upgrade 時（仍 appended）：原文比對找 lines：唯一命中 → 問後替換（拒絕 → 只記 declined_hash，自環）；零命中 → 不動只印新內容；多處 → 保留並 warn" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1050" y="736" width="190" height="104" as="geometry"/></mxCell><mxCell id="up_u" value="upgrade 時：永遠不動（不合併、不覆蓋）；仍 unmanaged" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1360" y="766" width="190" height="42" as="geometry"/></mxCell><mxCell id="pr_d" value="dry-run／check.sh 印：維持刪除（不重建）；不紅燈" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="120" y="1008" width="190" height="42" as="geometry"/></mxCell><mxCell id="pr_m" value="dry-run／check.sh 印：會問哪些檔（換新版／三方合併）；有 declined_hash 且新版相同 → 6-6；CI 需改 進 git 的檔 → 1 印清單" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="430" y="985" width="190" height="88" as="geometry"/></mxCell><mxCell id="pr_c" value="dry-run／check.sh 印：6-6「有 N 個範本你拒絕過」；新版有更新 → 6-8「Y 你拒絕過，vZ 有新版」；不紅燈" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="740" y="992" width="190" height="73" as="geometry"/></mxCell><mxCell id="pr_a" value="dry-run／check.sh 印：找到 lines → 會問替換；找不到 → 印新內容；多處 → warn" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1050" y="1000" width="190" height="57" as="geometry"/></mxCell><mxCell id="pr_u" value="dry-run／check.sh 印：6-7「X 沒納管，與範本差 N 行」；不紅燈" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="1360" y="1000" width="190" height="57" as="geometry"/></mxCell><mxCell id="end_d" value="終點：remove &amp;lt;repo&amp;gt;／uninstall → 這筆 state 隨 metadata 消失" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=18;spacingBottom=18;" vertex="1" parent="bS"><mxGeometry x="20" y="1203" width="160" height="124" as="geometry"/></mxCell><mxCell id="end_m" value="終點：remove &amp;lt;repo&amp;gt;／uninstall → 這筆 state 隨 metadata 消失" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=18;spacingBottom=18;" vertex="1" parent="bS"><mxGeometry x="330" y="1203" width="160" height="124" as="geometry"/></mxCell><mxCell id="end_c" value="終點：remove &amp;lt;repo&amp;gt;／uninstall → 這筆 state 隨 metadata 消失" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=18;spacingBottom=18;" vertex="1" parent="bS"><mxGeometry x="640" y="1203" width="160" height="124" as="geometry"/></mxCell><mxCell id="end_a" value="終點：remove &amp;lt;repo&amp;gt;／uninstall → 這筆 state 隨 metadata 消失" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=18;spacingBottom=18;" vertex="1" parent="bS"><mxGeometry x="950" y="1203" width="160" height="124" as="geometry"/></mxCell><mxCell id="end_u" value="終點：remove &amp;lt;repo&amp;gt;／uninstall → 這筆 state 隨 metadata 消失" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#000000;strokeWidth=2;fontSize=12;spacingLeft=23;spacingRight=23;spacingTop=18;spacingBottom=18;" vertex="1" parent="bS"><mxGeometry x="1260" y="1203" width="160" height="124" as="geometry"/></mxCell><mxCell id="s_endn" value="終點（任一狀態皆同）：remove &amp;lt;repo&amp;gt;／uninstall → 初始檔保留並印清單（append 行問後只刪原文相同的）；metadata 隨 baseline/&amp;lt;repo&amp;gt;/ 刪除 → 狀態消失；要刪初始檔請自行 git rm" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="bS"><mxGeometry x="20" y="1457" width="1530" height="40" as="geometry"/></mxCell><mxCell id="sl_m_l" value="↑ upgrade：拒絕換版／三方合併 → 只記 declined_hash（仍 managed）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="bS"><mxGeometry x="470.0" y="345.0" width="150" height="73" as="geometry"/></mxCell><mxCell id="sl_c_l" value="↑ upgrade：再問後仍拒絕 → 更新 declined_hash（仍 declined）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="bS"><mxGeometry x="780.0" y="345.0" width="150" height="73" as="geometry"/></mxCell><mxCell id="sl_a_l" value="↑ upgrade：拒絕替換 lines → 只記 declined_hash（仍 appended）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="bS"><mxGeometry x="1090.0" y="345.0" width="150" height="73" as="geometry"/></mxCell><mxCell id="sl_u_l" value="↑ upgrade：永遠不動（仍 unmanaged）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="bS"><mxGeometry x="1400.0" y="345.0" width="150" height="42" as="geometry"/></mxCell><mxCell id="se_c" value="upgrade：拒絕建新檔" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.268;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=left;verticalAlign=middle;spacingLeft=6;spacingBottom=0;" edge="1" parent="1" source="s0" target="st_c"><mxGeometry x="-0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="se_m" value="add：dest 不存在 → 建；upgrade：同意建新檔" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="st_m"><mxGeometry x="0.00" relative="1" as="geometry"><Array as="points"><mxPoint x="693" y="383"/><mxPoint x="430" y="383"/></Array></mxGeometry></mxCell><mxCell id="se_a" value="add：append 檔已存在、同意插入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="st_a"><mxGeometry x="0.14" relative="1" as="geometry"><Array as="points"><mxPoint x="847" y="407"/><mxPoint x="1050" y="407"/></Array></mxGeometry></mxCell><mxCell id="se_u" value="add：copy 已存在；append 已存在但拒絕；upgrade：新增檔已存在" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="st_u"><mxGeometry x="-0.08" relative="1" as="geometry"><Array as="points"><mxPoint x="917" y="359"/><mxPoint x="1360" y="359"/></Array></mxGeometry></mxCell><mxCell id="se_md" value="upgrade：D 缺" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_m" target="st_d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="se_cm" value="upgrade：再問→同意建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_c" target="st_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="se_end_d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_d" target="end_d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="se_end_m" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSize=12;fontColor=default;labelBorderColor=none;labelBackgroundColor=none;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st_m" target="end_m"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="se_end_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=default;strokeWidth=2;align=center;verticalAlign=bottom;spacingBottom=6;fontFamily=Helvetica;fontSi