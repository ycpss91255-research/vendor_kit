ed=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1129" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r1c1" value="問句：根 justfile" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1129" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r1c2" value="要在 justfile 加這一行嗎：import &#x27;.vendor_kit/entry.just&#x27;／要從 justfile 刪這一行嗎：import &#x27;.vendor_kit/entry.just&#x27;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1129" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r2c0" value="6-21" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1171" width="50" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r2c1" value="問句：append" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1171" width="170" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r2c2" value="要在 &amp;lt;X&amp;gt; 加這幾行嗎（接列出行）／要刪我們加在 &amp;lt;X&amp;gt; 的這幾行嗎（接列出行）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1171" width="530" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r3c0" value="6-22" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1197" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r3c1" value="問句：upgrade 逐檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1197" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r3c2" value="&amp;lt;X&amp;gt; 換成新版？／你和新版都改了 &amp;lt;X&amp;gt;，要三方合併嗎？／要建 &amp;lt;X&amp;gt; 嗎／&amp;lt;X&amp;gt; 是二進位檔，要換成新版嗎？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1197" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r4c0" value="6-23" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1239" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r4c1" value="bootstrap just 太舊" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1239" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r4c2" value="需要 just ≥ 1.33.0，目前為 &amp;lt;version&amp;gt;。請使用 GitHub release 版。+ 固定兩行 下載：&amp;lt;平台對應 URL&amp;gt;、安裝：&amp;lt;不覆蓋既有檔的安裝指令&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1239" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r5c0" value="6-24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1281" width="50" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r5c1" value="docker pull 失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1281" width="170" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r5c2" value="原文 + 三分類（網路／認證／不存在；另「主機錯誤」：daemon 不可用、磁碟滿）；認證類：&amp;lt;ref&amp;gt; 不存在或無權限（GHCR 未登入一律 denied），私有請先 docker login &amp;lt;host&amp;gt;；僅 add／bootstrap 追加 離線可用：--local &amp;lt;tar&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1281" width="530" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r6c0" value="6-26" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1338" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r6c1" value="flock 逾時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1338" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r6c2" value="專案目錄被鎖定（PID &amp;lt;pid&amp;gt;，自 &amp;lt;time&amp;gt;）；60 秒內未釋放。確認無其他 vendor_kit 在跑後重試，或設 VENDOR_KIT_NO_LOCK=1。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1338" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r7c0" value="6-28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1380" width="50" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r7c1" value="薄殼被改（install／upgrade vendor_kit）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1380" width="170" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r7c2" value="偵測到薄殼被修改：&amp;lt;files&amp;gt;。未重產任何薄殼。請先檢視下列差異；確認並手動還原（git checkout -- .vendor_kit/&amp;lt;file&amp;gt;）後，再執行 just vendor_kit upgrade vendor_kit。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1380" width="530" height="57" as="geometry"/></mxCell><mxCell id="p1C_mR_r8c0" value="6-29" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1437" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r8c1" value="新增初始檔 dest 在 CI 路徑" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1437" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r8c2" value="注意：新版初始檔將建立或修改 CI 設定 &amp;lt;X&amp;gt;。請確認下列內容後再決定是否套用。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1437" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r9c0" value="6-30" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1479" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r9c1" value="啟動器驗 vk-resolve 失敗" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1479" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r9c2" value="引擎輸出不完整或不相容（&amp;lt;原因&amp;gt;），未執行任何動作。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1479" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r10c0" value="6-31" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1521" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r10c1" value="pull 逾時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1521" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r10c2" value="拉取 &amp;lt;ref&amp;gt; 超過 &amp;lt;秒&amp;gt; 秒未完成，已中止。可用 --timeout &amp;lt;秒&amp;gt; 或 VENDOR_KIT_PULL_TIMEOUT 調整。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1521" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r11c0" value="6-32" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1563" width="50" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r11c1" value="問句：prune" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1563" width="170" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r11c2" value="要刪除以上 vendor_kit 資源嗎？" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1563" width="530" height="26" as="geometry"/></mxCell><mxCell id="p1C_mR_r12c0" value="6-33" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1589" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r12c1" value="唯讀動詞偵測未完成交易" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1589" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r12c2" value="偵測到未完成的 &amp;lt;verb&amp;gt;（&amp;lt;id&amp;gt;）。請先重跑：just vendor_kit &amp;lt;verb&amp;gt; &amp;lt;targets&amp;gt;（sync／update 結束 1；help 不受影響；prune 只列出不刪）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1589" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r13c0" value="6-34" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1631" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r13c1" value="問句：根 .dockerignore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1631" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r13c2" value="要在 .dockerignore 加這四行嗎：.vendor_kit/cache/ .vendor_kit/gen/ .vendor_kit/.tmp.* .vendor_kit/log/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1631" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r14c0" value="6-35" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1673" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r14c1" value="install 巢狀" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1673" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r14c2" value="&amp;lt;dir&amp;gt; 已有 .vendor_kit/，不允許巢狀接入。請到該目錄執行，或先 uninstall。（結束 1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1673" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r15c0" value="6-36" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="790" y="1715" width="50" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r15c1" value="舊薄殼跑新 major 一般動詞" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="840" y="1715" width="170" height="42" as="geometry"/></mxCell><mxCell id="p1C_mR_r15c2" value="薄殼介面版 &amp;lt;P_shell&amp;gt; 低於引擎 &amp;lt;vY&amp;gt; 的一般動詞需求。請先執行：just vendor_kit upgrade vendor_kit（結束 3、零寫入）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;strokeWidth=1;" vertex="1" parent="p1C"><mxGeometry x="1010" y="1715" width="530" height="42" as="geometry"/></mxCell><mxCell id="p1c_lg0" value="綠底：常用動詞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1903" width="130" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg1" value="白底：進階動詞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="1903" width="130" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg2" value="淺橘底：規則／摘要（已定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="1903" width="190" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg3" value="灰底：表頭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontSize=12;fontStyle=1;align=center;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="550" y="1903" width="110" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg4" value="淺灰底：分組（無狀態意義）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="1903" width="200" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg5" value="右上角綠標籤：v2 改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1903" width="200" height="40" as="geometry"/></mxCell><mxCell id="p1c_lg5_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1068" y="1905" width="30" height="20" as="geometry"/></mxCell><mxCell id="p1c_lgt" value="「反向」= 收回它做的事的動詞&lt;br&gt;表格：一列一個選項／結束碼／訊息" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="1120" y="1893" width="300" height="60" as="geometry"/></mxCell><mxCell id="p1c_lg6" value="便條：說明（含「本頁無待拍板」）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1969" width="220" height="40" as="geometry"/></mxCell><mxCell id="p1c_th" value="本頁名詞（只列本頁用到的）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2025" width="300" height="28" as="geometry"/></mxCell><mxCell id="p1c_tk0" value="組（常用／進階／一次性）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2059" width="150" height="40" as="geometry"/></mxCell><mxCell id="p1c_tv0" value="常用 = 每天會打的（add／upgrade／dev）；進階 = 偶爾才用；一次性 = 只在第一次接入跑的 bootstrap.sh（release 附的腳本，不是 just 動詞）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2059" width="610" height="40" as="geometry"/></mxCell><mxCell id="p1c_tk1" value="反向" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2099" width="150" height="40" as="geometry"/></mxCell><mxCell id="p1c_tv1" value="把該動詞做的事收回的動詞（install↔uninstall、add↔remove、dev↔undev）；upgrade 沒有動詞反向，靠 git revert（把整組升級 commit 反做一次的 git 指令）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2099" width="610" height="40" as="geometry"/></mxCell><mxCell id="p1c_tk2" value="apt 語意" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2139" width="150" height="28" as="geometry"/></mxCell><mxCell id="p1c_tv2" value="跟 Debian 的 apt 一樣分兩步：update 只查有沒有新版、不動檔；upgrade 才真的套用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2139" width="610" height="28" as="geometry"/></mxCell><mxCell id="p1c_tk3" value="--local 值的判別" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2167" width="150" height="40" as="geometry"/></mxCell><mxCell id="p1c_tv3" value="已定：--local &amp;lt;值&amp;gt; 含 / 或以 .tar 結尾 → 檔案路徑（必須存在，否則 1）；其餘 → 本機 image tag；兩者皆成立（tag 含 / 且存在同名檔）→ 1 提示用 ./ 或完整 ref 消歧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2167" width="610" height="40" as="geometry"/></mxCell><mxCell id="p1c_tk4" value="pull 逾時" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="2207" width="150" height="40" as="geometry"/></mxCell><mxCell id="p1c_tv4" value="VENDOR_KIT_PULL_TIMEOUT／--timeout &amp;lt;秒&amp;gt;：單次 pull 總秒數，預設 300、只收正整數；逾時 → 1 印 6-31；啟動器自讀、不轉發引擎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="2207" width="610" height="40" as="geometry"/></mxCell><mxCell id="p1c_tk5" value="--protocol P" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2059" width="150" height="55" as="geometry"/></mxCell><mxCell id="p1c_tv5" value="薄殼每次呼叫引擎都附的介面版整數（第一版 P=1，全域旗標在子命令之前）；引擎接受 [floor_P, current_P] 並依呼叫方介面版 P 輸出 vk-resolve/P 行別與結束碼語意；太舊 → 一般動詞乾淨回 3 印 6-36，救援路徑永久可用；新增 verb／旗標／記錄種類／欄位／結束碼語意／印記第一行語意 → P+1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2059" width="610" height="55" as="geometry"/></mxCell><mxCell id="p1c_tk6" value="mod／mod?／import／import?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="2114" width="150" height="55" as="geometry"/></mxCell><mxCell id="p1c_tv6" value="just 的載入：mod &amp;lt;ns&amp;gt; &#x27;檔&#x27; 把整個檔掛成命名空間；mod? = 檔不在也不報錯（gen/tools.just 一律用它，cache 缺檔時 just vendor_kit sync 仍可進入）；import &#x27;檔&#x27; 把內容併進來（根 justfile 那一行）；import? = 檔不在也不報錯（entry.just 掛 gen/tools.just）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="2114" width="610" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p2" name="06 契約 v2：目錄樹與檔案範例"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2384" math="0" shadow="0"><root><mxCell id="0" style="strokeWidth=2;"/><mxCell id="1" parent="0" style="strokeWidth=2;"/><mxCell id="title" value="契約② 專案裡的檔（1／3）── 目錄樹與檔案範例（interface_spec §4；誰寫它、誰可以改、進不進 git）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="p2_num" value="契約編號：①介面 p1／p1b／p1c｜②專案裡的檔 p2／p2b／p2c｜③下游 repo p3｜④啟動器↔引擎 p3b｜⑤CI p3c／驗收詳表 p3d｜架構 p4｜流程 p5～；訊息編號 6-N = interface_spec §6 逐字" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p2_pend" value="&lt;b&gt;本頁無待拍板&lt;/b&gt;&lt;br&gt;檔名 version.toml 已定（§4.1：它是「該裝哪版」的宣告，不是 lock 產物）；右欄範例框逐字（等寬、保留縮排），說明一律放框外" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="12" width="340" height="81" as="geometry"/></mxCell><mxCell id="p2_lbl" value="3. 目錄樹（專案根 = 含 .vendor_kit/ 的目錄；每格：用途｜寫：誰產生｜改：誰可改）" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="109" width="620" height="28" as="geometry"/></mxCell><mxCell id="t_root" value="&lt;b&gt;專案/&lt;/b&gt;（下游使用者的；專案根）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="200" height="46" as="geometry"/></mxCell><mxCell id="t_just" value="&lt;b&gt;justfile&lt;/b&gt; ── 專案檔；install 只加一行 import &#x27;.vendor_kit/entry.just&#x27;（無 → 建四行；有 → 問／-y；已含 → 不再加）&lt;br&gt;寫：install｜改：隨意；uninstall 問後只刪完全相同那行；add 只讀它查撞名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="70" y="195" width="560" height="61" as="geometry"/></mxCell><mxCell id="t_just_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="197" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_di" value="&lt;b&gt;.dockerignore&lt;/b&gt; ── 下游使用者的；install 加四行 .vendor_kit/cache/、gen/、.tmp.*、log/（無 → 建；有 → 問 6-34／-y）&lt;br&gt;寫：install（記於 baseline/.vendor_kit.toml）｜改：下游使用者隨意；uninstall 問後只刪原文相同行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4C3;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="70" y="262" width="560" height="77" as="geometry"/></mxCell><mxCell id="t_di_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="264" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_vk" value="&lt;b&gt;.vendor_kit/&lt;/b&gt; ── 根目錄只多這一個；薄殼 + 狀態 + 快取都在裡面；上層或下層不得再有一個（禁止巢狀）&lt;br&gt;寫：install、upgrade vendor_kit 重產薄殼（先比對薄殼首行）｜改：人不改；uninstall 只刪 hash 相符的自產檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="560" height="77" as="geometry"/></mxCell><mxCell id="t_vk_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="347" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_ver" value="&lt;b&gt;version.toml&lt;/b&gt; ── 進 git：唯一來源。vendor_kit = &quot;&amp;lt;ref&amp;gt;&quot; 版本鎖定行（唯一）、schema、written_by、[tools] 一行一工具 tag@digest&lt;br&gt;寫：install／add／upgrade／remove（apply 最後才寫）｜改：下游使用者可手改、Renovate PR 改；sync 只讀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="428" width="530" height="77" as="geometry"/></mxCell><mxCell id="t_ver_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="430" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_vl" value="&lt;b&gt;version.local.toml&lt;/b&gt; ── 不進 git（自有 .gitignore 擋）；與 version.toml 同形：工具的本機覆寫 path:&amp;lt;dir&amp;gt;、引擎的本機覆寫 tag + vendor_kit_image_id&lt;br&gt;寫：dev／undev（含 image ID）；bootstrap --local 在 install 成功後才寫｜改：不建議手改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;dashed=1;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="511" width="530" height="92" as="geometry"/></mxCell><mxCell id="t_vl_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="513" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_vl2" value="&lt;b&gt;（規則）&lt;/b&gt;CI 模式下有任何本機覆寫 → sync 回 1；uninstall 直接刪（VK 自有檔，不比 hash）；undev 撤掉最後一個覆寫時刪整個檔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;dashed=1;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="130" y="609" width="500" height="46" as="geometry"/></mxCell><mxCell id="t_vl2_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="611" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_cfg" value="&lt;b&gt;config.toml&lt;/b&gt; ── 進 git：schema = 1、[log] keep = 50、days = 30（含註解與預設值；缺檔或缺鍵 = 預設；非正整數 → 預設 + 警告）&lt;br&gt;寫：install 建；upgrade 當初始檔三方合併｜改：下游使用者隨意；引擎用 TOML parser 讀，啟動器只 grep 固定寫法的 ^keep *= *[0-9]+ *$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="661" width="530" height="77" as="geometry"/></mxCell><mxCell id="t_cfg_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="663" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_gi" value="&lt;b&gt;.gitignore&lt;/b&gt; ── 進 git，我們自己的：cache/ gen/ log/ version.local.toml .tmp.*；第一行自描述&lt;br&gt;寫：install／upgrade vendor_kit 重產｜改：人不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="744" width="530" height="61" as="geometry"/></mxCell><mxCell id="t_gi_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="746" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_entry" value="&lt;b&gt;entry.just&lt;/b&gt; ── 進 git：mod vendor_kit &#x27;vendor.just&#x27; + import? &#x27;gen/tools.just&#x27;（零 set 零 recipe）；第一行自描述&lt;br&gt;寫：引擎 shell 模組（install／upgrade vendor_kit）｜改：人不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="811" width="530" height="61" as="geometry"/></mxCell><mxCell id="t_entry_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="813" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_vj" value="&lt;b&gt;vendor.just&lt;/b&gt; ── 進 git：動詞 recipe 一行轉發＋啟動器本體（POSIX sh；set positional-arguments 只放這；附 --protocol P）；第一行自描述&lt;br&gt;寫：引擎 shell 模組｜改：人不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=left;spacingLeft=8;spacingRight=34;" vertex="1" parent="1"><mxGeometry x="100" y="878" width="530" height="61" as="geometry"/></mxCell><mxCell id="t_vj_v2" value="v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00b050;strokeColor=#00b050;fontColor=#ffffff;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="598" y="880" width="30" height="20" as="geometry"/></mxCell><mxCell id="t_logsh" value="&lt;b&gt;log.sh&lt;/b&gt; ── 進 git：啟動器 log 函式（POSIX；內嵌啟動器事件白名單）；第一行自描述（同其他薄殼檔）&lt;br&gt;寫：引擎 shell 模組｜改：人不改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=light-dark(#000000,#9577A3);fontSize=14;strokeWidth=1;fontSize=12;strokeColor=#82b366;strokeWidth=2;align=lef