llColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1553" width="1540" height="40" as="geometry"/></mxCell><mxCell id="p5cw_th" value="本頁名詞" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1599" width="200" height="28" as="geometry"/></mxCell><mxCell id="p5cw_tk0" value="install 進度檔" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1633" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cw_tv0" value=".tmp.install.&amp;lt;id&amp;gt;.toml：拿鎖、比對薄殼之後、第一個寫入（含暫存檔）之前建；第一次也建 = 「不留半成品」的清除清單；最後一步（install（2）頁）刪；未完成 → 下次可寫動詞先恢復" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1633" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cw_tk1" value="暫存目錄／原子替換" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1673" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cw_tv1" value="先寫到暫存目錄，確認沒問題再逐檔一次換上；第一次 install 失敗 → 依進度檔丟棄暫存、移除已寫的檔，專案不留任何檔（log/ 除外）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1673" width="610" height="40" as="geometry"/></mxCell><mxCell id="p5cw_tk2" value="config.toml（install／uninstall）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1713" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5cw_tv2" value=".vendor_kit/config.toml（進 git）：schema = 1、[log] keep = 50、days = 30；install 建（含註解）＋ 基準版副本 baseline/vendor_kit/config.toml；升引擎時三方合併；uninstall 只在 hash == 副本時刪；缺檔或缺鍵 = 預設" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="190" y="1713" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5cw_tk3" value="gen/.stamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1633" width="150" height="55" as="geometry"/></mxCell><mxCell id="p5cw_tv3" value="只記「gen/ 與薄殼是哪個引擎產生的」（引擎 ref 一行；本機覆寫時為 &amp;lt;tag&amp;gt;）；只由 install／upgrade vendor_kit 寫；≠ version.toml 版本鎖定行 → sync 退出 1 印 6-1；fresh clone 缺此檔時相容判定改用薄殼首行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1633" width="610" height="55" as="geometry"/></mxCell><mxCell id="p5cw_tk4" value="baseline/.gitkeep" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="840" y="1688" width="150" height="40" as="geometry"/></mxCell><mxCell id="p5cw_tv4" value="VK 自產進 git 的檔，hash 固定為空檔；install 缺才建；metadata baseline/.vendor_kit.toml 記 config.toml 與根 .dockerignore 的紀錄（v2.13 P10）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="990" y="1688" width="610" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="v1p5cc" name="22 流程 v2：install（2）根 justfile 與 .dockerignore"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageSca